---
// "Made from <source> · <what was done> · for the entry <title> · by the workflow <slug>" for a derivative or a
// generated image (lib/assetLineage.ts). Nothing for an original. The source's and the entry's names are looked up
// best-effort: a deleted one still shows the line, unnamed.
import { entryHref, lineageOf, workflowHref } from "@/lib/assetLineage";
import { fetchApi } from "@/lib/api/client";
import { createSdkClient } from "@/lib/sdk";

interface Props {
  metadata: unknown;
  authToken: string | null | undefined;
}

const { metadata, authToken } = Astro.props;
const lineage = lineageOf(metadata);
let sourceName: string | null = null;
let entryTitle: string | null = null;
if (lineage && authToken) {
  const [source, entry] = await Promise.allSettled([
    lineage.sourceId ? createSdkClient(authToken).assets.get(lineage.sourceId) : Promise.resolve(null),
    lineage.entryId ? fetchApi<{ title?: string }>(`/api/platform/entries/${lineage.entryId}`, {}, authToken) : Promise.resolve(null),
  ]);
  sourceName = source.status === "fulfilled" ? (source.value?.name ?? null) : null; // gone, or not readable here
  entryTitle = entry.status === "fulfilled" ? (entry.value?.title ?? null) : null;
}
---

{lineage && (
  <p class="asset-lineage">
    {lineage.sourceId ? (
      <>Made from {sourceName ? <a href={`/workspace/assets/${lineage.sourceId}/view`}>{sourceName}</a> : "an asset that no longer exists"} · {lineage.made}</>
    ) : (
      <>{lineage.made[0].toUpperCase() + lineage.made.slice(1)}</>
    )}
    {lineage.model && <> ({lineage.model})</>}
    {lineage.entryId && <> · for the entry <a href={entryHref(lineage.entryId)}>{entryTitle ?? "(no longer there)"}</a></>}
    {lineage.workflow && (
      <> · by the workflow <a href={lineage.workflowId ? workflowHref(lineage.workflowId) : "/automation/workflows"}>{lineage.workflow}</a></>
    )}
    {lineage.prompt && <span class="asset-lineage-prompt">Prompt: “{lineage.prompt}”</span>}
  </p>
)}

<style>
  .asset-lineage {
    margin: 0.5rem 0 0;
    color: var(--muted);
    font-size: 0.875rem;
  }
  /* Links site-wide inherit the text colour; here they must read as links (the source picture, the entry, the workflow). */
  .asset-lineage a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .asset-lineage-prompt {
    display: block;
    margin-top: 0.25rem;
  }
</style>
