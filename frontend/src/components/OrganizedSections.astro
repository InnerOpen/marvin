---
/**
 * The sections of an organised Automation list: an empty host the page's script fills (lib/organizedListView.ts
 * through the shared list kit), the empty-filter message and the base styles for sections, compact cards, the On/Off
 * switch and the ⋯ menu. Pair it with components/FilterBar.astro. Each page draws its own card inside `.org-card`.
 *
 * Classes (all global, so client-rendered HTML picks them up): `org-section`, `org-title`, `org-items`, `org-card`
 * (+ `off` to dim), `org-card-main`, `org-card-title`, `org-card-sub`, `org-card-actions`, `org-btn`
 * (+ `primary`, `danger`), `org-switch`, `org-more-wrap`, `org-menu`, `org-menu-item` (+ `danger`).
 */
interface Props {
  /** Prefix for the element ids: `${id}-list`, `${id}-empty`, `${id}-none`. */
  id: string;
  /** Singular noun for the messages: "workflow". */
  noun: string;
  /** The message when there is nothing at all. */
  emptyAll: string;
}

const { id, noun, emptyAll } = Astro.props;
---

<div id={`${id}-list`} class="org-sections"></div>
<div id={`${id}-none`} class="org-empty" hidden>{emptyAll}</div>
<div id={`${id}-empty`} class="org-empty" hidden>No {noun} matches. Try another search, or show all.</div>

<style is:global>
  .org-sections { display: flex; flex-direction: column; gap: 22px; margin-top: 18px; }
  .org-empty { color: var(--muted); text-align: center; padding: 28px; border: 1px dashed var(--line); border-radius: 14px; margin-top: 18px; }
  .org-empty[hidden], .org-menu[hidden] { display: none; }

  .org-title { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin: 0 0 8px; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; color: var(--muted); }
  .org-title .int-mark { transform: scale(0.75); transform-origin: left center; margin-right: -8px; }
  .org-name { color: var(--ink); }
  .org-counts { font-weight: 400; text-transform: none; letter-spacing: 0; }
  .org-items { display: flex; flex-direction: column; gap: 8px; }

  .org-card { display: flex; align-items: flex-start; justify-content: space-between; gap: 14px; border: 1px solid var(--line); border-radius: 12px; padding: 10px 14px; background: var(--bg); scroll-margin-top: 80px; transition: border-color 0.15s, box-shadow 0.15s; }
  .org-card:hover { border-color: color-mix(in srgb, var(--accent) 40%, var(--line)); }
  .org-card.off { opacity: 0.6; }
  .org-card.linked { border-color: var(--accent); box-shadow: 0 0 0 2px color-mix(in srgb, var(--accent) 25%, transparent); }
  .org-card-main { flex: 1; min-width: 0; }
  .org-card-title { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; font-size: 14.5px; }
  .org-card-sub { margin-top: 2px; font-size: 13px; color: var(--muted); overflow-wrap: anywhere; }
  .org-card-actions { display: flex; align-items: center; gap: 8px; flex: none; }

  .org-btn { text-decoration: none; font-size: 12px; padding: 5px 11px; border: 1px solid var(--line); border-radius: 8px; background: var(--bg); color: var(--muted); cursor: pointer; font-weight: 500; }
  .org-btn:hover { color: var(--ink); border-color: color-mix(in srgb, var(--accent) 45%, var(--line)); }
  .org-btn.primary { color: var(--accent); border-color: color-mix(in srgb, var(--accent) 45%, var(--line)); font-weight: 600; }
  .org-btn.danger { color: var(--color-error); }
  .org-btn.danger:hover { border-color: var(--color-error); background: color-mix(in srgb, var(--color-error) 10%, transparent); }
  .org-title .org-delete-removed { margin-left: auto; text-transform: none; letter-spacing: 0; }
  dialog.org-confirm-dialog { border: 1px solid var(--line); border-radius: 12px; background: var(--bg); color: inherit; padding: 20px; width: min(460px, calc(100vw - 32px)); }
  .org-confirm { display: flex; flex-direction: column; gap: 12px; }
  .org-confirm h3, .org-confirm p { margin: 0; }
  .org-confirm-list { margin: 0; padding-left: 20px; max-height: 40vh; overflow-y: auto; }
  .org-confirm-error { color: var(--color-error); }
  .org-confirm-actions { display: flex; justify-content: flex-end; gap: 8px; }
  .org-btn:disabled { opacity: 0.55; cursor: default; }

  /* On/Off switch */
  .org-switch { position: relative; width: 34px; height: 20px; padding: 0; border: 1px solid var(--line); border-radius: 999px; background: var(--line); cursor: pointer; flex: none; transition: background 0.15s; }
  .org-switch[aria-checked="true"] { background: var(--accent); border-color: var(--accent); }
  .org-switch-knob { position: absolute; top: 1px; left: 1px; width: 16px; height: 16px; border-radius: 50%; background: #fff; transition: transform 0.15s; box-shadow: 0 1px 2px rgb(0 0 0 / 0.25); }
  .org-switch[aria-checked="true"] .org-switch-knob { transform: translateX(14px); }
  .org-switch:focus-visible, .org-more:focus-visible, .org-btn:focus-visible, .org-menu-item:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  /* ⋯ menu */
  .org-more-wrap { position: relative; }
  .org-more { font-size: 16px; line-height: 1; padding: 4px 9px 6px; border: 1px solid var(--line); border-radius: 8px; background: var(--bg); color: var(--muted); cursor: pointer; }
  .org-more:hover, .org-more-wrap.open .org-more { color: var(--ink); border-color: color-mix(in srgb, var(--accent) 45%, var(--line)); }
  .org-menu { position: absolute; right: 0; top: calc(100% + 4px); z-index: 20; min-width: 160px; display: flex; flex-direction: column; padding: 4px; border: 1px solid var(--line); border-radius: 10px; background: var(--bg); box-shadow: 0 6px 24px rgb(0 0 0 / 0.14); }
  .org-menu-item { text-align: left; font-size: 13px; padding: 7px 10px; border: 0; border-radius: 6px; background: none; color: var(--ink); cursor: pointer; }
  .org-menu-item:hover { background: color-mix(in srgb, var(--accent) 10%, transparent); }
  .org-menu-item.danger { color: var(--color-error); }
  .org-menu-item.danger:hover { background: color-mix(in srgb, var(--color-error) 10%, transparent); }

  /* Phones: compact cards stack the actions under the text; the menu is a bottom sheet over a backdrop. */
  @media (max-width: 640px) {
    .org-card { flex-direction: column; gap: 10px; }
    .org-card-actions { width: 100%; flex-wrap: wrap; }
    .org-card-actions .org-switch { order: -1; }
    .org-more-wrap { margin-left: auto; }
    .org-more-wrap.open::before { content: ""; position: fixed; inset: 0; z-index: 40; background: rgb(0 0 0 / 0.4); }
    .org-menu { position: fixed; left: 0; right: 0; bottom: 0; top: auto; z-index: 41; border-radius: 16px 16px 0 0; padding: 10px 10px calc(10px + env(safe-area-inset-bottom)); box-shadow: 0 -6px 24px rgb(0 0 0 / 0.2); }
    .org-menu-item { padding: 14px 12px; font-size: 15px; }
  }
</style>
