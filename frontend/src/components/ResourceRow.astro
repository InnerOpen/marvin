---
/**
 * One row of the Resources page (table and by-type views alike). A trashed resource (`inTrash`) is marked and
 * only links to its page, where the Trash banner offers Restore and Delete forever (EDITOR+). Move to Trash
 * is wired by the page's script (`.delete-resource-btn`). The whole row opens the resource (`data-href`, the page's
 * script): on a phone the Actions column sits off-screen to the right, as on the Assets page.
 */
import TagList from "@/components/TagList.astro";
import type { ResourceRead } from "@/lib/api/resources";

interface Props {
  resource: ResourceRead;
  /** EDITOR and above: Edit and Move to Trash. */
  canEdit: boolean;
  inTrash?: boolean;
}

const { resource, canEdit, inTrash = false } = Astro.props;
const openHref = `/workspace/resources/${resource.id}`;
---

<tr class="resource-row" data-href={openHref} data-type={resource.resourceType} data-status={inTrash ? "trashed" : undefined} data-in-trash={inTrash ? "" : undefined}>
  <td class="resource-name">
    <a class="name-link" href={openHref}><strong>{resource.name}</strong></a>
    {inTrash && <span class="trash-badge">In the Trash</span>}
    {resource.tags?.length > 0 && <div class="tags-row"><TagList tags={resource.tags} /></div>}
  </td>
  <td class="stack-hide"><span class="type-badge">{resource.resourceType}</span></td>
  <td class="description-cell">{resource.description || '—'}</td>
  <td class="stack-hide">{resource.externalId ? <code>{resource.externalId}</code> : '—'}</td>
  <td class="stack-hide">
    {resource.url ? (
      <a href={resource.url} target="_blank" rel="noopener noreferrer" class="external-link">
        {new URL(resource.url).hostname} ↗
      </a>
    ) : '—'}
  </td>
  <td>
    <div class="actions">
      {inTrash ? (
        <a href={`/workspace/resources/${resource.id}`} class="button secondary small" title={canEdit ? "Restore it or delete it forever" : undefined}>Open</a>
      ) : (
        <>
          <a href={`/workspace/resources/${resource.id}`} class="button secondary small">{canEdit ? "Edit" : "View"}</a>
          {canEdit && (
            <button
              type="button"
              class="button secondary small delete-resource-btn"
              data-resource-id={resource.id}
              data-resource-name={resource.name}
            >
              Move to Trash
            </button>
          )}
        </>
      )}
    </div>
  </td>
</tr>

<style>
  .resource-row[data-href] { cursor: pointer; }
  .name-link { color: inherit; text-decoration: none; }
  .name-link:hover strong { text-decoration: underline; }

  .tags-row {
    margin-top: 0.35rem;
  }

  .type-badge {
    display: inline-block;
    padding: 0.25rem 0.5rem;
    background: var(--panel-2);
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: capitalize;
  }

  .description-cell {
    max-width: 300px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .external-link {
    color: var(--accent);
    text-decoration: none;
    font-size: 0.875rem;
  }

  .external-link:hover {
    text-decoration: underline;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .button.small {
    min-height: 32px;
    padding: 6px 10px;
    font-size: 0.875rem;
  }

  .button.danger {
    color: var(--color-error);
    border-color: var(--color-error);
  }

  .button.danger:hover {
    background: var(--color-error-bg);
  }

  .trash-badge {
    display: inline-block;
    margin-left: 0.5rem;
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    background: var(--color-error-bg);
    color: var(--color-error);
    font-size: 0.7rem;
    font-weight: 600;
  }
</style>
