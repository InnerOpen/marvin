---
// Live activity toasts (a speech bubble off the bell; newest on top): what Marvin just did in this workspace — workflows that ran or failed,
// webhooks received, site rebuilds sent (with a "N changes" list of what each covers), content changed by someone else.
//
// Polls GET /api/platform/events/feed (the audit log, oldest first) every few seconds while the tab
// is visible. Everything shown is already in the event log; this only surfaces it as it happens.
// The bell cycles All → Failures only → Off, remembered per browser. Muting changes nothing in Marvin.
interface Props {
  /** The signed-in user — their own content edits aren't echoed back to them. */
  userId?: string | null;
}
const { userId = null } = Astro.props;
---

<button type="button" class="button secondary activity-bell" id="activity-bell" data-user-id={userId ?? ""} aria-live="polite">
  <span aria-hidden="true" data-icon>🔔</span><span class="sr-only" data-label>Activity: all</span>
</button>
<div class="activity-stack" id="activity-stack" role="log" aria-live="polite" aria-label="Recent activity"></div>

<script>
  import { type ChangeList, changesLabel, dismissTimer, moreLabel, type RebuildChange, summarizeChanges } from "@/lib/activity/toast";
  import { fetchApi } from "@/lib/api/client";

  type FeedEvent = {
    eventId: string;
    eventType: string;
    occurredAt: string;
    userId?: string | null;
    entityId?: string | null;
    entityType?: string | null;
    messageTitle: string;
    messageBody?: string | null;
    detail?: string | null;
    changes?: RebuildChange[] | null;
    requestCount?: number | null;
  };
  type Feed = { now: string; events: FeedEvent[] };
  type Mode = "all" | "failures" | "off";
  type Kind = {
    tone: "ok" | "info" | "warn" | "err"; // warn and err stay until dismissed and show in "failures only"
    label: string;
    href?: (e: FeedEvent) => string;
    othersOnly?: boolean;
    skip?: (e: FeedEvent) => boolean;
  };

  const STICKY = new Set<Kind["tone"]>(["warn", "err"]);
  const POLL_MS = 5000;
  const TOAST_MS = 6000;
  const MAX_TOASTS = 5;
  const SEEN_CAP = 500; // the feed overlaps polls on purpose; remember enough ids to dedupe
  const MODE_KEY = "marvin.activity";
  const MODES: Mode[] = ["all", "failures", "off"];
  const MODE_LABEL: Record<Mode, string> = { all: "Activity: all", failures: "Activity: failures only", off: "Activity: off" };
  const MODE_ICON: Record<Mode, string> = { all: "🔔", failures: "⚠️", off: "🔕" };

  const entryHref = (e: FeedEvent) => (e.entityType === "entry" && e.entityId ? `/workspace/entries/${e.entityId}` : "/workspace/events");

  // What's worth a toast. Anything not listed stays in the event log only.
  const KINDS: Record<string, Kind> = {
    automation_ran: { tone: "ok", label: "Workflow", href: () => "/automation/workflows" },
    automation_failed: { tone: "err", label: "Workflow failed", href: () => "/automation/workflows" },
    incoming_webhook: { tone: "info", label: "Webhook received", href: () => "/automation/incoming-webhooks" },
    webhook_triggered: { tone: "info", label: "Site rebuild" },
    webhook_delivery_failed: { tone: "err", label: "Webhook delivery failed", href: () => "/automation/webhooks" },
    site_build_started: { tone: "info", label: "Site build started" },
    site_build_completed: { tone: "ok", label: "Site built" },
    site_build_failed: { tone: "err", label: "Site build failed" },
    site_deployment_started: { tone: "info", label: "Site deploy started" },
    site_deployment_completed: { tone: "ok", label: "Site deployed" },
    site_deployment_failed: { tone: "err", label: "Site deploy failed" },
    scheduled_task_failed: { tone: "err", label: "Scheduled task failed", href: () => "/workspace/scheduled-tasks" },
    ai_operation_failed: { tone: "err", label: "AI operation failed" },
    ai_budget_threshold_reached: { tone: "warn", label: "AI budget", href: () => "/workspace/settings/ai-workflow#usage-section" },
    ai_budget_exceeded: { tone: "err", label: "AI budget reached", href: () => "/workspace/settings/ai-workflow#usage-section" },
    ai_provider_quota_exceeded: { tone: "err", label: "AI provider out of quota", href: () => "/workspace/settings/ai-workflow" },
    // Full reindex runs only — every publish/edit also auto-indexes that one item, which isn't news.
    ai_embeddings_reindexed: {
      tone: "info",
      label: "Search index",
      href: () => "/workspace/settings/ai-ask",
      skip: (e) => (e.messageBody || "").startsWith("Auto-indexed"),
    },
    form_submission_received: { tone: "info", label: "Form submission", href: entryHref },
    entry_published: { tone: "info", label: "Published", href: entryHref, othersOnly: true },
    entry_unpublished: { tone: "info", label: "Unpublished", href: entryHref, othersOnly: true },
    entry_created: { tone: "info", label: "Created", href: entryHref, othersOnly: true },
    entry_updated: { tone: "info", label: "Updated", href: entryHref, othersOnly: true },
    entry_deleted: { tone: "info", label: "Deleted", othersOnly: true },
  };

  const bell = document.getElementById("activity-bell") as HTMLButtonElement;
  const stack = document.getElementById("activity-stack") as HTMLElement;
  // Rendered next to the bell, inside the top bar — whose backdrop-filter makes it the containing
  // block for position: fixed, pinning the stack to the bar instead of the window. Lift it out.
  document.body.appendChild(stack);

  // Hang the stack off the bell like a speech bubble: right-aligned under it, the tail pointing at
  // its middle. The bell lives in the sticky top bar, so this only changes when the window does.
  function placeStack() {
    const b = bell.getBoundingClientRect();
    stack.style.top = `${Math.round(b.bottom) + 10}px`;
    stack.style.right = `${Math.max(8, Math.round(window.innerWidth - b.right))}px`;
    stack.style.setProperty("--tail-right", `${Math.round(b.width / 2 - 7)}px`);
  }
  placeStack();
  window.addEventListener("resize", placeStack);
  const me = bell.dataset.userId || null;

  function readMode(): Mode {
    try {
      const v = localStorage.getItem(MODE_KEY) as Mode | null;
      return v && MODES.includes(v) ? v : "all";
    } catch {
      return "all";
    }
  }
  let mode = readMode();

  function renderBell() {
    bell.querySelector("[data-icon]")!.textContent = MODE_ICON[mode];
    bell.querySelector("[data-label]")!.textContent = MODE_LABEL[mode];
    bell.title = `${MODE_LABEL[mode]} — click to change`;
  }

  bell.addEventListener("click", () => {
    mode = MODES[(MODES.indexOf(mode) + 1) % MODES.length];
    try {
      localStorage.setItem(MODE_KEY, mode);
    } catch {
      /* private window — the choice lasts for this page only */
    }
    renderBell();
  });
  renderBell();

  function shouldShow(e: FeedEvent, kind: Kind | undefined): kind is Kind {
    if (!kind || mode === "off") return false;
    if (mode === "failures" && !STICKY.has(kind.tone)) return false;
    if (kind.othersOnly && me && e.userId === me) return false;
    if (kind.skip?.(e)) return false;
    return true;
  }

  function dismiss(el: HTMLElement) {
    el.classList.add("leaving");
    setTimeout(() => el.remove(), 200);
  }

  // "N changes ▾" under a site rebuild: a disclosure listing what that one build covers.
  function changesDisclosure(eventId: string, list: ChangeList, onToggle: (open: boolean) => void): HTMLElement {
    const wrap = document.createElement("div");
    wrap.className = "activity-changes";

    const toggle = document.createElement("button");
    toggle.type = "button";
    toggle.className = "activity-changes-toggle";
    toggle.setAttribute("aria-expanded", "false");
    const panelId = `activity-changes-${eventId}`;
    toggle.setAttribute("aria-controls", panelId);
    const caret = document.createElement("span");
    caret.setAttribute("aria-hidden", "true");
    caret.textContent = "▾";
    toggle.append(`${changesLabel(list.total)} `, caret);

    const panel = document.createElement("ul");
    panel.id = panelId;
    panel.hidden = true;
    for (const item of list.items) {
      const li = document.createElement("li");
      const text = document.createElement(item.href ? "a" : "span");
      if (item.href) (text as HTMLAnchorElement).href = item.href;
      text.textContent = item.label;
      li.append(text);
      panel.append(li);
    }
    if (list.more > 0) {
      const li = document.createElement("li");
      li.className = "activity-changes-more";
      li.textContent = moreLabel(list.more);
      panel.append(li);
    }

    toggle.addEventListener("click", () => {
      const open = toggle.getAttribute("aria-expanded") !== "true";
      toggle.setAttribute("aria-expanded", String(open));
      panel.hidden = !open;
      onToggle(open);
    });
    wrap.append(toggle, panel);
    return wrap;
  }

  function show(e: FeedEvent, kind: Kind) {
    const changes = summarizeChanges(e.changes, e.requestCount);
    // A toast with its own links inside can't itself be a link.
    const link = kind.href && !changes ? kind.href(e) : null;
    const el = document.createElement(link ? "a" : "div");
    el.className = `activity-toast ${kind.tone}`;
    if (link) (el as HTMLAnchorElement).href = link;

    const head = document.createElement("div");
    head.className = "activity-head";
    const label = document.createElement("strong");
    label.textContent = kind.label;
    const time = document.createElement("time");
    time.dateTime = e.occurredAt;
    time.textContent = new Date(e.occurredAt).toLocaleTimeString([], { hour: "numeric", minute: "2-digit", second: "2-digit" });
    head.append(label, time);

    const body = document.createElement("div");
    body.className = "activity-body";
    body.textContent = e.messageBody || e.messageTitle;
    el.append(head, body);

    if (e.detail) {
      const detail = document.createElement("div");
      detail.className = "activity-detail";
      detail.textContent = e.detail;
      el.append(detail);
    }

    // Failures stay until dismissed — they're the ones you'd act on. Others wait while you're
    // reading them: pointer over, focus inside, or the change list open.
    const countdown = STICKY.has(kind.tone) ? null : dismissTimer(TOAST_MS, () => dismiss(el));
    if (countdown) {
      el.addEventListener("pointerenter", () => countdown.hold("pointer"));
      el.addEventListener("pointerleave", () => countdown.release("pointer"));
      el.addEventListener("focusin", () => countdown.hold("focus"));
      el.addEventListener("focusout", (ev) => {
        if (!el.contains((ev as FocusEvent).relatedTarget as Node | null)) countdown.release("focus");
      });
    }
    if (changes) el.append(changesDisclosure(e.eventId, changes, (open) => (open ? countdown?.hold("open") : countdown?.release("open"))));

    const close = document.createElement("button");
    close.type = "button";
    close.className = "activity-close";
    close.setAttribute("aria-label", "Dismiss");
    close.textContent = "×";
    close.addEventListener("click", (ev) => {
      ev.preventDefault();
      ev.stopPropagation();
      countdown?.cancel();
      dismiss(el);
    });
    el.append(close);

    stack.prepend(el);
    while (stack.children.length > MAX_TOASTS) stack.lastElementChild?.remove();
  }

  const seen = new Set<string>();
  let since: string | null = null;
  let timer: number | undefined;
  let stopped = false;

  async function poll() {
    if (stopped || document.hidden) return;
    try {
      const q = since ? `?since=${encodeURIComponent(since)}` : "";
      const feed = await fetchApi<Feed>(`/api/platform/events/feed${q}`);
      since = feed.now;
      for (const e of feed.events) {
        if (seen.has(e.eventId)) continue;
        seen.add(e.eventId);
        const kind = KINDS[e.eventType];
        if (shouldShow(e, kind)) show(e, kind);
      }
      if (seen.size > SEEN_CAP) {
        for (const id of [...seen].slice(0, seen.size - SEEN_CAP)) seen.delete(id);
      }
    } catch (err) {
      // Signed out — stop asking. Anything else (a deploy, a blip) is retried on the next tick.
      if ((err as { status?: number })?.status === 401) stopped = true;
    }
  }

  function start() {
    if (timer === undefined) timer = window.setInterval(poll, POLL_MS);
  }
  function stop() {
    if (timer !== undefined) window.clearInterval(timer);
    timer = undefined;
  }

  // A hidden tab doesn't poll; on return it asks from where it left off, so nothing is lost.
  document.addEventListener("visibilitychange", () => {
    if (document.hidden) stop();
    else {
      poll();
      start();
    }
  });
  poll();
  start();
</script>

<style>
  /* Toasts are built by the script at runtime, so they don't carry this component's scope
     attribute — styles reach them through :global() under the (scoped) stack. */
  .activity-bell { padding: 6px 10px; line-height: 1; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  .activity-stack {
    position: fixed; top: 72px; right: 16px; z-index: 1100;
    display: flex; flex-direction: column; gap: 8px;
    width: min(380px, calc(100vw - 16px)); pointer-events: none;
  }
  /* The bubble's tail, drawn over the newest toast's top edge and pointing up at the bell. */
  .activity-stack::before {
    content: ""; position: absolute; top: -7px; right: var(--tail-right, 14px); z-index: 1;
    width: 12px; height: 12px; transform: rotate(45deg);
    background: var(--panel, var(--bg)); border-top: 1px solid var(--line); border-left: 1px solid var(--line);
  }
  .activity-stack:empty::before { display: none; }
  .activity-stack :global(.activity-toast) {
    position: relative; display: block; pointer-events: auto;
    padding: 10px 32px 10px 12px; border-radius: 10px;
    background: var(--panel, var(--bg)); color: inherit; text-decoration: none;
    border: 1px solid var(--line); border-left: 4px solid var(--accent-2);
    box-shadow: 0 6px 20px rgb(0 0 0 / 0.12);
    font-size: 13px; animation: activity-in 0.18s ease-out;
    transition: opacity 0.2s, transform 0.2s;
  }
  .activity-stack :global(.activity-toast.ok) { border-left-color: #16a34a; }
  .activity-stack :global(.activity-toast.warn) { border-left-color: #d97706; }
  .activity-stack :global(.activity-toast.err) { border-left-color: #dc2626; }
  .activity-stack :global(.activity-toast.leaving) { opacity: 0; transform: translateY(-6px); }
  .activity-stack :global(a.activity-toast:hover) { border-color: var(--muted); }
  .activity-stack :global(.activity-head) { display: flex; justify-content: space-between; gap: 8px; margin-bottom: 2px; }
  .activity-stack :global(.activity-head time) { color: var(--muted); font-size: 11px; white-space: nowrap; }
  .activity-stack :global(.activity-body) { overflow-wrap: anywhere; }
  .activity-stack :global(.activity-detail) { margin-top: 4px; color: #dc2626; font-size: 12px; overflow-wrap: anywhere; }
  .activity-stack :global(.activity-changes) { margin-top: 4px; }
  .activity-stack :global(.activity-changes-toggle) {
    border: 0; background: none; padding: 0; color: var(--muted); font: inherit; font-size: 12px; cursor: pointer;
  }
  .activity-stack :global(.activity-changes-toggle:hover) { color: inherit; text-decoration: underline; }
  .activity-stack :global(.activity-changes-toggle span) { display: inline-block; transition: transform 0.15s; }
  .activity-stack :global(.activity-changes-toggle[aria-expanded="true"] span) { transform: rotate(180deg); }
  .activity-stack :global(.activity-changes ul) {
    margin: 4px 0 0; padding: 0 0 0 16px; max-height: 180px; overflow-y: auto; font-size: 12px;
  }
  .activity-stack :global(.activity-changes li) { margin: 2px 0; overflow-wrap: anywhere; }
  .activity-stack :global(.activity-changes a) { color: inherit; }
  .activity-stack :global(.activity-changes-more) { list-style: none; color: var(--muted); }
  .activity-stack :global(.activity-close) {
    position: absolute; top: 4px; right: 6px; border: 0; background: none; color: var(--muted);
    font-size: 16px; line-height: 1; cursor: pointer; padding: 2px 4px;
  }
  @keyframes activity-in { from { opacity: 0; transform: translateY(-8px); } }
  @media (prefers-reduced-motion: reduce) {
    .activity-stack :global(.activity-toast) { animation: none; transition: none; }
    .activity-stack :global(.activity-changes-toggle span) { transition: none; }
  }
</style>
