---
/**
 * SchemaEditor Component
 * Visual editor for creating and modifying entry type schemas
 *
 * Usage:
 *   <SchemaEditor schema={existingSchema} />
 *
 * The schema is stored in a hidden input field as JSON and can be submitted with the form.
 */

import { getAuthToken } from "@/lib/api/client";
import { getEmbedProviders } from "@/lib/api/mediaEmbeds";

export interface Props {
  schema?: {
    fields: Array<{
      key: string;
      label: string;
      type: string;
      [key: string]: any;
    }>;
  } | null;
}

const { schema } = Astro.props;
const initialSchema = schema && typeof schema === "object" && "fields" in schema ? schema : { fields: [] };

// Available field types
// Note: Asset and Resource fields are managed through the entry UI sidebar, not schema
const fieldTypes = [
  { value: "text", label: "Text", description: "Single-line text input" },
  { value: "textarea", label: "Textarea", description: "Multi-line plain text" },
  { value: "markdown", label: "Markdown", description: "Markdown editor with preview" },
  { value: "number", label: "Number", description: "Numeric input" },
  { value: "boolean", label: "Boolean", description: "Checkbox toggle" },
  { value: "select", label: "Select", description: "Dropdown selection" },
  { value: "date", label: "Date", description: "Date picker" },
  { value: "datetime", label: "DateTime", description: "Date and time picker" },
  { value: "json", label: "JSON", description: "Free-form JSON data" },
  { value: "embed", label: "Media embed", description: "A video, audio or podcast link shown as a player" },
];

// Provider keys for the embed field's "Providers" hint. Best-effort: the editor works without them.
let embedProviders: Array<{ key: string; name: string }> = [];
try {
  const { providers } = await getEmbedProviders(getAuthToken(Astro.cookies));
  embedProviders = providers.map((p) => ({ key: p.key, name: p.name }));
} catch (e) {
  console.warn("[SchemaEditor] Could not load media embed providers:", e);
}
---

<div class="schema-editor">
  <div class="form-group">
    <label>Content Schema</label>
    <p class="form-help">Define the fields for this entry type. Fields will appear in the entry editor in the order shown below.</p>
  </div>

  <div id="fields-container" class="fields-container">
    <!-- Fields will be rendered here by client-side JS -->
  </div>

  <button type="button" id="add-field-btn" class="button secondary">
    + Add Field
  </button>

  <!-- Schema JSON Editor (always visible, at bottom) -->
  <div class="schema-json-editor">
    <label>Edit Schema JSON</label>
    <p class="form-help">Paste JSON schema here and click Apply to quickly create fields, or edit the JSON directly.</p>
    <textarea
      id="schema-preview-json"
      class="json-preview editable"
      rows="10"
      placeholder='{"fields": []}'
    >{JSON.stringify(initialSchema, null, 2)}</textarea>
    <button type="button" id="apply-json-btn" class="button secondary">Apply JSON to Form</button>
  </div>

  <!-- Hidden input to store the schema JSON for form submission -->
  <input
    type="hidden"
    name="schema_json"
    id="schema-json-input"
    value={JSON.stringify(initialSchema)}
  />
</div>

<style is:global>
  .schema-editor {
    display: grid;
    gap: 1.5rem;
  }

  .schema-editor .form-group {
    display: grid;
    gap: 0.5rem;
  }

  .schema-editor .form-group label {
    font-weight: 600;
    font-size: 0.875rem;
    color: var(--ink);
  }

  .schema-editor .field-label-hint {
    font-weight: 400;
    color: var(--muted, #6b7280);
  }

  .schema-editor .form-help {
    margin: 0;
    font-size: 0.75rem;
    color: var(--muted);
  }

  .schema-editor .fields-container {
    display: grid;
    gap: 1rem;
  }

  .schema-editor .field-editor {
    padding: 0;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 8px;
    overflow: hidden;
  }

  .schema-editor .field-editor-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.25rem;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }

  .schema-editor .field-editor-title {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-weight: 600;
    font-size: 0.875rem;
    color: var(--ink);
    flex: 1;
    flex-wrap: wrap;
  }

  .schema-editor .field-type-badge {
    padding: 0.25rem 0.625rem;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--muted);
  }

  .schema-editor .field-meta-inline {
    display: flex;
    gap: 0.75rem;
    font-weight: 400;
    font-size: 0.75rem;
    color: var(--muted);
  }

  .schema-editor .field-meta-item {
    font-style: italic;
  }

  .schema-editor .field-editor-actions {
    display: flex;
    gap: 0.5rem;
  }

  .schema-editor .field-editor-actions button {
    padding: 0.375rem 0.75rem;
    font-size: 0.75rem;
    border-radius: 6px;
  }

  .schema-editor .field-editor-body {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr 1fr;
    padding: 1.25rem;
  }

  .schema-editor .field-editor-body .full-width {
    grid-column: 1 / -1;
  }

  /* Match parent page form field styling */
  .schema-editor .field-editor-body input,
  .schema-editor .field-editor-body select,
  .schema-editor .field-editor-body textarea {
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--bg);
    font-size: 0.875rem;
    font-family: inherit;
  }

  .schema-editor .field-editor-body textarea {
    resize: vertical;
  }

  .schema-editor .field-editor-body input:focus,
  .schema-editor .field-editor-body select:focus,
  .schema-editor .field-editor-body textarea:focus {
    outline: none;
    border-color: var(--color-primary, #666);
  }

  /* Checkbox field override for Required checkbox */
  .schema-editor .checkbox-field {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding-top: 0.25rem;
  }

  .schema-editor .checkbox-field input[type="checkbox"] {
    width: 1rem;
    height: 1rem;
    cursor: pointer;
  }

  .schema-editor .checkbox-field label {
    cursor: pointer;
    user-select: none;
    margin: 0;
  }

  .schema-editor .schema-json-editor {
    display: grid;
    gap: 0.75rem;
    padding: 1.25rem;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 8px;
    margin-bottom: 1.5rem;
  }

  .schema-editor .schema-json-editor label {
    font-weight: 600;
    font-size: 0.875rem;
    color: var(--ink);
    margin: 0;
  }

  .schema-editor .json-preview {
    width: 100%;
    padding: 1rem;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 6px;
    font-family: 'SF Mono', Monaco, monospace;
    font-size: 0.75rem;
    overflow-x: auto;
    white-space: pre;
    resize: vertical;
  }

  .schema-editor .json-preview:focus {
    outline: none;
    border-color: var(--color-primary, #666);
  }

  .schema-editor .empty-state {
    padding: 3rem 2rem;
    text-align: center;
    background: var(--bg);
    border: 2px dashed var(--line);
    border-radius: 8px;
  }

  .schema-editor .empty-state-title {
    margin: 0 0 0.5rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--ink);
  }

  .schema-editor .empty-state-text {
    margin: 0;
    color: var(--muted);
    font-size: 0.875rem;
    line-height: 1.5;
  }
</style>

<script define:vars={{ initialSchema, fieldTypes, embedProviders }}>
  // Schema state
  let schema = JSON.parse(JSON.stringify(initialSchema));

  // Render the schema editor
  function render() {
    const container = document.getElementById('fields-container');
    const input = document.getElementById('schema-json-input');
    const preview = document.getElementById('schema-preview-json');

    if (!container || !input || !preview) return;

    // Update hidden input and preview
    input.value = JSON.stringify(schema);
    preview.textContent = JSON.stringify(schema, null, 2);

    // Clear container
    container.replaceChildren();

    // Show empty state if no fields
    if (schema.fields.length === 0) {
      container.append(
        el(
          'div',
          { className: 'empty-state' },
          el('p', { className: 'empty-state-title' }, 'No fields defined'),
          el(
            'p',
            { className: 'empty-state-text' },
            'Add your first field to define the content structure for this entry type.',
          ),
        ),
      );
      return;
    }

    // Render each field
    schema.fields.forEach((field, index) => {
      const fieldEl = createFieldEditor(field, index);
      container.appendChild(fieldEl);
    });
  }

  // Build an element. `props` are DOM properties (className, type, placeholder, defaultValue…) and string
  // children become text nodes, so a field's label, key, placeholder, help text or AI hint — strings anyone
  // who edits entry types can set — is always text, never markup.
  function el(tag, props, ...children) {
    const node = Object.assign(document.createElement(tag), props);
    node.append(...children);
    return node;
  }

  const groupClass = (extraClass) => (extraClass ? `form-group ${extraClass}` : 'form-group');

  // A labelled control: <div class="form-group …"><label>…</label>…controls</div>.
  function formGroup(extraClass, label, ...controls) {
    return el('div', { className: groupClass(extraClass) }, el('label', {}, ...[].concat(label)), ...controls);
  }

  // A checkbox row: the box first, then its label.
  function checkboxGroup(extraClass, box, ...label) {
    const className = groupClass(extraClass ? `checkbox-field ${extraClass}` : 'checkbox-field');
    return el('div', { className }, box, el('label', {}, ...label));
  }

  const formHelp = (text) => el('p', { className: 'form-help' }, text);
  const labelHint = (text) => el('span', { className: 'field-label-hint' }, text);

  // The header's "Placeholder: … / Help: … / AI: …" summary items for a field.
  function fieldMetaItems(field) {
    return [
      ['Placeholder', field.placeholder],
      ['Help', field.helpText],
      ['AI', field.aiHint],
    ]
      .filter(([, value]) => value)
      .map(([name, value]) => el('span', { className: 'field-meta-item' }, `${name}: ${value}`));
  }

  // Create field editor element
  function createFieldEditor(field, index) {
    const div = document.createElement('div');
    div.className = 'field-editor';
    div.dataset.index = index;

    const typeInfo = fieldTypes.find(t => t.value === field.type) || { label: field.type };

    const title = el(
      'div',
      { className: 'field-editor-title' },
      el('span', { className: 'field-title-label' }, field.label || 'Untitled Field'),
      el('span', { className: 'field-type-badge' }, `${typeInfo.label}${field.required ? ' *' : ''}`),
    );
    const metaItems = fieldMetaItems(field);
    if (metaItems.length) title.append(el('span', { className: 'field-meta-inline' }, ...metaItems));

    const actionButton = (className, text) => el('button', { type: 'button', className: `button secondary ${className}` }, text);
    const actions = el('div', { className: 'field-editor-actions' });
    if (index > 0) actions.append(actionButton('btn-move-up', '↑'));
    if (index < schema.fields.length - 1) actions.append(actionButton('btn-move-down', '↓'));
    actions.append(actionButton('btn-remove', 'Remove'));

    // Values go in as defaultValue / defaultChecked / defaultSelected: the same `value` / `checked` /
    // `selected` attributes the markup used to carry, set as data.
    const inputEl = (className, defaultValue, placeholder, extra) =>
      el('input', { type: 'text', className, defaultValue, placeholder, ...extra });
    const textarea = (className, defaultValue, placeholder) =>
      el('textarea', { className, rows: 2, placeholder, defaultValue });
    const checkbox = (className, defaultChecked) => el('input', { type: 'checkbox', className, defaultChecked });

    const body = el(
      'div',
      { className: 'field-editor-body' },
      formGroup(
        '',
        'Label *',
        inputEl('field-label', field.label || '', 'e.g., Body, Title', { required: true }),
        formHelp('Display name in the editor'),
      ),
      formGroup(
        '',
        'Field Key *',
        inputEl('field-key', field.key || '', 'e.g., body, title', { required: true }),
        formHelp('Auto-generated from label (editable)'),
      ),
      formGroup(
        '',
        'Field Type *',
        el(
          'select',
          { className: 'field-type', required: true },
          ...fieldTypes.map(t => new Option(t.label, t.value, t.value === field.type, t.value === field.type)),
        ),
      ),
      checkboxGroup('', checkbox('field-required', !!field.required), 'Required field'),
      formGroup('full-width', 'Placeholder Text', inputEl('field-placeholder', field.placeholder || '', 'Optional hint text')),
      formGroup(
        'full-width',
        'Help Text',
        textarea('field-help-text', field.helpText || '', 'Optional description for editors'),
      ),
      formGroup(
        'full-width',
        ['AI Guidance ', labelHint('— shown only to AI when authoring this field')],
        textarea(
          'field-ai-hint',
          field.aiHint || '',
          'e.g., 2-3 short paragraphs, first person, name the material, no marketing adjectives',
        ),
      ),
    );

    if (field.type === 'select') {
      body.append(
        formGroup(
          'full-width',
          'Options (comma-separated) *',
          inputEl('field-options', (field.options || []).join(', '), 'e.g., draft, published', { required: true }),
        ),
      );
    }
    if (field.type === 'markdown') {
      body.append(
        checkboxGroup(
          'full-width',
          checkbox('field-auto-embed', field.autoEmbed !== false),
          'Auto-embed media links ',
          labelHint('— a YouTube, Vimeo, Spotify… link on its own line shows as a player'),
        ),
      );
    }
    if (field.type === 'embed') {
      body.append(
        formGroup(
          'full-width',
          'Providers (comma-separated)',
          inputEl('field-providers', (field.providers || []).join(', '), 'Leave empty to accept every supported provider'),
          formHelp(
            embedProviders.length
              ? 'Available: ' + embedProviders.map(p => `${p.key} (${p.name})`).join(', ')
              : 'Provider keys, e.g. youtube, vimeo, spotify',
          ),
        ),
      );
    }
    if (field.type === 'number') {
      body.append(
        formGroup('', 'Min Value', inputEl('field-min', field.min ?? '', 'Optional', { type: 'number' })),
        formGroup('', 'Max Value', inputEl('field-max', field.max ?? '', 'Optional', { type: 'number' })),
      );
    }

    div.append(el('div', { className: 'field-editor-header' }, title, actions), body);

    // Attach event listeners
    const moveUpBtn = div.querySelector('.btn-move-up');
    const moveDownBtn = div.querySelector('.btn-move-down');
    const removeBtn = div.querySelector('.btn-remove');

    if (moveUpBtn) moveUpBtn.addEventListener('click', () => moveField(index, -1));
    if (moveDownBtn) moveDownBtn.addEventListener('click', () => moveField(index, 1));
    if (removeBtn) removeBtn.addEventListener('click', () => removeField(index));

    // Track if key has been manually edited
    const keyInput = div.querySelector('.field-key');
    const labelInput = div.querySelector('.field-label');
    let keyManuallyEdited = !!field.key; // If field has a key already, consider it manually set

    // Auto-generate key from label (like slug)
    labelInput.addEventListener('input', () => {
      if (!keyManuallyEdited) {
        const generatedKey = labelInput.value
          .toLowerCase()
          .trim()
          .replace(/[^\w\s-]/g, '')
          .replace(/[\s-]+/g, '_')
          .replace(/^_+|_+$/g, '');
        keyInput.value = generatedKey;
      }
      updateField(index, div);
    });

    // Mark key as manually edited if user types in it
    keyInput.addEventListener('input', () => {
      keyManuallyEdited = true;
      updateField(index, div);
    });

    // Update field on other input changes (placeholder, help text, type, required, etc.)
    div.querySelectorAll('.field-placeholder, .field-help-text, .field-ai-hint, .field-type, .field-required, .field-options, .field-min, .field-max, .field-providers, .field-auto-embed').forEach(input => {
      input.addEventListener('input', () => updateField(index, div));
    });

    // Type-specific settings (options, min/max, providers, auto-embed) depend on the type: redraw on change.
    div.querySelector('.field-type').addEventListener('change', () => render());

    return div;
  }

  // Update field from DOM
  function updateField(index, fieldEl) {
    const field = schema.fields[index];

    field.key = fieldEl.querySelector('.field-key').value.trim();
    field.label = fieldEl.querySelector('.field-label').value.trim();
    field.type = fieldEl.querySelector('.field-type').value;
    field.required = fieldEl.querySelector('.field-required').checked;
    field.placeholder = fieldEl.querySelector('.field-placeholder').value.trim() || undefined;
    field.helpText = fieldEl.querySelector('.field-help-text').value.trim() || undefined;
    field.aiHint = fieldEl.querySelector('.field-ai-hint').value.trim() || undefined;

    // Type-specific fields
    if (field.type === 'select') {
      const optionsInput = fieldEl.querySelector('.field-options');
      if (optionsInput) {
        field.options = optionsInput.value.split(',').map(s => s.trim()).filter(Boolean);
      }
    }

    // Embed fields may limit providers (registry keys; empty = all). Only embed fields carry the key.
    if (field.type === 'embed') {
      const providersInput = fieldEl.querySelector('.field-providers');
      if (providersInput) {
        const keys = providersInput.value.split(',').map(s => s.trim().toLowerCase()).filter(Boolean);
        if (keys.length) field.providers = keys;
        else delete field.providers;
      }
    } else {
      delete field.providers;
    }

    // Markdown auto-embed is on unless explicitly off — store only `autoEmbed: false`.
    if (field.type === 'markdown') {
      const autoEmbedInput = fieldEl.querySelector('.field-auto-embed');
      if (autoEmbedInput) {
        if (autoEmbedInput.checked) delete field.autoEmbed;
        else field.autoEmbed = false;
      }
    } else {
      delete field.autoEmbed;
    }

    if (field.type === 'number') {
      const minInput = fieldEl.querySelector('.field-min');
      const maxInput = fieldEl.querySelector('.field-max');
      if (minInput && minInput.value) field.min = parseFloat(minInput.value);
      if (maxInput && maxInput.value) field.max = parseFloat(maxInput.value);
    }

    // Update the card header title live
    const headerTitle = fieldEl.querySelector('.field-title-label');
    if (headerTitle) {
      headerTitle.textContent = field.label || 'Untitled Field';
    }

    // Update the type badge with required indicator
    const typeBadge = fieldEl.querySelector('.field-type-badge');
    if (typeBadge) {
      const typeInfo = fieldTypes.find(t => t.value === field.type) || { label: field.type };
      typeBadge.textContent = typeInfo.label + (field.required ? ' *' : '');
    }

    // Update or create the inline meta info
    let metaInline = fieldEl.querySelector('.field-meta-inline');
    const titleSection = fieldEl.querySelector('.field-editor-title');

    const metaItems = fieldMetaItems(field);
    if (metaItems.length) {
      if (!metaInline) {
        metaInline = el('span', { className: 'field-meta-inline' });
        titleSection.appendChild(metaInline);
      }
      metaInline.replaceChildren(...metaItems);
    } else if (metaInline) {
      metaInline.remove();
    }

    // Update hidden input and preview
    document.getElementById('schema-json-input').value = JSON.stringify(schema);
    document.getElementById('schema-preview-json').textContent = JSON.stringify(schema, null, 2);
  }

  // Add new field
  function addField() {
    schema.fields.push({
      key: '',
      label: '',
      type: 'text',
      required: false,
    });
    render();
  }

  // Remove field
  function removeField(index) {
    if (confirm('Remove this field?')) {
      schema.fields.splice(index, 1);
      render();
    }
  }

  // Move field
  function moveField(index, direction) {
    const newIndex = index + direction;
    if (newIndex < 0 || newIndex >= schema.fields.length) return;

    const temp = schema.fields[index];
    schema.fields[index] = schema.fields[newIndex];
    schema.fields[newIndex] = temp;

    render();
  }

  // Apply JSON from textarea
  function applyJson() {
    const jsonTextarea = document.getElementById('schema-preview-json');
    if (!jsonTextarea) return;

    try {
      const parsed = JSON.parse(jsonTextarea.value);
      if (!parsed.fields || !Array.isArray(parsed.fields)) {
        alert('Invalid schema format. Must have a "fields" array.');
        return;
      }
      schema = parsed;
      render();
    } catch (e) {
      alert('Invalid JSON: ' + e.message);
    }
  }

  // Initialize
  document.addEventListener('DOMContentLoaded', () => {
    render();

    const addBtn = document.getElementById('add-field-btn');
    if (addBtn) {
      addBtn.addEventListener('click', addField);
    }

    const applyJsonBtn = document.getElementById('apply-json-btn');
    if (applyJsonBtn) {
      applyJsonBtn.addEventListener('click', applyJson);
    }
  });
</script>
