---
// The hamburger that opens the layout's sidebar as an off-canvas drawer on compact screens
// (≤920px, the breakpoint global.css already uses for the shell). On wider screens the button is
// hidden and the sidebar is the ordinary sticky column, so none of this applies.
interface Props {
  /** id of the <aside> this button opens. */
  controls: string;
}
const { controls } = Astro.props;
---

<button
  type="button"
  class="button secondary nav-toggle"
  id="nav-toggle"
  aria-controls={controls}
  aria-expanded="false"
  aria-label="Open navigation"
>
  <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
    <path d="M4 6h16M4 12h16M4 18h16"></path>
  </svg>
</button>
<div class="nav-backdrop" id="nav-backdrop" hidden></div>

<script>
  const COMPACT = window.matchMedia("(max-width: 920px)");
  const toggle = document.getElementById("nav-toggle") as HTMLButtonElement;
  const backdrop = document.getElementById("nav-backdrop") as HTMLElement;
  const drawer = document.getElementById(toggle.getAttribute("aria-controls") ?? "") as HTMLElement | null;
  // Rendered inside the top bar, whose backdrop-filter makes it the containing block for
  // position: fixed — which would pin the backdrop to the bar instead of the window. Lift it out.
  document.body.appendChild(backdrop);

  const isOpen = () => toggle.getAttribute("aria-expanded") === "true";

  function setOpen(open: boolean, { restoreFocus = true } = {}) {
    if (!drawer || open === isOpen()) return;
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Close navigation" : "Open navigation");
    // On <html> so the drawer rules and the scroll lock key off one class.
    document.documentElement.classList.toggle("nav-open", open);
    backdrop.hidden = !open;
    if (open) {
      // The drawer is visibility:hidden while closed; focus once it has been made visible.
      requestAnimationFrame(() => {
        const current = drawer.querySelector<HTMLElement>('[aria-current="page"]');
        (current ?? drawer.querySelector<HTMLElement>("a, button"))?.focus();
      });
    } else if (restoreFocus) {
      toggle.focus();
    }
  }

  toggle.addEventListener("click", () => setOpen(!isOpen()));
  backdrop.addEventListener("click", () => setOpen(false));
  // While open the drawer behaves as a modal: Escape closes it and Tab cycles within it.
  document.addEventListener("keydown", (e) => {
    if (!drawer || !isOpen()) return;
    if (e.key === "Escape") {
      setOpen(false);
      return;
    }
    if (e.key !== "Tab") return;
    const focusable = [...drawer.querySelectorAll<HTMLElement>("a[href], button:not([disabled])")].filter((el) => el.offsetParent !== null);
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    const active = document.activeElement;
    if (e.shiftKey && (active === first || !drawer.contains(active))) {
      e.preventDefault();
      last?.focus();
    } else if (!e.shiftKey && (active === last || !drawer.contains(active))) {
      e.preventDefault();
      first?.focus();
    }
  });
  // A link click navigates away anyway; closing first keeps a slow navigation (or an in-page
  // anchor) from leaving the drawer over the page.
  drawer?.addEventListener("click", (e) => {
    if ((e.target as Element).closest("a[href]")) setOpen(false, { restoreFocus: false });
  });
  COMPACT.addEventListener("change", (e) => {
    if (!e.matches) setOpen(false, { restoreFocus: false });
  });
</script>
