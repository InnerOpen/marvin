---
import AudioRecorder from "@/components/AudioRecorder.astro";
import ImageCropper from "@/components/ImageCropper.astro";
import { type CueOption } from "./schema-fields/CueListField.astro";
import SchemaFormField from "./SchemaFormField.astro";
import { groupFields } from "@/lib/fieldGroups";
import type { CueSpec } from "@/lib/cueFields";
/**
 * SchemaForm Component
 * Dynamically renders a form based on an entry type's schema definition
 */
import type { LinkedItem } from "@/lib/linkedItems";
import type { RefOption } from "@/lib/refFields";

export interface FieldSchema {
  key: string;
  label: string;
  type: string;
  required?: boolean;
  defaultValue?: any;
  placeholder?: string;
  helpText?: string;
  readOnly?: boolean;
  [key: string]: any;
}

export interface Props {
  schema: {
    fields: FieldSchema[];
  } | null;
  values?: Record<string, any>;
  errors?: Record<string, string>;
  /** The workspace's assets and resources, for the asset / resource fields' pickers (lib/linkedItems.ts shapes them). */
  assets?: LinkedItem[];
  resources?: LinkedItem[];
  /** JSON fields that place other entries in time (a beat's sounds), edited as cue lists: by field key, the shape and the options. */
  cues?: Record<string, { spec: CueSpec; options: CueOption[] }>;
  /** Text fields that hold another entry's slug (`ref`), offered as a pick list: by field key, that type's entries (lib/refFieldsApi.ts). */
  refs?: Record<string, RefOption[]>;
}

const { schema, values = {}, errors = {}, assets = [], resources = [], cues = {}, refs = {} } = Astro.props;
// An asset field can upload from its own dialog, which sends a picture through the page's cropper: one cropper per page, only when needed.
const hasAssetField = (schema.fields ?? []).some((f: { type?: string }) => f.type === "asset" || f.type === "asset-list");

// If no schema provided, show empty state
if (!schema?.fields || schema.fields.length === 0) {
  // Don't render anything - parent component should handle empty state
  return;
}

// Helper to get field value from nested dataJson
function getFieldValue(key: string) {
  return values[key];
}

// Helper to get field error
function getFieldError(key: string) {
  return errors[key];
}

// A field may name a `group` (lib/fieldGroups.ts): its fields then sit in one collapsible section, folded until a field in it has an error.
const segments = groupFields(schema.fields, values, errors);
---

<div class="schema-form">
  {segments.map((seg) =>
    seg.group === null ? (
      <SchemaFormField field={seg.fields[0] as any} value={getFieldValue(seg.fields[0].key)} error={getFieldError(seg.fields[0].key)} assets={assets} resources={resources} cues={cues} refs={refs} />
    ) : (
      <details class="field-section" open={seg.open}>
        <summary>
          <span class="field-section-name">{seg.group}</span>
          <span class="field-section-count">{seg.filled} of {seg.fields.length} filled</span>
        </summary>
        <div class="field-section-body">
          {seg.fields.map((f) => (
            <SchemaFormField field={f as any} value={getFieldValue(f.key)} error={getFieldError(f.key)} assets={assets} resources={resources} cues={cues} refs={refs} />
          ))}
        </div>
      </details>
    ),
  )}
</div>
{hasAssetField && <ImageCropper />}
{hasAssetField && <AudioRecorder />}

<style>
  .field-section { border: 1px solid var(--line); border-radius: var(--radius, 8px); background: var(--panel, transparent); }
  .field-section > summary { display: flex; justify-content: space-between; gap: 1rem; align-items: baseline; padding: 0.75rem 1rem; cursor: pointer; list-style: none; font-weight: 600; }
  .field-section > summary::-webkit-details-marker { display: none; }
  .field-section > summary::before { content: "▸"; margin-right: 0.5rem; color: var(--muted); }
  .field-section[open] > summary::before { content: "▾"; }
  .field-section-count { font-weight: 400; font-size: 0.8125rem; color: var(--muted); margin-left: auto; }
  .field-section-body { display: grid; gap: 1.5rem; padding: 0.25rem 1rem 1rem; }
  .schema-form {
    display: grid;
    gap: 1.5rem;
  }

  .field-group {
    display: grid;
    gap: 0.5rem;
  }

  .field-group label {
    font-weight: 600;
    font-size: 0.875rem;
    color: var(--ink);
  }

  .required {
    color: var(--color-error);
    margin-left: 2px;
  }

  .unsupported-message,
  .error-message {
    padding: 1rem;
    background: var(--muted-bg);
    border: 1px solid var(--line);
    border-radius: 6px;
  }

  .unsupported-message p,
  .error-message p {
    margin: 0;
    font-size: 0.875rem;
  }

  .unsupported-message p + p {
    margin-top: 0.5rem;
  }

  .muted {
    color: var(--muted);
  }

  .error-message {
    background: var(--color-error-bg);
    border-color: var(--color-error);
    color: var(--color-error);
  }
</style>
