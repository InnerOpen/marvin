---
import BooleanField from "./schema-fields/BooleanField.astro";
import DateField from "./schema-fields/DateField.astro";
import DateTimeField from "./schema-fields/DateTimeField.astro";
import EmbedField from "./schema-fields/EmbedField.astro";
import AudioRecorder from "@/components/AudioRecorder.astro";
import ImageCropper from "@/components/ImageCropper.astro";
import CueListField, { type CueOption } from "./schema-fields/CueListField.astro";
import LinkedItemsField from "./schema-fields/LinkedItemsField.astro";
import type { CueSpec } from "@/lib/cueFields";
import MarkdownField from "./schema-fields/MarkdownField.astro";
import NumberField from "./schema-fields/NumberField.astro";
import RefField from "./schema-fields/RefField.astro";
import SelectField from "./schema-fields/SelectField.astro";
import TextareaField from "./schema-fields/TextareaField.astro";
/**
 * SchemaForm Component
 * Dynamically renders a form based on an entry type's schema definition
 */
import TextField from "./schema-fields/TextField.astro";
import type { LinkedItem } from "@/lib/linkedItems";
import type { RefOption } from "@/lib/refFields";

export interface FieldSchema {
  key: string;
  label: string;
  type: string;
  required?: boolean;
  defaultValue?: any;
  placeholder?: string;
  helpText?: string;
  readOnly?: boolean;
  [key: string]: any;
}

export interface Props {
  schema: {
    fields: FieldSchema[];
  } | null;
  values?: Record<string, any>;
  errors?: Record<string, string>;
  /** The workspace's assets and resources, for the asset / resource fields' pickers (lib/linkedItems.ts shapes them). */
  assets?: LinkedItem[];
  resources?: LinkedItem[];
  /** JSON fields that place other entries in time (a beat's sounds), edited as cue lists: by field key, the shape and the options. */
  cues?: Record<string, { spec: CueSpec; options: CueOption[] }>;
  /** Text fields that hold another entry's slug (`ref`), offered as a pick list: by field key, that type's entries (lib/refFieldsApi.ts). */
  refs?: Record<string, RefOption[]>;
}

const { schema, values = {}, errors = {}, assets = [], resources = [], cues = {}, refs = {} } = Astro.props;
// An asset field can upload from its own dialog, which sends a picture through the page's cropper: one cropper per page, only when needed.
const hasAssetField = (schema.fields ?? []).some((f: { type?: string }) => f.type === "asset" || f.type === "asset-list");

// If no schema provided, show empty state
if (!schema?.fields || schema.fields.length === 0) {
  // Don't render anything - parent component should handle empty state
  return;
}

// Helper to get field value from nested dataJson
function getFieldValue(key: string) {
  return values[key];
}

// Helper to get field error
function getFieldError(key: string) {
  return errors[key];
}
---

<div class="schema-form">
  {schema.fields.map((field) => {
    const value = getFieldValue(field.key);
    const error = getFieldError(field.key);

    // Render appropriate component based on field type
    switch (field.type) {
      case 'text':
        if (field.ref && refs[field.key] && !field.readOnly) return <RefField field={field as any} value={value} error={error} options={refs[field.key]} />;
        return <TextField field={field as any} value={value} error={error} />;

      case 'textarea':
        return <TextareaField field={field as any} value={value} error={error} />;

      case 'markdown':
        return <MarkdownField field={field as any} value={value} error={error} />;

      case 'number':
        return <NumberField field={field as any} value={value} error={error} />;

      case 'boolean':
        return <BooleanField field={field as any} value={value} error={error} />;

      case 'select':
        return <SelectField field={field as any} value={value} error={error} />;

      case 'date':
        return <DateField field={field as any} value={value} error={error} />;

      case 'datetime':
        return <DateTimeField field={field as any} value={value} error={error} />;

      case 'asset':
      case 'asset-list':
        return <LinkedItemsField field={field as any} value={value} error={error} items={assets} />;

      case 'embed':
        return <EmbedField field={field as any} value={value} error={error} />;

      case 'resource':
      case 'resource-list':
        return <LinkedItemsField field={field as any} value={value} error={error} items={resources} />;

      case 'json':
        if (cues[field.key]) return <CueListField field={field as any} value={value} spec={cues[field.key].spec} options={cues[field.key].options} error={error} />;
        // JSON field - allow free-form JSON input
        return (
          <div class="field-group">
            <label>
              {field.label}
              {field.required && <span class="required">*</span>}
            </label>
            <textarea
              name={`dataJson.${field.key}`}
              placeholder="Enter valid JSON"
              rows="6"
              required={field.required}
              class="field-textarea json-field"
            >{value ? JSON.stringify(value, null, 2) : ''}</textarea>
            <p class="field-help">{field.helpText || 'Enter valid JSON data'}</p>
          </div>
        );

      default:
        // Unknown field type
        return (
          <div class="field-group unknown">
            <label>{field.label}</label>
            <div class="error-message">
              <p><strong>Unknown field type:</strong> {field.type}</p>
              <p class="muted">This field type is not recognized. Please check the schema definition.</p>
            </div>
          </div>
        );
    }
  })}
</div>
{hasAssetField && <ImageCropper />}
{hasAssetField && <AudioRecorder />}

<style>
  .schema-form {
    display: grid;
    gap: 1.5rem;
  }

  .field-group {
    display: grid;
    gap: 0.5rem;
  }

  .field-group label {
    font-weight: 600;
    font-size: 0.875rem;
    color: var(--ink);
  }

  .required {
    color: var(--color-error);
    margin-left: 2px;
  }

  .unsupported-message,
  .error-message {
    padding: 1rem;
    background: var(--muted-bg);
    border: 1px solid var(--line);
    border-radius: 6px;
  }

  .unsupported-message p,
  .error-message p {
    margin: 0;
    font-size: 0.875rem;
  }

  .unsupported-message p + p {
    margin-top: 0.5rem;
  }

  .muted {
    color: var(--muted);
  }

  .error-message {
    background: var(--color-error-bg);
    border-color: var(--color-error);
    color: var(--color-error);
  }
</style>
