---
import { acceptsAudio } from "@/lib/acceptKind";
/**
 * A drop zone for one file in a plain form, the look of the Assets upload page and the asset field's dialog: click or drop, then the
 * file's name (and a thumbnail for a picture) shows with a Change button. The file rides in a hidden `<input type="file">` of the given
 * name, so the form posts exactly as it did with a bare file chooser. A required zone stops the submit and shows itself when empty,
 * because a hidden required input would stop it silently.
 */
interface Props {
  name?: string;
  accept?: string;
  required?: boolean;
  /** The second line: what kind of file goes here. */
  hint?: string;
  /** The name of another field in the same form that names what is being added (e.g. a title box): a recording is named from it. */
  nameFrom?: string;
}

const { name = "file", accept, required = true, hint = "One file.", nameFrom } = Astro.props;
// A zone that takes a sound offers "Record…" too, when the page has the recorder (components/AudioRecorder.astro); the script shows it.
const recordable = acceptsAudio(accept);
---

<div class="file-drop" data-file-drop data-required={required ? "1" : undefined} data-name-from={nameFrom} role="button" tabindex="0" aria-label="Choose a file, or drop one here">
  <input type="file" name={name} accept={accept} hidden data-file-drop-input />
  <div class="file-drop-empty" data-file-drop-empty>
    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
      <polyline points="17 8 12 3 7 8"></polyline>
      <line x1="12" y1="3" x2="12" y2="15"></line>
    </svg>
    <p><strong>Click to upload or drag and drop</strong></p>
    <p class="field-help">{hint}</p>
    {recordable && <p class="file-drop-or"><button type="button" class="button secondary small" data-file-drop-record hidden>Record…</button></p>}
  </div>
  <div class="file-drop-picked" data-file-drop-picked hidden>
    <img alt="" hidden data-file-drop-thumb />
    <p class="file-drop-name" data-file-drop-name></p>
    <div class="file-drop-buttons">
      <button type="button" class="button secondary small">Change file</button>
      {recordable && <button type="button" class="button secondary small" data-file-drop-record hidden>Record again…</button>}
    </div>
  </div>
</div>

<style>
  .file-drop { border: 2px dashed var(--line); border-radius: var(--radius, 10px); padding: 1.5rem; text-align: center; cursor: pointer; transition: border-color 0.2s, background-color 0.2s; }
  .file-drop:hover, .file-drop:focus-visible { border-color: var(--ink); background: var(--panel-2); outline: none; }
  .file-drop.dragover { border-color: var(--accent, var(--brand)); background: var(--panel-2); }
  .file-drop.invalid { border-color: var(--color-error, #c0392b); }
  .file-drop-empty svg { color: var(--muted); }
  .file-drop-empty p { margin: 0.5rem 0 0; }
  .file-drop-picked { display: flex; flex-direction: column; align-items: center; gap: 0.5rem; }
  /* display: flex beat the hidden attribute, so an empty zone showed "Change file" too. */
  .file-drop-picked[hidden], .file-drop [hidden] { display: none; }
  .file-drop-picked img { max-width: 100%; max-height: 220px; border-radius: var(--radius, 10px); object-fit: contain; }
  .file-drop-name { margin: 0; font-size: 0.875rem; color: var(--muted); overflow-wrap: anywhere; }
  .file-drop-buttons { display: flex; flex-wrap: wrap; gap: 0.5rem; justify-content: center; }
  .file-drop-or { margin: 0.75rem 0 0; }
</style>

<script>
  type RecorderApi = { open: (options?: { suggestedName?: string }) => Promise<File | null> };

  function wire(zone: HTMLElement) {
    const input = zone.querySelector<HTMLInputElement>("[data-file-drop-input]")!;
    const empty = zone.querySelector<HTMLElement>("[data-file-drop-empty]")!;
    const picked = zone.querySelector<HTMLElement>("[data-file-drop-picked]")!;
    const thumb = zone.querySelector<HTMLImageElement>("[data-file-drop-thumb]")!;
    const nameLine = zone.querySelector<HTMLElement>("[data-file-drop-name]")!;
    let thumbUrl: string | null = null;

    const show = () => {
      const file = input.files?.[0];
      if (thumbUrl) URL.revokeObjectURL(thumbUrl);
      thumbUrl = file && file.type.startsWith("image/") ? URL.createObjectURL(file) : null;
      thumb.hidden = !thumbUrl;
      if (thumbUrl) thumb.src = thumbUrl;
      nameLine.textContent = file ? `${file.name} · ${(file.size / 1024).toFixed(0)} KB` : "";
      empty.hidden = !!file;
      picked.hidden = !file;
      if (file) zone.classList.remove("invalid");
      zone.dispatchEvent(new CustomEvent("filedrop:change", { bubbles: true, detail: { hasFile: !!file } })); // a form can enable its buttons by whether there is a file
    };

    const take = (file: File) => {
      const one = new DataTransfer();
      one.items.add(file);
      input.files = one.files;
      // A recording knows how long it ran: keep that beside the file, so a form can pass it on (a picked file has no such clock).
      const facts = (window as unknown as { AudioRecorder?: { metadataOf?: (f: File) => { recording?: { duration_seconds?: number } } | null } }).AudioRecorder?.metadataOf?.(file);
      const seconds = facts?.recording?.duration_seconds;
      if (typeof seconds === "number" && seconds > 0) input.dataset.seconds = String(seconds);
      else delete input.dataset.seconds;
      show();
    };
    input.addEventListener("change", () => delete input.dataset.seconds); // a file picked from disk replaces a recording

    // "Record…": a take from the page's recorder stands in for a picked file. The recorder's script may run after this one, so the
    // buttons show once the page is ready, and the recorder is looked up again at click time.
    const recordButtons = [...zone.querySelectorAll<HTMLButtonElement>("[data-file-drop-record]")];
    const recorder = () => (window as unknown as { AudioRecorder?: RecorderApi }).AudioRecorder;
    const revealRecord = () => recordButtons.forEach((b) => (b.hidden = !recorder()));
    if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", revealRecord);
    else setTimeout(revealRecord);
    recordButtons.forEach((button) =>
      button.addEventListener("click", async () => {
        const open = recorder()?.open;
        if (!open) return;
        // Named for what the person typed in the form's name box, else the file already chosen; never left as "recording".
        const typed = zone.dataset.nameFrom ? zone.closest("form")?.querySelector<HTMLInputElement>(`[name="${zone.dataset.nameFrom}"]`)?.value.trim() : "";
        const file = await open({ suggestedName: typed || input.files?.[0]?.name.replace(/\.[a-z0-9]+$/i, "") || undefined });
        if (file) take(file);
      }),
    );

    // A programmatic input.click() bubbles back up here, so the input's own click is let through untouched; a Record button is not
    // a request to pick a file.
    zone.addEventListener("click", (e) => {
      if (e.target === input || (e.target as Element | null)?.closest?.("[data-file-drop-record]")) return;
      input.click();
    });
    zone.addEventListener("keydown", (e) => {
      if ((e.target as Element | null)?.closest?.("[data-file-drop-record]")) return;
      if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        input.click();
      }
    });
    input.addEventListener("change", show);
    zone.addEventListener("dragover", (e) => {
      e.preventDefault();
      zone.classList.add("dragover");
    });
    zone.addEventListener("dragleave", (e) => {
      if (!zone.contains(e.relatedTarget as Node)) zone.classList.remove("dragover");
    });
    zone.addEventListener("drop", (e) => {
      e.preventDefault();
      zone.classList.remove("dragover");
      const dropped = e.dataTransfer?.files;
      if (dropped?.length) take(dropped[0]);
    });
    zone.closest("form")?.addEventListener("submit", (e) => {
      if (zone.dataset.required && !input.files?.length) {
        e.preventDefault();
        zone.classList.add("invalid");
        zone.focus();
      }
    });
  }

  document.addEventListener("dragover", (e) => e.preventDefault());
  document.addEventListener("drop", (e) => e.preventDefault());
  document.querySelectorAll<HTMLElement>("[data-file-drop]").forEach(wire);
</script>
