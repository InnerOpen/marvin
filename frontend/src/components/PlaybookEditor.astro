---
// The Playbook editor: the Agent Skills standard fields (name, description, license, compatibility, allowed tools, manual only) and the
// markdown body. Used by the New page and the edit page. It saves through the entries API (lib/api/playbooks.ts) and checks the
// fields with lib/playbooks.ts, the same checks the page shows as you type; a body past about 500 lines gets a warning, never a block.
import { type PlaybookForm, actionsFor, BODY_LINES_ADVISED, COMPATIBILITY_MAX, DESCRIPTION_MAX, NAME_MAX, lengthWarning, statusHint, statusLabel, statusTone } from "@/lib/playbooks";

interface Props {
  form: PlaybookForm;
  /** The entry's id and status; both absent for a new Playbook. */
  id?: string | null;
  status?: string | null;
  /** Whether the caller is an Admin: only they publish, unpublish or change a published Playbook. */
  canPublish?: boolean;
}
const { form, id = null, status = null, canPublish = true } = Astro.props;
const isNew = !id;
const actions = actionsFor(status, isNew, canPublish);
const warning = lengthWarning(form.body);
---

<form id="playbook-form" class="pb-form section-card" data-id={id ?? ""} data-status={status ?? ""} novalidate>
  {!isNew && (
    <p class="pb-status">
      <span class:list={["pill", statusTone(status)]}>{statusLabel(status)}</span>
      <span class="pb-hint">{statusHint(status)}</span>
    </p>
  )}

  {form.replaces && (
    <p class="pb-hint" data-testid="playbook-replaces">
      Proposed change to <strong>{form.replaces}</strong>. Publishing it replaces that Playbook's text and archives this draft.
      <input type="hidden" name="replaces" value={form.replaces} />
      <button type="button" class="button secondary" data-action="clear-replaces">Publish as a new Playbook instead</button>
    </p>
  )}

  <div class="pb-field">
    <label class="label" for="pb-name">Name</label>
    <input class="input" id="pb-name" name="name" value={form.name} maxlength={NAME_MAX + 20} autocomplete="off" autocapitalize="none" spellcheck="false" placeholder="release-notes" />
    <span class="hint">Lowercase letters, digits and hyphens, up to {NAME_MAX} characters. It is how an agent asks for the Playbook.</span>
    <span class="pb-error" data-error="name" role="alert"></span>
  </div>

  <div class="pb-field">
    <label class="label" for="pb-description">Description</label>
    <textarea class="input" id="pb-description" name="description" rows="3">{form.description}</textarea>
    <span class="hint">What it does and when to use it, up to {DESCRIPTION_MAX} characters. Agents read this to decide whether to load it.</span>
    <span class="pb-error" data-error="description" role="alert"></span>
  </div>

  <div class="pb-field">
    <label class="label" for="pb-body">Instructions</label>
    <div class="pb-tabs" role="tablist" aria-label="Instructions view">
      <button type="button" class="pb-tab active" role="tab" aria-selected="true" data-body-tab="write">Write</button>
      <button type="button" class="pb-tab" role="tab" aria-selected="false" data-body-tab="preview">Preview</button>
    </div>
    <textarea class="input pb-body" id="pb-body" name="body" rows="18" spellcheck="true">{form.body}</textarea>
    <div class="pb-preview" id="pb-preview" hidden></div>
    <span class="hint"><span id="pb-lines">0 lines</span>. Markdown. Aim for about {BODY_LINES_ADVISED} lines or fewer.</span>
    <div class="pb-warning" id="pb-warning" role="status" hidden={!warning}>{warning}</div>
  </div>

  <details class="pb-more" open={Boolean(form.license || form.compatibility || form.allowedTools || form.manualOnly)}>
    <summary>More settings</summary>
    <div class="pb-field">
      <label class="label" for="pb-license">License <span class="muted">(optional)</span></label>
      <input class="input" id="pb-license" name="license" value={form.license} placeholder="MIT" />
    </div>
    <div class="pb-field">
      <label class="label" for="pb-compatibility">Compatibility <span class="muted">(optional)</span></label>
      <input class="input" id="pb-compatibility" name="compatibility" value={form.compatibility} />
      <span class="hint">What it needs, such as a tool or an integration, up to {COMPATIBILITY_MAX} characters.</span>
      <span class="pb-error" data-error="compatibility" role="alert"></span>
    </div>
    <div class="pb-field">
      <label class="label" for="pb-allowed">Allowed tools <span class="muted">(optional)</span></label>
      <input class="input" id="pb-allowed" name="allowedTools" value={form.allowedTools} autocapitalize="none" spellcheck="false" />
      <span class="hint">Tool names separated by spaces. This narrows the agent while the Playbook runs; it never gives it more.</span>
    </div>
    <label class="pb-check">
      <input type="checkbox" name="manualOnly" checked={form.manualOnly} />
      <span><strong>Manual only</strong><span class="hint"> Loaded only when a person names it, never chosen by an agent.</span></span>
    </label>
  </details>

  {!canPublish && (
    <p class="hint" id="pb-admin-note">
      {status === "published" ? "This Playbook is published. Only an Admin can change or unpublish it." : "You can draft and edit. Only an Admin can publish a Playbook."}
    </p>
  )}
  <div class="pb-actions">
    {actions.map((a) => (
      <button type="button" class:list={["button", a.primary ? "" : "secondary"]} data-action={a.key}>{a.label}</button>
    ))}
    {!isNew && <button type="button" class="button secondary" data-action="export" title="Download the saved Playbook as a standard skill folder (zip)">Export</button>}
    {!isNew && <button type="button" class="button secondary pb-trash" data-action="trash">Move to Trash</button>}
    <span class="save-status" id="pb-status" role="status"></span>
  </div>
</form>

<style>
  .section-card { box-sizing: border-box; background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); padding: 20px 24px; margin-bottom: 16px; }
  .pb-form { display: grid; gap: 16px; max-width: 820px; }
  .pb-field { display: grid; gap: 6px; min-width: 0; }
  .pb-field .input { width: 100%; box-sizing: border-box; }
  .pb-body { font-family: ui-monospace, monospace; font-size: 13px; line-height: 1.5; resize: vertical; }
  .pb-body[hidden] { display: none; }
  .pb-tabs { display: flex; gap: 4px; margin: 0 0 6px; }
  .pb-tab { background: none; border: 1px solid var(--line); border-radius: 6px; padding: 4px 12px; font: inherit; font-size: 13px; color: var(--muted); cursor: pointer; min-height: 32px; }
  .pb-tab.active { background: var(--panel); color: var(--text); border-color: var(--accent, var(--line)); }
  .pb-preview { border: 1px solid var(--line); border-radius: 8px; padding: 12px 16px; min-height: 18em; max-height: 70vh; overflow: auto; background: var(--panel); line-height: 1.6; overflow-wrap: anywhere; }
  .pb-preview :global(h1), .pb-preview :global(h2), .pb-preview :global(h3), .pb-preview :global(h4) { margin: 1em 0 0.4em; line-height: 1.3; }
  .pb-preview :global(h1) { font-size: 1.5rem; }
  .pb-preview :global(h2) { font-size: 1.25rem; }
  .pb-preview :global(h3) { font-size: 1.1rem; }
  .pb-preview :global(:first-child) { margin-top: 0; }
  .pb-preview :global(p), .pb-preview :global(ul), .pb-preview :global(ol), .pb-preview :global(blockquote) { margin: 0 0 0.8em; }
  .pb-preview :global(ul), .pb-preview :global(ol) { padding-left: 1.4em; }
  .pb-preview :global(code) { font-family: ui-monospace, monospace; font-size: 0.9em; background: var(--bg); padding: 1px 4px; border-radius: 4px; }
  .pb-preview :global(pre) { background: var(--bg); padding: 10px 12px; border-radius: 6px; overflow-x: auto; }
  .pb-preview :global(pre code) { background: none; padding: 0; }
  .pb-preview :global(blockquote) { border-left: 3px solid var(--line); padding-left: 12px; color: var(--muted); }
  .pb-preview :global(table) { border-collapse: collapse; display: block; overflow-x: auto; }
  .pb-preview :global(th), .pb-preview :global(td) { border: 1px solid var(--line); padding: 4px 8px; }
  .pb-preview :global(.preview-empty) { color: var(--muted); }
  .pb-status { display: flex; align-items: center; gap: 10px; margin: 0; flex-wrap: wrap; }
  .pb-hint, .hint { font-size: 12px; color: var(--muted); }
  .pb-error { font-size: 13px; color: var(--bad, #b91c1c); }
  .pb-error:empty { display: none; }
  .pb-warning { font-size: 13px; padding: 8px 12px; border-radius: var(--radius); color: #a16207; border: 1px solid rgba(234, 179, 8, 0.45); background: rgba(234, 179, 8, 0.1); }
  .pb-more { border-top: 1px solid var(--line); padding-top: 12px; }
  .pb-more > summary { cursor: pointer; font-weight: 600; font-size: 14px; margin-bottom: 12px; }
  .pb-more .pb-field { margin-bottom: 14px; }
  .pb-check { display: flex; gap: 10px; align-items: flex-start; font-size: 14px; }
  .pb-check input { margin-top: 3px; accent-color: var(--accent); }
  .pb-actions { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; border-top: 1px solid var(--line); padding-top: 14px; }
  .pb-trash { margin-left: auto; }
  .save-status.error { color: var(--bad, #b91c1c); }
  .save-status.success { color: var(--good); }
  @media (max-width: 720px) {
    .pb-actions .button { flex: 1 1 auto; }
    .pb-trash { margin-left: 0; }
  }
</style>

<script>
  import { describeSaveError } from "@/lib/saveError";
  import { renderPreviewInto } from "@/lib/mediaEmbedsBrowser";
  import { createPlaybook, ensurePlaybookType, exportPlaybook, trashPlaybook, updatePlaybook } from "@/lib/api/playbooks";
  import { bodyLines, editorPath, entryPayload, isValid, lengthWarning, PLAYBOOKS_PATH, validate, type PlaybookForm } from "@/lib/playbooks";

  const formEl = document.getElementById("playbook-form") as HTMLFormElement;
  const field = (name: string) => formEl.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement;
  const statusEl = document.getElementById("pb-status") as HTMLElement;
  const linesEl = document.getElementById("pb-lines") as HTMLElement;
  const warnEl = document.getElementById("pb-warning") as HTMLElement;
  const id = formEl.dataset.id || "";

  const say = (msg: string, kind: "" | "success" | "error" = "") => {
    statusEl.textContent = msg;
    statusEl.classList.remove("success", "error");
    if (kind) statusEl.classList.add(kind);
  };

  const read = (): PlaybookForm => ({
    name: field("name").value,
    description: field("description").value,
    license: field("license").value,
    compatibility: field("compatibility").value,
    allowedTools: field("allowedTools").value,
    manualOnly: (field("manualOnly") as HTMLInputElement).checked,
    body: field("body").value,
    ...(formEl.querySelector<HTMLInputElement>("[name=replaces]")?.value ? { replaces: formEl.querySelector<HTMLInputElement>("[name=replaces]")!.value } : {}),
  });

  function showErrors(): boolean {
    const errors = validate(read());
    formEl.querySelectorAll<HTMLElement>("[data-error]").forEach((el) => {
      el.textContent = errors[el.dataset.error as keyof typeof errors] ?? "";
    });
    return isValid(errors);
  }

  // The length note follows the body as it is typed; it only ever warns.
  function showLength() {
    const n = bodyLines(field("body").value);
    linesEl.textContent = `${n} line${n === 1 ? "" : "s"}`;
    const text = lengthWarning(field("body").value);
    warnEl.textContent = text ?? "";
    warnEl.hidden = !text;
  }
  field("body").addEventListener("input", showLength);

  // Write / Preview: the preview is the body rendered as markdown and sanitised (an imported Playbook's text is someone
  // else's), with embeds off — agents read the text, not players.
  const previewEl = document.getElementById("pb-preview") as HTMLElement;
  formEl.querySelectorAll<HTMLButtonElement>("[data-body-tab]").forEach((tab) => {
    tab.addEventListener("click", () => {
      const preview = tab.dataset.bodyTab === "preview";
      if (preview) renderPreviewInto(previewEl, field("body").value, false);
      previewEl.hidden = !preview;
      field("body").hidden = preview;
      formEl.querySelectorAll<HTMLButtonElement>("[data-body-tab]").forEach((t) => {
        const on = t === tab;
        t.classList.toggle("active", on);
        t.setAttribute("aria-selected", on ? "true" : "false");
      });
    });
  });
  showLength();
  for (const name of ["name", "description", "compatibility"]) field(name).addEventListener("blur", showErrors);

  async function save(action: "save" | "publish" | "unpublish") {
    if (!showErrors()) {
      say("Fix the highlighted fields first.", "error");
      return;
    }
    const status = action === "publish" ? "published" : action === "unpublish" ? "draft" : id ? undefined : "draft";
    const buttons = formEl.querySelectorAll<HTMLButtonElement>("button");
    buttons.forEach((b) => (b.disabled = true));
    say("Saving…");
    try {
      if (id) {
        await updatePlaybook(id, entryPayload(read(), null, status));
        location.assign(`${editorPath(id)}?saved=${action}`);
      } else {
        const typeId = await ensurePlaybookType();
        const made = await createPlaybook(entryPayload(read(), typeId, status));
        location.assign(`${editorPath(made.id)}?saved=${action}`);
      }
    } catch (e) {
      const err = describeSaveError(e);
      say(err.issues.length ? `${err.message} ${err.issues.join(" ")}` : err.message, "error");
      buttons.forEach((b) => (b.disabled = false));
    }
  }

  async function trash() {
    if (!confirm("Move this Playbook to the Trash? Agents stop seeing it. You can restore it from the Trash.")) return;
    try {
      await trashPlaybook(id);
      location.assign(PLAYBOOKS_PATH);
    } catch (e) {
      say(describeSaveError(e).message, "error");
    }
  }

  async function download() {
    try {
      await exportPlaybook(id, read().name);
    } catch (e) {
      say(e instanceof Error ? e.message : "The export failed.", "error");
    }
  }

  formEl.querySelectorAll<HTMLButtonElement>("[data-action]").forEach((button) => {
    button.addEventListener("click", () => {
      const action = button.dataset.action;
      if (action === "clear-replaces") {
        // Saving without the hidden field drops "Replaces", so this draft becomes a Playbook of its own.
        formEl.querySelector("[data-testid=playbook-replaces]")?.remove();
        say("This draft will be its own Playbook, not a change. Save or Publish to keep that.", "success");
      } else if (action === "trash") void trash();
      else if (action === "export") void download();
      else void save(action as "save" | "publish" | "unpublish");
    });
  });

  const saved = new URLSearchParams(location.search).get("saved");
  if (saved) {
    say(saved === "publish" ? "Published." : saved === "unpublish" ? "Unpublished: now a draft." : "Saved.", "success");
    history.replaceState(null, "", location.pathname);
  }
</script>
