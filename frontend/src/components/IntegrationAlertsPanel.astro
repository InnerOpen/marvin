---
// "Integration alerts" — where a connection's "needs attention" alert goes besides the bell (which
// always gets it): workspace admins by email, and any chat / notification connection (Slack, Apprise).
// Saving writes ordinary event subscription rows for integration_attention_needed; a route turned off
// is disabled, not deleted, so an alert that is still open sends its "resolved" notice back through
// every channel that delivered it.
import type { AlertRouting } from "@/lib/api/integrations";

interface Props {
  routing: AlertRouting;
}

const { routing } = Astro.props;
---

<section class="alerts-panel" id="integration-alerts">
  <h3>Integration alerts</h3>
  <p class="section-description">
    When a connection fails in a way its provider says needs a person — expired credentials, a misconfigured account —
    Marvin marks it <strong>Needs attention</strong> and tells you once (not once per item), reminds you while it stays
    open, and says so when it works again. The bell always gets these. Also send them to:
  </p>
  <form class="alerts-form" id="alerts-form">
    <label class="alerts-row">
      <input type="checkbox" name="emailAdmins" checked={routing.emailAdmins} />
      <span>Email the workspace's owners and admins</span>
    </label>
    {routing.targets.map((t) => (
      <label class="alerts-row">
        <input type="checkbox" name="target" value={t.integrationId} checked={t.enabled} />
        <span>{t.name} <span class="alerts-sub">({t.provider} · {t.action})</span></span>
      </label>
    ))}
    {routing.targets.length === 0 && (
      <p class="alerts-sub">Connect Slack or Apprise under Manage Integrations to send alerts there too.</p>
    )}
    <label class="alerts-row">
      <span>Remind every</span>
      <input type="number" name="reminderHours" min="0" max="720" value={routing.reminderHours} class="alerts-hours" />
      <span>hours while an alert stays open (0 = never)</span>
    </label>
    <div class="alerts-actions">
      <button type="submit" class="button small">Save</button>
      <span class="alerts-status" id="alerts-status" role="status"></span>
    </div>
  </form>
</section>

<script>
  import { setAlertRouting } from "@/lib/api/integrations";

  const form = document.getElementById("alerts-form") as HTMLFormElement | null;
  const status = document.getElementById("alerts-status") as HTMLElement | null;
  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const button = form.querySelector("button[type=submit]") as HTMLButtonElement;
    button.disabled = true;
    try {
      await setAlertRouting({
        emailAdmins: data.get("emailAdmins") === "on",
        integrationIds: data.getAll("target").map(String),
        reminderHours: Math.max(0, Number(data.get("reminderHours") || 0)),
      });
      if (status) status.textContent = "Saved";
    } catch (e) {
      if (status) status.textContent = e instanceof Error ? e.message : "Couldn't save";
    } finally {
      button.disabled = false;
    }
  });
</script>

<style>
  .alerts-panel { margin-top: 24px; }
  .alerts-panel h3 { margin: 0 0 6px; }
  .alerts-form { display: grid; gap: 8px; max-width: 640px; }
  .alerts-row { display: flex; align-items: center; gap: 8px; }
  .alerts-sub { color: var(--muted); font-size: 13px; }
  .alerts-hours { width: 5em; }
  .alerts-actions { display: flex; align-items: center; gap: 12px; margin-top: 4px; }
  .alerts-status { color: var(--muted); font-size: 13px; }
</style>
