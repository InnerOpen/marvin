---
// Marvin — the (pluggable) workspace assistant bubble.
// Renders hidden; the client script reveals it only when AI is enabled for the workspace.
// Capabilities live in @/lib/marvin/capabilities — adding a skill needs no change here.
import { getAuthToken } from "@/lib/api/client";
import { getCurrentWorkspace } from "@/lib/api/workspaces";

// The workspace this page was rendered for: the bubble keeps its threads and transcript per workspace.
let workspaceId = "";
const authToken = getAuthToken(Astro.cookies);
try {
  if (authToken) workspaceId = (await getCurrentWorkspace(authToken))?.id ?? "";
} catch {
  // Unscoped storage still works for a single workspace; it only risks a stale thread after a switch.
}
---

<div id="marvin-root" class="marvin" data-workspace={workspaceId} hidden>
  <button id="marvin-toggle" class="marvin-toggle" aria-label="Ask Marvin" title="Ask Marvin"><span id="marvin-icon">🤖</span></button>

  <div id="marvin-panel" class="marvin-panel" role="dialog" aria-label="Ask Marvin">
    <div class="marvin-head">
      <div class="marvin-id">
        <span class="marvin-name">Marvin</span>
        <span id="marvin-sub" class="marvin-sub">here to help, allegedly</span>
      </div>
      <button id="marvin-clear" class="marvin-clear" aria-label="Clear conversation" title="Clear conversation" hidden>Clear</button>
      <button id="marvin-close" class="marvin-close" aria-label="Close">×</button>
    </div>
    <div id="marvin-context" class="marvin-context" hidden>
      <span class="marvin-context-what">Looking at</span>
      <span id="marvin-context-label" class="marvin-context-label"></span>
      <button id="marvin-context-clear" class="marvin-context-clear"
        aria-label="Ignore this page's context" title="Ignore this page's context">×</button>
    </div>
    <div id="marvin-log" class="marvin-log"></div>
    <form id="marvin-form" class="marvin-form">
      <input id="marvin-input" class="marvin-input" type="text" autocomplete="off"
        placeholder="Ask Marvin…  (try /help)" />
      <button type="submit" class="marvin-send" aria-label="Send">➤</button>
    </form>
  </div>
</div>

<script>
  import { fetchApi } from '@/lib/api/client';
  import { resolveCapability, helpHtml, esc, setPendingRegister, resumePendingRun, onRunProgress, getActiveAgent } from '@/lib/marvin/capabilities';
  import { createCast, type Cast } from '@/lib/marvin/cast';
  import { createCharacter, dragDirection, type Character, type CharacterEvent, type CharacterStates } from '@/lib/marvin/character';
  import { MARVIN_VOICE, voiceFor, pick } from '@/lib/marvin/persona';
  import { bubbleAllowed } from '@/lib/marvin/gate';
  import { getPageContext, contextLabel, setContextSuppressed } from '@/lib/marvin/context';
  import { forgetConversation, loadPending, scoped, setStorageScope } from '@/lib/marvin/pending';
  import { type BubbleSpot, clampSpot, DEFAULT_SPOT, parseSpot, spotFromRect } from '@/lib/marvin/position';

  const root = document.getElementById('marvin-root');
  setStorageScope(root?.dataset.workspace);
  if (root) {
    // Gate: stay hidden until we confirm AI is enabled for this workspace.
    (async () => {
      try {
        const settings = await fetchApi<any>('/api/groups/ai-settings');
        if (!bubbleAllowed(settings)) { root.remove(); return; } // AI off, or the bubble switched off
        applyIdentity(settings);
        root.removeAttribute('hidden');
      } catch {
        root.remove(); // no auth / no AI / error → no bubble
        return;
      }
      void resumeIfPending();
    })();

    const toggle = document.getElementById('marvin-toggle')!;
    const close = document.getElementById('marvin-close')!;
    const panel = document.getElementById('marvin-panel')!;
    const log = document.getElementById('marvin-log')!;
    const form = document.getElementById('marvin-form') as HTMLFormElement;
    const input = document.getElementById('marvin-input') as HTMLInputElement;
    const sub = document.getElementById('marvin-sub')!;
    const clear = document.getElementById('marvin-clear')!;
    let greeted = false;
    let busy = false;
    // Bumped by "Clear": a reply that resolves after it belongs to the conversation that was cleared.
    let generation = 0;
    let taglineTimer: number | undefined;
    let voice = MARVIN_VOICE;

    // The workspace's name and icon for its assistant (AI settings → Persona). An icon is an emoji,
    // or an image URL. The canned lines are the workspace's own bubble lines where it has them, else
    // Marvin's while it's still named Marvin (see voiceFor).
    function applyIdentity(settings: any) {
      const name = (settings?.assistantName || '').trim() || 'Marvin';
      const icon = (settings?.assistantIcon || '').trim();
      voice = voiceFor(name, settings?.bubbleLines);
      document.querySelector('#marvin-root .marvin-name')!.textContent = name;
      for (const el of [toggle, panel]) el.setAttribute('aria-label', `Ask ${name}`);
      toggle.title = `Ask ${name}`;
      input.placeholder = `Ask ${name}…  (try /help)`;
      sub.textContent = pick(voice.taglines);
      workspaceIcon = icon;
      cast = createCast(settings?.assistantCharacter?.states, settings?.agentCharacters ?? {}, getActiveAgent());
      showCast();
      if (cast.hasAny) {
        onRunProgress((progress) => {
          if (!busy) return; // a late poll of a finished run
          // A hand-off's delegate shows its own character while it works.
          if (cast?.progress(progress.events)) showCast();
          if (progress.status === 'awaiting_approval') cue('parked');
          else if (progress.events.length) cue('progress');
        });
      }
    }

    function applyIcon(icon: string) {
      const slot = document.getElementById('marvin-icon')!;
      if (/^(https?:\/\/|\/)/.test(icon)) {
        const img = document.createElement('img');
        img.src = icon;
        img.alt = '';
        img.className = 'marvin-icon-img';
        slot.replaceChildren(img);
      } else if (icon) {
        slot.textContent = icon;
      }
    }

    // ── Animated character (AI settings → Persona → Bubble character; Settings → Agents) ──
    // Shown instead of the round icon: one animation per bubble state, picked by @/lib/marvin/character
    // from what happens here (cue). Whose character — the workspace's or the talking agent's — is
    // @/lib/marvin/cast's call. With prefers-reduced-motion it's a still — each state's image drawn
    // once to a canvas, which keeps only the first frame.
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let character: Character | null = null;
    let cast: Cast | null = null;
    let workspaceIcon = '';

    function cue(event: CharacterEvent) { character?.dispatch(event); }

    /** The talking agent's character, or the icon when nobody involved has one. */
    function showCast() {
      if (!applyCharacter(cast?.states, workspaceIcon)) showIcon();
      if (panel.classList.contains('open')) placePanel(); // a character and the icon differ in size
    }

    /** A run ended, or `/use` switched agents: the active agent is the one talking again. */
    function finish(event: CharacterEvent) {
      if (cast?.use(getActiveAgent())) showCast();
      cue(event);
    }

    function showIcon() {
      character?.stop(); character = null;
      toggle.classList.remove('has-character');
      document.getElementById('marvin-icon')!.textContent = '🤖';
      applyIcon(workspaceIcon);
    }

    function applyCharacter(states: CharacterStates | undefined, icon: string): boolean {
      if (!states?.idle) return false;
      character?.stop();
      const slot = document.getElementById('marvin-icon')!;
      const view = document.createElement(reducedMotion ? 'canvas' : 'img');
      view.className = 'marvin-character';
      if (view instanceof HTMLImageElement) { view.alt = ''; view.draggable = false; }
      slot.replaceChildren(view);
      toggle.classList.add('has-character');
      // A file that won't load (its asset was deleted) loses the whole character, not just a state.
      const giveUp = () => {
        if (!slot.contains(view)) return; // a character swapped out since; its late error is moot
        character?.stop(); character = null;
        toggle.classList.remove('has-character');
        slot.textContent = '🤖';
        applyIcon(icon);
      };
      if (view instanceof HTMLImageElement) view.onerror = giveUp;
      const show = (src: string) => {
        if (view instanceof HTMLCanvasElement) drawStill(view, src, giveUp);
        else if (view.getAttribute('src') !== src) view.src = src;
      };
      character = createCharacter(states, {
        render: ({ src }) => show(src),
        reducedMotion,
        setTimer: (fn, ms) => window.setTimeout(fn, ms),
        clearTimer: (id) => window.clearTimeout(id as number),
        random: Math.random,
      });
      // Warm the cache so the first switch to each state doesn't flash empty; off the critical path.
      window.setTimeout(() => { for (const src of new Set(Object.values(states))) new Image().src = src!; }, 0);
      return true;
    }

    function drawStill(canvas: HTMLCanvasElement, src: string, onError: () => void) {
      const img = new Image();
      img.onload = () => {
        canvas.width = img.naturalWidth;
        canvas.height = img.naturalHeight;
        canvas.getContext('2d')?.drawImage(img, 0, 0);
      };
      img.onerror = onError;
      img.src = src;
    }

    // ── Session memory: keep the transcript across page navigations (per-tab) ──
    // sessionStorage, so the conversation follows you as you move around the workspace but doesn't
    // linger forever or leak between tabs. Only committed turns are stored — never the transient
    // "thinking…" placeholder, which is replaced in place by the final answer. This is a display
    // cache: agent conversations themselves live in server threads (@/lib/marvin/pending), which is
    // where the agent's memory comes from; /chat, /tools, /help, /agents and /use stay local-only.
    const MEM_KEY = scoped('marvin.transcript');
    const MEM_CAP = 60; // keep the last N turns; guards both quota and scrollback bloat
    // `executionId` marks an agent reply, so one recovered from the server isn't appended twice.
    type Turn = { who: 'user' | 'marvin'; html: string; executionId?: string };
    let transcript: Turn[] = [];
    try {
      const saved = JSON.parse(sessionStorage.getItem(MEM_KEY) || '[]');
      if (Array.isArray(saved)) transcript = saved;
    } catch { /* ignore corrupt transcript */ }

    function saveTranscript() {
      try {
        transcript = transcript.slice(-MEM_CAP);
        sessionStorage.setItem(MEM_KEY, JSON.stringify(transcript));
      } catch { /* quota or disabled storage — degrade to in-memory only */ }
      clear.toggleAttribute('hidden', transcript.length === 0);
    }

    function appendNode(who: 'user' | 'marvin', html: string): HTMLElement {
      const div = document.createElement('div');
      div.className = `mv-msg mv-${who}`;
      div.innerHTML = html;
      log.appendChild(div);
      log.scrollTop = log.scrollHeight;
      return div;
    }

    // Add a message to the log. Committed turns persist; pass persist=false for the transient
    // "thinking…" placeholder (its final answer is committed via commitReply once it resolves).
    function addMsg(who: 'user' | 'marvin', html: string, persist = true): HTMLElement {
      const div = appendNode(who, html);
      if (persist) { transcript.push({ who, html }); saveTranscript(); }
      return div;
    }

    // Commit a marvin reply that replaced a "thinking…" node in place.
    function commitReply(node: HTMLElement, html: string, executionId?: string) {
      node.innerHTML = html;
      transcript.push({ who: 'marvin', html, ...(executionId ? { executionId } : {}) });
      saveTranscript();
    }

    function thinkingHtml() {
      return `<span class="mv-thinking">${esc(pick(voice.emotes) + ' ' + pick(voice.thinking))}</span>`;
    }

    function errorHtml(err: any) {
      return `<span class="mv-error">${esc(pick(voice.errors))} (${esc(err?.message || 'error')})</span>`;
    }

    function clearTranscript() {
      transcript = [];
      generation += 1;
      busy = false; // a run still in flight no longer holds the input; its reply is dropped
      // "Clear" must also drop the model's memory, not just the visible log: the next message opens
      // a new thread, and nothing waits on the old one any more.
      forgetConversation();
      finish('rest');
      try { sessionStorage.removeItem(MEM_KEY); } catch { /* ignore */ }
      log.innerHTML = '';
      clear.setAttribute('hidden', '');
      greeted = false;
      if (panel.classList.contains('open')) { greeted = true; addMsg('marvin', esc(pick(voice.greetings)), false); }
    }

    // Rehydrate a stored conversation on page load (before any greeting).
    if (transcript.length) {
      for (const t of transcript) appendNode(t.who, t.html);
      greeted = true; // don't greet over a restored conversation
      clear.removeAttribute('hidden');
    }

    // An agent run the previous page sent but didn't live to see answered: the server kept going,
    // so show the thinking placeholder and fetch the answer from the run's thread.
    async function resumeIfPending() {
      const run = loadPending();
      if (!run || busy) return;
      busy = true;
      greeted = true;
      const gen = generation;
      const thinking = addMsg('marvin', thinkingHtml(), false);
      cue('send');
      try {
        const res = await resumePendingRun(run);
        if (gen !== generation) return;
        const seen = res?.executionId && transcript.some((t) => t.executionId === res.executionId);
        if (!res || seen) { thinking.remove(); finish('rest'); }
        else { commitReply(thinking, res.html, res.executionId); finish(res.parked ? 'parked' : 'reply'); }
      } catch (err: any) {
        if (gen === generation) { commitReply(thinking, errorHtml(err)); finish('error'); }
      } finally {
        if (gen === generation) busy = false;
        log.scrollTop = log.scrollHeight;
      }
    }

    // ── Page context chip: show what Marvin is grounded in, and let it be dismissed ──
    // The chip is honest UI, not decoration: if it's showing, that entity is being sent with
    // every ask. Dismissing suppresses it for this page load (a navigation resets it).
    const contextBar = document.getElementById('marvin-context')!;
    const contextLabelEl = document.getElementById('marvin-context-label')!;
    const contextClear = document.getElementById('marvin-context-clear')!;

    function renderContext() {
      const label = contextLabel(getPageContext());
      if (!label) { contextBar.setAttribute('hidden', ''); return; }
      contextLabelEl.textContent = label;
      contextBar.removeAttribute('hidden');
    }

    contextClear.addEventListener('click', () => {
      setContextSuppressed(true);
      contextBar.setAttribute('hidden', '');
      addMsg('marvin', "Fine — I'll ignore this page and answer about the whole workspace.", false);
    });

    renderContext();

    function rotateTagline() { sub.textContent = pick(voice.taglines); }

    // Open the panel on the side of the button with the most room (he may be dragged anywhere).
    const PANEL_GAP = 12; // between the button (icon or character) and the panel
    function placePanel() {
      const r = toggle.getBoundingClientRect();
      const below = r.top < window.innerHeight / 2;
      const leftSide = r.left < window.innerWidth / 2;
      const offset = `${toggle.offsetHeight + PANEL_GAP}px`;
      panel.style.top = below ? offset : 'auto';
      panel.style.bottom = below ? 'auto' : offset;
      panel.style.left = leftSide ? '0' : 'auto';
      panel.style.right = leftSide ? 'auto' : '0';
    }

    function openPanel() {
      placePanel();
      panel.classList.add('open');
      rotateTagline();
      taglineTimer = window.setInterval(rotateTagline, 7000); // cycle like a login fortune
      if (!greeted) {
        greeted = true;
        addMsg('marvin', esc(pick(voice.greetings)), false); // flavor line, not part of the saved transcript
      }
      cue('open');
      // A restored conversation was appended while the panel was display:none, where scrolling is
      // a no-op — so land on the latest turn now that it has a height.
      log.scrollTop = log.scrollHeight;
      input.focus();
    }
    function closePanel() {
      panel.classList.remove('open');
      if (taglineTimer) { clearInterval(taglineTimer); taglineTimer = undefined; }
    }

    // ── Drag the bubble around (pointer events; click vs drag disambiguated) ──
    // It rests at a viewport-relative spot (see @/lib/marvin/position): bottom-left by default,
    // otherwise wherever it was dropped, anchored to the nearest edges and kept on screen.
    const POS_KEY = 'marvin.pos';
    let dragging = false, moved = false, sx = 0, sy = 0, ox = 0, oy = 0;
    let lastX = 0; // where the character last turned to face, for its running direction

    const viewport = () => ({ width: document.documentElement.clientWidth, height: window.innerHeight });
    const bubbleBox = () => ({ width: toggle.offsetWidth, height: toggle.offsetHeight });

    function applySpot(s: BubbleSpot) {
      // env() keeps it clear of a notch or home indicator where the page extends under one.
      root.style.left = s.x === 'left' ? `max(${s.dx}px, env(safe-area-inset-left, 0px))` : 'auto';
      root.style.right = s.x === 'right' ? `max(${s.dx}px, env(safe-area-inset-right, 0px))` : 'auto';
      root.style.top = s.y === 'top' ? `max(${s.dy}px, env(safe-area-inset-top, 0px))` : 'auto';
      root.style.bottom = s.y === 'bottom' ? `max(${s.dy}px, env(safe-area-inset-bottom, 0px))` : 'auto';
    }

    function readSpot(): BubbleSpot {
      let raw: unknown = null;
      try { raw = JSON.parse(localStorage.getItem(POS_KEY) || 'null'); } catch { /* bad or blocked storage */ }
      return parseSpot(raw, bubbleBox(), viewport());
    }
    function saveSpot(s: BubbleSpot) {
      try { localStorage.setItem(POS_KEY, JSON.stringify(s)); } catch { /* private window: lasts this page */ }
    }

    let spot = readSpot();
    applySpot(spot);
    // The character swaps in after load and the window can change size or rotate: re-clamp the
    // remembered spot to what fits now (without overwriting it, so it springs back on a bigger screen).
    function reclamp() {
      if (dragging) return;
      applySpot(clampSpot(spot, bubbleBox(), viewport()));
      if (panel.classList.contains('open')) placePanel();
    }
    window.addEventListener('resize', reclamp);
    new ResizeObserver(reclamp).observe(toggle);

    toggle.addEventListener('pointerdown', (e) => {
      dragging = true; moved = false;
      const r = toggle.getBoundingClientRect();
      ox = r.left; oy = r.top; sx = e.clientX; sy = e.clientY; lastX = e.clientX;
      toggle.setPointerCapture(e.pointerId);
    });
    toggle.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      const dx = e.clientX - sx, dy = e.clientY - sy;
      if (!moved && Math.abs(dx) + Math.abs(dy) > 4) moved = true;
      if (!moved) return;
      applySpot(spotFromRect(ox + dx, oy + dy, bubbleBox(), viewport()));
      if (panel.classList.contains('open')) placePanel();
      const facing = dragDirection(e.clientX - lastX);
      if (facing) { cue(facing); lastX = e.clientX; }
    });
    toggle.addEventListener('pointerup', (e) => {
      if (!dragging) return;
      dragging = false;
      toggle.releasePointerCapture(e.pointerId);
      if (moved) {
        const r = toggle.getBoundingClientRect();
        spot = spotFromRect(r.left, r.top, bubbleBox(), viewport());
        applySpot(spot);
        saveSpot(spot);
        cue('drop');
      }
    });
    // Double-click puts him back in his default corner.
    toggle.addEventListener('dblclick', () => {
      spot = clampSpot(DEFAULT_SPOT, bubbleBox(), viewport());
      applySpot(spot);
      try { localStorage.removeItem(POS_KEY); } catch { /* nothing stored */ }
      if (panel.classList.contains('open')) placePanel();
    });

    toggle.addEventListener('click', () => {
      if (moved) { moved = false; return; } // it was a drag, not a click
      panel.classList.contains('open') ? closePanel() : openPanel();
    });
    // Public hook: any page can drive the bubble without reaching into it or needing a global —
    //   document.dispatchEvent(new CustomEvent('marvin:ask', { detail: { text: 'review this' } }))
    // Opens the panel and submits, so the ask flows through the normal capability dispatch
    // (and therefore picks up page context + history like anything the user typed).
    // `detail.register` lets the caller ask for a tone register — e.g. the entry editor's
    // "Review & suggest" sends 'professional' so the findings come back plain and actionable
    // rather than in character. Cleared after the run so typed messages aren't affected.
    document.addEventListener('marvin:ask', (e) => {
      const detail = (e as CustomEvent).detail ?? {};
      const text = String(detail.text ?? '').trim();
      if (!text || busy) return;
      if (detail.register) setPendingRegister(detail.register);
      if (!panel.classList.contains('open')) openPanel();
      input.value = text;
      form.requestSubmit();
    });

    close.addEventListener('click', closePanel);
    clear.addEventListener('click', clearTranscript);
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closePanel(); });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const text = input.value.trim();
      if (!text || busy) return;
      addMsg('user', esc(text));
      input.value = '';

      const { cap, arg, help } = resolveCapability(text);
      if (help) { addMsg('marvin', helpHtml()); return; }
      if (!cap) {
        addMsg('marvin', "I don't know that command. Try <code>/help</code> — not that it'll lift the mood.");
        return;
      }
      if (!arg && !cap.noArg) { addMsg('marvin', "You'll have to give me something to work with."); return; }

      busy = true;
      const gen = generation;
      const thinking = addMsg('marvin', thinkingHtml(), false);
      cue('send');
      try {
        const res = await cap.run(arg);
        // After `/use`, the agent now talking may have a character of its own.
        if (gen === generation) { commitReply(thinking, res.html, res.executionId); finish(res.parked ? 'parked' : 'reply'); }
      } catch (err: any) {
        if (gen === generation) { commitReply(thinking, errorHtml(err)); finish('error'); }
      } finally {
        if (gen === generation) busy = false;
        log.scrollTop = log.scrollHeight;
      }
    });
  }
</script>

<style>
  /* Default resting spot; the script re-applies it (or the remembered one) as viewport-relative insets. */
  .marvin {
    position: fixed; left: max(16px, env(safe-area-inset-left, 0px)); bottom: max(16px, env(safe-area-inset-bottom, 0px));
    z-index: 1000; --marvin-character-height: 80px;
  }

  .marvin-toggle {
    width: 52px; height: 52px; border-radius: 50%;
    border: 1px solid var(--line);
    background: var(--accent); color: #fff;
    font-size: 24px; line-height: 1; cursor: grab;
    box-shadow: 0 6px 20px rgb(0 0 0 / 0.18);
    transition: box-shadow 0.15s;
    touch-action: none; user-select: none;
  }
  .marvin-toggle:active { cursor: grabbing; }
  .marvin-toggle :global(.marvin-icon-img) { width: 100%; height: 100%; border-radius: 50%; object-fit: cover; display: block; pointer-events: none; }
  .marvin-toggle:has(.marvin-icon-img) { padding: 0; overflow: hidden; }
  .marvin-toggle:hover { box-shadow: 0 10px 26px rgb(0 0 0 / 0.24); }
  /* The character stands on its own: no circle, no fill, its own aspect ratio. */
  .marvin-toggle.has-character {
    width: auto; height: var(--marvin-character-height); padding: 0;
    border: none; border-radius: 0; background: none; box-shadow: none;
  }
  .marvin-toggle :global(.marvin-character) {
    height: var(--marvin-character-height); width: auto; display: block; pointer-events: none;
  }

  .marvin-panel {
    position: absolute; right: 0; bottom: 64px;
    width: 360px; max-width: calc(100vw - 40px);
    height: 520px; max-height: calc(100vh - 120px);
    display: none; flex-direction: column;
    background: var(--panel); border: 1px solid var(--line);
    border-radius: 14px; overflow: hidden;
    box-shadow: 0 12px 40px rgb(0 0 0 / 0.22);
  }
  .marvin-panel.open { display: flex; }

  .marvin-head {
    display: flex; align-items: center; justify-content: space-between;
    padding: 12px 14px; border-bottom: 1px solid var(--line); background: var(--bg);
  }
  .marvin-id { display: flex; flex-direction: column; }
  .marvin-name { font-weight: 600; font-size: 15px; color: var(--ink); }
  .marvin-sub { font-size: 11px; color: var(--muted); }
  .marvin-clear {
    margin-left: auto; margin-right: 4px;
    background: none; border: none; cursor: pointer;
    font-size: 11px; line-height: 1; color: var(--muted); padding: 2px 4px;
  }
  .marvin-clear:hover { color: var(--ink); }
  .marvin-close {
    background: none; border: none; cursor: pointer;
    font-size: 22px; line-height: 1; color: var(--muted); padding: 0 4px;
  }
  .marvin-close:hover { color: var(--ink); }

  /* Context chip — static markup, so plain scoped styles reach it. */
  .marvin-context {
    display: flex; align-items: center; gap: 6px;
    padding: 7px 14px; border-bottom: 1px solid var(--line);
    background: var(--bg); font-size: 11px; color: var(--muted);
  }
  .marvin-context[hidden] { display: none; }
  .marvin-context-what { flex: none; }
  .marvin-context-label {
    flex: 1; min-width: 0; font-weight: 600; color: var(--ink);
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .marvin-context-clear {
