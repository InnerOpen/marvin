---
/**
 * MarkdownField Component
 * Renders a markdown editor field
 */
export interface Props {
  field: {
    key: string;
    label: string;
    type: "markdown";
    required?: boolean;
    defaultValue?: string;
    placeholder?: string;
    helpText?: string;
    readOnly?: boolean;
    /** Bare provider URLs on their own line become players (default). `false` keeps them plain links. */
    autoEmbed?: boolean;
  };
  value?: string;
  error?: string;
}

const { field, value, error } = Astro.props;
const inputId = `field-${field.key}`;
const autoEmbed = field.autoEmbed !== false;
const canEmbed = autoEmbed && !field.readOnly;
---

<div class="field-group markdown-field" data-auto-embed={autoEmbed ? "true" : "false"}>
  <label for={inputId}>
    {field.label}
    {field.required && <span class="required">*</span>}
  </label>

  <div class="markdown-editor-container">
    <div class="markdown-tabs">
      <button type="button" class="tab-button active" data-tab="write">Write</button>
      <button type="button" class="tab-button" data-tab="preview">Preview</button>
      {canEmbed && (
        <button type="button" class="tab-button embed-button" data-embed-open title="Embed a video, song, playlist or podcast">
          Embed
        </button>
      )}
    </div>

    <div class="markdown-content">
      <textarea
        id={inputId}
        name={`dataJson.${field.key}`}
        placeholder={field.placeholder}
        required={field.required}
        readonly={field.readOnly}
        class:list={['field-textarea markdown-editor', { error }]}
        rows="12"
        data-markdown-input
      >{value || field.defaultValue || ''}</textarea>

      <div class="markdown-preview" data-markdown-preview style="display: none;">
        <div class="preview-empty">Nothing to preview</div>
      </div>
    </div>
  </div>

  {field.helpText && <p class="field-help">{field.helpText}</p>}
  {error && <p class="field-error">{error}</p>}

  {canEmbed && (
    <dialog class="modal embed-dialog" data-embed-dialog aria-label="Embed media">
      <div class="modal-content">
        <h3>Embed media</h3>
        <p class="embed-dialog-help">
          Paste a link to a video, song, playlist or podcast — or the provider's embed code. It's added as a
          link on its own line, which your site shows as a player.
        </p>
        <textarea class="input embed-dialog-input" rows="3" data-embed-input placeholder="https://www.youtube.com/watch?v=…"></textarea>
        <p class="embed-dialog-status" data-embed-status aria-live="polite"></p>
        <div class="embed-dialog-preview" data-embed-preview></div>
        <div class="modal-actions">
          <button type="button" class="button secondary" data-embed-cancel>Cancel</button>
          <button type="button" class="button secondary" data-embed-resolve>Check link</button>
          <button type="button" class="button" data-embed-insert disabled>Insert</button>
        </div>
      </div>
    </dialog>
  )}
</div>

<style>
  .field-group {
    display: grid;
    gap: 0.5rem;
  }

  label {
    font-weight: 600;
    font-size: 0.875rem;
    color: var(--ink);
  }

  .required {
    color: var(--color-error);
    margin-left: 2px;
  }

  .field-textarea {
    padding: 0.75rem;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--bg);
    font-size: 0.875rem;
    font-family: 'SF Mono', Monaco, 'Cascadia Code', 'Roboto Mono', Consolas, monospace;
    line-height: 1.6;
    resize: vertical;
    transition: border-color 0.2s;
  }

  .field-textarea:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px var(--color-primary-alpha);
  }

  .field-textarea:read-only {
    background: var(--muted-bg);
    cursor: not-allowed;
  }

  .field-textarea.error {
    border-color: var(--color-error);
  }

  .field-help {
    margin: 0;
    font-size: 0.75rem;
    color: var(--muted);
  }

  .field-error {
    margin: 0;
    font-size: 0.75rem;
    color: var(--color-error);
  }

  .markdown-hint {
    font-size: 0.75rem;
    color: var(--muted);
  }

  .markdown-editor-container {
    border: 1px solid var(--line);
    border-radius: 6px;
    overflow: hidden;
    background: var(--bg);
  }

  .markdown-tabs {
    display: flex;
    border-bottom: 1px solid var(--line);
    background: var(--panel);
  }

  .tab-button {
    padding: 0.5rem 1rem;
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--muted);
    cursor: pointer;
    transition: all 0.2s;
  }

  .tab-button:hover {
    color: var(--ink);
    background: var(--bg);
  }

  .tab-button.active {
    color: var(--ink);
    border-bottom-color: var(--color-primary);
  }

  .embed-button {
    margin-left: auto;
  }

  .embed-dialog {
    width: min(560px, 90vw);
    padding: 0;
    border: none;
    border-radius: var(--radius);
    background: var(--panel);
    color: var(--ink);
    box-shadow: 0 8px 32px rgb(0 0 0 / 0.15);
  }

  .embed-dialog::backdrop {
    background: rgb(0 0 0 / 0.5);
  }

  .embed-dialog .modal-content {
    display: grid;
    gap: 0.75rem;
    padding: 24px;
  }

  .embed-dialog h3,
  .embed-dialog-help,
  .embed-dialog-status {
    margin: 0;
  }

  .embed-dialog-help,
  .embed-dialog-status {
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .embed-dialog-status:empty {
    display: none;
  }

  .embed-dialog-status.is-error {
    color: var(--color-error);
  }

  .embed-dialog-input {
    font-family: 'SF Mono', Monaco, monospace;
    font-size: 0.8125rem;
    resize: vertical;
  }

  .embed-dialog .modal-actions {
    display: flex;
    gap: 0.75rem;
    justify-content: flex-end;
  }

  .markdown-content {
    position: relative;
  }

  .markdown-editor-container .field-textarea {
    border: none;
    border-radius: 0;
    width: 100%;
    box-sizing: border-box;
  }

  .markdown-editor-container .field-textarea:focus {
    box-shadow: none;
  }

  .markdown-preview {
    padding: 0.75rem;
    min-height: 300px;
    overflow-y: auto;
    background: var(--bg);
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .markdown-preview.empty {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--muted);
    font-style: italic;
  }

  .preview-empty {
    padding: 2rem;
    text-align: center;
    color: var(--muted);
    font-style: italic;
  }

  /* Markdown preview content styling */
  .markdown-preview :global(h1),
  .markdown-preview :global(h2),
  .markdown-preview :global(h3),
  .markdown-preview :global(h4),
  .markdown-preview :global(h5),
  .markdown-preview :global(h6) {
    margin: 1.5rem 0 0.75rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .markdown-preview :global(h1) { font-size: 1.75rem; }
  .markdown-preview :global(h2) { font-size: 1.5rem; }
  .markdown-preview :global(h3) { font-size: 1.25rem; }
  .markdown-preview :global(h4) { font-size: 1.1rem; }
  .markdown-preview :global(h5) { font-size: 1rem; }
  .markdown-preview :global(h6) { font-size: 0.95rem; }

  .markdown-preview :global(p) {
    margin: 0.75rem 0;
  }

  .markdown-preview :global(a) {
    color: var(--color-primary);
    text-decoration: underline;
  }

  .markdown-preview :global(code) {
    padding: 0.2rem 0.4rem;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 3px;
    font-family: 'SF Mono', Monaco, monospace;
    font-size: 0.85em;
  }

  .markdown-preview :global(pre) {
    margin: 1rem 0;
    padding: 1rem;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 6px;
    overflow-x: auto;
  }

  .markdown-preview :global(pre code) {
    padding: 0;
    background: transparent;
    border: none;
  }

  .markdown-preview :global(ul),
  .markdown-preview :global(ol) {
    margin: 0.75rem 0;
    padding-left: 2rem;
  }

  .markdown-preview :global(li) {
    margin: 0.25rem 0;
  }

  .markdown-preview :global(blockquote) {
    margin: 1rem 0;
    padding-left: 1rem;
    border-left: 4px solid var(--line);
    color: var(--muted);
  }

  .markdown-preview :global(hr) {
    margin: 1.5rem 0;
    border: none;
    border-top: 1px solid var(--line);
  }

  .markdown-preview :global(table) {
    border-collapse: collapse;
    width: 100%;
    margin: 1rem 0;
  }

  .markdown-preview :global(th),
  .markdown-preview :global(td) {
    padding: 0.5rem;
    border: 1px solid var(--line);
    text-align: left;
  }

  .markdown-preview :global(th) {
    background: var(--panel);
    font-weight: 600;
  }

  .markdown-preview :global(a.marvin-embed-link) {
    text-decoration: none;
  }

  .markdown-preview :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 6px;
  }
</style>

<script>
  import { insertEmbedParagraph } from '@/lib/mediaEmbeds';
  import {
    buildEmbedElement,
    describeEmbed,
    loadProviders,
    renderPreviewInto,
    resolveCached,
    resolveErrorMessage,
  } from '@/lib/mediaEmbedsBrowser';

  // The Embed dialog: paste a link or embed code → check it → insert the canonical URL as its own paragraph.
  function setupEmbedDialog(field: Element, textarea: HTMLTextAreaElement) {
    const openBtn = field.querySelector<HTMLButtonElement>('[data-embed-open]');
    const dialog = field.querySelector<HTMLDialogElement>('[data-embed-dialog]');
    if (!openBtn || !dialog) return;
    const input = dialog.querySelector<HTMLTextAreaElement>('[data-embed-input]')!;
    const status = dialog.querySelector<HTMLElement>('[data-embed-status]')!;
    const preview = dialog.querySelector<HTMLElement>('[data-embed-preview]')!;
    const resolveBtn = dialog.querySelector<HTMLButtonElement>('[data-embed-resolve]')!;
    const insertBtn = dialog.querySelector<HTMLButtonElement>('[data-embed-insert]')!;

    let selection = { start: 0, end: 0 };
    let resolvedUrl: string | null = null;

    const setStatus = (text: string, isError = false) => {
      status.textContent = text;
      status.classList.toggle('is-error', isError);
    };
    const reset = () => {
      resolvedUrl = null;
      insertBtn.disabled = true;
      preview.replaceChildren();
      setStatus('');
    };

    openBtn.addEventListener('click', () => {
      selection = { start: textarea.selectionStart ?? textarea.value.length, end: textarea.selectionEnd ?? textarea.value.length };
      input.value = '';
      reset();
      dialog.showModal();
      input.focus();
      void loadProviders();
    });
    dialog.querySelector('[data-embed-cancel]')?.addEventListener('click', () => dialog.close());
    input.addEventListener('input', reset);

    resolveBtn.addEventListener('click', async () => {
      const value = input.value.trim();
      reset();
      if (!value) {
        setStatus('Paste a link or embed code first.', true);
        return;
      }
      resolveBtn.disabled = true;
      setStatus('Checking…');
      try {
        const [result, { frameSources }] = await Promise.all([resolveCached(value, 'direct'), loadProviders()]);
        if (!result.url || !result.embed) {
          setStatus(result.error || "That link isn't from a supported provider.", true);
          return;
        }
        resolvedUrl = result.url;
        insertBtn.disabled = false;
        setStatus(describeEmbed(result.embed));
        preview.replaceChildren(buildEmbedElement(result.embed, frameSources));
      } catch (e) {
        setStatus(resolveErrorMessage(e), true);
      } finally {
        resolveBtn.disabled = false;
      }
    });

    insertBtn.addEventListener('click', () => {
      if (!resolvedUrl) return;
      const { value, caret } = insertEmbedParagraph(textarea.value, selection.start, selection.end, resolvedUrl);
      textarea.value = value;
      textarea.setSelectionRange(caret, caret);
      // Existing listeners (data JSON sync, dirty tracking, the preview) react to input events.
      textarea.dispatchEvent(new Event('input', { bubbles: true }));
      dialog.close();
      textarea.focus();
    });
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll<HTMLElement>('.markdown-field').forEach((field) => {
      const writeBtn = field.querySelector('[data-tab="write"]');
      const previewBtn = field.querySelector('[data-tab="preview"]');
      const textarea = field.querySelector('[data-markdown-input]') as HTMLTextAreaElement;
      const preview = field.querySelector('[data-markdown-preview]') as HTMLElement;

      if (!writeBtn || !previewBtn || !textarea || !preview) return;
      const autoEmbed = field.dataset.autoEmbed !== 'false';
      const renderPreview = () => renderPreviewInto(preview, textarea.value, autoEmbed);

      // Tab switching
      writeBtn.addEventListener('click', () => {
        writeBtn.classList.add('active');
        previewBtn.classList.remove('active');
        textarea.style.display = 'block';
        preview.style.display = 'none';
      });

      previewBtn.addEventListener('click', () => {
        previewBtn.classList.add('active');
        writeBtn.classList.remove('active');
        textarea.style.display = 'none';
        preview.style.display = 'block';
        renderPreview();
      });

      // Update preview on input (debounced)
      let debounceTimer: number;
      textarea.addEventListener('input', () => {
        clearTimeout(debounceTimer);
        debounceTimer = window.setTimeout(() => {
          if (previewBtn.classList.contains('active')) renderPreview();
        }, 300);
      });

      setupEmbedDialog(field, textarea);
    });
  });
</script>
