---
/**
 * LinkedItemsField: the `asset`, `asset-list`, `resource` and `resource-list` schema fields. The chosen items show as
 * cards (an image asset with its thumbnail); "Choose…" opens a searchable list of the workspace's assets or resources,
 * which the page loads and passes down (lib/linkedItems.ts has the pure parts). The hidden input posts the ids joined by
 * commas; coerceDataJsonValue turns a list field's string back into an array.
 */
import PlayButton from "@/components/PlayButton.astro";
import { type LinkedItem, canAdd, chosen, idsOf, serialize } from "@/lib/linkedItems";

export interface Props {
  field: {
    key: string;
    label: string;
    type: "asset" | "asset-list" | "resource" | "resource-list";
    required?: boolean;
    helpText?: string;
    readOnly?: boolean;
    min?: number | null;
    max?: number | null;
    minItems?: number | null;
    maxItems?: number | null;
    /** The attachment role the saved value becomes (services/entries/linked_fields.py); the key when unset. */
    role?: string | null;
  };
  value?: unknown;
  error?: string;
  items: LinkedItem[];
}

const { field, value, error, items } = Astro.props;
const isAsset = field.type.startsWith("asset");
const multiple = field.type.endsWith("-list");
const max = multiple ? (field.max ?? field.maxItems ?? null) : 1;
const min = multiple ? (field.min ?? field.minItems ?? null) : null;
const noun = isAsset ? "asset" : "resource";
const ids = idsOf(value);
const picked = chosen(ids, items);
const inputId = `field-${field.key}`;
const addable = canAdd(ids.length, multiple, max) && !field.readOnly;
const newHref = isAsset ? "/workspace/assets/new" : "/workspace/resources/new";
const role = (field as { role?: string | null }).role?.trim() || field.key;
---

<div class="field-group li-field" data-linked-field data-multiple={multiple ? "1" : ""} data-max={max ?? ""} data-noun={noun} data-role={role} data-readonly={field.readOnly ? "1" : ""}>
  <label for={inputId}>
    {field.label}
    {field.required && <span class="required">*</span>}
    {multiple && (min || max) && <span class="count-hint">({min ?? 0}{max ? `–${max}` : "+"} {noun}s)</span>}
  </label>

  <input type="hidden" id={inputId} name={`dataJson.${field.key}`} value={serialize(ids)} data-linked-value />

  <ul class="li-chosen" data-linked-chosen>
    {picked.map((item) => (
      <li class="li-card" data-id={item.id}>
        <span class="li-thumb">{item.imageUrl ? <img src={item.imageUrl} alt={item.alt || item.name} /> : item.audioUrl ? <PlayButton src={item.audioUrl} label={`Play ${item.name}`} /> : <span aria-hidden="true">{isAsset ? "📄" : "🔗"}</span>}</span>
        <span class="li-text"><strong>{item.name}</strong>{item.meta && <small>{item.meta}</small>}</span>
        {!field.readOnly && <button type="button" class="li-remove" aria-label={`Remove ${item.name}`} data-linked-remove>×</button>}
      </li>
    ))}
  </ul>

  {!field.readOnly && (
    <div class="li-actions">
    <details class="li-picker" data-linked-picker>
      <summary class:list={["button", "secondary", "li-choose", { "li-hidden": !addable }]} data-linked-choose>Choose {multiple ? `${noun}s` : `an ${noun}`}…</summary>
      <div class="li-panel">
        <input type="search" class="li-search" placeholder={`Search ${noun}s…`} aria-label={`Search ${noun}s`} data-linked-search />
        <ul class="li-options" data-linked-options>
          {items.map((item) => (
            <li class="li-card li-option" data-id={item.id} data-name={item.name} data-meta={item.meta ?? ""} data-image={item.imageUrl ?? ""} data-alt={item.alt ?? ""} hidden={ids.includes(item.id)}>
              <span class="li-thumb">{item.imageUrl ? <img src={item.imageUrl} alt={item.alt || item.name} loading="lazy" /> : <span aria-hidden="true">{isAsset ? "📄" : "🔗"}</span>}</span>
              <span class="li-text"><strong>{item.name}</strong>{item.meta && <small>{item.meta}</small>}</span>
              <button type="button" class="li-add" aria-label={`Add ${item.name}`} data-linked-add>+</button>
            </li>
          ))}
          {items.length === 0 && <li class="li-empty">No {noun}s yet. <a href={newHref}>Add one</a>.</li>}
        </ul>
        <p class="li-none" data-linked-none hidden>Nothing matches.</p>
      </div>
    </details>
    {isAsset && (
      <button type="button" class:list={["button", "secondary", "li-upload-open", { "li-hidden": !addable }]} data-linked-upload-open>Upload {multiple ? "assets" : "an asset"}…</button>
    )}
    </div>
  )}

  {isAsset && !field.readOnly && (
    <dialog class="li-upload" data-linked-upload aria-labelledby={`${inputId}-upload-title`}>
      <div class="li-upload-body">
        <h3 id={`${inputId}-upload-title`}>Upload {field.label}</h3>
        <p class="field-help">A new asset for this field: a picture opens in the cropper first (crop, rotate, brightness, contrast). It is uploaded now, chosen here, and attached as <code>{role}</code> when you save.</p>
        <label class="li-upload-label">File
          <input type="file" data-linked-upload-file accept="image/*,video/*,audio/*,.pdf,.doc,.docx,.svg" />
        </label>
        <div class="li-upload-preview" data-linked-upload-preview hidden><img alt="" /><button type="button" class="button secondary li-upload-again" data-linked-upload-again hidden>Crop or adjust again…</button></div>
        <label class="li-upload-keep" data-linked-upload-keep hidden><input type="checkbox" data-linked-upload-keep-on checked /> Keep the original file in the library too (the cropped picture is saved as a version made from it)</label>
        <label class="li-upload-label">Name
          <input type="text" data-linked-upload-name maxlength="200" />
        </label>
        <label class="li-upload-label">Alt text <small>(what the picture shows, for people who cannot see it)</small>
          <input type="text" data-linked-upload-alt maxlength="500" />
        </label>
        <label class="li-upload-label">Description <small>(optional)</small>
          <textarea rows="2" data-linked-upload-description></textarea>
        </label>
        <p class="field-error" data-linked-upload-error hidden></p>
        <div class="li-upload-actions">
          <button type="button" class="button secondary" data-linked-upload-cancel>Cancel</button>
          <button type="button" class="button" data-linked-upload-go disabled>Upload and choose</button>
        </div>
      </div>
    </dialog>
  )}

  {field.helpText && <p class="field-help">{field.helpText}</p>}
  <p class="field-help li-role-note">
    Attached as <code>{role}</code>. The sidebar's {noun}s in that role are these same ones: give one the role there and it appears here; change its role there and it leaves.
  </p>
  {error && <p class="field-error">{error}</p>}
</div>

<style is:global>
  /* Global, scoped by the .li-field wrapper: the picker script adds cards after render, and Astro's scoped styles would miss them. */
  .li-field { display: grid; gap: 0.5rem; }
  .li-field > label { font-weight: 600; font-size: 0.875rem; color: var(--ink); }
  .li-field .required { color: var(--color-error); margin-left: 2px; }
  .li-field .count-hint { font-weight: 400; color: var(--muted); margin-left: 6px; font-size: 0.8em; }
  .li-field .li-chosen, .li-field .li-options { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .li-field .li-chosen:empty { display: none; }
  .li-field .li-card { display: flex; align-items: center; gap: 10px; padding: 6px 8px; border: 1px solid var(--line); border-radius: 8px; background: var(--bg); }
  .li-field .li-thumb { flex: 0 0 44px; width: 44px; height: 44px; border-radius: 6px; overflow: hidden; display: grid; place-items: center; background: var(--panel); font-size: 18px; }
  .li-field .li-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .li-field .li-text { flex: 1; min-width: 0; display: grid; gap: 2px; }
  .li-field .li-text strong { font-size: 0.875rem; font-weight: 600; color: var(--ink); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .li-field .li-text small { color: var(--muted); font-size: 0.75rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .li-field .li-remove, .li-field .li-add { flex: 0 0 auto; width: 28px; height: 28px; padding: 0; border: 1px solid var(--line); border-radius: 6px; background: var(--panel); color: var(--muted); cursor: pointer; font-size: 16px; line-height: 1; display: grid; place-items: center; }
  .li-field .li-remove:hover { color: var(--color-error); border-color: var(--color-error); }
  .li-field .li-add:hover { color: var(--color-primary); border-color: var(--color-primary); }
  .li-field .li-actions { display: flex; gap: 8px; flex-wrap: wrap; align-items: flex-start; }
  .li-field .li-picker { position: relative; }
  .li-field .li-upload { border: 1px solid var(--line); border-radius: 12px; padding: 0; width: min(480px, calc(100vw - 32px)); background: var(--panel); color: var(--ink); }
  .li-field .li-upload::backdrop { background: rgb(0 0 0 / 0.35); }
  .li-field .li-upload-body { display: grid; gap: 12px; padding: 20px; }
  .li-field .li-upload-body h3 { margin: 0; font-size: 1.1rem; }
  .li-field .li-upload-label { display: grid; gap: 4px; font-size: 0.875rem; font-weight: 600; }
  .li-field .li-upload-label small { font-weight: 400; color: var(--muted); }
  .li-field .li-upload-label input[type="text"], .li-field .li-upload-label textarea { font: inherit; padding: 0.5rem 0.75rem; border: 1px solid var(--line); border-radius: 6px; background: var(--bg); color: var(--ink); }
  .li-field .li-upload-preview { display: grid; gap: 8px; justify-items: start; }
  .li-field .li-upload-preview img { max-width: 100%; max-height: 180px; border-radius: 8px; display: block; }
  .li-field .li-upload-actions { display: flex; justify-content: flex-end; gap: 8px; }
  .li-field .li-upload-keep { display: flex; gap: 8px; align-items: flex-start; font-size: 0.8125rem; color: var(--muted); }
  .li-field .li-picker summary { list-style: none; display: inline-flex; width: max-content; cursor: pointer; }
  .li-field .li-picker summary::-webkit-details-marker { display: none; }
  .li-field .li-hidden { display: none !important; }
  .li-field .li-panel { margin-top: 8px; padding: 10px; border: 1px solid var(--line); border-radius: 8px; background: var(--panel); display: grid; gap: 8px; }
  .li-field .li-search { width: 100%; box-sizing: border-box; padding: 0.5rem 0.75rem; border: 1px solid var(--line); border-radius: 6px; background: var(--bg); color: var(--ink); font-size: 0.875rem; }
  .li-field .li-options { max-height: 280px; overflow: auto; }
  .li-field .li-option[hidden] { display: none; }
  .li-field .li-empty, .li-field .li-none { margin: 0; padding: 6px 2px; color: var(--muted); font-size: 0.8rem; }
  .li-field .field-help, .li-field .field-error { margin: 0; font-size: 0.75rem; color: var(--muted); }
  .li-role-note code { font-size: 0.7rem; padding: 0 0.25em; border-radius: 3px; background: var(--panel-2); }
  .li-field .field-error { color: var(--color-error); }
</style>

<script>
  import { assetItem, canAdd, matches, nameFromFile, serialize, uploadSlug } from "@/lib/linkedItems";
  import { fetchApi } from "@/lib/api/client";

  // Each field keeps its ids in the hidden input; the cards and the option list are redrawn from it, so the page's own
  // "unsaved changes" tracking (a change event on the input) keeps working.
  document.querySelectorAll<HTMLElement>("[data-linked-field]").forEach((root) => {
    const input = root.querySelector<HTMLInputElement>("[data-linked-value]")!;
    const chosenEl = root.querySelector<HTMLUListElement>("[data-linked-chosen]")!;
    const picker = root.querySelector<HTMLDetailsElement>("[data-linked-picker]");
    if (root.dataset.readonly || !picker) return;
    const choose = picker.querySelector<HTMLElement>("[data-linked-choose]")!;
    const search = picker.querySelector<HTMLInputElement>("[data-linked-search]")!;
    const options = Array.from(picker.querySelectorAll<HTMLLIElement>(".li-option"));
    const none = picker.querySelector<HTMLElement>("[data-linked-none]")!;
    const multiple = root.dataset.multiple === "1";
    const max = root.dataset.max ? Number(root.dataset.max) : null;
    const isAsset = root.dataset.noun === "asset";

    const ids = () => input.value.split(",").map((s) => s.trim()).filter(Boolean);
    const setIds = (next: string[]) => {
      input.value = serialize(next);
      input.dispatchEvent(new Event("change", { bubbles: true }));
      input.dispatchEvent(new Event("input", { bubbles: true }));
      refresh();
    };

    function card(option: HTMLLIElement): HTMLLIElement {
      const li = document.createElement("li");
      li.className = "li-card";
      li.dataset.id = option.dataset.id!;
      const thumb = document.createElement("span");
      thumb.className = "li-thumb";
      if (option.dataset.image) {
        const img = document.createElement("img");
        img.src = option.dataset.image;
        img.alt = option.dataset.alt || option.dataset.name || "";
        thumb.append(img);
      } else {
        thumb.textContent = isAsset ? "📄" : "🔗";
      }
      const text = document.createElement("span");
      text.className = "li-text";
      const name = document.createElement("strong");
      name.textContent = option.dataset.name || "";
      text.append(name);
      if (option.dataset.meta) {
        const meta = document.createElement("small");
        meta.textContent = option.dataset.meta;
        text.append(meta);
      }
      const remove = document.createElement("button");
      remove.type = "button";
      remove.className = "li-remove";
      remove.textContent = "×";
      remove.setAttribute("aria-label", `Remove ${option.dataset.name || ""}`);
      remove.dataset.linkedRemove = "";
      li.append(thumb, text, remove);
      return li;
    }

    function refresh() {
      const current = ids();
      options.forEach((o) => (o.hidden = current.includes(o.dataset.id!) || !matches({ id: o.dataset.id!, name: o.dataset.name || "", meta: o.dataset.meta }, search.value)));
      none.hidden = options.some((o) => !o.hidden) || options.length === 0;
      choose.classList.toggle("li-hidden", !canAdd(current.length, multiple, max));
      root.querySelector("[data-linked-upload-open]")?.classList.toggle("li-hidden", !canAdd(current.length, multiple, max));
      if (!canAdd(current.length, multiple, max)) picker.open = false;
    }

    chosenEl.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>("[data-linked-remove]");
      if (!btn) return;
      const li = btn.closest<HTMLLIElement>(".li-card")!;
      li.remove();
      setIds(ids().filter((id) => id !== li.dataset.id));
    });

    picker.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>("[data-linked-add]");
      if (!btn) return;
      const option = btn.closest<HTMLLIElement>(".li-option")!;
      const current = ids();
      if (!canAdd(current.length, multiple, max)) return;
      chosenEl.append(card(option));
      setIds([...current, option.dataset.id!]);
      if (!multiple) picker.open = false;
      search.value = "";
    });

    search.addEventListener("input", refresh);
    picker.addEventListener("toggle", () => picker.open && search.focus());

    // Upload from here: a dialog like the Upload page, without leaving the form. A raster picture goes through the page's cropper first
    // (crop, rotate, brightness, contrast). The new asset becomes an option and is chosen at once; saving the entry attaches it in this
    // field's role, as with any chosen asset.
    const dialog = root.querySelector<HTMLDialogElement>("[data-linked-upload]");
    const openUpload = root.querySelector<HTMLButtonElement>("[data-linked-upload-open]");
    if (dialog && openUpload) {
      const file = dialog.querySelector<HTMLInputElement>("[data-linked-upload-file]")!;
      const name = dialog.querySelector<HTMLInputElement>("[data-linked-upload-name]")!;
      const alt = dialog.querySelector<HTMLInputElement>("[data-linked-upload-alt]")!;
      const description = dialog.querySelector<HTMLTextAreaElement>("[data-linked-upload-description]")!;
      const preview = dialog.querySelector<HTMLElement>("[data-linked-upload-preview]")!;
      const again = dialog.querySelector<HTMLButtonElement>("[data-linked-upload-again]")!;
      const keep = dialog.querySelector<HTMLElement>("[data-linked-upload-keep]")!;
      const keepOn = dialog.querySelector<HTMLInputElement>("[data-linked-upload-keep-on]")!;
      let original: File | null = null; // the file as picked, when the cropper made something else of it
      let source: { id: string } | null = null; // the original once uploaded, so a retry never sends it twice
      const error = dialog.querySelector<HTMLElement>("[data-linked-upload-error]")!;
      const go = dialog.querySelector<HTMLButtonElement>("[data-linked-upload-go]")!;
      const cancel = dialog.querySelector<HTMLButtonElement>("[data-linked-upload-cancel]")!;
      let picked: File | null = null; // what will be sent: the cropper's output, or the file as it came
      const reset = () => {
        file.value = "";
        name.value = "";
        alt.value = "";
        description.value = "";
        preview.hidden = true;
        again.hidden = true;
        keep.hidden = true;
        error.hidden = true;
        go.disabled = true;
        go.textContent = "Upload and choose";
        picked = null;
        original = null;
        source = null;
      };
      const show = (f: File) => {
        picked = f;
        go.disabled = false;
        const img = preview.querySelector("img")!;
        if (f.type.startsWith("image/")) {
          img.src = URL.createObjectURL(f);
          preview.hidden = false;
        } else preview.hidden = true;
      };
      type CropperClass = new () => { show: (f: File, ok: (b: Blob) => void, no?: () => void) => void };
      const crop = (f: File) => {
        // Looked up when needed: the cropper's own script (SchemaForm puts one on the page) may run after this one.
        const Cropper = (window as unknown as { ImageCropper?: CropperClass }).ImageCropper;
        if (!Cropper || !f.type.startsWith("image/") || f.type === "image/svg+xml") return show(f);
        // The cropper is a modal of its own over this dialog: hide the dialog while it is up so the two do not fight for the screen.
        dialog.close();
        try {
          new Cropper().show(
            f,
            (blob) => {
              const type = blob.type || "image/jpeg";
              const ext = type === "image/png" ? ".png" : type === "image/webp" ? ".webp" : ".jpg";
              show(new File([blob], f.name.replace(/\.[a-z0-9]+$/i, "") + ext, { type }));
              original = f;
              again.hidden = false;
              keep.hidden = false; // the crop is a smaller copy: the archive may want the file as it came
              dialog.showModal();
            },
            () => {
              show(f);
              original = null;
              again.hidden = false;
              keep.hidden = true;
              dialog.showModal();
            },
          );
        } catch {
          show(f);
          dialog.showModal();
        }
      };
      openUpload.addEventListener("click", () => {
        reset();
        picker.open = false;
        dialog.showModal();
      });
      cancel.addEventListener("click", () => dialog.close());
      file.addEventListener("change", () => {
        const f = file.files?.[0];
        if (!f) return;
        if (!name.value.trim()) name.value = nameFromFile(f.name);
        crop(f);
      });
      again.addEventListener("click", () => {
        const f = file.files?.[0];
        if (f) crop(f);
      });
      type Made = { id: string; name: string; mimeType?: string | null; publicUrl?: string | null; altText?: string | null };
      const send = (f: File, slug: string, title: string, metadata?: Record<string, string>) => {
        const body = new FormData();
        body.append("file", f);
        body.append("slug", slug);
        body.append("name", title);
        if (alt.value.trim()) body.append("alt_text", alt.value.trim());
        if (description.value.trim()) body.append("description", description.value.trim());
        if (metadata) body.append("metadata", JSON.stringify(metadata));
        return fetchApi<Made>("/api/platform/assets/upload", { method: "POST", body });
      };
      // The crop goes up as a version made from the original (the library shows the lineage), when the original is kept. The original is
      // sent once, with a stamped slug of its own; only the crop's slug is retried when a nicer one is taken.
      const upload = async (slug: string) => {
        if (!picked) return null;
        const title = name.value.trim() || nameFromFile(picked.name);
        if (original && !keep.hidden && keepOn.checked && !source) source = await send(original, uploadSlug(`${title} original`), `${title} (original)`);
        return send(picked, slug, title, source ? { derived_from: source.id, derivation: "edited:cropper" } : undefined);
      };
      go.addEventListener("click", async () => {
        if (!picked) return;
        error.hidden = true;
        go.disabled = true;
        go.textContent = "Uploading…";
        try {
          let made: Awaited<ReturnType<typeof upload>>;
          try {
            made = await upload(uploadSlug(name.value.trim() || picked.name, ""));
          } catch (e) {
            // The slug is taken (a second "Blue boat"): once more with a stamp.
            if (!/exist|taken|duplicate|unique|409|conflict/i.test(e instanceof Error ? e.message : String(e))) throw e;
            made = await upload(uploadSlug(name.value.trim() || picked.name));
          }
          if (!made) return;
          const item = assetItem(made);
          const option = document.createElement("li");
          option.className = "li-card li-option";
          option.dataset.id = item.id;
          option.dataset.name = item.name;
          option.dataset.meta = item.meta ?? "";
          option.dataset.image = item.imageUrl ?? "";
          option.dataset.alt = item.alt ?? "";
          option.hidden = true;
          picker.querySelector("[data-linked-options]")!.append(option);
          options.push(option);
          const current = ids();
          if (canAdd(current.length, multiple, max)) {
            chosenEl.append(card(option));
            setIds([...current, item.id]);
          }
          dialog.close();
        } catch (e) {
          error.textContent = e instanceof Error ? e.message : "The upload failed.";
          error.hidden = false;
          go.disabled = false;
          go.textContent = "Upload and choose";
        }
      });
    }
    // The entry editor's sidebar removed an attachment with this field's role: drop the id here too, or the next save
    // would attach it again (the field owns its role; see services/entries/linked_fields.py).
    root.addEventListener("linked-field:drop", (e) => {
      const id = (e as CustomEvent<{ id: string }>).detail?.id;
      if (!id || !ids().includes(id)) return;
      chosenEl.querySelector(`.li-card[data-id="${CSS.escape(id)}"]`)?.remove();
      setIds(ids().filter((x) => x !== id));
    });
    refresh();
  });
</script>
