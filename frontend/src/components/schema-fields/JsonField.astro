---
/**
 * JsonField Component
 * Renders a free-form JSON field as a monospace textarea, styled like the other fields
 */
export interface Props {
  field: {
    key: string;
    label: string;
    type: "json";
    required?: boolean;
    helpText?: string;
    readOnly?: boolean;
    /** A hint of the shape, shown in the empty box (default "Enter valid JSON"). */
    placeholder?: string;
    /** Ready-made values to start from: choosing one fills the box (a camera move: Slow push in). */
    presets?: { label: string; value: unknown }[];
    /** Start from another field's choice: { from: "camera", values: { "Push in": {...} }, note }. Shown until the person edits it; saved only then. */
    suggest?: { from: string; values: Record<string, unknown>; note?: string };
  };
  value?: unknown;
  error?: string;
}

import { readSuggest } from "../../lib/jsonSuggest";

const { field, value, error } = Astro.props;
const suggest = field.readOnly ? null : readSuggest(field.suggest);
const inputId = `field-${field.key}`;
const presets = Array.isArray(field.presets) ? field.presets.filter((p) => p && typeof p.label === "string") : [];
const empty = value === undefined || value === null || value === "";
---

<div
  class="field-group"
  data-json-presets={presets.length ? "1" : undefined}
  data-json-suggest={suggest ? JSON.stringify(suggest) : undefined}
  data-suggest-name={suggest ? `dataJson.${suggest.from}` : undefined}
>
  <label for={inputId}>
    {field.label}
    {field.required && <span class="required">*</span>}
  </label>

  {presets.length > 0 && !field.readOnly && (
    <select class="field-select json-presets" aria-label={`${field.label}: start from`}>
      <option value="">Start from a preset…</option>
      {presets.map((p) => <option value={JSON.stringify(p.value, null, 2)}>{p.label}</option>)}
    </select>
  )}

  <textarea
    id={inputId}
    name={`dataJson.${field.key}`}
    placeholder={field.placeholder ?? "Enter valid JSON"}
    rows="6"
    required={field.required}
    readonly={field.readOnly}
    class:list={["field-textarea", { error }]}
    spellcheck="false"
  >{empty ? "" : JSON.stringify(value, null, 2)}</textarea>

  {suggest && <p class="field-note" data-suggest-note hidden></p>}
  <p class="field-help">{field.helpText || "Enter valid JSON data"}</p>
  {error && <p class="field-error">{error}</p>}
</div>

<script>
  // Choosing a preset fills the box with its JSON (and leaves it editable); the select goes back to its prompt.
  document.querySelectorAll<HTMLElement>("[data-json-presets]").forEach((group) => {
    const select = group.querySelector<HTMLSelectElement>(".json-presets");
    const box = group.querySelector<HTMLTextAreaElement>("textarea");
    select?.addEventListener("change", () => {
      if (!select.value || !box) return;
      box.value = select.value;
      box.dispatchEvent(new Event("input", { bubbles: true }));
      select.value = "";
    });
  });
</script>

<script>
  // A box that starts from another field's choice: it shows the suggestion for the pick while empty or untouched, follows the pick when that
  // changes, and is left out of the save (sent empty) unless the person changed the text.
  import { nextBox, noteFor, readSuggest, suggestionFor } from "../../lib/jsonSuggest";

  document.querySelectorAll<HTMLElement>("[data-json-suggest]").forEach((group) => {
    const suggest = readSuggest(JSON.parse(group.dataset.jsonSuggest ?? "null"));
    const box = group.querySelector<HTMLTextAreaElement>("textarea");
    const note = group.querySelector<HTMLElement>("[data-suggest-note]");
    const form = box?.closest("form");
    const pickField = form?.querySelector<HTMLSelectElement | HTMLInputElement>(`[name="${group.dataset.suggestName}"]`);
    if (!suggest || !box || !form || !pickField) return;

    let last = ""; // the suggestion the box was last given
    let following = false; // the box holds only the suggestion

    const show = () => {
      const suggested = suggestionFor(suggest, pickField.value);
      const next = nextBox(box.value, last, suggested);
      box.value = next.text;
      last = next.suggested ? suggested : "";
      following = next.suggested;
      box.classList.toggle("suggested", following);
      if (note) {
        const text = following ? noteFor(suggest, pickField.value, suggested) : "";
        note.textContent = text;
        note.hidden = !text;
      }
    };
    show();
    pickField.addEventListener("change", show);
    box.addEventListener("input", () => {
      if (following && box.value !== last) {
        following = false;
        last = "";
        box.classList.remove("suggested");
        if (note) note.hidden = true;
      }
    });
    // What goes to the server: nothing, while the box is only the suggestion.
    form.addEventListener("formdata", (event) => {
      if (following && box.value === last) (event as FormDataEvent).formData.set(box.name, "");
    });
  });
</script>

<style>
  .field-group {
    display: grid;
    gap: 0.5rem;
  }

  label {
    font-weight: 600;
    font-size: 0.875rem;
    color: var(--ink);
  }

  .required {
    color: var(--color-error);
    margin-left: 2px;
  }

  .field-textarea {
    padding: 0.75rem;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--bg);
    font-size: 0.8125rem;
    font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, Consolas, monospace);
    line-height: 1.5;
    resize: vertical;
    transition: border-color 0.2s;
  }

  .field-textarea:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px var(--color-primary-alpha);
  }

  .field-textarea:read-only {
    background: var(--muted-bg);
    cursor: not-allowed;
  }

  .field-textarea.error {
    border-color: var(--color-error);
  }

  .field-textarea.suggested {
    color: var(--muted);
    font-style: italic;
  }

  .field-note {
    margin: 0;
    font-size: 0.75rem;
    color: var(--color-primary);
  }

  .field-help {
    margin: 0;
    font-size: 0.75rem;
    color: var(--muted);
  }

  .field-error {
    margin: 0;
    font-size: 0.75rem;
    color: var(--color-error);
  }
</style>
