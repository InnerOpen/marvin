---
/**
 * One row of the Assets page (table and by-type views alike). A trashed asset (`inTrash`) is marked and
 * only links to its page, where the Trash banner offers Restore and Delete forever (EDITOR+).
 */
import TagList from "@/components/TagList.astro";
import { getMimeCategory } from "@/lib/assetCategory";

interface Props {
  asset: any;
  /** EDITOR and above: Edit and Move to Trash. */
  canEdit: boolean;
  inTrash?: boolean;
}

const { asset, canEdit, inTrash = false } = Astro.props;
const category = getMimeCategory(asset.mimeType);
---

<tr class="asset-row" data-type={category} data-status={inTrash ? "trashed" : undefined} data-in-trash={inTrash ? "" : undefined}>
  <td>
    <div class="preview">
      {asset.publicUrl && category === 'image' ? (
        <img
          src={asset.publicUrl}
          alt={asset.altText ?? asset.name}
          style={`object-position: ${asset.focalPoint ?? "50% 50%"}`}
        />
      ) : (
        <span class="file-icon">{
          category === 'video' ? '🎬' :
          category === 'audio' ? '🎵' :
          category === 'document' ? '📄' : '📎'
        }</span>
      )}
    </div>
  </td>
  <td class="asset-name">
    <strong>{asset.name}</strong>
    {inTrash && <span class="trash-badge">In the Trash</span>}
    {asset.slug && <div class="slug"><code>{asset.slug}</code></div>}
    {asset.tags?.length > 0 && <div class="tags-row"><TagList tags={asset.tags} /></div>}
  </td>
  <td class="asset-type"><span class="type-badge">{asset.mimeType}</span></td>
  <td>
    {asset.width && asset.height
      ? `${asset.width} × ${asset.height}`
      : '—'}
  </td>
  <td>
    {asset.fileSize
      ? `${(asset.fileSize / 1024).toFixed(1)} KB`
      : '—'}
  </td>
  <td class="alt-text-cell">{asset.altText || '—'}</td>
  <td>
    <div class="actions">
      {inTrash ? (
        <a href={`/workspace/assets/${asset.id}`} class="button secondary small" title={canEdit ? "Restore it or delete it forever" : undefined}>Open</a>
      ) : (
        <>
          <a href={`/workspace/assets/${asset.id}/view`} class="button secondary small">View</a>
          {canEdit && (
            <>
              <a href={`/workspace/assets/${asset.id}`} class="button secondary small">Edit</a>
              <form method="POST" action={`/api/assets/${asset.id}/delete`} style="display:inline;">
                <button type="submit" class="button secondary small" title="Move to the Trash (restore it from there)">
                  Move to Trash
                </button>
              </form>
            </>
          )}
        </>
      )}
    </div>
  </td>
</tr>

<style>
  .preview {
    width: 80px;
    height: 80px;
    border-radius: 6px;
    overflow: hidden;
    background: var(--panel-2);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .preview img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .file-icon {
    font-size: 2rem;
    opacity: 0.7;
  }

  .slug {
    margin-top: 0.25rem;
    font-size: 0.75rem;
    color: var(--muted);
  }
  .tags-row {
    margin-top: 0.35rem;
  }

  .type-badge {
    display: inline-block;
    padding: 0.25rem 0.5rem;
    background: var(--panel-2);
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
  }

  .alt-text-cell {
    max-width: 200px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 0.875rem;
    color: var(--muted);
  }

  .actions {
    display: flex;
    gap: 0.5rem;
  }

  .button.small {
    min-height: 32px;
    padding: 6px 10px;
    font-size: 0.875rem;
  }

  .button.danger {
    color: var(--color-error);
    border-color: var(--color-error);
  }

  .button.danger:hover {
    background: var(--color-error-bg);
  }

  .trash-badge {
    display: inline-block;
    margin-left: 0.5rem;
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    background: var(--color-error-bg);
    color: var(--color-error);
    font-size: 0.7rem;
    font-weight: 600;
  }

</style>
