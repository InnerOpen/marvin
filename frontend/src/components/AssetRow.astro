---
/**
 * One row of the Assets page (table and by-type views alike). A trashed asset (`inTrash`) is marked and
 * only links to its page, where the Trash banner offers Restore and Delete forever (EDITOR+).
 */
import TagList from "@/components/TagList.astro";
import { getMimeCategory } from "@/lib/assetCategory";
import { decisionOf } from "@/lib/assetLineage";
import { isUnsearchableImage } from "@/lib/assetLibraryView";

interface Props {
  asset: any;
  /** EDITOR and above: Edit and Move to Trash. */
  canEdit: boolean;
  inTrash?: boolean;
  /** Where its "N versions" link goes (the library filtered to what was made from it). */
  versionsHref?: string;
}

const { asset, canEdit, inTrash = false, versionsHref } = Astro.props;
// Where it came from, when it isn't a plain upload: a version made from another asset, or an image an integration made.
const originBadge = asset.origin === "derived" ? "Version" : asset.origin === "generated" ? "Generated" : null;
// What an approval said about the picture, when one showed it (a denied generated image stays in the library).
const decision = decisionOf(asset.metadataJson);
const category = getMimeCategory(asset.mimeType);
// The whole row opens the asset (a tap anywhere on a phone, where the Actions column sits off-screen); an asset in
// the Trash opens its restore page instead of the viewer.
const openHref = inTrash ? `/workspace/assets/${asset.id}` : `/workspace/assets/${asset.id}/view`;
---

<tr class="asset-row" data-href={openHref} data-type={category} data-status={inTrash ? "trashed" : undefined} data-in-trash={inTrash ? "" : undefined}>
  <td class="stack-lead">
    <a class="preview" href={openHref} title={asset.name}>
      {asset.publicUrl && category === 'image' ? (
        <img
          src={asset.publicUrl}
          alt={asset.altText ?? asset.name}
          style={`object-position: ${asset.focalPoint ?? "50% 50%"}`}
        />
      ) : (
        <span class="file-icon">{
          category === 'video' ? '🎬' :
          category === 'audio' ? '🎵' :
          category === 'document' ? '📄' : '📎'
        }</span>
      )}
    </a>
  </td>
  <td class="asset-name">
    <a class="name-link" href={openHref}><strong>{asset.name}</strong></a>
    {inTrash && <span class="trash-badge">In the Trash</span>}
    {originBadge && (asset.sourceAssetId
      ? <a class="origin-badge" href={`/workspace/assets/${asset.sourceAssetId}/view`} title="Open the asset it was made from">{originBadge}</a>
      : <span class="origin-badge">{originBadge}</span>)}
    {decision && <span class={`origin-badge decision-${decision.decision}`} title={decision.note ?? undefined}>{decision.label}</span>}
    {asset.versionsCount > 0 && versionsHref && (
      <a class="versions-link" href={versionsHref}>{asset.versionsCount} {asset.versionsCount === 1 ? "version" : "versions"}</a>
    )}
    {asset.slug && <div class="slug"><code>{asset.slug}</code></div>}
    {asset.tags?.length > 0 && <div class="tags-row"><TagList tags={asset.tags} /></div>}
  </td>
  <td class="asset-type stack-hide"><span class="type-badge">{asset.mimeType}</span></td>
  <td class="stack-hide">
    {asset.width && asset.height
      ? `${asset.width} × ${asset.height}`
      : '—'}
  </td>
  <td class="stack-hide">
    {asset.fileSize
      ? `${(asset.fileSize / 1024).toFixed(1)} KB`
      : '—'}
  </td>
  <td class="alt-text-cell stack-hide">{asset.altText || (isUnsearchableImage(asset) ? <span class="not-searchable" title="No alt text or description: search can't find it">Not searchable</span> : '—')}</td>
  <td>
    <div class="actions">
      {inTrash ? (
        <a href={`/workspace/assets/${asset.id}`} class="button secondary small" title={canEdit ? "Restore it or delete it forever" : undefined}>Open</a>
      ) : (
        <>
          <a href={`/workspace/assets/${asset.id}/view`} class="button secondary small">View</a>
          {canEdit && (
            <>
              <a href={`/workspace/assets/${asset.id}`} class="button secondary small">Edit</a>
              <form method="POST" action={`/api/assets/${asset.id}/delete`} style="display:inline;">
                <button type="submit" class="button secondary small" title="Move to the Trash (restore it from there)">
                  Move to Trash
                </button>
              </form>
            </>
          )}
        </>
      )}
    </div>
  </td>
</tr>

<style>
  .asset-row[data-href] { cursor: pointer; }
  .preview { display: block; text-decoration: none; }
  .name-link { color: inherit; text-decoration: none; }
  .name-link:hover strong { text-decoration: underline; }
  .origin-badge,
  .versions-link {
    display: inline-block;
    margin-left: 0.4rem;
    padding: 0 0.4rem;
    border-radius: 999px;
    font-size: 0.75rem;
    line-height: 1.4rem;
    border: 1px solid var(--line);
    color: var(--muted);
    text-decoration: none;
  }
  .origin-badge.decision-denied {
    color: var(--color-error);
    border-color: var(--color-error);
  }
  .origin-badge.decision-approved {
    color: var(--color-success, var(--accent));
  }
  .versions-link {
    color: var(--accent, inherit);
  }
  .preview {
    width: 80px;
    height: 80px;
    border-radius: 6px;
    overflow: hidden;
    background: var(--panel-2);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .preview img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .file-icon {
    font-size: 2rem;
    opacity: 0.7;
  }

  .slug {
    margin-top: 0.25rem;
    font-size: 0.75rem;
    color: var(--muted);
  }
  .tags-row {
    margin-top: 0.35rem;
  }

  .type-badge {
    display: inline-block;
    padding: 0.25rem 0.5rem;
    background: var(--panel-2);
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
  }

  .alt-text-cell {
    max-width: 200px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 0.875rem;
    color: var(--muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .button.small {
    min-height: 32px;
    padding: 6px 10px;
    font-size: 0.875rem;
  }

  .button.danger {
    color: var(--color-error);
    border-color: var(--color-error);
  }

  .button.danger:hover {
    background: var(--color-error-bg);
  }

  .trash-badge {
    display: inline-block;
    margin-left: 0.5rem;
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    background: var(--color-error-bg);
    color: var(--color-error);
    font-size: 0.7rem;
    font-weight: 600;
  }

  .not-searchable { color: var(--muted); font-style: italic; }
</style>
