---
import ThemeInit from "@/components/ThemeInit.astro";
import "../styles/global.css";
// Server-rendered: it reads the token from the link and posts the new password.
export const prerender = false;

import Pwa from "@/components/Pwa.astro";
import RuntimeConfig from "@/components/RuntimeConfig.astro";
import { resetPassword } from "@/lib/api/auth";
import { getEnvironmentLabel, withEnvironmentPrefix } from "@/lib/environmentLabel";

// Non-production instances (backend ENVIRONMENT_LABEL) prefix the tab title.
const environmentLabel = await getEnvironmentLabel();

// The link in the reset email: /reset-password/?token=… (services/user/password_reset_service.py). The token is a
// one-use credential, so it also travels as a hidden field and the page sends no Referer.
let token = Astro.url.searchParams.get("token") ?? "";
let success = false;
let error: string | null = null;

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  token = String(formData.get("token") ?? token);
  const password = String(formData.get("password") ?? "");
  const passwordConfirm = String(formData.get("passwordConfirm") ?? "");
  if (password !== passwordConfirm) {
    error = "The two passwords don't match.";
  } else {
    try {
      await resetPassword(token, password, passwordConfirm);
      success = true;
    } catch (e: any) {
      // The API's own reason (an expired link, a password that's too short), without the status code.
      error = String(e?.message || "Something went wrong. Please try again.").replace(/\s*\(\d{3}\)$/, "");
    }
  }
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <ThemeInit />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="referrer" content="no-referrer" />
    <title>{withEnvironmentPrefix("Choose a New Password | Marvin", environmentLabel)}</title>
    <RuntimeConfig />
    <Pwa environmentLabel={environmentLabel} />
  </head>
  <body class="reset-password-page">
    <div class="reset-password-container">
      <div class="reset-password-card">
        <div class="reset-password-header">
          <div class="brand-logo">
            <strong>Marvin</strong>
            <span>Content engine</span>
          </div>
          <h1>Choose a new password</h1>
          {!success && token && <p>Enter it twice to be sure.</p>}
        </div>

        {success ? (
          <div class="success-message">
            <strong>✓ Password changed</strong>
            <p>Sign in with your new password.</p>
            <a href="/login" class="button primary" style="margin-top:1.5rem;">Go to Login</a>
          </div>
        ) : !token ? (
          <div class="error-message">
            <strong>⚠ This link is incomplete</strong>
            <p>Open the link from your reset email again, or ask for a new one.</p>
            <a href="/forgot" class="button primary" style="margin-top:1rem;">Send a New Link</a>
          </div>
        ) : (
          <>
            {error && (
              <div class="error-message">
                <strong>⚠ Couldn't change the password</strong>
                <p>{error}</p>
                {/expired|invalid/i.test(error) && <p><a href="/forgot">Ask for a new link</a></p>}
              </div>
            )}

            <form method="POST" class="reset-password-form">
              <input type="hidden" name="token" value={token} />
              <div class="form-group">
                <label for="password">New password</label>
                <input type="password" id="password" name="password" required autofocus autocomplete="new-password" />
              </div>
              <div class="form-group">
                <label for="passwordConfirm">Confirm new password</label>
                <input type="password" id="passwordConfirm" name="passwordConfirm" required autocomplete="new-password" />
              </div>

              <div class="form-actions">
                <button type="submit" class="button primary">Change Password</button>
                <a href="/login" class="button secondary">Back to Login</a>
              </div>
            </form>
          </>
        )}
      </div>
    </div>
  </body>
</html>

<style>
  .reset-password-page {
    min-height: 100vh;
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, #1e2725 0%, #2f4a47 100%);
    padding: 2rem;
  }

  .reset-password-container {
    width: 100%;
    max-width: 24rem;
  }

  .reset-password-card {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 2.5rem;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
  }

  .reset-password-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .brand-logo {
    display: grid;
    gap: 4px;
    margin-bottom: 2rem;
  }

  .brand-logo strong {
    font-size: 32px;
    font-weight: 700;
    color: var(--ink);
  }

  .brand-logo span {
    font-size: 14px;
    color: var(--muted);
    letter-spacing: 0.5px;
  }

  .reset-password-header h1 {
    margin: 0 0 0.5rem;
    font-size: 24px;
    font-weight: 600;
    color: var(--ink);
  }

  .reset-password-header p {
    margin: 0;
    color: var(--muted);
    font-size: 15px;
  }

  .success-message {
    padding: 1.5rem;
    background: rgba(34, 197, 94, 0.1);
    border: 1px solid rgba(34, 197, 94, 0.3);
    border-radius: 8px;
    text-align: center;
  }

  .success-message strong {
    display: block;
    margin-bottom: 0.5rem;
    color: #22c55e;
    font-size: 16px;
  }

  .success-message p {
    margin: 0;
    color: var(--ink);
    font-size: 14px;
    line-height: 1.5;
  }

  .error-message {
    padding: 1rem;
    margin-bottom: 1.5rem;
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.3);
    border-radius: 8px;
  }

  .error-message strong {
    display: block;
    margin-bottom: 0.25rem;
    color: #ef4444;
    font-size: 14px;
  }

  .error-message p {
    margin: 0;
    color: #ef4444;
    font-size: 13px;
  }

  .reset-password-form {
    display: grid;
    gap: 1.25rem;
  }

  .form-group {
    display: grid;
    gap: 0.5rem;
  }

  .form-group label {
    font-weight: 600;
    font-size: 14px;
    color: var(--ink);
  }

  .form-group input {
    padding: 0.75rem 1rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--bg);
    font-size: 15px;
    transition: all 0.2s;
  }

  .form-group input:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(169, 77, 63, 0.1);
  }

  .form-actions {
    margin-top: 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .button {
    width: 100%;
    padding: 0.875rem 1.5rem;
    border: none;
    border-radius: 8px;
    font-weight: 600;
    font-size: 15px;
    cursor: pointer;
    transition: all 0.2s;
    text-align: center;
    text-decoration: none;
    display: inline-block;
    box-sizing: border-box;
  }

  .button.primary {
    background: var(--accent);
    color: white;
  }

  .button.primary:hover {
    background: #8f3f31;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(169, 77, 63, 0.3);
  }

  .button.secondary {
    background: transparent;
    color: var(--muted);
    border: 1px solid var(--line);
  }

  .button.secondary:hover {
    background: var(--panel-2);
    color: var(--ink);
  }

  @media (max-width: 480px) {
    .reset-password-card {
      padding: 2rem 1.5rem;
    }
  }
</style>
