---
import AppLayout from "@/layouts/AppLayout.astro";
import { getAuthToken } from "@/lib/api/client";
import { createSdkClient } from "@/lib/sdk";
import { isForbidden } from "@/lib/workspaceRole";

const authToken = getAuthToken(Astro.cookies);
const sdk = createSdkClient(authToken);

const filter = Astro.url.searchParams.get("filter") || "all";

let logs: any[] = [];
let webhooks: any[] = [];
let error: string | null = null;
let adminOnly = false;

try {
  [logs, webhooks] = await Promise.all([sdk.webhooks.log({ limit: 200 }), sdk.webhooks.list()]);
} catch (e) {
  console.error("[webhooks/log] Error:", e);
  if (isForbidden(e)) adminOnly = true;
  else error = e instanceof Error ? e.message : String(e);
}

// API returns camelCase due to _MarvinModel alias_generator
const webhookMap = new Map(webhooks.map((w: any) => [w.id, w]));
const filteredLogs = filter === "all" ? logs : logs.filter((l: any) => l.status === filter);

function getField(log: any, camel: string, snake: string) {
  return log[camel] ?? log[snake];
}

function formatDate(isoStr: string): string {
  if (!isoStr) return "—";
  const normalized = isoStr.replace(/(\.\d{3})\d+/, "$1");
  const d = new Date(normalized);
  return Number.isNaN(d.getTime()) ? isoStr : d.toLocaleString();
}

function statusClass(status: string): string {
  if (status === "success") return "success";
  if (status === "failed") return "failed";
  if (status === "retrying") return "timeout";
  return "none";
}
---

<AppLayout adminOnly={adminOnly} title="Webhook Activity Log" eyebrow="Automation">
  <div class="page-header">
    <div class="breadcrumb">
      <a href="/automation/webhooks">Webhooks</a>
      <span>›</span>
      <span>Activity Log</span>
    </div>
    <h2>Webhook Activity Log</h2>
    <p>Execution history for all webhooks in this workspace</p>
  </div>

  <div class="filters">
    <a href="?filter=all" class:list={['filter-btn', { active: filter === 'all' }]}>All ({logs.length})</a>
    <a href="?filter=success" class:list={['filter-btn', { active: filter === 'success' }]}>Success</a>
    <a href="?filter=failed" class:list={['filter-btn', { active: filter === 'failed' }]}>Failed</a>
    <a href="?filter=retrying" class:list={['filter-btn', { active: filter === 'retrying' }]}>Retrying</a>
  </div>

  {error ? (
    <div class="alert alert-error"><strong>Error:</strong> {error}</div>
  ) : filteredLogs.length === 0 ? (
    <div class="empty-state">
      <div class="empty-icon">🔗</div>
      <p class="empty-title">No webhook executions yet</p>
      <p class="empty-desc">Logs appear here after webhooks fire or are tested</p>
      <a href="/automation/webhooks" class="button">View Webhooks</a>
    </div>
  ) : (
    <div class="table-wrap">
      <table class="log-table">
        <thead>
          <tr>
            <th></th>
            <th>Executed At</th>
            <th>Webhook</th>
            <th>Method</th>
            <th>Status</th>
            <th>HTTP</th>
            <th>Attempt</th>
          </tr>
        </thead>
        <tbody>
          {filteredLogs.map((log: any, i: number) => {
            const webhookId = log.webhookId ?? log.webhook_id;
            const executedAt = log.executedAt ?? log.executed_at;
            const httpStatus = log.httpStatusCode ?? log.http_status_code;
            const errorMsg = log.errorMessage ?? log.error_message;
            const retryAttempt = log.retryAttempt ?? log.retry_attempt ?? 0;
            const payload = log.requestPayload ?? log.request_payload;
            const responseBody = log.responseBody ?? log.response_body;
            const webhook = webhookMap.get(webhookId);
            const hasDetails = !!(errorMsg || payload || responseBody);
            return (
              <>
                <tr class:list={['log-row', { 'has-details': hasDetails }]}>
                  <td class="expand-cell">
                    {hasDetails && (
                      <button class="expand-btn" data-target={`detail-${i}`}>▶</button>
                    )}
                  </td>
                  <td class="nowrap">{formatDate(executedAt)}</td>
                  <td>
                    {webhook
                      ? <a href={`/automation/webhooks/${webhookId}`} class="webhook-link">{webhook.name}</a>
                      : <span class="muted">{webhookId?.slice(0, 8)}…</span>}
                  </td>
                  <td>
                    <code class="method-badge">{webhook?.method ?? '—'}</code>
                  </td>
                  <td>
                    <span class={`status-chip status-${statusClass(log.status)}`}>{log.status}</span>
                  </td>
                  <td>
                    {httpStatus
                      ? <code class={`http-code ${httpStatus < 300 ? 'ok' : 'err'}`}>{httpStatus}</code>
                      : <span class="muted">—</span>}
                  </td>
                  <td>{retryAttempt > 0 ? `#${retryAttempt + 1}` : '1'}</td>
                </tr>
                {hasDetails && (
                  <tr class="detail-row" id={`detail-${i}`} style="display:none">
                    <td colspan="7">
                      <div class="detail-body">
                        {errorMsg && (
                          <div class="detail-section">
                            <div class="detail-label">Error</div>
                            <div class="detail-message">{errorMsg}</div>
                          </div>
                        )}
                        {payload && (
                          <div class="detail-section">
                            <div class="detail-label">Payload Sent</div>
                            <pre class="payload-json">{JSON.stringify(payload, null, 2)}</pre>
                          </div>
                        )}
                        {responseBody && (
                          <div class="detail-section">
                            <div class="detail-label">Response Body</div>
                            <pre class="payload-json response-body">{responseBody}</pre>
                          </div>
                        )}
                      </div>
                    </td>
                  </tr>
                )}
              </>
            );
          })}
        </tbody>
      </table>
    </div>
  )}
</AppLayout>

<script>
  document.querySelectorAll('.expand-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const id = (btn as HTMLElement).dataset.target!;
      const row = document.getElementById(id);
      if (!row) return;
      const open = row.style.display !== 'none';
      row.style.display = open ? 'none' : 'table-row';
      (btn as HTMLElement).textContent = open ? '▶' : '▼';
    });
  });
</script>

<style>
  .page-header {
    margin-bottom: 24px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--line);
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    color: var(--muted);
    margin-bottom: 12px;
  }

  .breadcrumb a { color: var(--muted); text-decoration: none; }
  .breadcrumb a:hover { color: var(--ink); }

  .page-header h2 { margin: 0 0 8px; font-size: 24px; font-weight: 600; }
  .page-header p { margin: 0; color: var(--muted); font-size: 14px; }

  .filters { display: flex; gap: 8px; margin-bottom: 24px; }

  .filter-btn {
    padding: 6px 14px;
    border-radius: var(--radius);
    font-size: 13px;
    font-weight: 500;
    text-decoration: none;
    color: var(--muted);
    border: 1px solid var(--line);
    background: var(--panel);
    transition: all 0.15s;
  }

  .filter-btn:hover { color: var(--ink); border-color: var(--ink); }
  .filter-btn.active { background: var(--ink); color: var(--bg); border-color: var(--ink); }

  .alert {
    padding: 16px;
    margin-bottom: 24px;
    border-radius: var(--radius);
    background: var(--color-error-bg);
    color: var(--color-error);
    border: 1px solid var(--color-error);
  }

  .empty-state { padding: 80px 24px; text-align: center; }
  .empty-icon { font-size: 48px; margin-bottom: 16px; opacity: 0.3; }
  .empty-title { margin: 0 0 8px; font-size: 18px; font-weight: 600; }
  .empty-desc { margin: 0 0 24px; color: var(--muted); font-size: 14px; }

  .table-wrap { overflow-x: auto; }

  .log-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }

  .log-table th {
    text-align: left;
    padding: 10px 12px;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--muted);
    border-bottom: 2px solid var(--line);
    white-space: nowrap;
  }

  .log-table td {
    padding: 10px 12px;
    border-bottom: 1px solid var(--line);
    vertical-align: middle;
  }

  .log-row:hover td { background: var(--panel); }

  .expand-cell { width: 32px; padding: 10px 6px 10px 12px; }

  .expand-btn {
    background: none;
    border: none;
    cursor: pointer;
    color: var(--muted);
    font-size: 11px;
    padding: 2px 4px;
    border-radius: 3px;
  }

  .expand-btn:hover { background: var(--line); color: var(--ink); }

  .detail-row td { padding: 0; border-bottom: 1px solid var(--line); }

  .detail-body {
    padding: 16px 16px 16px 52px;
    background: var(--panel);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .detail-section { display: flex; flex-direction: column; gap: 4px; }

  .detail-label {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    color: var(--muted);
  }

  .detail-message {
    font-size: 13px;
    color: var(--color-error);
    font-family: ui-monospace, monospace;
  }

  .response-body { border-color: rgba(239,68,68,0.2); background: rgba(239,68,68,0.03); }

  .payload-json {
    font-size: 12px;
    font-family: ui-monospace, monospace;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 12px;
    margin: 0;
    overflow-x: auto;
    max-height: 400px;
    overflow-y: auto;
    white-space: pre;
    color: var(--ink);
  }

  .nowrap { white-space: nowrap; }
  .muted { color: var(--muted); font-size: 13px; }

  .webhook-link { color: var(--ink); text-decoration: none; font-weight: 500; }
  .webhook-link:hover { color: var(--accent); }

  .status-chip {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
  }

  .status-success { background: rgba(79, 156, 132, 0.1); color: var(--accent); }
  .status-failed { background: rgba(239, 68, 68, 0.1); color: var(--color-error); }
  .status-timeout { background: rgba(217, 119, 6, 0.1); color: #d97706; }
  .status-none { color: var(--muted); }

  .http-code {
    font-family: ui-monospace, monospace;
    font-size: 12px;
    padding: 1px 6px;
    border-radius: 3px;
  }

  .http-code.ok { background: rgba(79, 156, 132, 0.1); color: var(--accent); }
  .http-code.err { background: rgba(239, 68, 68, 0.1); color: var(--color-error); }

  .method-badge {
    font-size: 11px;
    font-family: ui-monospace, monospace;
    background: var(--panel);
    border: 1px solid var(--line);
    padding: 1px 6px;
    border-radius: 3px;
  }
</style>
