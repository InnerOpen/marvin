---
// Automation → Packages: bundles of blueprints (entry types, workflows, collections...) this workspace has installed, plus adding one from
// a file and building one from the workspace's own content. A package groups what belongs together under one label (the Workflows page
// shows it as one collapsed section) and travels as a single JSON file. Owners and admins only: the server refuses everyone else.
import AppLayout from "@/layouts/AppLayout.astro";
import { getAuthToken } from "@/lib/api/client";
import { listCollections } from "@/lib/api/collections";
import { listEntryTypes } from "@/lib/api/entryTypes";
import { getIntegrationFootprint, listIntegrations } from "@/lib/api/integrations";
import { footprintSections, type FootprintSection } from "@/lib/integrationFootprint";
import { listPackages, type PackageInfo } from "@/lib/api/packages";
import { createSdkClient } from "@/lib/sdk";

const authToken = getAuthToken(Astro.cookies);
const byName = (a: { name: string }, b: { name: string }) => a.name.localeCompare(b.name);
let error: string | null = null;
let packages: PackageInfo[] = [];
let workflows: { slug: string; name: string }[] = [];
let entryTypes: { slug: string; name: string }[] = [];
let collections: { slug: string; name: string }[] = [];
// What each integration's blueprints installed here: read-only, so everything that brings structure in is on one page.
let fromIntegrations: { id: string; name: string; sections: FootprintSection[] }[] = [];

if (!authToken) {
  error = "Authentication required";
} else {
  try {
    packages = await listPackages(authToken);
    const sdk = createSdkClient(authToken);
    const [wf, types, cols] = await Promise.all([sdk.automations.list(), listEntryTypes(authToken), listCollections(authToken)]);
    // Only what is free to bundle: a workflow already in a package belongs to that one, and built-in types and collections are not packaged.
    workflows = (wf as any[]).filter((w) => !w.sourcePackage).map((w) => ({ slug: w.slug, name: w.name }));
    entryTypes = (types as any[]).filter((t) => !t.isSystem).map((t) => ({ slug: t.slug, name: t.name }));
    collections = (cols as any[]).filter((c) => !c.isSystem).map((c) => ({ slug: c.slug, name: c.name }));
    try {
      const integrations = await listIntegrations(authToken);
      const found = await Promise.all(
        integrations.map(async (i: any) => ({ id: i.id as string, name: (i.name || i.slug) as string, sections: footprintSections(await getIntegrationFootprint(i.id, authToken)) })),
      );
      fromIntegrations = found.filter((f) => f.sections.length > 0).sort(byName);
    } catch {
      /* integrations are optional here: the block just does not show */
    }
  } catch (e) {
    error = /403|forbidden/i.test(String((e as Error)?.message)) ? "Packages are for workspace owners and admins." : `Could not load packages: ${(e as Error)?.message ?? e}`;
  }
}
const choices = { workflows: workflows.sort(byName), entryTypes: entryTypes.sort(byName), collections: collections.sort(byName) };
const dataJson = JSON.stringify({ packages, ...choices }).replace(/</g, "\\u003c");
const plural = (n: number, word: string) => `${n} ${word}${n === 1 ? "" : "s"}`;
const holds = (p: PackageInfo) =>
  [
    p.workflows ? `${plural(p.workflows, "workflow")} (${p.workflowsOn} on)` : "",
    p.entryTypes.length ? plural(p.entryTypes.length, "entry type") : "",
    p.collections ? plural(p.collections, "collection") : "",
    p.wizards?.length ? plural(p.wizards.length, "guided setup") : "",
    p.views?.length ? plural(p.views.length, "view") : "",
    p.scheduledTasks ? plural(p.scheduledTasks, "scheduled task") : "",
    p.incomingWebhooks ? plural(p.incomingWebhooks, "incoming webhook") : "",
  ]
    .filter(Boolean)
    .join(" · ") || "nothing yet";
---

<AppLayout width="wide" crumb="automation.packages">
  <div class="toolbar">
    <div>
      <h2>Packages</h2>
      <p class="sub">A package is a named set of blueprints (workflows, entry types, collections and more) kept as one file, so it can be installed, downloaded and shared. Install one, build your own from this workspace, or download it to use in another. Installing never overwrites anything, and workflows arrive switched off.</p>
    </div>
  </div>

  {error && <div class="alert error">{error}</div>}

  {!error && (
    <>
      <section class="card" data-testid="installed">
        <h3>Installed</h3>
        {packages.length === 0 ? (
          <p class="empty">No packages yet. Add one from a file below, or build one from what this workspace already has.</p>
        ) : (
          <ul class="packages">
            {packages.map((p) => (
              <li class="package" data-slug={p.slug} data-name={p.name}>
                <div class="package-head">
                  <strong>{p.name}</strong>
                  <span class="pill">v{p.version}</span>
                  <span class="muted">{p.slug}</span>
                </div>
                {p.description && <p class="muted">{p.description}</p>}
                <p class="holds">{holds(p)}</p>
                {p.wizards?.length ? <p class="holds"><a href="/workspace/setups">Open its guided setups →</a></p> : null}
                <div class="actions">
                  {p.workflows > p.workflowsOn && <button type="button" class="button js-enable">Turn on {plural(p.workflows - p.workflowsOn, "workflow")}</button>}
                  <button type="button" class="button secondary js-download">Download</button>
                  <button type="button" class="button secondary danger js-remove">Remove</button>
                </div>
                <p class="note" role="status" hidden></p>
              </li>
            ))}
          </ul>
        )}
      </section>

      {fromIntegrations.length > 0 && (
        <section class="card" data-testid="from-integrations">
          <h3>Brought by integrations</h3>
          <p class="muted">Integrations install blueprints of their own when you add them. These are not packages and are managed on the integration; this is what they put in this workspace.</p>
          <ul class="packages">
            {fromIntegrations.map((i) => (
              <li class="package">
                <div class="package-head">
                  <strong>{i.name}</strong>
                  <a class="muted" href="/workspace/settings/integrations">Manage</a>
                </div>
                <p class="holds">
                  {i.sections.map((sec, n) => (<>{n ? " · " : ""}<a href={sec.href}>{sec.heading}</a></>))}
                </p>
              </li>
            ))}
          </ul>
        </section>
      )}

      <section class="card" data-testid="add">
        <h3>Add a package</h3>
        <p class="muted">Choose a package file (<code>.marvin-package.json</code>). You see exactly what it would create before anything is installed.</p>
        <label class="drop" id="pk-drop" for="pk-file">
          <input type="file" id="pk-file" class="sr-only" accept=".json,application/json" />
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="17 8 12 3 7 8"></polyline>
            <line x1="12" y1="3" x2="12" y2="15"></line>
          </svg>
          <span class="drop-title">Choose a package file, or drop it here</span>
          <span class="drop-hint" id="pk-file-name">.marvin-package.json</span>
        </label>
        <div id="pk-preview" hidden>
          <p id="pk-preview-title" class="preview-title"></p>
          <div class="table-wrap">
            <table class="stack">
              <thead><tr><th>Kind</th><th>Name</th><th>Result</th><th>Details</th></tr></thead>
              <tbody id="pk-preview-rows"></tbody>
            </table>
          </div>
          <div class="actions">
            <button type="button" class="button" id="pk-install">Install</button>
            <button type="button" class="button secondary" id="pk-cancel">Cancel</button>
          </div>
        </div>
        <p id="pk-add-note" class="note" role="status" hidden></p>
      </section>

      <section class="card" data-testid="build">
        <h3>Build a package from this workspace</h3>
        <p class="muted">Choose what belongs together. "Group them here" files them under the package's label on the Workflows page without recreating anything. The file is for using the same set in another workspace.</p>
        <form id="pk-build" autocomplete="off">
          <div class="fields">
            <label>Name<input class="input" type="text" id="pk-name" required maxlength="120" placeholder="Brand kit" /></label>
            <label>Slug<input class="input" type="text" id="pk-slug" required maxlength="64" pattern="[a-z0-9][a-z0-9\-]*" placeholder="brand-kit" /></label>
            <label class="wide">Description<input class="input" type="text" id="pk-desc" placeholder="What this set is for" /></label>
          </div>
          {[["workflows", "Workflows", choices.workflows], ["entryTypes", "Entry types", choices.entryTypes], ["collections", "Collections", choices.collections]].map(([key, label, list]: any) => (
            <fieldset data-group={key}>
              <legend>{label} <button type="button" class="linkish js-all">all</button> <button type="button" class="linkish js-none">none</button></legend>
              {list.length === 0 ? <p class="muted">None available.</p> : (
                <div class="checks">
                  {list.map((c: { slug: string; name: string }) => <label class="check" title={c.slug}><input type="checkbox" value={c.slug} /> {c.name}</label>)}
                </div>
              )}
            </fieldset>
          ))}
          <label class="check"><input type="checkbox" id="pk-adopt" checked /> Group them here too (they collapse together on the Workflows page)</label>
          <div class="actions"><button type="submit" class="button">Build and download</button></div>
        </form>
        <p id="pk-build-note" class="note" role="status" hidden></p>
      </section>
    </>
  )}

  <script type="application/json" id="pk-data" is:inline set:html={dataJson}></script>
</AppLayout>

<script>
  import { describeResult, parseManifestText, slugFor, fileNameFor } from "@/lib/packageFile";
  import {
    enablePackage,
    exportPackage,
    getPackageFile,
    installPackage,
    previewPackage,
    removePackage,
    type PackageManifest,
    type PackageResult,
  } from "@/lib/api/packages";

  const $ = (id: string) => document.getElementById(id)!;
  const esc = (s: unknown) => String(s ?? "").replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]!);
  const message = (el: HTMLElement | null, text: string, bad = false) => {
    if (!el) return;
    el.textContent = text;
    el.classList.toggle("bad", bad);
    el.hidden = !text;
  };
  const failure = (e: unknown) => (e instanceof Error ? e.message : String(e));

  function saveFile(manifest: PackageManifest, slug: string) {
    const url = URL.createObjectURL(new Blob([JSON.stringify(manifest, null, 2)], { type: "application/json" }));
    const a = Object.assign(document.createElement("a"), { href: url, download: fileNameFor(slug) });
    document.body.appendChild(a);
    a.click();
    a.remove();
    URL.revokeObjectURL(url);
  }

  // ── Installed packages: turn on, download, remove ──
  document.querySelectorAll<HTMLElement>(".package").forEach((card) => {
    const slug = card.dataset.slug!;
    const note = card.querySelector<HTMLElement>(".note");
    const run = async (button: HTMLButtonElement, work: () => Promise<void>) => {
      button.disabled = true;
      message(note, "");
      try {
        await work();
      } catch (e) {
        message(note, failure(e), true);
        button.disabled = false;
      }
    };
    card.querySelector<HTMLButtonElement>(".js-enable")?.addEventListener("click", (e) =>
      run(e.currentTarget as HTMLButtonElement, async () => {
        const done = await enablePackage(slug);
        message(note, `${done.switchedOn} workflow${done.switchedOn === 1 ? "" : "s"} switched on.`);
        setTimeout(() => location.reload(), 900);
      }),
    );
    card.querySelector<HTMLButtonElement>(".js-download")?.addEventListener("click", (e) => {
      // Taken now: after the await below the event is over and `e.currentTarget` is null.
      const button = e.currentTarget as HTMLButtonElement;
      run(button, async () => {
        saveFile(await getPackageFile(slug), slug);
        button.disabled = false;
      });
    });
    card.querySelector<HTMLButtonElement>(".js-remove")?.addEventListener("click", (e) => {
      if (!confirm(`Remove the package "${card.dataset.name}"?\n\nThis only ungroups it. Nothing it created is deleted.`)) return;
      run(e.currentTarget as HTMLButtonElement, async () => {
        const done = await removePackage(slug);
        message(note, `Ungrouped ${done.ungrouped} item${done.ungrouped === 1 ? "" : "s"}; nothing was deleted.`);
        setTimeout(() => location.reload(), 900);
      });
    });
  });

  // ── Add from a file: read, preview, then install ──
  let pending: PackageManifest | null = null;
  const addNote = $("pk-add-note");
  const rows = $("pk-preview-rows");
  const WHAT: Record<string, string> = { create: "Will be created", created: "Created", exists: "Already here, left as it is", blocked: "Blocked" };

  function showPreview(result: PackageResult, preview: boolean) {
    $("pk-preview-title").textContent = `${result.name}: ${describeResult(result, preview)}`;
    rows.innerHTML = result.items
      .map(
        (i) =>
          `<tr><td data-label="Kind">${esc(i.kind.replace("_", " "))}</td><td data-label="Name"><strong>${esc(i.name)}</strong></td><td data-label="Result" class="${i.status === "blocked" ? "bad-text" : ""}">${esc(WHAT[i.status] ?? i.status)}</td>${i.summary || i.detail ? `<td data-label="Details" class="long muted">${esc(i.summary || i.detail)}</td>` : ""}</tr>`,
      )
      .join("");
    $("pk-preview").hidden = false;
  }

  const fileName = $("pk-file-name");
  const DEFAULT_HINT = fileName.textContent ?? "";
  const drop = $("pk-drop");
  ["dragenter", "dragover"].forEach((type) =>
    drop.addEventListener(type, (e) => {
      e.preventDefault();
      drop.classList.add("dragover");
    }),
  );
  drop.addEventListener("dragleave", () => drop.classList.remove("dragover"));
  drop.addEventListener("drop", (e) => {
    e.preventDefault();
    drop.classList.remove("dragover");
    const files = (e as DragEvent).dataTransfer?.files;
    if (!files?.length) return;
    // Handed to the same input the picker uses, so one code path reads and previews the file.
    const input = $("pk-file") as HTMLInputElement;
    input.files = files;
    input.dispatchEvent(new Event("change"));
  });

  $("pk-file").addEventListener("change", async (e) => {
    const input = e.currentTarget as HTMLInputElement;
    const file = input.files?.[0];
    fileName.textContent = file ? file.name : DEFAULT_HINT;
    pending = null;
    $("pk-preview").hidden = true;
    message(addNote, "");
    if (!file) return;
    try {
      pending = parseManifestText(await file.text());
      showPreview(await previewPackage(pending), true);
      ($("pk-install") as HTMLButtonElement).disabled = false;
    } catch (err) {
      pending = null;
      message(addNote, failure(err), true);
    }
  });
  $("pk-cancel").addEventListener("click", () => {
    pending = null;
    ($("pk-file") as HTMLInputElement).value = "";
    fileName.textContent = DEFAULT_HINT;
    $("pk-preview").hidden = true;
  });
  $("pk-install").addEventListener("click", async (e) => {
    if (!pending) return;
    const button = e.currentTarget as HTMLButtonElement;
    button.disabled = true;
    try {
      const result = await installPackage(pending);
      showPreview(result, false);
      message(addNote, `Installed. ${describeResult(result, false)}. Workflows are switched off: turn them on from the package when you have read them.`);
      setTimeout(() => location.reload(), 2500);
    } catch (err) {
      message(addNote, failure(err), true);
      button.disabled = false;
    }
  });

  // ── Build from this workspace ──
  const name = $("pk-name") as HTMLInputElement;
  const slug = $("pk-slug") as HTMLInputElement;
  let slugEdited = false;
  slug.addEventListener("input", () => (slugEdited = true));
  name.addEventListener("input", () => {
    if (!slugEdited) slug.value = slugFor(name.value);
  });
  document.querySelectorAll<HTMLElement>("#pk-build fieldset").forEach((group) => {
    const boxes = () => group.querySelectorAll<HTMLInputElement>("input[type=checkbox]");
    group.querySelector(".js-all")?.addEventListener("click", () => boxes().forEach((b) => (b.checked = true)));
    group.querySelector(".js-none")?.addEventListener("click", () => boxes().forEach((b) => (b.checked = false)));
  });
  const picked = (key: string) =>
    Array.from(document.querySelectorAll<HTMLInputElement>(`#pk-build fieldset[data-group="${key}"] input:checked`), (b) => b.value);
  const buildNote = $("pk-build-note");
  $("pk-build").addEventListener("submit", async (e) => {
    e.preventDefault();
    const button = (e.currentTarget as HTMLElement).querySelector<HTMLButtonElement>("button[type=submit]")!;
    const adopt = ($("pk-adopt") as HTMLInputElement).checked;
    button.disabled = true;
    message(buildNote, "");
    try {
      const manifest = await exportPackage({
        slug: slug.value,
        name: name.value,
        description: ($("pk-desc") as HTMLInputElement).value,
        workflows: picked("workflows"),
        entryTypes: picked("entryTypes"),
        collections: picked("collections"),
        adopt,
      });
      saveFile(manifest, slug.value);
      message(buildNote, adopt ? "Built, downloaded and grouped here." : "Built and downloaded.");
      if (adopt) setTimeout(() => location.reload(), 1200);
      else button.disabled = false;
    } catch (err) {
      message(buildNote, failure(err), true);
      button.disabled = false;
    }
  });
</script>

<style>
  .sub { margin: 4px 0 0; color: var(--muted); }
  .card { border: 1px solid var(--line); border-radius: var(--radius); background: var(--panel); padding: 14px 16px; margin: 0 0 16px; }
  .card h3 { margin: 0 0 10px; font-size: 1rem; font-weight: 600; }
  .alert { padding: 10px 14px; border-radius: var(--radius); margin: 0 0 12px; }
  .alert.error { border: 1px solid var(--color-error, #dc2626); }
  .muted { color: var(--muted); }
  .empty { color: var(--muted); margin: 0; }
  .pill { display: inline-block; padding: 2px 9px; border-radius: 999px; font-size: 12px; border: 1px solid var(--line); background: var(--panel-2, var(--panel)); }
  .packages { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  .package { border-top: 1px solid var(--line); padding-top: 12px; }
  .package:first-child { border-top: 0; padding-top: 0; }
  .package-head { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; }
  .package p { margin: 6px 0 0; }
  .holds { font-size: 13px; }
  .actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px; }
  .note { font-size: 13px; color: var(--muted); }
  .note.bad, .bad-text { color: var(--color-error, #dc2626); }
  .drop { display: grid; justify-items: center; gap: 4px; padding: 1.4rem 1rem; border: 2px dashed var(--line); border-radius: var(--radius); text-align: center; cursor: pointer; transition: border-color 0.15s, background-color 0.15s; }
  .drop svg { color: var(--muted); }
  .drop:hover, .drop.dragover, .drop:focus-within { border-color: var(--accent); background: var(--panel-2); }
  .drop:focus-within { outline: 2px solid var(--accent); outline-offset: 2px; }
  .drop-title { font-weight: 600; }
  .drop-hint { font-size: 13px; color: var(--muted); overflow-wrap: anywhere; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  #pk-preview { margin-top: 14px; padding-top: 4px; border-top: 1px solid var(--line); }
  .preview-title { font-weight: 600; margin: 10px 0 6px; color: var(--ink); }
  .fields { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; margin-bottom: 12px; }
  .fields label { display: grid; gap: 4px; font-size: 13px; color: var(--muted); }
  .fields .wide { grid-column: 1 / -1; }
  fieldset { border: 1px solid var(--line); border-radius: var(--radius); margin: 0 0 12px; padding: 8px 12px 10px; }
  legend { font-size: 13px; font-weight: 600; padding: 0 6px; }
  .linkish { background: none; border: 0; color: var(--accent); cursor: pointer; font-size: 12px; padding: 0 2px; }
  .checks { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 6px 18px; }
  .check { display: flex; gap: 6px; align-items: baseline; font-size: 13px; }
  @media (max-width: 720px) { .fields { grid-template-columns: 1fr; } }
</style>

<style is:global>
  /* The preview's rows are drawn by the page script, so scoped styles would not reach them. */
  #pk-preview .table-wrap { overflow-x: auto; }
  #pk-preview table { width: 100%; border-collapse: collapse; font-size: 13px; }
  #pk-preview th, #pk-preview td { text-align: left; padding: 7px 8px; border-bottom: 1px solid var(--line); vertical-align: top; }
  #pk-preview th { font-size: 12px; color: var(--muted); font-weight: 600; }
  #pk-preview .muted { color: var(--muted); }
  #pk-preview .bad-text { color: var(--color-error, #dc2626); }
  @media (max-width: 720px) {
    #pk-preview .stack thead { display: none; }
    #pk-preview .stack, #pk-preview .stack tbody, #pk-preview .stack tr, #pk-preview .stack td { display: block; width: auto; }
    #pk-preview .stack tr { padding: 14px 0; border-bottom: 1px solid var(--line); }
    #pk-preview .stack tbody tr:last-child { padding-bottom: 0; border-bottom: 0; }
    #pk-preview .stack td { position: relative; border-bottom: 0; padding: 6px 0 6px 7.5rem; overflow-wrap: anywhere; }
    #pk-preview .stack td[data-label]::before { content: attr(data-label); position: absolute; left: 0; top: 8px; width: 6.5rem; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; color: var(--muted); }
    #pk-preview .stack td.long { padding-left: 0; }
    #pk-preview .stack td.long[data-label]::before { position: static; display: block; width: auto; margin-bottom: 3px; }
  }
</style>
