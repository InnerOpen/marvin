---
import ConnectionGroup from "@/components/events/ConnectionGroup.astro";
import ConnectionRow from "@/components/events/ConnectionRow.astro";
import AppLayout from "@/layouts/AppLayout.astro";
import { ApiRequestError, fetchApi, getAuthToken } from "@/lib/api/client";
import { getBrowserFetchBaseUrl } from "@/lib/api/config";
import { listEmailTemplates } from "@/lib/api/emailTemplates";
import { getEventConnections } from "@/lib/api/eventConnections";
import { listIntegrations, listProviders } from "@/lib/api/integrations";
import { canManageCurrentWorkspace, getCurrentWorkspace } from "@/lib/api/workspaces";
import {
  type EventConnections,
  type EventReaction,
  eventLogHref,
  formatWhen,
  groupReactions,
  groupSenders,
  isSystemEmail,
  managedHere,
  newWorkflowHref,
  systemEmailNote,
  triggerableEvents,
} from "@/lib/eventConnections";
import { createSdkClient } from "@/lib/sdk";

const authToken = getAuthToken(Astro.cookies);
// Admin-only page (the API refuses members with a 403); if the role can't be read, let the API decide.
const adminOnly = !(await canManageCurrentWorkspace(authToken!).catch(() => true));
const sdk = createSdkClient(authToken);
const { type } = Astro.params;

let eventInfo: any = null;
let emailTemplates: any[] = [];
let emailSubscriptions: any[] = [];
let webhooks: any[] = [];
let integrations: any[] = [];
let integrationProviders: any[] = [];
let integrationsAvailable = true;
let connections: EventConnections | null = null;
let reactions: EventReaction[] = [];
let triggerable = false;
let error: string | null = null;
let wsId: string | null = null;

const apiUrl = getBrowserFetchBaseUrl();

try {
  const allTypes = (await sdk.events.getOptions()) as any[];
  eventInfo = allTypes.find((e: any) => e.value === type) || null;

  // Unknown, and the platform's own events (sign-ups, workspaces, …): the workspace catalog leaves them out,
  // so their links land on the catalog. Super admins see them on Admin → Events.
  if (!eventInfo) {
    return Astro.redirect("/automation/events");
  }

  const workspace = await getCurrentWorkspace(authToken!);
  wsId = workspace?.id ?? null;

  let builderOptions: any = null;
  let connectionsResult: EventConnections | null = null;
  let emailRes: any;
  let webhookRes: any;
  let emailSubsRes: any;
  [connectionsResult, builderOptions, emailRes, webhookRes, emailSubsRes, integrations, integrationProviders] =
    await Promise.all([
      getEventConnections(type!, authToken).catch((e) => {
        console.error("[events/type] Connections failed:", e);
        return null;
      }),
      sdk.automations.options().catch(() => null),
      wsId ? listEmailTemplates(wsId, authToken).catch(() => []) : Promise.resolve([]),
      sdk.webhooks.list().catch(() => []),
      fetchApi<any[]>("/api/groups/email-event-subscriptions", {}, authToken).catch(() => []),
      listIntegrations(authToken).catch(() => []),
      listProviders(authToken).catch(() => []),
    ]);
  connections = connectionsResult;
  triggerable = triggerableEvents(builderOptions).includes(type!);
  emailTemplates = Array.isArray(emailRes) ? emailRes : (emailRes?.items ?? []);
  webhooks = Array.isArray(webhookRes) ? webhookRes : (webhookRes?.items ?? []);
  emailSubscriptions = Array.isArray(emailSubsRes) ? emailSubsRes : [];

  // Integrations are an optional, plugin-only feature — the backend only mounts the routes when an
  // integration package is installed. Probe the providers endpoint: a 404 means it's not installed,
  // so we surface a note instead of the "connect an action" affordance.
  try {
    await fetchApi("/api/groups/integrations/providers", {}, authToken);
  } catch (e) {
    if (e instanceof ApiRequestError && e.status === 404) {
      integrationsAvailable = false;
    }
  }

  reactions = connections?.reactions ?? [];
} catch (e) {
  console.error("[events/type] Error:", e);
  error = e instanceof Error ? e.message : String(e);
}

function buildExamplePayload(eventType: string, variables: any[]): object {
  const varExamples: Record<string, string> = {};
  for (const v of variables || []) varExamples[v.slug] = v.example || `<${v.slug}>`;
  return {
    eventType,
    eventId: "evt_a1b2c3d4-...",
    timestamp: new Date().toISOString().replace(/\.\d{3}Z$/, "Z"),
    workspaceId: "<workspace-uuid>",
    message: { title: eventType.replace(/_/g, " ").replace(/\b\w/g, (l: string) => l.toUpperCase()), body: eventType },
    documentData: varExamples,
    userId: "<user-uuid>",
  };
}

// Use real payload structure from the API if available, else fall back to client builder
const examplePayload =
  eventInfo?.payloadExample ?? (eventInfo ? buildExamplePayload(type!, eventInfo.variables || []) : {});

const now = new Date();
const reactionGroups = groupReactions(reactions);
const senderGroups = connections ? groupSenders(connections.senders) : [];
const webhooksById = new Map(webhooks.map((w: any) => [w.id, w]));

// The Subscribe menu offers what isn't connected yet; connected ones are listed under "What happens".
const eventDrivenWebhooks = webhooks.filter((w: any) => (w.webhookType ?? w.webhook_type) === "event_driven");
const openWebhooks = eventDrivenWebhooks.filter(
  (w: any) => !(w.subscribedEvents ?? w.subscribed_events ?? []).includes(type),
);
// System-typed workspace templates (invitation / password reset / welcome) belong to their own event only.
const SYSTEM_EVENT_MAP: Record<string, string> = {
  invitation: "invitation_sent",
  password_reset: "user_password_reset_requested",
  welcome: "user_signup",
};
const connectedTemplateIds = new Set(
  emailSubscriptions
    .filter((s: any) => (s.event_type ?? s.eventType) === type)
    .map((s: any) => s.template_id ?? s.templateId),
);
const openTemplates = emailTemplates.filter((t: any) => {
  if (!(t.groupId ?? t.group_id)) return false;
  const mapped = SYSTEM_EVENT_MAP[t.templateType ?? t.template_type];
  if (mapped && mapped !== type) return false;
  return !connectedTemplateIds.has(t.id);
});
---

<AppLayout crumb="automation.events.type" adminOnly={adminOnly} title={eventInfo ? eventInfo.label : 'Event'}>
  {error ? (
    <div class="alert alert-error"><strong>Error:</strong> {error}</div>
  ) : eventInfo ? (
    <>
      <div class="page-header">
        <div class="event-meta">
          <h2>{eventInfo.label}</h2>
          <span class="event-category">{eventInfo.category}</span>
        </div>
        {eventInfo.description && (
          <p class="event-description">{eventInfo.description}</p>
        )}
        <code class="event-type-code">{type}</code>
        {connections && (connections.causedBy.length > 0 || connections.leadsTo.length > 0) && (
          <div class="chain">
            {connections.causedBy.length > 0 && (
              <div class="chain-line">
                <span class="chain-label">Caused by</span>
                {connections.causedBy.map((t) => <a class="chain-chip" href={`/automation/events/${t.eventType}`}>{t.name}</a>)}
              </div>
            )}
            {connections.leadsTo.length > 0 && (
              <div class="chain-line">
                <span class="chain-label">Leads to</span>
                {connections.leadsTo.map((t) => <a class="chain-chip" href={`/automation/events/${t.eventType}`}>{t.name}</a>)}
              </div>
            )}
          </div>
        )}
      </div>

      <div class="story">
        <section class="ev-panel" aria-labelledby="sent-by-title">
          <div class="ev-panel-head">
            <div>
              <h3 id="sent-by-title">Sent by</h3>
              <p>What makes this event happen.</p>
            </div>
          </div>
          {connections ? (
            senderGroups.length ? (
              senderGroups.map((g) => (
                <ConnectionGroup label={g.label}>
                  {g.rows.map((s) =>
                    s.kind === "marvin" ? (
                      <ConnectionRow name={s.name} showState={false} />
                    ) : (
                      <ConnectionRow
                        name={s.name}
                        enabled={s.enabled}
                        detail={s.viaWorkflowId ? "Starts the workflow" : s.detail}
                        via={s.viaWorkflowId ? { label: s.viaWorkflowName ?? "workflow", href: `/automation/workflows?workflow=${s.viaWorkflowId}` } : null}
                        installedBy={s.installedBy}
                        href={s.managedAt}
                      />
                    ),
                  )}
                </ConnectionGroup>
              ))
            ) : (
              <p class="ev-empty">Nothing sends this event yet.</p>
            )
          ) : (
            <p class="ev-empty">
              Couldn't load what sends this event. Reload the page to try again.
            </p>
          )}
        </section>

        <section class="ev-panel" aria-labelledby="what-happens-title">
          <div class="ev-panel-head">
            <div>
              <h3 id="what-happens-title">What happens</h3>
              <p>Everything that runs when this event fires, however it was connected.</p>
            </div>
            <button type="button" class="button small" id="subscribe-toggle" aria-expanded="false" aria-controls="subscribe-menu">
              Subscribe <span aria-hidden="true">▾</span>
            </button>
          </div>

          <div id="subscribe-menu" class="subscribe-menu" hidden>
            {triggerable && (
              <div class="sm-group">
                <h4>Workflow</h4>
                <a href={newWorkflowHref(type!)} class="sm-create">+ New workflow on this event</a>
              </div>
            )}
            <div class="sm-group">
              <h4>Webhook</h4>
              <p class="sm-hint">Send an HTTP request — only Event-Driven webhooks appear here.</p>
              {openWebhooks.map((w: any) => (
                <div class="sm-option">
                  <div class="sm-option-info">
                    <strong>{w.name}</strong>
                    <code class="sub-url">{w.url?.toString().slice(0, 48)}{(w.url?.toString().length || 0) > 48 ? '…' : ''}</code>
                  </div>
                  <button
                    type="button"
                    class="button small"
                    data-open-webhook-modal={w.id}
                    data-webhook-name={w.name}
                    data-webhook-url={w.url}
                    data-webhook-method={w.method || 'POST'}
                    data-is-connected="false"
                  >
                    Connect
                  </button>
                </div>
              ))}
              <a href="/automation/webhooks/new" class="sm-create">+ Create a new webhook</a>
            </div>
            <div class="sm-group">
              <h4>Email</h4>
              <p class="sm-hint">Send one of your email templates.</p>
              {openTemplates.map((t: any) => (
                <div class="sm-option">
                  <div class="sm-option-info">
                    <strong>{t.name}</strong>
                    <code class="sub-type">{t.templateType ?? t.template_type}</code>
                  </div>
                  <button
                    class="button small connect-email-btn"
                    data-template-id={t.id}
                    data-template-name={t.name}
                    data-event-type={type}
                    data-subscription-id=""
                    data-is-connected="false"
                    data-is-edit="false"
                  >
                    Connect
                  </button>
                </div>
              ))}
              <a href="/workspace/settings/email" class="sm-create">+ Create or customize an email template</a>
            </div>
            <div class="sm-group">
              <h4>Integration action</h4>
              {integrationsAvailable ? (
                <>
                  <p class="sm-hint">Run an integration action (Slack, Apprise notifications, deploy hook, …).</p>
                  <button type="button" class="sm-create js-int-connect-open">+ Connect an integration action</button>
                </>
              ) : (
                <p class="sm-hint">
                  Integrations aren't installed. They're an optional add-on that ships separately from Marvin core:
                  install a provider package (e.g. <code>marvin-integration-slack</code>) and restart the server.
                </p>
              )}
            </div>
          </div>

          {reactionGroups.length ? (
            reactionGroups.map((g) => (
              <ConnectionGroup label={g.label} muted={g.kind === "builtin"}>
                {g.rows.map((r) => {
                  if (r.kind === "builtin") return <ConnectionRow name={r.name} showState={false} muted />;
                  if (isSystemEmail(r)) {
                    return (
                      <ConnectionRow
                        name={r.name}
                        enabled={r.enabled}
                        note={systemEmailNote(r)}
                        href={r.managedAt}
                        linkLabel="Customize"
                      />
                    );
                  }
                  if (!managedHere(r)) {
                    return (
                      <ConnectionRow
                        name={r.name}
                        enabled={r.enabled}
                        detail={r.detail}
                        installedBy={r.installedBy}
                        href={r.managedAt}
                      />
                    );
                  }
                  if (r.kind === "webhook") {
                    const w: any = webhooksById.get(r.id);
                    return (
                      <ConnectionRow name={r.name} enabled={r.enabled} detail={r.detail}>
                        <a href={`/automation/events/${type}/webhook/${r.id}`} class="button small secondary">Edit</a>
                        <button
                          type="button"
                          class="button small secondary danger"
                          data-open-webhook-modal={r.id}
                          data-webhook-name={r.name}
                          data-webhook-url={w?.url ?? ''}
                          data-webhook-method={w?.method || 'POST'}
                          data-is-connected="true"
                        >
                          Disconnect
                        </button>
                      </ConnectionRow>
                    );
                  }
                  if (r.kind === "email") {
                    return (
                      <ConnectionRow name={r.name} enabled={r.enabled} detail={r.detail}>
                        {r.managedAt && <a href={r.managedAt} class="button small secondary">Edit</a>}
                        <button type="button" class="button small secondary danger disconnect-email-btn" data-subscription-id={r.id ?? ''}>Disconnect</button>
                      </ConnectionRow>
                    );
                  }
                  return (
                    <ConnectionRow name={r.name} enabled={r.enabled} detail={r.detail}>
                      <button type="button" class="button small secondary danger js-int-disconnect" data-sub-id={r.id ?? ''}>Disconnect</button>
                    </ConnectionRow>
                  );
                })}
              </ConnectionGroup>
            ))
          ) : (
            <p class="ev-empty">
              {connections
                ? "Nothing reacts to this event yet. Use Subscribe to add a workflow, webhook, email or integration action."
                : "Couldn't load what reacts to this event. Reload the page to try again."}
            </p>
          )}
        </section>

        {connections && (
          <section class="ev-panel" aria-labelledby="recent-title">
            <div class="ev-panel-head">
              <div>
                <h3 id="recent-title">Recent</h3>
                <p>The newest times it happened in this workspace.</p>
              </div>
              {connections.audited && <a href="/workspace/events" class="button small secondary">Event Log</a>}
            </div>
            {!connections.audited ? (
              <p class="ev-empty">
                This event isn't recorded in this workspace's Event Log.{" "}
                <a href="/workspace/events#audit-coverage">Audit coverage</a> decides which events are recorded.
              </p>
            ) : connections.recent.length ? (
              <ul class="recent-list">
                {connections.recent.map((ev) => (
                  <li>
                    <a class="recent-row" href={eventLogHref(ev.eventId)}>
                      <span class="recent-main">
                        <span class="recent-title">{ev.messageTitle}</span>
                        {ev.messageBody && <span class="recent-body">{ev.messageBody}</span>}
                      </span>
                      <time class="recent-when" datetime={ev.occurredAt} title={ev.occurredAt}>{formatWhen(ev.occurredAt, now)}</time>
                    </a>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="ev-empty">It hasn't happened in this workspace yet.</p>
            )}
          </section>
        )}
      </div>
    </>
  ) : null}
<!-- Webhook connection modal -->
<div id="webhook-modal" class="wh-modal" style="display:none" aria-modal="true">
  <div class="wh-overlay"></div>
  <div class="wh-content">
    <div class="wh-header">
      <div>
        <h3 id="wh-title">Connect Webhook</h3>
        <code id="wh-url" class="wh-url"></code>
      </div>
      <button type="button" id="wh-close" class="wh-close">✕</button>
    </div>

    <div class="wh-body">
      <p class="wh-label">Your endpoint will receive this JSON via <span id="wh-method">POST</span>:</p>
      <pre id="wh-payload" class="wh-payload"></pre>
    </div>

    <div class="wh-footer">
      <span id="wh-note" class="wh-note"></span>
      <div class="wh-actions">
        <button type="button" id="wh-confirm" class="button">Connect</button>
        <a id="wh-edit-link" href="#" class="button secondary" style="display:none">Full page</a>
        <button type="button" id="wh-cancel" class="button secondary">Cancel</button>
      </div>
    </div>
  </div>
</div>

<!-- Email connection modal -->
<div id="email-modal" class="wh-modal" style="display:none" aria-modal="true">
  <div class="wh-overlay"></div>
  <div class="wh-content">
    <div class="wh-header">
      <div>
        <h3 id="em-title">Connect Email Template</h3>
        <code id="em-template-name" class="wh-url"></code>
      </div>
      <button type="button" id="em-close" class="wh-close">✕</button>
    </div>
    <div class="wh-body em-combined-body">
      <div class="em-section-divider">Recipient</div>
      <div class="em-recipient-options">
        <label class="em-radio-label">
          <input type="radio" name="em-recipient-type" value="admins" checked />
          Workspace admins
        </label>
        <label class="em-radio-label">
          <input type="radio" name="em-recipient-type" value="event_field" id="em-event-field-radio" />
          Field from event data
          <select id="em-event-field" class="em-field-select" style="display:none"></select>
          <span id="em-no-email-fields" class="em-hint" style="display:none">— no email fields for this event</span>
        </label>
        <label class="em-radio-label">
          <input type="radio" name="em-recipient-type" value="specific" />
          Specific email address
        </label>
        <input type="text" id="em-specific-email" class="em-email-input" placeholder="user@example.com, other@example.com" style="display:none" />
      </div>

      <div class="em-section-divider" style="margin-top:20px">Template</div>
      <div class="form-group">
        <label class="em-field-label">Subject</label>
        <input type="text" id="em-subject" class="em-text-input" placeholder="e.g. New entry in {{ workspace_name }}" />
      </div>
      <div class="form-group">
        <label class="em-field-label">Body</label>
        <div class="em-md-container">
          <div class="em-md-tabs">
            <button type="button" class="em-md-tab active" data-em-tab="write">Write</button>
            <button type="button" class="em-md-tab" data-em-tab="preview">Preview</button>
          </div>
          <textarea id="em-md-body" rows="8" class="em-text-input em-md-write" placeholder="Write in markdown — use {{ variable }} for event data"></textarea>
          <div id="em-md-preview" class="em-md-preview" style="display:none">
            <span class="em-md-empty">Nothing to preview</span>
          </div>
        </div>
      </div>
      <div id="em-unresolved-vars" class="em-unresolved" style="display:none"></div>
      <div id="em-template-vars" class="em-vars"></div>
      <a id="em-full-editor-link" href="/workspace/settings/email" class="em-subtle-link" target="_blank">Open full editor ↗</a>
    </div>

    <div class="wh-footer">
      <span id="em-note" class="wh-note"></span>
      <div class="wh-actions">
        <button type="button" id="em-confirm" class="button">Connect</button>
        <button type="button" id="em-cancel" class="button secondary">Cancel</button>
      </div>
    </div>
  </div>
</div>

<!-- Integration connection modal -->
<div id="int-modal" class="wh-modal" style="display:none" aria-modal="true">
  <div class="wh-overlay"></div>
  <div class="wh-content">
    <div class="wh-header">
      <div>
        <h3>Connect an integration</h3>
        <code class="wh-url">Runs on every {type} event</code>
      </div>
      <button type="button" id="int-close" class="wh-close">✕</button>
    </div>
    <div class="wh-body">
      <div class="form-group">
        <label class="em-field-label">Integration</label>
        <select id="int-select" class="em-text-input"></select>
      </div>
      <div class="form-group">
        <label class="em-field-label">Action</label>
        <select id="int-action" class="em-text-input"></select>
      </div>
      <div id="int-args"></div>
      <p class="wh-label" style="margin-top:10px;">Insert event data with <code>{"{{field}}"}</code> — e.g. <code>{"{{title}}"}</code>, <code>{"{{event_type}}"}</code>.</p>
    </div>
    <div class="wh-footer">
      <span id="int-note" class="wh-note"></span>
      <div class="wh-actions">
        <button type="button" id="int-confirm" class="button">Connect</button>
        <button type="button" id="int-cancel" class="button secondary">Cancel</button>
      </div>
    </div>
  </div>
</div>

<script type="application/json" id="int-data" set:html={JSON.stringify({ integrations, providers: integrationProviders, eventType: type }).replace(/</g, "\\u003c")}></script>

<script define:vars={{ type, apiUrl, examplePayload, eventVariables: eventInfo?.variables ?? [], wsId: wsId ?? null }}>
  // Webhook modal
  const modal = document.getElementById('webhook-modal');
  const whTitle = document.getElementById('wh-title');
  const whUrl = document.getElementById('wh-url');
  const whMethod = document.getElementById('wh-method');
  const whPayload = document.getElementById('wh-payload');
  const whNote = document.getElementById('wh-note');
  const whConfirm = document.getElementById('wh-confirm');
  const whEditLink = document.getElementById('wh-edit-link');
  let activeWebhookId = null;
  let activeIsConnected = false;

  function openModal(btn) {
    activeWebhookId = btn.dataset.openWebhookModal;
    activeIsConnected = btn.dataset.isConnected === 'true';
    const name = btn.dataset.webhookName;
    const url = btn.dataset.webhookUrl;
    const method = btn.dataset.webhookMethod || 'POST';

    whTitle.textContent = (activeIsConnected ? 'Connected: ' : 'Connect: ') + name;
    whUrl.textContent = url;
    whMethod.textContent = method;
    whPayload.textContent = JSON.stringify(examplePayload, null, 2);
    whNote.innerHTML = activeIsConnected
      ? '&#10003; Connected — firing on every <strong>' + type + '</strong> event.'
      : 'Connect to send a POST to this URL on every <strong>' + type + '</strong> event.';
    whConfirm.textContent = activeIsConnected ? 'Disconnect' : 'Connect';
    whConfirm.className = activeIsConnected ? 'button secondary danger' : 'button';
    // Show "Full page" link for connected webhooks
    if (whEditLink) {
      whEditLink.href = '/automation/events/' + type + '/webhook/' + activeWebhookId;
      whEditLink.style.display = activeIsConnected ? '' : 'none';
    }
    modal.style.display = 'flex';
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    modal.style.display = 'none';
    document.body.style.overflow = '';
    activeWebhookId = null;
  }

  document.querySelectorAll('[data-open-webhook-modal]').forEach(btn => {
    btn.addEventListener('click', () => openModal(btn));
  });

  document.getElementById('wh-close')?.addEventListener('click', closeModal);
  document.getElementById('wh-cancel')?.addEventListener('click', closeModal);
  document.getElementById('wh-overlay')?.addEventListener('click', closeModal);
  document.querySelector('.wh-overlay')?.addEventListener('click', closeModal);

  whConfirm?.addEventListener('click', async () => {
    if (!activeWebhookId) return;
    whConfirm.disabled = true;
    whConfirm.textContent = 'Saving…';
    try {
      const res = await fetch(`${apiUrl}/api/groups/webhooks/${activeWebhookId}`, { credentials: 'include' });
      if (!res.ok) throw new Error(`GET failed: ${res.status}`);
      const webhook = await res.json();
      console.debug('[webhook-connect] GET response:', webhook);
      const current = webhook.subscribedEvents ?? webhook.subscribed_events ?? [];
      console.debug('[webhook-connect] current subscribed_events:', current);
      const updated = activeIsConnected
        ? current.filter(e => e !== type)
        : [...new Set([...current, type])];
      console.debug('[webhook-connect] updated subscribed_events:', updated);
      // Use camelCase key to match Pydantic alias — snake_case gets overridden by the spread
      const body = { ...webhook, subscribedEvents: updated, subscribed_events: updated };
      console.debug('[webhook-connect] PUT body:', body);
      const putRes = await fetch(`${apiUrl}/api/groups/webhooks/${activeWebhookId}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'include',
        body: JSON.stringify(body),
      });
      const putData = await putRes.json().catch(() => ({}));
      console.debug('[webhook-connect] PUT response:', putRes.status, putData);
      if (!putRes.ok) {
        console.error('[webhook-connect] PUT failed:', putRes.status, putData);
        throw new Error(putData.detail || `PUT failed: ${putRes.status}`);
      }
      closeModal();
      window.location.reload();
    } catch (e) {
      alert('Error: ' + e.message);
      whConfirm.disabled = false;
      whConfirm.textContent = activeIsConnected ? 'Disconnect' : 'Connect';
    }
  });

  // ── Markdown parser — inline, block-level, no external dependency ────────
  // The template body is text: raw HTML in it is shown escaped, not rendered, and a link becomes an <a>
  // only for an http(s) or mailto URL, or a {{ variable }} (anything else, e.g. javascript:, stays text).
  function _esc(s) {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }

  function _mdLink(_match, text, url) {
    return /^(https?:|mailto:)/i.test(url) || /^\x00V\d+\x00$/.test(url) ? `<a href="${url}">${text}</a>` : text;
  }

  function _mdInline(s) {
    return _esc(s)
      .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
      .replace(/__(.+?)__/g, '<strong>$1</strong>')
      .replace(/\*(.+?)\*/g, '<em>$1</em>')
      .replace(/_(.+?)_/g, '<em>$1</em>')
      .replace(/`([^`]+)`/g, '<code>$1</code>')
      .replace(/\[([^\]]+)\]\(([^)]+)\)/g, _mdLink);
  }

  function _mdParse(md) {
    const lines = md.split('\n');
    const out = [];
    let i = 0;
    while (i < lines.length) {
      const line = lines[i];
      if (line.startsWith('```')) {
        const code = []; i++;
        while (i < lines.length && !lines[i].startsWith('```')) code.push(lines[i++]);
        out.push('<pre><code>' + _esc(code.join('\n')) + '</code></pre>'); i++; continue;
      }
      const hm = line.match(/^(#{1,3})\s+(.*)/);
      if (hm) { out.push(`<h${hm[1].length}>${_mdInline(hm[2])}</h${hm[1].length}>`); i++; continue; }
      if (/^[-*]\s/.test(line)) {
        const items = [];
        while (i < lines.length && /^[-*]\s/.test(lines[i])) items.push('<li>' + _mdInline(lines[i++].replace(/^[-*]\s/, '')) + '</li>');
        out.push('<ul>' + items.join('') + '</ul>'); continue;
      }
      if (/^\d+\.\s/.test(line)) {
        const items = [];
        while (i < lines.length && /^\d+\.\s/.test(lines[i])) items.push('<li>' + _mdInline(lines[i++].replace(/^\d+\.\s/, '')) + '</li>');
        out.push('<ol>' + items.join('') + '</ol>'); continue;
      }
      if (line.startsWith('> ')) { out.push('<blockquote><p>' + _mdInline(line.slice(2)) + '</p></blockquote>'); i++; continue; }
      if (/^---+$/.test(line.trim())) { out.push('<hr>'); i++; continue; }
      if (line.trim()) {
        const para = [];
        while (i < lines.length && lines[i].trim()) para.push(lines[i++]);
        out.push('<p>' + para.map(_mdInline).join('<br>') + '</p>'); continue;
      }
      i++;
    }
    return out.join('\n');
  }

  function _mdConvert(md) {
    if (!md || !md.trim()) return '';
    const vars = [];
    const safe = md.replace(/\{\{[^}]+\}\}/g, m => { vars.push(m); return `\x00V${vars.length - 1}\x00`; });
    let html = _mdParse(safe);
    vars.forEach((v, i) => { html = html.replaceAll(`\x00V${i}\x00`, _esc(v)); });
    return html;
  }

  function parseMarkdown(md) {
    return (!md || !md.trim()) ? '<span class="em-md-empty">Nothing to preview</span>' : _mdConvert(md);
  }

  function markdownToHtml(md) {
    return _mdConvert(md);
  }

  // ── Email modal ──────────────────────────────────────────────────────────
  const emailModal = document.getElementById('email-modal');
  const emTitle = document.getElementById('em-title');
  const emTemplateName = document.getElementById('em-template-name');
  const emConfirm = document.getElementById('em-confirm');
  const emNote = document.getElementById('em-note');
  const emEventField = document.getElementById('em-event-field');
  const emSpecificEmail = document.getElementById('em-specific-email');

  let emTemplateId = null;
  let emSubscriptionId = null;
  let emIsEdit = false;
  let emIsSystemTemplate = false;

  // Populate email field dropdown from catalog
  const emailVars = (eventVariables || []).filter(v => v.type === 'email');
  const emEventFieldRadio = document.getElementById('em-event-field-radio');
  const emNoEmailFields = document.getElementById('em-no-email-fields');
  if (emailVars.length > 0) {
    if (emEventField) emEventField.replaceChildren(...emailVars.map(v => new Option(v.slug, v.slug)));
  } else {
    if (emEventFieldRadio) emEventFieldRadio.disabled = true;
    if (emNoEmailFields) emNoEmailFields.style.display = 'inline';
  }

  // Write/Preview tabs for markdown editor
  const emMdBody = document.getElementById('em-md-body');
  const emMdPreview = document.getElementById('em-md-preview');
  document.querySelectorAll('.em-md-tab').forEach(tab => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('.em-md-tab').forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      const isPreview = tab.dataset.emTab === 'preview';
      if (emMdBody) emMdBody.style.display = isPreview ? 'none' : 'block';
      if (emMdPreview) {
        emMdPreview.style.display = isPreview ? 'block' : 'none';
        if (isPreview) emMdPreview.innerHTML = parseMarkdown(emMdBody?.value || '');
      }
    });
  });
  // Debounced preview update while on preview tab
  let mdDebounce;
  emMdBody?.addEventListener('input', () => {
    clearTimeout(mdDebounce);
    mdDebounce = setTimeout(() => {
      if (emMdPreview?.style.display !== 'none') emMdPreview.innerHTML = parseMarkdown(emMdBody.value);
      const subj = document.getElementById('em-subject')?.value || '';
      checkUnresolvedVars(subj + ' ' + emMdBody.value);
    }, 400);
  });
  document.getElementById('em-subject')?.addEventListener('input', () => {
    const subj = document.getElementById('em-subject')?.value || '';
    checkUnresolvedVars(subj + ' ' + (emMdBody?.value || ''));
  });

  // Recipient radio show/hide
  document.querySelectorAll('input[name="em-recipient-type"]').forEach(radio => {
    radio.addEventListener('change', e => {
      const v = e.target.value;
      if (emEventField) emEventField.style.display = v === 'event_field' ? 'inline-block' : 'none';
      if (emSpecificEmail) emSpecificEmail.style.display = v === 'specific' ? 'block' : 'none';
    });
  });

  // Variable chips — insert at cursor
  const varsEl = document.getElementById('em-template-vars');
  if (varsEl && eventVariables?.length) {
    const chips = eventVariables.filter(v => v.type !== 'uuid');
    const node = (tag, className, ...children) => {
      const n = document.createElement(tag);
      if (className) n.className = className;
      n.append(...children);
      return n;
    };
    varsEl.replaceChildren(
      node('div', 'em-vars-header', node('span', 'em-vars-title', 'Variables'), node('span', 'em-vars-hint', 'Click to insert at cursor')),
      node('div', 'em-vars-chips', ...chips.map(v => {
        const chip = node('button', 'em-var-chip', node('code', '', `{{${v.slug}}}`));
        chip.type = 'button';
        chip.dataset.slug = `{{${v.slug}}}`;
        chip.title = `${v.description || v.slug} — click to insert`;
        return chip;
      })),
    );
    // Track last focused editable field in the modal
    let emLastFocused = document.getElementById('em-md-body');
    ['em-subject', 'em-md-body'].forEach(id => {
      document.getElementById(id)?.addEventListener('focus', function() { emLastFocused = this; });
    });

    varsEl.querySelectorAll('.em-var-chip').forEach(btn => {
      btn.addEventListener('mousedown', (e) => e.preventDefault()); // prevent focus steal
      btn.addEventListener('click', () => {
        const slug = btn.dataset.slug;
        const target = emLastFocused || document.getElementById('em-md-body');
        if (target) {
          const start = target.selectionStart ?? target.value.length;
          const end = target.selectionEnd ?? start;
          target.value = target.value.slice(0, start) + slug + target.value.slice(end);
          const pos = start + slug.length;
          target.setSelectionRange(pos, pos);
          target.focus();
        }
        const codeEl = btn.querySelector('code');
        const orig = codeEl ? codeEl.textContent : btn.textContent;
        if (codeEl) { codeEl.textContent = '✓'; setTimeout(() => { codeEl.textContent = orig; }, 800); }
        else { btn.textContent = '✓'; setTimeout(() => { btn.textContent = orig; }, 800); }
      });
    });
  }

  async function openEmailModal(btn) {
    emTemplateId = btn.dataset.templateId;
    emSubscriptionId = btn.dataset.subscriptionId || '';
    emIsEdit = btn.dataset.isEdit === 'true';
    const name = btn.dataset.templateName || 'Template';

    if (emTitle) emTitle.textContent = (emIsEdit ? 'Edit: ' : 'Connect: ') + name;
    if (emTemplateName) emTemplateName.textContent = name;
    if (emNote) emNote.innerHTML = `Fires on every <strong>${type}</strong> event.`;
    if (emConfirm) { emConfirm.textContent = emIsEdit ? 'Save' : 'Connect'; emConfirm.disabled = false; emConfirm.className = 'button'; }

    // Pre-fill recipient — default admins for new, stored value for edit
    const rt = emIsEdit ? (btn.dataset.recipientType || 'admins') : 'admins';
    const radio = document.querySelector(`input[name="em-recipient-type"][value="${rt}"]`);
    if (radio) { radio.checked = true; radio.dispatchEvent(new Event('change')); }
    if (rt === 'event_field' && emEventField) emEventField.value = btn.dataset.recipientField || '';
    if (rt === 'specific' && emSpecificEmail) emSpecificEmail.value = btn.dataset.recipientEmail || '';

    if (emailModal) { emailModal.style.display = 'flex'; document.body.style.overflow = 'hidden'; }

    // Reset Write tab active
    document.querySelectorAll('.em-md-tab').forEach(t => t.classList.toggle('active', t.dataset.emTab === 'write'));
    if (emMdBody) { emMdBody.style.display = 'block'; }
    if (emMdPreview) { emMdPreview.style.display = 'none'; }

    // Fetch and pre-fill template
    emIsSystemTemplate = false;
    try {
      const res = await fetch(`${apiUrl}/api/platform/email/templates/${emTemplateId}`, { credentials: 'include' });
      if (res.ok) {
        const tpl = await res.json();
        emIsSystemTemplate = !(tpl.groupId || tpl.group_id);
        const f = (c, s) => tpl[c] ?? tpl[s] ?? '';
        const subj = document.getElementById('em-subject');
        // Use message_top as the markdown source (saved there on previous edits),
        // fall back to stripping tags from custom_html for first-open of HTML templates
        const markdownSource = f('bodyMarkdown', 'body_markdown') || f('customHtml', 'custom_html') || '';
        if (subj) subj.value = f('subject', 'subject');
        if (emMdBody) emMdBody.value = markdownSource;

        // Check for variables in the template that won't resolve for this event
        checkUnresolvedVars(f('subject', 'subject') + ' ' + markdownSource);
      }
    } catch {}
  }

  function checkUnresolvedVars(content) {
    const el = document.getElementById('em-unresolved-vars');
    if (!el) return;
    const known = new Set((eventVariables || []).map(v => v.slug));
    const used = [...content.matchAll(/\{\{\s*([a-z_][a-z0-9_]*)\s*\}\}/g)].map(m => m[1]);
    const unknown = [...new Set(used.filter(s => !known.has(s)))];
    if (unknown.length) {
      el.innerHTML = 'Not in this event\'s data (will be empty): ' +
        unknown.map(s => `<code>{{ ${s} }}</code>`).join(', ');
      el.style.display = 'block';
    } else {
      el.style.display = 'none';
    }
  }

  function closeEmailModal() {
    if (emailModal) emailModal.style.display = 'none';
    document.body.style.overflow = '';
    emTemplateId = null; emSubscriptionId = null;
    const subj = document.getElementById('em-subject');
    if (subj) subj.value = '';
    if (emMdBody) emMdBody.value = '';
    if (emMdPreview) emMdPreview.innerHTML = '<span class="em-md-empty">Nothing to preview</span>';
    const unresolvedEl = document.getElementById('em-unresolved-vars');
    if (unresolvedEl) unresolvedEl.style.display = 'none';
    // Reset to Write tab
    document.querySelectorAll('.em-md-tab').forEach(t => t.classList.toggle('active', t.dataset.emTab === 'write'));
    if (emMdBody) emMdBody.style.display = 'block';
    if (emMdPreview) emMdPreview.style.display = 'none';
  }

  document.querySelectorAll('.connect-email-btn').forEach(btn => {
    btn.addEventListener('click', () => openEmailModal(btn));
  });
  document.querySelectorAll('.disconnect-email-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      if (!confirm('Disconnect this email template?')) return;
      const subId = btn.dataset.subscriptionId;
      if (!subId) return;
      btn.disabled = true;
      try {
        const res = await fetch(`${apiUrl}/api/groups/email-event-subscriptions/${subId}`, { method: 'DELETE', credentials: 'include' });
        if (!res.ok && res.status !== 204) throw new Error(`DELETE failed: ${res.status}`);
        window.location.reload();
      } catch (e) { alert('Error: ' + e.message); btn.disabled = false; }
    });
  });
  document.getElementById('em-close')?.addEventListener('click', closeEmailModal);
  document.getElementById('em-cancel')?.addEventListener('click', closeEmailModal);
  document.querySelector('#email-modal .wh-overlay')?.addEventListener('click', closeEmailModal);

  emConfirm?.addEventListener('click', async () => {
    if (!emTemplateId) return;

    // Validate recipient
    const recipientType = document.querySelector('input[name="em-recipient-type"]:checked')?.value || 'admins';
    if (recipientType === 'specific') {
      const raw = emSpecificEmail?.value?.trim() || '';
      if (!raw) { alert('Please enter at least one email address.'); return; }
      const bad = raw.split(/[,\n]+/).map(s => s.trim()).filter(Boolean).filter(a => !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(a));
      if (bad.length) { alert('Invalid email: ' + bad.join(', ')); return; }
    }
    if (recipientType === 'event_field' && !emEventField?.value) { alert('No email field available.'); return; }

    emConfirm.disabled = true;
    emConfirm.textContent = 'Saving…';

    try {
      // 1. Save template edits
      const subject = document.getElementById('em-subject')?.value?.trim();
      const markdownBody = emMdBody?.value?.trim() || '';
      let finalTemplateId = emTemplateId;

      const tplBody = {
        subject,
        body_markdown: markdownBody || null,
      };
      // Safety: system templates must never be PATCHed directly — this path
      // should no longer be reachable since we only show workspace templates,
      // but guard anyway.
      if (emIsSystemTemplate) {
        const res = await fetch(`${apiUrl}/api/platform/workspaces/${wsId}/email-templates`, {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, credentials: 'include',
          body: JSON.stringify({ template_type: 'custom', name: document.getElementById('em-template-name')?.textContent || 'Custom', enabled: true, ...tplBody }),
        });
        if (res.ok) { const t = await res.json().catch(() => null); if (t?.id) finalTemplateId = t.id; }
      } else {
        const patchRes = await fetch(`${apiUrl}/api/platform/email/templates/${emTemplateId}`, {
          method: 'PATCH', headers: { 'Content-Type': 'application/json' }, credentials: 'include',
          body: JSON.stringify(tplBody),
        });
        if (!patchRes.ok) {
          const d = await patchRes.json().catch(() => ({}));
          throw new Error(d.detail || `Template update failed: ${patchRes.status}`);
        }
      }

      // 2. Delete old subscription if editing
      if (emIsEdit && emSubscriptionId) {
        await fetch(`${apiUrl}/api/groups/email-event-subscriptions/${emSubscriptionId}`, { method: 'DELETE', credentials: 'include' }).catch(() => {});
      }

      // 3. Create new subscription
      const rawEmails = recipientType === 'specific' ? emSpecificEmail?.value?.trim() : null;
      const emails = rawEmails ? rawEmails.split(/[,\n]+/).map(s => s.trim()).filter(Boolean) : null;
      const res = await fetch(`${apiUrl}/api/groups/email-event-subscriptions`, {
        method: 'POST', headers: { 'Content-Type': 'application/json' }, credentials: 'include',
        body: JSON.stringify({
          template_id: finalTemplateId,
          event_type: type,
          recipient_type: recipientType,
          recipient_field: recipientType === 'event_field' ? emEventField?.value : null,
          recipient_email: emails ? emails.join(',') : null,
          enabled: true,
        }),
      });
      if (!res.ok) { const d = await res.json().catch(() => ({})); throw new Error(d.detail || `POST failed: ${res.status}`); }
      closeEmailModal();
      window.location.reload();
    } catch (e) {
      alert('Error: ' + e.message);
      emConfirm.disabled = false;
      emConfirm.textContent = emIsEdit ? 'Save' : 'Connect';
    }
  });
</script>

<!-- Subscribe menu: open and close; /automation/events/<type>#subscribe opens it. -->
<script>
  {
    const toggle = document.getElementById('subscribe-toggle');
    const menu = document.getElementById('subscribe-menu');
    const setOpen = (open: boolean) => {
      if (!toggle || !menu) return;
      menu.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
    };
    toggle?.addEventListener('click', () => setOpen(!!menu?.hidden));
    if (location.hash === '#subscribe') {
      setOpen(true);
      menu?.scrollIntoView({ block: 'nearest' });
    }
  }
</script>

<!-- Integration event-connection: pick an integration action + args, wired via the SDK. -->
<script>
  {
    const dataEl = document.getElementById('int-data');
    const parsed = JSON.parse(dataEl?.textContent || '{}') as {
      integrations?: any[]; providers?: any[]; eventType?: string;
    };
    const integrations = parsed.integrations ?? [];
    const providers = parsed.providers ?? [];
    const eventType = parsed.eventType ?? '';
    const bySlug = new Map(providers.map((p: any) => [p.slug, p]));

    const modal = document.getElementById('int-modal') as HTMLElement | null;
    const sel = document.getElementById('int-select') as HTMLSelectElement | null;
    const actionSel = document.getElementById('int-action') as HTMLSelectElement | null;
    const argsEl = document.getElementById('int-args') as HTMLElement | null;

    // Only integrations that are enabled AND whose provider exposes at least one action.
    const usable = integrations.filter((i: any) => i.enabled && (bySlug.get(i.provider)?.actions?.length));

    // Names, labels and keys come from the server: built as DOM nodes, never as HTML.
    const option = (value: string, label: string) => {
      const o = document.createElement('option');
      o.value = value;
      o.textContent = label;
      return o;
    };
    sel?.replaceChildren(...usable.map((i: any) => {
      const o = option(i.id, i.name);
      o.dataset.provider = i.provider;
      return o;
    }));

    function renderArgs() {
      if (!sel || !actionSel || !argsEl) return;
      const provider = bySlug.get(sel.selectedOptions[0]?.dataset.provider);
      const action = (provider?.actions ?? []).find((a: any) => a.key === actionSel.value);
      const props = (action?.inputSchema?.properties ?? {}) as Record<string, any>;
      argsEl.replaceChildren(...Object.entries(props).map(([key, prop]: [string, any]) => {
        const group = document.createElement('div');
        group.className = 'form-group';
        const label = document.createElement('label');
        label.className = 'em-field-label';
        label.textContent = prop.title || key;
        const input = document.createElement('input');
        input.type = 'text';
        input.className = 'em-text-input';
        input.dataset.argKey = key;
        input.placeholder = prop.format === 'uri' ? 'https://…' : '';
        group.append(label, input);
        return group;
      }));
    }
    function renderActions() {
      if (!sel || !actionSel) return;
      const provider = bySlug.get(sel.selectedOptions[0]?.dataset.provider);
      const actions = provider?.actions ?? [];
      actionSel.replaceChildren(...actions.map((a: any) => option(a.key, a.label)));
      renderArgs();
    }
    sel?.addEventListener('change', renderActions);
    actionSel?.addEventListener('change', renderArgs);
    if (usable.length) renderActions();

    function closeInt() { if (modal) modal.style.display = 'none'; document.body.style.overflow = ''; }
    document.querySelector('.js-int-connect-open')?.addEventListener('click', () => {
      if (!usable.length) { alert('No integrations with actions yet. Add one in Settings → Integrations.'); return; }
      const note = document.getElementById('int-note');
      if (note) note.innerHTML = `Runs on every <strong>${eventType}</strong> event.`;
      if (modal) { modal.style.display = 'flex'; document.body.style.overflow = 'hidden'; }
    });
    document.getElementById('int-close')?.addEventListener('click', closeInt);
    document.getElementById('int-cancel')?.addEventListener('click', closeInt);
    modal?.querySelector('.wh-overlay')?.addEventListener('click', closeInt);

    document.getElementById('int-confirm')?.addEventListener('click', async () => {
      if (!sel || !actionSel || !argsEl) return;
      const integrationId = sel.value;
      const action = actionSel.value;
      if (!integrationId || !action) return;
      const args: Record<string, unknown> = {};
      argsEl.querySelectorAll<HTMLInputElement>('[data-arg-key]').forEach((inp) => {
        if (inp.value.trim()) args[inp.dataset.argKey!] = inp.value.trim();
      });
      const btn = document.getElementById('int-confirm') as HTMLButtonElement;
      btn.disabled = true; btn.textContent = 'Saving…';
      try {
        const { createSdkClient } = await import('@/lib/sdk');
        await createSdkClient().integrations.createSubscription({ integrationId, eventType, action, args });
        window.location.reload();
      } catch (e) {
        alert('Error: ' + (e instanceof Error ? e.message : String(e)));
        btn.disabled = false; btn.textContent = 'Connect';
      }
    });

    document.querySelectorAll<HTMLButtonElement>('.js-int-disconnect').forEach((btn) => {
      btn.addEventListener('click', async () => {
        if (!confirm('Disconnect this integration action from the event?')) return;
        btn.disabled = true;
        try {
          const { createSdkClient } = await import('@/lib/sdk');
          await createSdkClient().integrations.deleteSubscription(btn.dataset.subId!);
          window.location.reload();
        } catch (e) {
          alert('Error: ' + (e instanceof Error ? e.message : String(e)));
          btn.disabled = false;
        }
      });
    });
  }
</script>

</AppLayout>


<style>
  .alert {
    padding: 16px;
    border-radius: var(--radius);
    background: var(--color-error-bg);
    color: var(--color-error);
    border: 1px solid var(--color-error);
  }

  .page-header {
    margin-bottom: 28px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--line);
  }

  .event-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 8px;
  }

  .event-meta h2 {
    margin: 0;
    font-size: 24px;
    font-weight: 600;
  }

  .event-category {
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--accent);
    background: rgba(79, 156, 132, 0.1);
    padding: 3px 8px;
    border-radius: 4px;
  }

  .event-description {
    margin: 0 0 8px;
    color: var(--muted);
    font-size: 14px;
  }

  .event-type-code {
    font-size: 11px;
    font-family: ui-monospace, monospace;
    color: var(--muted);
    background: var(--panel);
    border: 1px solid var(--line);
    padding: 2px 6px;
    border-radius: 3px;
  }

  /* The chain: what causes this event and what it leads to */
  .chain { display: flex; flex-direction: column; gap: 6px; margin-top: 12px; }
  .chain-line { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
  .chain-label {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--muted);
    margin-right: 2px;
  }
  .chain-chip {
    font-size: 12px;
    padding: 2px 10px;
    border: 1px solid var(--line);
