---
import FilterBar from "@/components/FilterBar.astro";
import OrganizedSections from "@/components/OrganizedSections.astro";
import AppLayout from "@/layouts/AppLayout.astro";
import { getAuthToken } from "@/lib/api/client";
import { listIntegrations, listProviders } from "@/lib/api/integrations";
import { getCurrentWorkspace, listWorkspaces } from "@/lib/api/workspaces";
import { fromOptions, type Integrations, statusOptions } from "@/lib/organizedList";
import { createSdkClient } from "@/lib/sdk";
import { MODE_OPTIONS, webhookAdapter } from "@/lib/webhookList";
import { canManageWorkspace, isForbidden } from "@/lib/workspaceRole";

const authToken = getAuthToken(Astro.cookies);
const sdk = createSdkClient(authToken);
let workspace = null;
let webhooks: any[] = [];
let integrationInfo: Integrations = {};
let error: string | null = null;
let adminOnly = false;
// "Delete all of these" (From a removed integration) is ADMIN only; the API refuses anyone else.
let canManage = false;

try {
  workspace = await getCurrentWorkspace(authToken);

  if (workspace) {
    webhooks = await sdk.webhooks.list();
    try {
      canManage = canManageWorkspace(await listWorkspaces(authToken), (await sdk.user.getProfile()) as any);
    } catch {
      // unknown role: no button
    }
    // The sections' names and logos. If the integrations can't be read, their webhooks still group rather than
    // all reading as "From a removed integration".
    const [integrations, providers] = await Promise.all([
      listIntegrations(authToken).catch((e) => (console.error("[webhooks] integrations:", e), null)),
      listProviders(authToken).catch(() => []),
    ]);
    const byProvider = new Map((providers ?? []).map((p: any) => [p.slug, p]));
    integrationInfo = integrations
      ? Object.fromEntries(
          integrations.map((i: any) => {
            const provider: any = byProvider.get(i.provider);
            return [i.id, { name: i.name, slug: i.provider, icon: provider?.icon, hasLogo: provider?.hasLogo }];
          }),
        )
      : Object.fromEntries(
          webhooks.filter((w: any) => w.sourceIntegrationId).map((w: any) => [w.sourceIntegrationId, { name: "an integration" }]),
        );
  }
} catch (e) {
  console.error("[webhooks] Error loading:", e);
  if (isForbidden(e)) adminOnly = true;
  else error = e instanceof Error ? e.message : String(e);
}

const json = (value: unknown) => JSON.stringify(value).replace(/</g, "\\u003c");
const fromChoices = fromOptions(webhooks, webhookAdapter(), integrationInfo);
---

<AppLayout crumb="automation.webhooks" adminOnly={adminOnly}>
  <div class="toolbar">
    <div>
      <h2>Webhooks</h2>
      <p>Configure HTTP callbacks for workspace events</p>
    </div>
    <div class="toolbar-actions">
      <a href="/automation/webhooks/log" class="button secondary">Activity Log</a>
      <a href="/automation/webhooks/new" class="button">New Webhook</a>
    </div>
  </div>

  <div class="page-container webhooks-page">
    {error ? (
      <div class="alert alert-error">
        <strong>Error:</strong> {error}
      </div>
    ) : (
      <>
        {webhooks.length > 0 && (
          <FilterBar
            searchPlaceholder="Search webhooks…"
            searchId="wh-search"
            filters={[
              { id: "wh-f-from", label: "sources", options: fromChoices },
              { id: "wh-f-status", label: "statuses", options: statusOptions({ attention: true }) },
              { id: "wh-f-mode", label: "modes", options: MODE_OPTIONS },
            ]}
          />
        )}
        <OrganizedSections id="wh" noun="webhook" emptyAll="No webhooks configured. Webhooks send an HTTP request when events occur in your workspace." />
        {webhooks.length === 0 && (
          <div class="empty-state">
            <a href="/automation/webhooks/new" class="button">New Webhook</a>
          </div>
        )}
        <script type="application/json" id="wh-list-data" is:inline set:html={json(webhooks)}></script>
        <script type="application/json" id="wh-can-manage" is:inline set:html={JSON.stringify(canManage)}></script>
        <script type="application/json" id="wh-integration-names" is:inline set:html={json(integrationInfo)}></script>
      </>
    )}
  </div>

</AppLayout>

<script>
  import { createSdkClient } from '@/lib/sdk';
  import { mountOrganizedList } from '@/lib/organizedListView';
  import { webhookAdapter, webhookCardHtml } from '@/lib/webhookList';
  const sdk = createSdkClient();

  const read = (id: string) => {
    const el = document.getElementById(id);
    return el ? JSON.parse(el.textContent || 'null') : null;
  };
  const webhooks: any[] = read('wh-list-data') || [];
  const integrations = read('wh-integration-names') || {};
  const when = (iso: string) => new Date(iso).toLocaleString();

  // Toggle webhook enabled/disabled — must send full payload (PUT, not PATCH)
  async function toggle(id: string, currentlyEnabled: boolean) {
    try {
      const webhook = await sdk.webhooks.get(id);
      await sdk.webhooks.update(id, {
        name: webhook.name,
        url: webhook.url,
        method: webhook.method,
        webhook_type: webhook.webhookType ?? (webhook as any).webhook_type,
        scheduled_time: webhook.scheduledTime ?? (webhook as any).scheduled_time,
        enabled: !currentlyEnabled,
      } as any);
      window.location.reload();
    } catch (error) {
      alert('Failed to update webhook');
    }
  }

  async function test(id: string, name: string) {
    if (!confirm(`Send a test request to "${name}"?`)) return;
    try {
      await sdk.webhooks.test(id);
      alert('Test request sent! Check the Activity Log for results.');
    } catch (error) {
      alert('Failed to send test request');
    }
  }

  async function remove(id: string, name: string) {
    if (!confirm(`Are you sure you want to delete the webhook "${name}"?`)) return;
    try {
      await sdk.webhooks.delete(id);
      window.location.reload();
    } catch (error) {
      alert('Failed to delete webhook');
    }
  }

  const host = document.getElementById('wh-list');
  if (host) {
    const list = mountOrganizedList<any>({
      host,
      emptyFiltered: document.getElementById('wh-empty')!,
      emptyAll: document.getElementById('wh-none')!,
      search: document.getElementById('wh-search') as HTMLInputElement | null,
      selects: {
        from: document.getElementById('wh-f-from') as HTMLSelectElement | null,
        status: document.getElementById('wh-f-status') as HTMLSelectElement | null,
        mode: document.getElementById('wh-f-mode') as HTMLSelectElement | null,
      },
      items: () => webhooks,
      adapter: webhookAdapter(),
      integrations,
      noun: 'webhook',
      storageKey: 'marvin.automation.webhooks.filters',
      linkedId: null,
      renderItem: (w, { linked }) => webhookCardHtml(w, { linked, when }),
      removedDelete: { kind: 'outgoing-webhooks', canDelete: read('wh-can-manage') === true },
      afterRender: (root) => {
        root.querySelectorAll<HTMLElement>('.wh-card').forEach((card) => {
          const id = card.dataset.id!;
          const name = card.dataset.name || '';
          const w = webhooks.find((x) => x.id === id);
          card.querySelector('.js-toggle')?.addEventListener('click', () => toggle(id, !!w?.enabled));
          card.querySelector('.js-test')?.addEventListener('click', () => test(id, name));
          card.querySelector('.js-delete')?.addEventListener('click', () => remove(id, name));
        });
      },
    });
    list.refresh();
  }
</script>

<style>
  .toolbar {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 32px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--line);
  }

  .toolbar-actions {
    display: flex;
    gap: 12px;
    align-items: center;
  }

  .toolbar h2 {
    margin: 0;
    font-size: 24px;
    font-weight: 600;
  }

  .toolbar p {
    margin: 8px 0 0;
    color: var(--muted);
    font-size: 14px;
  }

  .page-container {
    max-width: 1200px;
  }

  .alert {
    padding: 16px;
    margin-bottom: 24px;
    border-radius: var(--radius);
  }

  .alert-error {
    background: var(--color-error-bg);
    color: var(--color-error);
    border: 1px solid var(--color-error);
  }

  .empty-state {
    padding: 16px 0;
    text-align: center;
  }

  .webhooks-page :global(.wh-attention) { margin-top: 2px; font-size: 12px; color: var(--color-error); }
</style>
