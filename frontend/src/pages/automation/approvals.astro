---
import MessageText from "@/components/MessageText.astro";
// Automation → Approvals: workflow runs waiting at an Approval step that you may decide. Approve or Deny (with an
// optional note) and the run goes on from the next step with ${steps.<id>.output.decision}. Editors and above; a step
// may ask for admins. Backend: routes/automations/automations_controller.py, services/automation/approvals.py.
import LocalTime from "@/components/LocalTime.astro";
import AppLayout from "@/layouts/AppLayout.astro";
import { getAuthToken } from "@/lib/api/client";
import { listApprovals, type WorkflowApproval } from "@/lib/api/workflowApprovals";
import { isAudioUrl } from "@/lib/approvalMedia";
import { deciderLabel, decisionLabel, firstLine } from "@/lib/approvalHistory";
import { captionResultsHtml } from "@/lib/captionCheck";
import { isForbidden } from "@/lib/workspaceRole";

const authToken = getAuthToken(Astro.cookies);
let approvals: WorkflowApproval[] = [];
let decided: WorkflowApproval[] = [];
let error: string | null = null;
let restricted = false;
try {
  approvals = await listApprovals(authToken);
  decided = await listApprovals(authToken, "decided").catch(() => []); // history is a nicety: never hide the waiting ones for it
} catch (e) {
  if (isForbidden(e)) restricted = true;
  else error = e instanceof Error ? e.message : String(e);
}
---

<AppLayout crumb="automation.approvals" restrictedNote={restricted ? "Approvals are for editors and above." : null}>
  <div class="toolbar">
    <div>
      <h2>Approvals</h2>
      <p>Workflow runs waiting for a person. Approve or deny and the run goes on from its next step; if nobody decides in time it goes on as expired.</p>
    </div>
  </div>
  {error && <div class="alert error">Could not load approvals: {error}</div>}
  {!error && approvals.length === 0 && <p class="empty-state">Nothing is waiting for you.</p>}
  <div class="approvals">
    {approvals.map((a) => (
      <article class="approval" data-id={a.id}>
        <p class="ask"><MessageText message={a.message} /></p>
        {a.imageUrl && (isAudioUrl(a.imageUrl)
          ? <audio class="preview-audio" src={a.imageUrl} controls preload="metadata" />
          : <a href={a.imageUrl} target="_blank" rel="noopener"><img class="preview" src={a.imageUrl} alt="" loading="lazy" /></a>)}
        {a.postPreview && (
          <details class="post-preview" open>
            <summary>What it will post, network by network</summary>
            <p class="post-text">{a.postPreview.text}</p>
            <div class="post-checks" set:html={captionResultsHtml(a.postPreview.results, a.postPreview.text)} />
          </details>
        )}
        <p class="meta">
          {a.automationName ?? "A workflow"}
          {a.entryId && (<> · <a href={`/workspace/entries/${a.entryId}`}>{a.entryTitle ?? "the entry"}</a></>)}
          {" "}· asked <LocalTime iso={a.createdAt} fallback="" /> · expires <LocalTime iso={a.expiresAt} fallback="" />
          {a.approvers === "admin" && <span class="badge">admins</span>}
        </p>
        <div class="decide">
          <input class="input note" placeholder="Note (optional)" maxlength="500" />
          {a.choices?.length ? (
            <>
              {a.choices.map((label) => (
                <button type="button" class="button js-decide" data-decision="approve" data-choice={label}>{label}</button>
              ))}
              <button type="button" class="button secondary js-decide" data-decision="deny">None of these</button>
            </>
          ) : (
            <>
              <button type="button" class="button js-decide" data-decision="approve">Approve</button>
              <button type="button" class="button secondary js-decide" data-decision="deny">Deny</button>
            </>
          )}
        </div>
        <p class="result" hidden></p>
      </article>
    ))}
  </div>
  {decided.length > 0 && (
    <section class="history" aria-labelledby="history-title">
      <h3 id="history-title">Recently decided</h3>
      <p class="muted">The latest 50, newest first. Hover a question or a note to read all of it.</p>
      <div class="chips">
        {decided.map((a) => (
          <div class={`decided-chip s-${a.status}`}>
            <div class="chip-left">
              <div class="chip-title">
                <span class="verdict-pill">{decisionLabel(a.status, a.choice)}</span>
                <span class="chip-msg" title={a.message}>{firstLine(a.message)}</span>
              </div>
              {a.note && <p class="chip-note" title={a.note}>“{a.note}”</p>}
            </div>
            <div class="chip-right">
              <span class="chip-meta">{deciderLabel(a.decidedByName)} · <LocalTime iso={a.decidedAt} fallback="" /></span>
              <span class="chip-meta chip-from">
                {a.automationName ?? "A workflow"}
                {a.entryId && (<> · <a href={`/workspace/entries/${a.entryId}`}>{a.entryTitle ?? "the entry"}</a></>)}
              </span>
              {a.imageUrl && <a class="button secondary small" href={a.imageUrl} target="_blank" rel="noopener">{isAudioUrl(a.imageUrl) ? "Listen" : "View"}</a>}
            </div>
          </div>
        ))}
      </div>
    </section>
  )}
</AppLayout>

<script>
  import { decideApproval } from "@/lib/api/workflowApprovals";

  document.querySelectorAll<HTMLButtonElement>(".js-decide").forEach((btn) =>
    btn.addEventListener("click", async () => {
      const card = btn.closest<HTMLElement>(".approval")!;
      const result = card.querySelector<HTMLElement>(".result")!;
      card.querySelectorAll<HTMLButtonElement>("button").forEach((b) => (b.disabled = true));
      // Deciding waits while the workflow goes on (an image step takes up to a minute), so say so at once.
      const label = btn.textContent;
      const approving = btn.dataset.decision === "approve";
      btn.textContent = approving ? "Approving…" : "Denying…";
      result.textContent = approving
        ? "Approved — the workflow is going on. This can take a minute (longer when it makes an image)."
        : "Denied — finishing the run…";
      result.hidden = false;
      try {
        const note = card.querySelector<HTMLInputElement>(".note")!.value.trim();
        const out = await decideApproval(card.dataset.id!, btn.dataset.decision as "approve" | "deny", note, btn.dataset.choice ?? null);
        result.textContent =
          out.status === "stale"
            ? "The entry changed after this was asked, so it went on as stale — nothing approved was applied."
            : out.choice
              ? `Approved: ${out.choice} — the workflow went on.`
              : `${out.status === "approved" ? "Approved" : "Denied"} — the workflow went on.`;
        card.querySelector(".decide")!.remove();
      } catch (e: any) {
        result.textContent = e?.message ?? String(e);
        btn.textContent = label;
        card.querySelectorAll<HTMLButtonElement>("button").forEach((b) => (b.disabled = false));
      }
      result.hidden = false;
    }),
  );
</script>

<style>
  .post-preview { margin: 0 0 10px; border: 1px solid var(--line); border-radius: var(--radius); padding: 8px 12px; }
  .post-preview summary { cursor: pointer; font-weight: 600; }
  .post-text { white-space: pre-wrap; overflow-wrap: anywhere; margin: 8px 0; }
  .post-checks { display: grid; gap: 8px; }
  .post-checks :global(.cc-card) { border: 1px solid var(--line); border-radius: 8px; padding: 8px 10px; display: grid; gap: 6px; }
  .post-checks :global(.cc-head) { display: flex; justify-content: space-between; gap: 8px; align-items: baseline; }
  .post-checks :global(.cc-count) { font-variant-numeric: tabular-nums; color: var(--muted); font-size: 12.5px; }
  .post-checks :global(.cc-count.over) { color: var(--danger, #c0392b); font-weight: 600; }
  .post-checks :global(.cc-visible) { font-size: 13px; padding: 6px 8px; background: color-mix(in srgb, var(--line) 35%, transparent); border-radius: 6px; white-space: pre-wrap; overflow-wrap: anywhere; }
  .post-checks :global(.cc-more) { color: var(--muted); margin-left: 4px; }
  .post-checks :global(.cc-issues) { margin: 0; padding-left: 18px; display: grid; gap: 2px; font-size: 13px; }
  .post-checks :global(.cc-error) { color: var(--danger, #c0392b); }
  .approvals { display: grid; gap: 12px; max-width: 760px; }
  .approval { border: 1px solid var(--line); border-radius: var(--radius); padding: 14px 16px; background: var(--panel); }
  .ask { margin: 0 0 6px; font-weight: 600; }
  .preview-audio { display: block; width: 100%; max-width: 360px; margin: 0 0 10px; }
  .preview { display: block; max-width: 360px; max-height: 270px; border-radius: var(--radius); border: 1px solid var(--line); margin: 0 0 10px; }
  .meta { margin: 0 0 10px; font-size: 13px; color: var(--muted); }
  .badge { margin-left: 6px; font-size: 11px; padding: 1px 7px; border: 1px solid var(--line); border-radius: 999px; }
  .decide { display: flex; flex-wrap: wrap; gap: 8px; }
  .decide .note { flex: 1 1 220px; }
  .result { margin: 8px 0 0; font-size: 13px; }
  /* Recently decided: slim full-width rows, the same shape as the Events page's chips. */
  .history { margin-top: 32px; }
  .history h3 { margin: 0 0 4px; }
  .chips { display: flex; flex-direction: column; gap: 4px; margin-top: 12px; }
  .decided-chip { padding: 10px 14px; background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); display: flex; align-items: center; gap: 12px; transition: border-color 0.15s; }
  .decided-chip:hover { border-color: var(--accent); }
  .chip-left { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
  .chip-title { display: flex; align-items: baseline; gap: 8px; min-width: 0; }
  .chip-msg { font-size: 13px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .chip-note { margin: 0; font-size: 12px; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .chip-right { display: flex; align-items: center; gap: 12px; flex-shrink: 0; }
  .chip-meta { font-size: 11px; color: var(--muted); white-space: nowrap; }
  .chip-from { max-width: 280px; overflow: hidden; text-overflow: ellipsis; }
  .verdict-pill { flex-shrink: 0; font-size: 10px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; padding: 1px 7px; border-radius: 999px; border: 1px solid var(--line); color: var(--muted); }
  .s-approved .verdict-pill { color: var(--good, #16a34a); }
  .s-denied .verdict-pill { color: var(--color-error, #dc2626); }
  .button.small { padding: 4px 10px; font-size: 12px; font-weight: 600; min-height: 26px; }
  @media (max-width: 640px) {
    .decided-chip { flex-wrap: wrap; }
    .chip-right { flex-basis: 100%; flex-wrap: wrap; gap: 4px 12px; }
    .chip-from { max-width: 100%; white-space: normal; }
    .button.small { min-height: 36px; }
  }
</style>
