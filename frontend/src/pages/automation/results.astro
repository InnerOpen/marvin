---
// Automation → Results: the work Marvin handed to another system (an integration action that follows up on it), newest first, with
// whether the other side reported back: in flight, no reply (in flight for 24 hours), failed or succeeded. Editors and above read;
// admins can Retry a failure (runs the workflow's hand-off step again for that entry) and Dismiss one that has been dealt with.
// Drawn in the Automation hub only once a hand-off has happened; the page itself can always be reached by its address.
// Backend: routes/groups/automation_results_controller.py. Pure logic: lib/automationResults.ts.
import AutomationResults from "@/components/AutomationResults.astro";
import AppLayout from "@/layouts/AppLayout.astro";
import { getSummary, listResults, type ResultList } from "@/lib/api/automationResults";
import { getAuthToken } from "@/lib/api/client";
import { apiQuery, emptyNotice, parseFilters, type ResultsSummary } from "@/lib/automationResults";
import { isForbidden } from "@/lib/workspaceRole";
import "@/styles/social.css";
import "@/styles/automationResults.css";

const authToken = getAuthToken(Astro.cookies);
const filters = parseFilters(Astro.url.searchParams);
let summary: ResultsSummary | null = null;
let list: ResultList | null = null;
let error: string | null = null;
let restricted = false;
try {
  summary = await getSummary(authToken);
  if (summary.show) list = await listResults(apiQuery(filters), authToken);
} catch (e) {
  if (isForbidden(e)) restricted = true;
  else error = e instanceof Error ? e.message : String(e);
}
const none = summary && !summary.show ? emptyNotice(summary, false) : null;
---

<AppLayout width="full" crumb="automation.results" restrictedNote={restricted ? "Results are for editors and above." : null}>
  <div class="social-page">
    <p class="si-lede">
      The work Marvin handed to another system, and whether it came back: in flight until the other side reports, then succeeded or
      failed. One still in flight after 24 hours shows as No reply. Click one to expand its details; an admin can retry a failure or dismiss it.
    </p>
    {error && <div class="si-alert">Could not load the results: {error}</div>}
    {none && (
      <div class="si-empty">
        <h3>{none.title}</h3>
        <p>{none.body}</p>
        {none.link && <p><a class="button secondary" href={none.link.href}>{none.link.label}</a></p>}
      </div>
    )}
    {summary?.show && !error && <AutomationResults summary={summary} list={list} filters={filters} />}
  </div>
</AppLayout>
