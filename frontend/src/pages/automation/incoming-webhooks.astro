  .iw-page :global(.iw-deliveries) { margin-top: 8px; display: grid; gap: 4px; }
  .iw-page :global(.delivery summary) { cursor: pointer; font-size: 13px; }
  .iw-page :global(.delivery-body) { margin: 6px 0 4px; padding: 8px 10px; max-height: 320px; overflow: auto; background: var(--panel-2); border-radius: var(--radius); font-size: 12px; white-space: pre-wrap; overflow-wrap: anywhere; }
  .iw-page :global(.pill) { padding: 1px 8px; border-radius: 999px; background: var(--bg); border: 1px solid var(--line); font-size: 11px; }
  .iw-page :global(.hint) { font-size: 12px; color: var(--muted); }
  .iw-page :global(.hint.error) { color: var(--color-error, #c0392b); }

  /* Phones: the create form's field pairs stack, a long name or slug wraps instead of pushing the
     toggle and Delete off the card, and the small buttons get finger-sized. */
  @media (max-width: 640px) {
    .form-row { flex-wrap: wrap; }
