---
import FilterBar from "@/components/FilterBar.astro";
import OrganizedSections from "@/components/OrganizedSections.astro";
import AppLayout from "@/layouts/AppLayout.astro";
import { fetchApi, getAuthToken } from "@/lib/api/client";
import { getBrowserApiBaseUrl } from "@/lib/api/config";
import { listIntegrations, listProviders } from "@/lib/api/integrations";
import { getCurrentWorkspace, listWorkspaces } from "@/lib/api/workspaces";
import { incomingWebhookAdapter, RECEIVED_OPTIONS, SIGNED_OPTIONS } from "@/lib/incomingWebhookList";
import { fromOptions, type Integrations, statusOptions } from "@/lib/organizedList";
import { createSdkClient } from "@/lib/sdk";
import { canManageWorkspace } from "@/lib/workspaceRole";

const authToken = getAuthToken(Astro.cookies);
const sdk = createSdkClient(authToken);

let workspace: any = null;
let webhooks: any[] = [];
let schemes: any[] = [];
let integrationInfo: Integrations = {};
let error: string | null = null;
// "Delete all of these" (From a removed integration) is ADMIN only; the API refuses anyone else.
let canManage = false;
try {
  canManage = canManageWorkspace(await listWorkspaces(authToken), (await sdk.user.getProfile()) as any);
} catch {
  // unknown role: no button
}

try {
  workspace = await getCurrentWorkspace(authToken);
  if (workspace) {
    let integrations: any[] | null = [];
    let providers: any[] = [];
    [webhooks, integrations, providers] = await Promise.all([
      sdk.incomingWebhooks.list(),
      // The sections' names and logos. If the integrations can't be read, their webhooks still group (below)
      // rather than all reading as "From a removed integration".
      listIntegrations(authToken).catch((e) => (console.error("[incoming-webhooks] integrations:", e), null)),
      listProviders(authToken).catch(() => []),
    ]);
    const byProvider = new Map((providers ?? []).map((p: any) => [p.slug, p]));
    integrationInfo = integrations
      ? Object.fromEntries(
          integrations.map((i: any) => {
            const provider: any = byProvider.get(i.provider);
            return [i.id, { name: i.name, slug: i.provider, icon: provider?.icon, hasLogo: provider?.hasLogo }];
          }),
        )
      : Object.fromEntries(
          webhooks.filter((w: any) => w.sourceIntegrationId).map((w: any) => [w.sourceIntegrationId, { name: "an integration" }]),
        );
  }
  // Core presets, presets from installed integrations, then "custom".
  if (workspace) schemes = await fetchApi<any[]>("/api/incoming-webhooks/signature-schemes", {}, authToken);
} catch (e) {
  console.error("[incoming-webhooks] Error loading:", e);
  error = e instanceof Error ? e.message : String(e);
}

const listJson = JSON.stringify(webhooks).replace(/</g, "\\u003c");
const schemesJson = JSON.stringify(schemes).replace(/</g, "\\u003c");
const integrationNamesJson = JSON.stringify(integrationInfo).replace(/</g, "\\u003c");
// The filter bar's choices (the page script reads the same selects back): From only offers the sections that exist.
const fromChoices = fromOptions(webhooks, incomingWebhookAdapter(), integrationInfo);
// Shown to the user to configure an external system that POSTs here, so it must be the publicly
// reachable address rather than an internal cluster one.
const hookBase = `${getBrowserApiBaseUrl()}/api/hooks`;
---

<AppLayout crumb="automation.incoming-webhooks">
 <div class="iw-page" data-hook-base={hookBase}>
  <script type="application/json" id="iw-list-data" is:inline set:html={listJson}></script>
  <script type="application/json" id="iw-schemes-data" is:inline set:html={schemesJson}></script>
  <script type="application/json" id="iw-integration-names" is:inline set:html={integrationNamesJson}></script>
  <script type="application/json" id="iw-can-manage" is:inline set:html={JSON.stringify(canManage)}></script>
  <div class="toolbar">
    <div>
      <h2>Incoming Webhooks</h2>
      <p>Give an external system a secret URL. When it POSTs, Marvin fires an event your workflows can react to.</p>
    </div>
    <button id="iw-new" class="button">New Webhook</button>
  </div>

  <div class="page-container">
    {error && <div class="banner error">{error}</div>}

    <!-- Create form (hidden until New) -->
    <section id="iw-create" class="create-card" hidden>
      <div class="form-row">
        <label class="form-field grow">
          <span class="label">Name</span>
          <input class="input" id="iw-name" placeholder="e.g. Stripe payments" />
        </label>
        <label class="form-field">
          <span class="label">Enabled</span>
          <label class="switch"><input type="checkbox" id="iw-enabled" checked /><span class="track"></span></label>
        </label>
      </div>
      <label class="form-field">
        <span class="label">Description <span class="muted">(optional)</span></span>
        <input class="input" id="iw-desc" placeholder="What sends to this webhook?" />
      </label>
      <div class="form-row">
        <label class="form-field grow">
          <span class="label">Signing secret <span class="muted">(optional — slug of a workspace Secret holding the sender's HMAC key)</span></span>
          <input class="input" id="iw-signing" placeholder="e.g. WEBHOOK_SIGNING_KEY" />
        </label>
        <label class="form-field grow">
          <span class="label">Signature header <span class="muted">(default X-Signature-256)</span></span>
          <input class="input" id="iw-sig-header" placeholder="e.g. X-Hub-Signature-256" />
        </label>
      </div>
      <p class="hint">With a signing secret set, every request must be signed or it is rejected — by default <code>sha256=&lt;hex HMAC-SHA256 of the raw body&gt;</code> in that header. After creating, pick another scheme under <strong>Signing</strong> (Stripe, Slack, Shopify, Standard Webhooks, an integration's own, or custom).</p>
      <div class="create-actions">
        <button id="iw-create-btn" class="button">Create</button>
        <button id="iw-cancel" class="button ghost" type="button">Cancel</button>
        <span id="iw-create-status" class="hint"></span>
      </div>
    </section>

    <!-- Webhook list: the shared list kit (lib/organizedList.ts) -->
    {webhooks.length > 0 && (
      <FilterBar
        searchPlaceholder="Search webhooks…"
        searchId="iw-search"
        filters={[
          { id: "iw-f-from", label: "sources", options: fromChoices },
          { id: "iw-f-status", label: "statuses", options: statusOptions({ attention: true }) },
          { id: "iw-f-signed", label: "signing", options: SIGNED_OPTIONS },
          { id: "iw-f-received", label: "deliveries", options: RECEIVED_OPTIONS },
        ]}
      />
    )}
    <OrganizedSections id="iw" noun="webhook" emptyAll="No incoming webhooks yet. Create one to get a URL." />
  </div>
 </div>
</AppLayout>

<script>
  import { fetchApi } from "@/lib/api/client";
  import { attentionReason, incomingWebhookAdapter } from "@/lib/incomingWebhookList";
  import { mountOrganizedList } from "@/lib/organizedListView";
  import { menuHtml, switchHtml } from "@/lib/organizedListHtml";
  import { createSdkClient } from "@/lib/sdk";

  const sdk = () => createSdkClient();
  // What each delivery carried: every call is in the event log (event incoming_webhook, entity = the webhook)
  // with its payload, kept for the event log's retention (90 days by default).
  const DELIVERIES_SHOWN = 10;
  const $ = (id: string): any => document.getElementById(id);
  const esc = (s: unknown) => String(s ?? "").replace(/[&<>"']/g, (c) =>
    ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c] as string));

  const hookBase = (document.querySelector(".iw-page") as HTMLElement).dataset.hookBase || "";
  let webhooks: any[] = JSON.parse($("iw-list-data").textContent || "[]");
  const INTEGRATIONS = JSON.parse($("iw-integration-names").textContent || "{}");
  const canManage = JSON.parse($("iw-can-manage").textContent || "false") === true;
  const schemes: any[] = JSON.parse($("iw-schemes-data").textContent || "[]");
  // What the sender must do, in the selected scheme's own words (its notes), so the hint never
  // describes a different scheme than the one picked.
  // Whether the sender makes the key and shows it (Stripe, Slack, Square…): then there is nothing to generate,
  // only the sender's key to paste into the secret.
  const senderIssuesKey = (name: string) => Boolean(schemes.find((x) => x.name === name)?.sender_issues_key);
  const signingHint = (name: string) => {
    if (name === "custom") return "The sender signs as described in the JSON below.";
    const notes = schemes.find((x) => x.name === name)?.notes;
    const how = notes ? `The sender must sign: ${notes}.` : "The sender must sign each request with this scheme.";
    return senderIssuesKey(name)
      ? `${how} The sender gives you the signing key: store it as the secret named above (Settings → Secrets), then Save.`
      : how;
  };
  const schemeLabel = (name) => {
    const s = schemes.find((x) => x.name === name);
    return s ? `${name}${s.source !== "core" ? ` (from ${s.source})` : ""}` : name;
  };

  function hookUrl(token) { return `${hookBase}/${token}`; }
  function fmtWhen(iso) {
    if (!iso) return "never";
    const d = new Date(iso);
    return isNaN(d.getTime()) ? "never" : d.toLocaleString();
  }

  function card(w) {
    const tokenBlock = w.token
      ? `<div class="token-live">
           <input class="input url" readonly value="${esc(hookUrl(w.token))}" data-url />
           <button class="button ghost sm" data-act="copy">Copy</button>
           <button class="button ghost sm" data-act="toggle-test">Send test</button>
           <button class="button ghost sm" data-act="rotate">Rotate</button>
           <button class="button ghost sm danger" data-act="revoke">Revoke</button>
         </div>
         <span class="hint" data-status></span>
         <div class="test-panel" data-test-panel hidden>
           <span class="hint">Test payload (JSON) — reaches your workflows as <code>$event.payload.*</code>:</span>
           <textarea class="input test-payload" rows="4" spellcheck="false">{
  "entry_slug": ""
}</textarea>
           <div class="test-actions">
             <button class="button sm" data-act="send-test">Send</button>
             <button class="button ghost sm" data-act="cancel-test">Cancel</button>
             <span class="hint" data-test-status></span>
           </div>
         </div>`
      : `<div class="token-none">
           <span class="hint">No token yet — the endpoint is inactive.</span>
           <button class="button sm" data-act="mint">Create token</button>
           <span class="hint" data-status></span>
         </div>`;

    const why = attentionReason(w);
    return `<article class="org-card iw-card${w.enabled ? "" : " off"}" data-id="${esc(w.id)}">
     <div class="org-card-main">
      <div class="iw-head">
        <div>
          <strong>${esc(w.name)}</strong>
          <code class="slug">${esc(w.slug)}</code>
          ${w.description ? `<span class="desc">${esc(w.description)}</span>` : ""}
        </div>
      </div>
      ${why ? `<div class="iw-attention" title="${esc(why)}"><strong>Needs a look</strong> · ${esc(why)}</div>` : ""}
      ${tokenBlock}
      <div class="signing-row">
        <span class="hint">Signing: ${w.signingSecretRef
          ? `${esc(schemeLabel(w.signatureScheme || "hmac_sha256_hex"))} with secret <code>${esc(w.signingSecretRef)}</code>${w.signatureHeader ? ` in header <code>${esc(w.signatureHeader)}</code>` : ""}`
          : "off — the URL token is the only credential"}</span>
        <button class="button ghost sm" data-act="edit-signing">${w.signingSecretRef ? "Change" : "Set up signing"}</button>
      </div>
      <div class="signing-edit" hidden>
        <input class="input" data-signing-ref placeholder="Secret slug, e.g. WEBHOOK_SIGNING_KEY" value="${esc(w.signingSecretRef || "")}" />
        <input class="input" data-signing-header placeholder="Header (blank = the scheme's own)" value="${esc(w.signatureHeader || "")}" />
        <select class="input" data-signing-scheme title="How the sender signs">
          ${schemes.map((s) => `<option value="${esc(s.name)}" title="${esc(s.notes || "")}" ${(w.signatureScheme || "hmac_sha256_hex") === s.name ? "selected" : ""}>${esc(schemeLabel(s.name))}${s.notes ? ` — ${esc(s.notes)}` : ""}</option>`).join("")}
        </select>
        <input class="input url" data-signing-url placeholder="Signed URL — only for schemes that sign the URL (the exact URL you gave the sender)" value="${esc(w.signatureUrl || (w.token ? hookUrl(w.token) : ""))}" />
        <textarea class="input mono" data-signing-config rows="5" spellcheck="false" ${w.signatureScheme === "custom" ? "" : "hidden"} placeholder='{"algorithm": "sha256", "encoding": "base64", "message": "{url}{body}", "header": "X-Signature"}'>${esc(w.signatureConfig ? JSON.stringify(w.signatureConfig, null, 2) : "")}</textarea>
        <button class="button sm" data-act="save-signing">Save</button>
        <button class="button ghost sm" data-act="gen-signing" title="Create a random key, store it as that secret, and show it once so you can paste it into the sender" ${senderIssuesKey(w.signatureScheme || "hmac_sha256_hex") ? "hidden" : ""}>Generate key</button>
        <button class="button ghost sm" data-act="cancel-signing">Cancel</button>
        <span class="hint">Leave the secret blank to turn verification off. <span data-signing-hint>${esc(signingHint(w.signatureScheme || "hmac_sha256_hex"))}</span></span>
        <div class="signing-reveal" hidden>
          <input class="input url" readonly data-signing-value />
          <button class="button ghost sm" data-act="copy-signing">Copy</button>
          <span class="hint">Shown once. Paste it into the sender's signing-key field now; Marvin keeps only the encrypted secret.</span>
        </div>
      </div>
      <div class="iw-meta">
        ${w.receivedCount
          ? `<button type="button" class="link-btn" data-act="deliveries" aria-expanded="false" title="What the last calls carried">${w.receivedCount} received ▾</button>`
          : `<span>0 received</span>`}
        <span>·</span>
        <span>last: ${esc(fmtWhen(w.lastReceivedAt))}</span>
        ${!w.enabled ? `<span class="pill">disabled</span>` : ""}
        ${w.signingSecretRef ? `<span class="pill" title="Requests are verified (${esc(schemeLabel(w.signatureScheme || "hmac_sha256_hex"))}) with secret ${esc(w.signingSecretRef)}${w.signatureHeader ? ` in header ${esc(w.signatureHeader)}` : ""}">verified</span>` : ""}
      </div>
      <div class="iw-deliveries" data-deliveries hidden></div>
     </div>
     <div class="org-card-actions">
       ${switchHtml({ on: w.enabled, cls: "js-toggle", label: w.name })}
       ${menuHtml([{ cls: "js-delete", label: "Delete", title: "Delete this webhook", danger: true }])}
     </div>
    </article>`;
  }

  const list = mountOrganizedList<any>({
    host: $("iw-list"),
    emptyFiltered: $("iw-empty"),
    emptyAll: $("iw-none"),
    search: document.getElementById("iw-search") as HTMLInputElement | null,
    selects: {
      from: document.getElementById("iw-f-from") as HTMLSelectElement | null,
      status: document.getElementById("iw-f-status") as HTMLSelectElement | null,
      signed: document.getElementById("iw-f-signed") as HTMLSelectElement | null,
      received: document.getElementById("iw-f-received") as HTMLSelectElement | null,
    },
    items: () => webhooks,
    adapter: incomingWebhookAdapter(),
    integrations: INTEGRATIONS,
    noun: "webhook",
    storageKey: "marvin.automation.incoming-webhooks.filters",
    renderItem: (w) => card(w),
    removedDelete: { kind: "incoming-webhooks", canDelete: canManage },
  });
  const render = () => list.refresh();

  function upsert(w) {
    const i = webhooks.findIndex((x) => x.id === w.id);
    if (i >= 0) webhooks[i] = w; else webhooks.push(w);
    render();
  }

  // ── Create ────────────────────────────────────────────────────────────────
  $("iw-new").addEventListener("click", () => $("iw-create").toggleAttribute("hidden"));
  $("iw-cancel").addEventListener("click", () => $("iw-create").setAttribute("hidden", ""));
  $("iw-create-btn").addEventListener("click", async () => {
    const name = ($("iw-name")).value.trim();
    const status = $("iw-create-status");
    if (!name) { status.textContent = "Name is required."; return; }
    status.textContent = "Creating…";
    try {
      const w = await sdk().incomingWebhooks.create({
        name,
        description: ($("iw-desc")).value.trim() || undefined,
        enabled: ($("iw-enabled")).checked,
        signingSecretRef: ($("iw-signing")).value.trim() || undefined,
        signatureHeader: ($("iw-sig-header")).value.trim() || undefined,
      } as any);
      upsert(w);
      ($("iw-name")).value = ""; ($("iw-desc")).value = ""; ($("iw-signing")).value = ""; ($("iw-sig-header")).value = "";
      $("iw-create").setAttribute("hidden", "");
      status.textContent = "";
    } catch (e) { status.textContent = `Error: ${e?.message ?? e}`; }
  });

  // Custom is the only scheme with settings of its own — show its JSON box only when it's picked.
  $("iw-list").addEventListener("change", (ev: Event) => {
    const sel = ev.target as HTMLElement;
    if (!sel.matches?.("[data-signing-scheme]")) return;
    const box = sel.closest(".signing-edit");
    const picked = (sel as HTMLSelectElement).value;
    box?.querySelector("[data-signing-config]")?.toggleAttribute("hidden", picked !== "custom");
    const hint = box?.querySelector("[data-signing-hint]");
    if (hint) hint.textContent = signingHint(picked);
    box?.querySelector('[data-act="gen-signing"]')?.toggleAttribute("hidden", senderIssuesKey(picked));
  });

  // ── Deliveries: the last calls, each opening to the JSON it carried ───────────
  async function loadDeliveries(w: any, box: HTMLElement) {
    box.innerHTML = `<p class="hint">Loading…</p>`;
    try {
      const q = new URLSearchParams({ entity_type: "incoming_webhook", entity_id: w.id, event_type: "incoming_webhook", limit: String(DELIVERIES_SHOWN) });
      const rows = await fetchApi<any[]>(`/api/platform/events?${q}`);
      box.innerHTML = rows.length
        ? rows
            .map((e) => `<details class="delivery" data-event="${esc(e.eventId ?? e.event_id)}">
                <summary>${esc(fmtWhen(e.occurredAt ?? e.occurred_at))}</summary>
                <pre class="delivery-body">Loading…</pre>
              </details>`)
            .join("") +
          (w.receivedCount > rows.length ? `<p class="hint">The last ${rows.length} of ${w.receivedCount}. Older calls are past the event log's retention, or open the <a href="/automation/events">event log</a>.</p>` : "")
        : `<p class="hint">No calls in the event log — older ones are past its retention.</p>`;
    } catch (e: any) {
      box.innerHTML = `<p class="hint error">Couldn't load the deliveries: ${esc(e?.message ?? e)}</p>`;
    }
  }
  // A delivery's payload is fetched when it is opened (the list stays light).
  $("iw-list").addEventListener("toggle", async (ev: Event) => {
    const det = ev.target as HTMLDetailsElement;
    if (!det.matches?.("details.delivery") || !det.open || det.dataset.loaded) return;
    det.dataset.loaded = "1";
    const pre = det.querySelector(".delivery-body") as HTMLElement;
    try {
      const e = await fetchApi<any>(`/api/platform/events/${encodeURIComponent(det.dataset.event!)}`);
      const doc = (e.eventData ?? e.event_data ?? {}).documentData ?? {};
      const from = doc.sourceIp ? `From ${doc.sourceIp}\n\n` : "";
      pre.textContent = from + JSON.stringify(doc.payload ?? {}, null, 2);
    } catch (err: any) {
      pre.textContent = `Couldn't load it: ${err?.message ?? err}`;
      delete det.dataset.loaded;
    }
  }, true);

  // ── Per-card actions (event delegation) ─────────────────────────────────────
  $("iw-list").addEventListener("click", async (ev: Event) => {
    const btn: any = (ev.target as HTMLElement).closest("[data-act], .js-toggle, .js-delete");
    if (!btn) return;
    const cardEl: any = btn.closest(".iw-card");
    const id = cardEl?.dataset.id;
    const w = webhooks.find((x) => x.id === id);
    if (!w) return;
    const act = btn.classList.contains("js-toggle") ? "toggle" : btn.classList.contains("js-delete") ? "delete" : btn.dataset.act;
    const status = cardEl.querySelector("[data-status]");
    const setStatus = (t: string, err?: boolean) => { if (status) { status.textContent = t; status.classList.toggle("error", !!err); } };

    try {
      if (act === "toggle") {
        const enabled = btn.getAttribute("aria-checked") !== "true";
        upsert(await sdk().incomingWebhooks.update(id, { enabled }));
      } else if (act === "mint" || act === "rotate") {
        if (act === "rotate" && !confirm("Rotate the token? The current URL will stop working immediately.")) return;
        setStatus(act === "mint" ? "Creating token…" : "Rotating…");
        upsert(await sdk().incomingWebhooks.mintToken(id));
        setStatus("");
      } else if (act === "revoke") {
        if (!confirm("Revoke the token? The endpoint will reject all requests until you mint a new one.")) return;
        upsert(await sdk().incomingWebhooks.revokeToken(id));
      } else if (act === "delete") {
        if (!confirm(`Delete “${w.name}”? This can't be undone.`)) return;
        await sdk().incomingWebhooks.delete(id);
        webhooks = webhooks.filter((x) => x.id !== id);
        render();
      } else if (act === "edit-signing" || act === "cancel-signing") {
        btn.closest(".iw-card, .iw-item, [data-id]")?.querySelector(".signing-edit")?.toggleAttribute("hidden", act === "cancel-signing");
      } else if (act === "gen-signing") {
        const box = btn.closest(".signing-edit");
        const refInput = box.querySelector("[data-signing-ref]") as HTMLInputElement;
        const slug = (refInput.value.trim() || `${w.slug}_SIGNING_KEY`).toUpperCase().replace(/[^A-Z0-9_]+/g, "_");
        const bytes = new Uint8Array(32); crypto.getRandomValues(bytes);
        const value = Array.from(bytes, (b) => b.toString(16).padStart(2, "0")).join("");
        setStatus("Creating secret…");
        try {
          await sdk().secrets.create({ name: `${w.name} signing key`, slug, description: `HMAC signing key for incoming webhook "${w.slug}"`, value });
        } catch (err) {
          // A secret by that name already exists: replacing its value is the user's call (the old key stops working).
          if (!/already exists|409/.test(String((err as Error)?.message ?? err))) throw err;
          if (!confirm(`A secret named ${slug} already exists. Replace its value with a new key? Whatever uses the old key stops verifying.`)) {
            setStatus("");
            return;
          }
          const existing = (await sdk().secrets.list()).find((x: any) => x.slug === slug);
          if (!existing) throw err;
          await sdk().secrets.update(existing.id, { value } as any);
        }
        const signatureHeader = (box.querySelector("[data-signing-header]") as HTMLInputElement).value.trim() || null;
        const updated = await sdk().incomingWebhooks.update(id, { signingSecretRef: slug, signatureHeader } as any);
        // Re-render would drop the one-time reveal, so patch the card in place instead.
        webhooks = webhooks.map((x) => (x.id === id ? updated : x));
        refInput.value = slug;
        const reveal = box.querySelector(".signing-reveal") as HTMLElement;
        (reveal.querySelector("[data-signing-value]") as HTMLInputElement).value = value;
        reveal.removeAttribute("hidden");
        setStatus("");
      } else if (act === "copy-signing") {
        const v = (btn.closest(".signing-reveal").querySelector("[data-signing-value]") as HTMLInputElement).value;
        await navigator.clipboard.writeText(v);
        setStatus("Key copied.");
      } else if (act === "save-signing") {
        const box = btn.closest(".signing-edit");
        const signingSecretRef = (box.querySelector("[data-signing-ref]") as HTMLInputElement).value.trim() || null;
        const signatureHeader = (box.querySelector("[data-signing-header]") as HTMLInputElement).value.trim() || null;
        const scheme = (box.querySelector("[data-signing-scheme]") as HTMLSelectElement).value;
        const signatureScheme = scheme === "hmac_sha256_hex" ? null : scheme;
        // Stored for every scheme; only those whose message includes {url} use it.
        const signatureUrl = (box.querySelector("[data-signing-url]") as HTMLInputElement).value.trim() || null;
        let signatureConfig = null;
        if (scheme === "custom") {
          try { signatureConfig = JSON.parse((box.querySelector("[data-signing-config]") as HTMLTextAreaElement).value || "{}"); }
          catch { setStatus("Custom config must be valid JSON.", true); return; }
        }
        setStatus("Saving…");
        upsert(await sdk().incomingWebhooks.update(id, { signingSecretRef, signatureHeader, signatureScheme, signatureUrl, signatureConfig } as any));
        setStatus("");
      } else if (act === "deliveries") {
        const box = cardEl.querySelector("[data-deliveries]") as HTMLElement;
        const open = box.hasAttribute("hidden");
        box.toggleAttribute("hidden", !open);
        btn.setAttribute("aria-expanded", String(open));
        if (open) await loadDeliveries(w, box);
      } else if (act === "copy") {
        await navigator.clipboard.writeText(hookUrl(w.token));
        setStatus("Copied.");
        setTimeout(() => setStatus(""), 1500);
      } else if (act === "toggle-test") {
        const panel = cardEl.querySelector("[data-test-panel]");
        panel?.toggleAttribute("hidden");
        if (panel && !panel.hasAttribute("hidden")) cardEl.querySelector(".test-payload")?.focus();
      } else if (act === "cancel-test") {
        cardEl.querySelector("[data-test-panel]")?.setAttribute("hidden", "");
      } else if (act === "send-test") {
        // Simulate an external caller with the author's own JSON body; ?wait=1 runs inline.
        const ta = cardEl.querySelector(".test-payload") as HTMLTextAreaElement | null;
        const tStatus = cardEl.querySelector("[data-test-status]") as HTMLElement | null;
        const setT = (t: string, err?: boolean) => { if (tStatus) { tStatus.textContent = t; tStatus.classList.toggle("error", !!err); } };
        let payload: any;
        try { payload = JSON.parse(ta?.value || "{}"); }
        catch (e: any) { setT(`Invalid JSON: ${e?.message ?? e}`, true); return; }
        setT("Sending…");
        const res = await fetch(`${hookUrl(w.token)}?wait=1`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });
        const body = await res.json().catch(() => ({}));
        if (res.ok) {
          setT(`Fired (${body.status ?? "ok"}).`);
          upsert(await sdk().incomingWebhooks.get(id));  // refresh counts (re-renders card)
        } else {
          setT(`Failed: ${body.detail ?? res.status}`, true);
        }
      }
    } catch (e) { setStatus(`Error: ${e?.message ?? e}`, true); }
  });

  render();
</script>

<style>
