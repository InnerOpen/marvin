---
import FilterBar from "@/components/FilterBar.astro";
import AppLayout from "@/layouts/AppLayout.astro";
import { getAuthToken } from "@/lib/api/client";
import { type EntryRead, listEntries } from "@/lib/api/entries";
import { type EntryTypeRead, listEntryTypes } from "@/lib/api/entryTypes";
import { canManageCurrentWorkspace } from "@/lib/api/workspaces";

const authToken = getAuthToken(Astro.cookies);
// Everyone reads; creating, editing and deleting entry types is admin-only (if the role can't be read, let the API decide).
const canManage = authToken ? await canManageCurrentWorkspace(authToken).catch(() => true) : true;

let entryTypes: EntryTypeRead[] = [];
let entries: EntryRead[] = [];
let error: string | null = null;

if (!authToken) {
  error = "Authentication required";
  console.error("[EntryTypes] No auth token available");
} else {
  try {
    [entryTypes, entries] = await Promise.all([listEntryTypes(authToken), listEntries(authToken)]);
  } catch (e) {
    error = e instanceof Error ? e.message : String(e);
    console.error("[EntryTypes] Failed to load:", error);
  }
}

// Count entries per type
const entryCounts = new Map<string, number>();
entries.forEach((entry) => {
  const count = entryCounts.get(entry.entryTypeId) || 0;
  entryCounts.set(entry.entryTypeId, count + 1);
});

// Sort by sortOrder (camelCase from SDK)
const sortedTypes = entryTypes.sort((a, b) => a.sortOrder - b.sortOrder);
const systemTypes = sortedTypes.filter((t) => t.isSystem);
const customTypes = sortedTypes.filter((t) => !t.isSystem);

function getRendering(type: EntryTypeRead) {
  const rendering = type.renderingJson as Record<string, unknown> | undefined;
  return {
    renderer: rendering?.renderer as string | undefined,
    package: rendering?.package as string | undefined,
    version: rendering?.version as string | undefined,
  };
}
---

<AppLayout crumb="settings.entry-types">
  {error ? (
    <div class="error-banner">
      <p><strong>Error loading entry types:</strong> {error}</p>
      <button onclick="location.reload()" class="button secondary">Retry</button>
    </div>
  ) : (
    <>
      <div class="toolbar">
        <div>
          <h2 style="margin:0;font-size:20px;">Entry Types</h2>
          <p style="margin:4px 0 0;color:var(--muted);">Define content types for your workspace.</p>
        </div>
        <div style="display:flex;gap:0.75rem;">
          <FilterBar searchPlaceholder="Search entry types..." />
          {canManage && <a class="button" href="/workspace/entry-types/new">Create Entry Type</a>}
        </div>
      </div>

      {systemTypes.length > 0 && (
        <section>
          <h3 style="margin:0 0 1rem;font-size:1rem;color:var(--muted);">System Types</h3>
          <table class="table types">
            <thead>
              <tr>
                <th>Icon</th>
                <th>Name</th>
                <th>Type</th>
                <th class="col-wide">Slug</th>
                <th class="col-render">Rendered</th>
                <th class="col-render">Renderer</th>
                <th class="col-render">Package</th>
                <th class="col-render">Version</th>
                <th class="col-wide">Entries</th>
                <th class="col-render">Sort Order</th>
              </tr>
            </thead>
            <tbody>
              {systemTypes.map((type) => {
                const count = entryCounts.get(type.id) || 0;
                const { renderer, package: pkg, version } = getRendering(type);
                return (
                  <tr class={`entry-type-row ${count === 0 ? 'empty-type' : ''}`}
                    data-system="true"
                    data-name={type.name.toLowerCase()}
                    data-slug={type.slug.toLowerCase()}
                    data-description={(type.description || '').toLowerCase()}>
                    <td>
                      {type.icon && (
                        <span style={`font-size:1.5rem;${type.color ? `color:${type.color}` : ''}`}>
                          {type.icon}
                        </span>
                      )}
                    </td>
                    <td class="type-name"><strong>{type.name}</strong></td>
                    <td><span class="system-badge">System</span></td>
                    <td class="col-wide"><code>{type.slug}</code></td>
                    <td class="col-render">{type.isRendered ? <span class="rendered-badge">Yes</span> : '—'}</td>
                    <td class="col-render">{renderer ? <code>{renderer}</code> : '—'}</td>
                    <td class="col-render">{pkg ? <code>{pkg}</code> : '—'}</td>
                    <td class="col-render">{version || '—'}</td>
                    <td class="col-wide">
                      {count === 0 ? (
                        <span class="empty-badge">Empty</span>
                      ) : (
                        <span class="count-badge">{count}</span>
                      )}
                    </td>
                    <td class="col-render">{type.sortOrder}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </section>
      )}

      {customTypes.length === 0 ? (
        <div class="empty-state">
          <p class="empty-title">No custom entry types yet</p>
          <p class="empty-description">
            Create custom entry types to organize your content beyond the default system types.
          </p>
          {canManage && <a href="/workspace/entry-types/new" class="button">Create Entry Type</a>}
        </div>
      ) : (
        <section>
          <h3 style="margin:2rem 0 1rem;font-size:1rem;color:var(--muted);">Custom Types</h3>
          <table class="table types">
            <thead>
              <tr>
                <th>Icon</th>
                <th>Name</th>
                <th>Type</th>
                <th class="col-wide">Slug</th>
                <th class="col-render">Rendered</th>
                <th class="col-render">Renderer</th>
                <th class="col-render">Package</th>
                <th class="col-render">Version</th>
                <th class="col-wide">Entries</th>
                <th class="col-render">Sort Order</th>
                <th class="col-wide">Actions</th>
              </tr>
            </thead>
            <tbody>
              {customTypes.map((type) => {
                const count = entryCounts.get(type.id) || 0;
                const { renderer, package: pkg, version } = getRendering(type);
                return (
                  <tr class={`entry-type-row ${count === 0 ? 'empty-type' : ''}`}
                    data-system="false"
                    data-name={type.name.toLowerCase()}
                    data-slug={type.slug.toLowerCase()}
                    data-description={(type.description || '').toLowerCase()}>
                    <td>
                      {type.icon && (
                        <span style={`font-size:1.5rem;${type.color ? `color:${type.color}` : ''}`}>
                          {type.icon}
                        </span>
                      )}
                    </td>
                    <td class="type-name"><a class="row-link" href={`/workspace/entry-types/${type.id}`}><strong>{type.name}</strong></a></td>
                    <td><span class="custom-badge">Custom</span></td>
                    <td class="col-wide"><code>{type.slug}</code></td>
                    <td class="col-render">{type.isRendered ? <span class="rendered-badge">Yes</span> : '—'}</td>
                    <td class="col-render">{renderer ? <code>{renderer}</code> : '—'}</td>
                    <td class="col-render">{pkg ? <code>{pkg}</code> : '—'}</td>
                    <td class="col-render">{version || '—'}</td>
                    <td class="col-wide">
                      {count === 0 ? (
                        <span class="empty-badge">Empty</span>
                      ) : (
                        <span class="count-badge">{count}</span>
                      )}
                    </td>
                    <td class="col-render">{type.sortOrder}</td>
                    <td class="col-wide">
                      <div class="actions">
                        <a href={`/workspace/entry-types/${type.id}`} class="button secondary small">{canManage ? "Edit" : "View"}</a>
                        {canManage && (
                          <form method="POST" action={`/api/entry-types/${type.id}/delete`} style="display:inline;">
                            <button type="submit" class="button secondary small danger" onclick="return confirm('Delete this entry type?')">
                              Delete
                            </button>
                          </form>
                        )}
                      </div>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </section>
      )}
    </>
  )}
</AppLayout>

<script>
  const searchInput = document.getElementById('filter-search') as HTMLInputElement;

  function filterEntryTypes() {
    const searchQuery = searchInput?.value.toLowerCase() || '';
    const rows = document.querySelectorAll('.entry-type-row');

    rows.forEach(row => {
      const name = row.getAttribute('data-name') || '';
      const slug = row.getAttribute('data-slug') || '';
      const description = row.getAttribute('data-description') || '';

      const matchesSearch = !searchQuery ||
        name.includes(searchQuery) ||
        slug.includes(searchQuery) ||
        description.includes(searchQuery);

      (row as HTMLElement).style.display = matchesSearch ? '' : 'none';
    });
  }

  searchInput?.addEventListener('input', filterEntryTypes);
</script>

<style>
  .error-banner {
    padding: 1.5rem;
    background: var(--color-error-bg);
    border: 1px solid var(--color-error);
    border-radius: var(--radius);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .error-banner p {
    margin: 0;
    color: var(--color-error);
  }

  .empty-state {
    display: grid;
    place-items: center;
    gap: 1rem;
    padding: 4rem 2rem;
    text-align: center;
  }

  .empty-title {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 600;
  }

  .empty-description {
    margin: 0;
    color: var(--muted);
    max-width: 32rem;
  }

  .actions {
    display: flex;
    gap: 0.5rem;
  }

  /* A long name or slug wraps rather than stretching its cell. */
  .types td {
    overflow-wrap: anywhere;
  }

  /* The whole row of a custom type opens its editor: the name is the real link (keyboard, screen reader) and its
     ::after stretches over the row as the tap target. The desktop Edit / Delete controls sit above it. */
  .types tr {
    position: relative;
  }
  .types .row-link {
    color: inherit;
    text-decoration: none;
  }
  .types .row-link::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  .types .row-link:focus-visible {
    outline: none;
  }
  .types .row-link:focus-visible::after {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }
  .types tr:has(.row-link):hover {
    background: rgba(79, 156, 132, 0.08);
  }
  .types .actions {
    position: relative;
  }
  .types td .system-badge,
  .types td .custom-badge {
    white-space: nowrap;
  }

  /* Below desktop width the rendering columns (rendered, renderer, package, version, sort order) go: with them the
     table overflows its box and the Actions column is clipped. */
  @media (max-width: 1240px) {
    .types .col-render {
      display: none;
    }
    /* The name column takes the leftover width (and wraps a long name); with columns hidden the browser otherwise
       leaves a gap at the table's right edge. */
    .types th:nth-child(2) {
      width: 100%;
    }
    .types td code {
      overflow-wrap: break-word;
    }
    .types .actions .button {
      white-space: nowrap;
    }
  }

  /* Phones: compact rows with just the icon, name and kind, which fit without sideways scrolling (the eleven-column
     table put Edit a thousand pixels off-screen); the rest is on the edit page. Tapping a row edits. */
  @media (max-width: 640px) {
    .types .col-wide {
      display: none;
    }
    .types td {
      vertical-align: middle;
    }
  }

  .button.small {
    min-height: 32px;
    padding: 6px 10px;
    font-size: 0.875rem;
  }

  .button.danger {
    color: var(--color-error);
    border-color: var(--color-error);
  }

  .button.danger:hover {
    background: var(--color-error-bg);
  }

  .empty-type {
    background: rgba(255, 193, 7, 0.05);
  }

  .empty-badge {
    display: inline-block;
    padding: 4px 8px;
    background: rgba(255, 193, 7, 0.1);
    color: #f59e0b;
    border: 1px solid rgba(255, 193, 7, 0.3);
    border-radius: 4px;
    font-size: 12px;
    font-weight: 500;
  }

  .count-badge {
    display: inline-block;
    padding: 4px 8px;
    background: rgba(79, 156, 132, 0.1);
    color: var(--accent);
    border: 1px solid var(--accent);
    border-radius: 4px;
    font-size: 12px;
    font-weight: 600;
  }

  .system-badge {
    display: inline-block;
    padding: 4px 8px;
    background: rgba(37, 99, 235, 0.1);
    color: #2563EB;
    border: 1px solid rgba(37, 99, 235, 0.3);
    border-radius: 4px;
    font-size: 12px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .rendered-badge {
    display: inline-block;
    padding: 4px 8px;
    background: rgba(79, 156, 132, 0.1);
    color: var(--accent);
    border: 1px solid var(--accent);
    border-radius: 4px;
    font-size: 12px;
    font-weight: 500;
  }

  .custom-badge {
    display: inline-block;
    padding: 4px 8px;
    background: rgba(124, 58, 237, 0.1);
    color: #7C3AED;
    border: 1px solid rgba(124, 58, 237, 0.3);
    border-radius: 4px;
    font-size: 12px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
</style>
