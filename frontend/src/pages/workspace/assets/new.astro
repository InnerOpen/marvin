---
import ImageCropper from "@/components/ImageCropper.astro";
import SlugInput from "@/components/SlugInput.astro";
import AppLayout from "@/layouts/AppLayout.astro";
import { getAuthToken } from "@/lib/api/client";
import { FULL_CONTENT_ACCESS, getContentAccess, getCurrentWorkspace } from "@/lib/api/workspaces";
import { AUTHORS_ONLY } from "@/lib/workspaceRole";

const authToken = getAuthToken(Astro.cookies);
// Uploading is AUTHOR+ (the API answers a VIEWER with 403).
const access = authToken ? await getContentAccess(authToken) : FULL_CONTENT_ACCESS;
// The workspace an upload is meant for: one that waits for a connection is sent there only (lib/uploadQueue.ts).
let workspaceId = "";
try {
  if (authToken) workspaceId = (await getCurrentWorkspace(authToken))?.id ?? "";
} catch {
  /* without it a failed upload just fails, as before */
}
---

<AppLayout restrictedNote={access.canAuthor ? null : AUTHORS_ONLY} title="Upload Asset" eyebrow="Assets">
  <div class="toolbar">
    <div>
      <h2>Upload Asset</h2>
      <p style="margin:4px 0 0;color:var(--muted);">Upload images, videos, documents, and other files</p>
    </div>
    <a href="/workspace/assets" class="button secondary">Cancel</a>
  </div>

  <section class="form-section">
    <form id="uploadForm" enctype="multipart/form-data" class="form" data-workspace={workspaceId}>
      <!-- File Upload Area -->
      <div class="form-group">
        <label for="file">File *</label>
        <div class="file-upload-area" id="dropZone">
          <input
            type="file"
            id="file"
            name="file"
            required
            multiple
            accept="image/*,video/*,audio/*,.pdf,.doc,.docx,.svg"
            hidden
          />
          <div class="upload-placeholder" id="uploadPlaceholder">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="17 8 12 3 7 8"></polyline>
              <line x1="12" y1="3" x2="12" y2="15"></line>
            </svg>
            <p style="margin: 1rem 0 0.5rem; font-weight: 600;">Click to upload or drag and drop</p>
            <p style="margin: 0; font-size: 0.875rem; color: var(--muted);">Images, videos, PDFs, documents — one file, or a whole batch</p>
          </div>
          <div class="upload-preview" id="uploadPreview" style="display: none;">
            <div id="previewContent"></div>
            <button type="button" class="button secondary small" id="removeFile">Change File</button>
          </div>
          <div class="upload-batch" id="uploadBatch" style="display: none;">
            <p class="batch-summary" id="batchSummary"></p>
            <label class="batch-adjust" id="batchAdjust" hidden><input type="checkbox" id="batchAdjustOn" /> <span id="batchAdjustText">Apply my last adjustments to every picture</span></label>
            <label class="batch-adjust" id="batchKeep" hidden><input type="checkbox" id="batchKeepOn" /> <span>Also keep each original file (a second, full-size asset; the adjusted picture is saved as a version made from it)</span></label>
            <ul class="batch-list" id="batchList"></ul>
            <button type="button" class="button secondary small" id="changeFiles">Change files</button>
          </div>
        </div>
        <p class="form-help" id="batchHelp" style="display: none;">Each file is named after its filename; alt text, description and metadata below apply to all of them. Edit any of them afterwards in the library.</p>
      </div>

      <!-- Name Field (Auto-populated from filename) -->
      <div class="form-group">
        <label for="name">Name *</label>
        <input
          type="text"
          id="name"
          name="name"
          required
          placeholder="e.g., Product Hero Image"
        />
        <p class="form-help">Auto-populated from filename, edit as needed</p>
      </div>

      <!-- Slug (Auto-generated, read-only) -->
      <SlugInput nameFieldId="name" />

      <!-- Alt Text -->
      <div class="form-group">
        <label for="alt_text">Alt Text</label>
        <input
          type="text"
          id="alt_text"
          name="alt_text"
          placeholder="Describe this asset for accessibility"
        />
        <p class="form-help">Important for accessibility and SEO (especially for images)</p>
      </div>

      <!-- Description -->
      <div class="form-group">
        <label for="description">Description</label>
        <textarea
          id="description"
          name="description"
          rows="4"
          placeholder="Additional details about this asset"
        ></textarea>
      </div>

      <!-- Metadata (JSON) -->
      <div class="form-group">
        <label for="metadata">Custom Metadata (JSON)</label>
        <textarea
          id="metadata"
          name="metadata"
          rows="6"
          placeholder='{"photographer": "Jane Doe", "license": "CC-BY"}'
          class="metadata-editor"
        ></textarea>
        <p class="form-help">Optional custom metadata as JSON</p>
      </div>

      <!-- Upload Progress -->
      <div id="uploadProgress" style="display: none;">
        <div class="progress-bar">
          <div class="progress-fill" id="progressFill"></div>
        </div>
        <p id="progressText" style="margin: 0.5rem 0 0; font-size: 0.875rem; color: var(--muted); text-align: center;">Uploading...</p>
      </div>

      <!-- Error Message -->
      <div id="errorMessage" class="error-message" style="display: none;"></div>

      <!-- Form Actions -->
      <div class="form-actions">
        <button type="submit" class="button" id="submitButton">Upload Asset</button>
        <a href="/workspace/assets" class="button secondary">Cancel</a>
      </div>
    </form>
  </section>

  <ImageCropper />
</AppLayout>

<style>
  .form-section {
    max-width: 42rem;
  }

  .form {
    display: grid;
    gap: 2rem;
    padding: 2rem;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .form-group {
    display: grid;
    gap: 0.5rem;
  }

  label {
    font-weight: 600;
    font-size: 0.875rem;
    color: var(--ink);
  }

  input[type="text"],
  textarea {
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--bg);
    font-size: 0.875rem;
  }

  textarea {
    resize: vertical;
    font-family: inherit;
  }

  .form-help {
    margin: 0;
    font-size: 0.75rem;
    color: var(--muted);
  }

  .file-upload-area {
    border: 2px dashed var(--line);
    border-radius: var(--radius);
    padding: 2rem;
    text-align: center;
    cursor: pointer;
    transition: border-color 0.2s, background-color 0.2s;
  }

  .file-upload-area:hover {
    border-color: var(--ink);
    background: var(--panel-2);
  }

  .file-upload-area.dragover {
    border-color: var(--brand);
    background: var(--panel-2);
  }

  .upload-placeholder svg {
    color: var(--muted);
  }

  .upload-preview {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .upload-preview :global(img) {
    max-width: 100%;
    max-height: 300px;
    border-radius: 6px;
    object-fit: contain;
  }

  .upload-preview :global(.file-info) {
    text-align: center;
  }

  .upload-preview :global(.file-name) {
    font-weight: 600;
    margin: 0;
  }

  .upload-preview :global(.file-size) {
    font-size: 0.875rem;
    color: var(--muted);
    margin: 0.25rem 0 0;
  }

  .upload-batch { text-align: left; }
  .batch-summary { margin: 0 0 0.5rem; font-weight: 600; }
  .batch-adjust { display: flex; gap: 0.5rem; align-items: flex-start; margin: 0 0 0.75rem; font-size: 0.875rem; font-weight: 400; }
  .batch-list { margin: 0 0 1rem; padding: 0; list-style: none; max-height: 240px; overflow: auto; font-size: 0.875rem; }
  .batch-list li { display: flex; justify-content: space-between; gap: 1rem; padding: 0.25rem 0; border-bottom: 1px solid var(--line); }
  .batch-size { color: var(--muted); white-space: nowrap; }

  .progress-bar {
    width: 100%;
    height: 8px;
    background: var(--panel-2);
    border-radius: 4px;
    overflow: hidden;
  }

  .progress-fill {
    height: 100%;
    background: var(--brand);
    transition: width 0.3s ease;
    width: 0%;
  }

  .error-message {
    padding: 1rem;
    background: #fdecea;
    border: 1px solid #f5c6cb;
    border-radius: 6px;
    color: #721c24;
    font-size: 0.875rem;
  }

  .form-actions {
    display: flex;
    gap: 0.75rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .metadata-editor {
    font-family: 'Monaco', 'Menlo', 'Ubuntu Mono', monospace;
    font-size: 12px;
    line-height: 1.5;
    background: var(--panel-2);
  }

  .button.small {
    padding: 0.375rem 0.75rem;
    font-size: 0.875rem;
  }
</style>

<script>
  import { createSdkClient } from '@/lib/sdk';
  import { isRetryable } from '@/lib/uploadQueue';
  import { queueUpload } from '@/lib/uploadQueueClient';

  const sdk = createSdkClient();
  const form = document.getElementById('uploadForm') as HTMLFormElement;
  const fileInput = document.getElementById('file') as HTMLInputElement;
  const dropZone = document.getElementById('dropZone') as HTMLElement;
  const uploadPlaceholder = document.getElementById('uploadPlaceholder') as HTMLElement;
  const uploadPreview = document.getElementById('uploadPreview') as HTMLElement;
  const previewContent = document.getElementById('previewContent') as HTMLElement;
  const removeFileBtn = document.getElementById('removeFile') as HTMLButtonElement;
  const nameInput = document.getElementById('name') as HTMLInputElement;
  const slugInput = document.getElementById('slug') as HTMLInputElement;
  const submitButton = document.getElementById('submitButton') as HTMLButtonElement;
  const progressContainer = document.getElementById('uploadProgress') as HTMLElement;
  const progressFill = document.getElementById('progressFill') as HTMLElement;
  const progressText = document.getElementById('progressText') as HTMLElement;
  const errorMessage = document.getElementById('errorMessage') as HTMLElement;

  let selectedFile: File | null = null;
  // A batch (two or more files chosen at once): uploaded one after another, each named after its file.
  let selectedFiles: File[] = [];
  let progressInterval: number | null = null;
  const uploadBatch = document.getElementById('uploadBatch') as HTMLElement;
  const batchSummary = document.getElementById('batchSummary') as HTMLElement;
  const batchList = document.getElementById('batchList') as HTMLElement;
  const batchAdjust = document.getElementById('batchAdjust') as HTMLElement;
  const batchAdjustOn = document.getElementById('batchAdjustOn') as HTMLInputElement;
  const batchAdjustText = document.getElementById('batchAdjustText') as HTMLElement;
  const batchKeep = document.getElementById('batchKeep') as HTMLElement;
  const batchKeepOn = document.getElementById('batchKeepOn') as HTMLInputElement;
  // The cropper remembers the last brightness, contrast and saturation; a batch (which skips the cropper) can take the same look.
  const rememberedAdjust = () => ((window as any).ImageCropper?.rememberedFilter?.() ?? null) as { filter: string; summary: string } | null;
  batchAdjustOn?.addEventListener('change', () => (batchKeep.hidden = !batchAdjustOn.checked));
  function showBatchAdjust() {
    const kept = rememberedAdjust();
    batchAdjust.hidden = !kept;
    batchKeep.hidden = !kept || !batchAdjustOn.checked;
    if (kept) batchAdjustText.textContent = `Apply my last adjustments (${kept.summary}) to every picture, fitted within ${maxBox().w}×${maxBox().h} (JPEG; a PNG stays PNG), like a single cropped upload`;
  }
  /** The cropper's max size and quality, as set on the page (its controls are there even when the batch skips it). */
  const maxBox = () => ({
    w: parseInt((document.getElementById('maxWidth') as HTMLInputElement)?.value || '1920'),
    h: parseInt((document.getElementById('maxHeight') as HTMLInputElement)?.value || '1080'),
    q: parseInt((document.getElementById('quality') as HTMLInputElement)?.value || '85') / 100,
  });
  /** A raster picture with the remembered adjustments baked in, fitted within the cropper's max size, as JPEG: the same format a single
   * cropped upload gives. Anything that is not a raster picture goes as it is. */
  async function adjusted(file: File, filter: string): Promise<File> {
    if (!file.type.startsWith('image/') || file.type === 'image/svg+xml') return file;
    const bitmap = await createImageBitmap(file);
    const { w, h, q } = maxBox();
    const ratio = Math.min(1, w / bitmap.width, h / bitmap.height);
    const canvas = document.createElement('canvas');
    canvas.width = Math.round(bitmap.width * ratio);
    canvas.height = Math.round(bitmap.height * ratio);
    const ctx = canvas.getContext('2d')!;
    ctx.filter = filter;
    ctx.drawImage(bitmap, 0, 0, canvas.width, canvas.height);
    const keep = file.type === 'image/png' || file.type === 'image/webp'; // transparency stays; anything else becomes a JPEG
    const type = keep ? file.type : 'image/jpeg';
    const blob: Blob | null = await new Promise((resolve) => canvas.toBlob(resolve, type, q));
    return blob ? new File([blob], keep ? file.name : file.name.replace(/\.[a-z0-9]+$/i, '') + '.jpg', { type }) : file;
  }
  const batchHelp = document.getElementById('batchHelp') as HTMLElement;
  const changeFilesBtn = document.getElementById('changeFiles') as HTMLButtonElement;
  const nameGroup = nameInput.closest('.form-group') as HTMLElement | null;
  const slugGroup = slugInput.closest('.form-group') as HTMLElement | null;

  // Click to select file
  dropZone.addEventListener('click', (e) => {
    const t = e.target as Node;
    if (t !== removeFileBtn && !removeFileBtn.contains(t) && t !== changeFilesBtn && !changeFilesBtn.contains(t)) {
      fileInput.click();
    }
  });

  // File selection handler
  fileInput.addEventListener('change', (e) => {
    const files = (e.target as HTMLInputElement).files;
    if (files && files.length > 0) {
      handleFiles(files);
    }
  });

  // Prevent browser from opening files dropped outside the zone
  document.addEventListener('dragover', (e) => e.preventDefault());
  document.addEventListener('drop', (e) => e.preventDefault());

  // Drag and drop
  dropZone.addEventListener('dragover', (e) => {
    e.preventDefault();
    dropZone.classList.add('dragover');
  });

  dropZone.addEventListener('dragleave', (e) => {
    // Only remove highlight when leaving the drop zone itself, not its children
    if (!dropZone.contains(e.relatedTarget as Node)) {
      dropZone.classList.remove('dragover');
    }
  });

  dropZone.addEventListener('drop', (e) => {
    e.preventDefault();
    e.stopPropagation();
    dropZone.classList.remove('dragover');

    const files = e.dataTransfer?.files;
    if (files && files.length > 0) {
      fileInput.files = files;
      handleFiles(files);
    }
  });

  // Remove file
  removeFileBtn.addEventListener('click', (e) => {
    e.stopPropagation();
    selectedFile = null;
    fileInput.value = '';
    uploadPlaceholder.style.display = 'block';
    uploadPreview.style.display = 'none';
    nameInput.value = '';
    slugInput.value = '';
  });

  // Handle file selection
  // One file keeps the single-file form (with the cropper); more become a batch.
  function handleFiles(files: FileList) {
    if (files.length === 1) {
      handleFile(files[0]);
      return;
    }
    selectedFile = null;
    selectedFiles = Array.from(files);
    uploadPlaceholder.style.display = 'none';
    uploadPreview.style.display = 'none';
    uploadBatch.style.display = 'block';
    batchHelp.style.display = 'block';
    showBatchAdjust();
    batchSummary.textContent = `${selectedFiles.length} files, ${formatFileSize(selectedFiles.reduce((n, f) => n + f.size, 0))}`;
    batchList.replaceChildren(
      ...selectedFiles.map((file) => {
        const li = document.createElement('li');
        const name = document.createElement('span');
        name.textContent = nameFor(file);
        const size = document.createElement('span');
        size.className = 'batch-size';
        size.textContent = formatFileSize(file.size);
        li.append(name, size);
        return li;
      }),
    );
    // Names come from the files, so the single name/slug fields step aside.
    if (nameGroup) nameGroup.style.display = 'none';
    if (slugGroup) slugGroup.style.display = 'none';
    nameInput.required = false;
    submitButton.textContent = `Upload ${selectedFiles.length} files`;
  }
  changeFilesBtn.addEventListener('click', (e) => {
    e.stopPropagation();
    selectedFiles = [];
    fileInput.value = '';
    uploadBatch.style.display = 'none';
    batchHelp.style.display = 'none';
    uploadPlaceholder.style.display = 'block';
    if (nameGroup) nameGroup.style.display = '';
    if (slugGroup) slugGroup.style.display = '';
    nameInput.required = true;
    submitButton.textContent = 'Upload Asset';
  });
  function nameFor(file: File): string {
    const fileName = file.name.replace(/\.[^/.]+$/, ''); // Remove extension
    return fileName.replace(/[-_]/g, ' ').replace(/\b\w/g, (l) => l.toUpperCase());
  }
  function handleFile(file: File) {
    // Auto-populate name from filename
    nameInput.value = nameFor(file);

    // Generate slug
    updateSlug();

    // Show cropper for raster images (skip SVGs — they're vector and shouldn't be rasterized)
    if (file.type.startsWith('image/') && file.type !== 'image/svg+xml') {
      try {
        const cropper = new (window as any).ImageCropper();
        cropper.show(file, (blob: Blob) => {
          selectedFile = new File([blob], file.name, { type: blob.type || 'image/jpeg' });
          showPreview(selectedFile);
        }, () => {
          selectedFile = file;
          showPreview(file);
        });
      } catch {
        selectedFile = file;
        showPreview(file);
      }
    } else {
      selectedFile = file;
      showPreview(file);
    }
  }

  function showPreview(file: File) {
    // Show preview
    uploadPlaceholder.style.display = 'none';
    uploadPreview.style.display = 'flex';

    // Create preview content
    if (file.type.startsWith('image/')) {
      const url = URL.createObjectURL(file);
      if (file.type === 'image/svg+xml') {
        previewContent.innerHTML = `<img src="${url}" alt="Preview" style="width:100%;height:200px;object-fit:contain;background:var(--panel-2);border-radius:6px;" />`;
      } else {
        previewContent.innerHTML = `<img src="${url}" alt="Preview" />`;
      }
    } else {
      // The file's name and type are text: a file can be named "<img src=x onerror=…>.txt".
      const line = (className: string, text: string) => {
        const p = document.createElement('p');
        p.className = className;
        p.textContent = text;
        return p;
      };
      const info = document.createElement('div');
      info.className = 'file-info';
      info.append(
        line('file-name', file.name),
        line('file-size', formatFileSize(file.size)),
        line('file-size', file.type || 'Unknown type'),
      );
      previewContent.replaceChildren(info);
    }
  }

  // Auto-generate slug from name
  nameInput.addEventListener('input', updateSlug);

  function updateSlug() {
    slugInput.value = slugify(nameInput.value);
  }
  function slugify(name: string): string {
    return name
      .toLowerCase()
      .trim()
      .replace(/[^\w\s-]/g, '')
      .replace(/[\s_-]+/g, '-')
      .replace(/^-+|-+$/g, '');
  }

  // Format file size
  function formatFileSize(bytes: number): string {
    if (bytes === 0) return '0 Bytes';
    const k = 1024;
    const sizes = ['Bytes', 'KB', 'MB', 'GB'];
    const i = Math.floor(Math.log(bytes) / Math.log(k));
    return Math.round(bytes / Math.pow(k, i) * 100) / 100 + ' ' + sizes[i];
  }

  // Form submission
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (selectedFiles.length > 1) {
      await uploadBatchFiles();
      return;
    }

    if (!selectedFile) {
      showError('Please select a file to upload');
      return;
    }

    // Hide error
    errorMessage.style.display = 'none';

    // Create FormData
    const formData = new FormData();
    formData.append('file', selectedFile);
    formData.append('slug', slugInput.value);
    formData.append('name', nameInput.value);

    const altText = (document.getElementById('alt_text') as HTMLInputElement).value;
    const description = (document.getElementById('description') as HTMLTextAreaElement).value;
    const metadata = (document.getElementById('metadata') as HTMLTextAreaElement).value;

    if (altText) formData.append('alt_text', altText);
    if (description) formData.append('description', description);
    if (metadata) {
      try {
        JSON.parse(metadata); // Validate JSON
        formData.append('metadata', metadata);
      } catch (e) {
        showError('Invalid JSON in metadata field');
        return;
      }
    }

    // Disable submit button and show progress
    submitButton.disabled = true;
    submitButton.textContent = 'Uploading...';
    progressContainer.style.display = 'block';

    // Prepare metadata for SDK
    const uploadData = {
      slug: slugInput.value,
      name: nameInput.value,
      altText: altText || undefined,
      description: description || undefined,
      metadata: metadata ? JSON.parse(metadata) : undefined,
    };

    try {

      // Use SDK to upload
      // Note: SDK uses fetch which doesn't support upload progress tracking
      // For a better UX, we simulate progress
      simulateProgress();

      const asset = await sdk.assets.upload(selectedFile, uploadData);

      // Clear progress simulation
      if (progressInterval) {
        clearInterval(progressInterval);
        progressInterval = null;
      }

      progressFill.style.width = '100%';
      progressText.textContent = 'Upload complete! Redirecting...';

      setTimeout(() => {
        window.location.href = '/workspace/assets';
      }, 1000);
    } catch (error: any) {
      if (progressInterval) { clearInterval(progressInterval); progressInterval = null; }
      // No connection (or a passing server error): keep it on this device and send it when the app is back online.
      if (isRetryable(error, navigator.onLine) && await queueUpload(selectedFile as File, uploadData, form.dataset.workspace ?? '')) {
        progressFill.style.width = '100%';
        progressText.textContent = "No connection — it's kept on this device and uploads when you're back online.";
        submitButton.textContent = 'Saved for later';
        return;
      }
      const message = error?.message || error?.detail || 'Upload failed';
      showError(message);
      resetForm();
    }
  });

  // A batch: one upload per file, in order, each named after its file. A file that fails is reported and the rest go
  // on; a slug the library already has gets a numbered one. No cropper, no offline queue — the single-file form has those.
  async function uploadBatchFiles() {
    errorMessage.style.display = 'none';
    const altText = (document.getElementById('alt_text') as HTMLInputElement).value;
    const description = (document.getElementById('description') as HTMLTextAreaElement).value;
    const metadataText = (document.getElementById('metadata') as HTMLTextAreaElement).value;
    let metadata: Record<string, unknown> | undefined;
    if (metadataText) {
      try {
        metadata = JSON.parse(metadataText);
      } catch {
        showError('Invalid JSON in metadata field');
        return;
      }
    }
    submitButton.disabled = true;
    changeFilesBtn.disabled = true;
    progressContainer.style.display = 'block';
    const total = selectedFiles.length;
    const taken = new Set<string>();
    const failed: Array<{ name: string; reason: string }> = [];
    let done = 0;
    const look = batchAdjustOn.checked ? rememberedAdjust() : null;
    const keepOriginals = !!look && batchKeepOn.checked;
    for (const file of selectedFiles) {
      const name = nameFor(file);
      progressText.textContent = `Uploading ${done + 1} of ${total}: ${name}`;
      const base = slugify(name) || 'file';
      // Distinct within the batch; a clash with an asset already in the library is retried with the next number.
      let n = 1;
      let slug = base;
      while (taken.has(slug)) slug = `${base}-${++n}`;
      const toSend = look ? await adjusted(file, look.filter) : file;
      // An adjusted picture is a smaller copy: the file as picked goes up too, once, with a stamped slug of its own, and the copy is
      // recorded as made from it, the way the field's upload dialog does, so an archive keeps its full-size photo.
      let lineage: Record<string, unknown> | undefined;
      if (keepOriginals && toSend !== file) {
        try {
          const original = await sdk.assets.upload(file, { slug: `${base}-original-${Date.now().toString(36)}`, name: `${name} (original)`, altText: altText || undefined, description: description || undefined, metadata });
          lineage = { derived_from: (original as { id: string }).id, derivation: 'edited:batch' };
        } catch (error: any) {
          failed.push({ name: `${file.name} (original)`, reason: error?.message || error?.detail || 'Upload failed' });
          done += 1;
          progressFill.style.width = `${Math.round((done / total) * 100)}%`;
          continue;
        }
      }
      let tries = 0;
      while (true) {
        try {
          await sdk.assets.upload(toSend, { slug, name, altText: altText || undefined, description: description || undefined, metadata: lineage ? { ...(metadata ?? {}), ...lineage } : metadata });
          taken.add(slug);
          break;
        } catch (error: any) {
          const message: string = error?.message || error?.detail || 'Upload failed';
          const slugTaken = error?.status === 409 || /slug|409|conflict|exist/i.test(message);
          if (slugTaken && ++tries < 5) {
            slug = `${base}-${++n}`;
            continue;
          }
          failed.push({ name: file.name, reason: message });
          break;
        }
      }
      done += 1;
      progressFill.style.width = `${Math.round((done / total) * 100)}%`;
    }
    if (failed.length === 0) {
      progressText.textContent = `${total} uploaded. Opening the library…`;
      setTimeout(() => {
        window.location.href = '/workspace/assets';
      }, 800);
      return;
    }
    progressText.textContent = `${total - failed.length} of ${total} uploaded.`;
    const list = document.createElement('ul');
    for (const f of failed) {
      const li = document.createElement('li');
      li.textContent = `${f.name}: ${f.reason}`;
      list.append(li);
    }
    errorMessage.replaceChildren(document.createTextNode('Could not upload:'), list);
    errorMessage.style.display = 'block';
    submitButton.textContent = 'Open the library';
    submitButton.disabled = false;
    submitButton.type = 'button';
    submitButton.addEventListener('click', () => {
      window.location.href = '/workspace/assets';
    });
  }
  // Simulate upload progress (since fetch doesn't support progress tracking)
  function simulateProgress() {
    let progress = 0;
    progressInterval = setInterval(() => {
      progress += Math.random() * 15;
      if (progress > 90) {
        if (progressInterval) clearInterval(progressInterval);
        progress = 90;
      }
      progressFill.style.width = progress + '%';
      progressText.textContent = `Uploading... ${Math.round(progress)}%`;
    }, 200) as unknown as number;
  }

  function showError(message: string) {
    errorMessage.textContent = message;
    errorMessage.style.display = 'block';
  }

  function resetForm() {
    if (progressInterval) {
      clearInterval(progressInterval);
      progressInterval = null;
    }
    submitButton.disabled = false;
    submitButton.textContent = 'Upload Asset';
    progressContainer.style.display = 'none';
    progressFill.style.width = '0%';
  }
</script>
