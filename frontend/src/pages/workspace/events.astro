---
import AppLayout from "@/layouts/AppLayout.astro";
import { getAuditSettings, getExcludedEventTypes } from "@/lib/api/auditSettings";
import { fetchApi, getAuthToken } from "@/lib/api/client";
import {
  type AuditEventSetting,
  type AuditExcludedEvent,
  excludedSummary,
  groupByCategory,
  isOverridden,
  searchText,
} from "@/lib/auditSettings";
import { entityLink, entityTypeLabel } from "@/lib/eventEntity";
import { isForbidden } from "@/lib/workspaceRole";

const authToken = getAuthToken(Astro.cookies);
const authed = !!authToken;

let events: any[] = [];
let error: string | null = null;

if (authed) {
  try {
    events = await fetchApi<any[]>("/api/platform/events?limit=100", {}, authToken);
  } catch (e) {
    error = e instanceof Error ? e.message : String(e);
    console.error("[events] Failed to load:", error);
  }
}

// Audit coverage: admins get every type's setting (and can change it); everyone else the types left out.
let auditSettings: AuditEventSetting[] | null = null;
let auditExcluded: AuditExcludedEvent[] = [];
let auditError: string | null = null;

if (authed && !error) {
  try {
    auditSettings = await getAuditSettings(authToken);
    auditExcluded = auditSettings.filter((s) => !s.audited);
  } catch (e) {
    if (isForbidden(e)) {
      try {
        auditExcluded = await getExcludedEventTypes(authToken);
      } catch (e2) {
        auditError = e2 instanceof Error ? e2.message : String(e2);
      }
    } else {
      auditError = e instanceof Error ? e.message : String(e);
    }
  }
  if (auditError) console.error("[events] Failed to load audit settings:", auditError);
}
const auditGroups = auditSettings ? groupByCategory(auditSettings) : [];

function fld(row: any, camel: string, snake: string) {
  return row[camel] ?? row[snake];
}

function formatDate(isoStr: string): string {
  if (!isoStr) return "—";
  const normalized = isoStr.replace(/(\.\d{3})\d+/, "$1");
  const d = new Date(normalized);
  return Number.isNaN(d.getTime()) ? isoStr : d.toLocaleString();
}

// Legacy rows stored the enum ordinal; new rows store the name. Prettify both.
function prettyType(t: any): string {
  const s = String(t ?? "");
  if (/^\d+$/.test(s)) return `event #${s}`;
  return s.replace(/[._]/g, " ");
}

// Derive a coarse outcome status from the event type + title. Uses message_title too, so it
// still works for legacy numeric-coded rows. Order matters: check failed, then removed (so
// "unpublished" isn't caught by "publish"), then success.
function statusOf(eventType: any, title: any): string {
  const s = `${eventType ?? ""} ${title ?? ""}`.toLowerCase();
  if (/fail|error|denied|reject|quota|exceed/.test(s)) return "failed";
  if (/delet|remov|revok|unpublish|archiv|cancel|expir/.test(s)) return "removed";
  if (/complet|success|execut|publish|reindex|creat|upload|added|accept|activ|sent|restor|approv/.test(s))
    return "success";
  return "info";
}
const STATUS_ORDER = ["failed", "success", "removed", "info"];
const STATUS_LABEL: Record<string, string> = { failed: "Failed", success: "Success", removed: "Removed", info: "Info" };

// Distinct entity types present, for the filter chips.
const entityTypes = Array.from(new Set(events.map((e) => fld(e, "entityType", "entity_type")).filter(Boolean))).sort();

// Statuses actually present (fixed order), for the status filter chips.
const presentStatuses = STATUS_ORDER.filter((st) =>
  events.some((e) => statusOf(fld(e, "eventType", "event_type"), fld(e, "messageTitle", "message_title")) === st),
);
---

<AppLayout crumb="automation.event-log">
  <div class="page-header">
    <h2>Event Log</h2>
    <p>
      The workspace audit trail: publishes, uploads, members, workflows, AI runs and more. Platform events, such as
      sign-ups and workspaces created by a platform admin, aren't listed here; platform admins find them under
      Admin → Operations → Events.
    </p>
  </div>

  {!authed ? (
    <div class="alert alert-error"><strong>Authentication required.</strong> Sign in to view the event log.</div>
  ) : error ? (
    <div class="alert alert-error"><strong>Error:</strong> {error}</div>
  ) : (
    <>
      <details class="audit-coverage" id="audit-coverage">
        <summary>
          <span class="ac-caret">▶</span>
          <span class="ac-title">Audit coverage</span>
          {!auditError && <span class="ac-sub" id="ac-summary">{excludedSummary(auditExcluded.length)}</span>}
        </summary>
        <div class="ac-body">
          {auditError ? (
            <p class="ac-note ac-error">Couldn't load the audit settings: {auditError}</p>
          ) : auditSettings ? (
            <>
              <p class="ac-lead">
                Choose which event types this log records. A type switched off is not written to the log at all, so
                its events can't be found here later. Security events (members and invitations, API clients and their
                tokens, secrets, workspace settings and approvals) are always recorded, and so is every change made
                here.
              </p>
              <div class="ac-tools">
                <input id="ac-filter" class="search ac-filter" type="search" placeholder="Filter event types…" aria-label="Filter event types" />
                <span id="ac-status" class="ac-status" role="status" aria-live="polite"></span>
              </div>
              {auditGroups.map((group) => (
                <section class="ac-group" data-ac-group>
                  <h3 class="ac-group-title">{group.category}</h3>
                  <ul class="ac-rows">
                    {group.rows.map((row) => (
                      <li
                        class="ac-row"
                        data-ac-row
                        data-event-type={row.eventType}
                        data-default={String(row.defaultAudited)}
                        data-search={searchText(row)}
                      >
                        <span class="ac-name">
                          <span class="ac-label">{row.name}</span>
                          <code>{row.eventType}</code>
                        </span>
                        <span class="ac-state">
                          {row.locked ? (
                            <span class="ac-lock" title="A security event: always recorded">Always recorded</span>
                          ) : (
                            <>
                              <span class="ac-default">Default {row.defaultAudited ? "on" : "off"}</span>
                              <button type="button" class="ac-reset" data-ac-reset hidden={!isOverridden(row)}>Reset to default</button>
                              <label class="switch" title={row.audited ? "Recorded" : "Not recorded"}>
                                <input type="checkbox" role="switch" data-ac-switch checked={row.audited} aria-label={`Record ${row.name}`} />
                                <span class="track"></span>
                              </label>
                            </>
                          )}
                        </span>
                      </li>
                    ))}
                  </ul>
                </section>
              ))}
              <p class="ac-note" id="ac-empty" hidden>No event types match the filter.</p>
            </>
          ) : (
            <>
              {auditExcluded.length > 0 ? (
                <>
                  <p class="ac-lead">These event types are not recorded, so they never appear in this log:</p>
                  <div class="ac-chips">
                    {auditExcluded.map((e) => (
                      <span class="ac-chip">
                        <span class="status-dot s-audit-off"></span>
                        <code>{e.eventType}</code>
                        <span class="ac-chip-label">{e.name}</span>
                      </span>
                    ))}
                  </div>
                </>
              ) : (
                <p class="ac-lead">Every event type is recorded.</p>
              )}
              <p class="ac-note">A workspace admin chooses what this log records. Security events are always recorded.</p>
            </>
          )}
        </div>
      </details>
      {events.length === 0 ? (
        <div class="empty-state">
          <div class="empty-icon">🗂️</div>
          <p class="empty-title">No events yet</p>
          <p class="empty-desc">Workspace activity will appear here as it happens</p>
        </div>
      ) : (
        <>
          <div class="controls">
            <input id="event-search" class="search" type="search" placeholder="Filter by message or type…" />
            <div class="chips" id="status-chips">
              <button class="chip active" data-status="">All</button>
              {presentStatuses.map((st) => (
                <button class="chip" data-status={st}><span class={`status-dot s-${st}`}></span>{STATUS_LABEL[st]}</button>
              ))}
            </div>
            <div class="chips" id="entity-chips">
              <button class="chip active" data-entity="">All</button>
              {entityTypes.map((t) => <button class="chip" data-entity={t}>{entityTypeLabel(t)}</button>)}
            </div>
          </div>


          <div class="table-wrap">
            <table class="log-table">
              <thead>
                <tr>
                  <th></th>
                  <th>When</th>
                  <th>Status</th>
                  <th>Event</th>
                  <th>Details</th>
                  <th>Entity</th>
                </tr>
              </thead>
              <tbody>
                {events.map((ev: any, i: number) => {
                  const eventId = fld(ev, 'eventId', 'event_id');
                  const eventType = fld(ev, 'eventType', 'event_type');
                  const occurredAt = fld(ev, 'occurredAt', 'occurred_at');
                  const entityType = fld(ev, 'entityType', 'entity_type');
                  const entityId = fld(ev, 'entityId', 'entity_id');
                  const subject = entityLink(entityType, entityId);
                  // A workflow run also names what triggered it (the entry, the incoming webhook, …).
                  const related = entityLink(
                    fld(ev, 'relatedEntityType', 'related_entity_type'),
                    fld(ev, 'relatedEntityId', 'related_entity_id'),
                    fld(ev, 'relatedEntityLabel', 'related_entity_label'),
                  );
                  const title = fld(ev, 'messageTitle', 'message_title');
                  const body = fld(ev, 'messageBody', 'message_body');
                  const isLegacyType = /^\d+$/.test(String(eventType ?? ''));
                  const status = statusOf(eventType, title);
                  const search = `${title ?? ''} ${body ?? ''} ${isLegacyType ? '' : prettyType(eventType)} ${subject?.label ?? ''} ${related?.label ?? ''}`.toLowerCase();
                  return (
                    <>
                      <tr class="log-row" data-search={search} data-entity={entityType ?? ''} data-status={status}>
                        <td class="expand-cell">
                          <button class="expand-btn" data-target={`detail-${i}`} data-event-id={eventId}>▶</button>
                        </td>
                        <td class="nowrap muted">{formatDate(occurredAt)}</td>
                        <td class="nowrap">
                          <span class={`status-pill s-${status}`}>
                            <span class={`status-dot s-${status}`}></span>
                            {STATUS_LABEL[status]}
                          </span>
                        </td>
                        <td>
                          <span class="event-cell">
                            <span class="event-head">
                              <span class="event-title">{title}</span>
                            </span>
                            {!isLegacyType && <code class="ev-badge">{prettyType(eventType)}</code>}
                          </span>
                        </td>
                        <td class="detail-col">{body || '—'}</td>
                        <td class="nowrap">
                          {subject ? (
                            <span class="entity-cell">
                              {subject.href ? (
                                <a class="entity-type entity-link" href={subject.href}>{subject.label}</a>
                              ) : (
                                <span class="entity-type">{subject.label}</span>
                              )}
                              {subject.shortId && <span class="entity-id">{subject.shortId}</span>}
                              {related && (
                                <span class="entity-related">
                                  from{' '}
                                  {related.href ? <a class="entity-link" href={related.href}>{related.label}</a> : related.label}
                                </span>
                              )}
                            </span>
                          ) : <span class="muted">—</span>}
                        </td>
                      </tr>
                      <tr class="detail-row" id={`detail-${i}`} style="display:none">
                        <td colspan="6">
                          <div class="detail-body">
                            <div class="detail-section">
                              <div class="detail-label">Payload</div>
                              <pre class="payload-json" data-payload-for={eventId}>Loading…</pre>
                            </div>
                          </div>
                        </td>
                      </tr>
                    </>
                  );
                })}
              </tbody>
            </table>
          </div>
          <p class="count-note" id="count-note">{events.length} most recent event{events.length === 1 ? '' : 's'}</p>
        </>
      )}
    </>
  )}
</AppLayout>

<script>
  import { updateAuditSettings } from '@/lib/api/auditSettings';
  import { fetchApi } from '@/lib/api/client';
  import { type AuditEventSetting, excludedSummary, isOverridden, matchesFilter, overrideFor } from '@/lib/auditSettings';

  const loaded = new Set<string>();

  // Tiny USD amounts (e.g. AI cost) serialize as scientific notation (5.175e-05) in the raw
  // payload. Render cost fields as friendly dollars for display without touching stored values.
  const COST_KEYS = new Set(['estimatedCostUsd', 'estimated_cost_usd']);

  function formatCostUsd(value: number): string {
    if (value === 0) return '$0.00';
    return value < 0.01 ? `$${value.toFixed(4)}` : `$${value.toFixed(2)}`;
  }

  function humanizePayload(node: any): any {
    if (Array.isArray(node)) return node.map(humanizePayload);
    if (node && typeof node === 'object') {
      const out: Record<string, any> = {};
      for (const [key, val] of Object.entries(node)) {
        out[key] =
          COST_KEYS.has(key) && typeof val === 'number' && isFinite(val)
            ? formatCostUsd(val)
            : humanizePayload(val);
      }
      return out;
    }
    return node;
  }

  // Expand / collapse + lazy-load full payload
  document.querySelectorAll('.expand-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const el = btn as HTMLElement;
      const row = document.getElementById(el.dataset.target!);
      if (!row) return;
      const open = row.style.display !== 'none';
      row.style.display = open ? 'none' : 'table-row';
      el.textContent = open ? '▶' : '▼';

      const eventId = el.dataset.eventId!;
      if (open || loaded.has(eventId)) return;
      loaded.add(eventId);
      const pre = document.querySelector<HTMLElement>(`[data-payload-for="${eventId}"]`);
      if (!pre) return;
      try {
        const full = await fetchApi<any>(`/api/platform/events/${eventId}`);
        const payload = full?.eventData ?? full?.event_data ?? full;
        pre.textContent = JSON.stringify(humanizePayload(payload), null, 2);
      } catch (e: any) {
        pre.textContent = `Failed to load payload: ${e.message}`;
      }
    });
  });

  // Text + entity-type filtering (client-side over the loaded page)
  const search = document.getElementById('event-search') as HTMLInputElement | null;
  const entityChips = Array.from(document.querySelectorAll<HTMLElement>('#entity-chips .chip'));
  const statusChips = Array.from(document.querySelectorAll<HTMLElement>('#status-chips .chip'));
  const rows = Array.from(document.querySelectorAll<HTMLElement>('tr.log-row'));
  const countNote = document.getElementById('count-note');
  let activeEntity = '';
  let activeStatus = '';

  function applyFilters() {
    const q = (search?.value || '').trim().toLowerCase();
    let shown = 0;
    rows.forEach((row) => {
      const matchText = !q || (row.dataset.search || '').includes(q);
      const matchEntity = !activeEntity || row.dataset.entity === activeEntity;
      const matchStatus = !activeStatus || row.dataset.status === activeStatus;
      const visible = matchText && matchEntity && matchStatus;
      row.style.display = visible ? '' : 'none';
      // Collapse any open detail row when its parent is hidden
      const detail = row.nextElementSibling as HTMLElement | null;
      if (detail?.classList.contains('detail-row') && !visible) detail.style.display = 'none';
      if (visible) shown++;
    });
    if (countNote) countNote.textContent = `${shown} event${shown === 1 ? '' : 's'} shown`;
  }

  function wireChips(chips: HTMLElement[], onPick: (v: string) => void) {
    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        chips.forEach((c) => c.classList.remove('active'));
        chip.classList.add('active');
        onPick(chip.dataset.status ?? chip.dataset.entity ?? '');
        applyFilters();
      });
    });
  }

  search?.addEventListener('input', applyFilters);
  wireChips(statusChips, (v) => { activeStatus = v; });
  wireChips(entityChips, (v) => { activeEntity = v; });

  // ---- Audit coverage (admins): a switch per event type, saved one change at a time. The server's answer
  // (every type's setting) is the truth the rows are set back to; nothing it sends is rendered as HTML.
  const acRows = Array.from(document.querySelectorAll<HTMLElement>('[data-ac-row]'));
  const acGroups = Array.from(document.querySelectorAll<HTMLElement>('[data-ac-group]'));
  const acFilter = document.getElementById('ac-filter') as HTMLInputElement | null;
  const acStatus = document.getElementById('ac-status');
  const acSummary = document.getElementById('ac-summary');
  const acEmpty = document.getElementById('ac-empty');

  function acSay(message: string, ok = true) {
    if (!acStatus) return;
    acStatus.textContent = message;
    acStatus.classList.toggle('is-error', !ok);
  }

  function acErrorMessage(e: unknown): string {
    const detail = (e as { body?: { detail?: unknown } } | null)?.body?.detail;
    if (typeof detail === 'string') return detail;
    return e instanceof Error ? e.message : 'Something went wrong.';
  }

  function acApply(settings: AuditEventSetting[]) {
    const byType = new Map(settings.map((s) => [s.eventType, s]));
    for (const row of acRows) {
      const setting = byType.get(row.dataset.eventType ?? '');
      const box = row.querySelector<HTMLInputElement>('[data-ac-switch]');
      const reset = row.querySelector<HTMLButtonElement>('[data-ac-reset]');
      if (!setting || !box) continue;
      box.checked = setting.audited;
      box.closest('label')?.setAttribute('title', setting.audited ? 'Recorded' : 'Not recorded');
      if (reset) reset.hidden = !isOverridden(setting);
    }
    if (acSummary) acSummary.textContent = excludedSummary(settings.filter((s) => !s.audited).length);
  }

  async function acSave(row: HTMLElement, value: boolean | null, label: string) {
    const eventType = row.dataset.eventType!;
    const controls = Array.from(row.querySelectorAll<HTMLInputElement | HTMLButtonElement>('input, button'));
    controls.forEach((c) => { c.disabled = true; });
    try {
      acApply(await updateAuditSettings({ [eventType]: value }));
      acSay(label);
    } catch (e) {
      const box = row.querySelector<HTMLInputElement>('[data-ac-switch]');
      if (box && value !== null) box.checked = !value; // put the switch back
      acSay(acErrorMessage(e), false);
    } finally {
      controls.forEach((c) => { c.disabled = false; });
    }
  }

  for (const row of acRows) {
    const name = row.querySelector('.ac-label')?.textContent ?? row.dataset.eventType ?? '';
    const box = row.querySelector<HTMLInputElement>('[data-ac-switch]');
    box?.addEventListener('change', () => {
      const audited = box.checked;
      acSave(row, overrideFor({ defaultAudited: row.dataset.default === 'true' }, audited), `${name}: ${audited ? 'recorded' : 'not recorded'}.`);
    });
    row.querySelector<HTMLButtonElement>('[data-ac-reset]')?.addEventListener('click', () => {
      acSave(row, null, `${name}: back to the default.`);
    });
  }

  acFilter?.addEventListener('input', () => {
    const query = acFilter.value;
    let shown = 0;
    for (const row of acRows) {
      row.hidden = !matchesFilter(row.dataset.search ?? '', query);
      if (!row.hidden) shown++;
    }
    for (const group of acGroups) group.hidden = !group.querySelector('[data-ac-row]:not([hidden])');
    if (acEmpty) acEmpty.hidden = shown > 0;
  });
</script>

<style>
  .page-header {
    margin-bottom: 24px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--line);
  }

  .page-header h2 { margin: 0 0 8px; font-size: 24px; font-weight: 600; }
  .page-header p { margin: 0; color: var(--muted); font-size: 14px; }

  .alert {
    padding: 16px;
    margin-bottom: 24px;
    border-radius: var(--radius);
    background: var(--color-error-bg);
    color: var(--color-error);
    border: 1px solid var(--color-error);
  }

  .empty-state { padding: 80px 24px; text-align: center; }
  .empty-icon { font-size: 48px; margin-bottom: 16px; opacity: 0.3; }
  .empty-title { margin: 0 0 8px; font-size: 18px; font-weight: 600; }
  .empty-desc { margin: 0; color: var(--muted); font-size: 14px; }

  .controls {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 16px;
    flex-wrap: wrap;
  }

  .search {
    flex: 1;
    min-width: 220px;
    padding: 9px 12px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    font-size: 14px;
    background: var(--bg);
    color: var(--ink);
  }

  .search:focus { border-color: var(--accent); outline: none; }

  .chips { display: flex; gap: 6px; flex-wrap: wrap; }

  .chip {
    padding: 6px 12px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 500;
    text-transform: capitalize;
    cursor: pointer;
    color: var(--muted);
    border: 1px solid var(--line);
    background: var(--panel);
    transition: all 0.15s;
  }

  .chip:hover { color: var(--ink); border-color: var(--ink); }
  .chip.active { background: var(--ink); color: var(--bg); border-color: var(--ink); }

  .table-wrap { overflow-x: auto; }

  .log-table { width: 100%; border-collapse: collapse; font-size: 14px; }

  .log-table th {
    text-align: left;
    padding: 10px 12px;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--muted);
    border-bottom: 2px solid var(--line);
    white-space: nowrap;
  }

  .log-table td {
    padding: 10px 12px;
    border-bottom: 1px solid var(--line);
    vertical-align: middle;
  }

  .log-row:hover td { background: var(--panel); }

  .expand-cell { width: 32px; padding: 10px 6px 10px 12px; }

  .expand-btn {
    background: none;
    border: none;
    cursor: pointer;
    color: var(--muted);
    font-size: 11px;
    padding: 2px 4px;
    border-radius: 3px;
  }

  .expand-btn:hover { background: var(--line); color: var(--ink); }

  .detail-row td { padding: 0; border-bottom: 1px solid var(--line); }

  .detail-body {
    padding: 16px 16px 16px 52px;
    background: var(--panel);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .detail-section { display: flex; flex-direction: column; gap: 4px; }

  .detail-label {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    color: var(--muted);
  }

  .detail-message { font-size: 13px; color: var(--ink); }

  .payload-json {
    font-size: 12px;
    font-family: ui-monospace, monospace;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 12px;
    margin: 0;
    overflow-x: auto;
    max-height: 400px;
    overflow-y: auto;
    white-space: pre;
    color: var(--ink);
  }

  .nowrap { white-space: nowrap; }
  .muted { color: var(--muted); }

  .ev-badge {
    font-size: 12px;
    font-family: ui-monospace, monospace;
    background: var(--panel);
    border: 1px solid var(--line);
    padding: 2px 8px;
    border-radius: 4px;
    color: var(--ink);
    white-space: nowrap;
  }

  .event-cell { display: flex; flex-direction: column; gap: 3px; align-items: flex-start; }
  .event-head { display: flex; align-items: center; gap: 8px; }
  .event-title { font-size: 14px; color: var(--ink); font-weight: 500; }
  .detail-col { color: var(--muted); font-size: 13px; max-width: 520px; }

  /* Outcome status dot (also used inside the status filter chips) */
  .status-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; display: inline-block; }
  .chip .status-dot { margin-right: 6px; vertical-align: middle; }
