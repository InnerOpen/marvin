---
// Settings → Workers: the queue of heavy jobs handed to workers, and whether anything is watching it. Read from the workspace's own
// records (`job`, `job-kind`, and a dispatcher's `worker` heartbeat; see lib/workers.ts), so it shows nothing until a workspace has them.
import AppLayout from "@/layouts/AppLayout.astro";
import { fetchApi, getAuthToken } from "@/lib/api/client";
import { getBrowserApiBaseUrl } from "@/lib/api/config";
import { getCurrentWorkspace } from "@/lib/api/workspaces";
import { runGuide } from "@/lib/workerCommands";
import { ago, type TypeShape, type RecordRow, STATUSES, summarize, workerSetup } from "@/lib/workers";

const authToken = getAuthToken(Astro.cookies);
type Found = { entries: RecordRow[] };
const find = (spec: Record<string, unknown>, limit: number): Promise<RecordRow[]> =>
  fetchApi<Found>("/api/platform/entries/query", { method: "POST", body: JSON.stringify({ spec, limit }) }, authToken)
    .then((r) => r.entries ?? [])
    .catch(() => []);

let error: string | null = null;
let jobs: RecordRow[] = [];
let kinds: RecordRow[] = [];
let workers: RecordRow[] = [];
let missing: string[] = [];
let misfit: { slug: string; lacks: string[] }[] = [];
if (!authToken) {
  error = "Authentication required";
} else {
  // Without the three record types a worker cannot register or take a job, so say so first. If the list cannot be read, say nothing.
  const types = await fetchApi<TypeShape[]>("/api/platform/entry-types", {}, authToken).catch(() => null);
  if (types) ({ missing, misfit } = workerSetup(types));
  [jobs, kinds, workers] = await Promise.all([
    find({ entry_type: "job", sort: { by: "created_at", direction: "desc" } }, 40),
    find({ entry_type: "job-kind" }, 100),
    find({ entry_type: "worker" }, 20),
  ]);
}
let workspaceSlug = "<workspace-slug>";
try {
  if (authToken) workspaceSlug = (await getCurrentWorkspace(authToken)).slug || workspaceSlug;
} catch {
  /* the placeholder stays */
}
const guide = runGuide(getBrowserApiBaseUrl(), workspaceSlug);
const view = summarize(jobs, kinds, workers);
const busy = view.counts.queued + view.counts.claimed + view.counts.running > 0;
const entryHref = (id: string) => `/workspace/entries/${id}?return=${encodeURIComponent(Astro.url.pathname)}`;
---

<AppLayout crumb="settings.workers">
  <div class="toolbar">
    <div>
      <h2>Workers</h2>
      <p class="sub">Heavy jobs (anything that needs a binary tool or a long run) are queued here and picked up by a worker, either a runner that has the capability or a dispatcher that starts one for each job.</p>
    </div>
  </div>

  {error && <div class="alert error">{error}</div>}

  {misfit.length > 0 && (
    <section class="card setup" data-testid="workers-misfit">
      <h3>These record types are not the ones workers use</h3>
      <p>
        This workspace already has {misfit.length === 1 ? "a record type" : "record types"} named
        {misfit.map((m, i) => <>{i ? ", " : " "}<strong>{m.slug}</strong></>)}, but {misfit.length === 1 ? "it does" : "they do"} not have the fields workers read
        and write, so a worker could not register or take a job. Marvin leaves them as they are.
      </p>
      <ul>
        {misfit.map((m) => <li><strong>{m.slug}</strong> lacks {m.lacks.map((key, i) => <>{i ? ", " : ""}<code>{key}</code></>)}</li>)}
      </ul>
      <p>Rename the existing type (its slug is what matters) and add the rest here, or add those fields to it if it is meant to be the same thing.</p>
    </section>
  )}

  {missing.length > 0 && (
    <section class="card setup" data-testid="workers-setup">
      <h3>Set up workers</h3>
      <p>
        Workers need three kinds of record in this workspace: <strong>job</strong> (a task to run), <strong>job-kind</strong> (where each kind of job
        runs) and <strong>worker</strong> (a runner's or dispatcher's heartbeat). {missing.length === 3 ? "None are here yet." : `Missing: ${missing.join(", ")}.`}
        Adding them creates only what is missing and never changes what you already have.
      </p>
      <button type="button" class="button" id="workers-setup-button">Add them</button>
      <span class="muted" id="workers-setup-note" role="status"></span>
    </section>
  )}

  {view.warnings.map((w) => <div class="alert warn" role="status">{w}</div>)}

  <section class="card" data-testid="run-worker">
    <h3>Run a worker</h3>
    <p class="muted roles">Pick how you want it to run. Each shows the commands for this Marvin and workspace; the token is never filled in for you.</p>
    {guide.first.map((b) => (
      <>
        <p class="step">{b.label}</p>
        <div class="cmd"><pre><code>{b.code}</code></pre><button type="button" class="copy" data-copy={b.code}>Copy</button></div>
      </>
    ))}
    {guide.options.map((o) => (
      <details class="how" data-option={o.id}>
        <summary>{o.title}</summary>
        <p class="muted roles">{o.blurb}</p>
        {o.blocks.map((b) => (
          <>
            <p class="step">{b.label}</p>
            <div class="cmd"><pre><code>{b.code}</code></pre><button type="button" class="copy" data-copy={b.code}>Copy</button></div>
          </>
        ))}
      </details>
    ))}
  </section>

  <section class="card" data-testid="workers">
    <h3>Workers</h3>
    <p class="muted roles">
      A <strong>runner</strong> stays up, asks Marvin for jobs it can do, and does them itself. A <strong>dispatcher</strong> stays up and starts a fresh
      container or Kubernetes Job for each queued job, which ends when the job does. A grey dot means it is not running.
    </p>
    {view.workers.length === 0 ? (
      <p class="empty">No dispatcher or runner has reported yet.</p>
    ) : (
      <div class="image-groups">
        {view.groups.map((g) => (
          <div class="image-group" data-image={g.key}>
            <h4 class="image-head">
              <strong>{g.title}</strong>
              {g.revisions.length === 1 && <span class="muted">build {g.revisions[0]}</span>}
              {g.revisions.length > 1 && <span class="muted">mixed builds: {g.revisions.join(", ")}</span>}
              <span class="pill">{g.workers.length} {g.workers.length === 1 ? "worker" : "workers"}{g.running !== g.workers.length ? `, ${g.running} running` : ""}</span>
              {g.alsoRunning.length > 0 && <span class="pill warn" title="Another release of this image is running on other workers">also running {g.alsoRunning.join(", ")}</span>}
            </h4>
            <ul class="workers">
              {g.workers.map((w) => (
                <li>
                  <span class={`dot ${w.healthy ? "ok" : "off"}`} aria-hidden="true"></span>
                  <strong>{w.name}</strong>
                  <span class="pill">{w.role}</span>
                  <span class="muted">
                    {w.healthy ? w.status : "not running"} · last seen {ago(w.lastSeenAgo)} ago
                    {w.currentJob ? ` · on ${w.currentJob}` : ""}
                    {w.modes ? ` · starts ${w.modes}` : ""}
                    {w.tags ? ` · has ${w.tags}` : ""}
                    {w.jobsDone !== null ? ` · ${w.jobsDone} done` : ""}
                    {g.revisions.length > 1 && w.revision ? ` · build ${w.revision}` : ""}
                  </span>
                  {w.kinds.length > 0 && <span class="kind-list">{w.kinds.map((k) => <span class="pill">{k}</span>)}</span>}
                  {!w.healthy && (
                    <button type="button" class="button tiny secondary js-remove-worker" data-id={w.id} data-name={w.name}>Remove</button>
                  )}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    )}
  </section>

  <section class="card" data-testid="capabilities">
    <h3>What they can do</h3>
    {view.capabilities.length === 0 ? (
      <p class="empty">Nothing advertised yet. A worker lists the kinds it can do, and what each one takes, when it reports in.</p>
    ) : (
      <div class="table-wrap"><table class="stack">
        <thead><tr><th>Kind</th><th>Takes</th><th>Gives</th><th>Needs</th><th>Offered by</th></tr></thead>
        <tbody>
          {view.capabilities.map((c) => (
            <tr>
              <td data-label="Kind" class="long"><strong>{c.kind}</strong>{c.description && <div class="muted small">{c.description}</div>}</td>
              <td data-label="Takes" class="long">
                {c.inputs.length === 0 ? <span class="muted">—</span> : (
                  <ul class="inputs">
                    {c.inputs.map((i) => (
                      <li title={i.description}>
                        <code>{i.name}</code>
                        <span class="muted"> {i.type}{i.accepts.length ? ` (${i.accepts.join(", ")})` : ""}{i.required ? "" : ", optional"}</span>
                      </li>
                    ))}
                  </ul>
                )}
                {c.accepts.length > 0 && <div class="muted small">files: {c.accepts.join(", ")}</div>}
              </td>
              <td data-label="Gives" class="muted">{c.produces.join(", ") || "—"}</td>
              <td data-label="Needs" class="muted">{c.needs.join(", ") || "—"}</td>
              <td data-label="Offered by">{c.offeredBy.length ? c.offeredBy.join(", ") : <span class="muted">nobody running</span>}</td>
            </tr>
          ))}
        </tbody>
      </table></div>
    )}
  </section>

  <section class="card">
    <h3>Jobs</h3>
    <p class="counts">
      {STATUSES.map((s) => <span class={`pill s-${s}`}>{view.counts[s] ?? 0} {s}</span>)}
    </p>
    {view.jobs.length === 0 ? (
      <p class="empty">No jobs yet. A workflow queues one by creating a <code>job</code> entry.</p>
    ) : (
      <div class="table-wrap"><table class="stack">
        <thead><tr><th>Job</th><th>Kind</th><th>Status</th><th>Queued</th><th>What happened</th></tr></thead>
        <tbody>
          {view.jobs.map((j) => {
            // A long log gets its own row under the job, across the whole card; a short one stays in the cell.
            const long = j.log.length > 120 || j.log.includes("\n");
            const tone = j.status === "failed" ? "bad-text" : "";
            return (
              <>
                <tr class={long ? "has-log" : ""}>
                  <td data-label="Job"><a href={entryHref(j.id)}>{j.title}</a></td>
                  <td data-label="Kind">{j.kind}</td>
                  <td data-label="Status"><span class={`pill s-${j.status}`}>{j.status}</span>{j.stuck && <span class="flag" title="Past the time allowed with no outcome"> stuck</span>}{j.unknownKind && <span class="flag" title="No job kind is registered for this"> no such kind</span>}</td>
                  <td data-label="Queued" class="muted">{ago(j.queuedAgo)} ago</td>
                  <td data-label="What happened" class="log">
                    {j.resultUrl && <a href={j.resultUrl} target="_blank" rel="noopener">Open the result</a>}
                    {j.log && <span class={tone}>{long ? `${j.log.split("\n")[0].slice(0, 120)}…` : j.log}</span>}
                  </td>
                </tr>
                {long && (
                  <tr class="log-row">
                    <td colspan="5" class="long">
                      <details>
                        <summary class={tone}>Full log</summary>
                        <pre class="log-full"><code>{j.log}</code></pre>
                      </details>
                    </td>
                  </tr>
                )}
              </>
            );
          })}
        </tbody>
      </table></div>
    )}
  </section>

  <section class="card">
    <h3>Job kinds</h3>
    {view.kinds.length === 0 ? (
      <p class="empty">No job kinds yet. A <code>job-kind</code> entry says which image runs a kind of job, how it is started and how long it may take.</p>
    ) : (
      <div class="table-wrap"><table class="stack">
        <thead><tr><th>Kind</th><th>Started by</th><th>Image or worker</th><th>Time allowed</th></tr></thead>
        <tbody>
          {view.kinds.map((k) => (
            <tr>
              <td data-label="Kind">{k.kind}</td>
              <td data-label="Started by">{k.mode}</td>
              <td data-label="Image or worker" class="muted">{k.image || k.url || "—"}</td>
              <td data-label="Time allowed" class="muted">{ago(k.timeoutSeconds)}</td>
            </tr>
          ))}
        </tbody>
      </table></div>
    )}
  </section>

  <script>
    document.querySelectorAll<HTMLButtonElement>("button.copy").forEach((button) => {
      button.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(button.dataset.copy ?? "");
          button.textContent = "Copied";
        } catch {
          button.textContent = "Select and copy";
        }
        setTimeout(() => (button.textContent = "Copy"), 1500);
      });
    });
  </script>
  {view.workers.some((w) => !w.healthy) && (
    <script>
      import { fetchApi } from "@/lib/api/client";

      // Moves the record to the Trash (the Trash can restore it). A worker that is still running writes a new one on its next beat.
      document.querySelectorAll<HTMLButtonElement>("button.js-remove-worker").forEach((button) => {
        button.addEventListener("click", async () => {
          if (!confirm(`Remove ${button.dataset.name} from this list? It comes back by itself if it starts again.`)) return;
          button.disabled = true;
          try {
            await fetchApi(`/api/platform/entries/${button.dataset.id}`, { method: "DELETE" });
            button.closest("li")?.remove();
          } catch (e) {
            button.disabled = false;
            alert(e instanceof Error ? e.message : "Could not remove it.");
          }
        });
      });
    </script>
  )}
  {busy && <script is:inline>setTimeout(() => location.reload(), 15000);</script>}
  {missing.length > 0 && (
    <script>
      import { applyBlueprints } from "@/lib/api/blueprints";
      import { WORKER_TYPES } from "@/lib/workers";

      const button = document.getElementById("workers-setup-button") as HTMLButtonElement | null;
      const note = document.getElementById("workers-setup-note");
      button?.addEventListener("click", async () => {
        button.disabled = true;
        if (note) note.textContent = "Adding…";
        try {
          // `core`: an integration could offer a blueprint with one of these slugs; the Workers set is core's.
          await applyBlueprints([...WORKER_TYPES], undefined, "core");
          location.reload();
        } catch (e) {
          button.disabled = false;
          if (note) note.textContent = e instanceof Error ? e.message : "Could not add them. You need to be a workspace admin.";
        }
      });
    </script>
  )}
</AppLayout>

<style>
  .sub { margin: 4px 0 0; color: var(--muted); }
  .card { border: 1px solid var(--line); border-radius: var(--radius); background: var(--panel); padding: 14px 16px; margin: 0 0 16px; }
  .card h3 { margin: 0 0 10px; font-size: 1rem; font-weight: 600; }
  .step { margin: 12px 0 0; font-size: 13px; font-weight: 600; }
  .how { border-top: 1px solid var(--line); margin-top: 12px; padding-top: 10px; }
  .how summary { cursor: pointer; font-weight: 600; }
  .cmd { position: relative; margin: 6px 0 4px; }
  .cmd pre { margin: 0; padding: 12px 76px 12px 12px; background: var(--panel-2, var(--panel)); border: 1px solid var(--line); border-radius: var(--radius); white-space: pre-wrap; overflow-wrap: anywhere; font-size: 13px; line-height: 1.5; }
  .cmd code { padding: 0; background: none; }
  .copy { position: absolute; top: 8px; right: 8px; padding: 4px 10px; font-size: 12px; border: 1px solid var(--line); border-radius: 6px; background: var(--bg, transparent); color: var(--ink); cursor: pointer; }
  .roles { margin: 0 0 12px; font-size: 13px; }
  .workers .button { margin-left: auto; padding: 3px 10px; font-size: 12px; }
  /* The same 13px as the other cards' explanations (.roles), not the page's body size, so the card doesn't read louder than the rest. */
  .setup p { margin: 0 0 10px; font-size: 13px; }
  .setup ul { margin: 0 0 10px; padding-left: 20px; font-size: 13px; }
  .setup .muted { margin-left: 10px; }
  .alert { padding: 10px 14px; border-radius: var(--radius); margin: 0 0 12px; }
  .alert.warn { border: 1px solid var(--warn, #d97706); background: color-mix(in srgb, var(--warn, #d97706) 10%, transparent); }
  .alert.error { border: 1px solid var(--color-error, #dc2626); }
  .workers { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .image-groups { display: grid; gap: 1rem; }
  .image-group { border: 1px solid var(--line); border-radius: var(--radius); padding: 0.75rem 1rem; }
  .image-head { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; margin: 0 0 0.6rem; font-size: 0.95rem; }
  .pill.warn { color: var(--color-warning, #b45309); border-color: currentColor; }
  .workers li { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 8px; }
  .workers .dot { margin-right: 0; }
  .kind-list { display: inline-flex; gap: 4px; flex-wrap: wrap; }
  .inputs { list-style: none; margin: 0; padding: 0; }
  .small { font-size: 12px; }
  .dot { display: inline-block; width: 9px; height: 9px; border-radius: 50%; margin-right: 8px; }
  .dot.ok { background: var(--good, #16a34a); }
  .dot.off { background: var(--muted); opacity: 0.55; }
  /* 13px like the rest of the site's secondary text (the Packages page, the pills), not the page's body size. */
  .muted { color: var(--muted); font-size: 13px; }
  .empty { color: var(--muted); margin: 0; }
  .counts { display: flex; gap: 8px; flex-wrap: wrap; margin: 0 0 12px; }
  .pill { display: inline-block; padding: 2px 9px; border-radius: 999px; font-size: 12px; border: 1px solid var(--line); background: var(--panel-2, var(--panel)); }
  .s-done { color: var(--good, #16a34a); }
  .s-failed { color: var(--color-error, #dc2626); }
  .s-running, .s-claimed { color: var(--accent, #2563eb); }
  .flag { color: var(--color-error, #dc2626); font-size: 12px; }
  .table-wrap { overflow-x: auto; }
  @media (max-width: 720px) {
    .workers { gap: 16px; }
    .workers li { row-gap: 4px; }
    .workers li > .muted { flex-basis: 100%; }
    .stack thead { display: none; }
    .stack, .stack tbody, .stack tr, .stack td { display: block; width: auto; }
    .stack tr { padding: 14px 0; border-bottom: 1px solid var(--line); }
    .stack tbody tr:first-child { padding-top: 4px; }
    .stack tbody tr:last-child { padding-bottom: 0; border-bottom: 0; }
    .stack td { position: relative; border-bottom: 0; padding: 6px 0 6px 7.5rem; overflow-wrap: anywhere; }
    .stack td ul { margin: 0; }
    .stack td[data-label]::before { content: attr(data-label); position: absolute; left: 0; top: 8px; width: 6.5rem; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; color: var(--muted); }
    /* Long values (a description, a log) take the whole card, with the label above. */
    .stack td.long, .stack td.log { padding-left: 0; }
    .stack tr.has-log { border-bottom: 0; padding-bottom: 0; }
    .stack tr.log-row { padding-top: 0; }
    .log-row td { padding: 0 0 6px; }
    .stack td.long[data-label]::before, .stack td.log[data-label]::before { position: static; display: block; width: auto; margin-bottom: 3px; }
  }
  table { width: 100%; border-collapse: collapse; font-size: 13px; }
  th, td { text-align: left; padding: 7px 8px; border-bottom: 1px solid var(--line); vertical-align: top; }
  th { font-size: 12px; color: var(--muted); font-weight: 600; }
  .log { max-width: 34rem; color: var(--muted); word-break: break-word; }
  .log a { display: block; margin-bottom: 2px; }
  .log summary { cursor: pointer; }
  .log-row td { padding: 0 8px 10px; }
  .has-log td { border-bottom: 0; }
  .log-row summary { cursor: pointer; font-size: 13px; color: var(--muted); }
  .log-row .log-full { margin: 6px 0 0; padding: 10px 12px; max-height: 24rem; overflow: auto; white-space: pre-wrap; overflow-wrap: anywhere; background: var(--panel-2, var(--panel)); border: 1px solid var(--line); border-radius: var(--radius); font-size: 12.5px; line-height: 1.5; color: var(--ink); }
  .log-full code { padding: 0; background: none; font: inherit; }
  .log pre { margin: 6px 0 0; padding: 8px 10px; max-height: 18rem; overflow: auto; white-space: pre-wrap; background: var(--panel-2, var(--panel)); border: 1px solid var(--line); border-radius: var(--radius); font-size: 12px; color: var(--ink); }
  .bad-text { color: var(--color-error, #dc2626); }
</style>
