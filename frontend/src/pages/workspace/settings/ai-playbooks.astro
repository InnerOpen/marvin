---
// Settings › AI › Playbooks: the workspace's Playbooks (written procedures an agent follows when a task calls for one) with their
// status. A Playbook is an entry of the internal `playbook` type, so it never appears in All entries, search or the status lists;
// this page and its editor are where it lives. Editors and above. Backend: routes/groups/playbooks_controller.py.
// Pure logic: lib/playbooks.ts.
import AppLayout from "@/layouts/AppLayout.astro";
import { getAuthToken } from "@/lib/api/client";
import { listPlaybooks, listSystemPlaybooks, type PlaybookList } from "@/lib/api/playbooks";
import { listWorkspaces } from "@/lib/api/workspaces";
import { requireAuth } from "@/lib/auth";
import { GITHUB_IMPORT_PLACEHOLDER, IMPORT_PATH_ACCEPT } from "@/lib/playbookReview";
import {
  EMPTY_NOTICE,
  fromIntegration,
  fromIntegrationId,
  listSummary,
  NEW_PLAYBOOK_PATH,
  playbookRow,
  PLAYBOOKS_PATH,
  sortedItems,
  SYSTEM_INTRO,
  type SystemPlaybookItem,
  switchTitle,
  systemGroups,
} from "@/lib/playbooks";
import { canManageWorkspace, isForbidden } from "@/lib/workspaceRole";

const user = await requireAuth(Astro.cookies, Astro.redirect, Astro.url.pathname);
const authToken = getAuthToken(Astro.cookies);
let list: PlaybookList | null = null;
let system: SystemPlaybookItem[] = [];
let canManage = false;
let error: string | null = null;
let restricted = false;
try {
  list = await listPlaybooks(authToken);
  system = await listSystemPlaybooks(authToken).catch(() => []); // the System section is a nicety: the page works without it
  canManage = canManageWorkspace(await listWorkspaces(authToken), user);
} catch (e) {
  if (isForbidden(e)) restricted = true;
  else error = e instanceof Error ? e.message : String(e);
}
// `?from=integration:<id>`: the card's "What it installed" link, narrowed to one integration's Playbooks.
const fromId = fromIntegrationId(Astro.url.searchParams.get("from"));
const all = sortedItems(list?.items ?? []);
const items = fromIntegration(all, fromId);
const fromName = fromId ? (all.find((i) => i.fromIntegration?.integrationId === fromId)?.fromIntegration?.name ?? "this integration") : null;
const rows = items.map((item) => playbookRow(item));
const systemSections = fromId ? [] : systemGroups(system);
---

<AppLayout crumb="settings.ai-playbooks" restrictedNote={restricted ? "Playbooks are for editors and above." : null}>
  <div class="page-header">
    <div>
      <h2>Playbooks</h2>
      <p>Written procedures your agents follow when a task calls for one. Only published Playbooks are used.</p>
    </div>
    {!error && (
      <div class="pb-head-actions">
        <button type="button" class="button secondary" id="pb-import" title="Import a SKILL.md or a zip of a skill folder">Import</button>
        <input type="file" id="pb-import-file" accept={IMPORT_PATH_ACCEPT} hidden />
        <a class="button" href={NEW_PLAYBOOK_PATH}>New Playbook</a>
      </div>
    )}
  </div>

  {!error && (
    <form class="pb-github" id="pb-github-form" autocomplete="off">
      <input
        type="url"
        class="input"
        id="pb-github-url"
        placeholder={GITHUB_IMPORT_PLACEHOLDER}
        aria-label="GitHub link to a skill folder or SKILL.md"
        title="A public github.com link to a skill folder or its SKILL.md"
      />
      <button type="submit" class="button secondary" id="pb-github-go">Import from GitHub</button>
    </form>
  )}

  {!error && (
    <p class="pb-import-help">
      <strong>From GitHub:</strong> link a skill's folder or its SKILL.md. Either way the whole folder comes in, reference files
      included. Public repositories only.
      <strong>From your computer:</strong> Import takes one SKILL.md, or a .zip of one skill folder (use a zip when the skill has
      reference files). Every import arrives as a draft for you to review before publishing.
    </p>
  )}

  <p class="pb-import-msg" id="pb-import-msg" role="status" hidden></p>
  {error && <div class="alert"><strong>Couldn't load your Playbooks.</strong> {error}</div>}

  {!error && rows.length === 0 && systemSections.length === 0 && (
    <div class="section-card pb-empty">
      <h3>{EMPTY_NOTICE.title}</h3>
      <p>{EMPTY_NOTICE.body}</p>
      <p><a class="button" href={NEW_PLAYBOOK_PATH}>Write the first one</a></p>
    </div>
  )}

  {fromName && (
    <p class="pb-from" data-testid="playbooks-from">
      Showing the Playbooks {fromName} shipped. <a href={PLAYBOOKS_PATH}>Show all</a>
    </p>
  )}

  {rows.length > 0 && (
    <div class="pb-section">
      <p class="pb-summary">{listSummary(items)}</p>
      <ul class="pb-list">
        {rows.map((row) => (
          <li>
            <a class="pb-row" href={row.href}>
              <span class="pb-main">
                <strong class="pb-name">{row.name}</strong>
                {row.summary && <span class="pb-desc">{row.summary}</span>}
                <span class="pb-used">{row.used}</span>
                {row.origin && <span class="pb-origin" data-testid="playbook-origin">{row.origin}</span>}
                {row.copied && <span class="pb-origin" data-testid="playbook-copied">{row.copied}</span>}
              </span>
              <span class="pb-tags">
                {row.manualOnly && <span class="pb-manual" title="Loaded only when a person names it">Manual only</span>}
                <span class:list={["pill", row.tone]}>{row.label}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
      {rows.some((r) => r.upstream) && (
        <ul class="pb-upstream-list">
          {rows.filter((r) => r.upstream).map((row) => (
            <li class="pb-upstream" data-testid="playbook-upstream">
              <span><strong>{row.name}.</strong> {row.upstream}</span>
              <span class="pb-upstream-actions">
                {row.upstreamHref && <a href={row.upstreamHref}>View it</a>}
                {canManage && <button type="button" class="button secondary small pb-seen" data-id={row.id}>Mark as seen</button>}
              </span>
            </li>
          ))}
        </ul>
      )}
    </div>
  )}

  {!error && systemSections.length > 0 && (
    <div class="pb-section pb-system" data-testid="playbooks-system">
      <h3 class="pb-system-title">System</h3>
      <p class="pb-import-help">{SYSTEM_INTRO}</p>
      {systemSections.map((group) => (
        <div class="pb-group">
          <p class="pb-summary">{group.label}</p>
          <ul class="pb-list">
            {group.rows.map((row) => (
              <li class:list={["pb-row", "pb-row-system", { "pb-off": !row.on }]} data-testid="system-playbook" data-name={row.name}>
                <span class="pb-main">
                  <strong class="pb-name">{row.name}</strong>
                  {row.summary && <span class="pb-desc">{row.summary}</span>}
                  {row.note && <span class="pb-used" data-testid="system-note">{row.note}</span>}
                  <span class="pb-used">{row.label}{row.version ? ` · ${row.version}` : ""}</span>
                </span>
                <span class="pb-tags">
                  {row.manualOnly && <span class="pb-manual" title="Loaded only when a person names it">Manual only</span>}
                  {row.allowedTools && <span class="pb-manual" title={`Limits an agent to: ${row.allowedTools}`}>Allowed tools</span>}
                  {canManage && (
                    <label class="pb-switch" title={switchTitle(row)}>
                      <input type="checkbox" class="pb-system-switch" data-name={row.name} checked={row.enabled} disabled={row.serverOff} />
                      <span>{row.enabled ? "On" : "Off"}</span>
                    </label>
                  )}
                  <a class="button secondary small" href={row.href}>View</a>
                  {canManage && <button type="button" class="button secondary small pb-copy" data-name={row.name} data-suggested={row.suggestedName}>Copy</button>}
                </span>
              </li>
            ))}
          </ul>
        </div>
      ))}
      <p class="pb-import-msg" id="pb-system-msg" role="status" hidden></p>
    </div>
  )}
</AppLayout>

<style>
  .section-card { box-sizing: border-box; background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); padding: 20px 24px; margin-bottom: 16px; }
  .pb-head-actions { display: flex; gap: 8px; flex-wrap: wrap; }
  .pb-github { display: flex; gap: 8px; margin: 0 0 12px; max-width: 720px; }
  .pb-github input { flex: 1; min-width: 0; }
  @media (max-width: 720px) { .pb-github { flex-direction: column; } }
  .pb-import-help { margin: -4px 0 16px; max-width: 720px; color: var(--muted); font-size: 13px; line-height: 1.5; }
  .pb-import-msg { margin: 0 0 12px; font-size: 14px; padding: 8px 12px; border-radius: var(--radius); border: 1px solid var(--line); }
  .pb-import-msg.error { color: var(--bad, #b91c1c); border-color: var(--bad, #b91c1c); }
  /* Slim cards, matching the Automation lists' .org-card (components/OrganizedSections.astro). */
  .pb-section { max-width: 900px; }  /* as wide as the Workflows list */
  .pb-summary { margin: 0 0 8px; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; color: var(--muted); }
  .pb-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  .pb-row { display: flex; align-items: center; justify-content: space-between; gap: 14px; border: 1px solid var(--line); border-radius: 12px; padding: 10px 14px; background: var(--panel); color: inherit; text-decoration: none; transition: border-color 0.15s; }
  .pb-row:hover { border-color: color-mix(in srgb, var(--accent) 40%, var(--line)); }
  .pb-row:hover .pb-name { color: var(--accent); }
  .pb-main { display: flex; flex-direction: column; gap: 2px; min-width: 0; flex: 1; }
  .pb-name { font-size: 14.5px; font-weight: 600; overflow-wrap: anywhere; }
  .pb-desc { font-size: 13px; color: var(--muted); overflow-wrap: anywhere; }
  .pb-used { font-size: 12px; color: var(--muted); }
  .pb-origin { font-size: 12px; color: var(--muted); }
  .pb-from { margin: 0 0 12px; font-size: 13px; color: var(--muted); }
  .pb-tags { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }
  .pb-manual { font-size: 11px; color: var(--muted); border: 1px solid var(--line); border-radius: 4px; padding: 1px 6px; white-space: nowrap; }
  .pb-empty h3 { margin: 0 0 6px; }
  .pb-system { margin-top: 28px; }
  .pb-system-title { margin: 0 0 4px; }
  .pb-group { margin-bottom: 14px; }
  .pb-row-system { cursor: default; }
  .pb-row-system:hover .pb-name { color: inherit; }
  .pb-off { opacity: 0.75; }
  .pb-switch { display: inline-flex; align-items: center; gap: 4px; font-size: 12px; color: var(--muted); }
  .pb-upstream-list { list-style: none; margin: 10px 0 0; padding: 0; display: flex; flex-direction: column; gap: 6px; }
  .pb-upstream { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; font-size: 13px; border: 1px solid var(--line); border-radius: 8px; padding: 6px 12px; }
  .pb-upstream-actions { display: flex; gap: 10px; align-items: center; }
  @media (max-width: 720px) {
    .pb-row { align-items: flex-start; flex-direction: column; gap: 6px; }
    .pb-tags { flex-wrap: wrap; }
  }
</style>

<script>
  import { copySystemPlaybook, importPlaybook, importPlaybookFromGithub, markUpstreamSeen, switchSystemPlaybook } from "@/lib/api/playbooks";
  import { githubLink, importError } from "@/lib/playbookReview";
  import { copyError, editorPath } from "@/lib/playbooks";

  const button = document.getElementById("pb-import") as HTMLButtonElement | null;
  const input = document.getElementById("pb-import-file") as HTMLInputElement | null;
  const message = document.getElementById("pb-import-msg") as HTMLElement;

  const say = (text: string, error = false) => {
    message.textContent = text;
    message.hidden = !text;
    message.classList.toggle("error", error);
  };

  const githubForm = document.getElementById("pb-github-form") as HTMLFormElement | null;
  const githubUrl = document.getElementById("pb-github-url") as HTMLInputElement | null;
  const githubGo = document.getElementById("pb-github-go") as HTMLButtonElement | null;
  githubForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const link = githubLink(githubUrl?.value ?? "");
    if (!link) return say("Paste a GitHub link to a skill folder or a SKILL.md file.", true);
    githubGo!.disabled = true;
    say("Fetching from GitHub…");
    try {
      const made = await importPlaybookFromGithub(link);
      location.assign(`${editorPath(made.id)}?imported=1`);
    } catch (e) {
      say(importError(e), true);
      githubGo!.disabled = false;
    }
  });

  const systemMessage = document.getElementById("pb-system-msg") as HTMLElement | null;
  const sayAbout = (text: string, error = false) => {
    if (!systemMessage) return;
    systemMessage.textContent = text;
    systemMessage.hidden = !text;
    systemMessage.classList.toggle("error", error);
  };
  document.querySelectorAll<HTMLInputElement>(".pb-system-switch").forEach((box) =>
    box.addEventListener("change", async () => {
      box.disabled = true;
      try {
        await switchSystemPlaybook(box.dataset.name!, box.checked);
        location.reload();
      } catch (e) {
        box.checked = !box.checked;
        box.disabled = false;
        sayAbout(copyError(e), true);
      }
    }),
  );
  document.querySelectorAll<HTMLButtonElement>(".pb-copy").forEach((copy) =>
    copy.addEventListener("click", async () => {
      const name = copy.dataset.name!;
      const chosen = window.prompt(`Name for your copy of ${name}`, copy.dataset.suggested ?? "");
      if (chosen === null) return;
      copy.disabled = true;
      try {
        const made = await copySystemPlaybook(name, chosen.trim() || undefined);
        location.assign(`${editorPath(made.id)}?imported=1`);
      } catch (e) {
        sayAbout(copyError(e), true);
        copy.disabled = false;
      }
    }),
  );
  document.querySelectorAll<HTMLButtonElement>(".pb-seen").forEach((seen) =>
    seen.addEventListener("click", async () => {
      seen.disabled = true;
      try {
        await markUpstreamSeen(seen.dataset.id!);
        location.reload();
      } catch (e) {
        sayAbout(copyError(e), true);
        seen.disabled = false;
      }
    }),
  );

  button?.addEventListener("click", () => input?.click());
  input?.addEventListener("change", async () => {
    const file = input.files?.[0];
    if (!file) return;
    button!.disabled = true;
    say(`Importing ${file.name}…`);
    try {
      const made = await importPlaybook(file);
      location.assign(`${editorPath(made.id)}?imported=1`);
    } catch (e) {
      say(importError(e), true);
      button!.disabled = false;
    } finally {
      input.value = "";
    }
  });
</script>
