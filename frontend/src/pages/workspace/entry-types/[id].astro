---
import SchemaEditor from "@/components/SchemaEditor.astro";
import AppLayout from "@/layouts/AppLayout.astro";
import { getAuthToken } from "@/lib/api/client";
import { type CollectionRead, listCollections } from "@/lib/api/collections";
import { getEntryType } from "@/lib/api/entryTypes";
import { type MarvinAsset, getAssets } from "@/lib/api/platform";
import { canManageCurrentWorkspace } from "@/lib/api/workspaces";
import { lockReason, usedBy } from "@/lib/entryTypeListing";
import { TEMPLATE_VARIABLES, assetFields, valueFields } from "@/lib/entryTemplates";
import { ASPECTS, GRADES, SLIDERS, type GradeSetting } from "@/lib/picturePresets";
import { splitRecipe } from "@/lib/recipeForm";
import { ADMINS_ONLY } from "@/lib/workspaceRole";

const { id } = Astro.params;
const authToken = getAuthToken(Astro.cookies);
// Everyone reads; changing an entry type is admin-only (if the role can't be read, let the API decide).
const canManage = authToken ? await canManageCurrentWorkspace(authToken, Astro.locals).catch(() => true) : true;

let entryType = null;
let error: string | null = null;

if (!id) {
  error = "Entry type ID is required";
} else {
  try {
    entryType = await getEntryType(id, authToken);
  } catch (e) {
    error = e instanceof Error ? e.message : String(e);
    console.error("[EntryType] Failed to load:", error);
  }
}

const isSystem = entryType?.isSystem ?? false;
// A type a feature is built on (the Playbook type) is read-only for everyone; the server refuses the change too.
const lockedReason = lockReason(entryType);

const rendering = (entryType?.renderingJson ?? {}) as Record<string, unknown>;
const capabilities = (entryType?.capabilitiesJson ?? {}) as Record<string, unknown>;
const submission = (capabilities.submission ?? {}) as Record<string, unknown>;
const subStr = (k: string) => (submission[k] == null ? "" : String(submission[k]));
// "Same person = same …": the fields that can identify a submitter (single values, not long text).
const schemaFields = ((entryType?.schemaJson as { fields?: { key?: string; label?: string; type?: string; options?: string[] }[] } | null)?.fields ?? []);
const matchFieldOptions = schemaFields.filter((f) => f.key && ["text", "number", "select"].includes(f.type ?? ""));
const matchField = subStr("matchField");
// Where the submissions go (the backend defaults to the Audience, also for a type that never stored it) and what they are.
const destination = submission.destination === "entries" ? "entries" : "audience";
const kind = submission.kind === "signup" ? "signup" : "message";
// "Show in content lists" is the one internal flag (`listed`); the hint says what uses the type.
const listed = capabilities.listed !== false;
const usedByNow = usedBy({ slug: entryType?.slug, capabilitiesJson: capabilities });
const recipe = (entryType?.recipeJson ?? {}) as Record<string, unknown>;
// The authoring instructions and the drafts' voice (`enrichment.voice`) get their own boxes; the JSON textarea
// holds the rest of the structured contract (lib/recipeForm).
const { instructions: recipeInstructions, voice: recipeVoice, json: recipeStr } = splitRecipe(recipe);

// Templates (lib/entryTemplates): presets for making entries of this type from pictures. Saved on their own
// (api/entry-types/[id]/templates), so the server's 400 can be shown next to the template that caused it.
// templatesJson is newer than the SDK release the frontend pins.
const templates = ((entryType as { templatesJson?: unknown } | null)?.templatesJson ?? []) as unknown[];
const canEditTemplates = canManage && !lockedReason;
const templateValueFields = valueFields(schemaFields);
const templateAssetFields = assetFields(schemaFields);
// The title preview uses the newest image in the library (the list has no limit, so only an editor asks), and the
// collection boxes list the hand-picked collections (read once per request; the sidebar reads them too).
const [samplePicture, handPicked]: [MarvinAsset | null, CollectionRead[]] = canEditTemplates && authToken && entryType
  ? await Promise.all([
      getAssets(authToken, { asset_type: "image", sort: "newest", limit: "1" }).then((a) => a[0] ?? null).catch(() => null),
      listCollections(authToken, Astro.locals).then((cs) => cs.filter((c) => !c.isSmart)).catch(() => []),
    ])
  : [null, []];
const json = (value: unknown) => JSON.stringify(value).replace(/</g, "\\u003c");
const templateData = json({
  id,
  templates,
  fields: schemaFields,
  canEdit: canEditTemplates,
  sample: samplePicture ? { name: samplePicture.name, originalFilename: samplePicture.originalFilename, filename: samplePicture.filename } : null,
});
const variableList = TEMPLATE_VARIABLES.map((v) => `{${v}}`).join(", ");

// Picture presets (lib/picturePresets): named recipes of treatments a template can name. Saved on their own
// (api/entry-types/[id]/picture-presets), like the templates; picturePresetsJson is newer than the pinned SDK too.
const picturePresets = ((entryType as { picturePresetsJson?: unknown } | null)?.picturePresetsJson ?? []) as unknown[];
const presetData = json({
  id,
  presets: picturePresets,
  canEdit: canEditTemplates,
  sample: samplePicture?.publicUrl ? { url: samplePicture.publicUrl, name: samplePicture.name } : null,
});
const gradeNames = Object.keys(GRADES);
const presetSliders: { key: GradeSetting; label: string; help: string }[] = [
  { key: "brightness", label: "Brightness", help: "" },
  { key: "contrast", label: "Contrast", help: "" },
  { key: "saturation", label: "Saturation", help: "" },
  { key: "warmth", label: "Warmth", help: "Above 0 warmer, below 0 cooler." },
  { key: "vignette", label: "Dark corners (vignette)", help: "" },
];
---

<AppLayout
  crumb="settings.entry-types.entry-type"
  title={entryType ? `Edit ${entryType.name}` : "Edit Entry Type"}
  entityType="entry_type"
  entityId={id}
  entityLabel={entryType?.name}
>
  {error ? (
    <div class="error-banner">
      <p><strong>Error loading entry type:</strong> {error}</p>
    </div>
  ) : entryType ? (
    <>
      <div class="toolbar">
        <div>
          <h2>Edit Entry Type</h2>
          <p style="margin:4px 0 0;color:var(--muted);">
            {lockedReason ? "This entry type is locked" : isSystem ? "System entry types have limited editing" : "Update entry type details"}
          </p>
        </div>
      </div>

      {!canManage && <div class="alert alert-info" role="status">{ADMINS_ONLY}</div>}
      {lockedReason && <div class="alert alert-info" role="status"><strong>🔒 Locked.</strong> {lockedReason}</div>}

      <section class="form-section">
        <form method="POST" action={`/api/entry-types/${id}/update`} class="form">
          <fieldset disabled={!canManage || !!lockedReason} style="border:0;margin:0;padding:0;min-width:0;">
          <div class="form-group">
            <label for="name">Name *</label>
            <input
              type="text"
              id="name"
              name="name"
              required
              value={entryType.name}
              disabled={isSystem}
            />
            <p class="form-help">{isSystem ? 'System entry type name cannot be changed' : 'Display name for this entry type'}</p>
          </div>

          <div class="form-group">
            <label>Slug</label>
            <input
              type="text"
              id="slug"
              value={entryType.slug}
              disabled
              style="background: var(--panel-2); color: var(--muted);"
            />
            <p class="form-help" style="font-size: 12px; color: var(--muted);">Slug is fixed once created to avoid breaking references</p>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="icon">Icon</label>
              <input
                type="text"
                id="icon"
                name="icon"
                value={entryType.icon || ""}
                maxlength="4"
              />
              <p class="form-help">Emoji or symbol</p>
            </div>

            <div class="form-group">
              <label for="color">Color</label>
              <input
                type="color"
                id="color"
                name="color"
                value={entryType.color || "#a94d3f"}
              />
              <p class="form-help">Theme color</p>
            </div>
          </div>

          <div class="form-group">
            <label for="description">Description</label>
            <textarea
              id="description"
              name="description"
              rows="3"
            >{entryType.description || ""}</textarea>
          </div>

          <div class="form-group">
            <label for="sort_order">Sort Order</label>
            <input
              type="number"
              id="sort_order"
              name="sort_order"
              value={entryType.sortOrder}
              min="0"
            />
            <p class="form-help">Lower numbers appear first</p>
          </div>

          <div class="form-group">
            <label for="page_url_pattern">Page URL pattern</label>
            <input
              type="text"
              id="page_url_pattern"
              name="page_url_pattern"
              value={entryType.pageUrlPattern || ""}
              placeholder="/works/{slug}"
              pattern="(/|https?://).*"
              title="Start with / (a path on your site) or http(s):// (a full URL)"
              spellcheck="false"
            />
            <p class="form-help">Optional. Where your site shows an entry of this type, so Marvin can link to it (the AI assistant, "View on site", the publishing API's <code>url</code>). Use <code>{"{slug}"}</code>, <code>{"{id}"}</code> or <code>{"{entry_type}"}</code>; a path is joined to the Canonical URL in site settings. Leave blank if entries of this type have no page.</p>
          </div>

          {/* Schema Editor */}
          <div class="schema-section">
            <SchemaEditor schema={entryType.schemaJson} />
          </div>

          {/* Rendering Configuration */}
          <div class="config-section">
            <label class="checkbox-label" style="margin-bottom: 0.75rem;">
              <input type="checkbox" id="is_rendered" name="is_rendered" checked={entryType.isRendered} />
              Uses a renderer component
            </label>
            <p class="form-help" style="margin-bottom: 1rem;">Enable for types rendered by a registered renderer (e.g. page, article). Leave off for types that inject data into layouts or use custom components.</p>
            <details id="rendering-details" open={!!rendering.renderer}>
              <summary class="section-heading">Rendering</summary>
              <div class="config-fields">
                <div class="form-group">
                  <label for="renderer_name">Renderer Name</label>
                  <input type="text" id="renderer_name" value={String(rendering.renderer || '')} placeholder="e.g., page, form, external-embed" />
                  <p class="form-help">Identifies the renderer component to use</p>
                </div>
                <div class="form-row">
                  <div class="form-group">
                    <label for="renderer_package">Package</label>
                    <input type="text" id="renderer_package" value={String(rendering.package || '')} placeholder="e.g., @inneropen/marvin-renderers-core" />
                  </div>
                  <div class="form-group">
                    <label for="renderer_version">Version</label>
                    <input type="text" id="renderer_version" value={String(rendering.version || '')} placeholder="e.g., ^1.0.0" />
                  </div>
                </div>
              </div>
            </details>
            <input type="hidden" name="rendering_json" id="rendering_json" />
          </div>

          {/* Capabilities */}
          <div class="config-section">
            <details id="capabilities-details" open={Object.keys(capabilities).length > 0}>
              <summary class="section-heading">Capabilities</summary>
              <div class="config-fields">
                <label class="checkbox-label">
                  <input type="checkbox" id="cap_publishable" checked={capabilities.publishable !== false} />
                  Publishable
                </label>
                <label class="checkbox-label">
                  <input type="checkbox" id="cap_submittable" checked={capabilities.submittable === true} />
                  Submittable
                </label>
                <label class="checkbox-label">
                  <input type="checkbox" id="cap_routable" checked={capabilities.routable !== false} />
                  Routable
                </label>
                <div class="form-group listed-switch">
                  <label class="checkbox-label">
                    <input type="checkbox" id="cap_listed" checked={listed} />
                    Show in content lists
                  </label>
                  <p class="form-help">
                    Off means its entries are kept out of All entries, the status lists, counts, search and the AI index, while features that use them keep working.
                    <span id="cap_listed_use" data-initial={usedByNow ?? ""}>{usedByNow ? ` Used by ${usedByNow}.` : ""}</span>
                  </p>
                </div>

                <fieldset id="submission-settings" class="submission-settings" hidden={capabilities.submittable !== true}>
                  <legend>Submission settings</legend>
                  <p class="form-help">How public submissions to this type are accepted. Spam controls (domain lists, exempt IPs, surge) are set under Workspace Settings → Submission Protection.</p>
                  <div class="form-row">
                    <div class="form-group">
                      <label for="sub_destination">Submissions go to</label>
                      <select id="sub_destination" data-sub="destination">
                        <option value="audience" selected={destination === "audience"}>Audience</option>
                        <option value="entries" selected={destination === "entries"}>Entries</option>
                      </select>
                      <p class="form-help" id="sub_destination_help" data-audience="Audience: people writing to you, kept out of your content." data-entries="Entries: content to review and publish, e.g. testimonials.">
                        {destination === "entries" ? "Entries: content to review and publish, e.g. testimonials." : "Audience: people writing to you, kept out of your content."}
                      </p>
                    </div>
                    <div class="form-group" id="sub_kind_group">
                      <label for="sub_kind">A submission is a</label>
                      <select id="sub_kind" data-sub="kind">
                        <option value="message" selected={kind === "message"}>Message</option>
                        <option value="signup" selected={kind === "signup"}>Signup</option>
                      </select>
                      <p class="form-help" id="sub_kind_help" data-message="Message: someone writing to you (listed under Submissions when the destination is Audience)." data-signup="Signup: newsletter signups, listed under Audience › Subscribers (whatever the destination).">
                        {kind === "signup" ? "Signup: newsletter signups, listed under Audience › Subscribers (whatever the destination)." : "Message: someone writing to you (listed under Submissions when the destination is Audience)."}
                      </p>
                    </div>
                  </div>
                  <div class="form-group">
                    <label for="sub_successMessage">Success message</label>
                    <input type="text" id="sub_successMessage" data-sub="successMessage" value={subStr("successMessage")} placeholder="Thank you for your submission" />
                  </div>
                  <div class="form-row">
                    <div class="form-group">
                      <label for="sub_redirectUrl">Redirect URL</label>
                      <input type="text" id="sub_redirectUrl" data-sub="redirectUrl" value={subStr("redirectUrl")} placeholder="/thanks" />
                    </div>
                    <div class="form-group">
                      <label for="sub_titleTemplate">Entry title template</label>
                      <input type="text" id="sub_titleTemplate" data-sub="titleTemplate" value={subStr("titleTemplate")} placeholder="Newsletter signup: {{ email }}" />
                      <p class="form-help">Jinja over the submitted fields; blank = first text value</p>
                    </div>
                  </div>
                  <div class="form-group">
                    <label for="sub_matchField">Same person = same …</label>
                    <select id="sub_matchField" data-sub="matchField">
                      <option value="" selected={!matchField}>Off — every submission is a new entry</option>
                      {matchFieldOptions.map((f) => (
                        <option value={f.key} selected={matchField === f.key}>{f.label || f.key}</option>
                      ))}
                      {matchField && !matchFieldOptions.some((f) => f.key === matchField) && (
                        <option value={matchField} selected>{matchField}</option>
                      )}
                    </select>
                    <p class="form-help">A repeat submission with the same value (an email ignores case and spaces) updates that person's entry instead of adding another; the visitor sees the same message either way. Lists saved fields, so save a new field before picking it.</p>
                  </div>
                  <div class="form-row">
                    <label class="checkbox-label">
                      <input type="checkbox" id="sub_enableHoneypot" data-sub="enableHoneypot" checked={submission.enableHoneypot === true} />
                      Honeypot field
                    </label>
                    <div class="form-group">
                      <label for="sub_honeypotField">Honeypot field name</label>
                      <input type="text" id="sub_honeypotField" data-sub="honeypotField" value={subStr("honeypotField")} placeholder="_website" />
                    </div>
                  </div>
                  <div class="form-row">
                    <label class="checkbox-label">
                      <input type="checkbox" id="sub_enableCaptcha" data-sub="enableCaptcha" checked={submission.enableCaptcha === true} />
                      CAPTCHA
                    </label>
                    <div class="form-group">
                      <label for="sub_captchaProvider">Provider</label>
                      <select id="sub_captchaProvider" data-sub="captchaProvider">
                        <option value="" selected={!submission.captchaProvider}>hcaptcha (default)</option>
                        <option value="hcaptcha" selected={submission.captchaProvider === "hcaptcha"}>hcaptcha</option>
                        <option value="turnstile" selected={submission.captchaProvider === "turnstile"}>turnstile</option>
                        <option value="recaptcha" selected={submission.captchaProvider === "recaptcha"}>recaptcha</option>
                      </select>
                    </div>
                    <div class="form-group">
                      <label for="sub_captchaSecretRef">Secret ref</label>
                      <input type="text" id="sub_captchaSecretRef" data-sub="captchaSecretRef" value={subStr("captchaSecretRef")} placeholder={"{{CAPTCHA_SECRET}}"} />
                    </div>
                  </div>
                  <div class="form-row">
                    <div class="form-group">
                      <label for="sub_rateLimitMax">Rate limit (per IP)</label>
                      <input type="number" id="sub_rateLimitMax" data-sub="rateLimitMax" data-sub-type="number" min="1" value={subStr("rateLimitMax")} placeholder="off" />
                    </div>
                    <div class="form-group">
                      <label for="sub_rateLimitWindowSeconds">Window (seconds)</label>
                      <input type="number" id="sub_rateLimitWindowSeconds" data-sub="rateLimitWindowSeconds" data-sub-type="number" min="60" value={subStr("rateLimitWindowSeconds")} placeholder="3600" />
                    </div>
                  </div>
                  <label class="checkbox-label">
                    <input type="checkbox" id="sub_notify" data-sub="notify" checked={submission.notify !== false} />
                    Emit <code>form_submission_received</code> (workflows, notifications)
                  </label>
                </fieldset>
              </div>
            </details>
            <input type="hidden" name="capabilities_json" id="capabilities_json" value={JSON.stringify(capabilities)} />
          </div>

          {/* Recipe (authoring) */}
          <div class="config-section">
            <details id="recipe-details" open={Object.keys(recipe).length > 0}>
              <summary class="section-heading">Recipe (authoring)</summary>
              <div class="config-fields">
                <label for="recipe_instructions" style="display:block;font-weight:600;margin:0 0 4px;">Authoring instructions</label>
                <p style="margin:0 0 6px;color:var(--muted);font-size:13px;">
                  Plain-language directions the AI follows when composing this type. e.g. "A short
                  navigation page. No images. One-line blurb linking to a URL."
                </p>
                <textarea
                  id="recipe_instructions"
                  rows="4"
                  placeholder="Describe how to author this type…"
                  style="width:100%;font-size:14px;line-height:1.5;padding:10px;box-sizing:border-box;border:1px solid var(--line);border-radius:var(--radius);background:var(--bg);color:var(--ink);margin-bottom:14px;"
                >{recipeInstructions}</textarea>

                <label for="recipe_voice" style="display:block;font-weight:600;margin:0 0 4px;">Voice</label>
                <p style="margin:0 0 6px;color:var(--muted);font-size:13px;">
                  Overrides the tone for AI drafts of this type. e.g. "Warm and first person; short sentences."
                  Leave blank to use the tone.
                </p>
                <input
                  id="recipe_voice"
                  type="text"
                  value={recipeVoice}
                  placeholder="How drafts of this type should sound…"
                  style="width:100%;font-size:14px;padding:9px 10px;box-sizing:border-box;border:1px solid var(--line);border-radius:var(--radius);background:var(--bg);color:var(--ink);margin-bottom:14px;"
                />

                <label for="recipe_json" style="display:block;font-weight:600;margin:0 0 4px;">Structured contract</label>
                <p style="margin:0 0 8px;color:var(--muted);font-size:13px;">
                  What to gather &amp; derive — assets contract (min/max + roles like hero/gallery, with
                  derive), resource extraction, enrichment. JSON for now.
                </p>
                <textarea
                  name="recipe_json"
                  id="recipe_json"
                  rows="12"
                  spellcheck="false"
                  style="width:100%;font-family:ui-monospace,monospace;font-size:13px;line-height:1.5;padding:10px;box-sizing:border-box;border:1px solid var(--line);border-radius:var(--radius);background:var(--bg);color:var(--ink);"
                  placeholder={'{\n  "assets": { "min": 1, "max": 4, "roles": [{ "role": "hero", "required": true, "derive": ["thumbnail", "palette"] }] },\n  "resources": { "extract": [{ "type": "supplier", "source": "body", "capture": ["name", "url"] }] }\n}'}
                >{recipeStr}</textarea>
              </div>
            </details>
          </div>

          {isSystem && (
            <div class="notice">
              <strong>⚠️ System Entry Type</strong>
              <p>Name and slug cannot be changed for system entry types. Only visual properties can be updated.</p>
            </div>
          )}

          </fieldset>
          {canManage && !lockedReason && (
            <div class="form-actions">
              <button type="submit" class="button">Save Changes</button>
              <a href="/workspace/entry-types" class="button secondary">Cancel</a>
            </div>
          )}
        </form>
        {canManage && !isSystem && !lockedReason && (
          <form method="POST" action={`/api/entry-types/${id}/delete`} class="delete-form">
            <button type="submit" class="button secondary danger" onclick="return confirm('Delete this entry type?')">
              Delete entry type
            </button>
          </form>
        )}
      </section>

      {/* Picture presets: their own section and form, saved on their own, before the templates (which name them). The list
          and the editor's values are drawn by the script below from #pp-data. */}
      <section class="form-section templates-section" id="picture-presets">
        <div class="form">
          <details id="pp-details" open={picturePresets.length > 0}>
            <summary class="section-heading">Picture presets (<span id="pp-count">{picturePresets.length}</span>)</summary>
            <div class="config-fields">
              <p class="form-help">
                Treat each picture the same way: crop, size, colour, format. Each picture gets one new version made with the steps
                in order; the original is never changed. A template can use a preset for every picture it makes an entry from.
              </p>
              <ul class="tpl-list" id="pp-list"></ul>
              <p class="form-help" id="pp-empty" hidden>No picture presets yet.</p>
              <div class="tpl-message" id="pp-message" role="alert" hidden></div>
              {canEditTemplates && (
                <button type="button" class="button secondary tpl-add" id="pp-add">Add picture preset</button>
              )}

              {canEditTemplates && (
                <form class="tpl-editor" id="pp-editor" novalidate hidden>
                  <h3 class="tpl-editor-title" id="pp-editor-title">New picture preset</h3>
                  <div class="form-row">
                    <div class="form-group">
                      <label for="pp_name">Name *</label>
                      <input type="text" id="pp_name" required maxlength="120" />
                    </div>
                    <div class="form-group">
                      <label for="pp_slug">Slug *</label>
                      <input type="text" id="pp_slug" required maxlength="64" pattern="[a-z0-9][a-z0-9\-]*" spellcheck="false" />
                    </div>
                  </div>
                  <div class="form-group">
                    <label for="pp_description">What it is for</label>
                    <input type="text" id="pp_description" maxlength="500" placeholder="Shown where the preset is picked" />
                  </div>
                  <label class="checkbox-label"><input type="checkbox" id="pp_json_mode" /> Edit the steps as JSON</label>
                  <p class="tpl-warning" id="pp_json_note" hidden></p>

                  <div class="pp-steps" id="pp_steps">
                    <fieldset class="tpl-group">
                      <legend><label class="checkbox-label"><input type="checkbox" id="pp_crop" data-pp-toggle /> Crop</label></legend>
                      <div class="pp-body" data-pp-body="pp_crop">
                        <div class="form-row">
                          <div class="form-group">
                            <label for="pp_aspect">Shape</label>
                            <select id="pp_aspect">
                              {ASPECTS.map((a) => <option value={a}>{a === "1:1" ? "1:1 (square)" : a}</option>)}
                              <option value="other">Other…</option>
                            </select>
                          </div>
                          <div class="form-group" id="pp_aspect_other_box" hidden>
                            <label for="pp_aspect_other">Other shape</label>
                            <input type="text" id="pp_aspect_other" maxlength="9" placeholder="5:7" spellcheck="false" />
                          </div>
                        </div>
                        <fieldset class="pp-radios">
                          <legend>Keep in the frame</legend>
                          <label class="checkbox-label"><input type="radio" name="pp_focus" value="center" checked /> The middle</label>
                          <label class="checkbox-label"><input type="radio" name="pp_focus" value="subject" /> The subject (AI finds it; costs one AI call per picture)</label>
                          <label class="checkbox-label"><input type="radio" name="pp_focus" value="point" /> A fixed point</label>
                        </fieldset>
                        <div class="form-row" id="pp_point_box" hidden>
                          <div class="form-group">
                            <label for="pp_focus_x">Across <output id="pp_focus_x_out" for="pp_focus_x"></output></label>
                            <input type="range" id="pp_focus_x" min="0" max="1" step="0.01" value="0.5" />
                          </div>
                          <div class="form-group">
                            <label for="pp_focus_y">Down <output id="pp_focus_y_out" for="pp_focus_y"></output></label>
                            <input type="range" id="pp_focus_y" min="0" max="1" step="0.01" value="0.5" />
                          </div>
                        </div>
                      </div>
                    </fieldset>

                    <fieldset class="tpl-group">
                      <legend><label class="checkbox-label"><input type="checkbox" id="pp_resize" data-pp-toggle /> Resize</label></legend>
                      <div class="pp-body" data-pp-body="pp_resize">
                        <div class="form-row">
                          <div class="form-group">
                            <label for="pp_width">Width (px)</label>
                            <input type="number" id="pp_width" min="1" max="10000" step="1" inputmode="numeric" placeholder="auto" />
                          </div>
                          <div class="form-group">
                            <label for="pp_height">Height (px)</label>
                            <input type="number" id="pp_height" min="1" max="10000" step="1" inputmode="numeric" placeholder="auto" />
                          </div>
                        </div>
                        <div class="form-group">
                          <label for="pp_fit">Fit</label>
                          <select id="pp_fit">
                            <option value="inside">Fit inside (the whole picture, no bigger than this)</option>
                            <option value="cover">Fill the box exactly (the rest is cut off)</option>
                          </select>
                        </div>
                      </div>
                    </fieldset>

                    <fieldset class="tpl-group">
                      <legend><label class="checkbox-label"><input type="checkbox" id="pp_grade" data-pp-toggle /> Colour</label></legend>
                      <div class="pp-body" data-pp-body="pp_grade">
                        <div class="form-group">
                          <label for="pp_grade_preset">Named look</label>
                          <select id="pp_grade_preset">
                            <option value="">None</option>
                            {gradeNames.map((g) => <option value={g}>{g}</option>)}
                          </select>
                          <p class="form-help">The sliders go on top of the named look.</p>
                        </div>
                        <div class="pp-sliders">
                          {presetSliders.map((s) => (
                            <div class="form-group">
                              <label for={`pp_${s.key}`}>{s.label} <output id={`pp_${s.key}_out`} for={`pp_${s.key}`}></output></label>
                              <input type="range" id={`pp_${s.key}`} data-pp-slider={s.key} min={SLIDERS[s.key].min} max={SLIDERS[s.key].max} step="1" value="0" />
                              {s.help && <p class="form-help">{s.help}</p>}
                            </div>
                          ))}
                        </div>
                      </div>
                    </fieldset>

                    <fieldset class="tpl-group">
                      <legend>Format</legend>
                      <div class="form-row">
                        <div class="form-group">
                          <label for="pp_format">Save as</label>
                          <select id="pp_format">
                            <option value="">Keep the picture's format</option>
                            <option value="jpeg">JPEG</option>
                            <option value="webp">WebP</option>
                            <option value="png">PNG</option>
                          </select>
                        </div>
                        <div class="form-group">
                          <label for="pp_quality">Quality (1 to 100)</label>
                          <input type="number" id="pp_quality" min="1" max="100" step="1" inputmode="numeric" placeholder="default" />
                        </div>
                      </div>
                    </fieldset>
                  </div>

                  <div class="form-group" id="pp_json_box" hidden>
                    <label for="pp_json">Steps (JSON)</label>
                    <textarea id="pp_json" rows="10" spellcheck="false" class="pp-json"></textarea>
                    <p class="form-help">A list of steps, done in order: crop (aspect, focus), resize (width, height, fit), grade (preset, brightness, contrast, saturation, warmth, vignette), convert (format, quality).</p>
                  </div>

                  <p class="form-help tpl-preview" id="pp_words" aria-live="polite"></p>
                  {samplePicture?.publicUrl && (
                    <div class="pp-preview" id="pp_preview">
                      <div class="pp-frame" id="pp_frame">
                        <img id="pp_preview_img" src={samplePicture.publicUrl} alt="" loading="lazy" />
                        <div class="pp-tint" id="pp_tint"></div>
                        <div class="pp-vignette" id="pp_vignette"></div>
                      </div>
                      <p class="form-help">Approximate preview on the newest picture in the library; the real one is made on the server.</p>
                    </div>
                  )}
                  <div class="tpl-message" id="pp-editor-message" role="alert" hidden></div>
                  <div class="form-actions">
                    <button type="submit" class="button" id="pp-save">Save picture preset</button>
                    <button type="button" class="button secondary" id="pp-cancel">Cancel</button>
                  </div>
                </form>
              )}
            </div>
          </details>
        </div>
        <script type="application/json" id="pp-data" is:inline set:html={presetData}></script>
      </section>

      {/* Templates: their own section and form (forms can't nest), saved on their own. The list and the editor's values
          are drawn by the script below from #tpl-data. */}
      <section class="form-section templates-section" id="templates">
        <div class="form">
          <details id="templates-details" open={templates.length > 0}>
            <summary class="section-heading">Templates (<span id="tpl-count">{templates.length}</span>)</summary>
            <div class="config-fields">
              <p class="form-help">
                Presets for making entries of this type from pictures, one entry per picture. Text may use {`${variableList} ({n} is the entry's number in the batch, from 1; {date} is today).`}
              </p>
              <ul class="tpl-list" id="tpl-list"></ul>
              <p class="form-help" id="tpl-empty" hidden>No templates yet.</p>
              <div class="tpl-message" id="tpl-message" role="alert" hidden></div>
              {canEditTemplates && (
                <button type="button" class="button secondary tpl-add" id="tpl-add">Add template</button>
              )}

              {canEditTemplates && (
                <form class="tpl-editor" id="tpl-editor" hidden>
                  <h3 class="tpl-editor-title" id="tpl-editor-title">New template</h3>
                  <div class="form-row">
                    <div class="form-group">
                      <label for="tpl_name">Name *</label>
                      <input type="text" id="tpl_name" required maxlength="120" />
                    </div>
                    <div class="form-group">
                      <label for="tpl_slug">Slug *</label>
                      <input type="text" id="tpl_slug" required maxlength="64" pattern="[a-z0-9][a-z0-9\-]*" spellcheck="false" />
                    </div>
                  </div>
                  <div class="form-group">
                    <label for="tpl_description">What it is for</label>
                    <input type="text" id="tpl_description" maxlength="500" placeholder="Shown where the template is picked" />
                  </div>
                  <div class="form-group">
                    <label for="tpl_title">Title</label>
                    <input type="text" id="tpl_title" maxlength="300" placeholder="{asset.name}" spellcheck="false" />
                    <p class="form-help tpl-preview" id="tpl_title_preview" aria-live="polite"></p>
                    <p class="tpl-warning" id="tpl_title_warning" hidden></p>
                  </div>
                  <div class="form-group">
                    <label for="tpl_summary">Summary</label>
                    <textarea id="tpl_summary" rows="2" maxlength="2000"></textarea>
                  </div>
                  <div class="form-group">
                    <label for="tpl_entry_description">Description text</label>
                    <textarea id="tpl_entry_description" rows="3" maxlength="20000"></textarea>
                  </div>
                  <div class="form-row">
                    <div class="form-group">
                      <label for="tpl_status">New entries start in</label>
                      <select id="tpl_status">
                        <option value="inbox">Inbox</option>
                        <option value="draft">Draft</option>
                        <option value="needs_review">Needs review</option>
                      </select>
                    </div>
                    <div class="form-group">
                      <label for="tpl_asset_field">The picture goes in</label>
                      <select id="tpl_asset_field">
                        <option value="">No field (attached only)</option>
                        {templateAssetFields.map((f) => <option value={f.key}>{f.label || f.key}</option>)}
                      </select>
                    </div>
                  </div>
                  <div class="form-row">
                    <div class="form-group">
                      <label for="tpl_asset_role">Attached as</label>
                      <input type="text" id="tpl_asset_role" maxlength="40" placeholder="featured" spellcheck="false" />
                    </div>
                    <div class="form-group">
                      <label for="tpl_tags">Tags</label>
                      <input type="text" id="tpl_tags" placeholder="birds, field notes" />
                      <p class="form-help">Comma separated; missing tags are made.</p>
                    </div>
                  </div>
                  <div class="form-row">
                    <div class="form-group">
                      <label for="tpl_picture_preset">Picture preset</label>
                      <select id="tpl_picture_preset">
                        <option value="">None</option>
                      </select>
                    </div>
                    <div class="form-group" id="tpl_treated_role_box" hidden>
                      <label for="tpl_treated_role">Treated picture's role</label>
                      <input type="text" id="tpl_treated_role" maxlength="40" placeholder="featured" spellcheck="false" />
                    </div>
                  </div>
                  <p class="form-help" id="tpl_preset_help" hidden>
                    Each picture is treated with it (in the background); the entry shows the treated picture and the original is kept as its source.
                  </p>
                  <fieldset class="tpl-group">
                    <legend>Collections</legend>
                    <div class="tpl-checks" id="tpl_collections">
                      {handPicked.map((c) => (
                        <label class="checkbox-label"><input type="checkbox" value={c.slug} /> {c.name}</label>
                      ))}
                    </div>
                    {handPicked.length === 0 && <p class="form-help">No hand-picked collections yet.</p>}
                  </fieldset>
                  {/* A number field gets a text box: its value may be a variable ({n}), which type="number" would blank. */}
                  {templateValueFields.length > 0 && (
                    <fieldset class="tpl-group">
                      <legend>Field values</legend>
                      <p class="form-help">Blank leaves a field unset. Lists saved fields, so save a new field before giving it a value.</p>
                      {templateValueFields.map((f) => (
                        <div class="form-group">
                          <label for={`tpl_field_${f.key}`}>{f.label || f.key}</label>
                          {f.type === "boolean" ? (
                            <select id={`tpl_field_${f.key}`} data-tpl-field={f.key}>
                              <option value="">Not set</option>
                              <option value="true">Yes</option>
                              <option value="false">No</option>
                            </select>
                          ) : f.type === "select" ? (
                            <select id={`tpl_field_${f.key}`} data-tpl-field={f.key}>
                              <option value="">Not set</option>
                              {(f.options ?? []).map((o) => <option value={o}>{o}</option>)}
                            </select>
                          ) : f.type === "textarea" || f.type === "markdown" ? (
                            <textarea id={`tpl_field_${f.key}`} data-tpl-field={f.key} rows="2"></textarea>
                          ) : f.type === "number" ? (
                            <input type="text" inputmode="decimal" id={`tpl_field_${f.key}`} data-tpl-field={f.key} placeholder="a number or {n}" spellcheck="false" />
                          ) : (
                            <input type="text" id={`tpl_field_${f.key}`} data-tpl-field={f.key} />
                          )}
                        </div>
                      ))}
                    </fieldset>
                  )}
                  <div class="tpl-message" id="tpl-editor-message" role="alert" hidden></div>
                  <div class="form-actions">
                    <button type="submit" class="button" id="tpl-save">Save template</button>
                    <button type="button" class="button secondary" id="tpl-cancel">Cancel</button>
                  </div>
                </form>
              )}
            </div>
          </details>
        </div>
        <script type="application/json" id="tpl-data" is:inline set:html={templateData}></script>
      </section>
    </>
  ) : null}
</AppLayout>

<style>
  .error-banner {
    padding: 1.5rem;
    background: var(--color-error-bg);
    border: 1px solid var(--color-error);
    border-radius: var(--radius);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .error-banner p {
    margin: 0;
    color: var(--color-error);
  }

  .form-section {
    max-width: 42rem;
  }

  .form {
    display: grid;
    gap: 1.5rem;
    padding: 2rem;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .form-group {
    display: grid;
    gap: 0.5rem;
  }

  .form-row {
    display: grid;
    /* minmax(0, …): a column's floor is otherwise its input's own width, which pushes two columns past a phone. */
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }
  @media (max-width: 640px) {
    .form-row { grid-template-columns: minmax(0, 1fr); }
  }

  label {
    font-weight: 600;
    font-size: 0.875rem;
    color: var(--ink);
  }

  input[type="text"],
  input[type="number"],
  input[type="color"],
  textarea {
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--bg);
    font-size: 0.875rem;
  }

  input:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  input[type="color"] {
    height: 40px;
    cursor: pointer;
  }

  textarea {
    resize: vertical;
    font-family: inherit;
  }

  .form-help {
    margin: 0;
    font-size: 0.75rem;
    color: var(--muted);
  }

  .schema-section {
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .notice {
    padding: 1rem;
    background: rgb(169 99 47 / 0.1);
    border: 1px solid var(--warn);
    border-radius: 6px;
  }

  .notice strong {
    display: block;
    margin-bottom: 0.5rem;
    color: var(--warn);
  }

  .notice p {
    margin: 0;
    font-size: 0.875rem;
    color: var(--muted);
  }

  .config-section {
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .section-heading {
    font-weight: 600;
    font-size: 0.875rem;
    color: var(--ink);
    cursor: pointer;
    user-select: none;
    padding: 0.25rem 0;
  }

  .config-fields {
    display: grid;
    gap: 1rem;
    padding-top: 1rem;
  }
  .config-fields > * { min-width: 0; }

  .submission-settings {
    margin-top: 0.75rem;
    padding: 0.75rem 1rem 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    display: grid;
    gap: 0.75rem;
  }
  /* `display: grid` above beats the browser's [hidden] rule: without this the box showed even with Submittable off. */
  .submission-settings[hidden] {
    display: none;
  }
  .submission-settings legend {
    font-weight: 600;
    padding: 0 0.4rem;
  }
  .submission-settings .form-row {
    align-items: end;
  }
  /* A dropdown is as wide as its longest option: let the row shrink and the dropdown fit it, or the page widens on a phone. */
  .submission-settings > *, .form-group { min-width: 0; }
  select { max-width: 100%; }

  .checkbox-label {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-weight: 400;
    font-size: 0.875rem;
    cursor: pointer;
  }

  .checkbox-label input[type="checkbox"] {
    width: 16px;
    height: 16px;
  }

  .form-actions {
    display: flex;
    gap: 0.75rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  /* Delete lives here as well as (on desktop) in the list, so it is reachable on a phone, where the list rows just open
     this page. Its own form: forms cannot nest. */
  .delete-form {
    margin-top: 1rem;
    margin-bottom: 1rem;
  }
  .button.danger {
    color: var(--color-error);
    border-color: var(--color-error);
  }
  .button.danger:hover {
    background: var(--color-error-bg);
  }

  /* Phones: less padding round the form (the schema cards inside need the width), 16px inputs so iOS does not zoom
     the page on focus, and tap-sized Save / Cancel. */
  @media (max-width: 640px) {
    .form { padding: 1rem; }
    input[type="text"],
    input[type="number"],
    textarea,
    select { font-size: 16px; }
    .form-actions .button { flex: 1; min-height: 44px; }
    .delete-form .button { width: 100%; min-height: 44px; }
  }

  /* Templates: compact rows (name and slug, then the title pattern), the editor below the list. The rows, the extra
     collection boxes and the preview's text are made by the script, so their rules are :global() under a scoped parent. */
  .templates-section { margin-top: 1.5rem; }
  .tpl-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  .tpl-list:empty { display: none; }
  .tpl-list :global(.tpl-row) {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--bg);
  }
  .tpl-list :global(.tpl-row-text) { flex: 1; min-width: 0; }
  .tpl-list :global(.tpl-row-name) { font-weight: 600; font-size: 0.875rem; overflow-wrap: anywhere; }
  .tpl-list :global(.tpl-row-slug),
  .tpl-list :global(.tpl-row-title) {
    font-size: 0.75rem;
    color: var(--muted);
    overflow-wrap: anywhere;
  }
  .tpl-list :global(.tpl-row-slug),
  .tpl-list :global(.tpl-row-title code) { font-family: ui-monospace, monospace; }
  .tpl-list :global(.tpl-row-actions) { display: flex; gap: 0.5rem; flex-shrink: 0; }
  .tpl-list :global(.tpl-row-actions .button) { padding: 0.25rem 0.6rem; font-size: 0.8125rem; }
  .tpl-list :global(.button.danger) { color: var(--color-error); border-color: var(--color-error); }
  .tpl-add { justify-self: start; }
  .tpl-add[hidden] { display: none; }
  .tpl-editor {
    display: grid;
    gap: 1rem;
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .tpl-editor[hidden] { display: none; }
  .tpl-editor-title { margin: 0; font-size: 1rem; }
  .tpl-group {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0.75rem 1rem 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    min-width: 0;
  }
  .tpl-group legend { font-weight: 600; font-size: 0.875rem; padding: 0 0.4rem; }
  .tpl-checks { display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; }
  .tpl-checks :global(.tpl-extra) { display: flex; align-items: center; gap: 0.5rem; font-size: 0.875rem; cursor: pointer; }
  .tpl-checks:empty { display: none; }
  .tpl-preview :global(strong) { color: var(--ink); overflow-wrap: anywhere; }
  .tpl-warning, .tpl-message {
    margin: 0;
    padding: 0.5rem 0.75rem;
    border-radius: 6px;
    font-size: 0.8125rem;
    overflow-wrap: anywhere;
  }
  .tpl-warning {
    background: rgb(169 99 47 / 0.1);
    border: 1px solid var(--warn);
    color: var(--ink);
  }
  .tpl-message {
    background: var(--color-error-bg);
    border: 1px solid var(--color-error);
    color: var(--color-error);
  }
  .tpl-message.is-ok {
    background: transparent;
    border-color: var(--line);
    color: var(--muted);
  }
  .tpl-warning[hidden], .tpl-message[hidden] { display: none; }
  @media (max-width: 640px) {
    .tpl-list :global(.tpl-row) { flex-wrap: wrap; }
    .tpl-list :global(.tpl-row-actions .button) { min-height: 36px; }
    .tpl-add { width: 100%; min-height: 44px; }
  }

  /* Picture presets: the Templates rules above, plus a switch in each treatment's legend, the sliders and the preview. */
  .tpl-group legend .checkbox-label { display: inline-flex; align-items: center; gap: 0.4rem; font-weight: 600; cursor: pointer; }
  .pp-steps { display: grid; gap: 1rem; }
  .pp-steps[hidden], .pp-body[hidden], #pp_point_box[hidden], #pp_aspect_other_box[hidden],
  #pp_json_box[hidden], #tpl_treated_role_box[hidden], #tpl_preset_help[hidden] { display: none; }
  .pp-body { display: grid; gap: 0.75rem; }
  .pp-radios {
    display: grid;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }
  .pp-radios legend { font-size: 0.875rem; font-weight: 500; padding: 0; margin-bottom: 0.25rem; }
  .pp-sliders {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem 1rem;
  }
  .pp-sliders input[type="range"], #pp_point_box input[type="range"] { width: 100%; }
  .pp-steps output { color: var(--muted); font-variant-numeric: tabular-nums; margin-left: 0.25rem; }
  .pp-json { font-family: ui-monospace, monospace; font-size: 0.8125rem; }
  .pp-preview { display: grid; gap: 0.25rem; justify-items: start; }
  .pp-frame {
    position: relative;
    width: min(100%, 320px);
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--bg);
  }
  .pp-frame img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .pp-tint, .pp-vignette { position: absolute; inset: 0; pointer-events: none; }
  .pp-tint { mix-blend-mode: soft-light; opacity: 0; }
  @media (max-width: 640px) {
    .pp-sliders { grid-template-columns: minmax(0, 1fr); }
  }
</style>

<script>
  import { foldRecipe } from '@/lib/recipeForm';

  function syncRenderingJson() {
    const name = (document.getElementById('renderer_name') as HTMLInputElement)?.value.trim();
    const pkg = (document.getElementById('renderer_package') as HTMLInputElement)?.value.trim();
    const version = (document.getElementById('renderer_version') as HTMLInputElement)?.value.trim();
    const hidden = document.getElementById('rendering_json') as HTMLInputElement;

    if (!name && !pkg && !version) {
      hidden.value = '';
      return;
    }
    hidden.value = JSON.stringify({
      ...(name && { renderer: name }),
      ...(pkg && { package: pkg }),
      ...(version && { version }),
    });
  }

  // The hidden input is seeded with the stored capabilities so anything this form doesn't edit
  // (future keys, hand-written submission settings) survives a save instead of being rebuilt away.
  const capabilitiesHidden = document.getElementById('capabilities_json') as HTMLInputElement;
  let storedCapabilities: Record<string, unknown> = {};
  try { storedCapabilities = JSON.parse(capabilitiesHidden.value || '{}'); } catch { storedCapabilities = {}; }
  const storedSubmission = (storedCapabilities.submission ?? {}) as Record<string, unknown>;

  function readSubmissionSettings(): Record<string, unknown> {
    const out: Record<string, unknown> = { ...storedSubmission };
    for (const el of document.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[data-sub]')) {
      const key = el.dataset.sub as string;
      if (el instanceof HTMLInputElement && el.type === 'checkbox') {
        out[key] = el.checked;
      } else if (el.value.trim() === '') {
        // A cleared box means the default: drop the key (a null is refused for the ones that aren't optional, like the
        // honeypot field's name, so saving a form that never set it failed with a 422).
        delete out[key];
      } else if (el.dataset.subType === 'number') {
        out[key] = Number(el.value);
      } else {
        out[key] = el.value.trim();
      }
    }
    return out;
  }

  function syncCapabilitiesJson() {
    const submittable = (document.getElementById('cap_submittable') as HTMLInputElement).checked;
    const submissionFieldset = document.getElementById('submission-settings') as HTMLFieldSetElement | null;
    if (submissionFieldset) submissionFieldset.hidden = !submittable;
    const next: Record<string, unknown> = {
      ...storedCapabilities,
      publishable: (document.getElementById('cap_publishable') as HTMLInputElement).checked,
      submittable,
      routable: (document.getElementById('cap_routable') as HTMLInputElement).checked,
      listed: (document.getElementById('cap_listed') as HTMLInputElement).checked,
    };
    if (submittable) next.submission = readSubmissionSettings();
    capabilitiesHidden.value = JSON.stringify(next);
  }

  // Fold the prose Instructions and Voice boxes back into recipe_json on save (they're edited separately so
  // authors don't have to hand-write the "instructions" / "enrichment.voice" keys inside the JSON).
  function syncRecipeJson() {
    const instr = (document.getElementById('recipe_instructions') as HTMLTextAreaElement)?.value ?? '';
    const voice = (document.getElementById('recipe_voice') as HTMLInputElement)?.value ?? '';
    const jsonEl = document.getElementById('recipe_json') as HTMLTextAreaElement;
    const folded = foldRecipe(jsonEl.value, instr, voice);
    if (folded !== null) jsonEl.value = folded;  // invalid JSON goes as typed, for the server to reject
  }
  document.querySelector('form[action*="/update"]')?.addEventListener('submit', syncRecipeJson);

  document.getElementById('renderer_name')?.addEventListener('input', syncRenderingJson);
  document.getElementById('renderer_package')?.addEventListener('input', syncRenderingJson);
  document.getElementById('renderer_version')?.addEventListener('input', syncRenderingJson);
  document.getElementById('cap_publishable')?.addEventListener('change', syncCapabilitiesJson);
  document.getElementById('cap_submittable')?.addEventListener('change', syncCapabilitiesJson);
  document.getElementById('cap_routable')?.addEventListener('change', syncCapabilitiesJson);
  // One line under each switch says what the choice does.
  const destinationSelect = document.getElementById('sub_destination') as HTMLSelectElement | null;
  const kindSelect = document.getElementById('sub_kind') as HTMLSelectElement | null;
  function syncSubmissionHelp() {
    const help = document.getElementById('sub_destination_help');
    if (help && destinationSelect) help.textContent = help.dataset[destinationSelect.value === 'entries' ? 'entries' : 'audience'] ?? '';
    const kindHelp = document.getElementById('sub_kind_help');
    if (kindHelp && kindSelect) kindHelp.textContent = kindHelp.dataset[kindSelect.value === 'signup' ? 'signup' : 'message'] ?? '';
  }
  // Choosing where a form's submissions go sets "Show in content lists" as a default (Audience: off, Entries: on), which can
  // then be switched on its own; the server applies the same default, so this only shows it before saving.
  const listedBox = document.getElementById('cap_listed') as HTMLInputElement | null;
  const submittableBox = document.getElementById('cap_submittable') as HTMLInputElement | null;
  const wasAudienceForm = (storedCapabilities.submittable === true) && ((storedSubmission.destination ?? 'audience') !== 'entries');
  function applyDestinationDefault() {
    if (!listedBox || !destinationSelect || !submittableBox) return;
    if (submittableBox.checked) listedBox.checked = destinationSelect.value === 'entries';
    else if (wasAudienceForm) listedBox.checked = true;
    const use = document.getElementById('cap_listed_use');
    if (use) {
      const initial = use.dataset.initial ?? '';
      const signup = submittableBox.checked && kindSelect?.value === 'signup';
      const isForm = signup || (submittableBox.checked && destinationSelect.value !== 'entries');
      const where = isForm ? (signup ? 'Audience › Subscribers' : 'Audience › Submissions') : initial.startsWith('Audience › Sub') ? '' : initial;
      use.textContent = where ? ` Used by ${where}.` : '';
    }
    syncCapabilitiesJson();
  }
  destinationSelect?.addEventListener('change', applyDestinationDefault);
  kindSelect?.addEventListener('change', applyDestinationDefault);
  submittableBox?.addEventListener('change', applyDestinationDefault);
  listedBox?.addEventListener('change', syncCapabilitiesJson);
  destinationSelect?.addEventListener('change', syncSubmissionHelp);
  kindSelect?.addEventListener('change', syncSubmissionHelp);
  for (const el of document.querySelectorAll('[data-sub]')) {
    el.addEventListener('input', syncCapabilitiesJson);
    el.addEventListener('change', syncCapabilitiesJson);
  }

  const isRenderedCheckbox = document.getElementById('is_rendered') as HTMLInputElement;
  const renderingDetails = document.getElementById('rendering-details') as HTMLDetailsElement;
  const capabilitiesDetails = document.getElementById('capabilities-details') as HTMLDetailsElement;

  isRenderedCheckbox?.addEventListener('change', () => {
    if (isRenderedCheckbox.checked) {
      renderingDetails.open = true;
      capabilitiesDetails.open = true;
    } else {
      renderingDetails.open = false;
      capabilitiesDetails.open = false;
    }
  });

  syncRenderingJson();
  syncCapabilitiesJson();
</script>

<script>
  // Auto-generate slug preview from name (if not system type)
  const nameInput = document.getElementById('name') as HTMLInputElement | null;
  const slugInput = document.getElementById('slug') as HTMLInputElement | null;

  if (nameInput && slugInput && !nameInput.disabled) {
    nameInput.addEventListener('input', () => {
      const slug = nameInput.value
        .toLowerCase()
        .trim()
        .replace(/[^\w\s-]/g, '')
        .replace(/[\s_-]+/g, '-')
        .replace(/^-+|-+$/g, '');
      slugInput.value = slug;
    });
  }
</script>

<script>
  // Picture presets: the list, the editor and saving (lib/picturePresets), as the Templates script below does it. Each Save or
  // Delete sends the whole list to api/entry-types/[id]/picture-presets; the server's message is shown here (also its
  // "a template names it" when a preset in use is deleted or its slug changed). After a save the Templates editor is told
  // (`picture-presets:change`), so its preset select and rows follow.
  import { slugify } from '@/lib/entryTemplates';
  import {
    GRADE_SETTINGS,
    formFits,
    formFromPreset,
    parseSteps,
    presetFromForm,
    previewLook,
    putPreset,
    sliderLabel,
    stepsFromForm,
    stepsWords,
    validateForm,
    type GradeSetting,
    type PicturePreset,
    type PresetForm,
    type PresetStep,
  } from '@/lib/picturePresets';

  const dataEl = document.getElementById('pp-data');
  const data = dataEl ? JSON.parse(dataEl.textContent || '{}') : null;
  if (data) {
    const canEdit: boolean = data.canEdit === true;
    let presets: PicturePreset[] = Array.isArray(data.presets) ? data.presets : [];
    let editing: string | null = null; // the slug being edited; null for a new preset
    let slugTouched = false;

    const listEl = document.getElementById('pp-list') as HTMLUListElement;
    const emptyEl = document.getElementById('pp-empty') as HTMLElement;
    const countEl = document.getElementById('pp-count');
    const messageEl = document.getElementById('pp-message') as HTMLElement;
    const editor = document.getElementById('pp-editor') as HTMLFormElement | null;
    const editorMessage = document.getElementById('pp-editor-message') as HTMLElement | null;
    const addButton = document.getElementById('pp-add') as HTMLButtonElement | null;
    const el = <T extends HTMLElement = HTMLInputElement>(id: string) => document.getElementById(id) as T;
    const jsonMode = () => el('pp_json_mode').checked;

    function show(target: HTMLElement | null, text: string, ok = false) {
      if (!target) return;
      target.textContent = text;
      target.classList.toggle('is-ok', ok);
      target.hidden = !text;
    }

    function announce() {
      document.dispatchEvent(new CustomEvent('picture-presets:change', { detail: presets }));
    }

    function renderList() {
      listEl.replaceChildren(
        ...presets.map((p) => {
          const li = document.createElement('li');
          li.className = 'tpl-row';
          const text = document.createElement('div');
          text.className = 'tpl-row-text';
          const name = document.createElement('div');
          name.className = 'tpl-row-name';
          name.textContent = p.name;
          const slug = document.createElement('div');
          slug.className = 'tpl-row-slug';
          slug.textContent = p.slug;
          const steps = document.createElement('div');
          steps.className = 'tpl-row-title';
          steps.textContent = `Steps: ${stepsWords(p.steps)}`;
          text.append(name, slug, steps);
          li.append(text);
          if (canEdit) {
            const actions = document.createElement('div');
            actions.className = 'tpl-row-actions';
            const edit = document.createElement('button');
            edit.type = 'button';
            edit.className = 'button secondary';
            edit.textContent = 'Edit';
            edit.addEventListener('click', () => openEditor(p));
            const del = document.createElement('button');
            del.type = 'button';
            del.className = 'button secondary danger';
            del.textContent = 'Delete';
            del.addEventListener('click', () => remove(p));
            actions.append(edit, del);
            li.append(actions);
          }
          return li;
        }),
      );
      emptyEl.hidden = presets.length > 0;
      if (countEl) countEl.textContent = String(presets.length);
    }

    function sliders() {
      return [...document.querySelectorAll<HTMLInputElement>('[data-pp-slider]')];
    }

    // A stored value the select doesn't offer (a workspace's named grade) is shown, not lost.
    function keepOption(select: HTMLSelectElement, value: string) {
      if (value && ![...select.options].some((o) => o.value === value)) select.add(new Option(value, value));
    }

    function fillEditor(form: PresetForm) {
      el('pp_name').value = form.name;
      el('pp_slug').value = form.slug;
      el('pp_description').value = form.description;
      el('pp_crop').checked = form.crop;
      el<HTMLSelectElement>('pp_aspect').value = form.aspect;
      el('pp_aspect_other').value = form.aspectOther;
      for (const radio of document.querySelectorAll<HTMLInputElement>('input[name="pp_focus"]')) radio.checked = radio.value === form.focus;
      el('pp_focus_x').value = String(form.focusX);
      el('pp_focus_y').value = String(form.focusY);
      el('pp_resize').checked = form.resize;
      el('pp_width').value = form.width;
      el('pp_height').value = form.height;
      el<HTMLSelectElement>('pp_fit').value = form.fit;
      el('pp_grade').checked = form.grade;
      const grade = el<HTMLSelectElement>('pp_grade_preset');
      keepOption(grade, form.gradePreset);
      grade.value = form.gradePreset;
      for (const input of sliders()) input.value = String(form[input.dataset.ppSlider as keyof PresetForm]);
      el<HTMLSelectElement>('pp_format').value = form.format;
      el('pp_quality').value = form.quality;
    }

    function readEditor(): PresetForm {
      const form = {
        name: el('pp_name').value,
        slug: el('pp_slug').value,
        description: el('pp_description').value,
        crop: el('pp_crop').checked,
        aspect: el<HTMLSelectElement>('pp_aspect').value,
        aspectOther: el('pp_aspect_other').value,
        focus: (document.querySelector<HTMLInputElement>('input[name="pp_focus"]:checked')?.value ?? 'center') as PresetForm['focus'],
        focusX: Number(el('pp_focus_x').value),
        focusY: Number(el('pp_focus_y').value),
        resize: el('pp_resize').checked,
        width: el('pp_width').value,
        height: el('pp_height').value,
        fit: el<HTMLSelectElement>('pp_fit').value === 'cover' ? 'cover' : 'inside',
        grade: el('pp_grade').checked,
        gradePreset: el<HTMLSelectElement>('pp_grade_preset').value,
        format: el<HTMLSelectElement>('pp_format').value,
        quality: el('pp_quality').value,
      } as PresetForm;
      for (const s of GRADE_SETTINGS) form[s] = Number(el(`pp_${s}`).value);
      return form;
    }

    /** The steps being edited: from the JSON box in JSON mode (null while it doesn't read), else from the form. */
    function currentSteps(): PresetStep[] | null {
      if (!jsonMode()) return stepsFromForm(readEditor(), storedPreset());
      const parsed = parseSteps(el<HTMLTextAreaElement>('pp_json').value);
      return 'steps' in parsed ? parsed.steps : null;
    }

    function storedPreset() {
      return editing == null ? null : presets.find((p) => p.slug === editing) ?? null;
    }

    /** Show what is switched on, the slider values, the steps in words and the preview. */
    function refresh() {
      const json = jsonMode();
      el('pp_steps').hidden = json;
      el('pp_json_box').hidden = !json;
      for (const toggle of document.querySelectorAll<HTMLInputElement>('[data-pp-toggle]')) {
        const body = document.querySelector<HTMLElement>(`[data-pp-body="${toggle.id}"]`);
        if (body) body.hidden = !toggle.checked;
      }
      el('pp_aspect_other_box').hidden = el<HTMLSelectElement>('pp_aspect').value !== 'other';
      el('pp_point_box').hidden = document.querySelector<HTMLInputElement>('input[name="pp_focus"]:checked')?.value !== 'point';
      el('pp_quality').disabled = !el<HTMLSelectElement>('pp_format').value;
      el<HTMLOutputElement>('pp_focus_x_out').value = el('pp_focus_x').value;
      el<HTMLOutputElement>('pp_focus_y_out').value = el('pp_focus_y').value;
      for (const input of sliders()) {
        el<HTMLOutputElement>(`${input.id}_out`).value = sliderLabel(input.dataset.ppSlider as GradeSetting, Number(input.value));
      }
      const steps = currentSteps();
      el('pp_words').textContent = steps == null ? '' : steps.length ? `Steps: ${stepsWords(steps)}` : 'Nothing switched on yet.';
      const img = document.getElementById('pp_preview_img') as HTMLImageElement | null;
      if (img && steps) {
        const look = previewLook(steps);
        el('pp_frame').style.aspectRatio = look.aspectRatio ?? '';
        img.style.height = look.aspectRatio ? '100%' : 'auto';
        img.style.objectPosition = look.objectPosition;
        img.style.filter = look.filter;
        const tint = el('pp_tint');
        tint.style.background = look.tint?.color ?? 'transparent';
        tint.style.opacity = String(look.tint?.opacity ?? 0);
        el('pp_vignette').style.background = look.vignette
          ? `radial-gradient(ellipse at center, transparent 45%, rgb(0 0 0 / ${look.vignette}) 100%)`
          : 'none';
      }
    }

    /** JSON mode on: the box gets the steps as they are. Off: back to the form, only when the steps fit it. */
    function setJsonMode(on: boolean, steps?: PresetStep[]) {
      const box = el<HTMLTextAreaElement>('pp_json');
      if (on) {
        box.value = JSON.stringify(steps ?? stepsFromForm(readEditor(), storedPreset()), null, 2);
        el('pp_json_mode').checked = true;
      } else {
        const parsed = parseSteps(box.value);
        if ('error' in parsed || !formFits(parsed.steps)) {
          el('pp_json_mode').checked = true;
          show(
            el('pp_json_note'),
            'error' in parsed
              ? `${parsed.error} Fix it to go back to the form.`
              : "These steps don't fit the form (a treatment twice, out of the form's order, or a value its controls can't hold), so they stay as JSON.",
          );
          return;
        }
        const form = formFromPreset({ slug: '', name: '', steps: parsed.steps });
        const kept = readEditor();
        fillEditor({ ...form, name: kept.name, slug: kept.slug, description: kept.description });
        el('pp_json_mode').checked = false;
        show(el('pp_json_note'), '');
      }
      refresh();
    }

    function openEditor(preset: PicturePreset | null) {
      if (!editor) return;
      editing = preset ? preset.slug : null;
      slugTouched = preset != null;
      fillEditor(formFromPreset(preset));
      const fits = !preset || formFits(preset.steps);
      el('pp_json_mode').checked = false;
      show(el('pp_json_note'), '');
      if (!fits && preset) {
        setJsonMode(true, preset.steps);
        show(
          el('pp_json_note'),
          "This preset's steps don't fit the form (a treatment twice, out of the form's order, or a value its controls can't hold), so they are shown as JSON to keep them as they are.",
        );
      }
      (document.getElementById('pp-editor-title') as HTMLElement).textContent = preset ? `Edit ${preset.name}` : 'New picture preset';
      show(editorMessage, '');
      show(messageEl, '');
      refresh();
      editor.hidden = false;
      if (addButton) addButton.hidden = true;
      editor.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
      el('pp_name').focus({ preventScroll: true });
    }

    function closeEditor() {
      if (!editor) return;
      editor.hidden = true;
      editing = null;
      if (addButton) addButton.hidden = false;
    }

    /** Send the whole list; true when the server took it (and the list is then what it stored). */
    async function save(next: PicturePreset[], messageTarget: HTMLElement | null): Promise<boolean> {
      show(messageTarget, '');
      try {
        const res = await fetch(`/api/entry-types/${encodeURIComponent(data.id)}/picture-presets`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ presets: next }),
        });
        const body = await res.json().catch(() => ({}));
        if (!res.ok) {
          show(messageTarget, body.error || `The picture presets could not be saved (${res.status}).`);
          return false;
        }
        presets = Array.isArray(body.presets) ? body.presets : next;
        renderList();
        announce();
        return true;
      } catch {
        show(messageTarget, 'The picture presets could not be saved: no answer from the server.');
        return false;
      }
    }

    async function remove(preset: PicturePreset) {
      if (!confirm(`Delete the picture preset "${preset.name}"? Pictures already made with it are kept.`)) return;
      if (await save(presets.filter((p) => p.slug !== preset.slug), messageEl)) {
        if (editing === preset.slug) closeEditor();
        show(messageEl, `Deleted "${preset.name}".`, true);
      }
    }

    if (editor) {
      addButton?.addEventListener('click', () => openEditor(null));
      el('pp-cancel').addEventListener('click', closeEditor);
      el('pp_json_mode').addEventListener('change', () => setJsonMode(el('pp_json_mode').checked));
      editor.addEventListener('input', refresh);
      editor.addEventListener('change', refresh);
      el('pp_name').addEventListener('input', () => {
        if (!slugTouched) el('pp_slug').value = slugify(el('pp_name').value);
      });
      el('pp_slug').addEventListener('input', () => {
        slugTouched = el('pp_slug').value !== '';
      });
      editor.addEventListener('submit', async (event) => {
        event.preventDefault();
        const form = readEditor();
        const stored = storedPreset();
        let preset: PicturePreset;
        if (jsonMode()) {
          const parsed = parseSteps(el<HTMLTextAreaElement>('pp_json').value);
          // The name and slug are checked as the form checks them; the steps by the server.
          const errors = validateForm({ ...form, crop: false, resize: false, grade: false, format: 'jpeg', quality: '' });
          if ('error' in parsed) errors.push(parsed.error);
          if (errors.length) return show(editorMessage, errors.join(' '));
          preset = { ...presetFromForm(form, stored), steps: 'steps' in parsed ? parsed.steps : [] };
        } else {
          const errors = validateForm(form);
          if (errors.length) return show(editorMessage, errors.join(' '));
          preset = presetFromForm(form, stored);
        }
        const saveButton = el<HTMLButtonElement>('pp-save');
        saveButton.disabled = true;
        const ok = await save(putPreset(presets, preset, editing), editorMessage);
        saveButton.disabled = false;
        if (ok) {
          closeEditor();
          show(messageEl, `Saved "${preset.name}".`, true);
        }
      });
    }

    renderList();
  }
</script>

<script>
  // Templates: the list, the editor and saving (lib/entryTemplates). Each Save or Delete sends the whole list to
  // api/entry-types/[id]/templates; the server checks it against the saved schema and its message is shown here.
  import {
    formFromTemplate,
    putTemplate,
    renderPattern,
    sampleValues,
    slugify,
    templateFromForm,
    unknownVariables,
    type EntryTemplate,
    type SchemaField,
    type TemplateForm,
  } from '@/lib/entryTemplates';

  const dataEl = document.getElementById('tpl-data');
  const data = dataEl ? JSON.parse(dataEl.textContent || '{}') : null;
  if (data) {
    const fields: SchemaField[] = data.fields ?? [];
    const canEdit: boolean = data.canEdit === true;
    const sample = sampleValues(data.sample);
    let templates: EntryTemplate[] = Array.isArray(data.templates) ? data.templates : [];
    let editing: string | null = null; // the slug being edited; null for a new template
    // The type's picture presets (#pp-data), kept current by the Picture presets script above as they are saved.
    const presetsEl = document.getElementById('pp-data');
    let presets: { slug: string; name: string }[] = (() => {
      const list = presetsEl ? JSON.parse(presetsEl.textContent || '{}').presets : null;
      return Array.isArray(list) ? list : [];
    })();
    let slugTouched = false;

    const listEl = document.getElementById('tpl-list') as HTMLUListElement;
    const emptyEl = document.getElementById('tpl-empty') as HTMLElement;
    const countEl = document.getElementById('tpl-count');
    const messageEl = document.getElementById('tpl-message') as HTMLElement;
    const editor = document.getElementById('tpl-editor') as HTMLFormElement | null;
    const editorMessage = document.getElementById('tpl-editor-message') as HTMLElement | null;
    const addButton = document.getElementById('tpl-add') as HTMLButtonElement | null;
    const input = (id: string) => document.getElementById(id) as HTMLInputElement;
    const nameInput = input('tpl_name');
    const slugInput = input('tpl_slug');
    const titleInput = input('tpl_title');

    function show(el: HTMLElement | null, text: string, ok = false) {
      if (!el) return;
      el.textContent = text;
      el.classList.toggle('is-ok', ok);
      el.hidden = !text;
    }

    function renderList() {
      listEl.replaceChildren(
        ...templates.map((t) => {
          const li = document.createElement('li');
          li.className = 'tpl-row';
          const text = document.createElement('div');
          text.className = 'tpl-row-text';
          const name = document.createElement('div');
          name.className = 'tpl-row-name';
          name.textContent = t.name;
          const slug = document.createElement('div');
          slug.className = 'tpl-row-slug';
          slug.textContent = t.slug;
          const title = document.createElement('div');
          title.className = 'tpl-row-title';
          const code = document.createElement('code');
          code.textContent = t.title || '{asset.name}';
          title.append('Title: ', code);
          if (t.picturePreset) {
            const preset = presets.find((p) => p.slug === t.picturePreset);
            title.append(` · treated with ${preset?.name ?? t.picturePreset}`);
          }
          text.append(name, slug, title);
          li.append(text);
          if (canEdit) {
            const actions = document.createElement('div');
            actions.className = 'tpl-row-actions';
            const edit = document.createElement('button');
            edit.type = 'button';
            edit.className = 'button secondary';
            edit.textContent = 'Edit';
            edit.addEventListener('click', () => openEditor(t));
            const del = document.createElement('button');
            del.type = 'button';
            del.className = 'button secondary danger';
            del.textContent = 'Delete';
            del.addEventListener('click', () => remove(t));
            actions.append(edit, del);
            li.append(actions);
          }
          return li;
        }),
      );
      emptyEl.hidden = templates.length > 0;
      if (countEl) countEl.textContent = String(templates.length);
    }

    function renderPreview() {
      const pattern = titleInput.value.trim() || '{asset.name}';
      const preview = document.getElementById('tpl_title_preview') as HTMLElement;
      const strong = document.createElement('strong');
      strong.textContent = renderPattern(pattern, sample);
      const from = data.sample ? 'the newest picture in the library' : 'a sample picture';
      preview.replaceChildren('Preview: ', strong, ` (${from}, ${sample['asset.filename']}, entry 1, today)`);
      const unknown = unknownVariables(pattern);
      show(
        document.getElementById('tpl_title_warning'),
        unknown.length
          ? `${unknown.map((v) => `{${v}}`).join(', ')} ${unknown.length > 1 ? 'are not variables' : 'is not a variable'}: use {asset.name}, {asset.filename}, {n} or {date}. The template can't be saved with it.`
          : '',
      );
    }

    function fieldInputs() {
      return [...document.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('[data-tpl-field]')];
    }

    function collectionBoxes() {
      return [...document.querySelectorAll<HTMLInputElement>('#tpl_collections input[type="checkbox"]')];
    }

    function fillEditor(form: TemplateForm) {
      nameInput.value = form.name;
      slugInput.value = form.slug;
      input('tpl_description').value = form.description;
      titleInput.value = form.title;
      (document.getElementById('tpl_summary') as HTMLTextAreaElement).value = form.summary;
      (document.getElementById('tpl_entry_description') as HTMLTextAreaElement).value = form.entryDescription;
      (document.getElementById('tpl_status') as HTMLSelectElement).value = form.status;
      const assetField = document.getElementById('tpl_asset_field') as HTMLSelectElement;
      keepOption(assetField, form.assetField);
      assetField.value = form.assetField;
      input('tpl_asset_role').value = form.assetRole;
      fillPresetOptions(form.picturePreset);
      input('tpl_treated_role').value = form.treatedRole;
      showTreatedRole();
      input('tpl_tags').value = form.tags;
      // A collection the template names that isn't a hand-picked one here (a package's) gets a box of its own, kept until unticked.
      const box = document.getElementById('tpl_collections') as HTMLElement;
      box.querySelectorAll('.tpl-extra').forEach((el) => el.remove());
      for (const slug of form.collections) {
        if (collectionBoxes().some((b) => b.value === slug)) continue;
        const label = document.createElement('label');
        label.className = 'checkbox-label tpl-extra';
        const cb = document.createElement('input');
        cb.type = 'checkbox';
        cb.value = slug;
        label.append(cb, ` ${slug}`);
        box.append(label);
      }
      for (const cb of collectionBoxes()) cb.checked = form.collections.includes(cb.value);
      for (const el of fieldInputs()) {
        const value = form.fields[el.dataset.tplField as string] ?? '';
        if (el instanceof HTMLSelectElement) keepOption(el, value);
        el.value = value;
      }
    }

    /** The preset select lists the type's presets by name, with `chosen` picked (shown even when it is no longer there). */
    function fillPresetOptions(chosen = (document.getElementById('tpl_picture_preset') as HTMLSelectElement | null)?.value ?? '') {
      const select = document.getElementById('tpl_picture_preset') as HTMLSelectElement | null;
      if (!select) return;
      select.replaceChildren(new Option('None', ''), ...presets.map((p) => new Option(p.name, p.slug)));
      keepOption(select, chosen);
      select.value = chosen;
    }

    /** The role box and the help line show only when a preset is picked. */
    function showTreatedRole() {
      const picked = !!(document.getElementById('tpl_picture_preset') as HTMLSelectElement | null)?.value;
      for (const id of ['tpl_treated_role_box', 'tpl_preset_help']) {
        const box = document.getElementById(id);
        if (box) box.hidden = !picked;
      }
    }

    // A stored value the select doesn't offer (an option since removed) is shown, not lost.
    function keepOption(select: HTMLSelectElement, value: string) {
      if (value && ![...select.options].some((o) => o.value === value)) select.add(new Option(value, value));
    }

    function readEditor(): TemplateForm {
      const fieldValues: Record<string, string> = {};
      for (const el of fieldInputs()) fieldValues[el.dataset.tplField as string] = el.value;
      return {
        name: nameInput.value,
        slug: slugInput.value,
        description: input('tpl_description').value,
        title: titleInput.value,
        summary: (document.getElementById('tpl_summary') as HTMLTextAreaElement).value,
        entryDescription: (document.getElementById('tpl_entry_description') as HTMLTextAreaElement).value,
        status: (document.getElementById('tpl_status') as HTMLSelectElement).value,
        assetField: (document.getElementById('tpl_asset_field') as HTMLSelectElement).value,
        assetRole: input('tpl_asset_role').value,
        picturePreset: (document.getElementById('tpl_picture_preset') as HTMLSelectElement).value,
        treatedRole: input('tpl_treated_role').value,
        tags: input('tpl_tags').value,
        collections: collectionBoxes().filter((cb) => cb.checked).map((cb) => cb.value),
        fields: fieldValues,
      };
    }

    function openEditor(template: EntryTemplate | null) {
      if (!editor) return;
      editing = template ? template.slug : null;
      slugTouched = template != null;
      fillEditor(formFromTemplate(template, fields));
      (document.getElementById('tpl-editor-title') as HTMLElement).textContent = template ? `Edit ${template.name}` : 'New template';
      show(editorMessage, '');
      show(messageEl, '');
      renderPreview();
      editor.hidden = false;
      if (addButton) addButton.hidden = true;
      editor.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
      nameInput.focus({ preventScroll: true });
    }

    function closeEditor() {
      if (!editor) return;
      editor.hidden = true;
      editing = null;
      if (addButton) addButton.hidden = false;
    }

    /** Send the whole list; true when the server took it (and the list is then what it stored). */
    async function save(next: EntryTemplate[], messageTarget: HTMLElement | null): Promise<boolean> {
      show(messageTarget, '');
      try {
        const res = await fetch(`/api/entry-types/${encodeURIComponent(data.id)}/templates`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ templates: next }),
        });
        const body = await res.json().catch(() => ({}));
        if (!res.ok) {
          show(messageTarget, body.error || `The templates could not be saved (${res.status}).`);
          return false;
        }
        templates = Array.isArray(body.templates) ? body.templates : next;
        renderList();
        return true;
      } catch {
        show(messageTarget, 'The templates could not be saved: no answer from the server.');
        return false;
      }
    }

    async function remove(template: EntryTemplate) {
      if (!confirm(`Delete the template "${template.name}"?`)) return;
      if (await save(templates.filter((t) => t.slug !== template.slug), messageEl)) {
        if (editing === template.slug) closeEditor();
        show(messageEl, `Deleted "${template.name}".`, true);
      }
    }

    if (editor) {
      addButton?.addEventListener('click', () => openEditor(null));
      document.getElementById('tpl-cancel')?.addEventListener('click', closeEditor);
      titleInput.addEventListener('input', renderPreview);
      document.getElementById('tpl_picture_preset')?.addEventListener('change', showTreatedRole);
      nameInput.addEventListener('input', () => {
        if (!slugTouched) slugInput.value = slugify(nameInput.value);
      });
      slugInput.addEventListener('input', () => {
        slugTouched = slugInput.value !== '';
      });
      editor.addEventListener('submit', async (event) => {
        event.preventDefault();
        const stored = editing == null ? null : templates.find((t) => t.slug === editing) ?? null;
        const template = templateFromForm(readEditor(), fields, stored);
        const saveButton = document.getElementById('tpl-save') as HTMLButtonElement;
        saveButton.disabled = true;
        const ok = await save(putTemplate(templates, template, editing), editorMessage);
        saveButton.disabled = false;
        if (ok) {
          closeEditor();
          show(messageEl, `Saved "${template.name}".`, true);
        }
      });
    }

    document.addEventListener('picture-presets:change', (event) => {
      const list = (event as CustomEvent).detail;
      presets = Array.isArray(list) ? list : [];
      fillPresetOptions();
      renderList();
    });

    renderList();
  }
</script>
