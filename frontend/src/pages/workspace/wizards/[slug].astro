---
import AudioRecorder from "@/components/AudioRecorder.astro";
import FileDrop from "@/components/FileDrop.astro";
import PlayButton from "@/components/PlayButton.astro";
import SchemaForm from "@/components/SchemaForm.astro";
import AppLayout from "@/layouts/AppLayout.astro";
import { acceptKind, acceptsAudio } from "@/lib/acceptKind";
import { getAuthToken } from "@/lib/api/client";
import { type RefOption, withCurrent } from "@/lib/refFields";
import { refOptionsFor } from "@/lib/refFieldsApi";
import { getWizard, type WizardRead } from "@/lib/api/wizards";
import { viewHref } from "@/lib/api/views";
import {
  type ApprovalCard, type Check, type Ctx, type Step, NOTICE_PARAM, NOTICES, SIMPLE_FIELD_TYPES, approvalsOf, blocker, checkSpec, inputKeys, chooseSpec, currentStep, entryTypeOf, hasValue, listSpec, nextStep, optionStepOf, passes, previousStep, readCtx, suppliedData,
  StepError, cardAudio, cardPicture, galleryAccept, generateAsRun, isDone, shownSteps, stepHref,
} from "@/lib/wizard";
import { runStep } from "@/lib/wizardActions";
import { type Row, type WorkflowState, MAX_DECIDED_SHOWN, approvalCards, askedKeys, decideApproval, describeFailure, entryOfType, findEntries, typeBySlug, workflowState } from "@/lib/wizardApi";

const authToken = getAuthToken(Astro.cookies);
const slug = Astro.params.slug ?? "";

let wizard: WizardRead | null = null;
let problem: string | null = authToken ? null : "Sign in to use this guided setup.";
let stepProblem: string | null = null; // what went wrong with the step just posted: shown inside its card
let badFields: string[] = []; // the inputs it is about
const bad = (name: string) => (badFields.includes(name) ? "invalid" : undefined);
if (authToken) {
  try {
    wizard = await getWizard(slug, authToken);
  } catch (e) {
    problem = describeFailure(e);
  }
}
const def = wizard?.definition ?? null;
const notice = NOTICES[Astro.url.searchParams.get(NOTICE_PARAM) ?? ""] ?? null;

// The address is only trusted once checked: each choice must be an entry of the type its step picks (or one of an option's values), or it
// is dropped, so a stale or crafted link cannot point a later step at something else.
const entries: Record<string, Row> = {};
async function checkedCtx(raw: Ctx): Promise<Ctx> {
  if (!def || !authToken) return {};
  const out: Ctx = {};
  for (const [key, value] of Object.entries(raw)) {
    const type = entryTypeOf(def, key);
    if (type) {
      const found = await entryOfType(type, value, authToken);
      if (found) {
        out[key] = value;
        entries[key] = found;
      }
    } else if (optionStepOf(def, key)?.options?.some((o: { value: string }) => o.value === value)) {
      out[key] = value;
    }
  }
  return out;
}
const ctx = await checkedCtx(readCtx(Astro.url.searchParams));
const step: Step | null = def ? currentStep(def, ctx, Astro.url.searchParams.get("step")) : null;

if (Astro.request.method === "POST" && authToken && def && step) {
  try {
    const form = await Astro.request.formData();
    const deciding = String(form.get("decide") ?? "");
    if (deciding) {
      const decision = form.get("decision") === "deny" ? "deny" : "approve";
      const choice = String(form.get("choice") ?? "").trim() || null;
      await decideApproval(deciding, decision, choice, String(form.get("note") ?? "").trim() || null, authToken);
      return Astro.redirect(stepHref(slug, ctx, step.id, { [NOTICE_PARAM]: decision === "deny" ? "denied" : choice ? "chosen" : "approved" }));
    }
    const done = await runStep(def, step, form, ctx, authToken);
    const target = done.stay ? step : (nextStep(def, done.ctx, step.id) ?? step);
    return Astro.redirect(stepHref(slug, done.ctx, target.id, done.notice ? { [NOTICE_PARAM]: done.notice } : {}));
  } catch (e) {
    stepProblem = describeFailure(e);
    badFields = e instanceof StepError ? e.fields : [];
  }
}

// What the current step draws.
const fieldsOf = (type: Awaited<ReturnType<typeof typeBySlug>>, keys: string[]) =>
  (((type?.schemaJson as { fields?: any[] } | null)?.fields ?? []) as any[]).filter((f) => keys.includes(f.key));
const simple = (fields: any[]) => fields.filter((f) => SIMPLE_FIELD_TYPES.includes(f.type));
let choices: Row[] = [];
let listRows: Row[] = [];
let entry: Row | null = null;
let typeName = "";
let missingType = false;
let formFields: any[] = [];
let leftOut: any[] = [];
let checks: { label: string; ok: boolean; count: number; step?: Step | null }[] = [];
let columns: any[] = [];
let flow: WorkflowState = { found: true, enabled: true };
let pendingCards: ApprovalCard[] = [];
let decidedCards: ApprovalCard[] = [];
let watchIds: string[] = [];
let lacking: string | null = null; // a run step's `requires` not met
let cards: Row[] = [];
let addFields: any[] = [];
let genStep: Step | null = null; // a gallery's generate action, as the run step it is
// A shown text field that holds another entry's slug (`ref`) is a pick list. In a wizard the list is narrowed by the entries chosen so
// far that the referenced type has a field for (a cast member's actor comes from the chosen world's troupe, not every actor).
let refs: Record<string, RefOption[]> = {};
const refsFor = (fields: any[]) => refOptionsFor({ fields }, authToken, ctx);

// Drawn whatever happened to a post: an error shows above a complete page, never an empty one.
if (authToken && def && step) {
  if (step.kind === "choose" || step.kind === "list") {
    const type = await typeBySlug(step.entry_type, authToken);
    missingType = !type;
    typeName = type?.name ?? step.entry_type;
    if (step.kind === "choose") {
      choices = (await findEntries(chooseSpec(step, ctx), authToken)).entries;
      formFields = simple(fieldsOf(type, askedKeys(type, step.create?.fields, Object.keys(suppliedData(step, ctx)))));
      refs = await refsFor(formFields);
    } else {
      listRows = (await findEntries(listSpec(step, ctx), authToken)).entries;
      columns = simple(fieldsOf(type, askedKeys(type, step.columns, Object.keys(suppliedData(step, ctx))))).filter((f) => f.type !== "boolean");
      refs = await refsFor(columns);
    }
  } else if (step.kind === "form" || step.kind === "upload") {
    entry = entries[step.entry] ?? null;
    if (step.kind === "form") {
      const type = await typeBySlug(entryTypeOf(def, step.entry), authToken);
      const all = fieldsOf(type, step.fields);
      formFields = simple(all);
      leftOut = all.filter((f) => !SIMPLE_FIELD_TYPES.includes(f.type));
      refs = await refsFor(formFields);
    }
  } else if (step.kind === "gallery") {
    const type = await typeBySlug(step.entry_type, authToken);
    missingType = !type;
    typeName = type?.name ?? step.entry_type;
    cards = (await findEntries(listSpec(step, ctx), authToken)).entries;
    addFields = simple(fieldsOf(type, askedKeys(type, step.add?.fields, Object.keys(suppliedData(step, ctx)))));
    refs = await refsFor(addFields);
    if (step.generate) {
      genStep = generateAsRun(step, undefined).run;
      flow = await workflowState(genStep.workflow, authToken);
      const about = inputKeys(genStep).map((k) => entries[k]).filter((e): e is Row => !!e).map((e) => e.id);
      watchIds = about;
      const all = await approvalCards(authToken);
      pendingCards = approvalsOf(all.pending, genStep.workflow, about);
      decidedCards = approvalsOf(all.decided, genStep.workflow, about).slice(0, MAX_DECIDED_SHOWN);
    }
  } else if (step.kind === "run") {
    flow = await workflowState(step.workflow, authToken);
    // The approvals this run raises are about the entries the step hands it: those are the cards shown here.
    const about = inputKeys(step).map((k) => entries[k]).filter((e): e is Row => !!e).map((e) => e.id);
    watchIds = about;
    if (step.requires) {
      const needed = entries[step.requires.entry];
      if (!needed || !hasValue(needed.dataJson?.[step.requires.field])) lacking = `“${step.requires.field}” on ${needed?.title ?? step.requires.entry} is empty: fill it in (or upload it) in an earlier step first.`;
    }
    const cards = await approvalCards(authToken);
    pendingCards = approvalsOf(cards.pending, step.workflow, about);
    decidedCards = approvalsOf(cards.decided, step.workflow, about).slice(0, MAX_DECIDED_SHOWN);
  } else if (step.kind === "review") {
    checks = await Promise.all(
      (step.checks as (Check & { step?: string })[]).map(async (c) => {
        const count = (await findEntries(checkSpec(c, ctx), authToken, 1)).total;
        return { label: c.label, ok: passes(c.op, count, c.value), count, step: c.step ? def.steps.find((s) => s.id === c.step) : null };
      }),
    );
  }
}

const steps = def ? shownSteps(def, ctx) : [];
const here = step ? steps.findIndex((s) => s.id === step.id) : -1;
const before = def && step ? previousStep(def, ctx, step.id) : null;
const after = def && step ? nextStep(def, ctx, step.id) : null;
const allPass = checks.length > 0 && checks.every((c) => c.ok);
// A run step with a card waiting holds the later steps: answering first keeps the card from going stale (an entry edited after the
// question was asked makes the approval count as neither yes nor no).
const held = (step?.kind === "run" || step?.kind === "gallery") && pendingCards.length > 0;
const made = Object.entries(entries).map(([key, e]) => ({ key, ...e }));
const opened = def?.open ? entries[def.open.entry] ?? null : null;
const submitLabel = after ? "Continue" : "Save";
// A column heading is the field's label without its explanation in brackets (the full label stays as the hover text).
const shortLabel = (label: string) => label.replace(/\s*\(.*\)\s*$/, "") || label;
const uploadAccept = step?.kind === "gallery" && step.upload ? galleryAccept(step) : null;
const uploadNoun = { audio: "sound", image: "picture", file: "file" }[acceptKind(uploadAccept)];
// A sound can be recorded instead of picked (the drop zone's Record button): the recorder is on the page once, when the step takes one.
const takesRecording = acceptsAudio(step?.kind === "upload" ? step.accept : uploadAccept);
---

<AppLayout crumb="workspace.wizards.run" title={wizard?.name ?? "Guided setup"} width="page">
  <div class="page-header">
    <h2>{wizard?.name ?? "Guided setup"}</h2>
    {wizard?.description && <p>{wizard.description}</p>}
  </div>

  {problem && <div class="alert alert-error">{problem}</div>}
  {notice && !problem && <div class="alert alert-info">{notice}</div>}
  {!problem && !wizard && <div class="alert alert-info">There is no guided setup called “{slug}” here. <a href="/workspace/wizards">See the ones there are.</a></div>}

  {
    def && step && (
      <>
        <ol class="stepper" aria-label="Steps">
          {steps.map((s, i) => (
            <li class:list={[i === here && "current", i < here && "past", isDone(s, ctx) && "done"]}>
              {blocker(def, ctx, s.id) || (held && i > here) ? (
                <span class="wait" title="Answer the steps before it first"><span class="n">{i + 1}</span><span class="t">{s.title}</span></span>
              ) : (
                <a href={stepHref(slug, ctx, s.id)} aria-current={i === here ? "step" : undefined}>
                  <span class="n" aria-hidden="true">{isDone(s, ctx) && i !== here ? "✓" : i + 1}</span>
                  <span class="t">{s.title}</span>
                </a>
              )}
            </li>
          ))}
        </ol>

        <section class="card step">
          <p class="eyebrow">Step {here + 1} of {steps.length}</p>
          <h3>{step.title}</h3>
          {step.help && <p class="help">{step.help}</p>}
          {stepProblem && <div class="step-error" role="alert">{stepProblem}</div>}

          {step.kind === "option" && (
            <form method="post" class="form">
              <div class="choices">
                {step.options.map((o: { value: string; label: string }) => (
                  <label class="choice">
                    <input type="radio" name="value" value={o.value} checked={ctx[step.as] === o.value} required /> {o.label}
                  </label>
                ))}
              </div>
              <div class="actions"><button class="button" type="submit">{submitLabel}</button></div>
            </form>
          )}

          {step.kind === "choose" && (
            <div class="form">
              {missingType && <div class="alert alert-info">This workspace has no “{step.entry_type}” entry type yet, so there is nothing to pick. Install the package’s types first.</div>}
              {choices.length > 0 && (
                <form method="post" class="form">
                  <input type="hidden" name="action" value="pick" />
                  <p class="label">Pick one you have</p>
                  {step.picture ? (
                    <div class="tiles" role="radiogroup">
                      {choices.map((c) => {
                        const pic = cardPicture(c.assets, step.picture);
                        return (
                          <label class="tile">
                            <input type="radio" name="pick" value={c.slug} checked={ctx[step.as] === c.slug} />
                            <span class="tpic">{pic ? <img src={pic} alt="" loading="lazy" /> : <span class="gnone" aria-hidden="true">{(c.title || "?").slice(0, 1)}</span>}</span>
                            <strong>{c.title}</strong>
                            {step.subtitle && c.dataJson?.[step.subtitle] && <span class="muted gsub">{String(c.dataJson[step.subtitle]).slice(0, 60)}</span>}
                          </label>
                        );
                      })}
                    </div>
                  ) : (
                    <div class="choices">
                      {choices.map((c) => (
                        <label class="choice">
                          <input type="radio" name="pick" value={c.slug} checked={ctx[step.as] === c.slug} /> {c.title}
                        </label>
                      ))}
                    </div>
                  )}
                  <div class="actions"><button class="button" type="submit">Use this {typeName.toLowerCase()}</button></div>
                </form>
              )}
              {step.create && !missingType && (
                <form method="post" class="form">
                  <input type="hidden" name="action" value="create" />
                  <fieldset class="create">
                    <legend>{choices.length > 0 ? "Or make a new one" : `Make a new ${typeName.toLowerCase()}`}</legend>
                    <div class="form-group">
                      <label for="create_title">Name <span class="req" title="Required">*</span></label>
                      <input class:list={["input", bad("create_title")]} id="create_title" name="create_title" required />
                    </div>
                    <SchemaForm schema={{ fields: formFields }} refs={refs} />
                    <div class="actions"><button class="button secondary" type="submit">Create and continue</button></div>
                  </fieldset>
                </form>
              )}
              {step.optional && (
                <form method="post" class="actions">
                  <input type="hidden" name="action" value="skip" />
                  <button class="button secondary" type="submit">Skip this</button>
                </form>
              )}
            </div>
          )}

          {step.kind === "form" && (
            entry ? (
              <form method="post" class="form">
                <SchemaForm schema={{ fields: formFields }} values={entry.dataJson ?? {}} refs={refs} />
                {leftOut.length > 0 && <p class="muted">{leftOut.map((f) => f.label).join(", ")} can be edited in the <a href={`/workspace/entries/${entry.id}`}>entry itself</a>.</p>}
                <div class="actions"><button class="button" type="submit">{submitLabel}</button></div>
              </form>
            ) : <div class="alert alert-info">Choose the {step.entry} in an earlier step first.</div>
          )}

          {step.kind === "upload" && (
            entry ? (
              <form method="post" class="form" enctype="multipart/form-data">
                <p class="muted">
                  {step.mode === "text" ? `Its text goes into “${step.field}” on ${entry.title}.` : `The file is kept as an asset in “${step.field}” on ${entry.title}.`}
                </p>
                {hasValue(entry.dataJson?.[step.field]) && (
                  <div class="alert alert-info replace">
                    <strong>{entry.title} already has {step.mode === "text" ? `a ${step.field} (${String(entry.dataJson?.[step.field]).length.toLocaleString()} characters)` : `something in ${step.field}`}.</strong>
                    Uploading replaces it, and this page cannot bring it back.
                    <label class="choice"><input type="checkbox" name="replace" value="1" required /> Replace it</label>
                  </div>
                )}
                <FileDrop accept={(step.accept ?? []).join(",") || undefined} hint={step.accept?.length ? `One ${step.accept.join(", ")} file.` : "One file."} />
                <div class="actions">
                  <button class="button" type="submit">Upload</button>
                  {after && <a class="button secondary" href={stepHref(slug, ctx, after.id)}>Skip</a>}
                </div>
              </form>
            ) : <div class="alert alert-info">Choose the {step.entry} in an earlier step first.</div>
          )}

          {step.kind === "list" && (
            <form method="post" class="form">
              {missingType && <div class="alert alert-info">This workspace has no “{step.entry_type}” entry type yet.</div>}
              {!missingType && (
                <div class="rows">
                  {listRows.length === 0 && <p class="muted none">None yet. Add the first one below.</p>}
                  {listRows.map((r) => (
                    <div class="row">
                      <div class="row-head"><a href={`/workspace/entries/${r.id}`}>{r.title}</a></div>
                      <input type="hidden" name={`row.${r.id}.__was`} value={JSON.stringify(Object.fromEntries(columns.map((c) => [c.key, r.dataJson?.[c.key] ?? null])))} />
                      <div class="cols">
                        {columns.map((c) => (
                          <label class="col" title={c.label}>
                            <span>{shortLabel(c.label)}{c.required && <span class="req" title="Required"> *</span>}</span>
                            {refs[c.key] ? (
                              <select class="input" name={`row.${r.id}.${c.key}`}>
                                <option value="">— none —</option>
                                {withCurrent(refs[c.key], r.dataJson?.[c.key]).map((o) => <option value={o.slug} selected={r.dataJson?.[c.key] === o.slug}>{o.title}</option>)}
                              </select>
                            ) : c.type === "select" ? (
                              <select class="input" name={`row.${r.id}.${c.key}`}>
                                <option value=""></option>
                                {(c.options ?? []).map((o: string) => <option value={o} selected={r.dataJson?.[c.key] === o}>{o}</option>)}
                              </select>
                            ) : c.type === "textarea" || c.type === "markdown" ? (
                              <textarea class="input" rows="2" name={`row.${r.id}.${c.key}`}>{r.dataJson?.[c.key] ?? ""}</textarea>
                            ) : (
                              <input class="input" type={c.type === "number" ? "number" : "text"} name={`row.${r.id}.${c.key}`} value={r.dataJson?.[c.key] ?? ""} />
                            )}
                          </label>
                        ))}
                      </div>
                    </div>
                  ))}
                  {step.add !== false && (
                    <div class="row new">
                      <label class="col row-head">
                        <span>{listRows.length ? "Add another" : "Add one"} <span class="req" title="Required">*</span></span>
                        <input class:list={["input", bad("new.title")]} name="new.title" placeholder="Name" />
                      </label>
                      <div class="cols">
                        {columns.map((c) => (
                          <label class="col" title={c.label}>
                            <span>{shortLabel(c.label)}{c.required && <span class="req" title="Required"> *</span>}</span>
                            {refs[c.key] ? (
                              <select class:list={["input", bad(`new.${c.key}`)]} name={`new.${c.key}`}>
                                <option value="">— none —</option>
                                {refs[c.key].map((o) => <option value={o.slug}>{o.title}</option>)}
                              </select>
                            ) : c.type === "select" ? (
                              <select class:list={["input", bad(`new.${c.key}`)]} name={`new.${c.key}`}>
                                <option value=""></option>
                                {(c.options ?? []).map((o: string) => <option value={o}>{o}</option>)}
                              </select>
                            ) : c.type === "textarea" || c.type === "markdown" ? (
                              <textarea class:list={["input", bad(`new.${c.key}`)]} rows="2" name={`new.${c.key}`} />
                            ) : (
                              <input class:list={["input", bad(`new.${c.key}`)]} type={c.type === "number" ? "number" : "text"} name={`new.${c.key}`} />
                            )}
                          </label>
                        ))}
                      </div>
                    </div>
                  )}
                </div>
              )}
              <div class="actions">
                <button class="button" type="submit">{submitLabel}</button>
                {step.add !== false && <button class="button secondary" type="submit" name="again" value="1">Save and add another</button>}
              </div>
            </form>
          )}

          {step.kind === "gallery" && (
            <div class="gallery" data-watch={step.generate && (notice === NOTICES.started || pendingCards.length) ? "1" : undefined} data-workflow={genStep?.workflow} data-entries={watchIds.join(",")} data-pending={String(pendingCards.length)}>
              {missingType && <div class="alert alert-info">This workspace has no “{step.entry_type}” entry type yet.</div>}
              {!missingType && (
                <div class="cards">
                  {cards.map((r) => {
                    const pic = cardPicture(r.assets, step.picture);
                    const sound = cardAudio(r.assets, step.audio);
                    const badges = ((step.badges ?? []) as string[]).filter((b) => r.dataJson?.[b]);
                    return (
                      <a class="gcard" href={`/workspace/entries/${r.id}`}>
                        <div class="gpic">
                          {pic ? <img src={pic} alt="" loading="lazy" /> : <span class="gnone" aria-hidden="true">{(r.title || "?").slice(0, 1)}</span>}
                          {/* The play button keeps its click to itself (PlayButton.astro), so playing does not open the entry. */}
                          {sound && <span class="gplay"><PlayButton src={sound} label={`Play ${r.title}`} /></span>}
                        </div>
                        <div class="gbody">
                          <strong>{r.title}</strong>
                          {step.subtitle && r.dataJson?.[step.subtitle] && <span class="muted gsub">{String(r.dataJson[step.subtitle]).slice(0, 80)}</span>}
                          {badges.length > 0 && <span class="gbadges">{badges.map((b) => <span class="pill">{String(r.dataJson?.[b])}</span>)}</span>}
                        </div>
                      </a>
                    );
                  })}
                  {cards.length === 0 && <p class="muted none">{step.empty ?? `No ${typeName.toLowerCase()} yet.`}</p>}
                </div>
              )}

              {!missingType && (step.add || step.upload || step.generate) && (
                <div class="gactions">
                  {step.add && (
                    <details class="gaction">
                      <summary class="button secondary">＋ Add {typeName.toLowerCase()}</summary>
                      <form method="post" class="form gform">
                        <input type="hidden" name="action" value="add" />
                        <div class="form-group"><label for="add_title">Name <span class="req" title="Required">*</span></label><input class:list={["input", bad("add_title")]} id="add_title" name="add_title" required /></div>
                        <SchemaForm schema={{ fields: addFields }} refs={refs} />
                        <div class="actions"><button class="button" type="submit">Add</button></div>
                      </form>
                    </details>
                  )}
                  {step.upload && (
                    <details class="gaction">
                      <summary class="button secondary">⬆ Upload a {uploadNoun}</summary>
                      <form method="post" class="form gform" enctype="multipart/form-data">
                        <input type="hidden" name="action" value="upload" />
                        <p class="muted">The {uploadNoun} becomes a new {typeName.toLowerCase()}, named for the file unless you name it here.</p>
                        <FileDrop accept={uploadAccept ?? undefined} hint={`One ${uploadNoun}.`} />
                        <div class="form-group"><label for="upload_title">Name (optional)</label><input class="input" id="upload_title" name="upload_title" /></div>
                        <div class="actions"><button class="button" type="submit">Upload</button></div>
                      </form>
                    </details>
                  )}
                  {step.generate && (
                    <details class="gaction" open={!!(notice || pendingCards.length)}>
                      <summary class="button secondary">✦ {step.generate.button ?? "Generate"}</summary>
                      <div class="form gform">
                        {flow.forbidden && <div class="alert alert-info">Only a workspace admin can start a workflow today.</div>}
                        {!flow.found && !flow.forbidden && <div class="alert alert-info">This workspace has no workflow “{step.generate.workflow}”.</div>}
                        {flow.found && !flow.enabled && <div class="alert alert-info">“{flow.name}” is switched off: turn it on under <a href="/automation/workflows">Automation → Workflows</a>.</div>}
                        {pendingCards.map((c) => (
                          <form method="post" class="approval">
                            <input type="hidden" name="decide" value={c.id} />
                            <p class="approval-title">{flow.name ?? step.generate.workflow} is asking</p>
                            <div class="approval-message">{c.message}</div>
                            {c.imageUrl && <img class="approval-picture" src={c.imageUrl} alt="" loading="lazy" />}
                            <label class="col"><span>Note (optional)</span><textarea class="input" rows="2" name="note" /></label>
                            <div class="actions">
                              {c.choices?.length
                                ? c.choices.map((label: string, n: number) => <button class:list={["button", n > 0 && "secondary"]} type="submit" name="choice" value={label}>{label}</button>)
                                : <button class="button" type="submit" name="decision" value="approve">Approve</button>}
                              <button class="button secondary" type="submit" name="decision" value="deny">Deny</button>
                            </div>
                          </form>
                        ))}
                        {pendingCards.length === 0 && notice === NOTICES.started && <p class="muted waiting">Running… this page checks for anything to approve every few seconds.</p>}
                        <form method="post" class="form">
                          <input type="hidden" name="action" value="generate" />
                          {step.generate.prompt && <label class="col"><span>{step.generate.prompt.label}</span><textarea class="input" rows="3" name="prompt" required /></label>}
                          <div class="actions"><button class="button" type="submit" disabled={!flow.found || !flow.enabled}>{step.generate.button ?? "Generate"}</button></div>
                        </form>
                      </div>
                    </details>
                  )}
                </div>
              )}
              {after && <div class="actions"><a class="button" href={stepHref(slug, ctx, after.id)}>Continue →</a></div>}
            </div>
          )}

          {step.kind === "run" && (
            <div class="run" data-watch={notice || pendingCards.length ? "1" : undefined} data-workflow={step.workflow} data-entries={watchIds.join(",")} data-pending={String(pendingCards.length)}>
              {flow.forbidden && <div class="alert alert-info">Only a workspace admin can start a workflow today. Ask one to run this step; what it makes shows here for everyone.</div>}
              {!flow.found && !flow.forbidden && <div class="alert alert-info">This workspace has no workflow “{step.workflow}”. Install the package that brings it.</div>}
              {flow.found && flow.enabled && <p class="muted runs">Runs “{flow.name}”{flow.description ? `: ${flow.description}` : ""}</p>}
              {lacking && flow.found && flow.enabled && <div class="alert alert-info">{lacking}</div>}
              {flow.found && !flow.enabled && (
                <div class="alert alert-info">“{flow.name}” is switched off. Turn it on under <a href="/automation/workflows">Automation → Workflows</a> (it runs with its author’s permissions), then come back.</div>
              )}

              {pendingCards.map((c) => (
                <form method="post" class="approval">
                  <input type="hidden" name="decide" value={c.id} />
                  <p class="approval-title">{flow.name ?? step.workflow} is asking</p>
                  <div class="approval-message">{c.message}</div>
                  {c.imageUrl && <img class="approval-picture" src={c.imageUrl} alt="" loading="lazy" />}
                  <label class="col"><span>Note (optional)</span><textarea class="input" rows="2" name="note" /></label>
                  <div class="actions">
                    {c.choices?.length
                      ? c.choices.map((label, n) => <button class:list={["button", n > 0 && "secondary"]} type="submit" name="choice" value={label}>{label}</button>)
                      : <button class="button" type="submit" name="decision" value="approve">Approve</button>}
                    <button class="button secondary" type="submit" name="decision" value="deny">Deny</button>
                  </div>
                </form>
              ))}

              {pendingCards.length === 0 && notice && flow.found && flow.enabled && <p class="muted waiting">Running… this page checks for anything to approve every few seconds.</p>}

              <form method="post" class="form">
                <div class="actions">
                  <button class:list={["button", pendingCards.length > 0 && "secondary"]} type="submit" disabled={!flow.found || !flow.enabled || !!lacking}>
                    {pendingCards.length > 0 || decidedCards.length > 0 ? `${step.button ?? "Run"} again` : (step.button ?? "Run")}
                  </button>
                  {after && !held && (decidedCards.length > 0 || notice) && <a class="button" href={stepHref(slug, ctx, after.id)}>Continue →</a>}
                  {held && <span class="muted">Answer the question above before going on: editing the story meanwhile would void it.</span>}
                </div>
              </form>

              {decidedCards.length > 0 && (
                <details class="decided">
                  <summary>Earlier answers ({decidedCards.length})</summary>
                  <ul>
                    {decidedCards.map((c) => (
                      <li><strong>{c.choice ?? c.status}</strong> {c.decidedByName ? `by ${c.decidedByName}` : ""} {c.decidedAt ? `· ${new Date(c.decidedAt).toLocaleString()}` : ""}<span class="muted"> — {c.message.split("\n")[0].slice(0, 120)}</span></li>
                    ))}
                  </ul>
                </details>
              )}
            </div>
          )}

          {step.kind === "review" && (
            <>
            <ul class="checks">
              {checks.map((c) => (
                <li class:list={[c.ok ? "ok" : "no"]}>
                  <span aria-hidden="true">{c.ok ? "✓" : "○"}</span> {c.label}<span class="muted"> ({c.count})</span>
                  {!c.ok && c.step && <a class="fix" href={stepHref(slug, ctx, c.step.id)}>Go to “{c.step.title}” →</a>}
                </li>
              ))}
            </ul>
            <p class="verdict">{allPass ? "Everything is in place." : "Some things are still missing: go back to the step that makes them."}</p>
            {opened && (
              <p class="open"><a class="button" href={def.open!.view ? viewHref(def.open!.view, opened.slug) : `/workspace/entries/${opened.id}`}>{def.open!.label} →</a> <span class="muted">{opened.title}</span></p>
            )}
            {made.length > 0 && (
              <div class="made">
                <p class="label">What you made</p>
                <ul>{made.map((e) => <li><span class="muted">{e.key}:</span> <a href={`/workspace/entries/${e.id}`}>{e.title}</a></li>)}</ul>
              </div>
            )}
            {def.next?.length ? (
              <div class="made">
                <p class="label">What to do next</p>
                <ol>{def.next.map((n) => <li>{n.href ? <a href={n.href}>{n.text}</a> : n.text}</li>)}</ol>
              </div>
            ) : null}
            </>
          )}

          <div class="nav">
            {before ? <a class="button secondary" href={stepHref(slug, ctx, before.id)}>← Previous step</a> : <span />}
            {after && !["option", "choose", "run"].includes(step.kind) && <a class="muted" href={stepHref(slug, ctx, after.id)}>Next step without saving →</a>}
          </div>
        </section>
      </>
    )
  }
  {def && takesRecording && <AudioRecorder />}
</AppLayout>

<script>
  import { fetchApi } from "@/lib/api/client";
  // A run step with something going on (just started, or a card waiting): reload when the set of cards for it changes, for ten minutes at most.
  const run = document.querySelector<HTMLElement>(".run[data-watch], .gallery[data-watch]");
  if (run) {
    const slug = run.dataset.workflow;
    const entries = (run.dataset.entries ?? "").split(",").filter(Boolean);
    const shown = Number(run.dataset.pending ?? "0");
    const started = Date.now();
    const tick = async () => {
      if (Date.now() - started > 10 * 60 * 1000) return;
      try {
        const cards = await fetchApi<{ automationSlug?: string; entryId?: string }[]>("/api/automations/approvals?state=pending");
        const mine = cards.filter((c) => c.automationSlug === slug && (entries.length === 0 || !c.entryId || entries.includes(c.entryId)));
        if (mine.length !== shown) return location.reload();
      } catch {
        /* a failed poll just tries again */
      }
      window.setTimeout(tick, 5000);
    };
    window.setTimeout(tick, 5000);
  }
</script>

