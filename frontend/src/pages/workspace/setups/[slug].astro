---
import AudioRecorder from "@/components/AudioRecorder.astro";
import FileDrop from "@/components/FileDrop.astro";
import ImageCropper from "@/components/ImageCropper.astro";
import LinkedItemsField from "@/components/schema-fields/LinkedItemsField.astro";
import WizardCard from "@/components/WizardCard.astro";
import WizardCreate from "@/components/WizardCreate.astro";
import SchemaForm from "@/components/SchemaForm.astro";
import SchemaFormField from "@/components/SchemaFormField.astro";
import AppLayout from "@/layouts/AppLayout.astro";
import { acceptKind, acceptsAudio } from "@/lib/acceptKind";
import { getAuthToken } from "@/lib/api/client";
import { type MarvinAsset, getAssets } from "@/lib/api/platform";
import { kindOfAccept, matchesAccept } from "@/lib/assetAccept";
import { assetItem } from "@/lib/linkedItems";
import { type RefOption, withCurrent } from "@/lib/refFields";
import { refOptionsFor } from "@/lib/refFieldsApi";
import { getWizard, type WizardRead } from "@/lib/api/wizards";
import { viewHref } from "@/lib/api/views";
import {
  type ApprovalCard, type Check, type Ctx, type Step, NOTICE_PARAM, NOTICES, RUN_PARAM, runIdOf, subtitleOf, SIMPLE_FIELD_TYPES, approvalsOf, blocker, checkSpec, inputKeys, chooseSpec, currentStep, entryTypeOf, hasValue, listSpec, nextStep, optionStepOf, passes, previousStep, readCtx, suppliedData,
  MAX_PICKS, PAGE_PARAM, PER_PARAM, assetSpec, listKeys, listOf, listStepOf, pickedLine, picksAssets, pictureFieldOf, skipTo,
  StepError, cardAudio, cardPicture, fieldRole, fileButtonNote, fileButtonOff, fileWays, galleryAccept, cardActionShown, generateAsRun, highlightOf, isDone, naturalByTitle, prefillOf, runInputs, shownLines, shownSteps, stepHref,
} from "@/lib/wizard";
import { jobLead, leftOutLine, listLine, nothingLine, runButton } from "@/lib/runList";
import { runStep } from "@/lib/wizardActions";
import { getRunState, type SelectionCondition, type WorkflowRunState } from "@/lib/api/workflowRuns";
import { runKey, runLine } from "@/lib/runState";
import { type Row, type WorkflowState, MAX_DECIDED_SHOWN, approvalCards, askedKeys, decideApproval, describeFailure, entryOfType, findAssets, findEntries, picksOf, runSelection, typeBySlug, workflowState } from "@/lib/wizardApi";
import { lastPage, rangeText, readPage } from "@/lib/pagination";

const authToken = getAuthToken(Astro.cookies);
const slug = Astro.params.slug ?? "";

let wizard: WizardRead | null = null;
let problem: string | null = authToken ? null : "Sign in to use this guided setup.";
let pickerAssets: MarvinAsset[] = []; // the workspace's assets, when a gallery lets the person choose one instead of uploading
let galleryFields: { key?: string; accept?: string | null }[] = []; // the gallery entry type's fields: what its file field takes is what an upload takes
let stepProblem: string | null = null; // what went wrong with the step just posted: shown inside its card
let badFields: string[] = []; // the inputs it is about
const bad = (name: string) => (badFields.includes(name) ? "invalid" : undefined);
if (authToken) {
  try {
    wizard = await getWizard(slug, authToken);
  } catch (e) {
    problem = describeFailure(e);
  }
}
const def = wizard?.definition ?? null;
const notice = NOTICES[Astro.url.searchParams.get(NOTICE_PARAM) ?? ""] ?? null;
// The run this step started, carried in the address: the step says where it stands until it is over.
const runId = runIdOf(Astro.url.searchParams);

// The address is only trusted once checked: each choice must be an entry of the type its step picks (or one of an option's values), or it
// is dropped, so a stale or crafted link cannot point a later step at something else.
const entries: Record<string, Row> = {};
// A multi-select step's picks (a list key): the ones that are still there, in the order picked, read in one request.
const lists: Record<string, Row[]> = {};
async function checkedCtx(raw: Ctx): Promise<Ctx> {
  if (!def || !authToken) return {};
  const out: Ctx = {};
  for (const [key, value] of Object.entries(raw)) {
    const many = listStepOf(def, key);
    if (many) {
      const rows = await picksOf(many, listOf(value), authToken);
      if (rows.length) {
        out[key] = rows.map((r) => r.slug).join(",");
        lists[key] = rows;
      }
      continue;
    }
    const type = entryTypeOf(def, key);
    if (type) {
      const found = await entryOfType(type, value, authToken);
      if (found) {
        out[key] = value;
        entries[key] = found;
      }
    } else if (optionStepOf(def, key)?.options?.some((o: { value: string }) => o.value === value)) {
      out[key] = value;
    }
  }
  return out;
}
const ctx = await checkedCtx(readCtx(Astro.url.searchParams, def ? listKeys(def) : undefined));
const step: Step | null = def ? currentStep(def, ctx, Astro.url.searchParams.get("step")) : null;

if (Astro.request.method === "POST" && authToken && def && step) {
  try {
    const form = await Astro.request.formData();
    const deciding = String(form.get("decide") ?? "");
    if (deciding) {
      const decision = form.get("decision") === "deny" ? "deny" : "approve";
      const choice = String(form.get("choice") ?? "").trim() || null;
      await decideApproval(deciding, decision, choice, String(form.get("note") ?? "").trim() || null, authToken);
      return Astro.redirect(stepHref(slug, ctx, step.id, { ...(runId ? { [RUN_PARAM]: runId } : {}), [NOTICE_PARAM]: decision === "deny" ? "denied" : choice ? "chosen" : "approved" }));
    }
    const done = await runStep(def, step, form, ctx, authToken);
    const target = done.stay ? step : (nextStep(def, done.ctx, step.id) ?? step);
    // A page move of a multi-select step keeps its page size (`per`) as the address had it.
    const paging = done.page ? { [PAGE_PARAM]: String(done.page), ...(Astro.url.searchParams.get(PER_PARAM) ? { [PER_PARAM]: Astro.url.searchParams.get(PER_PARAM)! } : {}) } : {};
    return Astro.redirect(stepHref(slug, done.ctx, target.id, { ...(done.notice ? { [NOTICE_PARAM]: done.notice } : {}), ...(done.run ? { [RUN_PARAM]: done.run } : {}), ...paging }));
  } catch (e) {
    stepProblem = describeFailure(e);
    badFields = e instanceof StepError ? e.fields : [];
  }
}

// What the current step draws.
const fieldsOf = (type: Awaited<ReturnType<typeof typeBySlug>>, keys: string[]) =>
  (((type?.schemaJson as { fields?: any[] } | null)?.fields ?? []) as any[]).filter((f) => keys.includes(f.key));
/** A list cell is one compact control: a long-text field is a two-line box here, whatever editor it has on its own page. */
const cellField = (c: any) => (c.type === "markdown" ? { ...c, type: "textarea", rows: 2 } : c);
const simple = (fields: any[]) => fields.filter((f) => SIMPLE_FIELD_TYPES.includes(f.type));
let choices: Row[] = [];
let listRows: Row[] = [];
let entry: Row | null = null;
let typeName = "";
let missingType = false;
let formFields: any[] = [];
let leftOut: any[] = [];
let checks: { label: string; ok: boolean; count: number; step?: Step | null }[] = [];
let columns: any[] = [];
let flow: WorkflowState = { found: true, enabled: true, canRun: true };
let runNow: WorkflowRunState | null = null; // where the run in the address stands, when it is this step's workflow's
/** The run in the address, if it is a run of this workflow (an id carried over from another step says nothing here). */
const runOf = async (workflow: string): Promise<WorkflowRunState | null> => {
  const found = runId && authToken ? await getRunState(runId, authToken).catch(() => null) : null;
  return found && found.automationSlug === workflow ? found : null;
};
const askedBy = (run: WorkflowRunState | null): string[] => (run?.waitingOn ?? []).map((w) => w.approvalId);
let pendingCards: ApprovalCard[] = [];
let decidedCards: ApprovalCard[] = [];
let watchIds: string[] = [];
let lacking: string | null = null; // a run step's `requires` not met
let picked: Awaited<ReturnType<typeof runSelection>> = null; // a run step's list: what its workflow will act on, from the workflow itself
let leftSays: string | null = null; // and why some are not in it, in the package's words
let jobSays: { lead: string; more: boolean; all: string } | null = null; // what the worker job the run started said
let report: { label: string; text: string; title: string; href: string } | null = null; // the field the run writes, to read here
let cards: Row[] = [];
// A multi-select step: this page of its cards, how many there are in all, the page, and what is picked (on this page and on others).
let pageRows: Row[] = [];
let pageTotal = 0;
let pageAt = { page: 1, per: 50, offset: 0 };
let picked0: string[] = [];
let offPage = 0;
// A step's `selection`: a multi-select step's picks shown as cards (the first SELECTION_SHOWN), with a link back to change them.
const SELECTION_SHOWN = 24;
const selectionStep = def && step?.selection ? listStepOf(def, step.selection) : undefined;
const selectionRows: Row[] = step?.selection ? (lists[step.selection] ?? []) : [];
const pickHref = (r: Row, step: Step | undefined) => (step && picksAssets(step) ? `/workspace/assets/${r.id}` : `/workspace/entries/${r.id}`);
const LONG_LIST = 8; // a pick list longer than this puts "make a new one" above it, so it is not lost at the bottom
let pictureCards = false; // a single pick draws picture cards, not a list of radio buttons
let pictureRole: string | undefined; // the role the picture field's file is attached under (a field's `role` may differ from its key)
let currentPicture: string | null = null; // an upload step's picture as it is now
let createFirst = false; // the choose step's make-a-new-one form comes before the list
let uploadHeld = false; // the upload step's field already holds something (a value, or a file attached under its role)
let addFields: any[] = [];
let genStep: Step | null = null; // a gallery's generate action, as the run step it is
let addValues: Record<string, string> = {}; // the add form's starting values (`add.prefill`)
let approveNames: Record<string, string> = {}; // a gallery's `approve` workflows, by slug, with their names
let showTitle = ""; // a step's `show` card: the chosen entry's title, address and the fields it reads out
let showHref = "";
let showLines: { key: string; label: string; value: string }[] = [];
// A shown text field that holds another entry's slug (`ref`) is a pick list. In a wizard the list is narrowed by the entries chosen so
// far that the referenced type has a field for (a cast member's actor comes from the chosen world's troupe, not every actor).
let refs: Record<string, RefOption[]> = {};
// (A multi-select's list is no one entry: it narrows nothing.)
const refsFor = (fields: any[]) => refOptionsFor({ fields }, authToken, Object.fromEntries(Object.entries(ctx).filter(([k]) => !(k in lists))));

// Drawn whatever happened to a post: an error shows above a complete page, never an empty one.
if (authToken && def && step) {
  if (step.show && entries[step.show.entry]) {
    const shown = entries[step.show.entry];
    const shownType = await typeBySlug(entryTypeOf(def, step.show.entry) ?? "", authToken, Astro.locals);
    showTitle = shown.title;
    showHref = `/workspace/entries/${shown.id}`;
    showLines = shownLines(shown.dataJson, shownType?.schemaJson as any, step.show.fields);
  }
  if (step.kind === "choose" && step.multiple === true) {
    // A page at a time (`page`, `per`): entries are paged by the query (by title), assets read once and cut here.
    pageAt = readPage(Astro.url.searchParams);
    picked0 = listOf(ctx[step.as]);
    if (picksAssets(step)) {
      typeName = "file";
      pictureRole = "picture";
      const all = await findAssets(assetSpec(step, ctx), authToken);
      pageTotal = all.length;
      pageAt = readPage(new URLSearchParams({ page: String(Math.min(pageAt.page, lastPage(pageTotal, pageAt.per))), per: String(pageAt.per) }));
      pageRows = all.slice(pageAt.offset, pageAt.offset + pageAt.per);
    } else {
      const type = await typeBySlug(step.entry_type, authToken, Astro.locals);
      missingType = !type;
      typeName = type?.name ?? step.entry_type;
      pictureRole = fieldRole(type, step.picture ?? pictureFieldOf(type));
      const spec = { ...chooseSpec(step, ctx), sort: { by: "title" } };
      let found = await findEntries(spec, authToken, pageAt.per, pageAt.offset);
      if (!found.entries.length && found.total > 0) {
        // Past the end (the list got shorter): the last page.
        pageAt = readPage(new URLSearchParams({ page: String(lastPage(found.total, pageAt.per)), per: String(pageAt.per) }));
        found = await findEntries(spec, authToken, pageAt.per, pageAt.offset);
      }
      pageTotal = found.total;
      pageRows = step.sort === "natural" ? naturalByTitle(found.entries) : found.entries;
    }
    const here = new Set(pageRows.map((r) => r.slug));
    offPage = picked0.filter((p) => !here.has(p)).length;
  } else if (step.kind === "choose" || step.kind === "list") {
    const type = await typeBySlug(step.entry_type, authToken, Astro.locals);
    missingType = !type;
    typeName = type?.name ?? step.entry_type;
    if (step.kind === "choose") {
      choices = (await findEntries(chooseSpec(step, ctx), authToken)).entries;
      if (step.sort === "natural") choices = naturalByTitle(choices);
      // A pick is cards with pictures when the step names its picture field, or when the type has a picture field and the entries have
      // pictures in it (a character with its master): never radio buttons for things that have a face.
      const picture = step.picture ?? pictureFieldOf(type);
      pictureRole = fieldRole(type, picture);
      pictureCards = !!step.picture || (!!picture && choices.some((c) => !!cardPicture(c.assets, pictureRole)));
      createFirst = !!step.create && (!!step.create.upload || choices.length > LONG_LIST);
      formFields = simple(fieldsOf(type, askedKeys(type, step.create?.fields, Object.keys(suppliedData(step, ctx)))));
      refs = await refsFor(formFields);
    } else {
      listRows = naturalByTitle((await findEntries(listSpec(step, ctx), authToken)).entries); // as people count: Beat 01, Beat 02, Beat 10 (not newest first)
      columns = simple(fieldsOf(type, askedKeys(type, step.columns, Object.keys(suppliedData(step, ctx))))).filter((f) => f.type !== "boolean");
      refs = await refsFor(columns);
    }
  } else if (step.kind === "form" || step.kind === "upload") {
    entry = entries[step.entry] ?? null;
    if (step.kind === "upload" && entry) {
      const role = fieldRole(await typeBySlug(entryTypeOf(def, step.entry), authToken, Astro.locals), step.field);
      const attached = (entry.assets ?? []) as { role?: string }[];
      currentPicture = step.mode === "asset" ? cardPicture(entry.assets, role) : null;
      uploadHeld = hasValue(entry.dataJson?.[step.field]) || attached.some((a) => a.role === role);
    }
    if (step.kind === "form") {
      const type = await typeBySlug(entryTypeOf(def, step.entry), authToken, Astro.locals);
      const all = fieldsOf(type, step.fields);
      formFields = simple(all);
      leftOut = all.filter((f) => !SIMPLE_FIELD_TYPES.includes(f.type));
      refs = await refsFor(formFields);
    }
  } else if (step.kind === "gallery") {
    const type = await typeBySlug(step.entry_type, authToken, Astro.locals);
    missingType = !type;
    typeName = type?.name ?? step.entry_type;
    galleryFields = (type as any)?.schemaJson?.fields ?? [];
    cards = (await findEntries(listSpec(step, ctx), authToken)).entries;
    if (step.sort === "natural") cards = naturalByTitle(cards);
    pictureRole = fieldRole(type, step.picture);
    addFields = simple(fieldsOf(type, askedKeys(type, step.add?.fields, Object.keys(suppliedData(step, ctx)))));
    refs = await refsFor(addFields);
    addValues = prefillOf(step.add, entries);
    if (step.add?.file?.assets || (step.card_actions ?? []).some((a: any) => a.file?.assets)) {
      pickerAssets = authToken ? await getAssets(authToken, { sort: "newest" }).catch(() => []) : [];
    }
    if (step.approve) {
      // The approvals of these workflows about the entries listed here (its takes, and what was chosen), so they are answered on this page.
      const about = [...cards.map((c) => c.id), ...Object.values(entries).map((e) => e.id)];
      watchIds = about;
      for (const w of step.approve as string[]) {
        const all = await approvalCards(w, authToken);
        approveNames[w] = (await workflowState(w, authToken)).name ?? w;
        pendingCards = [...pendingCards, ...approvalsOf(all.pending, w, about)];
        decidedCards = [...decidedCards, ...approvalsOf(all.decided, w, about)].slice(0, MAX_DECIDED_SHOWN);
      }
    }
    if (step.generate) {
      genStep = generateAsRun(step, undefined).run;
      flow = await workflowState(genStep.workflow, authToken);
      const about = inputKeys(genStep).map((k) => entries[k]).filter((e): e is Row => !!e).map((e) => e.id);
      watchIds = about;
      runNow = await runOf(genStep.workflow);
      const all = await approvalCards(genStep.workflow, authToken);
      pendingCards = approvalsOf(all.pending, genStep.workflow, about, askedBy(runNow));
      decidedCards = approvalsOf(all.decided, genStep.workflow, about).slice(0, MAX_DECIDED_SHOWN);
    }
  } else if (step.kind === "run") {
    flow = await workflowState(step.workflow, authToken);
    // The approvals this run raises are about the entries the step hands it (each of a list's): those are the cards shown here.
    const about = inputKeys(step).flatMap((k) => (entries[k] ? [entries[k]] : (lists[k] ?? []))).map((e) => e.id);
    watchIds = about;
    if (step.requires) {
      const needed = entries[step.requires.entry];
      if (!needed || !hasValue(needed.dataJson?.[step.requires.field])) lacking = `“${step.requires.field}” on ${needed?.title ?? step.requires.entry} is empty: fill it in (or upload it) in an earlier step first.`;
    }
    runNow = await runOf(step.workflow);
    const reasons = (step.left_out ?? []) as { label: string; where: SelectionCondition[] }[];
    picked = await runSelection(step.workflow, runInputs(step, ctx), reasons.map((r) => r.where), authToken);
    leftSays = picked ? leftOutLine(reasons, picked.selection.leftOut) : null;
    const job = runNow?.job?.finished ? (await findEntries({ entries: [runNow.job.entryId] }, authToken, 1)).entries[0] : null;
    const log = String(job?.dataJson?.log ?? "").trim();
    // A run whose step names a report shows the report: the job's own words only when it failed (they say why).
    if (log && (runNow?.job?.status === "failed" || !step.report)) jobSays = { ...jobLead(log, runNow?.job?.status === "failed"), all: log };
    const holder = step.report ? entries[step.report.entry] : null;
    const text = holder ? String(holder.dataJson?.[step.report.field] ?? "").trim() : "";
    if (holder && text) {
      const label = step.report.label ?? fieldsOf(await typeBySlug(entryTypeOf(def, step.report.entry), authToken, Astro.locals), [step.report.field])[0]?.label ?? step.report.field;
      report = { label, text, title: holder.title, href: `/workspace/entries/${holder.id}` };
    }
    const cards = await approvalCards(step.workflow, authToken);
    pendingCards = approvalsOf(cards.pending, step.workflow, about, askedBy(runNow));
    decidedCards = approvalsOf(cards.decided, step.workflow, about).slice(0, MAX_DECIDED_SHOWN);
  } else if (step.kind === "review") {
    checks = await Promise.all(
      (step.checks as (Check & { step?: string })[]).map(async (c) => {
        const count = (await findEntries(checkSpec(c, ctx), authToken, 1)).total;
        return { label: c.label, ok: passes(c.op, count, c.value), count, step: c.step ? def.steps.find((s) => s.id === c.step) : null };
      }),
    );
  }
}

const steps = def ? shownSteps(def, ctx) : [];
const here = step ? steps.findIndex((s) => s.id === step.id) : -1;
const before = def && step ? previousStep(def, ctx, step.id) : null;
const after = def && step ? nextStep(def, ctx, step.id) : null;
const allPass = checks.length > 0 && checks.every((c) => c.ok);
// The step the steps list (or a link) asked for, when it opened on the one that must be answered before it.
const askedId = Astro.url.searchParams.get("step");
const jumpedFrom = def && step && askedId && askedId !== step.id ? (steps.find((s) => s.id === askedId) ?? null) : null;
// A run step with a card waiting holds the later steps: answering first keeps the card from going stale (an entry edited after the
// question was asked makes the approval count as neither yes nor no).
const held = (step?.kind === "run" || step?.kind === "gallery") && pendingCards.length > 0;
const runSays = runNow ? runLine(runNow) : null;
// A run step whose list is empty has nothing to do: Continue is its main button, not a run that would do nothing. While a run of it is
// still going (the list empties as soon as it takes them), the run's own line speaks instead.
const nothingToDo = !!picked && picked.selection.count === 0;
const running = !!runSays && !runSays.over;
const continues = !!after && !held && (nothingToDo || decidedCards.length > 0 || !!notice || !!runNow);
const made = Object.entries(entries).map(([key, e]) => ({ key, ...e }));
const opened = def?.open ? entries[def.open.entry] ?? null : null;
const submitLabel = after ? "Continue" : "Save";
// One way to skip, the same on every step: a link at the bottom. An optional choice or option skipped is no choice (what was picked, and
// what later steps picked on the strength of it, is dropped, as a changed choice drops it), so the step after it is worked out without it.
// A choice that is not optional cannot be skipped (the steps after it wait for it); a run's link shows only while it has not run.
const skipHref: string | null = (() => {
  if (!def || !step) return null;
  if (step.kind === "option" || step.kind === "choose") {
    const skip = skipTo(def, ctx, step);
    return skip ? stepHref(slug, skip.ctx, skip.step.id) : null;
  }
  if (!after || (step.kind === "run" && (held || continues))) return null;
  return stepHref(slug, ctx, after.id);
})();
// A column heading is the field's label without its explanation in brackets (the full label stays as the hover text).
const shortLabel = (label: string) => label.replace(/\s*\(.*\)\s*$/, "") || label;
const uploadAccept = step?.kind === "gallery" && step.upload ? galleryAccept(step, galleryFields) : null;
const uploadNoun = { audio: "sound", image: "picture", file: "file" }[acceptKind(uploadAccept)];
// A sound can be recorded instead of picked (the drop zone's Record button): the recorder is on the page once, when the step takes one.
// A gallery's add form may hold a file box of its own (`add.file`): it takes recordings too.
const lengthField: string | undefined = step?.upload?.seconds ?? step?.add?.file?.seconds; // where a card's sound length lives
const addAccept = step?.kind === "gallery" && step.add?.file ? galleryAccept({ upload: step.add.file } as any, galleryFields) : null;
// A file box (a card action's `file`, the add form's `add.file`) is the control an entry's asset field has: choose one of the workspace's
// assets that fit its accept, where the step offers them, or upload one (drop it, or record a sound) in a dialog.
const fileNoun = (accept: string | null | undefined) => ({ audio: "sound", image: "picture", file: "file" })[acceptKind(accept)];
const assetsFor = (accept: string) => pickerAssets.filter((a) => matchesAccept(accept, a)).map(assetItem);
// One box for each card action that takes a file, shared by every card (a story has dozens of cards and the list is long): the card's
// button opens it under that card.
const cardFiles = (step?.kind === "gallery" ? ((step.card_actions ?? []) as { label: string; file?: { accept?: string; assets?: boolean } }[]) : []).flatMap((a, n) =>
  a.file ? [{ n, label: a.label, accept: a.file.accept ?? "audio/*", choose: !!a.file.assets }] : [],
);
// The page has the recorder once when a box takes a sound, and the cropper when one takes a picture, as an entry's page does.
const boxKinds = [...cardFiles.map((c) => c.accept), ...(addAccept ? [addAccept] : [])].map(kindOfAccept);
const takesRecording = acceptsAudio(step?.kind === "upload" ? step.accept : uploadAccept) || boxKinds.some((k) => k === "audio" || k === "any");
const takesPicture = boxKinds.some((k) => k === "image" || k === "any");
// The add form's save buttons, and how its file box can be filled: a button that needs the file says what it is waiting for.
const addButtons = ((step?.add?.buttons ?? [{ label: "Add" }]) as { label: string; file?: string; skip_required?: boolean }[]).map((b) => ({ ...b, needs: b.file }));
const addWays = fileWays(!!step?.add?.file?.assets, acceptKind(addAccept) === "audio");
// What the recorder shows to read from (`add.file.script`: field keys of the add form, labelled as the form labels them): a take's words and direction.
const readFrom: { label: string; field: string }[] = ((step?.add?.file?.script ?? []) as string[]).map((key) => ({
  field: key,
  label: String((addFields as { key: string; label?: string }[]).find((f) => f.key === key)?.label ?? key).replace(/\s*\([^)]*\)\s*$/, ""), // "Words (what is said)" reads as "Words" at this size
}));
---

<AppLayout crumb="workspace.wizards.run" title={wizard?.name ?? "Guided setup"} width="page">
  <div class="page-header">
    <h2>{wizard?.name ?? "Guided setup"}</h2>
    {wizard?.description && <p>{wizard.description}</p>}
  </div>

  {problem && <div class="alert alert-error">{problem}</div>}
  {notice && !problem && <div class="alert alert-info">{notice === NOTICES.added && step?.added ? step.added : notice}</div>}
  {!problem && !wizard && <div class="alert alert-info">There is no guided setup called “{slug}” here. <a href="/workspace/setups">See the ones there are.</a></div>}

  {
    def && step && (
      <>
        <ol class="stepper" aria-label="Steps">
          {steps.map((s, i) => (
            <li class:list={[i === here && "current", i < here && "past", isDone(s, ctx) && "done"]}>
              <a href={stepHref(slug, ctx, s.id)} aria-current={i === here ? "step" : undefined} title={blocker(def, ctx, s.id) ? `Needs “${blocker(def, ctx, s.id)!.title}” answered first` : undefined}>
                <span class="n" aria-hidden="true">{isDone(s, ctx) && i !== here ? "✓" : i + 1}</span>
                <span class="t">{s.title}</span>
              </a>
            </li>
          ))}
        </ol>

        <section class="card step">
          <p class="eyebrow">Step {here + 1} of {steps.length}</p>
          <h3>{step.title}</h3>
          {step.help && <p class="help">{step.help}</p>}
          {jumpedFrom && <div class="alert alert-info">“{jumpedFrom.title}” needs this step answered first, so it opened here.</div>}
          {showTitle && (
            <aside class="showcard" aria-label={showTitle}>
              <div class="showhead"><strong>{showTitle}</strong><a class="muted" href={showHref}>Open ↗</a></div>
              <dl>{showLines.map((l) => (<><dt>{l.label}</dt><dd>{l.value}</dd></>))}</dl>
            </aside>
          )}
          {selectionRows.length > 0 && (
            <section class="picks" aria-label="What you picked">
              <div class="showhead">
                <p class="label">{selectionRows.length === 1 ? "The one you picked" : `The ${selectionRows.length} you picked`}</p>
                {selectionStep && <a class="muted" href={stepHref(slug, ctx, selectionStep.id)}>Change</a>}
              </div>
              <div class="cards">
                {selectionRows.slice(0, SELECTION_SHOWN).map((r) => (
                  <WizardCard href={pickHref(r, selectionStep)} title={r.title} picture={cardPicture(r.assets, selectionStep && picksAssets(selectionStep) ? "picture" : fieldRole(null, selectionStep?.picture))} />
                ))}
              </div>
              {selectionRows.length > SELECTION_SHOWN && <p class="muted none">and {selectionRows.length - SELECTION_SHOWN} more</p>}
            </section>
          )}
          {stepProblem && <div class="step-error" role="alert">{stepProblem}</div>}

          {step.kind === "option" && (
            <form method="post" class="form">
              <div class="choices">
                {step.options.map((o: { value: string; label: string }) => (
                  <label class="choice">
                    <input type="radio" name="value" value={o.value} checked={ctx[step.as] === o.value} required /> {o.label}
                  </label>
                ))}
              </div>
              <div class="actions"><button class="button" type="submit">{submitLabel}</button></div>
            </form>
          )}

          {step.kind === "choose" && step.multiple === true && (
            <div class="form">
              {missingType && <div class="alert alert-info">This workspace has no “{step.entry_type}” entry type yet, so there is nothing to pick. Install the package’s types first.</div>}
              {!missingType && pageRows.length === 0 && <p class="muted none">{step.empty ?? `There is nothing to pick here yet.`}</p>}
              {!missingType && pageRows.length > 0 && (
                <form method="post" class="form" data-multi data-off={String(offPage)}>
                  <input type="hidden" name="page" value={String(pageAt.page)} />
                  <input type="hidden" name="clear_all" value="" data-clear-flag />
                  {/* The form's first button, so Enter (in the search box, on a box) keeps the ticks and stays on this page: never Select all. */}
                  <button class="enter-stays" type="submit" name="go" value={String(pageAt.page)} tabindex="-1" aria-hidden="true">Keep</button>
                  {pageRows.map((r) => <input type="hidden" name="shown" value={r.slug} />)}
                  <div class="multibar">
                    <p class="label">Tick as many as you like</p>
                    <button class="button secondary small" type="submit" name="sel" value="all" data-select-page>Select all on this page</button>
                    <button class="button secondary small" type="submit" name="sel" value="clear" data-clear>Clear</button>
                    <span class:list={["picked", { over: picked0.length > MAX_PICKS }]} role="status" aria-live="polite" data-picked>{pickedLine(picked0.length)}</span>
                  </div>
                  {pageRows.length > LONG_LIST && <input type="search" class="input pick-search" placeholder="Search this page by name…" data-pick-search aria-label="Search this page by name" autocomplete="off" />}
                  <div class="tiles multi">
                    {pageRows.map((c) => {
                      const pic = cardPicture(c.assets, pictureRole);
                      const sub = subtitleOf(step.subtitle, c.dataJson);
                      return (
                        <label class="tile" data-pick-item>
                          <input type="checkbox" name="pick" value={c.slug} checked={picked0.includes(c.slug)} />
                          <span class="tpic">{pic ? <img src={pic} alt="" loading="lazy" /> : <span class="gnone" aria-hidden="true">{(c.title || "?").slice(0, 1)}</span>}</span>
                          <strong>{c.title}</strong>
                          {sub && <span class="muted gsub">{sub}</span>}
                        </label>
                      );
                    })}
                  </div>
                  {pageTotal > pageAt.per && (
                    <nav class="multipager" aria-label="Pages">
                      <span>{rangeText(pageAt.page, pageAt.per, pageTotal)}</span>
                      {pageAt.page > 1 && <button class="button secondary small" type="submit" name="go" value={String(pageAt.page - 1)}>← Previous</button>}
                      {pageAt.page < lastPage(pageTotal, pageAt.per) && <button class="button secondary small" type="submit" name="go" value={String(pageAt.page + 1)}>Next →</button>}
                      <span class="muted">What you tick stays ticked when you change page.</span>
                    </nav>
                  )}
                  <div class="actions"><button class="button" type="submit" name="action" value="pick">{submitLabel}</button></div>
                </form>
              )}
            </div>
          )}

          {step.kind === "choose" && step.multiple !== true && (
            <div class="form">
              {missingType && <div class="alert alert-info">This workspace has no “{step.entry_type}” entry type yet, so there is nothing to pick. Install the package’s types first.</div>}
              {step.create && !missingType && createFirst && <WizardCreate step={step} typeName={typeName} hasChoices={choices.length > 0} first={true} formFields={formFields} refs={refs} badFields={badFields} />}
              {choices.length > 0 && (
                <form method="post" class="form">
                  <input type="hidden" name="action" value="pick" />
                  <p class="label">{createFirst ? `Or pick one you have (${choices.length})` : "Pick one you have"}</p>
                  {choices.length > LONG_LIST && <input type="search" class="input pick-search" placeholder={`Search ${typeName.toLowerCase()}s by name…`} data-pick-search aria-label="Search by name" autocomplete="off" />}
                  {pictureCards ? (
                    <div class="tiles" role="radiogroup">
                      {choices.map((c) => {
                        const pic = cardPicture(c.assets, pictureRole);
                        return (
                          <label class="tile" data-pick-item>
                            <input type="radio" name="pick" value={c.slug} checked={ctx[step.as] === c.slug} />
                            <span class="tpic">{pic ? <img src={pic} alt="" loading="lazy" /> : <span class="gnone" aria-hidden="true">{(c.title || "?").slice(0, 1)}</span>}</span>
                            <strong>{c.title}</strong>
                            {subtitleOf(step.subtitle, c.dataJson) && <span class="muted gsub">{subtitleOf(step.subtitle, c.dataJson)}</span>}
                          </label>
                        );
                      })}
                    </div>
                  ) : (
                    <div class="choices">
                      {choices.map((c) => (
                        <label class="choice" data-pick-item>
                          <input type="radio" name="pick" value={c.slug} checked={ctx[step.as] === c.slug} />
                          <span class="choice-text">{c.title}{subtitleOf(step.subtitle, c.dataJson, 400) && <span class="muted gsub">{subtitleOf(step.subtitle, c.dataJson, 400)}</span>}</span>
                        </label>
                      ))}
                    </div>
                  )}
                  <div class="actions"><button class="button" type="submit">Use this {typeName.toLowerCase()}</button></div>
                </form>
              )}
              {step.create && !missingType && !createFirst && <WizardCreate step={step} typeName={typeName} hasChoices={choices.length > 0} first={false} formFields={formFields} refs={refs} badFields={badFields} />}
            </div>
          )}

          {step.kind === "form" && (
            entry ? (
              <form method="post" class="form">
                <SchemaForm schema={{ fields: formFields }} values={entry.dataJson ?? {}} refs={refs} />
                {leftOut.length > 0 && <p class="muted">{leftOut.map((f) => f.label).join(", ")} can be edited in the <a href={`/workspace/entries/${entry.id}`}>entry itself</a>.</p>}
                <div class="actions"><button class="button" type="submit">{submitLabel}</button></div>
              </form>
            ) : <div class="alert alert-info">Choose the {step.entry} in an earlier step first.</div>
          )}

          {step.kind === "upload" && (
            entry ? (
              <form method="post" class="form" enctype="multipart/form-data">
                <p class="muted">
                  {step.mode === "text" ? `Its text goes into “${step.field}” on ${entry.title}.` : `The file is kept as an asset in “${step.field}” on ${entry.title}.`}
                </p>
                {currentPicture && (
                  <figure class="current">
                    <img src={currentPicture} alt={`${entry.title} as it is now`} />
                    <figcaption>Now: {entry.title}</figcaption>
                  </figure>
                )}
                {uploadHeld && (
                  <div class="alert alert-info replace">
                    <strong>{entry.title} already has {step.mode === "text" ? `a ${step.field} (${String(entry.dataJson?.[step.field]).length.toLocaleString()} characters)` : currentPicture ? "this picture" : `something in ${step.field}`}.</strong>
                    Uploading replaces it, and this page cannot bring it back.
                    <label class="choice"><input type="checkbox" name="replace" value="1" required /> Replace it</label>
                  </div>
                )}
                <FileDrop accept={(step.accept ?? []).join(",") || undefined} hint={step.accept?.length ? `One ${step.accept.join(", ")} file.` : "One file."} />
                <div class="actions">
                  <button class="button" type="submit">Upload</button>
                </div>
              </form>
            ) : <div class="alert alert-info">Choose the {step.entry} in an earlier step first.</div>
          )}

          {step.kind === "list" && (
            <form method="post" class="form">
              {missingType && <div class="alert alert-info">This workspace has no “{step.entry_type}” entry type yet.</div>}
              {!missingType && (
                <div class="rows">
                  {listRows.length === 0 && <p class="muted none">None yet. Add the first one below.</p>}
                  {listRows.map((r) => (
                    <div class="row">
                      <div class="row-head"><a href={`/workspace/entries/${r.id}`}>{r.title}</a></div>
                      <input type="hidden" name={`row.${r.id}.__was`} value={JSON.stringify(Object.fromEntries(columns.map((c) => [c.key, r.dataJson?.[c.key] ?? null])))} />
                      <div class="cols">
                        {columns.map((c) => (
                          <div class="col" title={c.label}>
                            <label for={`row-${r.id}-${c.key}`}>{shortLabel(c.label)}{c.required && <span class="req" title="Required"> *</span>}</label>
                            <SchemaFormField bare field={cellField(c)} value={r.dataJson?.[c.key] ?? undefined} refs={refs} name={`row.${r.id}.${c.key}`} id={`row-${r.id}-${c.key}`} />
                          </div>
                        ))}
                      </div>
                    </div>
                  ))}
                  {step.add !== false && (
                    <div class="row new">
                      <div class="row-head">＋ {listRows.length ? "Add another" : "Add the first"} {typeName.toLowerCase()}</div>
                      <div class="cols">
                        <label class="col">
                          <span>Name <span class="req" title="Required">*</span></span>
                          <input class:list={["input", bad("new.title")]} name="new.title" />
                        </label>
                        {columns.map((c) => (
                          <div class="col" title={c.label}>
                            <label for={`new-${c.key}`}>{shortLabel(c.label)}{c.required && <span class="req" title="Required"> *</span>}</label>
                            <SchemaFormField bare field={cellField(c)} error={bad(`new.${c.key}`)} refs={refs} name={`new.${c.key}`} id={`new-${c.key}`} />
                          </div>
                        ))}
                      </div>
                      <div class="actions"><button class="button secondary" type="submit" name="again" value="1">Add {typeName.toLowerCase()}</button></div>
                    </div>
                  )}
                </div>
              )}
              <div class="actions">
                <button class="button" type="submit">{submitLabel}</button>
              </div>
            </form>
          )}

          {step.kind === "gallery" && (
            <div class="gallery" data-watch={(step.generate && (notice === NOTICES.started || pendingCards.length)) || (step.approve && (pendingCards.length || cards.some((c) => c.dataJson?.status === "queued"))) ? "1" : undefined} data-workflow={step.approve ? (step.approve as string[]).join(",") : genStep?.workflow} data-entries={watchIds.join(",")} data-asked={askedBy(runNow).join(",")} data-pending={String(pendingCards.length)}>
              {missingType && <div class="alert alert-info">This workspace has no “{step.entry_type}” entry type yet.</div>}
              {step.approve && (pendingCards.length > 0 || cards.some((c) => c.dataJson?.status === "queued")) && (
                <section class="approvals" aria-live="polite">
                  {pendingCards.map((c) => (
                    <form method="post" class="approval">
                      <input type="hidden" name="decide" value={c.id} />
                      <p class="approval-title">{approveNames[c.automationSlug ?? ""] ?? "A workflow"} is asking</p>
                      <div class="approval-message">{c.message}</div>
                      {c.detail && <details class="approval-detail"><summary>Show the details</summary><div class="approval-message">{c.detail}</div></details>}
                      {c.imageUrl && <audio class="approval-audio" controls src={c.imageUrl}></audio>}
                      <label class="col"><span>Note (optional)</span><textarea class="input" rows="2" name="note" /></label>
                      <div class="actions">
                        {c.choices?.length
                          ? c.choices.map((label: string, n: number) => <button class:list={["button", n > 0 && "secondary"]} type="submit" name="choice" value={label}>{label}</button>)
                          : <button class="button" type="submit" name="decision" value="approve">Approve</button>}
                        <button class="button secondary" type="submit" name="decision" value="deny">Deny</button>
                      </div>
                    </form>
                  ))}
                  {pendingCards.length === 0 && <p class="muted waiting">A take is being made. Whatever needs your answer appears here, so you can stay on this page.</p>}
                </section>
              )}
              {!missingType && (
                <div class:list={["cards", { rows: step.layout === "list" }]}>
                  {cards.map((r) => {
                    const pic = cardPicture(r.assets, pictureRole);
                    const sound = cardAudio(r.assets, step.audio);
                    const badges = ((step.badges ?? []) as string[]).filter((b) => r.dataJson?.[b]);
                    return (
                      <div class="gwrap">
                      <WizardCard
                        href={`/workspace/entries/${r.id}`}
                        title={r.title}
                        picture={pic}
                        sound={sound}
                        subtitle={subtitleOf(step.subtitle, r.dataJson, 80)}
                        marked={highlightOf(step, r.dataJson)}
                        pills={[...badges.map((b) => String(r.dataJson?.[b])), ...(lengthField && r.dataJson?.[lengthField] && (badges.length > 0 || highlightOf(step, r.dataJson)) ? [`${Number(r.dataJson[lengthField]).toFixed(1)} s`] : [])]}
                      />
                      <div class="gbar">
                      {(step.card_actions ?? []).some((a: any) => cardActionShown(a, r.dataJson)) && (
                        <div class="gacts">
                          {(step.card_actions as { label: string; when?: any; file?: { accept?: string; assets?: boolean } }[]).map((a, n) => cardActionShown(a, r.dataJson) && (a.file ? (
                            <button type="button" class="button secondary small" data-card-file={String(n)} data-card-id={r.id} data-card-title={r.title} aria-expanded="false">{a.label}</button>
                          ) : (
                            <form method="post" class="gact">
                              <input type="hidden" name="action" value="card" />
                              <input type="hidden" name="card_id" value={r.id} />
                              <input type="hidden" name="card_do" value={String(n)} />
                              <button class="button secondary small" type="submit">{a.label}</button>
                            </form>
                          )))}
                        </div>
                      )}
                      {step.trash && (
                        <form method="post" class="gtrash" data-confirm={highlightOf(step, r.dataJson) ? `“${r.title}” is the one this plays. Move it to the Trash? What was already set from it stays until you choose another.` : `Move “${r.title}” to the Trash? You can bring it back from the Trash.`}>
                          <input type="hidden" name="action" value="trash" />
                          <input type="hidden" name="trash_id" value={r.id} />
                          <button type="submit" title="Move to the Trash">🗑 Remove</button>
                        </form>
                      )}
                      </div>
                      </div>
                    );
                  })}
                  {cards.length === 0 && <p class="muted none">{step.empty ?? `No ${typeName.toLowerCase()} yet.`}</p>}
                  {/* A card action's file box, once for the step: the script puts it under the card whose button was pressed and posts it as soon as it holds an asset. */}
                  {cards.length > 0 && cardFiles.map((c) => (
                    <form method="post" class="gfile-panel" data-card-file-panel={String(c.n)} hidden>
                      <input type="hidden" name="action" value="card" />
                      <input type="hidden" name="card_id" value="" />
                      <input type="hidden" name="card_do" value={String(c.n)} />
                      <input type="hidden" name="card_title" value="" />
                      <p class="gfile-for"><strong>{c.label}</strong> <span class="muted">for <span data-card-file-title></span></span></p>
                      <LinkedItemsField
                        field={{ key: `card_file_${c.n}`, label: `Your own ${fileNoun(c.accept)}`, type: "asset", accept: c.accept }}
                        name="asset_id"
                        nameFrom="card_title"
                        pick={c.choose}
                        items={c.choose ? assetsFor(c.accept) : []}
                      />
                    </form>
                  ))}
                </div>
              )}

              {!missingType && (step.add || step.upload || step.generate) && (
                <div class="gactions">
                  {step.add && (
                    <details class="gaction" open={step.add.open === true || undefined}>
                      <summary class="button secondary">＋ {step.add.title ?? `Add ${typeName.toLowerCase()}`}</summary>
                      <form method="post" class="form gform" data-file-box={step.add.file ? fileNoun(addAccept) : undefined} data-ways={step.add.file ? addWays : undefined}>
                        <input type="hidden" name="action" value="add" />
                        {step.add.file?.seconds && <input type="hidden" name="upload_seconds" value="" />}
                        <div class="form-group">
                          <label for="add_title">Name {!step.name && <span class="req" title="Required">*</span>}</label>
                          <input class:list={["input", bad("add_title")]} id="add_title" name="add_title" required={!step.name} placeholder={step.name ? (step.name.placeholder ?? "Leave empty to name it after the line") : undefined} />
                        </div>
                        <SchemaForm schema={{ fields: addFields }} values={addValues} refs={refs} />
                        {step.add.file && (
                          <LinkedItemsField
                            field={{ key: "add_file", label: step.add.file.label ?? "Your own take", type: "asset", accept: addAccept, helpText: step.add.file.help ?? "Record or upload one, then use the first button. Leave it empty to have ElevenLabs make it from the words above." }}
                            name="asset_id"
                            nameFrom="add_title"
                            script={readFrom}
                            hint={step.add.file.hint ?? "Record or upload one take."}
                            pick={!!step.add.file.assets}
                            items={step.add.file.assets ? assetsFor(addAccept ?? "audio/*") : []}
                          />
                        )}
                        <div class="actions">
                          {addButtons.map((b, n) => (
                            <button class:list={["button", n > 0 && "secondary"]} type="submit" name="do" value={String(n)} data-needs-file={b.file} disabled={(!!step.add.file && fileButtonOff(b.file, false)) || undefined} formnovalidate={b.skip_required || undefined}>{b.label}</button>
                          ))}
                        </div>
                        {step.add.file && <p class="muted gneeds" data-file-note>{fileButtonNote(addButtons, false, fileNoun(addAccept), addWays)}</p>}
                      </form>
                    </details>
                  )}
                  {step.upload && (
                    <details class="gaction">
                      <summary class="button secondary">⬆ Upload a {uploadNoun}</summary>
                      <form method="post" class="form gform" enctype="multipart/form-data" data-measure={step.upload.seconds ? "1" : undefined}>
                        <input type="hidden" name="action" value="upload" />
                        {step.upload.seconds && <input type="hidden" name="upload_seconds" value="" />}
                        <p class="muted">The {uploadNoun} becomes a new {typeName.toLowerCase()}, named for the file unless you name it here.</p>
                        <FileDrop accept={uploadAccept ?? undefined} hint={`One ${uploadNoun}.`} nameFrom="upload_title" />
                        <div class="form-group"><label for="upload_title">Name (optional)</label><input class="input" id="upload_title" name="upload_title" /></div>
                        <div class="actions"><button class="button" type="submit">Upload</button></div>
                      </form>
                    </details>
                  )}
                  {step.generate && (
                    <details class="gaction" open={!!(notice || pendingCards.length || runNow)}>
                      <summary class="button secondary">✦ {step.generate.button ?? "Generate"}</summary>
                      <div class="form gform">
                        {flow.forbidden && <div class="alert alert-info">Only a workspace admin can start a workflow today.</div>}
                        {!flow.found && !flow.forbidden && <div class="alert alert-info">This workspace has no workflow “{step.generate.workflow}”.</div>}
                        {flow.found && !flow.enabled && <div class="alert alert-info">“{flow.name}” is switched off: turn it on under <a href="/automation/workflows">Automation → Workflows</a>.</div>}
                        {pendingCards.map((c) => (
                          <form method="post" class="approval">
                            <input type="hidden" name="decide" value={c.id} />
                            <p class="approval-title">{flow.name ?? step.generate.workflow} is asking</p>
                            <div class="approval-message">{c.message}</div>
                            {c.detail && <details class="approval-detail"><summary>Show the details</summary><div class="approval-message">{c.detail}</div></details>}
                            {c.imageUrl && <img class="approval-picture" src={c.imageUrl} alt="" loading="lazy" />}
                            <label class="col"><span>Note (optional)</span><textarea class="input" rows="2" name="note" /></label>
                            <div class="actions">
                              {c.choices?.length
                                ? c.choices.map((label: string, n: number) => <button class:list={["button", n > 0 && "secondary"]} type="submit" name="choice" value={label}>{label}</button>)
                                : <button class="button" type="submit" name="decision" value="approve">Approve</button>}
                              <button class="button secondary" type="submit" name="decision" value="deny">Deny</button>
                            </div>
                          </form>
                        ))}
                        {runNow && runSays && (
                          <p class:list={["run-state", runSays.tone]} role="status" aria-live="polite" data-run={runNow.executionId} data-key={runKey(runNow)} data-over={runSays.over ? "1" : undefined}>
                            <span data-run-text>{runSays.text}</span>
                            {runNow.job && <a href={`/workspace/entries/${runNow.job.entryId}`}>Open the job</a>}
                          </p>
                        )}
                        <form method="post" class="form">
                          <input type="hidden" name="action" value="generate" />
                          {step.generate.prompt && <label class="col"><span>{step.generate.prompt.label}</span><textarea class="input" rows="3" name="prompt" required /></label>}
                          <div class="actions"><button class="button" type="submit" disabled={!flow.canRun}>{step.generate.button ?? "Generate"}</button></div>
                        </form>
                      </div>
                    </details>
                  )}
                </div>
              )}
              {after && <div class="actions"><a class="button" href={stepHref(slug, ctx, after.id)}>Continue →</a></div>}
            </div>
          )}

          {step.kind === "run" && (
            <div class="run" data-watch={notice || pendingCards.length ? "1" : undefined} data-workflow={step.workflow} data-entries={watchIds.join(",")} data-asked={askedBy(runNow).join(",")} data-pending={String(pendingCards.length)}>
              {flow.forbidden && <div class="alert alert-info">Only a workspace admin can start a workflow today. Ask one to run this step; what it makes shows here for everyone.</div>}
              {!flow.found && !flow.forbidden && <div class="alert alert-info">This workspace has no workflow “{step.workflow}”. Install the package that brings it.</div>}
              {flow.found && flow.enabled && <p class="muted runs">Runs “{flow.name}”</p>}
              {lacking && flow.found && flow.enabled && <div class="alert alert-info">{lacking}</div>}
              {flow.found && !flow.enabled && (
                <div class="alert alert-info">“{flow.name}” is switched off. Turn it on under <a href="/automation/workflows">Automation → Workflows</a> (it runs with its author’s permissions), then come back.</div>
              )}

              {picked && (nothingToDo ? (
                !running && <p class="nothing">{nothingLine(step.empty, !!after)}</p>
              ) : (
                <section class="runlist" aria-label="What it works on">
                  <p class="label">{listLine(picked.selection)}</p>
                  <div class="cards rows">
                    {picked.rows.map((r) => (
                      <WizardCard
                        href={`/workspace/entries/${r.id}`}
                        title={r.title}
                        sound={cardAudio(r.assets, step.audio)}
                        subtitle={subtitleOf(step.subtitle, r.dataJson, 120)}
                        pills={((step.badges ?? []) as string[]).filter((b) => r.dataJson?.[b]).map((b) => String(r.dataJson?.[b]))}
                      />
                    ))}
                  </div>
                </section>
              ))}
              {leftSays && <p class="muted leftout">{leftSays}</p>}

              {pendingCards.map((c) => (
                <form method="post" class="approval">
                  <input type="hidden" name="decide" value={c.id} />
                  <p class="approval-title">{flow.name ?? step.workflow} is asking</p>
                  <div class="approval-message">{c.message}</div>
                  {c.detail && <details class="approval-detail"><summary>Show the details</summary><div class="approval-message">{c.detail}</div></details>}
                  {c.imageUrl && <img class="approval-picture" src={c.imageUrl} alt="" loading="lazy" />}
                  <label class="col"><span>Note (optional)</span><textarea class="input" rows="2" name="note" /></label>
                  <div class="actions">
                    {c.choices?.length
                      ? c.choices.map((label, n) => <button class:list={["button", n > 0 && "secondary"]} type="submit" name="choice" value={label}>{label}</button>)
                      : <button class="button" type="submit" name="decision" value="approve">Approve</button>}
                    <button class="button secondary" type="submit" name="decision" value="deny">Deny</button>
                  </div>
                </form>
              ))}

              {runNow && runSays && (
                <p class:list={["run-state", runSays.tone]} role="status" aria-live="polite" data-run={runNow.executionId} data-key={runKey(runNow)} data-over={runSays.over ? "1" : undefined}>
                  <span data-run-text>{runSays.text}</span>
                  {runNow.job && <a href={`/workspace/entries/${runNow.job.entryId}`}>Open the job</a>}
                </p>
              )}
              {jobSays && (
                <div class="said">
                  <p class="label">What the job said</p>
                  <p class="said-text">{jobSays.lead}</p>
                  {jobSays.more && <details><summary>Show all of it</summary><div class="said-text">{jobSays.all}</div></details>}
                </div>
              )}
              {/* What the run wrote, whenever it holds something (also for whoever did not start the run), except while a run is going. */}
              {report && !running && (
                <aside class="showcard report" aria-label={report.label}>
                  <div class="showhead"><strong>{report.label}</strong><a class="muted" href={report.href}>Open {report.title} to edit it ↗</a></div>
                  <div class="said-text">{report.text}</div>
                </aside>
              )}

              <form method="post" class="form">
                <div class="actions">
                  {!nothingToDo && (
                    <button class:list={["button", (pendingCards.length > 0 || (runSays && runSays.tone !== "bad")) && "secondary"]} type="submit" disabled={!flow.canRun || !!lacking}>
                      {picked ? runButton(step.button, picked.selection.count) : pendingCards.length > 0 || decidedCards.length > 0 || runNow ? `${runButton(step.button, null)} again` : runButton(step.button, null)}
                    </button>
                  )}
                  {continues && <a class:list={["button", !(nothingToDo && !running) && runSays && runSays.tone !== "ok" && "secondary"]} href={stepHref(slug, ctx, after!.id)}>Continue →</a>}
                  {held && <span class="muted">Answer the question above before going on: editing the story meanwhile would void it.</span>}
                </div>
              </form>

              {decidedCards.length > 0 && (
                <details class="decided">
                  <summary>Earlier answers ({decidedCards.length})</summary>
                  <ul>
                    {decidedCards.map((c) => (
                      <li><strong>{c.choice ?? c.status}</strong> {c.decidedByName ? `by ${c.decidedByName}` : ""} {c.decidedAt ? `· ${new Date(c.decidedAt).toLocaleString()}` : ""}<span class="muted"> — {c.message.split("\n")[0].slice(0, 120)}</span></li>
                    ))}
                  </ul>
                </details>
              )}
            </div>
          )}

          {step.kind === "review" && (
            <>
            <ul class="checks">
              {checks.map((c) => (
                <li class:list={[c.ok ? "ok" : "no"]}>
                  <span aria-hidden="true">{c.ok ? "✓" : "○"}</span> {c.label}<span class="muted"> ({c.count})</span>
                  {!c.ok && c.step && <a class="fix" href={stepHref(slug, ctx, c.step.id)}>Go to “{c.step.title}” →</a>}
                </li>
              ))}
            </ul>
            <p class="verdict">{allPass ? "Everything is in place." : "Some things are still missing: go back to the step that makes them."}</p>
            {opened && (
              <p class="open"><a class="button" href={def.open!.view ? viewHref(def.open!.view, opened.slug) : `/workspace/entries/${opened.id}`}>{def.open!.label} →</a> <span class="muted">{opened.title}</span></p>
            )}
            {made.length > 0 && (
              <div class="made">
                <p class="label">What you made</p>
                <ul>{made.map((e) => <li><span class="muted">{e.key}:</span> <a href={`/workspace/entries/${e.id}`}>{e.title}</a></li>)}</ul>
              </div>
            )}
            {def.next?.length ? (
              <div class="made">
                <p class="label">What to do next</p>
                <ol>{def.next.map((n) => <li>{n.href ? <a href={n.href}>{n.text}</a> : n.text}</li>)}</ol>
              </div>
            ) : null}
            </>
          )}

          <div class="nav">
            {before ? <a class="button secondary" href={stepHref(slug, ctx, before.id)}>← Previous step</a> : <span />}
            {skipHref && <a class="muted" href={skipHref}>Skip without saving →</a>}
          </div>
        </section>
      </>
    )
  }
  {def && takesRecording && <AudioRecorder />}
  {def && takesPicture && <ImageCropper />}
</AppLayout>

<script>
  import { MAX_PICKS, fileButtonNote, fileButtonOff, pickedLine } from "@/lib/wizard";

  // A multi-select step: the count says how many are picked as boxes are ticked (with those picked on other pages, `data-off`). Select all
  // and Clear work here without a round trip; without a script they post and the server does the same. Clear drops the picks on other
  // pages too (`clear_all`), when the form is next posted.
  document.querySelectorAll<HTMLFormElement>("form[data-multi]").forEach((form) => {
    const boxes = [...form.querySelectorAll<HTMLInputElement>('input[type="checkbox"][name="pick"]')];
    const line = form.querySelector<HTMLElement>("[data-picked]");
    const flag = form.querySelector<HTMLInputElement>("[data-clear-flag]");
    let off = Number(form.dataset.off ?? "0");
    const update = () => {
      const count = off + boxes.filter((b) => b.checked).length;
      if (line) {
        line.textContent = pickedLine(count);
        line.classList.toggle("over", count > MAX_PICKS);
      }
    };
    form.querySelector<HTMLButtonElement>("[data-select-page]")?.addEventListener("click", (e) => {
      e.preventDefault();
      for (const b of boxes) if (!b.closest<HTMLElement>("[data-pick-item]")?.hidden) b.checked = true; // a search narrows "all"
      update();
    });
    form.querySelector<HTMLButtonElement>("[data-clear]")?.addEventListener("click", (e) => {
      e.preventDefault();
      for (const b of boxes) b.checked = false;
      off = 0;
      if (flag) flag.value = "1";
      update();
    });
    form.addEventListener("change", update);
    update();
  });

  /** A sound's length in seconds: what its recorder counted, else by decoding the file; null when it cannot be told. */
  async function soundSeconds(file: File): Promise<number | null> {
    const facts = (window as unknown as { AudioRecorder?: { metadataOf?: (f: File) => { recording?: { duration_seconds?: number } } | null } }).AudioRecorder?.metadataOf?.(file);
    const counted = facts?.recording?.duration_seconds;
    if (typeof counted === "number" && counted > 0) return counted;
    try {
      const Audio = window.AudioContext || (window as any).webkitAudioContext;
      const context = new Audio();
      const seconds = (await context.decodeAudioData(await file.arrayBuffer())).duration;
      void context.close?.();
      return seconds;
    } catch {
      return null; // the length stays unknown: the entry is still made
    }
  }

  // The add form's file box (the asset control: choose, upload or record). A button that needs the file stays off until the box holds one,
  // and a button that must have none goes off once it does: neither can post an error, and the line under them says what is missing.
  document.querySelectorAll<HTMLFormElement>("form[data-file-box]").forEach((form) => {
    const held = form.querySelector<HTMLInputElement>("[data-linked-value]");
    if (!held) return;
    const buttons = [...form.querySelectorAll<HTMLButtonElement>('button[name="do"]')];
    const note = form.querySelector<HTMLElement>("[data-file-note]");
    const refresh = () => {
      const has = !!held.value;
      for (const b of buttons) b.disabled = fileButtonOff(b.dataset.needsFile, has);
      const why = fileButtonNote(buttons.map((b) => ({ label: b.textContent?.trim() ?? "", needs: b.dataset.needsFile })), has, form.dataset.fileBox ?? "file", form.dataset.ways ?? "Upload");
      if (note) {
        note.textContent = why;
        note.hidden = !why;
      }
    };
    // A sound's length is not stored anywhere when it is uploaded or recorded: it is measured here as the box's dialog sends the file up,
    // and posted with the form, so the new entry knows how long it is. It belongs to that upload only: another choice clears it.
    const seconds = form.querySelector<HTMLInputElement>('input[name="upload_seconds"]');
    let measured = ""; // the asset the length is of
    let measuring: Promise<void> | null = null;
    form.addEventListener("linked-field:uploaded", (e) => {
      const { id, file } = (e as CustomEvent<{ id: string; file: File }>).detail;
      if (!seconds) return;
      measured = id;
      seconds.value = "";
      const mine = soundSeconds(file).then((length) => {
        if (measured === id && length) seconds.value = String(length);
      });
      measuring = mine;
      void mine.finally(() => {
        if (measuring === mine) measuring = null;
      });
    });
    held.addEventListener("change", () => {
      if (seconds && held.value !== measured) {
        measured = "";
        seconds.value = "";
      }
      refresh();
    });
    // Saved while a long sound is still being measured: wait for the length, then go on with the button that was pressed.
    form.addEventListener("submit", async (e) => {
      if (!measuring) return;
      e.preventDefault();
      await measuring;
      form.requestSubmit(e.submitter);
    });
    refresh();
  });

  // A card's file button ("Use my own sound") opens the step's one file box under that card, emptied of what the last card left in it.
  // Choosing an asset there, or finishing an upload, is the answer: the form posts at once for that card.
  const filePanels = [...document.querySelectorAll<HTMLFormElement>("form[data-card-file-panel]")];
  const fileButtons = [...document.querySelectorAll<HTMLButtonElement>("button[data-card-file]")];
  const closePanel = (panel: HTMLFormElement) => {
    panel.hidden = true;
    panel.querySelector<HTMLInputElement>('input[name="card_id"]')!.value = "";
    panel.querySelector<HTMLDetailsElement>("[data-linked-picker]")?.removeAttribute("open");
  };
  for (const panel of filePanels) {
    panel.addEventListener("change", (e) => {
      const held = e.target as HTMLInputElement;
      if (held.matches("[data-linked-value]") && held.value && panel.querySelector<HTMLInputElement>('input[name="card_id"]')!.value) panel.submit();
    });
  }
  for (const button of fileButtons) {
    button.addEventListener("click", () => {
      const panel = filePanels.find((p) => p.dataset.cardFilePanel === button.dataset.cardFile);
      const card = button.closest<HTMLElement>(".gwrap");
      if (!panel || !card) return;
      const wasOpen = button.getAttribute("aria-expanded") === "true";
      filePanels.forEach(closePanel);
      fileButtons.forEach((b) => b.setAttribute("aria-expanded", "false"));
      if (wasOpen) return; // pressed again: put away
      // Emptied the way the entry editor's sidebar drops an attachment from the field, so the field redraws its list and buttons itself.
      const field = panel.querySelector<HTMLElement>("[data-linked-field]");
      const held = panel.querySelector<HTMLInputElement>("[data-linked-value]");
      for (const id of (held?.value ?? "").split(",").filter(Boolean)) field?.dispatchEvent(new CustomEvent("linked-field:drop", { detail: { id } }));
      const search = panel.querySelector<HTMLInputElement>("[data-linked-search]");
      if (search?.value) {
        search.value = "";
        search.dispatchEvent(new Event("input"));
      }
      panel.querySelector<HTMLInputElement>('input[name="card_id"]')!.value = button.dataset.cardId ?? "";
      panel.querySelector<HTMLInputElement>('input[name="card_title"]')!.value = button.dataset.cardTitle ?? "";
      panel.querySelector<HTMLElement>("[data-card-file-title]")!.textContent = `“${button.dataset.cardTitle ?? ""}”`;
      card.after(panel);
      panel.hidden = false;
      button.setAttribute("aria-expanded", "true");
      panel.scrollIntoView({ block: "nearest" });
    });
  }
  // A form that moves something to the Trash asks first.
  document.querySelectorAll<HTMLFormElement>("form[data-confirm]").forEach((form) => {
    form.addEventListener("submit", (e) => {
      if (!window.confirm(form.dataset.confirm ?? "Are you sure?")) e.preventDefault();
    });
  });
  // A sound's length is not stored anywhere when it is uploaded or recorded: measure it here, as it is posted, so the new entry knows how long it is.
  document.querySelectorAll<HTMLFormElement>("form[data-measure]").forEach((form) => {
    form.addEventListener("submit", async (e) => {
      const input = form.querySelector<HTMLInputElement>('input[type="file"]');
      const file = input?.files?.[0];
      const out = form.querySelector<HTMLInputElement>('input[name="upload_seconds"]');
      if (!file || !out || out.value) return;
      // A recording brings the length its recorder counted; a file from disk is measured by decoding it.
      if (input?.dataset.seconds) {
        out.value = input.dataset.seconds;
        return;
      }
      e.preventDefault();
      out.value = String((await soundSeconds(file)) ?? "");
      form.submit();
    });
  });
  import { listApprovals } from "@/lib/api/workflowApprovals";
  import { approvalsOf } from "@/lib/wizard";
  import { getRunState } from "@/lib/api/workflowRuns";
  import { runKey, runLine } from "@/lib/runState";
  // A pick list longer than a few: type to narrow it by name (and by the line under it), as you type.
  const search = document.querySelector<HTMLInputElement>("[data-pick-search]");
  if (search) {
    const items = Array.from(document.querySelectorAll<HTMLElement>("[data-pick-item]"));
    const none = document.createElement("p");
    none.className = "muted";
    none.textContent = "Nothing matches. Clear the search, or add a new one above.";
    none.hidden = true;
    items[0]?.parentElement?.after(none);
    search.addEventListener("input", () => {
      const words = search.value.toLowerCase().split(/\s+/).filter(Boolean);
      let shown = 0;
      for (const el of items) {
        const hit = words.every((w) => (el.textContent ?? "").toLowerCase().includes(w));
        el.hidden = !hit;
        if (hit) shown += 1;
      }
      none.hidden = shown > 0;
    });
  }
  // A run step with something going on (just started, or a card waiting): reload when the set of cards for it changes, for ten minutes at most.
  const run = document.querySelector<HTMLElement>(".run[data-watch], .gallery[data-watch]");
  if (run) {
    const slugs = (run.dataset.workflow ?? "").split(",").filter(Boolean);
    const entries = (run.dataset.entries ?? "").split(",").filter(Boolean);
    const asked = (run.dataset.asked ?? "").split(",").filter(Boolean);
    const shown = Number(run.dataset.pending ?? "0");
    const started = Date.now();
    const tick = async () => {
      if (Date.now() - started > 10 * 60 * 1000) return;
      try {
        // Asked for one workflow at a time, so the server narrows the list before its cap: this step's cards are found however many
        // others wait. Counted by the rule the page drew them with, so the two can never disagree (and reload for ever).
        const lists = await Promise.all(slugs.map((slug) => listApprovals(undefined, "pending", { automation: slug })));
        const mine = slugs.flatMap((slug, i) => approvalsOf(lists[i], slug, entries, asked));
        if (mine.length !== shown) return location.reload();
      } catch {
        /* a failed poll just tries again */
      }
      window.setTimeout(tick, 5000);
    };
    window.setTimeout(tick, 5000);
  }
  // A run this step started: say where it stands as it goes, and draw the page again when what it shows would change (a question
  // to answer, the end). Stops when the run is over, or after half an hour.
  const live = document.querySelector<HTMLElement>(".run-state[data-run]:not([data-over])");
  if (live) {
    const RUN_POLL_MS = 4000;
    const RUN_WATCH_MS = 30 * 60 * 1000;
    const words = live.querySelector<HTMLElement>("[data-run-text]");
    const began = Date.now();
    const follow = async () => {
      if (Date.now() - began > RUN_WATCH_MS) return;
      try {
        const now = await getRunState(live.dataset.run ?? "");
        if (!now || runKey(now) !== live.dataset.key) return location.reload();
        if (words) words.textContent = runLine(now).text;
      } catch {
        /* a failed poll just tries again */
      }
      window.setTimeout(follow, RUN_POLL_MS);
    };
    window.setTimeout(follow, RUN_POLL_MS);
  }
</script>

<style>
  .stepper { list-style: none; margin: 0 0 24px; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .stepper a { display: inline-flex; align-items: center; gap: 8px; padding: 6px 12px; border: 1px solid var(--line); border-radius: 999px; font-size: 13px; color: var(--muted); text-decoration: none; background: var(--panel); }
  .stepper .n { display: inline-grid; place-items: center; width: 20px; height: 20px; border-radius: 50%; background: var(--panel-2); font-size: 12px; }
  .stepper .past a { color: var(--ink); }
  .stepper .current a { border-color: var(--accent); color: var(--ink); font-weight: 600; }
  .stepper .current .n { background: var(--accent); color: var(--accent-ink, #fff); }

  /* .card has no padding of its own (the content goes in a .card-body elsewhere), so the step carries it. */
  .step { display: grid; gap: 20px; padding: 28px; width: min(100%, 1040px); box-sizing: border-box; }
  .step h3 { margin: 0; font-size: 24px; letter-spacing: -0.01em; }
  .eyebrow { margin: 0 0 -10px; font-size: 12px; font-weight: 500; color: var(--muted); text-transform: uppercase; letter-spacing: 0.4px; }
  .stepper .done .n { background: color-mix(in srgb, var(--accent) 18%, var(--panel-2)); color: var(--accent); font-weight: 700; }
  .open { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin: 4px 0; }
  .made { display: grid; gap: 6px; }
  .made ul, .made ol { margin: 0; padding-left: 20px; font-size: 14px; display: grid; gap: 4px; }
  .help { margin: 0; color: var(--muted); font-size: 14px; line-height: 1.5; max-width: 70ch; }
  .form { display: grid; gap: 16px; }
  .label { margin: 0; font-size: 12px; font-weight: 500; color: var(--muted); text-transform: uppercase; letter-spacing: 0.4px; }
  .choices { display: grid; gap: 8px; }
  /* A pick with pictures: the art leads. The radio is hidden; the tile shows the choice with a tint and a check. */
  .pick-search { max-width: 28rem; }
  .tile[hidden], .choice[hidden] { display: none; }
  .current { margin: 0 0 12px; display: grid; gap: 6px; justify-items: start; }
  .current img { max-width: min(100%, 22rem); max-height: 20rem; border-radius: var(--radius); object-fit: contain; background: var(--bg); }
  .current figcaption { color: var(--muted); font-size: 14px; }
  .tiles { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 14px; }
  /* A multi-select: each card has its own checkbox, top left, and the card itself toggles it. */
  .tiles.multi .tile input { inset: auto; top: 10px; left: 10px; width: 20px; height: 20px; opacity: 1; accent-color: var(--accent); z-index: 1; }
  .tiles.multi .tile:has(input:checked)::after { content: none; }
  .multibar { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 10px; }
  .multibar .label { margin-right: auto; }
  .picked { font-size: 14px; font-weight: 500; }
  .picked.over { color: var(--color-error, #c0392b); }
  .multipager { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; font-size: 14px; color: var(--muted); }
  .picks { display: grid; gap: 8px; }
  .enter-stays { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); border: 0; padding: 0; }
  .tile { position: relative; display: grid; justify-items: center; align-content: start; gap: 8px; padding: 14px 10px 12px; text-align: center; cursor: pointer; border: 1px solid transparent; border-radius: calc(var(--radius) + 4px); background: var(--bg); font-size: 15px; transition: border-color 0.15s, background-color 0.15s; }
  .tile:hover { border-color: color-mix(in srgb, var(--accent) 45%, transparent); }
  .tile input { position: absolute; opacity: 0; inset: 0; width: 100%; height: 100%; margin: 0; cursor: pointer; }
  .tile:has(input:checked) { border-color: var(--accent); background: color-mix(in srgb, var(--accent) 9%, var(--bg)); box-shadow: 0 0 0 1px var(--accent); }
  .tile:has(input:checked)::after { content: "✓"; position: absolute; top: 8px; right: 8px; display: grid; place-items: center; width: 22px; height: 22px; border-radius: 50%; background: var(--accent); color: var(--accent-ink, #fff); font-size: 13px; font-weight: 700; }
  .tile:has(input:focus-visible) { outline: 2px solid var(--accent); outline-offset: 2px; }
  .tile strong { font-weight: 600; }
  .tpic { width: 112px; height: 112px; display: grid; place-items: center; border-radius: var(--radius); overflow: hidden; background: var(--panel-2); }
  .tpic img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .tpic .gnone { font-size: 44px; }
  @media (prefers-reduced-motion: reduce) { .tile { transition: none; } }
  /* Everything you can pick in a step is a darker panel with no outline; the accent outline shows on hover and on the one picked. */
  .choice { display: flex; gap: 10px; align-items: flex-start; cursor: pointer; padding: 10px 14px; border: 1px solid transparent; border-radius: var(--radius); background: var(--bg); }
  .choice:hover { border-color: color-mix(in srgb, var(--accent) 45%, transparent); }
  .choice:has(input:checked) { border-color: var(--accent); }
  .actions { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }
  .req { color: var(--color-error, #c0392b); }
  .replace { display: grid; gap: 10px; }

  .rows { display: grid; gap: 12px; }
