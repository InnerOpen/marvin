---
import FilterSearch from "@/components/FilterSearch.astro";
import AppLayout from "@/layouts/AppLayout.astro";
import { getAuthToken } from "@/lib/api/client";
import { listResources, type ResourceRead } from "@/lib/api/resources";
import { listTags } from "@/lib/api/tags";
import { listTrashedResources } from "@/lib/api/trash";
import { FULL_CONTENT_ACCESS, getContentAccess } from "@/lib/api/workspaces";
import { filterResources, isFiltered, readResourceView, resourceHref, SORTS } from "@/lib/resourceView";

const authToken = getAuthToken(Astro.cookies);
// Everyone reads; adding, editing and deleting resources is EDITOR+ (Move to Trash is on a resource's page).
const { canEdit } = authToken ? await getContentAccess(authToken) : FULL_CONTENT_ACCESS;
// The filters live in the URL (lib/resourceView.ts). The list API takes none, so all are loaded and the page picks.
const view = readResourceView(Astro.url.searchParams);

let resources: ResourceRead[] = [];
let trashedResources: ResourceRead[] = [];
let tags: any[] = [];
let error: string | null = null;

if (!authToken) {
  error = "Authentication required";
} else {
  try {
    [resources, trashedResources, tags] = await Promise.all([
      listResources(authToken),
      listTrashedResources(authToken).catch(() => []),
      listTags(authToken).catch(() => []),
    ]);
  } catch (e) {
    error = e instanceof Error ? e.message : String(e);
    console.error("[Resources] Failed to load:", error);
  }
}

const inTrash = view.status === "trashed";
const rows = filterResources(inTrash ? trashedResources : resources, view);
const typeLabel = (t: string) => t.charAt(0).toUpperCase() + t.slice(1).replace(/[-_]/g, " ");
const hostOf = (url?: string | null) => {
  try {
    return url ? new URL(url).hostname.replace(/^www\./, "") : "";
  } catch {
    return "";
  }
};
const tagNames = new Map(tags.map((t: any) => [t.slug, t.name]));

// The search bar (FilterSearch): the types in use as buttons, the rest as rows.
const typesInUse = [...new Set([...resources.map((r) => r.resourceType), ...(view.type ? [view.type] : [])])].sort();
const pills = typesInUse.map((t) => ({ label: typeLabel(t), href: resourceHref(view, { type: view.type === t ? "" : t }), on: view.type === t }));
const yesNo = [{ value: "yes", label: "Yes" }, { value: "no", label: "No" }];
const rowFields: Record<string, { label: string; options: { value: string; label: string }[] }> = {
  ...(tags.length ? { tag: { label: "Tag", options: tags.map((t: any) => ({ value: t.slug, label: t.name })) } } : {}),
  link: { label: "Has a link", options: yesNo },
  external: { label: "Has an external ID", options: yesNo },
};
const rowValues = Object.keys(rowFields).filter((k) => (view as any)[k]).map((k) => ({ field: k, value: (view as any)[k] as string }));
const optionsOpen = rowValues.length > 0 || inTrash || view.sort !== "name";
---

<AppLayout title="Resources" eyebrow="Content">
  <div class="toolbar">
    <div>
      <h2 style="margin:0;font-size:20px;">{inTrash ? "Resources in the Trash" : "Resources"}</h2>
      <p style="margin:4px 0 0;color:var(--muted);">
        {isFiltered(view) ? `${rows.length} ${rows.length === 1 ? "resource" : "resources"}` : "External references, suppliers, tools, and materials"}
      </p>
    </div>
    <div style="display:flex;gap:0.75rem;">
      {canEdit && <a href="/workspace/resources/new" class="button">Add Resource</a>}
    </div>
  </div>

  {error ? (
    <div class="error-banner">
      <p><strong>Error loading resources:</strong> {error}</p>
      <button onclick="location.reload()" class="button secondary">Retry</button>
    </div>
  ) : resources.length === 0 && trashedResources.length === 0 ? (
    <div class="empty-state">
      <div class="empty-icon">🔗</div>
      <h3>No resources yet</h3>
      <p>Resources are external references like suppliers, tools, fabrics, or documentation.</p>
      {canEdit && <a href="/workspace/resources/new" class="button">Add Your First Resource</a>}
    </div>
  ) : (
    <>
      <FilterSearch
        path="/workspace/resources"
        q={view.q}
        placeholder="Search names and descriptions…"
        pills={pills}
        fields={rowFields}
        rows={rowValues}
        open={optionsOpen}
        filtered={isFiltered(view)}
      >
        <Fragment slot="extras">
          <label>Sort
            <select name="sort" data-default="name">
              {Object.entries(SORTS).map(([v, l]) => <option value={v} selected={view.sort === v}>{l}</option>)}
            </select>
          </label>
          {(trashedResources.length > 0 || inTrash) && (
            <label><input type="checkbox" name="status" value="trashed" checked={inTrash} /> The Trash ({trashedResources.length})</label>
          )}
        </Fragment>
      </FilterSearch>

      {rows.length === 0 ? (
        <div class="empty-state">
          <h3>Nothing matches</h3>
          <p><a href="/workspace/resources">Clear the filters</a></p>
        </div>
      ) : (
        <>
          <div class="view-toggle">
            <button class="toggle-btn active" id="view-grid" title="Cards">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><rect x="1" y="1" width="6" height="6" rx="1"/><rect x="9" y="1" width="6" height="6" rx="1"/><rect x="1" y="9" width="6" height="6" rx="1"/><rect x="9" y="9" width="6" height="6" rx="1"/></svg>
              Cards
            </button>
            <button class="toggle-btn" id="view-list" title="A row each">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><rect x="1" y="2" width="14" height="2.5" rx="1"/><rect x="1" y="6.75" width="14" height="2.5" rx="1"/><rect x="1" y="11.5" width="14" height="2.5" rx="1"/></svg>
              List
            </button>
          </div>

          <div id="grid-view">
            <ul class="resource-grid">
              {rows.map((r) => (
                <li class:list={["resource-card", { trashed: inTrash }]}>
                  <a class="card-link" href={`/workspace/resources/${r.id}`}>
                    <span class="card-top">
                      <span class="type-pill">{typeLabel(r.resourceType)}</span>
                      {inTrash && <span class="type-pill">In the Trash</span>}
                    </span>
                    <span class="card-name">{r.name}</span>
                    {r.description && <span class="card-desc">{r.description}</span>}
                    {(r.tags?.length ?? 0) > 0 && <span class="card-tags">{r.tags.map((t) => `#${tagNames.get(t) ?? t}`).join("  ")}</span>}
                  </a>
                  {hostOf(r.url) && <a class="card-host" href={r.url!} target="_blank" rel="noopener noreferrer">{hostOf(r.url)} ↗</a>}
                </li>
              ))}
            </ul>
          </div>

          <div id="list-view" style="display:none;">
            <ul class="inbox">
              {rows.map((r) => (
                <li class="inbox-row">
                  <a class="inbox-link" href={`/workspace/resources/${r.id}`}>
                    <span class="inbox-main">
                      <span class="inbox-title">{r.name}</span>
                      {r.description && <span class="inbox-summary">{r.description}</span>}
                    </span>
                    <span class="inbox-meta">
                      {inTrash && <span class="type-pill">In the Trash</span>}
                      {r.externalId && <code class="inbox-ext">{r.externalId}</code>}
                      <span class="type-pill">{typeLabel(r.resourceType)}</span>
                    </span>
                  </a>
                  {hostOf(r.url) && <a class="inbox-host" href={r.url!} target="_blank" rel="noopener noreferrer">{hostOf(r.url)} ↗</a>}
                  {canEdit && !inTrash && (
                    <button type="button" class="row-trash" data-resource-id={r.id} title="Move to the Trash (restore it from there)">Move to Trash</button>
                  )}
                </li>
              ))}
            </ul>
          </div>
        </>
      )}
    </>
  )}
</AppLayout>

<script>
  import { createSdkClient } from '@/lib/sdk';
  import { isForbidden } from '@/lib/workspaceRole';

  // Move to Trash takes the row out in place, keeping the filters; it's reversible, so it doesn't ask.
  document.querySelectorAll<HTMLButtonElement>('.row-trash[data-resource-id]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      btn.disabled = true;
      btn.textContent = 'Moving…';
      try {
        await createSdkClient().resources.delete(btn.dataset.resourceId!);
        btn.closest('li')?.remove();
      } catch (error: any) {
        btn.disabled = false;
        btn.textContent = isForbidden(error) ? 'Not allowed' : 'Failed, try again';
      }
    });
  });

  // Cards or List; the choice is remembered (the old table / by-type choices open as Cards).
  type View = 'grid' | 'list';
  const views: Record<View, { el: HTMLElement | null; btn: HTMLElement | null }> = {
    grid: { el: document.getElementById('grid-view'), btn: document.getElementById('view-grid') },
    list: { el: document.getElementById('list-view'), btn: document.getElementById('view-list') },
  };
  function setView(view: View) {
    for (const [name, v] of Object.entries(views) as [View, (typeof views)[View]][]) {
      if (v.el) v.el.style.display = name === view ? '' : 'none';
      v.btn?.classList.toggle('active', name === view);
    }
    try { localStorage.setItem('resources-view', view); } catch { /* a private window: the choice just isn't kept */ }
  }
  for (const [name, v] of Object.entries(views) as [View, (typeof views)[View]][]) v.btn?.addEventListener('click', () => setView(name));
  let saved: string | null = null;
  try { saved = localStorage.getItem('resources-view'); } catch { /* as above */ }
  if (saved === 'grid' || saved === 'list') setView(saved);
</script>

<style>
  .error-banner { padding: 1.5rem; background: var(--color-error-bg); border: 1px solid var(--color-error); border-radius: var(--radius); display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .error-banner p { margin: 0; color: var(--color-error); }
  .empty-icon { font-size: 4rem; margin-bottom: 1rem; opacity: 0.5; }
  .empty-state h3 { margin: 0; font-size: 1.5rem; font-weight: 600; }
  .empty-state p { margin: 0; color: var(--muted); max-width: 32rem; }

  .view-toggle { display: flex; gap: 2px; background: var(--panel-2); border-radius: 6px; padding: 2px; width: fit-content; margin-bottom: 1.5rem; }
  .toggle-btn { display: flex; align-items: center; gap: 0.375rem; padding: 0.375rem 0.75rem; border: none; border-radius: 4px; background: transparent; color: var(--muted); font-size: 0.8125rem; font-weight: 500; cursor: pointer; transition: all 0.15s; }
  .toggle-btn:hover { color: var(--ink); }
  .toggle-btn.active { background: var(--panel); color: var(--ink); box-shadow: 0 1px 2px rgba(0, 0, 0, 0.06); }

  .type-pill { font-size: 0.7rem; font-weight: 600; padding: 0.1rem 0.5rem; border-radius: 10px; background: var(--panel-2); color: var(--muted); white-space: nowrap; }

  .resource-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 1rem; margin: 0; padding: 0; list-style: none; }
  .resource-card { display: flex; flex-direction: column; min-width: 0; border: 1px solid var(--line); border-radius: var(--radius); background: var(--panel); transition: border-color 0.12s; }
  .resource-card:hover { border-color: var(--accent); }
  .resource-card.trashed { opacity: 0.6; }
  .card-link { flex: 1; display: flex; flex-direction: column; gap: 0.4rem; padding: 0.9rem 1rem 0.5rem; color: var(--ink); text-decoration: none; }
  .card-top { display: flex; gap: 0.4rem; }
  .card-name { font-weight: 600; font-size: 0.95rem; }
  .card-desc { font-size: 0.8rem; color: var(--muted); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .card-tags { font-size: 0.75rem; color: var(--muted); }
  .card-host { padding: 0 1rem 0.8rem; font-size: 0.75rem; color: var(--accent); text-decoration: none; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .card-host:hover, .inbox-host:hover { text-decoration: underline; }

  .inbox { list-style: none; margin: 0; padding: 0; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; background: var(--panel); }
  .inbox-row { display: flex; align-items: center; }
  .inbox-row + .inbox-row { border-top: 1px solid var(--line); }
  .inbox-link { flex: 1; min-width: 0; display: flex; align-items: center; gap: 0.75rem; padding: 0.7rem 1rem; text-decoration: none; color: var(--ink); transition: background 0.12s; }
  .inbox-link:hover { background: var(--panel-2); }
  .inbox-main { flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; gap: 0.1rem; }
  .inbox-title { font-weight: 600; font-size: 0.9rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .inbox-summary { font-size: 0.8rem; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .inbox-meta { flex: 0 0 auto; display: flex; align-items: center; gap: 0.6rem; }
  .inbox-ext { font-size: 0.7rem; color: var(--muted); }
  .inbox-host { flex: 0 0 auto; margin-right: 1rem; font-size: 0.75rem; color: var(--accent); text-decoration: none; white-space: nowrap; }
  .row-trash { flex: 0 0 auto; margin-right: 1rem; padding: 0.25rem 0.6rem; border: 1px solid var(--line); border-radius: 6px; background: transparent; color: var(--muted); font: inherit; font-size: 0.75rem; cursor: pointer; white-space: nowrap; }
  .row-trash:hover { color: var(--color-error, #dc2626); border-color: var(--color-error, #dc2626); }
  @media (max-width: 640px) {
    .inbox-ext, .inbox-host { display: none; }
  }
</style>
