---
import EntryCard from "@/components/EntryCard.astro";
import FilterBar from "@/components/FilterBar.astro";
import AppLayout from "@/layouts/AppLayout.astro";
import { fetchApi, getAuthToken } from "@/lib/api/client";
import { type CollectionRead, getCollectionEntries, listCollections } from "@/lib/api/collections";
import { type EntryRead, listEntries } from "@/lib/api/entries";
import { type EntryTypeRead, listEntryTypes } from "@/lib/api/entryTypes";
import { listTags, type TagRead } from "@/lib/api/tags";
import { FULL_CONTENT_ACCESS, getContentAccess } from "@/lib/api/workspaces";
import { condLabel, condsHref, fieldsFor, readConds, STATUSES, toSpec, withoutCond } from "@/lib/entryQuery";

const authToken = getAuthToken(Astro.cookies);
// Everyone reads; creating entries is AUTHOR+.
const access = authToken ? await getContentAccess(authToken) : FULL_CONTENT_ACCESS;

// Get URL parameters for pre-filtering
const statusParam = Astro.url.searchParams.get("status");
const statusFilters = statusParam ? statusParam.split(",").map((s) => s.trim()) : [];
// A single tag slug can pre-select the tag filter (deep-link, e.g. ?tag=leather).
const tagParam = Astro.url.searchParams.get("tag") || "";
// Structured search: condition chips in `?c=` (lib/entryQuery.ts). With any, the page shows what the engine finds.
const conds = readConds(Astro.url.searchParams);
// Set by the entry page's Move to Trash: offer Undo (restore) right here.
const trashedParam = Astro.url.searchParams.get("trashed") || "";

let entries: EntryRead[] = [];
let entryTypes: EntryTypeRead[] = [];
let collections: CollectionRead[] = [];
let allTags: TagRead[] = [];
let error: string | null = null;

// Ensure we have auth token before making requests
if (!authToken) {
  error = "Authentication required";
} else {
  try {
    [entries, entryTypes, collections, allTags] = await Promise.all([
      listEntries(authToken),
      listEntryTypes(authToken),
      listCollections(authToken),
      listTags(authToken),
    ]);
  } catch (e) {
    error = e instanceof Error ? e.message : String(e);
    console.error("[Entries] Failed to load:", error);
  }
}

// The structured search's results (the same engine as the assistants' find_entries).
type QueryResult = { entries: EntryRead[]; total: number; note?: string | null; unknownOps?: string[] };
let search: QueryResult | null = null;
if (conds.length && authToken && !error) {
  try {
    search = await fetchApi<QueryResult>("/api/platform/entries/query", { method: "POST", body: JSON.stringify({ spec: toSpec(conds), limit: 500 }) }, authToken);
  } catch (e) {
    search = { entries: [], total: 0, note: e instanceof Error ? e.message : String(e) };
  }
}
const chosenTypes = (conds.find((c) => c.dim === "type")?.value as string[] | undefined) ?? [];
const typeFields = fieldsFor(entryTypes, chosenTypes);
const labels = {
  types: Object.fromEntries(entryTypes.map((t) => [t.slug, t.name])),
  tags: Object.fromEntries(allTags.map((t) => [t.slug, t.name])),
  collections: Object.fromEntries(collections.map((c) => [c.slug, c.name])),
  fields: Object.fromEntries(entryTypes.flatMap((t) => ((t.schemaJson?.fields as any[]) ?? []).map((f) => [f.key, f.label || f.key]))),
};
// What the chip editor offers (its script reads this).
const builderData = {
  conds,
  types: entryTypes.map((t) => ({ value: t.slug, label: t.name })),
  statuses: Object.entries(STATUSES).map(([value, label]) => ({ value, label })),
  tags: allTags.map((t) => ({ value: t.slug, label: t.name })).sort((a, b) => a.label.localeCompare(b.label)),
  collections: collections.filter((c: any) => (c.targetType ?? "entry") === "entry").map((c) => ({ value: c.slug, label: c.name })),
  fields: typeFields,
};

// Create a map of collection ID to collection for quick lookup
const collectionsMap = new Map(collections.map((c) => [c.id, c]));
const trashCollection = collections.find((c: any) => c.isSystem && c.slug === "trash");
// Trashed entries aren't in the list above: load the Trash's own, so the Trash group lists them and "In the Trash"
// in the status filter shows them. "All statuses" leaves them out (the filter script), as everywhere else.
let trashedEntries: EntryRead[] = [];
if (trashCollection && (trashCollection.entryCount ?? 0) > 0 && authToken) {
  trashedEntries = await getCollectionEntries(trashCollection.id, authToken).catch(() => []);
}

// Sort entry types by sort_order
const sortedTypes = entryTypes.sort((a, b) => a.sortOrder - b.sortOrder);

// Tags that are actually applied to something, for the filter dropdown (alpha by name).
const filterTags = allTags.filter((t) => (t.entryCount ?? 0) > 0).sort((a, b) => a.name.localeCompare(b.name));

// Group entries by collection (entries can appear in multiple collections)
const collectionGroups = new Map<string, { collection: CollectionRead; entries: EntryRead[] }>();
const uncollected: EntryRead[] = [];

for (const entry of entries) {
  if (entry.collections && entry.collections.length > 0) {
    for (const item of entry.collections) {
      const colId = typeof item === "string" ? item : item.id;
      const col = collectionsMap.get(colId);
      if (col) {
        if (!collectionGroups.has(colId)) {
          collectionGroups.set(colId, { collection: col, entries: [] });
        }
        collectionGroups.get(colId)!.entries.push(entry);
      }
    }
  } else {
    uncollected.push(entry);
  }
}

if (trashCollection && trashedEntries.length > 0) {
  collectionGroups.set(trashCollection.id, { collection: trashCollection, entries: trashedEntries });
}

// Every entry collection that has entries gets a group, from its own count — not only the ones the loaded entries
// name: trashed entries aren't loaded here, so the Trash (and a collection whose entries are all in it) would vanish.
// A group with nothing loaded shows its count and links to the collection.
for (const col of collections) {
  const holdsEntries = (col.targetType ?? "entry") === "entry";
  if (holdsEntries && (col.entryCount ?? 0) > 0 && !collectionGroups.has(col.id)) {
    collectionGroups.set(col.id, { collection: col, entries: [] });
  }
}

// Sort groups by collection sort_order (Inbox/Drafts/… lead), then name as a tiebreaker.
const sortedGroups = [...collectionGroups.values()].sort(
  (a, b) => a.collection.sortOrder - b.collection.sortOrder || a.collection.name.localeCompare(b.collection.name),
);
---

<AppLayout title="Entries">
  {error ? (
    <div class="error-banner">
      <p><strong>Error loading entries:</strong> {error}</p>
      <button onclick="location.reload()" class="button secondary">Retry</button>
    </div>
  ) : (
    <>
      <div class="toolbar">
        <div>
          <h2 style="margin:0;font-size:20px;">Entries</h2>
          <p style="margin:4px 0 0;color:var(--muted);">Manage all your content entries.</p>
        </div>
        <div style="display:flex;gap:0.75rem;">
          <FilterBar
            searchPlaceholder="Search entries..."
            filters={[
              {
                id: "type-filter",
                label: "Types",
                options: sortedTypes.map(type => ({
                  value: type.id,
                  label: type.name
                }))
              },
              {
                id: "status-filter",
                label: "Statuses",
                options: [
                  { value: "inbox", label: "Inbox" },
                  { value: "draft", label: "Draft" },
                  { value: "needs_review", label: "Needs Review" },
                  { value: "approved", label: "Approved" },
                  { value: "published", label: "Published" },
                  { value: "archived", label: "Archived" },
                  { value: "trashed", label: "In the Trash" }
                ]
              },
              ...(filterTags.length > 0 ? [{
                id: "tag-filter",
                label: "Tags",
                defaultValue: tagParam,
                options: filterTags.map(tag => ({ value: tag.slug, label: tag.name }))
              }] : [])
            ]}
          />
          {access.canAuthor && <a class="button" href="/workspace/entries/new">New Entry</a>}
        </div>
      </div>

      <div class="query-bar" aria-label="Search by conditions">
        {conds.map((c, i) => (
          <span class="query-chip">
            {condLabel(c, labels)}
            <a href={condsHref(withoutCond(conds, i))} class="query-chip-x" aria-label={`Remove “${condLabel(c, labels)}”`}>×</a>
          </span>
        ))}
        <button type="button" class="query-add" id="query-add">+ Add condition</button>
        {conds.length > 0 && (
          <>
            {search && <span class="query-count">{search.total} {search.total === 1 ? "entry" : "entries"}</span>}
            <a href="/workspace/entries" class="query-clear">Clear</a>
          </>
        )}
        <form class="query-editor" id="query-editor" hidden>
          <select id="q-dim" aria-label="Filter on"></select>
          <select id="q-op" aria-label="How"></select>
          <span id="q-value"></span>
          <button type="submit" class="button small">Add</button>
          <button type="button" class="button secondary small" id="q-cancel">Cancel</button>
        </form>
        <script type="application/json" id="query-data" set:html={JSON.stringify(builderData)} />
      </div>
      {search?.note && <p class="query-note">{search.note}</p>}

      {trashedParam && (
        <div class="undo-notice" id="undo-notice" data-entry-id={trashedParam} role="status">
          <span>Entry moved to the Trash.</span>
          <button type="button" class="button secondary" id="undo-trash">Undo</button>
          {trashCollection && <a href={`/workspace/collections/${trashCollection.id}`}>Open the Trash</a>}
        </div>
      )}

      {conds.length > 0 ? (
        search && search.entries.length > 0 ? (
          <section class="grid" aria-label="Matching entries">
            {search.entries.map((entry) => (
              <div class="query-result">
                <EntryCard entry={entry} collectionsMap={collectionsMap} />
              </div>
            ))}
            {search.total > search.entries.length && <p class="query-more">Showing {search.entries.length} of {search.total}: add a condition to narrow it.</p>}
          </section>
        ) : (
          <div class="empty-state">
            <h3>Nothing matches</h3>
            <p>Remove a condition, or <a href="/workspace/entries">clear them all</a>.</p>
          </div>
        )
      ) : entries.length === 0 && trashedEntries.length === 0 ? (
        <div class="empty-state">
          <div class="empty-icon">📝</div>
          <h3>No entries yet</h3>
          <p>Entries are your content items like blog posts, products, pages, or any structured content.</p>
          {access.canAuthor && <a href="/workspace/entries/new" class="button">Create Your First Entry</a>}
        </div>
      ) : (
        <>
          <div class="view-toggle">
            <button class="toggle-btn active" id="view-grid" title="All entries">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><rect x="1" y="1" width="6" height="6" rx="1"/><rect x="9" y="1" width="6" height="6" rx="1"/><rect x="1" y="9" width="6" height="6" rx="1"/><rect x="9" y="9" width="6" height="6" rx="1"/></svg>
              All
            </button>
            <button class="toggle-btn" id="view-grouped" title="Group by collection">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><rect x="1" y="1" width="14" height="3" rx="1"/><rect x="3" y="5.5" width="12" height="2" rx="0.5" opacity="0.6"/><rect x="3" y="8.5" width="12" height="2" rx="0.5" opacity="0.6"/><rect x="1" y="12" width="14" height="3" rx="1"/></svg>
              Collections
            </button>
          </div>

          {entries.length === 0 && trashCollection && (
            <p class="all-trashed-note" id="all-trashed-note">
              No entries outside the Trash. <a href={`/workspace/collections/${trashCollection.id}`}>Open the Trash</a> to restore
              them, or pick “In the Trash” in Statuses.
            </p>
          )}

          {/* Flat grid view */}
          <section class="grid view-section" id="grid-view" aria-label="Entries">
            {[...entries, ...trashedEntries].map((entry) => {
              const matchesStatusFilter = statusFilters.length === 0 || statusFilters.includes(entry.status);
              return (
                <div class="entry-wrapper"
                  data-type={entry.entryTypeId}
                  data-status={entry.status}
                  data-title={entry.title.toLowerCase()}
                  data-summary={(entry.summary || '').toLowerCase()}
                  data-collections={entry.collections?.map((c: any) => typeof c === 'string' ? c : c.id).join(',') || ''}
                  data-tags={((entry.tags as string[] | undefined) || []).join(' ')}
                  style={matchesStatusFilter ? '' : 'display: none;'}>
                  <EntryCard entry={entry} collectionsMap={collectionsMap} />
                </div>
              );
            })}
          </section>

          {/* Grouped by collection view */}
          <div class="view-section" id="grouped-view" style="display:none;">
            {sortedGroups.map(({ collection, entries: groupEntries }) => (
              <details class="collection-group" data-collection-id={collection.id}>
                <summary class="collection-header">
                  <h3 class="collection-title">
                    <span class="collapse-chevron"></span>
                    {collection.icon && <span class="collection-icon">{collection.icon}</span>}
                    <a
                      href={`/workspace/collections/${collection.id}`}
                      class="collection-link"
                      title={`Open ${collection.name}`}
                      onclick="event.stopPropagation()"
                    >{collection.name}</a>
                    <span class="collection-count">{Math.max(groupEntries.length, collection.entryCount ?? 0)}</span>
                  </h3>
                  {collection.description && (
                    <p class="collection-desc">{collection.description}</p>
                  )}
                </summary>
                {groupEntries.length === 0 && (
                  <p class="collection-desc">
                    Its entries aren't listed here{collection.slug === "trash" ? " (deleted entries)" : ""}.{" "}
                    <a href={`/workspace/collections/${collection.id}`}>Open {collection.name}</a>
                  </p>
                )}
                <section class="grid" aria-label={`${collection.name} entries`}>
                  {groupEntries.map((entry) => (
                    <div class="entry-wrapper"
                      data-in-trash={collection.id === trashCollection?.id ? "" : undefined}
                      data-type={entry.entryTypeId}
                      data-status={entry.status}
                      data-title={entry.title.toLowerCase()}
                      data-summary={(entry.summary || '').toLowerCase()}
                      data-tags={((entry.tags as string[] | undefined) || []).join(' ')}>
                      <EntryCard entry={entry} collectionsMap={collectionsMap} />
                    </div>
                  ))}
                </section>
              </details>
            ))}

            {uncollected.length > 0 && (
              <details class="collection-group" data-collection-id="uncollected">
                <summary class="collection-header">
                  <h3 class="collection-title">
                    <span class="collapse-chevron"></span>
                    Uncollected
                    <span class="collection-count">{uncollected.length}</span>
                  </h3>
                </summary>
                <section class="grid" aria-label="Uncollected entries">
                  {uncollected.map((entry) => (
                    <div class="entry-wrapper"
                      data-type={entry.entryTypeId}
                      data-status={entry.status}
                      data-title={entry.title.toLowerCase()}
                      data-summary={(entry.summary || '').toLowerCase()}
                      data-tags={((entry.tags as string[] | undefined) || []).join(' ')}>
                      <EntryCard entry={entry} collectionsMap={collectionsMap} />
                    </div>
                  ))}
                </section>
              </details>
            )}
          </div>
        </>
      )}
    </>
  )}
</AppLayout>

<script>
  import { restoreFromTrash } from '@/lib/api/trash';
  import { addCond, condsHref, DIMENSIONS, OP_LABELS, opsFor, type Cond, type FieldDef } from '@/lib/entryQuery';

  // The chip editor: what to filter on → how → the value → Add, which reloads with the new chip in ?c=.
  const queryData = JSON.parse(document.getElementById('query-data')?.textContent || '{}');
  const editor = document.getElementById('query-editor') as HTMLFormElement | null;
  const dimSel = document.getElementById('q-dim') as HTMLSelectElement | null;
  const opSel = document.getElementById('q-op') as HTMLSelectElement | null;
  const valueBox = document.getElementById('q-value');
  type Opt = { value: string; label: string };
  const choices: Record<string, Opt[]> = { type: queryData.types, status: queryData.statuses, tag: queryData.tags, collection: queryData.collections };
  const fields: FieldDef[] = queryData.fields ?? [];
  const fieldOf = (dim: string) => fields.find((f) => `field:${f.key}` === dim);
  const option = (o: Opt) => { const el = document.createElement('option'); el.value = o.value; el.textContent = o.label; return el; };

  function fillDims() {
    if (!dimSel) return;
    dimSel.replaceChildren(
      ...Object.entries(DIMENSIONS).map(([value, label]) => option({ value, label })),
      ...fields.map((f) => option({ value: `field:${f.key}`, label: `${f.label} (field)` })),
    );
  }
  function fillOps() {
    if (!dimSel || !opSel) return;
    opSel.replaceChildren(...opsFor(dimSel.value, fieldOf(dimSel.value)).map((op) => option({ value: op, label: OP_LABELS[op] ?? op })));
    fillValue();
  }
  function fillValue() {
    if (!dimSel || !opSel || !valueBox) return;
    const dim = dimSel.value, op = opSel.value, field = fieldOf(dim);
    let input: HTMLElement | null = null;
    const list = choices[dim] ?? (field?.kind === 'select' ? field.options : undefined);
    if (op === 'exists' || op === 'missing' || op === 'yes') input = null;
    else if (list) {
      const sel = document.createElement('select');
      sel.multiple = dim in choices || op === 'in';
      sel.replaceChildren(...list.map(option));
      input = sel;
    } else if (field?.kind === 'boolean') {
      const sel = document.createElement('select');
      sel.replaceChildren(option({ value: 'true', label: 'yes' }), option({ value: 'false', label: 'no' }));
      input = sel;
    } else {
      const el = document.createElement('input');
      el.type = op === 'within' || field?.kind === 'number' ? 'number' : ['after', 'before'].includes(op) || field?.kind === 'date' ? 'date' : 'text';
      el.placeholder = op === 'within' ? 'days' : '';
      el.required = true;
      input = el;
    }
    if (input) input.id = 'q-input';
    valueBox.replaceChildren(...(input ? [input] : []));
  }
  function readValue(): Cond['value'] {
    const el = document.getElementById('q-input') as HTMLInputElement | HTMLSelectElement | null;
    if (!el) return null;
    if (el instanceof HTMLSelectElement && el.multiple) return [...el.selectedOptions].map((o) => o.value);
    const field = fieldOf(dimSel!.value);
    if (field?.kind === 'boolean') return el.value === 'true';
    if (field?.kind === 'number' || opSel!.value === 'within') return Number(el.value);
    return el.value;
  }
  document.getElementById('query-add')?.addEventListener('click', () => {
    if (!editor) return;
    editor.hidden = false;
    fillDims();
    fillOps();
    dimSel?.focus();
  });
  dimSel?.addEventListener('change', fillOps);
  opSel?.addEventListener('change', fillValue);
  document.getElementById('q-cancel')?.addEventListener('click', () => { if (editor) editor.hidden = true; });
  editor?.addEventListener('submit', (e) => {
    e.preventDefault();
    const value = readValue();
    if (Array.isArray(value) && !value.length) return;
    window.location.href = condsHref(addCond(queryData.conds ?? [], { dim: dimSel!.value, op: opSel!.value, value }));
  });

  // Undo a Move to Trash: restore the entry and go back to it. Drop ?trashed so a reload doesn't offer it again.
  const undoNotice = document.getElementById('undo-notice');
  if (undoNotice) {
    const url = new URL(window.location.href);
    url.searchParams.delete('trashed');
    history.replaceState(null, '', url);
    const undoButton = document.getElementById('undo-trash') as HTMLButtonElement;
    undoButton.addEventListener('click', async () => {
      const id = undoNotice.dataset.entryId!;
      undoButton.disabled = true;
      try {
        await restoreFromTrash(id);
        window.location.href = `/workspace/entries/${encodeURIComponent(id)}`;
      } catch (error: any) {
        alert(error?.message || 'Failed to restore the entry');
        undoButton.disabled = false;
      }
    });
  }

  const searchInput = document.getElementById('filter-search') as HTMLInputElement;
  const typeFilter = document.getElementById('type-filter') as HTMLSelectElement;
  const statusFilter = document.getElementById('status-filter') as HTMLSelectElement;
  const tagFilter = document.getElementById('tag-filter') as HTMLSelectElement | null;
  const gridView = document.getElementById('grid-view');
  const groupedView = document.getElementById('grouped-view');
  const viewGridBtn = document.getElementById('view-grid');
  const viewGroupedBtn = document.getElementById('view-grouped');

  const urlParams = new URLSearchParams(window.location.search);
  const statusParam = urlParams.get('status');
  const urlStatusFilters = statusParam ? statusParam.split(',').map(s => s.trim()) : [];

  // View toggle
  function setView(view: 'grid' | 'grouped') {
    if (!gridView || !groupedView) return;
    gridView.style.display = view === 'grid' ? '' : 'none';
    groupedView.style.display = view === 'grouped' ? '' : 'none';
    viewGridBtn?.classList.toggle('active', view === 'grid');
    viewGroupedBtn?.classList.toggle('active', view === 'grouped');
    localStorage.setItem('entries-view', view);
    filterEntries();
  }

  viewGridBtn?.addEventListener('click', () => setView('grid'));
  viewGroupedBtn?.addEventListener('click', () => setView('grouped'));

  // Restore saved view preference
  const savedView = localStorage.getItem('entries-view') as 'grid' | 'grouped' | null;
  if (savedView) setView(savedView);

  function filterEntries() {
    const searchQuery = searchInput?.value.toLowerCase() || '';
    const typeQuery = typeFilter?.value || '';
    const statusQuery = statusFilter?.value || '';
    const tagQuery = tagFilter?.value || '';

    // Filter all entry wrappers across both views
    const wrappers = document.querySelectorAll('.entry-wrapper');
    wrappers.forEach(wrapper => {
      const title = wrapper.getAttribute('data-title') || '';
      const summary = wrapper.getAttribute('data-summary') || '';
      const type = wrapper.getAttribute('data-type') || '';
      const status = wrapper.getAttribute('data-status') || '';
      const tags = (wrapper.getAttribute('data-tags') || '').split(' ').filter(Boolean);

      const matchesSearch = !searchQuery || title.includes(searchQuery) || summary.includes(searchQuery);
      const matchesType = !typeQuery || type === typeQuery;
      const matchesTag = !tagQuery || tags.includes(tagQuery);

      // "All statuses" means everything but the Trash — except inside the Trash group, which lists it; pick
      // "In the Trash" (or ?status=trashed) to see trashed entries anywhere.
      let matchesStatus = status !== 'trashed' || wrapper.hasAttribute('data-in-trash');
      if (statusQuery) {
        matchesStatus = status === statusQuery;
      } else if (urlStatusFilters.length > 0) {
        matchesStatus = urlStatusFilters.includes(status);
      }

      (wrapper as HTMLElement).style.display = (matchesSearch && matchesType && matchesStatus && matchesTag) ? '' : 'none';
    });

    // Hide collection groups where all entries are filtered out. A group with none listed here (only its count and
    // a link) shows while nothing is filtered.
    const filtering = Boolean(searchQuery || typeQuery || tagQuery || statusQuery || urlStatusFilters.length);
    document.querySelectorAll('.collection-group').forEach(group => {
      const listed = group.querySelectorAll('.entry-wrapper').length;
      const visibleEntries = group.querySelectorAll('.entry-wrapper:not([style*="display: none"])');
      (group as HTMLElement).style.display = visibleEntries.length > 0 || (listed === 0 && !filtering) ? '' : 'none';
    });
  }

  filterEntries();

  searchInput?.addEventListener('input', filterEntries);
  typeFilter?.addEventListener('change', filterEntries);
  statusFilter?.addEventListener('change', filterEntries);
  tagFilter?.addEventListener('change', filterEntries);
</script>

<style>
  .undo-notice {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0.9rem;
    margin-bottom: 1rem;
    background: var(--panel-2);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .undo-notice a { color: var(--accent); }
  .error-banner {
    padding: 1.5rem;
    background: var(--color-error-bg);
    border: 1px solid var(--color-error);
    border-radius: var(--radius);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .error-banner p {
    margin: 0;
    color: var(--color-error);
  }

  .all-trashed-note {
    margin: 0 0 1rem;
    color: var(--muted);
  }

  .empty-state {
    display: grid;
    place-items: center;
    gap: 1rem;
    padding: 4rem 2rem;
    text-align: center;
  }

  .empty-icon {
    font-size: 4rem;
    margin-bottom: 1rem;
    opacity: 0.5;
  }

  .empty-state h3 {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 600;
