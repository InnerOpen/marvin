---
import EntryCard from "@/components/EntryCard.astro";
import EntryList from "@/components/EntryList.astro";
import EntryViews from "@/components/EntryViews.astro";
import AppLayout from "@/layouts/AppLayout.astro";
import { fetchApi, getAuthToken } from "@/lib/api/client";
import { type CollectionRead, getCollectionEntries, listCollections } from "@/lib/api/collections";
import { type EntryRead, listEntries } from "@/lib/api/entries";
import { type EntryTypeRead, listEntryTypes } from "@/lib/api/entryTypes";
import { listTags, type TagRead } from "@/lib/api/tags";
import { FULL_CONTENT_ACCESS, getContentAccess } from "@/lib/api/workspaces";
import { condsHref, legacyConds, readConds, STATUSES, toggleValue, toSpec } from "@/lib/entryQuery";

const authToken = getAuthToken(Astro.cookies);
// Everyone reads; creating entries is AUTHOR+.
const access = authToken ? await getContentAccess(authToken) : FULL_CONTENT_ACCESS;

// Structured search: condition chips in `?c=` (lib/entryQuery.ts). With any, the page shows what the engine finds.
// The sidebar's old links (?status=inbox, ?tag=…) open as the same chips.
const conds = readConds(Astro.url.searchParams).length ? readConds(Astro.url.searchParams) : legacyConds(Astro.url.searchParams);
// Set by the entry page's Move to Trash: offer Undo (restore) right here.
const trashedParam = Astro.url.searchParams.get("trashed") || "";

let entries: EntryRead[] = [];
let entryTypes: EntryTypeRead[] = [];
let collections: CollectionRead[] = [];
let allTags: TagRead[] = [];
let error: string | null = null;

// Ensure we have auth token before making requests
if (!authToken) {
  error = "Authentication required";
} else {
  try {
    [entries, entryTypes, collections, allTags] = await Promise.all([
      listEntries(authToken),
      listEntryTypes(authToken),
      listCollections(authToken),
      listTags(authToken),
    ]);
  } catch (e) {
    error = e instanceof Error ? e.message : String(e);
    console.error("[Entries] Failed to load:", error);
  }
}

// The structured search's results (the same engine as the assistants' find_entries).
type QueryResult = { entries: EntryRead[]; total: number; note?: string | null; unknownOps?: string[] };
let search: QueryResult | null = null;
if (conds.length && authToken && !error) {
  try {
    search = await fetchApi<QueryResult>("/api/platform/entries/query", { method: "POST", body: JSON.stringify({ spec: toSpec(conds), limit: 500 }) }, authToken);
  } catch (e) {
    search = { entries: [], total: 0, note: e instanceof Error ? e.message : String(e) };
  }
}
// The search bar (Beaker-style): a title box and status buttons, then "Show search options" for stacked rows of
// field | operation | value. The rows hold everything but the title and the status, which the bar shows.
const titleText = String(conds.find((c) => c.dim === "title")?.value ?? "");
const statusOn = ((conds.find((c) => c.dim === "status")?.value as string[] | undefined) ?? []).map(String);
const QUICK_STATUSES = ["inbox", "draft", "needs_review", "approved", "published", "archived"];
const optionsOpen = conds.some((c) => c.dim !== "title" && c.dim !== "status");
const builderData = {
  conds,
  types: entryTypes.map((t) => ({ value: t.slug, label: t.name })),
  typeDefs: entryTypes.map((t) => ({ slug: t.slug, schemaJson: { fields: ((t.schemaJson?.fields as any[]) ?? []) } })),
  statuses: Object.entries(STATUSES).map(([value, label]) => ({ value, label })),
  tags: allTags.map((t) => ({ value: t.slug, label: t.name })).sort((a, b) => a.label.localeCompare(b.label)),
  collections: collections.filter((c: any) => (c.targetType ?? "entry") === "entry").map((c) => ({ value: c.slug, label: c.name })),
};

const typeNames = new Map(entryTypes.map((t) => [t.id, t.name]));

// Create a map of collection ID to collection for quick lookup
const collectionsMap = new Map(collections.map((c) => [c.id, c]));
const trashCollection = collections.find((c: any) => c.isSystem && c.slug === "trash");
// Trashed entries aren't in the list above: load the Trash's own, so the Trash group lists them and "In the Trash"
// in the status filter shows them. "All statuses" leaves them out (the filter script), as everywhere else.
let trashedEntries: EntryRead[] = [];
if (trashCollection && (trashCollection.entryCount ?? 0) > 0 && authToken) {
  trashedEntries = await getCollectionEntries(trashCollection.id, authToken).catch(() => []);
}


---

<AppLayout title="Entries">
  {error ? (
    <div class="error-banner">
      <p><strong>Error loading entries:</strong> {error}</p>
      <button onclick="location.reload()" class="button secondary">Retry</button>
    </div>
  ) : (
    <>
      <div class="toolbar">
        <div>
          <h2 style="margin:0;font-size:20px;">Entries</h2>
          <p style="margin:4px 0 0;color:var(--muted);">Manage all your content entries.</p>
        </div>
        <div style="display:flex;gap:0.75rem;">
          {access.canAuthor && <a class="button" href="/workspace/entries/new">New Entry</a>}
        </div>
      </div>

      <div class="search-bar">
        <form class="search-quick" id="quick-search" role="search">
          <input type="search" id="q-text" class="search-text" placeholder="Search titles…" value={titleText} aria-label="Search titles" />
          <button type="submit" class="button">Search</button>
        </form>
        <div class="search-statuses" role="group" aria-label="Filter by status">
          <span class="search-label">Status:</span>
          {QUICK_STATUSES.map((v) => (
            <a class:list={["status-pill", { on: statusOn.includes(v) }]} href={condsHref(toggleValue(conds, "status", v))} aria-pressed={statusOn.includes(v) ? "true" : "false"}>{STATUSES[v]}</a>
          ))}
        </div>
        <button type="button" class="search-toggle" id="toggle-options" aria-expanded={optionsOpen ? "true" : "false"} aria-controls="search-options">
          {optionsOpen ? "Hide search options" : "Show search options"}
        </button>
        {conds.length > 0 && <a href="/workspace/entries" class="search-clear">Clear filters</a>}
      </div>
      <form class="search-options" id="search-options" hidden={!optionsOpen}>
        <div class="search-row search-head" aria-hidden="true"><span>Field</span><span>Operation</span><span>Value</span><span></span></div>
        <div id="search-rows"></div>
        <div class="search-actions">
          <button type="button" class="button secondary" id="row-add">+ Add</button>
          <button type="submit" class="button">Search</button>
        </div>
      </form>
      <script type="application/json" id="query-data" set:html={JSON.stringify(builderData)} />
      {search && <p class="search-count">Entries ({search.total})</p>}
      {search?.note && <p class="query-note">{search.note}</p>}

      {trashedParam && (
        <div class="undo-notice" id="undo-notice" data-entry-id={trashedParam} role="status">
          <span>Entry moved to the Trash.</span>
          <button type="button" class="button secondary" id="undo-trash">Undo</button>
          {trashCollection && <a href={`/workspace/collections/${trashCollection.id}`}>Open the Trash</a>}
        </div>
      )}

      {conds.length > 0 ? (
        search && search.entries.length > 0 ? (
          <>
            <EntryViews entries={search.entries} typeNames={typeNames} collectionsMap={collectionsMap} storageKey="entries-search-view" />
            {search.total > search.entries.length && <p class="query-more">Showing {search.entries.length} of {search.total}: add a condition to narrow it.</p>}
          </>
        ) : (
          <div class="empty-state">
            <h3>Nothing matches</h3>
            <p>Remove a condition, or <a href="/workspace/entries">clear them all</a>.</p>
          </div>
        )
      ) : entries.length === 0 && trashedEntries.length === 0 ? (
        <div class="empty-state">
          <div class="empty-icon">📝</div>
          <h3>No entries yet</h3>
          <p>Entries are your content items like blog posts, products, pages, or any structured content.</p>
          {access.canAuthor && <a href="/workspace/entries/new" class="button">Create Your First Entry</a>}
        </div>
      ) : (
        <>
          <div class="view-toggle">
            <button class="toggle-btn active" id="view-grid" title="Cards">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><rect x="1" y="1" width="6" height="6" rx="1"/><rect x="9" y="1" width="6" height="6" rx="1"/><rect x="1" y="9" width="6" height="6" rx="1"/><rect x="9" y="9" width="6" height="6" rx="1"/></svg>
              Cards
            </button>
            <button class="toggle-btn" id="view-list" title="List">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><rect x="1" y="2" width="3" height="3" rx="0.5"/><rect x="5.5" y="2.5" width="9.5" height="2" rx="0.5"/><rect x="1" y="6.5" width="3" height="3" rx="0.5"/><rect x="5.5" y="7" width="9.5" height="2" rx="0.5"/><rect x="1" y="11" width="3" height="3" rx="0.5"/><rect x="5.5" y="11.5" width="9.5" height="2" rx="0.5"/></svg>
              List
            </button>
          </div>

          {entries.length === 0 && trashCollection && (
            <p class="all-trashed-note" id="all-trashed-note">
              No entries outside the Trash. <a href={`/workspace/collections/${trashCollection.id}`}>Open the Trash</a> to restore
              them, or pick “In the Trash” in Statuses.
            </p>
          )}

          {/* Flat grid view */}
          <section class="grid view-section" id="grid-view" aria-label="Entries">
            {[...entries, ...trashedEntries].map((entry) => {
              return (
                <div class="entry-wrapper"
                  data-type={entry.entryTypeId}
                  data-status={entry.status}
                  data-title={entry.title.toLowerCase()}
                  data-summary={(entry.summary || '').toLowerCase()}
                  data-collections={entry.collections?.map((c: any) => typeof c === 'string' ? c : c.id).join(',') || ''}
                  data-tags={((entry.tags as string[] | undefined) || []).join(' ')}>
                  <EntryCard entry={entry} collectionsMap={collectionsMap} />
                </div>
              );
            })}
          </section>

          {/* List view: the inbox-style rows a collection's page uses */}
          <div class="view-section" id="list-view" style="display:none;">
            <EntryList entries={entries} typeNames={typeNames} />
          </div>

        </>
      )}
    </>
  )}
</AppLayout>

<script>
  import { restoreFromTrash } from '@/lib/api/trash';
  import { addCond, condsHref, DIMENSIONS, fieldsFor, OP_LABELS, opsFor, type Cond, type FieldDef } from '@/lib/entryQuery';

  // The search bar: the title box and the status buttons; "Show search options" opens stacked rows of
  // field | operation | value (Beaker-style). Nothing runs until Search; the conditions go in ?c=.
  const queryData = JSON.parse(document.getElementById('query-data')?.textContent || '{}');
  const conds: Cond[] = queryData.conds ?? [];
  type Opt = { value: string; label: string };
  const choices: Record<string, Opt[]> = { type: queryData.types, tag: queryData.tags, collection: queryData.collections };
  const ROW_DIMS = Object.entries(DIMENSIONS).filter(([dim]) => dim !== 'title' && dim !== 'status');
  const option = (o: Opt, selected = false) => { const el = document.createElement('option'); el.value = o.value; el.textContent = o.label; el.selected = selected; return el; };
  const rowsBox = document.getElementById('search-rows')!;
  const optionsForm = document.getElementById('search-options') as HTMLFormElement | null;
  const textBox = document.getElementById('q-text') as HTMLInputElement | null;

  // A type's own fields are offered once a row picks that type.
  function currentFields(): FieldDef[] {
    const picked = [...rowsBox.querySelectorAll<HTMLSelectElement>('.row-dim')].flatMap((d) => d.value === 'type' ? [(d.closest('.search-row')!.querySelector('.row-value') as HTMLSelectElement)?.value] : []);
    return fieldsFor(queryData.typeDefs ?? [], picked.filter(Boolean));
  }
  const fieldOf = (dim: string) => currentFields().find((f) => `field:${f.key}` === dim);

  function valueControl(dim: string, op: string, value: Cond['value']): HTMLElement | null {
    const field = fieldOf(dim);
    const list = choices[dim] ?? (field?.kind === 'select' ? field.options : undefined);
    const current = Array.isArray(value) ? String(value[0] ?? '') : value == null ? '' : String(value);
    if (op === 'exists' || op === 'missing' || op === 'yes') return null;
    if (list || field?.kind === 'boolean') {
      const sel = document.createElement('select');
      const opts = list ?? [{ value: 'true', label: 'yes' }, { value: 'false', label: 'no' }];
      sel.replaceChildren(option({ value: '', label: 'Choose…' }), ...opts.map((o) => option(o, o.value === current)));
      return sel;
    }
    const el = document.createElement('input');
    el.type = op === 'within' || field?.kind === 'number' ? 'number' : ['after', 'before'].includes(op) || field?.kind === 'date' ? 'date' : 'text';
    el.placeholder = op === 'within' ? 'days' : 'Enter value';
    el.value = current;
    return el;
  }

  function fillRow(row: HTMLElement, cond?: Cond) {
    const dimSel = row.querySelector<HTMLSelectElement>('.row-dim')!;
    const opSel = row.querySelector<HTMLSelectElement>('.row-op')!;
    const holder = row.querySelector<HTMLElement>('.row-value-cell')!;
    const dim = dimSel.value;
    opSel.replaceChildren(...opsFor(dim, fieldOf(dim)).map((op) => option({ value: op, label: OP_LABELS[op] ?? op }, op === cond?.op)));
    const control = valueControl(dim, opSel.value, cond?.value ?? null);
    if (control) control.classList.add('row-value');
    holder.replaceChildren(...(control ? [control] : []));
  }

  function addRow(cond?: Cond) {
    const row = document.createElement('div');
    row.className = 'search-row';
    row.innerHTML = '<select class="row-dim" aria-label="Field"></select><select class="row-op" aria-label="Operation"></select><span class="row-value-cell"></span><button type="button" class="row-remove">✕ Remove</button>';
    const dimSel = row.querySelector<HTMLSelectElement>('.row-dim')!;
    const fields = currentFields();
    dimSel.replaceChildren(
      ...ROW_DIMS.map(([value, label]) => option({ value, label }, value === cond?.dim)),
      ...fields.map((f) => option({ value: `field:${f.key}`, label: f.label }, `field:${f.key}` === cond?.dim)),
    );
    if (cond?.dim.startsWith('field:') && !fields.some((f) => `field:${f.key}` === cond.dim)) {
      dimSel.append(option({ value: cond.dim, label: cond.dim.slice(6) }, true));
    }
    rowsBox.append(row);
    fillRow(row, cond);
    dimSel.addEventListener('change', () => fillRow(row));
    // A row the user touched counts: left without a value it stops the search instead of vanishing from it.
    row.addEventListener('change', () => { row.dataset.touched = '1'; row.classList.remove('incomplete'); });
    if (cond) row.dataset.touched = '1';
    row.querySelector('.row-op')!.addEventListener('change', (e) => {
      const keep = row.querySelector<HTMLInputElement | HTMLSelectElement>('.row-value')?.value;
      fillRow(row, { dim: dimSel.value, op: (e.target as HTMLSelectElement).value, value: keep ?? null });
    });
    row.querySelector('.row-remove')!.addEventListener('click', () => { row.remove(); if (!rowsBox.children.length) addRow(); });
    return row;
  }

  function rowCond(row: HTMLElement): Cond | null {
    const dim = row.querySelector<HTMLSelectElement>('.row-dim')!.value;
    const op = row.querySelector<HTMLSelectElement>('.row-op')!.value;
    const el = row.querySelector<HTMLInputElement | HTMLSelectElement>('.row-value');
    if (!el) return { dim, op };
    const raw = el.value.trim();
    if (!raw) return null;
    const field = fieldOf(dim);
    if (dim in choices) return { dim, op, value: [raw] };
    if (field?.kind === 'boolean') return { dim, op, value: raw === 'true' };
    if (field?.kind === 'number' || op === 'within') return { dim, op, value: Number(raw) };
    return { dim, op, value: raw };
  }

  // The bar's own conditions (title, status) plus the rows'; several rows on one list field join as "… or …".
  // null when a touched row has no value yet (it's marked, and the search waits).
  function collect(): Cond[] | null {
    let next: Cond[] = conds.filter((c) => c.dim === 'status');
    const text = textBox?.value.trim();
    if (text) next.push({ dim: 'title', op: 'contains', value: text });
    let incomplete = false;
    for (const row of rowsBox.querySelectorAll<HTMLElement>('.search-row')) {
      const c = rowCond(row);
      if (c) next = addCond(next, c);
      else if (row.dataset.touched) { row.classList.add('incomplete'); incomplete = true; }
    }
    if (incomplete) {
      rowsBox.querySelector<HTMLElement>('.incomplete .row-value')?.focus();
      return null;
    }
    return next;
  }
  const search = () => {
    const next = collect();
    if (next) window.location.href = condsHref(next);
  };

  // The rows start as the current conditions (one row per value), or one empty row.
  for (const c of conds.filter((c) => c.dim !== 'title' && c.dim !== 'status')) {
    const values = Array.isArray(c.value) ? c.value : [c.value];
    for (const v of values) addRow({ ...c, value: v as Cond['value'] });
  }
  if (!rowsBox.children.length) addRow();

  document.getElementById('quick-search')?.addEventListener('submit', (e) => { e.preventDefault(); search(); });
  optionsForm?.addEventListener('submit', (e) => { e.preventDefault(); search(); });
  document.getElementById('row-add')?.addEventListener('click', () => addRow().querySelector('select')?.focus());
  document.getElementById('toggle-options')?.addEventListener('click', (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    if (!optionsForm) return;
    optionsForm.hidden = !optionsForm.hidden;
    btn.textContent = optionsForm.hidden ? 'Show search options' : 'Hide search options';
    btn.setAttribute('aria-expanded', String(!optionsForm.hidden));
  });

  // Undo a Move to Trash: restore the entry and go back to it. Drop ?trashed so a reload doesn't offer it again.
  const undoNotice = document.getElementById('undo-notice');
  if (undoNotice) {
    const url = new URL(window.location.href);
    url.searchParams.delete('trashed');
    history.replaceState(null, '', url);
    const undoButton = document.getElementById('undo-trash') as HTMLButtonElement;
    undoButton.addEventListener('click', async () => {
      const id = undoNotice.dataset.entryId!;
      undoButton.disabled = true;
      try {
        await restoreFromTrash(id);
        window.location.href = `/workspace/entries/${encodeURIComponent(id)}`;
      } catch (error: any) {
        alert(error?.message || 'Failed to restore the entry');
        undoButton.disabled = false;
      }
    });
  }

  type View = 'grid' | 'list';
  const views: Record<View, { el: HTMLElement | null; btn: HTMLElement | null }> = {
    grid: { el: document.getElementById('grid-view'), btn: document.getElementById('view-grid') },
    list: { el: document.getElementById('list-view'), btn: document.getElementById('view-list') },
  };

  const hasChips = (queryData.conds ?? []).length > 0;

  // View toggle: Cards (grid) or List. The choice is remembered.
  function setView(view: View) {
    if (!views[view].el) view = 'grid';
    for (const [name, v] of Object.entries(views) as [View, (typeof views)[View]][]) {
      if (v.el) v.el.style.display = name === view ? '' : 'none';
      v.btn?.classList.toggle('active', name === view);
    }
    try { localStorage.setItem('entries-view', view); } catch { /* private mode: not remembered */ }
    filterEntries();
  }
  for (const [name, v] of Object.entries(views) as [View, (typeof views)[View]][]) v.btn?.addEventListener('click', () => setView(name));

  let savedView: View | null = null;
  try { savedView = localStorage.getItem('entries-view') as View | null; } catch { /* no storage */ }
  if (savedView && savedView in views) setView(savedView);

  // Without chips, the list is everything but the Trash (the Trash group lists it); with chips, the server chose.
  function filterEntries() {
    if (hasChips) return;
    document.querySelectorAll('.entry-wrapper').forEach((wrapper) => {
      const trashed = wrapper.getAttribute('data-status') === 'trashed' && !wrapper.hasAttribute('data-in-trash');
      (wrapper as HTMLElement).style.display = trashed ? 'none' : '';
    });
  }

  filterEntries();
</script>

<style>
  .undo-notice {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0.9rem;
    margin-bottom: 1rem;
    background: var(--panel-2);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .undo-notice a { color: var(--accent); }
  .error-banner {
    padding: 1.5rem;
    background: var(--color-error-bg);
    border: 1px solid var(--color-error);
    border-radius: var(--radius);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .error-banner p {
    margin: 0;
    color: var(--color-error);
  }

  .all-trashed-note {
    margin: 0 0 1rem;
    color: var(--muted);
  }

  .empty-state {
    display: grid;
    place-items: center;
    gap: 1rem;
    padding: 4rem 2rem;
    text-align: center;
  }

  .empty-icon {
    font-size: 4rem;
    margin-bottom: 1rem;
    opacity: 0.5;
  }

  .empty-state h3 {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 600;
  }

  .empty-state p {
    margin: 0;
    color: var(--muted);
    max-width: 32rem;
  }

  .view-toggle {
    display: flex;
    gap: 2px;
    background: var(--panel-2);
    border-radius: 6px;
    padding: 2px;
    width: fit-content;
    margin-bottom: 1.5rem;
  }

  .toggle-btn {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.75rem;
    border: none;
    border-radius: 4px;
    background: transparent;
    color: var(--muted);
    font-size: 0.8125rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.15s;
  }

  .toggle-btn:hover {
    color: var(--ink);
  }

  .toggle-btn.active {
    background: var(--panel);
    color: var(--ink);
    box-shadow: 0 1px 2px rgba(0,0,0,0.06);
  }

  .search-bar { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 14px; margin: 0 0 14px; }
  .search-quick { display: flex; gap: 8px; flex: 1 1 320px; max-width: 520px; }
  .search-text, .search-options :global(select), .search-options :global(input) {
    height: 38px; padding: 0 12px; border: 1px solid var(--line); border-radius: 6px; background: var(--bg);
    color: var(--ink); font: inherit; font-size: 14px; min-width: 0;
  }
  .search-text { flex: 1; }
  .search-text:focus, .search-options :global(select:focus), .search-options :global(input:focus) { outline: none; border-color: var(--accent); }
  .search-statuses { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; padding-left: 14px; border-left: 1px solid var(--line); }
  .search-label { color: var(--muted); font-size: 14px; margin-right: 2px; }
  .status-pill { padding: 7px 12px; border-radius: 6px; background: var(--panel-2, var(--panel)); color: var(--ink); font-size: 13px; text-decoration: none; border: 1px solid transparent; }
  .status-pill:hover { border-color: var(--line); }
  .status-pill.on { background: var(--accent); color: #fff; }
  .search-toggle { background: none; border: 0; padding: 0; color: var(--accent); font: inherit; font-size: 14px; cursor: pointer; }
  .search-toggle:hover, .search-clear:hover { text-decoration: underline; }
  .search-clear { color: var(--muted); font-size: 14px; text-decoration: none; }
  .search-options { margin: 0 0 16px; padding: 12px 14px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--panel); }
  .search-options[hidden] { display: none; }
