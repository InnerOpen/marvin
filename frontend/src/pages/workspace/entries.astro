---
import EntryCard from "@/components/EntryCard.astro";
import EntryList from "@/components/EntryList.astro";
import EntrySearchBar from "@/components/EntrySearchBar.astro";
import { ENTRY_SORTS, querySort, readEntrySort, sortEntries } from "@/lib/entrySort";
import EntryViews from "@/components/EntryViews.astro";
import AppLayout from "@/layouts/AppLayout.astro";
import { fetchApi, getAuthToken } from "@/lib/api/client";
import { type CollectionRead, getCollectionEntries, listCollections } from "@/lib/api/collections";
import { type EntryRead, listEntries } from "@/lib/api/entries";
import { type EntryTypeRead, listEntryTypes } from "@/lib/api/entryTypes";
import { listTags, type TagRead } from "@/lib/api/tags";
import { FULL_CONTENT_ACCESS, getContentAccess } from "@/lib/api/workspaces";
import { legacyConds, readConds, STATUSES, toSpec } from "@/lib/entryQuery";

const authToken = getAuthToken(Astro.cookies);
// Everyone reads; creating entries is AUTHOR+.
const access = authToken ? await getContentAccess(authToken) : FULL_CONTENT_ACCESS;

// Structured search: condition chips in `?c=` (lib/entryQuery.ts). With any, the page shows what the engine finds.
// The sidebar's old links (?status=inbox, ?tag=…) open as the same chips.
const conds = readConds(Astro.url.searchParams).length ? readConds(Astro.url.searchParams) : legacyConds(Astro.url.searchParams);
// Set by the entry page's Move to Trash: offer Undo (restore) right here.
const trashedParam = Astro.url.searchParams.get("trashed") || "";
// The order of the list (?sort=newest|oldest|updated|title): the plain list is sorted here, a search asks the query for the same order.
const sort = readEntrySort(Astro.url.searchParams.get("sort"));

let entries: EntryRead[] = [];
let entryTypes: EntryTypeRead[] = [];
let collections: CollectionRead[] = [];
let allTags: TagRead[] = [];
let error: string | null = null;

// Ensure we have auth token before making requests
if (!authToken) {
  error = "Authentication required";
} else {
  try {
    [entries, entryTypes, collections, allTags] = await Promise.all([
      listEntries(authToken),
      listEntryTypes(authToken),
      listCollections(authToken),
      listTags(authToken),
    ]);
  } catch (e) {
    error = e instanceof Error ? e.message : String(e);
    console.error("[Entries] Failed to load:", error);
  }
}
entries = sortEntries(entries, sort);

// The structured search's results (the same engine as the assistants' find_entries).
type QueryResult = { entries: EntryRead[]; total: number; note?: string | null; unknownOps?: string[] };
let search: QueryResult | null = null;
if (conds.length && authToken && !error) {
  try {
    search = await fetchApi<QueryResult>("/api/platform/entries/query", { method: "POST", body: JSON.stringify({ spec: { ...toSpec(conds), sort: querySort(sort) }, limit: 500 }) }, authToken);
  } catch (e) {
    search = { entries: [], total: 0, note: e instanceof Error ? e.message : String(e) };
  }
}
// The search bar (Beaker-style): a title box and status buttons, then "Show search options" for stacked rows of
// field | operation | value. The rows hold everything but the title and the status, which the bar shows.
const builderData = {
  types: entryTypes.map((t) => ({ value: t.slug, label: t.name })),
  typeDefs: entryTypes.map((t) => ({ slug: t.slug, schemaJson: { fields: ((t.schemaJson?.fields as any[]) ?? []) } })),
  statuses: Object.entries(STATUSES).map(([value, label]) => ({ value, label })),
  tags: allTags.map((t) => ({ value: t.slug, label: t.name })).sort((a, b) => a.label.localeCompare(b.label)),
  collections: collections.filter((c: any) => (c.targetType ?? "entry") === "entry").map((c) => ({ value: c.slug, label: c.name })),
};

const typeNames = new Map(entryTypes.map((t) => [t.id, t.name]));

// Create a map of collection ID to collection for quick lookup
const collectionsMap = new Map(collections.map((c) => [c.id, c]));
const trashCollection = collections.find((c: any) => c.isSystem && c.slug === "trash");
// Trashed entries aren't in the list above: load the Trash's own, so the Trash group lists them and "In the Trash"
// in the status filter shows them. "All statuses" leaves them out (the filter script), as everywhere else.
let trashedEntries: EntryRead[] = [];
if (trashCollection && (trashCollection.entryCount ?? 0) > 0 && authToken) {
  trashedEntries = await getCollectionEntries(trashCollection.id, authToken).catch(() => []);
}


---

<AppLayout title="Entries">
  {error ? (
    <div class="error-banner">
      <p><strong>Error loading entries:</strong> {error}</p>
      <button onclick="location.reload()" class="button secondary">Retry</button>
    </div>
  ) : (
    <>
      <div class="toolbar">
        <div>
          <h2>Entries</h2>
          <p style="margin:4px 0 0;color:var(--muted);">Manage all your content entries.</p>
        </div>
        <div style="display:flex;gap:0.75rem;">
          {access.canAuthor && <a class="button" href="/workspace/entries/new">New Entry</a>}
        </div>
      </div>

      <EntrySearchBar conds={conds} builderData={builderData} total={search?.total ?? null} note={search?.note ?? null} />
      {(entries.length > 0 || conds.length > 0) && (
        <div class="list-sort">
          <label>Sort
            <select data-sort-param aria-label="Sort the list">
              {Object.entries(ENTRY_SORTS).map(([v, l]) => <option value={v} selected={sort === v}>{l}</option>)}
            </select>
          </label>
        </div>
      )}

      {trashedParam && (
        <div class="undo-notice" id="undo-notice" data-entry-id={trashedParam} role="status">
          <span>Entry moved to the Trash.</span>
          <button type="button" class="button secondary" id="undo-trash">Undo</button>
          {trashCollection && <a href={`/workspace/collections/${trashCollection.id}`}>Open the Trash</a>}
        </div>
      )}

      {conds.length > 0 ? (
        search && search.entries.length > 0 ? (
          <>
            <EntryViews entries={search.entries} typeNames={typeNames} collectionsMap={collectionsMap} storageKey="entries-search-view" />
            {search.total > search.entries.length && <p class="query-more">Showing {search.entries.length} of {search.total}: add a condition to narrow it.</p>}
          </>
        ) : (
          <div class="empty-state">
            <h3>Nothing matches</h3>
            <p>Remove a condition, or <a href="/workspace/entries">clear them all</a>.</p>
          </div>
        )
      ) : entries.length === 0 && trashedEntries.length === 0 ? (
        <div class="empty-state">
          <div class="empty-icon">📝</div>
          <h3>No entries yet</h3>
          <p>Entries are your content items like blog posts, products, pages, or any structured content.</p>
          {access.canAuthor && <a href="/workspace/entries/new" class="button">Create Your First Entry</a>}
        </div>
      ) : (
        <>
          <div class="view-toggle">
            <button class="toggle-btn active" id="view-grid" title="Cards">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><rect x="1" y="1" width="6" height="6" rx="1"/><rect x="9" y="1" width="6" height="6" rx="1"/><rect x="1" y="9" width="6" height="6" rx="1"/><rect x="9" y="9" width="6" height="6" rx="1"/></svg>
              Cards
            </button>
            <button class="toggle-btn" id="view-list" title="List">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><rect x="1" y="2" width="3" height="3" rx="0.5"/><rect x="5.5" y="2.5" width="9.5" height="2" rx="0.5"/><rect x="1" y="6.5" width="3" height="3" rx="0.5"/><rect x="5.5" y="7" width="9.5" height="2" rx="0.5"/><rect x="1" y="11" width="3" height="3" rx="0.5"/><rect x="5.5" y="11.5" width="9.5" height="2" rx="0.5"/></svg>
              List
            </button>
          </div>

          {entries.length === 0 && trashCollection && (
            <p class="all-trashed-note" id="all-trashed-note">
              No entries outside the Trash. <a href={`/workspace/collections/${trashCollection.id}`}>Open the Trash</a> to restore
              them, or pick “In the Trash” in Statuses.
            </p>
          )}

          {/* Flat grid view */}
          <section class="grid view-section" id="grid-view" aria-label="Entries">
            {[...entries, ...trashedEntries].map((entry) => {
              return (
                <div class="entry-wrapper"
                  data-type={entry.entryTypeId}
                  data-status={entry.status}
                  data-title={entry.title.toLowerCase()}
                  data-summary={(entry.summary || '').toLowerCase()}
                  data-collections={entry.collections?.map((c: any) => typeof c === 'string' ? c : c.id).join(',') || ''}
                  data-tags={((entry.tags as string[] | undefined) || []).join(' ')}>
                  <EntryCard entry={entry} collectionsMap={collectionsMap} />
                </div>
              );
            })}
          </section>

          {/* List view: the inbox-style rows a collection's page uses */}
          <div class="view-section" id="list-view" style="display:none;">
            <EntryList entries={entries} typeNames={typeNames} />
          </div>

        </>
      )}
    </>
  )}
</AppLayout>

<script>
  // The Sort select: the same page with ?sort=…, keeping the conditions in the address.
  document.querySelector<HTMLSelectElement>("[data-sort-param]")?.addEventListener("change", (e) => {
    const url = new URL(location.href);
    url.searchParams.set("sort", (e.target as HTMLSelectElement).value);
    location.href = url.toString();
  });
  import { restoreFromTrash } from '@/lib/api/trash';
  // Undo a Move to Trash: restore the entry and go back to it. Drop ?trashed so a reload doesn't offer it again.
  const undoNotice = document.getElementById('undo-notice');
  if (undoNotice) {
    const url = new URL(window.location.href);
    url.searchParams.delete('trashed');
    history.replaceState(null, '', url);
    const undoButton = document.getElementById('undo-trash') as HTMLButtonElement;
    undoButton.addEventListener('click', async () => {
      const id = undoNotice.dataset.entryId!;
      undoButton.disabled = true;
      try {
        await restoreFromTrash(id);
        window.location.href = `/workspace/entries/${encodeURIComponent(id)}`;
      } catch (error: any) {
        alert(error?.message || 'Failed to restore the entry');
        undoButton.disabled = false;
      }
    });
  }

  type View = 'grid' | 'list';
  const views: Record<View, { el: HTMLElement | null; btn: HTMLElement | null }> = {
    grid: { el: document.getElementById('grid-view'), btn: document.getElementById('view-grid') },
    list: { el: document.getElementById('list-view'), btn: document.getElementById('view-list') },
  };

  const hasChips = (JSON.parse(document.getElementById('query-data')?.textContent || '{}').conds ?? []).length > 0;

  // View toggle: Cards (grid) or List. The choice is remembered.
  function setView(view: View) {
    if (!views[view].el) view = 'grid';
    for (const [name, v] of Object.entries(views) as [View, (typeof views)[View]][]) {
      if (v.el) v.el.style.display = name === view ? '' : 'none';
      v.btn?.classList.toggle('active', name === view);
    }
    try { localStorage.setItem('entries-view', view); } catch { /* private mode: not remembered */ }
    filterEntries();
  }
  for (const [name, v] of Object.entries(views) as [View, (typeof views)[View]][]) v.btn?.addEventListener('click', () => setView(name));

  let savedView: View | null = null;
  try { savedView = localStorage.getItem('entries-view') as View | null; } catch { /* no storage */ }
  if (savedView && savedView in views) setView(savedView);

  // Without chips, the list is everything but the Trash (the Trash group lists it); with chips, the server chose.
  function filterEntries() {
    if (hasChips) return;
    document.querySelectorAll('.entry-wrapper').forEach((wrapper) => {
      const trashed = wrapper.getAttribute('data-status') === 'trashed' && !wrapper.hasAttribute('data-in-trash');
      (wrapper as HTMLElement).style.display = trashed ? 'none' : '';
    });
  }

  filterEntries();
</script>

<style>
  .undo-notice {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0.9rem;
    margin-bottom: 1rem;
    background: var(--panel-2);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .undo-notice a { color: var(--accent); }
  .error-banner {
    padding: 1.5rem;
    background: var(--color-error-bg);
    border: 1px solid var(--color-error);
    border-radius: var(--radius);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .error-banner p {
    margin: 0;
    color: var(--color-error);
  }

  .all-trashed-note {
    margin: 0 0 1rem;
    color: var(--muted);
  }


  .empty-icon {
    font-size: 4rem;
    margin-bottom: 1rem;
    opacity: 0.5;
  }

  .empty-state h3 {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 600;
  }

  .empty-state p {
    margin: 0.5rem auto 1rem;
    color: var(--muted);
    max-width: 32rem;
  }

  .list-sort { display: flex; justify-content: flex-end; margin: 0.25rem 0 0.75rem; font-size: 0.875rem; color: var(--muted); }
  .list-sort label { display: inline-flex; align-items: center; gap: 0.5rem; }
  .list-sort select { font: inherit; padding: 0.35rem 0.5rem; border: 1px solid var(--line); border-radius: 6px; background: var(--panel); color: var(--ink); }
  .view-toggle {
    display: flex;
    gap: 2px;
    background: var(--panel-2);
    border-radius: 6px;
    padding: 2px;
    width: fit-content;
    margin-bottom: 1.5rem;
  }

  .toggle-btn {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.75rem;
    border: none;
    border-radius: 4px;
    background: transparent;
    color: var(--muted);
    font-size: 0.8125rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.15s;
  }

  .toggle-btn:hover {
    color: var(--ink);
  }

  .toggle-btn.active {
    background: var(--panel);
    color: var(--ink);
    box-shadow: 0 1px 2px rgba(0,0,0,0.06);
  }

  }
  .query-more { grid-column: 1 / -1; color: var(--muted); font-size: 13px; }
</style>
