  .tl-zoom button:first-child { border-left: 0; }
  .tl-zoom button:first-child, .tl-zoom a:first-child { border-left: 0; }
  .tl-zoom a { display: inline-block; padding: 7px 10px; border-left: 1px solid var(--line); color: var(--muted); font-size: 13px; text-decoration: none; }
  .tl-zoom button[aria-pressed="true"], .tl-zoom a[aria-current="true"] { background: var(--panel-2); color: var(--ink); font-weight: 600; }
  .tl-track + .tl-track { margin-top: 14px; }
  .tl-track-title { margin: 0 0 6px; font-size: 15px; }
  .tl-track-title a { color: var(--ink); text-decoration: none; }
  .tl-empty { padding: 24px; }
  .tl-hint { margin: 0; font-size: 13px; }

  /* One scroll container holds the strip, the ruler and the lanes, so they move together; everything inside is placed in seconds × scale. */
  .tl-scroll { overflow-x: auto; overflow-y: hidden; border: 1px solid var(--line); border-radius: 10px; background: var(--panel); padding: 12px 16px 16px; position: relative; min-width: 0; max-width: 100%; -webkit-overflow-scrolling: touch; }
  .tl-inner { position: relative; min-width: 100%; }
  .tl-groups { position: relative; height: 24px; margin-bottom: 4px; }
  .tl-bands { position: relative; height: 22px; margin-bottom: 4px; }
  .tl-band { position: absolute; top: 0; height: 20px; padding: 0 6px; box-sizing: border-box; font-size: 12px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: var(--muted); border-radius: 6px; background: color-mix(in srgb, var(--ink) 7%, var(--panel)); border: 1px solid var(--line); }
  .tl-band > span { position: sticky; left: 10px; display: inline-block; max-width: 100%; line-height: 18px; }
  .tl-band.is-link { color: var(--ink); text-decoration: none; cursor: pointer; }
  .tl-band.is-link:hover, .tl-band.is-link:focus-visible { background: color-mix(in srgb, var(--accent) 16%, var(--panel)); border-color: var(--accent); }
  .tl-band.is-link > span::after { content: " ↗"; color: var(--muted); font-size: 11px; }
  .tl-group { position: absolute; top: 0; height: 22px; border-bottom: 2px solid var(--accent); padding: 0 6px; font-size: 13px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; box-sizing: border-box; }
  /* The title slides along inside its chapter while you scroll, so you always know where you are at a high zoom. */
  .tl-group > span { position: sticky; left: 16px; display: inline-block; max-width: 100%; }
  .tl-group.is-link { color: var(--ink); text-decoration: none; cursor: pointer; }
  .tl-group.is-link:hover, .tl-group.is-link:focus-visible { background: color-mix(in srgb, var(--accent) 12%, transparent); }
  .tl-group.is-link > span::after { content: " ↗"; color: var(--muted); font-size: 12px; font-weight: 400; }
  .tl-group + .tl-group { border-left: 1px solid var(--line); }

  .tl-strip { position: relative; height: calc(var(--tl-h, 120px) + 8px); }
  .tl-item { position: absolute; top: 0; height: var(--tl-h, 120px); box-sizing: border-box; padding-right: 3px; }
  .tl-seek { display: block; width: 100%; height: 100%; margin: 0; padding: 0; border: 1px solid var(--line); border-radius: 8px; background: var(--panel-2); overflow: hidden; cursor: pointer; text-align: left; color: var(--muted); }
  .tl-item.estimated .tl-seek { border-style: dashed; }
  .tl-item.is-now .tl-seek { outline: 2px solid var(--accent); outline-offset: -2px; }
  .tl-seek img { display: block; width: 100%; height: 100%; object-fit: cover; }
  /* the story's own shape (a view's `aspect`): the picture in the shape the render will cut, as a frame at the start of the beat, its words beside it */
  .tl-seek:has(.tl-frame) { display: flex; align-items: stretch; text-align: left; }
  .tl-seek .tl-frame { flex: none; width: auto; height: 100%; aspect-ratio: var(--tl-shape); border-right: 1px solid var(--line); }
  /* a beat with no picture yet: a shaded frame in the same shape holding the beat's words, so the shape shows before anything is made (the draft render draws a plain card too). Only the theme's colours
     (panel, accent, muted text) are used: the theme switcher sets them from the API's theme for both light and dark */
  .tl-seek .tl-blank { display: block; box-sizing: border-box; padding: 24px 5px 5px; overflow: hidden; font-size: calc(7px + var(--tl-h, 120px) / 40); line-height: 1.3; font-weight: 400; overflow-wrap: anywhere; color: var(--muted); background: repeating-linear-gradient(135deg, color-mix(in srgb, var(--accent) 14%, transparent) 0 6px, transparent 6px 12px), var(--panel-2); }
  .tl-seek .tl-beside { flex: 1 1 auto; min-width: 0; padding: 22px 6px 6px; }
  .tl-text { display: block; padding: 26px 8px 8px; font-size: 12px; line-height: 1.35; max-height: 100%; overflow: hidden; }
  .tl-badge { position: absolute; top: 6px; left: 6px; display: inline-flex; align-items: center; gap: 5px; padding: 2px 6px; border-radius: 999px; background: color-mix(in srgb, var(--panel) 85%, transparent); font-size: 11px; font-weight: 600; pointer-events: none; }
  .tl-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--muted); }
  .tl-dot[data-status="ready"], .tl-dot[data-status="done"], .tl-dot[data-status="approved"], .tl-dot[data-status="published"] { background: #2f9e44; }
  .tl-dot[data-status="review"], .tl-dot[data-status="recording"], .tl-dot[data-status="rendering"] { background: #e8a317; }
  .tl-open { position: absolute; right: 9px; top: 6px; font-size: 11px; padding: 1px 7px; border-radius: 999px; background: var(--panel); border: 1px solid var(--line); color: var(--ink); text-decoration: none; opacity: 0; }
  .tl-item:hover .tl-open, .tl-item:focus-within .tl-open { opacity: 1; }
  .tl-draft { position: absolute; right: 9px; top: 28px; font: inherit; font-size: 11px; padding: 1px 7px; border-radius: 999px; background: var(--panel); border: 1px solid var(--line); color: var(--ink); cursor: pointer; opacity: 0; }
  .tl-item:hover .tl-draft, .tl-item:focus-within .tl-draft { opacity: 1; }
  .tl-draft:disabled { cursor: progress; opacity: 0.5; }
  @media (hover: none) { .tl-open, .tl-draft { opacity: 1; } }
  /* Keep / Redo on a card that waits to be looked at: always visible (it is the point of looking), small, along the bottom-left of the card */
  .tl-review { position: absolute; left: 6px; bottom: 6px; display: inline-flex; gap: 4px; z-index: 2; }
  .tl-review button { font: inherit; font-size: 11px; padding: 1px 8px; border-radius: 999px; background: var(--panel); border: 1px solid var(--line); color: var(--ink); cursor: pointer; }
  .tl-review .tl-keep { border-color: #2f9e44; }
