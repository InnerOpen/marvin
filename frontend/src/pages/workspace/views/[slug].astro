---
/**
 * A view of an entry, as a package declares it (services/blueprints/views.py): today the one kind, `timeline`, draws a story as time. The
 * spine (its beats) is a filmstrip of cards as wide as they last; under it one lane per child type (lines, sounds) placed where they fall;
 * a ruler of timecodes; a player that walks the lines and plays each take in the browser, moving a playhead. Everything is read through
 * the entries API, so who may see what is decided there.
 */
import AppLayout from "@/layouts/AppLayout.astro";
import { getAuthToken } from "@/lib/api/client";
import { getView, type ViewRead } from "@/lib/api/views";
import { getWizard } from "@/lib/api/wizards";
import type { Step } from "@/lib/wizard";
import { timecode } from "@/lib/audioTimeline";
import { withReturn } from "@/lib/entryBack";
import { listWizards } from "@/lib/api/wizards";
import { buttonHref } from "@/lib/wizard";
import { type Bed, type Group, type Item, type LaneSpec, type Layout, type Row as LaidRow, type TimelineSpec, aspectOf, cues, layout, overlays, progress, quiets, quietWords, stackRows, wavePolygon, progressLine, ZOOM_LEVELS, PICTURE_SIZES, cardMinPx, minInnerWidth, percent, tickLevels, canReview } from "@/lib/timeline";
import { type Row, describeFailure, entryOfType, findEntries, workflowState } from "@/lib/wizardApi";

const authToken = getAuthToken(Astro.cookies);
const slug = Astro.params.slug ?? "";
const entryRef = Astro.url.searchParams.get("entry") ?? "";
const here = `${Astro.url.pathname}${Astro.url.search}`;
const open = (id: string) => withReturn(`/workspace/entries/${id}`, here);

let view: ViewRead | null = null;
let problem: string | null = authToken ? null : "Sign in to see this.";
if (authToken) {
  try {
    view = await getView(slug, authToken);
  } catch (e) {
    problem = describeFailure(e);
  }
}
const spec: TimelineSpec | null = view?.definition ?? null;

// The entry the view is of, checked to be of the declared type; without one, the entries of that type to pick from.
const MAX_ROWS = 500;
let entry: Row | null = null;
let candidates: Row[] = [];
let laid: Layout | null = null;
let shape: number | null = null; // the picture's width over height (the entry's format), so a Short is drawn tall and a wide video wide
let itemRun: { workflow: string; base: Record<string, unknown>; item: string; label: string } | null = null;
let actions: { label: string; href: string; run?: { workflow: string; inputs: Record<string, unknown> } }[] = [];
const laneOpens: Record<string, (pieceSlug: string) => string> = {}; // lane id -> where a piece of it opens (a guided setup), when the lane says so
if (spec && authToken) {
  entry = await entryOfType(spec.entry_type, entryRef, authToken);
  shape = spec.aspect && entry ? aspectOf((entry.dataJson as Record<string, unknown> | undefined)?.[spec.aspect]) : null;
  if (!entry) {
    candidates = (await findEntries({ entry_type: spec.entry_type }, authToken, 50)).entries;
  } else {
    const whose = entry.slug;
    // A lane may open a guided setup with the piece chosen (a line opens its takes) instead of the entry's own page.
    for (const lane of spec.lanes ?? []) {
      if (!lane.open) continue;
      const found = (await listWizards(authToken, lane.entry_type).catch(() => [])).find((w) => w.slug === lane.open!.wizard && w.button);
      if (found) laneOpens[lane.id] = (pieceSlug) => buttonHref(found.slug, found.button!, { slug: pieceSlug, dataJson: lane.of ? { [lane.of]: whose } : {} });
    }
    const none = { entries: [] as Row[], total: 0 };
    const [spine, ...laneRows] = await Promise.all([
      findEntries({ entry_type: spec.spine.entry_type, fields: { [spec.spine.of]: whose } }, authToken, MAX_ROWS),
      ...(spec.lanes ?? []).map((lane) => (lane.of ? findEntries({ entry_type: lane.entry_type, fields: { [lane.of]: whose } }, authToken, MAX_ROWS) : none)),
    ]);
    const rows = spine.entries;
    const slugsIn = (list: Row[], key: string | undefined) => [...new Set(list.map((r) => String(r.dataJson?.[key ?? ""] ?? "")).filter(Boolean))];
    const bySlugs = async (type: string, slugs: string[]) => (slugs.length ? (await findEntries({ entry_type: type, entries: slugs }, authToken, slugs.length)).entries : []);
    const group = spec.spine.group;
    const groups = group ? await bySlugs(group.entry_type, slugsIn(rows, group.field)) : [];
    // A placed or bed lane's entries come by the slugs the spine (or the entry, or the entries a spine field names) points at: a library
    // sound shared by several stories has no `story` of its own, so a scope by `of` alone would miss it.
    const lanes: Record<string, LaidRow[]> = {};
    const via: Record<string, LaidRow[]> = {};
    for (const [i, lane] of (spec.lanes ?? []).entries()) {
      const have = laneRows[i].entries as LaidRow[];
      let wanted: string[] = [];
      if (lane.placed) {
        const { field, ref } = lane.placed;
        wanted = [...new Set(rows.flatMap((r) => (Array.isArray(r.dataJson?.[field]) ? (r.dataJson![field] as unknown[]) : [])).map((x) => String((x as Record<string, unknown>)?.[ref] ?? "")))];
      } else if (lane.cover) {
        // An overlay comes from the item, else the entry its `via` field names (a scene), else the view's own entry: nothing more to fetch.
        if (lane.cover.via && lane.cover.entry_type) via[lane.id] = (await bySlugs(lane.cover.entry_type, slugsIn(rows, lane.cover.via))) as LaidRow[];
      } else if (lane.marks) {
        // A choice comes from the item, else the entry its `via` field names (a scene), else the view's own entry: only the `via` entries to fetch.
        if (lane.marks.via && lane.marks.entry_type) via[lane.id] = (await bySlugs(lane.marks.entry_type, slugsIn(rows, lane.marks.via))) as LaidRow[];
      } else if (lane.bed?.via && lane.bed.entry_type) {
        via[lane.id] = (await bySlugs(lane.bed.entry_type, slugsIn(rows, lane.bed.via))) as LaidRow[];
        // the scenes' sounds, a beat's own, and the story's: every layer the lane draws
        wanted = [...new Set([...slugsIn(via[lane.id], lane.bed.field), ...slugsIn(rows, lane.bed.item_field), ...slugsIn([entry], lane.bed.entry_field)])];
      } else if (lane.bed) {
        wanted = lane.bed.on === "spine" ? slugsIn(rows, lane.bed.field) : slugsIn([entry], lane.bed.field);
      }
      const known = new Set(have.map((r) => r.slug));
      const missing = wanted.filter((x) => x && !known.has(x));
      lanes[lane.id] = [...have, ...((await bySlugs(lane.entry_type, missing)) as LaidRow[])];
    }
    // The entries each band's field names (the scenes), to title the bands over the beats that share them.
    const bandRows: Record<string, LaidRow[]> = {};
    for (const band of spec.spine.bands ?? []) bandRows[band.id ?? band.field] = (await bySlugs(band.entry_type, slugsIn(rows, band.field))) as LaidRow[];
    laid = layout(spec, { entry: entry as LaidRow, spine: rows as LaidRow[], groups: groups as LaidRow[], lanes, via, bands: bandRows });

    // A button on each item (a beat's draft) runs a workflow for just that item; off or missing, there is no button.
    const perItem = spec.spine.run;
    if (perItem) {
      const state = await workflowState(perItem.workflow, authToken);
      if (state.id && state.enabled) itemRun = { workflow: state.id, base: { ...(perItem.inputs ?? {}), [perItem.entry]: entry.slug }, item: perItem.item, label: perItem.label ?? "Draft" };
    }
    // A button starts a wizard with this entry already chosen (the choose step of its type sets the key), or opens a workflow's page.
    for (const action of spec.actions ?? []) {
      if (action.wizard) {
        const wizard = await getWizard(action.wizard, authToken).catch(() => null);
        const choose = wizard?.definition.steps.find((s: Step) => s.kind === "choose" && s.entry_type === spec.entry_type);
        // The entry itself, and the earlier choices it records (a story's world: the choose step scopes by `world: ${world}`), so the wizard
        // resumes past them instead of starting over. The wizard checks every key against what exists, so a stale one is simply dropped.
        const params = new URLSearchParams(choose?.as ? { [choose.as]: whose } : {});
        for (const [field, ref] of Object.entries((choose?.scope ?? {}) as Record<string, string>)) {
          const earlier = /^\$\{(\w+)\}$/.exec(ref)?.[1];
          const value = entry.dataJson?.[field];
          if (earlier && typeof value === "string" && value) params.set(earlier, value);
        }
        // …and opens on the step after the one that picks the entry (the wizard's own blockers still win if something earlier is missing).
        const after = wizard?.definition.steps[(wizard?.definition.steps.indexOf(choose as Step) ?? -1) + 1];
        if (choose && after) params.set("step", after.id);
        const query = params.toString();
        const href = `/workspace/setups/${encodeURIComponent(action.wizard)}${query ? `?${query}` : ""}`;
        actions.push({ label: action.label, href });
      } else if (action.workflow) {
        const state = await workflowState(action.workflow, authToken);
        const href = state.id ? `/automation/workflows?workflow=${encodeURIComponent(state.id)}` : "/automation/workflows";
        // A `run` action starts the workflow here, with this entry's slug in the input it names; one that is off or missing opens its page instead.
        const run = action.run && state.id && state.enabled ? { workflow: state.id, inputs: { ...(action.run.inputs ?? {}), [action.run.entry]: entry.slug } } : undefined;
        actions.push({ label: action.label, href, run });
      }
    }
  }
}

// The strip is laid out at a fixed width and scrolls sideways past it: a 0.3 s beat still gets a card you can click, so a long story is wider
// than the page, never squashed. Positions are percentages of the strip, so it fills the page at any width and the lanes line up under the cards;
// the strip is never narrower than the pixels the shortest card needs, and past that the box scrolls.
const total = laid?.total ?? 0;
// One track for the whole story, or (`?stack=chapters`) one track per chapter, each with its own ruler and lanes, stacked down the page.
interface Track {
  id: string | null;
  title: string;
  start: number;
  seconds: number;
  items: Item[];
  groups: Group[];
}
const stackable = !!spec?.spine.group && (laid?.groups.length ?? 0) > 1;
const stacked = stackable && Astro.url.searchParams.get("stack") === "chapters";
const tracks: Track[] = !laid
  ? []
  : stacked
    ? laid.groups.map((g) => ({ id: g.id, title: g.title, start: g.start, seconds: g.seconds, items: g.items, groups: [g] }))
    : [{ id: null, title: "", start: 0, seconds: laid.total, items: laid.items, groups: laid.groups }];
const pctIn = (track: Track, seconds: number) => percent(seconds - track.start, track.seconds);
// Stacked tracks share one scale: the longest chapter fills the page and a shorter one is proportionally shorter, so rows compare honestly.
const longest = Math.max(1e-9, ...tracks.map((t) => t.seconds));
const share = (track: Track) => (stacked ? track.seconds / longest : 1);
const stackHref = (on: boolean) => {
  const u = new URL(Astro.url);
  if (on) u.searchParams.set("stack", "chapters");
  else u.searchParams.delete("stack");
  return `${u.pathname}${u.search}`;
};
const steps = spec && laid ? progress(spec, laid) : [];
const lanes = spec?.lanes ?? [];
const firstWords = (text: string, n = 8) => {
  const words = text.trim().split(/\s+/).filter(Boolean);
  return words.slice(0, n).join(" ") + (words.length > n ? "…" : "");
};
const playable = laid ? cues(laid, lanes) : [];
const playJson = JSON.stringify(playable).replace(/</g, "\\u003c");
const overJson = JSON.stringify(laid ? overlays(laid, lanes) : []).replace(/</g, "\\u003c");
// A bed's block clipped to a track (a scene's ambience may run on past a chapter's end).
const clip = (b: { start: number; seconds: number }, track: { start: number; seconds: number }) => {
  const from = Math.max(b.start, track.start);
  const to = Math.min(b.start + b.seconds, track.start + track.seconds);
  return { from, seconds: Math.max(0, to - from) };
};
// A band's stretches that fall in a track (a scene may run on past a chapter's end).
const bandsOver = (key: string, track: { start: number; seconds: number }) =>
  (laid?.bands[key] ?? []).filter((b) => b.start < track.start + track.seconds && b.start + b.seconds > track.start);
const coversIn = (lane: LaneSpec, track: { start: number; seconds: number }) =>
  (laid?.covers[lane.id] ?? []).filter((c) => c.start < track.start + track.seconds && c.start + c.seconds > track.start);
const marksIn = (lane: LaneSpec, track: { start: number; seconds: number }) =>
  (laid?.marks[lane.id] ?? []).filter((m) => m.start < track.start + track.seconds && m.start + m.seconds > track.start);
// A bed's level steps as bars inside its block, as a share of the loudest of them (a block of 40 s with a silent beat in the middle).
const stepBars = (b: Bed, track: { start: number; seconds: number }) => {
  const from = clip(b, track);
  const top = Math.max(b.volume, ...b.steps.map((st) => st.volume), 0.01);
  return b.steps
    .map((st) => ({ ...st, ...clip(st, track) }))
    .filter((st) => st.seconds > 0 && from.seconds > 0)
    .map((st) => ({ left: ((st.from - from.from) / from.seconds) * 100, width: (st.seconds / from.seconds) * 100, height: (st.volume / top) * 100, volume: st.volume, start: st.start, end: st.start + st.seconds, source: st.source, by: st.by, muffled: st.muffled }));
};
// Who set a stretch of the story's bed, in words: "set by the story", "set by the scene On deck", "set by the beat 1005".
const stepSetBy = (st: { source?: string; by?: string }) => (st.source ? ` · set by ${st.source === "story" ? "the story" : `the ${st.source}${st.by ? ` ${st.by}` : ""}`}` : "");
// One line for a block whose stretches say who set them: "20% story · 10% scene · 5% beat · muffled in places".
const setBySummary = (b: Bed) => {
  const seen: string[] = [];
  for (const st of b.steps) {
    const part = `${Math.round(st.volume * 100)}% ${st.source}`;
    if (st.source && !seen.includes(part)) seen.push(part);
  }
  return `${seen.join(" · ")}${b.steps.some((st) => st.muffled) ? " · muffled in places" : ""}`;
};
// A bed's fades as ramps at the ends of its block, as a share of the block drawn (a block clipped to a chapter has no ramp where it was cut).
const fadeRamps = (b: Bed, track: { start: number; seconds: number }) => {
  const from = clip(b, track);
  if (from.seconds <= 0) return { inPct: 0, outPct: 0 };
  const cutAtStart = from.from > b.start + 1e-6;
  const cutAtEnd = from.from + from.seconds < b.start + b.seconds - 1e-6;
  return { inPct: cutAtStart ? 0 : Math.min(100, (b.fadeIn / from.seconds) * 100), outPct: cutAtEnd ? 0 : Math.min(100, (b.fadeOut / from.seconds) * 100) };
};
const bedsIn = (lane: LaneSpec, track: { start: number; seconds: number }) =>
  (laid?.beds[lane.id] ?? []).filter((b) => b.start < track.start + track.seconds && b.start + b.seconds > track.start);
const title = view ? `${view.name}${entry ? ` · ${entry.title}` : ""}` : "View";
---

<AppLayout crumb="workspace.views.run" title={title} width="full">
  {problem && <div class="alert alert-error">{problem}</div>}
  {!problem && !view && <div class="alert alert-info">There is no view called “{slug}” here. Install the package that brings it.</div>}

  {spec && !entry && !problem && (
    <>
      <div class="page-header">
        <h2>{view!.name}</h2>
        <p>Pick a {spec.entry_type.replace(/-/g, " ")} to see it this way.</p>
      </div>
      {entryRef && <div class="alert alert-info">“{entryRef}” is not a {spec.entry_type.replace(/-/g, " ")} here.</div>}
      {candidates.length === 0 ? (
        <p class="muted">There are none yet.</p>
      ) : (
        <ul class="pick">
          {candidates.map((c) => (
            <li><a href={`/workspace/views/${encodeURIComponent(slug)}?entry=${encodeURIComponent(c.slug)}`}>{c.title}</a></li>
          ))}
        </ul>
      )}
    </>
  )}

  {spec && entry && laid && (
    <div class="tl" data-noun={spec.spine.entry_type.replace(/-/g, " ")} data-total={total} data-sizes={JSON.stringify(PICTURE_SIZES)} data-shape={shape ?? undefined}>
      <header class="tl-head">
        <div class="tl-title">
          <h2>{entry.title}</h2>
          <p class="tl-facts">
            <strong class="tl-total">{timecode(total)}</strong>
            {steps.length > 0 && <span class="muted"> · {progressLine(steps)}</span>}
            {laid.items.some((i) => i.estimated) && <span class="muted" title="A line with no take yet is measured by its words, at 150 a minute."> · lengths with no take are estimates</span>}
          </p>
        </div>
        <div class="tl-links">
          {actions.map((a) =>
            a.run ? (
              <button type="button" class="button secondary" data-run={JSON.stringify(a.run)} data-run-label={a.label} data-run-slug={entry.slug}>{a.label}</button>
            ) : (
              <a class="button secondary" href={a.href}>{a.label}</a>
            ),
          )}
          <a class="button secondary" href={open(entry.id)}>Open the {spec.entry_type.replace(/-/g, " ")}</a>
        </div>
        {/* A floating note, not a line in the header: nothing on the page moves when a draft starts or reports. */}
        <div class="tl-run" data-run-status role="status" aria-live="polite" hidden>
          <span data-run-text></span>
          <button type="button" class="tl-run-close" data-run-close aria-label="Dismiss">×</button>
        </div>
      </header>

      {laid.items.length === 0 ? (
        <div class="card tl-empty">
          <p>Nothing on the timeline yet: this {spec.entry_type.replace(/-/g, " ")} has no {spec.spine.entry_type.replace(/-/g, " ")}s.</p>
          {actions.length > 0 && <p class="muted">The buttons above are how to make them.</p>}
        </div>
      ) : (
        tracks.map((track) => (
          <section class:list={["tl-track", { stacked }]} data-track data-start={track.start} data-seconds={track.seconds}>
            {stacked && (
              <h3 class="tl-track-title">
                {track.id ? <a href={open(track.id)}>{track.title}</a> : <span>{track.title || `No ${spec.spine.group!.entry_type.replace(/-/g, " ")}`}</span>}
                <span class="muted"> {timecode(track.start)} → {timecode(track.start + track.seconds)} · {track.seconds.toFixed(1)} s</span>
              </h3>
            )}
            <div class="tl-scroll" data-scroll tabindex="0" aria-label="Timeline: scroll sideways">
              <div class="tl-inner" data-zoom="1" data-share={share(track)} data-total={track.seconds} data-shortest={Math.min(...track.items.map((i) => i.seconds).filter((x) => x > 0), Infinity)} style={`width:${(share(track) * 100).toFixed(3)}%;min-width:${minInnerWidth(track.items, track.seconds)}px`}>
                {spec.spine.group && !stacked && (
                  <div class="tl-groups" role="list">
                    {track.groups.map((g) => {
                      const place = `left:${pctIn(track, g.start)};width:${pctIn(track, track.start + g.seconds)}`;
                      // The whole band opens the entry it names (the chapter); a stretch with none is only a label.
                      return g.id ? (
                        <a class="tl-group is-link" role="listitem" href={open(g.id)} style={place} title={`${g.title}\n${timecode(g.start)} → ${timecode(g.start + g.seconds)}\nClick to open it`}>
                          <span>{g.title}</span>
                        </a>
                      ) : (
                        <div class="tl-group" role="listitem" style={place}>
                          <span class="muted">{g.title || (laid!.groups.length > 1 ? `No ${spec.spine.group!.entry_type}` : "")}</span>
                        </div>
                      );
                    })}
                  </div>
                )}

                {(spec.spine.bands ?? []).map((band) => (
                  <div class="tl-bands" role="list" aria-label={band.title ?? band.entry_type}>
                    {bandsOver(band.id ?? band.field, track).map((b) => {
                      const from = clip(b, track);
                      const place = `left:${pctIn(track, from.from)};width:${pctIn(track, track.start + from.seconds)}`;
                      const words = `${band.title ?? band.entry_type}: ${b.title}\n${timecode(b.start)} → ${timecode(b.start + b.seconds)}`;
                      // The whole band opens the entry it names (the scene); one whose entry was not found is only a label.
                      return b.id ? (
                        <a class="tl-band is-link" role="listitem" href={open(b.id)} style={place} title={`${words}\nClick to open it`}>
                          <span>{b.title}</span>
                        </a>
                      ) : (
                        <div class="tl-band" role="listitem" style={place} title={`${words}\nNo ${band.entry_type} with this name was found`}>
                          <span class="muted">{b.title}</span>
                        </div>
                      );
                    })}
                  </div>
                ))}

                <div class="tl-strip" role="list" aria-label={spec.spine.entry_type} style={shape ? `--tl-shape:${shape}` : undefined}>
                  {track.items.map((item) => (
                    <div
                      class:list={["tl-item", { "has-picture": !!item.picture, estimated: item.estimated }]}
                      role="listitem"
                      data-item={item.id}
                      data-name={item.number !== null ? String(item.number) : item.title}
                      data-start={item.start}
                      style={`left:${pctIn(track, item.start)};width:${pctIn(track, track.start + item.seconds)}`}
                      title={`${item.title}${item.text ? ` — ${item.text}` : ""}\n${timecode(item.start)} → ${timecode(item.start + item.seconds)} (${item.seconds.toFixed(1)} s${item.estimated ? ", estimated" : ""})`}
                    >
                      <button type="button" class="tl-seek" data-seek={item.start} aria-label={`Go to ${item.title}`}>
                        {shape && item.picture ? (
                          <>
                            <img class="tl-frame" src={item.picture} alt="" loading="lazy" />
                            <span class="tl-text tl-beside">{item.text || item.title}</span>
                          </>
                        ) : shape && !item.card ? (
                          <span class="tl-frame tl-blank">{item.text || item.title}</span>
                        ) : item.picture ? <img src={item.picture} alt="" loading="lazy" /> : <span class="tl-text">{item.text || item.title}</span>}
                      </button>
                      <span class="tl-badge">
                        {item.number !== null && <span class="tl-n">{item.number}</span>}
                        {item.status && <span class="tl-dot" data-status={item.status} title={item.status} />}
                      </span>
                      {!item.card && <a class="tl-open" href={open(item.id)} title={`Open ${item.title}`}>Open</a>}
                      {itemRun && item.key && !item.card && (
                        <button
                          type="button"
                          class="tl-draft"
                          data-run={JSON.stringify({ workflow: itemRun.workflow, inputs: { ...itemRun.base, [itemRun.item]: item.key } })}
                          data-run-label={`${itemRun.label} of ${spec.spine.entry_type.replace(/-/g, " ")} ${item.key}`}
                          data-run-slug={entry.slug}
                          title={`Make a quick draft video of just this ${spec.spine.entry_type.replace(/-/g, " ")}: its picture, overlay, moves, sound and captions`}
                        >▶ {itemRun.label}</button>
                      )}
                      {spec.spine.review && !item.card && canReview(item.status, spec.spine.review) && (
                        <span class="tl-review" role="group" aria-label={`Keep or redo ${item.title}`}>
                          <button type="button" class="tl-keep" data-review={JSON.stringify({ id: item.id, field: spec.spine.status, value: spec.spine.review.keep })} title={`Keep this ${spec.spine.entry_type.replace(/-/g, " ")}: its status becomes ${spec.spine.review.keep}`}>Keep</button>
                          <button type="button" class="tl-redo" data-review={JSON.stringify({ id: item.id, field: spec.spine.status, value: spec.spine.review.redo })} title={`Make this ${spec.spine.entry_type.replace(/-/g, " ")} again: its status becomes ${spec.spine.review.redo}`}>Redo</button>
                        </span>
                      )}
                      <span class="tl-len">{item.seconds.toFixed(1)}s</span>
                    </div>
                  ))}
                </div>

                <div class="tl-ruler" aria-hidden="true">
                  {tickLevels(track.seconds, Math.max(3, Math.round(10 * share(track)))).map(({ t, levels }) => (
                    <span class:list={["tl-tick", ...levels.map((z) => `z${z}`)]} style={`left:${pctIn(track, track.start + t)}`}><i /><b>{timecode(track.start + t)}</b></span>
                  ))}
                </div>

                {lanes.map((lane) => {
                  // Pieces that overlap in time (two sound effects at one moment) stack on rows instead of sitting on top of each other.
                  const lanePieces = track.items.flatMap((item) => item.lanes[lane.id] ?? []);
                  const laneRows = stackRows(lanePieces);
                  // Beds that run together (the story's ambience under a scene's) stack the same way.
                  const bedList = lane.bed ? bedsIn(lane, track) : [];
                  const bedRows = stackRows(bedList.map((b) => ({ start: clip(b, track).from, seconds: clip(b, track).seconds })), 0);
                  // A bed is taller than a piece: its title on top and the level labels in a band of their own below, so one never sits on the other.
                  const laneHeight = (lane.bed ? 62 : 44) + Math.max(0, ...laneRows, ...bedRows) * (lane.bed ? 44 : 28);
                  return (
                  <div class="tl-lane" data-lane={lane.id} role="list" aria-label={lane.title} style={lane.bed || laneRows.some((r) => r > 0) || bedRows.some((r) => r > 0) ? `height:${laneHeight}px` : undefined}>
                    <span class="tl-lane-name">
                      {!lane.cover && !lane.marks && <button type="button" class="tl-mute" data-mute={lane.id} aria-pressed="false" title={`Mute ${lane.title.toLowerCase()}`} aria-label={`Mute ${lane.title}`}>🔊</button>}
                      {lane.title}
                      {lane.estimate_from && track.items.some((i) => (i.lanes[lane.id] ?? []).some((p) => p.estimated && !p.unmeasured)) && <em>hatched: no take yet, length estimated</em>}
                      {lane.estimate_from && track.items.some((i) => (i.lanes[lane.id] ?? []).some((p) => p.unmeasured)) && <em>dashed edge: take attached, length not stored</em>}
                    </span>
                    {lane.bed &&
                      bedList.map((b, n) => (
                        <a
                          class:list={["tl-bed", "has-levels", { silent: !b.audio }]}
                          role="listitem"
                          href={open(b.id)}
                          data-bed={b.id}
                          data-start={b.start}
                          data-end={b.start + b.seconds}
                          style={`left:${pctIn(track, clip(b, track).from)};width:${pctIn(track, track.start + clip(b, track).seconds)}${bedRows[n] ? `;top:${18 + bedRows[n] * 44}px` : ""}`}
                          title={`${b.title}\n${timecode(b.start)} → ${timecode(b.start + b.seconds)} · level ${Math.round(b.volume * 100)}%${b.loop ? ", loops" : ""}${b.muffled ? ", muffled" : ""}${b.fadeIn > 0 ? `\nfades in over ${b.fadeIn.toFixed(1)} s` : ""}${b.fadeOut > 0 ? `\nfades out over ${b.fadeOut.toFixed(1)} s` : ""}${b.audio ? "" : "\nno take yet"}`}
                        >
                          {fadeRamps(b, track).inPct > 0 && <i class="tl-fade in" aria-hidden="true" style={`width:${fadeRamps(b, track).inPct}%`} title={`fades in over ${b.fadeIn.toFixed(1).replace(/\.0$/, "")} s`} />}
                          {fadeRamps(b, track).outPct > 0 && <i class="tl-fade out" aria-hidden="true" style={`width:${fadeRamps(b, track).outPct}%`} title={`fades out over ${b.fadeOut.toFixed(1).replace(/\.0$/, "")} s`} />}
                          {stepBars(b, track).map((st) => (
                            <i
                              class:list={["tl-step", { off: st.volume === 0, muffled: st.muffled }, st.source && `by-${st.source}`]}
                              aria-hidden="true"
                              style={`left:${st.left}%;width:${st.width}%;height:${Math.max(st.height, st.volume === 0 ? 0 : 8)}%`}
                              title={`${timecode(st.start)} → ${timecode(st.end)} · ${st.volume === 0 ? "silent" : `level ${Math.round(st.volume * 100)}%`}${stepSetBy(st)}${st.muffled ? " · heard from inside (muffled)" : ""}`}
                            >
                              {st.source && st.width >= 7 && <b class="tl-step-tag">{st.source} {Math.round(st.volume * 100)}%{st.muffled ? " ≈" : ""}</b>}
                            </i>
                          ))}
                          <span>{b.title}</span>
                          <small>{b.steps.some((st) => st.source) ? setBySummary(b) : b.steps.some((st) => st.volume === 0) ? "dips to silence" : b.steps.length ? `${Math.round(b.volume * 100)}%, changes` : `${Math.round(b.volume * 100)}%`}{b.muffled ? " · muffled" : ""}{b.audio ? "" : " · no take yet"}</small>
                        </a>
                      ))}
                    {lane.cover &&
                      coversIn(lane, track).map((c) => (
                        <span
                          class="tl-bed tl-cover"
                          role="listitem"
                          data-start={c.start}
                          data-end={c.start + c.seconds}
                          style={`left:${pctIn(track, clip(c, track).from)};width:${pctIn(track, track.start + clip(c, track).seconds)}`}
                          title={c.card ? `${c.name}\n${timecode(c.start)} → ${timecode(c.start + c.seconds)} · written on the ${c.from}` : `${c.name}\n${timecode(c.start)} → ${timecode(c.start + c.seconds)} · ${c.blend}${c.opacity < 1 ? ` at ${Math.round(c.opacity * 100)}%` : ""} · from the ${c.from}`}
                        >
                          <span>{c.name}</span>
                          <small>{c.card ? `on the ${c.from}` : <>{c.blend}{c.opacity < 1 ? ` ${Math.round(c.opacity * 100)}%` : ""} · {c.from}</>}</small>
                        </span>
                      ))}
                    {lane.marks &&
                      marksIn(lane, track).map((m) => (
                        <span
                          class:list={["tl-bed", "tl-mark", { inherited: !m.custom && m.from !== spec.spine.entry_type, custom: m.custom }]}
                          role="listitem"
                          data-start={m.start}
                          data-end={m.start + m.seconds}
                          style={`left:${pctIn(track, clip(m, track).from)};width:${pctIn(track, track.start + clip(m, track).seconds)}`}
                          title={`${m.label}${m.count > 1 ? ` (${m.count} beats)` : ""}\n${timecode(m.start)} → ${timecode(m.start + m.seconds)} · ${m.custom ? "written out on the beat itself" : m.from === spec.spine.entry_type ? `set on the ${m.from}` : `from the ${m.from}`}`}
                        >
                          <span>{m.icon ? `${m.icon} ` : ""}{m.label}</span>
                          {(m.custom || m.from !== spec.spine.entry_type) && <small>{m.custom ? "exact numbers" : m.from}</small>}
                        </span>
                      ))}
                    {quiets(track.items, lane).map((q) => (
                      <span class={`tl-quiet ${q.kind}`} aria-hidden="true" style={`left:${pctIn(track, q.start)};width:${pctIn(track, track.start + q.seconds)}`} title={`${quietWords(q.kind)} (${q.seconds.toFixed(2)} s)\n${timecode(q.start)} → ${timecode(q.start + q.seconds)}`}>
                        <small>{q.seconds.toFixed(2).replace(/\.?0+$/, "")}</small>
                      </span>
                    ))}
                    {lanePieces.map((p, n) => (
                      <a
                        class:list={["tl-piece", { estimated: p.estimated && !p.unmeasured, unmeasured: p.unmeasured, untimed: p.seconds === 0, recorded: !!p.audio, placed: p.at !== null }]}
                        role="listitem"
                        href={laneOpens[lane.id] ? laneOpens[lane.id](p.slug) : open(p.id)}
                        data-piece={p.id}
                        style={`left:${pctIn(track, p.start)};width:${pctIn(track, track.start + p.seconds)};min-width:${p.seconds === 0 ? 10 : 18}px${laneRows[n] ? `;top:${18 + laneRows[n] * 28}px` : ""}`}
                        title={`${p.who ? `${p.who}: ` : ""}${p.text || p.title}\n${timecode(p.start)}${p.seconds ? ` → ${timecode(p.start + p.seconds)} (${p.seconds.toFixed(1)} s${p.unmeasured ? ", a take is attached but its length is not stored: this is the estimate" : p.estimated ? ", estimated: no take yet" : ""})` : ""}${p.at !== null ? ` · at ${p.at.toFixed(1)} s` : ""}`}
                      >
                        {p.wave && (
                          <svg class="tl-wave" viewBox={`0 0 ${p.wave.length} 100`} preserveAspectRatio="none" aria-hidden="true"><polygon points={wavePolygon(p.wave)} /></svg>
                        )}
                        {p.who && <b>{p.who}</b>}
                        <span>{firstWords(p.text || p.title)}</span>
                      </a>
                    ))}
                  </div>
                  );
                })}

                <div class="tl-playhead" data-playhead hidden><i /><b class="tl-grip" data-grip title="Drag to move the playhead" aria-hidden="true" /></div>
              </div>
            </div>
          </section>
        ))
      )}
      <p class="tl-hint muted">Click a card to put the playhead there; Open takes you to it. Space plays and pauses. A take plays as recorded; a line with none passes in silence for its estimated length. Sound effects and beds (ambience, music) play over it at their levels, when they have a take.</p>
      <div class="tl-actions">
        <span class="tl-nav" role="group" aria-label="Move through the story">
          <button type="button" class="button secondary" data-jump="start" aria-label="Back to the start" title="Back to the start (Home)" disabled={laid.items.length === 0}>|&lt;</button>
          <button type="button" class="button secondary" data-jump="back" aria-label="Previous beat" title="Previous beat: the start of this one first (←)" disabled={laid.items.length === 0}>&lt;&lt;</button>
          <button type="button" class="button tl-play" data-play aria-pressed="false" disabled={laid.items.length === 0}>▶ Play</button>
          <button type="button" class="button secondary" data-jump="next" aria-label="Next beat" title="Next beat (→)" disabled={laid.items.length === 0}>&gt;&gt;</button>
          <button type="button" class="button secondary" data-jump="end" aria-label="On to the end" title="On to the end (End)" disabled={laid.items.length === 0}>&gt;|</button>
        </span>
        <span class="tl-clock" role="group" aria-label="Playhead position">
          <input
            type="text"
            class="tl-clock-input"
            data-clock
            value="0:00:00.000"
            inputmode="decimal"
            spellcheck="false"
            autocomplete="off"
            aria-label="Playhead time, hours:minutes:seconds.thousandths"
            title="Where the playhead is: h:mm:ss.mmm. Type a time (1:23.5, 0:01:23.456 or 83.5) and press Enter to go there. , and . nudge it by a tenth of a second (Shift: a whole second)."
            disabled={laid.items.length === 0}
          />
          <span class="tl-clock-beat" data-clock-beat title={`How far into the ${spec.spine.entry_type.replace(/-/g, " ")} the playhead is: the "at" a sound placed in it needs`}></span>
        </span>
        <button type="button" class="button secondary tl-fold" data-fold aria-expanded="true" aria-label="Fold the controls down to Play and the clock" title="Fold the controls down to Play and the clock, to see more of the timeline">⌄</button>
        <span class="tl-zoom" role="group" aria-label="Zoom" title="How wide the timeline is: Fit is the page, 2× is two pages. Also + and −.">
          {ZOOM_LEVELS.map((z) => (
            <button type="button" data-zoom={z} aria-pressed={z === 1 ? "true" : "false"}>{z === 1 ? "Fit" : `${z}×`}</button>
          ))}
        </span>
        <span class="tl-zoom" role="group" aria-label="Picture size" title="How big the pictures are drawn: small, medium or large. The frame keeps the story's shape.">
          {Object.keys(PICTURE_SIZES).map((k) => (
            <button type="button" data-size={k} aria-pressed={k === "s" ? "true" : "false"}>{k.toUpperCase()}</button>
          ))}
        </span>
        {stackable && (
          <span class="tl-zoom" role="group" aria-label="Layout" title="One track for the whole story, or a track per chapter stacked down the page.">
            <a href={stackHref(false)} aria-current={stacked ? undefined : "true"}>One track</a>
            <a href={stackHref(true)} aria-current={stacked ? "true" : undefined}>By {spec.spine.group!.entry_type.replace(/-/g, " ")}</a>
          </span>
        )}
      </div>
      <script is:inline type="application/json" data-cues set:html={playJson} />
      <script is:inline type="application/json" data-overlays set:html={overJson} />
    </div>
  )}
</AppLayout>

<script>
  // The player: walks the cues (each a stretch of time, with a take to play or silence to wait), moves the playhead and lights the item and
  // piece under it. Nothing is stitched: a story plays from its takes as they are, and improves as takes land.
  interface Cue { item: string; piece: string | null; lane: string | null; start: number; seconds: number; audio: string | null }
  import { clockText, gainAt, jumpTo, parseClock, placeIn, type Jump, type Overlay } from "@/lib/timeline";
  import { fetchApi } from "@/lib/api/client";
  import { jobFor, runState, type JobRow } from "@/lib/timelineRun";
  const root = document.querySelector<HTMLElement>(".tl");
  const cuesEl = root?.querySelector<HTMLScriptElement>("script[data-cues]");
  if (root && cuesEl) {
    const cues: Cue[] = JSON.parse(cuesEl.textContent || "[]");
    const overlays: Overlay[] = JSON.parse(root.querySelector<HTMLScriptElement>("script[data-overlays]")?.textContent || "[]");
    // Sounds and beds play over the lines: each starts when the playhead reaches it (joining mid-way after a seek), stops at its end or on pause.
    const live = new Map<number, HTMLAudioElement>();
    // Mute by lane, like a mixer: a muted lane's sounds still run (so unmuting mid-way lands in the right place) at level 0.
    const muteKey = `tl-mute:${location.pathname}`;
    const muted = new Set<string>();
    try {
      JSON.parse(localStorage.getItem(muteKey) || "[]").forEach((id: string) => muted.add(id));
    } catch {
      /* nothing remembered */
    }
    const levelOf = (o: Overlay) => (muted.has(o.lane) ? 0 : Math.max(0, Math.min(1, o.volume)));
    const applyMutes = () => {
      root.querySelectorAll<HTMLButtonElement>("[data-mute]").forEach((b) => {
        const on = muted.has(b.dataset.mute || "");
        b.setAttribute("aria-pressed", on ? "true" : "false");
        b.textContent = on ? "🔇" : "🔊";
        b.closest(".tl-lane")?.classList.toggle("is-muted", on);
      });
      for (const [i, el] of live) el.volume = levelOf(overlays[i]);
      const cue = cues[cueIndex];
      audio.muted = !!cue?.lane && muted.has(cue.lane);
    };
    root.querySelectorAll<HTMLButtonElement>("[data-mute]").forEach((b) =>
      b.addEventListener("click", () => {
        const id = b.dataset.mute || "";
        if (muted.has(id)) muted.delete(id);
        else muted.add(id);
        try {
          localStorage.setItem(muteKey, JSON.stringify([...muted]));
        } catch {
          /* fine */
        }
        applyMutes();
      }),
    );
    const syncOverlays = (t: number, on: boolean) => {
      overlays.forEach((o, i) => {
        const end = o.seconds > 0 ? o.start + o.seconds : Infinity;
        const due = on && t >= o.start && t < end;
        const a = live.get(i);
        if (due && a) a.volume = levelOf(o) * gainAt(o, t); // its fades and its dip under speech, as the render does them
        if (due && !a) {
          const el = new Audio(o.audio);
          el.volume = levelOf(o) * gainAt(o, t);
          el.loop = o.loop;
          const offset = t - (o.origin ?? o.start); // a bed cut into level steps keeps its place in the file across them
          el.addEventListener("loadedmetadata", () => {
            if (!el.duration || !Number.isFinite(el.duration)) return;
            if (o.loop) el.currentTime = offset % el.duration;
            else if (offset < el.duration) el.currentTime = offset;
            else el.pause();
          });
          el.addEventListener("ended", () => live.delete(i));
          el.play().catch(() => live.delete(i));
          live.set(i, el);
        } else if (!due && a) {
          a.pause();
          live.delete(i);
        }
      });
    };
    const total = Number(root.dataset.total || "0");
    const playBtn = root.querySelector<HTMLButtonElement>("[data-play]");
    // Each track (the whole story, or one chapter when stacked) has its own box, strip and playhead; the playhead shows in the track holding `at`.
    const tracks = [...root.querySelectorAll<HTMLElement>("[data-track]")].map((el, i, all) => ({
      start: Number(el.dataset.start || "0"),
      seconds: Number(el.dataset.seconds || "0"),
      last: i === all.length - 1,
      inner: el.querySelector<HTMLElement>(".tl-inner"),
      scroll: el.querySelector<HTMLElement>("[data-scroll]"),
      head: el.querySelector<HTMLElement>("[data-playhead]"),
    }));
    const trackAt = (t: number) => tracks.find((k) => t >= k.start && (t < k.start + k.seconds || (k.last && t <= k.start + k.seconds)));
    const audio = new Audio();
    const zoomButtons = [...root.querySelectorAll<HTMLButtonElement>("[data-zoom]")];
    const zoomKey = `tl-zoom:${location.pathname}`;
    // On a phone the controls are one bar fixed to the screen: it folds down to Play and the clock (and a button to open it again), so the
    // timeline has the room. Remembered, for the next visit.
    const foldKey = "tl-controls-folded";
    const bar = root.querySelector<HTMLElement>(".tl-actions");
    const foldButton = root.querySelector<HTMLButtonElement>("[data-fold]");
    const setFolded = (on: boolean) => {
      bar?.classList.toggle("is-folded", on);
      root.classList.toggle("controls-folded", on);
      if (!foldButton) return;
      foldButton.setAttribute("aria-expanded", on ? "false" : "true");
      foldButton.textContent = on ? "⌃" : "⌄";
      foldButton.setAttribute("aria-label", on ? "Show all the controls" : "Fold the controls down to Play and the clock");
      foldButton.title = on ? "Show all the controls" : "Fold the controls down to Play and the clock, to see more of the timeline";
    };
    foldButton?.addEventListener("click", () => {
      const on = !bar?.classList.contains("is-folded");
      setFolded(on);
      try {
        localStorage.setItem(foldKey, on ? "1" : "0");
      } catch {
        /* a private window forgets it, nothing more */
      }
    });
    try {
      setFolded(localStorage.getItem(foldKey) === "1");
    } catch {
      /* same */
    }
    let zoom = 1;
    // Zoom: the strip is `zoom` pages wide (never under the floor the shortest beat needs); what sits under the middle of the box stays there.
    const setZoom = (level: number) => {
      zoom = level;
      for (const { inner, scroll } of tracks) {
        if (!inner || !scroll) continue;
        const box = scroll.clientWidth;
        const middle = (scroll.scrollLeft + box / 2) / Math.max(1, inner.offsetWidth);
        inner.style.width = `${Number(inner.dataset.share || "1") * level * 100}%`;
        inner.dataset.zoom = String(level);
        scroll.scrollLeft = Math.max(0, middle * inner.offsetWidth - box / 2);
      }
      zoomButtons.forEach((b) => b.setAttribute("aria-pressed", Number(b.dataset.zoom) === level ? "true" : "false"));
      try {
        localStorage.setItem(zoomKey, String(level));
      } catch {
        /* a private window forgets the zoom, nothing more */
      }
    };
    const levels = zoomButtons.map((b) => Number(b.dataset.zoom)).filter(Boolean);
    zoomButtons.forEach((b) => b.addEventListener("click", () => setZoom(Number(b.dataset.zoom))));
    const stepZoom = (dir: 1 | -1) => {
      const i = levels.indexOf(zoom);
      const next = levels[Math.min(levels.length - 1, Math.max(0, i + dir))];
      if (next && next !== zoom) setZoom(next);
    };
    try {
      const kept = Number(localStorage.getItem(zoomKey));
      if (levels.includes(kept) && kept !== 1) setZoom(kept);
    } catch {
      /* same */
    }
    // Picture size: the strip's cards take this height (the frame follows, in the story's shape) and the strip never gets narrower than the shape needs.
    const sizeButtons = [...root.querySelectorAll<HTMLButtonElement>("[data-size]")];
    const sizeKey = `tl-size:${location.pathname}`;
    const heights: Record<string, number> = JSON.parse(root.dataset.sizes || "{}");
    const shapeNow = Number(root.dataset.shape) || null;
    const setSize = (key: string) => {
      const h = heights[key];
      if (!h) return;
      root.style.setProperty("--tl-h", `${h}px`);
      const floor = Math.max(72, shapeNow ? Math.round(h * shapeNow) : 0);
      for (const { inner } of tracks) {
        const shortest = Number(inner?.dataset.shortest);
        const total = Number(inner?.dataset.total);
        if (inner && Number.isFinite(shortest) && shortest > 0 && total > 0) inner.style.minWidth = `${Math.ceil((floor / shortest) * total)}px`;
      }
      sizeButtons.forEach((b) => b.setAttribute("aria-pressed", b.dataset.size === key ? "true" : "false"));
      try {
        localStorage.setItem(sizeKey, key);
      } catch {
        /* a private window forgets the size, nothing more */
      }
    };
    sizeButtons.forEach((b) => b.addEventListener("click", () => setSize(b.dataset.size || "s")));
    try {
      const kept = localStorage.getItem(sizeKey);
      if (kept && kept !== "s") setSize(kept);
    } catch {
      /* same */
    }
    let at = 0; // seconds into the timeline
    let playing = false;
    let frame = 0;
    let cueIndex = -1;
    let cueStartedAt = 0; // wall clock, for silent stretches

    const cueAt = (t: number) => cues.findIndex((c) => t >= c.start && t < c.start + c.seconds);
    const light = (t: number) => {
      const cue = cues[cueAt(t)];
      root.querySelectorAll<HTMLElement>(".tl-item.is-now, .tl-piece.is-now").forEach((el) => el.classList.remove("is-now"));
      root.querySelectorAll<HTMLElement>(".tl-bed").forEach((el) => el.classList.toggle("is-now", playing && t >= Number(el.dataset.start) && t < Number(el.dataset.end)));
      if (!cue) return;
      root.querySelector(`[data-item="${cue.item}"]`)?.classList.add("is-now");
      if (cue.piece) root.querySelector(`[data-piece="${cue.piece}"]`)?.classList.add("is-now");
    };
    // Where each item starts and what it is called (a beat's number): for the clock's "how far into this beat" and for jumping between them.
    const itemMarks = Array.from(root.querySelectorAll<HTMLElement>("[data-item][data-start]"), (item) => ({ start: Number(item.dataset.start), name: item.dataset.name || "" }));
    const itemStarts = itemMarks.map((m) => m.start);
    const noun = root.dataset.noun || "item";
    const clockInput = root.querySelector<HTMLInputElement>("[data-clock]");
    const clockBeat = root.querySelector<HTMLElement>("[data-clock-beat]");
    const showClock = (t: number) => {
      if (clockInput && document.activeElement !== clockInput) clockInput.value = clockText(t); // not while it is being typed in
      if (!clockBeat) return;
      const here = placeIn(itemStarts, t);
      clockBeat.textContent = here ? `${noun} ${itemMarks[here.index].name} +${here.offset.toFixed(3)} s` : "";
    };
    const show = (t: number) => {
      at = Math.max(0, Math.min(total, t));
      showClock(at);
      const here = trackAt(at);
      for (const k of tracks) {
        if (!k.head) continue;
        k.head.hidden = k !== here;
        if (k === here) k.head.style.left = `${k.seconds > 0 ? ((at - k.start) / k.seconds) * 100 : 0}%`;
      }
      light(at);
      syncOverlays(at, playing);
      if (here?.scroll && here.head && playing) {
        const { scroll, head } = here;
        const px = head.offsetLeft;
        if (px < scroll.scrollLeft + 40 || px > scroll.scrollLeft + scroll.clientWidth - 40) scroll.scrollLeft = Math.max(0, px - scroll.clientWidth / 3);
      }
    };

    const stop = () => {
      playing = false;
      cancelAnimationFrame(frame);
      audio.pause();
      syncOverlays(at, false);
      cueIndex = -1;
      if (playBtn) {
        playBtn.textContent = "▶ Play";
        playBtn.setAttribute("aria-pressed", "false");
      }
    };
    const startCue = (i: number) => {
      cueIndex = i;
      const cue = cues[i];
      if (!cue) return finish();
      cueStartedAt = performance.now() - Math.max(0, at - cue.start) * 1000;
      if (cue.audio) {
        audio.muted = !!cue.lane && muted.has(cue.lane);
        audio.src = cue.audio;
        audio.currentTime = Math.max(0, at - cue.start);
        audio.play().catch(() => {
          // A take that will not play (gone, blocked) passes as silence of its length instead of stopping the story.
          cue.audio = null;
        });
      }
    };
    const finish = () => {
      stop();
      show(total);
    };
    const tick = () => {
      if (!playing) return;
      const cue = cues[cueIndex];
      if (!cue) return finish();
      const elapsed = cue.audio && !audio.paused && !audio.ended ? audio.currentTime : (performance.now() - cueStartedAt) / 1000;
      if (elapsed >= cue.seconds || (cue.audio && audio.ended)) {
        if (cueIndex + 1 >= cues.length) return finish();
        at = cue.start + cue.seconds;
        startCue(cueIndex + 1);
      } else {
        show(cue.start + Math.min(elapsed, cue.seconds));
      }
      frame = requestAnimationFrame(tick);
    };
    const play = () => {
      if (!cues.length) return;
      if (at >= total) at = 0;
      playing = true;
      if (playBtn) {
        playBtn.textContent = "❚❚ Pause";
        playBtn.setAttribute("aria-pressed", "true");
      }
      const i = cueAt(at);
      startCue(i < 0 ? 0 : i);
      frame = requestAnimationFrame(tick);
    };
    const toggle = () => (playing ? stop() : play());

    // A button that runs a workflow here (a render preview): start it, then follow the job it makes until it is done or has failed.
    const runStatus = root.querySelector<HTMLElement>("[data-run-status]");
    const runText = runStatus?.querySelector<HTMLElement>("[data-run-text]");
    runStatus?.querySelector("[data-run-close]")?.addEventListener("click", () => (runStatus.hidden = true));
    const POLL_MS = 4000;
    const GIVE_UP_MS = 30 * 60 * 1000;
    root.querySelectorAll<HTMLButtonElement>("[data-run]").forEach((button) =>
      button.addEventListener("click", async () => {
        const run = JSON.parse(button.dataset.run || "{}") as { workflow: string; inputs: Record<string, unknown> };
        const label = button.dataset.runLabel || "Run";
        const slug = button.dataset.runSlug || "";
        const since = Date.now();
        const say = (text: string, url: string | null = null) => {
          if (!runStatus || !runText) return;
          runStatus.hidden = false;
          runText.replaceChildren(document.createTextNode(text));
          if (url) {
            const link = document.createElement("a");
            link.href = url;
            link.target = "_blank";
            link.rel = "noopener noreferrer";
            link.textContent = " Open the video ↗";
            runText.append(link);
          }
        };
        button.disabled = true;
        say(`${label}: starting…`);
        try {
          await fetchApi(`/api/automations/${encodeURIComponent(run.workflow)}/run?background=true`, { method: "POST", body: JSON.stringify({ inputs: run.inputs }) });
        } catch (e) {
          say(`${label} could not start: ${e instanceof Error ? e.message : "the workflow did not run"}`);
          button.disabled = false;
          return;
        }
        while (Date.now() - since < GIVE_UP_MS) {
          await new Promise((r) => setTimeout(r, POLL_MS));
          const found = await fetchApi<{ entries?: JobRow[] }>("/api/platform/entries/query", {
            method: "POST",
            body: JSON.stringify({ spec: { entry_type: "job", created_after: new Date(since - 30_000).toISOString(), sort: { by: "created_at", direction: "desc" } }, limit: 20 }),
          }).catch(() => ({ entries: [] as JobRow[] }));
          const state = runState(jobFor(found.entries ?? [], slug, since), label);
          say(state.text, state.url);
          if (state.finished) break;
        }
        button.disabled = false;
      }),
    );

    // Keep / Redo on a card: write the view's keep or redo status into the entry's status field, then show it. The entry is read first and sent back
    // whole, because saving an entry replaces its fields.
    root.querySelectorAll<HTMLButtonElement>("[data-review]").forEach((button) =>
      button.addEventListener("click", async () => {
        const { id, field, value } = JSON.parse(button.dataset.review || "{}") as { id: string; field: string; value: string };
        const group = button.closest<HTMLElement>(".tl-review");
        const card = button.closest<HTMLElement>(".tl-item");
        group?.querySelectorAll("button").forEach((b) => ((b as HTMLButtonElement).disabled = true));
        try {
          const entry = await fetchApi<{ title: string; slug: string; dataJson?: Record<string, unknown> }>(`/api/platform/entries/${encodeURIComponent(id)}`);
          await fetchApi(`/api/platform/entries/${encodeURIComponent(id)}`, {
            method: "PATCH",
            body: JSON.stringify({ title: entry.title, slug: entry.slug, dataJson: { ...(entry.dataJson ?? {}), [field]: value } }),
          });
          const dot = card?.querySelector<HTMLElement>(".tl-dot");
          if (dot) {
            dot.dataset.status = value;
            dot.title = value;
          }
          group?.remove();
          if (runStatus && runText) {
            runStatus.hidden = false;
            runText.textContent = `${entry.title}: ${value}`;
          }
        } catch (e) {
          group?.querySelectorAll("button").forEach((b) => ((b as HTMLButtonElement).disabled = false));
          if (runStatus && runText) {
            runStatus.hidden = false;
            runText.textContent = `Could not save: ${e instanceof Error ? e.message : "the entry did not change"}`;
          }
        }
      }),
    );

    playBtn?.addEventListener("click", toggle);
    root.querySelectorAll<HTMLButtonElement>("[data-seek]").forEach((b) =>
      b.addEventListener("click", () => {
        const was = playing;
        stop();
        show(Number(b.dataset.seek || "0"));
        if (was) play();
      }),
    );
    // |< << >> >|: the start, the previous beat, the next beat, the end. Playing carries on from where it lands (but not past the end).
    const jump = (action: Jump) => {
      const was = playing;
      stop();
      show(jumpTo(itemStarts, total, at, action));
      if (was && action !== "end") play();
    };
    root.querySelectorAll<HTMLButtonElement>("[data-jump]").forEach((b) => b.addEventListener("click", () => jump(b.dataset.jump as Jump)));
    // Go to a time (typed, or a nudge), carrying on playing if it was.
    const goTo = (t: number) => {
      const was = playing;
      stop();
      show(t);
      if (was && at < total) play();
    };
    clockInput?.addEventListener("focus", () => clockInput.select());
    clockInput?.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        clockInput.value = clockText(at);
        clockInput.blur();
      } else if (e.key === "Enter") {
        e.preventDefault();
        const t = parseClock(clockInput.value);
        clockInput.classList.toggle("bad", t === null);
        if (t === null) return;
        clockInput.blur();
        goTo(Math.min(t, total));
      }
    });
    clockInput?.addEventListener("input", () => clockInput.classList.remove("bad"));
    clockInput?.addEventListener("blur", () => {
      clockInput.classList.remove("bad");
      showClock(at);
    });
    // The playhead can be dragged: its grip follows the pointer along the strip (the strip scrolls when the grip nears an edge), playback pauses while it is held and carries on from where it is let go.
    root.querySelectorAll<HTMLElement>("[data-grip]").forEach((grip) => {
      const head = grip.closest<HTMLElement>("[data-playhead]");
      const track = tracks.find((k) => k.head === head);
      if (!head || !track) return;
      let held: { was: boolean } | null = null;
      grip.addEventListener("pointerdown", (e) => {
        e.preventDefault();
        grip.setPointerCapture(e.pointerId);
        held = { was: playing };
        stop();
        head.classList.add("is-dragging");
      });
      grip.addEventListener("pointermove", (e) => {
        if (!held) return;
        const box = (head.offsetParent as HTMLElement | null)?.getBoundingClientRect();
        if (!box || box.width <= 0) return;
        if (track.scroll) {
          const edge = track.scroll.getBoundingClientRect();
          if (e.clientX < edge.left + 40) track.scroll.scrollLeft -= 24;
          else if (e.clientX > edge.right - 40) track.scroll.scrollLeft += 24;
        }
        const fraction = Math.max(0, Math.min(1, (e.clientX - box.left) / box.width));
        show(track.start + fraction * track.seconds);
      });
      const let_go = () => {
        if (!held) return;
        const { was } = held;
        held = null;
        head.classList.remove("is-dragging");
        if (was && at < total) play();
      };
      grip.addEventListener("pointerup", let_go);
      grip.addEventListener("pointercancel", let_go);
    });
    applyMutes();
    document.addEventListener("keydown", (e) => {
      const target = e.target as HTMLElement | null;
      if (target?.closest("input, textarea, select, [contenteditable]")) return;
      if (e.key === "+" || e.key === "=") return stepZoom(1);
      if (e.key === "-") return stepZoom(-1);
      // Home, End and the arrows move through the story from the page itself or from a button just pressed (Play keeps the focus); a scrolling box or a slider keeps its own arrows.
      if ((!target || target === document.body || target.closest("button, a")) && !e.metaKey && !e.ctrlKey && !e.altKey) {
        const key: Record<string, Jump> = { Home: "start", End: "end", ArrowLeft: "back", ArrowRight: "next" };
        if (key[e.key]) {
          e.preventDefault();
          return jump(key[e.key]);
        }
      }
      if ((e.key === "," || e.key === "." || e.key === "<" || e.key === ">") && !e.metaKey && !e.ctrlKey && !e.altKey && !target?.closest("a, select")) {
        e.preventDefault(); // , and . move the playhead a tenth of a second, a whole second with Shift, to place something exactly
        return goTo(at + (e.key === "," || e.key === "<" ? -1 : 1) * (e.shiftKey ? 1 : 0.1));
      }
      if (e.code !== "Space" || target?.closest("button, a")) return;
      e.preventDefault();
      toggle();
    });
    audio.addEventListener("error", () => {
      const cue = cues[cueIndex];
      if (cue) cue.audio = null;
    });
  }
</script>

<style>
  .pick { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
