  .tl-piece.estimated { background: repeating-linear-gradient(135deg, color-mix(in srgb, var(--accent) 18%, var(--panel)) 0 6px, var(--panel) 6px 10px); border-style: dashed; }
  .tl-piece.unmeasured { border-right-style: dashed; border-right-width: 3px; }
