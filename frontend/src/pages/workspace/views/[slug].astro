  /* min-width: 0 on the grid and its boxes: the strip's pixel floor scrolls inside its box instead of widening the whole page (on a phone
     that pushed the header, Play included, off to the right). */
  .tl { display: grid; gap: 16px; min-width: 0; max-width: 100%; }
  .tl-track { min-width: 0; }
  .tl-head { display: flex; flex-wrap: wrap; gap: 12px 24px; align-items: flex-end; justify-content: space-between; }
  .tl-title h2 { margin: 0 0 4px; }
  .tl-facts { margin: 0; font-size: 14px; }
  .tl-total { font-variant-numeric: tabular-nums; font-size: 16px; }
  .tl-run { position: fixed; left: 50%; transform: translateX(-50%); bottom: 20px; z-index: 40; display: flex; align-items: center; gap: 12px; max-width: min(560px, calc(100vw - 32px)); padding: 10px 14px; font-size: 0.875rem; background: var(--panel); color: var(--ink); border: 1px solid var(--line); border-radius: 10px; box-shadow: 0 6px 24px rgb(0 0 0 / 0.25); }
  .tl-run[hidden] { display: none; }
  .tl-run-close { flex: none; border: 0; background: transparent; color: var(--muted); font-size: 1.25rem; line-height: 1; padding: 0 2px; cursor: pointer; }
  .tl-actions, .tl-links { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  /* The controls are pinned to the bottom of the window, centered in the timeline's column, so Play and the clock stay in reach down a long page
