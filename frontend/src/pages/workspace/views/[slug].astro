  .tl-actions { position: sticky; bottom: 12px; z-index: 30; justify-self: center; justify-content: center; width: fit-content; max-width: 100%; padding: 8px 12px; background: var(--panel); border: 1px solid var(--line); border-radius: 12px; box-shadow: 0 6px 24px rgb(0 0 0 / 0.25); }
  .tl-run { bottom: 84px; } /* above the pinned bar */
  /* The transport: Play between the four jumps, one joined group; the jump buttons are small and mono so the pair of signs stay narrow. */
  .tl-nav { display: inline-flex; gap: 4px; align-items: center; }
  .tl-nav [data-jump] { min-width: 2.6em; padding-inline: 0.55em; font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 0.8125rem; letter-spacing: -0.04em; }
