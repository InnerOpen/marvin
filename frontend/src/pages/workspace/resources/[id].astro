---
import ItemTrashBanner from "@/components/ItemTrashBanner.astro";
import SuggestionBanner from "@/components/SuggestionBanner.astro";
import TagChips from "@/components/TagChips.astro";
import AppLayout from "@/layouts/AppLayout.astro";
import { getAuthToken } from "@/lib/api/client";
import { listCollections } from "@/lib/api/collections";
import { getResource } from "@/lib/api/resources";
import { listTags, type TagRead } from "@/lib/api/tags";
import { FULL_CONTENT_ACCESS, getContentAccess } from "@/lib/api/workspaces";
import { EDITORS_ONLY } from "@/lib/workspaceRole";

const authToken = getAuthToken(Astro.cookies);
const { id } = Astro.params;
// Everyone reads; changing, deleting or applying a suggestion to a resource is EDITOR+.
const access = authToken ? await getContentAccess(authToken) : FULL_CONTENT_ACCESS;

let resource = null;
let allTags: TagRead[] = [];
let error: string | null = null;

if (!id) {
  error = "Resource ID is required";
} else {
  try {
    [resource, allTags] = await Promise.all([getResource(id, authToken), listTags(authToken)]);
  } catch (e) {
    error = e instanceof Error ? e.message : String(e);
    console.error("[Resource] Failed to load:", error);
  }
}

// A resource in the Trash is read-only: whoever may change it can Restore it or delete it forever, nothing else.
const inTrash = Boolean((resource as any)?.trashedAt);
const canEdit = access.canEdit && !inTrash;
const trashCollectionId =
  inTrash && authToken
    ? ((await listCollections(authToken).catch(() => [])).find((c: any) => c.isSystem && c.slug === "trash")?.id ?? null)
    : null;

// resource.tags is a slug list; resolve to {id, name} via the workspace vocabulary for the chips.
const tagBySlug = new Map((allTags || []).map((t) => [t.slug, t]));
const attachedTags = ((resource?.tags as string[] | undefined) || [])
  .map((slug) => tagBySlug.get(slug))
  .filter(Boolean)
  .map((t) => ({ id: t!.id, name: t!.name }));
---

<AppLayout
  title={resource ? resource.name : "Edit Resource"}
  entityType="resource"
  entityId={id}
  entityLabel={resource?.name}
>
  {error ? (
    <div class="error-banner">
      <p><strong>Error loading resource:</strong> {error}</p>
      <a href="/workspace/resources" class="button secondary">Back to Resources</a>
    </div>
  ) : resource ? (
    <>
      <div class="toolbar">
        <div>
          <h2 style="margin:0;font-size:20px;">Edit Resource</h2>
          <p style="margin:4px 0 0;color:var(--muted);">Update resource details</p>
        </div>
        <div style="display:flex;gap:0.75rem;">
          {canEdit && (
            <button type="button" id="delete-button" class="button secondary" title="Move this resource to the Trash. You can restore it from there.">
              Move to Trash
            </button>
          )}
          <a class="button secondary" href="/workspace/resources">Back</a>
        </div>
      </div>

      {inTrash && <ItemTrashBanner kind="resource" id={id!} canChange={access.canEdit} trashCollectionId={trashCollectionId} />}
      {inTrash ? null : canEdit ? (
        <SuggestionBanner suggestion={(resource as any)?.suggestionJson} entity={resource} apiBase="/api/resources" entityId={id!} />
      ) : (
        <div class="alert alert-info" role="status">{EDITORS_ONLY}</div>
      )}

      <section class="form-section">
        <form id="resource-form" class="form">
          <fieldset disabled={!canEdit} style="border:0;margin:0;padding:0;min-width:0;">
          <div class="form-group">
            <label for="name">Name *</label>
            <input
              type="text"
              id="name"
              name="name"
              required
              value={resource.name}
            />
          </div>

          <div class="form-group">
            <label for="slug">Slug</label>
            <input
              type="text"
              id="slug"
              name="slug"
              value={resource.slug}
              disabled
              style="background: var(--panel-2); color: var(--muted);"
            />
            <p class="form-help">Auto-generated from name</p>
          </div>

          <div class="form-group">
            <label for="resource_type">Type *</label>
            <input
              type="text"
              id="resource_type"
              name="resource_type"
              required
              value={resource.resourceType}
            />
            <p class="form-help">Category for this resource</p>
          </div>

          <div class="form-group">
            <label for="url">URL</label>
            <input
              type="url"
              id="url"
              name="url"
              value={resource.url || ""}
            />
            <p class="form-help">External website or documentation</p>
            {resource.url && (
              <a href={resource.url} target="_blank" rel="noopener noreferrer" class="external-link">
                Open in new tab ↗
              </a>
            )}
          </div>

          <div class="form-group">
            <label for="external_id">External ID</label>
            <input
              type="text"
              id="external_id"
              name="external_id"
              value={resource.externalId || ""}
            />
          </div>

          <div class="form-group">
            <label for="description">Description</label>
            <textarea
              id="description"
              name="description"
              rows="4"
            >{resource.description || ""}</textarea>
          </div>

          <div class="form-group">
            <label for="metadata_">Metadata (JSON)</label>
            <p class="form-help">Custom metadata fields for this resource</p>
            <textarea
              id="metadata_"
              name="metadata_"
              rows="6"
              placeholder='{"key": "value"}'
              class="metadata-editor"
            >{resource.metadataJson ? JSON.stringify(resource.metadataJson, null, 2) : ""}</textarea>
            <small style="font-size: 11px; color: var(--muted);">
              Must be valid JSON. Example: {`{"supplier_code": "ABC123", "contact": "john@example.com"}`}
            </small>

            {resource.metadataJson && Object.keys(resource.metadataJson).length > 0 && (
              <div class="metadata-preview">
                <p class="metadata-preview-title">Current Metadata:</p>
                <dl class="metadata-preview-list">
                  {Object.entries(resource.metadataJson).map(([key, value]) => (
                    <div class="metadata-preview-item">
                      <dt>{key}</dt>
                      <dd>{typeof value === 'object' ? JSON.stringify(value, null, 2) : String(value)}</dd>
                    </div>
                  ))}
                </dl>
              </div>
            )}
          </div>

          <TagChips attachedTags={attachedTags} allTags={(allTags || []).map((t) => ({ id: t.id, name: t.name, slug: t.slug }))} />

          </fieldset>
          {canEdit && (
            <div class="form-actions">
              <button type="submit" class="button">Save Changes</button>
              <a href="/workspace/resources" class="button secondary">Cancel</a>
            </div>
          )}
        </form>
      </section>
    </>
  ) : null}
</AppLayout>

<script>
  import { createSdkClient } from '@/lib/sdk';
  import { resolveTagIds } from '@/lib/api/tagChips';
  import { bindMetadataPreview } from '@/lib/metadataPreview';
  import { isForbidden } from '@/lib/workspaceRole';

  console.log('[Resources] Script loading...');

  const sdk = createSdkClient();
  const form = document.getElementById('resource-form') as HTMLFormElement;
  const metadataField = document.getElementById('metadata_') as HTMLTextAreaElement;
  const submitButton = form?.querySelector('button[type="submit"]') as HTMLButtonElement;
  const deleteButton = document.getElementById('delete-button') as HTMLButtonElement;

  console.log('[Resources] Elements:', { form, deleteButton, submitButton });

  // Move to Trash (reversible: restore it from the Trash until the Trash is emptied).
  if (deleteButton) {
    deleteButton.addEventListener('click', async () => {
      deleteButton.disabled = true;
      deleteButton.textContent = 'Moving…';

      try {
        const resourceId = window.location.pathname.split('/').pop()!;
        await sdk.resources.delete(resourceId);
        window.location.href = '/workspace/resources';
      } catch (error: any) {
        const message = isForbidden(error) ? "You don't have permission to do this." : error?.message || error?.detail || 'Failed to move the resource to the Trash';
        alert(message);
        deleteButton.disabled = false;
        deleteButton.textContent = 'Move to Trash';
      }
    });
  }

  // Validate metadata JSON
  if (metadataField) {
    metadataField.addEventListener('blur', () => {
      const value = metadataField.value.trim();
      if (!value) return;

      try {
        JSON.parse(value);
        metadataField.style.borderColor = 'var(--line)';
      } catch (error) {
        metadataField.style.borderColor = '#ef5350';
      }
    });
  }

  // Handle form submission via SDK
  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const formData = new FormData(form);
      const name = formData.get('name') as string;
      const resourceType = formData.get('resource_type') as string;
      const url = formData.get('url') as string;
      const externalId = formData.get('external_id') as string;
      const description = formData.get('description') as string;
      const metadataStr = formData.get('metadata_') as string;

      // Parse metadata JSON
      let metadata = null;
      if (metadataStr?.trim()) {
        try {
          metadata = JSON.parse(metadataStr);
        } catch (error) {
          alert('Invalid JSON in metadata field');
          return;
        }
      }

      // Disable submit button
      submitButton.disabled = true;
      submitButton.textContent = 'Saving...';

      try {
        const resourceId = window.location.pathname.split('/').pop()!;
        const tagIds = await resolveTagIds(document.getElementById('tags-payload') as HTMLInputElement | null);
        await sdk.resources.update(resourceId, {
          name,
          resourceType,
          url: url?.trim() || null,
          externalId: externalId?.trim() || null,
          description: description?.trim() || null,
          metadataJson: metadata,
          tag_ids: tagIds,
        });

        // Redirect back to resources list
        window.location.href = '/workspace/resources';
      } catch (error: any) {
        const message = isForbidden(error) ? "You don't have permission to do this." : error?.message || error?.detail || 'Failed to update resource';
        alert(message);
        submitButton.disabled = false;
        submitButton.textContent = 'Save Changes';
      }
    });
  }

  // Metadata preview update
  const metadataEditor = document.getElementById('metadata_') as HTMLTextAreaElement | null;
  if (metadataEditor) {
    bindMetadataPreview(metadataEditor, '.form-group', () => metadataEditor.closest('.form-group')?.querySelector('.form-help'));
  }
</script>

<style>
  .error-banner {
    padding: 1.5rem;
    background: var(--color-error-bg);
    border: 1px solid var(--color-error);
    border-radius: var(--radius);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .error-banner p {
    margin: 0;
    color: var(--color-error);
  }

  .form-section {
    max-width: 42rem;
  }

  .form {
    display: grid;
    gap: 2rem;
    padding: 2rem;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .form-group {
    display: grid;
    gap: 0.5rem;
  }

  label {
    font-weight: 600;
    font-size: 0.875rem;
    color: var(--ink);
  }

  input[type="text"],
  input[type="url"],
  textarea {
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--bg);
    font-size: 0.875rem;
  }

  textarea {
    resize: vertical;
    font-family: inherit;
  }

  .form-help {
    margin: 0;
    font-size: 0.75rem;
    color: var(--muted);
  }

  .external-link {
    font-size: 0.875rem;
    color: var(--accent);
    text-decoration: none;
  }

  .external-link:hover {
    text-decoration: underline;
  }

  .form-actions {
    display: flex;
    gap: 0.75rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .metadata-editor {
    font-family: 'Monaco', 'Menlo', 'Ubuntu Mono', monospace;
    font-size: 12px;
    line-height: 1.5;
    background: var(--panel-2);
  }

  .metadata-preview {
    margin-top: 1rem;
    padding: 1rem;
    background: var(--panel-2);
    border-radius: 6px;
  }

  .metadata-preview-title {
    margin: 0 0 0.75rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .metadata-preview-list {
    display: grid;
    gap: 0.75rem;
    margin: 0;
  }

  .metadata-preview-item {
    padding: 0.5rem;
    background: var(--bg);
    border-radius: 4px;
  }

  .metadata-preview-item dt {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 0.25rem;
  }

  .metadata-preview-item dd {
    margin: 0;
    font-size: 0.875rem;
    word-break: break-word;
    white-space: pre-wrap;
    font-family: monospace;
  }
</style>
