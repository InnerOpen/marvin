---
import FilterBar from "@/components/FilterBar.astro";
import OrganizedSections from "@/components/OrganizedSections.astro";
import AppLayout from "@/layouts/AppLayout.astro";
import { getAuthToken } from "@/lib/api/client";
import { listIntegrations, listProviders } from "@/lib/api/integrations";
import { listScheduledTaskOverview } from "@/lib/api/scheduledTaskOverview";
import { listWorkspaces } from "@/lib/api/workspaces";
import { fromOptions, type Integrations, statusOptions } from "@/lib/organizedList";
import { createSdkClient } from "@/lib/sdk";
import { SCHEDULE_OPTIONS, type ScheduledTaskRow, scheduledTaskAdapter } from "@/lib/scheduledTaskList";
import { canManageWorkspace, EDITORS_ONLY, isForbidden } from "@/lib/workspaceRole";

const authToken = getAuthToken(Astro.cookies);
const sdk = createSdkClient(authToken);

let tasks: ScheduledTaskRow[] = [];
let integrationInfo: Integrations = {};
let error: string | null = null;
let restrictedNote: string | null = null;
// Editors read the page; switching, running, editing and deleting are ADMIN (the API refuses anyone else).
let canManage = false;
try {
  canManage = canManageWorkspace(await listWorkspaces(authToken), (await sdk.user.getProfile()) as any);
} catch {
  // unknown role: read-only
}

try {
  tasks = await listScheduledTaskOverview(authToken);
  // The sections' names and logos. If the integrations can't be read (an editor may not), their tasks still group
  // rather than all reading as "From a removed integration".
  const [integrations, providers] = await Promise.all([
    listIntegrations(authToken).catch((e) => (console.error("[scheduled-tasks] integrations:", e), null)),
    listProviders(authToken).catch(() => []),
  ]);
  const byProvider = new Map((providers ?? []).map((p: any) => [p.slug, p]));
  integrationInfo = integrations
    ? Object.fromEntries(
        integrations.map((i: any) => {
          const provider: any = byProvider.get(i.provider);
          return [i.id, { name: i.name, slug: i.provider, icon: provider?.icon, hasLogo: provider?.hasLogo }];
        }),
      )
    : Object.fromEntries(tasks.filter((t) => t.sourceIntegrationId).map((t) => [t.sourceIntegrationId, { name: "an integration" }]));
} catch (e) {
  console.error("[scheduled-tasks] Error loading:", e);
  if (isForbidden(e)) restrictedNote = EDITORS_ONLY;
  else error = e instanceof Error ? e.message : String(e);
}

const json = (value: unknown) => JSON.stringify(value).replace(/</g, "\\u003c");
const fromChoices = fromOptions(tasks, scheduledTaskAdapter(), integrationInfo);
---

<AppLayout crumb="automation.scheduled-tasks" restrictedNote={restrictedNote}>
  <div class="st-page">
    <div class="toolbar">
      <div>
        <h2>Scheduled Tasks</h2>
        <p>Recurring jobs: your own, the ones integrations installed, and Marvin's housekeeping.</p>
      </div>
      {canManage && (
        <div class="toolbar-actions">
          <a href="/workspace/scheduled-tasks/log" class="button secondary">Activity Log</a>
          <a href="/workspace/scheduled-tasks/new" class="button">New Task</a>
        </div>
      )}
    </div>

    {error && (
      <div class="alert alert-error">
        <strong>Error:</strong> {error}
      </div>
    )}

    {!error && tasks.length > 0 && (
      <FilterBar
        searchPlaceholder="Search scheduled tasks…"
        searchId="st-search"
        filters={[
          { id: "st-f-from", label: "sources", options: fromChoices },
          { id: "st-f-status", label: "statuses", options: statusOptions({ attention: true }) },
          { id: "st-f-schedule", label: "schedules", options: SCHEDULE_OPTIONS },
        ]}
      />
    )}
    {!error && (
      <OrganizedSections
        id="st"
        noun="scheduled task"
        emptyAll="No scheduled tasks yet. Scheduled tasks automate recurring operations like cleanup, rebuilds and maintenance."
      />
    )}

    <script type="application/json" id="st-list-data" is:inline set:html={json(tasks)}></script>
    <script type="application/json" id="st-integrations" is:inline set:html={json(integrationInfo)}></script>
    <script type="application/json" id="st-can-manage" is:inline set:html={JSON.stringify(canManage)}></script>
  </div>
</AppLayout>

<script>
  import { getScheduledTaskRuns, listScheduledTaskOverview } from '@/lib/api/scheduledTaskOverview';
  import { mountOrganizedList } from '@/lib/organizedListView';
  import { createSdkClient } from '@/lib/sdk';
  import { historyHtml, type ScheduledTaskRow, scheduledTaskAdapter, scheduledTaskCardHtml } from '@/lib/scheduledTaskList';

  const sdk = createSdkClient();
  const read = (id: string) => JSON.parse(document.getElementById(id)?.textContent || 'null');
  const host = document.getElementById('st-list');

  if (host) {
    let tasks: ScheduledTaskRow[] = read('st-list-data') ?? [];
    const canManage = read('st-can-manage') === true;

    // The server decides what needs a look, so after a change the list is read again rather than patched.
    async function reload() {
      tasks = await listScheduledTaskOverview();
      list.refresh();
    }

    const list = mountOrganizedList<ScheduledTaskRow>({
      host,
      emptyFiltered: document.getElementById('st-empty')!,
      emptyAll: document.getElementById('st-none')!,
      search: document.getElementById('st-search') as HTMLInputElement | null,
      selects: {
        from: document.getElementById('st-f-from') as HTMLSelectElement | null,
        status: document.getElementById('st-f-status') as HTMLSelectElement | null,
        schedule: document.getElementById('st-f-schedule') as HTMLSelectElement | null,
      },
      items: () => tasks,
      adapter: scheduledTaskAdapter(),
      integrations: read('st-integrations') ?? {},
      noun: 'scheduled task',
      storageKey: 'marvin.automation.scheduled-tasks.filters',
      linkedId: new URLSearchParams(location.search).get('task'),
      renderItem: (task, { linked }) => scheduledTaskCardHtml(task, { canManage, linked }),
      removedDelete: { kind: 'scheduled-tasks', canDelete: canManage },
      afterRender: attachHandlers,
    });

    function attachHandlers(root: HTMLElement) {
      root.querySelectorAll<HTMLElement>('.st-card').forEach((card) => {
        const id = card.dataset.id!;
        const task = tasks.find((t) => t.id === id)!;

        card.querySelector('.js-toggle')?.addEventListener('click', async () => {
          try {
            await sdk.scheduledTasks.update(id, { enabled: !task.enabled });
            await reload();
          } catch {
            alert('Failed to update task');
          }
        });

        card.querySelector('.js-run')?.addEventListener('click', async (e) => {
          if (!confirm(`Run "${task.name}" now?`)) return;
          const btn = e.currentTarget as HTMLButtonElement;
          const label = btn.textContent;
          btn.disabled = true;
          try {
            await sdk.scheduledTasks.execute(id);
            btn.textContent = 'Started ✓';
            btn.title = 'Running in the background. Runs shows how it went.';
            setTimeout(() => { btn.disabled = false; btn.textContent = label; }, 4000);
          } catch {
            btn.disabled = false;
            alert('Failed to trigger task');
          }
        });

        card.querySelector('.js-edit')?.addEventListener('click', () => {
          location.href = `/workspace/scheduled-tasks/${id}`;
        });

        card.querySelector('.js-delete')?.addEventListener('click', async () => {
          if (!confirm(`Are you sure you want to delete "${task.name}"?`)) return;
          try {
            await sdk.scheduledTasks.delete(id);
            await reload();
          } catch {
            alert('Failed to delete task');
          }
        });

        card.querySelector('.js-history')?.addEventListener('click', async () => {
          const panel = card.querySelector<HTMLElement>('.st-history')!;
          if (!panel.hidden) {
            panel.hidden = true;
            return;
          }
          panel.hidden = false;
          panel.textContent = 'Loading…';
          try {
            panel.innerHTML = historyHtml(await getScheduledTaskRuns(id));
          } catch {
            panel.textContent = 'Could not load the runs.';
          }
        });
      });
    }

    list.refresh();
  }
</script>

<style is:global>
  .st-page .toolbar {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 24px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--line);
  }
  .st-page .toolbar-actions { display: flex; gap: 12px; align-items: center; }
  .st-page .toolbar h2 { margin: 0; font-size: 24px; font-weight: 600; }
  .st-page .toolbar p { margin: 8px 0 0; color: var(--muted); font-size: 14px; }
  .st-page .alert { padding: 16px; margin-bottom: 24px; border-radius: var(--radius); }
  .st-page .alert-error { background: var(--color-error-bg); color: var(--color-error); border: 1px solid var(--color-error); }

  .st-description { margin-top: 2px; font-size: 12px; color: var(--muted); }
  .st-attention { margin-top: 2px; font-size: 12px; color: var(--color-error); }
  .st-last { margin-top: 2px; font-size: 12px; color: var(--muted); }
  .st-last.failed { color: var(--color-error); font-weight: 600; }
  .st-card .st-history { margin-top: 10px; border-top: 1px solid var(--line); padding-top: 8px; display: flex; flex-direction: column; gap: 4px; font-size: 12px; color: var(--muted); }
  .st-card .st-history[hidden] { display: none; }
  .st-run.failed { color: var(--color-error); }
  .st-run-note { margin-top: 1px; overflow-wrap: anywhere; font-weight: 400; white-space: pre-wrap; }
</style>
