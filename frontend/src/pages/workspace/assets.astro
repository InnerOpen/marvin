---
import AssetList from "@/components/AssetList.astro";
import FilterSearch from "@/components/FilterSearch.astro";
import AppLayout from "@/layouts/AppLayout.astro";
import { listAssetTypes } from "@/lib/api/assets";
import { fetchApi, getAuthToken } from "@/lib/api/client";
import { listCollections } from "@/lib/api/collections";
import { getAssets } from "@/lib/api/platform";
import { listTags } from "@/lib/api/tags";
import { listTrashedAssets } from "@/lib/api/trash";
import { FULL_CONTENT_ACCESS, getContentAccess } from "@/lib/api/workspaces";
import { getMimeCategory } from "@/lib/assetCategory";
import { DECISIONS, isFiltered, isUnsearchableImage, listParams, ORIGINS, readLibraryView, SORTS, TYPES, viewHref } from "@/lib/assetLibraryView";
import { decisionOf } from "@/lib/assetLineage";
import { createSdkClient } from "@/lib/sdk";

const authToken = getAuthToken(Astro.cookies);
// Everyone reads; uploading is AUTHOR+, editing and deleting assets EDITOR+.
const access = authToken ? await getContentAccess(authToken) : FULL_CONTENT_ACCESS;
// The filters live in the URL (lib/assetLibraryView.ts): the API returns exactly the matching assets, with versions
// folded under their original unless shown.
const view = readLibraryView(Astro.url.searchParams);

let assets: any[] = [];
let trashedAssets: any[] = [];
let tags: any[] = [];
let collections: any[] = [];
let sourceAsset: any = null;
let error: string | null = null;

// Ask files (chat attachments) live apart from the library: a link to them, with their count.
let askFiles = 0;
let typesInUse: { type: string; count: number }[] = [];
try {
  const [library, asks, trashed, tagList, collectionList, types] = await Promise.all([
    view.status === "trashed" ? Promise.resolve([]) : getAssets(authToken, listParams(view)),
    fetchApi<unknown[]>("/api/platform/assets?scope=ask", {}, authToken).catch(() => []),
    listTrashedAssets(authToken).catch(() => []),
    listTags(authToken).catch(() => []),
    listCollections(authToken).catch(() => []),
    listAssetTypes(authToken).catch(() => []),
  ]);
  typesInUse = types;
  assets = library;
  askFiles = asks.length;
  trashedAssets = trashed;
  tags = tagList;
  collections = collectionList.filter((c: any) => (c.targetType ?? "entry") === "asset");
  if (view.source) sourceAsset = await createSdkClient(authToken).assets.get(view.source).catch(() => null);
} catch (e) {
  error = e instanceof Error ? e.message : String(e);
  console.error("[Assets] Failed to load:", error);
}
const listed = view.status === "trashed" ? trashedAssets : assets;
// "Not searchable yet": pictures search and the assistants can't find, having no alt text or description.
const rows = view.searchable === "no" ? listed.filter(isUnsearchableImage) : listed;
const unsearchable = view.status === "trashed" ? [] : assets.filter(isUnsearchableImage);

// The search bar (FilterSearch): the types in use as buttons (the chosen one too, if none are left), the other filters
// as rows. Each takes one value, the list API's shape.
const named = (rec: Record<string, string>) => Object.entries(rec).map(([value, label]) => ({ value, label }));
const pillTypes = Object.keys(TYPES).filter((t) => t === view.type || typesInUse.some((u) => u.type === t));
const pills = pillTypes.map((t) => ({ label: TYPES[t], href: viewHref(view, { type: view.type === t ? "" : t }), on: view.type === t }));
const rowFields: Record<string, { label: string; options: { value: string; label: string }[] }> = {
  origin: { label: "Origin", options: named(ORIGINS) },
  decision: { label: "Approval", options: named(DECISIONS) },
  ...(tags.length ? { tag: { label: "Tag", options: tags.map((t: any) => ({ value: t.slug, label: t.name })) } } : {}),
  ...(collections.length ? { collection: { label: "Collection", options: collections.map((c: any) => ({ value: c.slug, label: c.name })) } } : {}),
  attached: { label: "Used on an entry", options: [{ value: "yes", label: "Yes" }, { value: "no", label: "No" }] },
  searchable: { label: "Searchable", options: [{ value: "no", label: "No (no alt text or description)" }] },
};
const rowValues = Object.keys(rowFields).filter((k) => (view as any)[k]).map((k) => ({ field: k, value: (view as any)[k] as string }));
const optionsOpen = rowValues.length > 0 || view.versions || Boolean(view.status) || view.sort !== "name";
---

<AppLayout title="Assets">
  {error ? (
    <div class="error-banner">
      <p><strong>Error loading assets:</strong> {error}</p>
      <button onclick="location.reload()" class="button secondary">Retry</button>
    </div>
  ) : (
    <>
      <div class="toolbar">
        <div>
          <h2>{view.source ? `Versions of ${sourceAsset?.name ?? "an asset"}` : view.status === "trashed" ? "Assets in the Trash" : "Media library"}</h2>
          <p style="margin:4px 0 0;color:var(--muted);">
            {view.source ? (
              <>Made from it by workflows and the media pipeline · <a href={viewHref(view, { source: "" })}>Back to the library</a></>
            ) : (
              <>{rows.length} {rows.length === 1 ? "asset" : "assets"}{!view.versions && view.status !== "trashed" ? " (versions folded under their original)" : ""}.</>
            )}
          </p>
        </div>
        <div style="display:flex;gap:0.75rem;">
          <a class="button secondary" href="/workspace/assets/ask-files" title="Files attached to chat questions, kept out of the library">Ask files{askFiles ? ` (${askFiles})` : ""}</a>
          {access.canAuthor && <a class="button" href="/workspace/assets/new">Upload Asset</a>}
        </div>
      </div>

      <FilterSearch
        path="/workspace/assets"
        q={view.q}
        placeholder="Search names…"
        pills={pills}
        fields={rowFields}
        rows={rowValues}
        open={optionsOpen}
        filtered={isFiltered(view) || view.versions || Boolean(view.status) || view.sort !== "name"}
      >
        <Fragment slot="extras">
          <label>Sort
            <select name="sort" data-default="name">
              {Object.entries(SORTS).map(([v, l]) => <option value={v} selected={view.sort === v}>{l}</option>)}
            </select>
          </label>
          <label><input type="checkbox" name="versions" value="show" checked={view.versions} /> Show versions</label>
          {(trashedAssets.length > 0 || view.status === "trashed") && (
            <label><input type="checkbox" name="status" value="trashed" checked={view.status === "trashed"} /> The Trash ({trashedAssets.length})</label>
          )}
        </Fragment>
      </FilterSearch>

      {rows.length === 0 && (isFiltered(view) || view.status) ? (
        <div class="empty-state">
          <h3>Nothing matches</h3>
          <p><a href="/workspace/assets">Clear the filters</a></p>
        </div>
      ) : assets.length === 0 && trashedAssets.length === 0 ? (
        <div class="empty-state">
          <div class="empty-icon">🖼️</div>
          <h3>No assets yet</h3>
          <p>Assets are images, videos, documents, and files that you can reference in your entries.</p>
          {access.canAuthor && <a href="/workspace/assets/new" class="button">Upload Your First Asset</a>}
        </div>
      ) : (
        <>
          {unsearchable.length > 0 && view.searchable !== "no" && (
            <p class="search-nudge">
              {unsearchable.length === 1 ? "1 picture has" : `${unsearchable.length} pictures have`} no alt text or description, so search and
              the assistants can't find {unsearchable.length === 1 ? "it" : "them"}. <a href={viewHref(view, { searchable: "no" })}>Show {unsearchable.length === 1 ? "it" : "them"}</a>
            </p>
          )}
          {view.searchable === "no" && rows.length > 0 && access.canEdit && (
            <div class="search-nudge">
              <p>
                Give each a description so it can be found: open one and type it, or let AI look at {rows.length === 1 ? "it" : "them"} and
                write one ({rows.length === 1 ? "one AI call" : `one AI call each, ${rows.length} in all`}). The text is saved straight away; edit it any time.
              </p>
              <button type="button" class="button" id="describe-all" data-ids={rows.map((a: any) => a.id).join(",")}>
                ✨ Describe and save {rows.length === 1 ? "it" : `these ${rows.length}`} with AI
              </button>
              <p id="describe-status" class="describe-status" aria-live="polite"></p>
            </div>
          )}
          <div class="view-toggle">
            <button class="toggle-btn active" id="view-grid" title="Thumbnails">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><rect x="1" y="1" width="6" height="6" rx="1"/><rect x="9" y="1" width="6" height="6" rx="1"/><rect x="1" y="9" width="6" height="6" rx="1"/><rect x="9" y="9" width="6" height="6" rx="1"/></svg>
              Cards
            </button>
            <button class="toggle-btn" id="view-table" title="A row each, with the details">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><rect x="1" y="2" width="14" height="2.5" rx="1"/><rect x="1" y="6.75" width="14" height="2.5" rx="1"/><rect x="1" y="11.5" width="14" height="2.5" rx="1"/></svg>
              List
            </button>
          </div>

          <div id="table-view" class="view-section" style="display:none;">
            <AssetList assets={rows} inTrash={view.status === "trashed"} canEdit={access.canEdit} versionsHref={(asset) => viewHref(view, { source: asset.id, versions: false })} />
          </div>

          <div id="grid-view" class="view-section">
            <ul class="asset-grid">
              {rows.map((asset: any) => (
                <li class="asset-card" data-href={view.status === "trashed" ? `/workspace/assets/${asset.id}` : `/workspace/assets/${asset.id}/view`} data-in-trash={view.status === "trashed" ? "" : undefined}>
                  <a class="thumb" href={view.status === "trashed" ? `/workspace/assets/${asset.id}` : `/workspace/assets/${asset.id}/view`} title={asset.name}>
                    {asset.publicUrl && getMimeCategory(asset.mimeType) === "image" ? (
                      <img src={asset.publicUrl} alt={asset.altText ?? asset.name} loading="lazy" style={`object-position: ${asset.focalPoint ?? "50% 50%"}`} />
                    ) : (
                      <span class="file-icon">📎</span>
                    )}
                  </a>
                  <a class="card-name" href={view.status === "trashed" ? `/workspace/assets/${asset.id}` : `/workspace/assets/${asset.id}/view`} title={asset.name}>{asset.name}</a>
                  <div class="card-meta">
                    {isUnsearchableImage(asset)
                      ? <span class="search-dot unsearchable" title="Not searchable: no alt text or description"></span>
                      : <span class="search-dot" title="Searchable"></span>}
                    {asset.width && asset.height ? `${asset.width}×${asset.height}` : asset.mimeType}
                    {asset.origin === "derived" && <span class="card-badge">Version</span>}
                    {asset.origin === "generated" && <span class="card-badge">Generated</span>}
                    {decisionOf(asset.metadataJson) && <span class={`card-badge decision-${decisionOf(asset.metadataJson)!.decision}`}>{decisionOf(asset.metadataJson)!.label}</span>}
                    {asset.versionsCount > 0 && (
                      <a class="card-badge versions" href={viewHref(view, { source: asset.id, versions: false })}>{asset.versionsCount} {asset.versionsCount === 1 ? "version" : "versions"}</a>
                    )}
                  </div>
                </li>
              ))}
            </ul>
          </div>

        </>
      )}
    </>
  )}
</AppLayout>

<script>
  import { createSdkClient } from '@/lib/sdk';

  // "Describe and save these with AI": one generate-alt-text call per picture, one after another, each saved as it
  // comes back (the person clicked, so this is their save), then the list reloads without the described ones.
  const describeAll = document.getElementById('describe-all') as HTMLButtonElement | null;
  const describeStatus = document.getElementById('describe-status');
  describeAll?.addEventListener('click', async () => {
    const ids = (describeAll.dataset.ids ?? '').split(',').filter(Boolean);
    const sdk = createSdkClient();
    describeAll.disabled = true;
    let done = 0;
    const failed: string[] = [];
    for (const id of ids) {
      if (describeStatus) describeStatus.textContent = `Describing ${done + failed.length + 1} of ${ids.length}…`;
      try {
        const exec: any = await sdk.ai.operations.execute('generate-alt-text', { entityType: 'asset', entityId: id });
        const out = exec?.outputJson ?? exec?.output_json ?? {};
        const altText = out.alt_text ?? out.altText;
        if (!altText) throw new Error('no description came back');
        await sdk.assets.update(id, { altText, description: out.description ?? null } as any);
        done += 1;
      } catch (e: any) {
        failed.push(e?.message || e?.detail || 'failed');
      }
    }
    if (describeStatus) {
      describeStatus.textContent = failed.length
        ? `Described ${done} of ${ids.length}. ${failed.length} failed: ${failed[0]}`
        : `Described all ${done}. Reloading…`;
    }
    if (!failed.length) setTimeout(() => window.location.reload(), 800);
    else describeAll.disabled = false;
  });

  // Cards or List; the choice is remembered (the old "table" choice is List now).
  type View = 'grid' | 'table';
  const views: Record<View, { el: HTMLElement | null; btn: HTMLElement | null }> = {
    grid: { el: document.getElementById('grid-view'), btn: document.getElementById('view-grid') },
    table: { el: document.getElementById('table-view'), btn: document.getElementById('view-table') },
  };
  function setView(view: View) {
    for (const [name, v] of Object.entries(views) as [View, (typeof views)[View]][]) {
      if (v.el) v.el.style.display = name === view ? '' : 'none';
      v.btn?.classList.toggle('active', name === view);
    }
    try { localStorage.setItem('assets-view', view); } catch { /* a private window: the choice just isn't kept */ }
  }
  for (const [name, v] of Object.entries(views) as [View, (typeof views)[View]][]) v.btn?.addEventListener('click', () => setView(name));
  let savedView: string | null = null;
  try { savedView = localStorage.getItem('assets-view'); } catch { /* as above */ }
  if (savedView === 'table' || savedView === 'grid') setView(savedView);

  // A card opens its asset wherever it's tapped. Links, buttons and form controls inside keep their own meaning.
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target.closest('a, button, form, input, select, label, summary')) return;
    const holder = target.closest<HTMLElement>('.asset-card[data-href]');
    if (holder?.dataset.href) window.location.href = holder.dataset.href;
  });
</script>

<style>
  .asset-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .asset-card[data-href] { cursor: pointer; }
  .asset-card {
    min-width: 0;
  }
  .asset-card .thumb {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 8px;
    border: 1px solid var(--line);
    background: var(--panel, var(--bg));
  }
  .asset-card[data-in-trash] .thumb {
    opacity: 0.5;
  }
  .asset-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .asset-card .file-icon {
    font-size: 2rem;
  }
  .card-name {
    margin-top: 0.35rem;
    font-size: 0.875rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    display: block;
    color: inherit;
    text-decoration: none;
  }
  .card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    align-items: center;
    color: var(--muted);
    font-size: 0.75rem;
  }
  .card-badge {
    padding: 0 0.35rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    text-decoration: none;
  }
  .card-badge.versions {
    color: var(--accent, inherit);
  }
  .card-badge.decision-denied {
    color: var(--color-error);
    border-color: var(--color-error);
  }
  .card-badge.decision-approved {
    color: var(--color-success, var(--accent));
  }

  .error-banner {
    padding: 1.5rem;
    background: var(--color-error-bg);
    border: 1px solid var(--color-error);
    border-radius: var(--radius);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .error-banner p {
    margin: 0;
    color: var(--color-error);
  }


  .empty-icon {
    font-size: 4rem;
    margin-bottom: 1rem;
    opacity: 0.5;
  }

  .empty-state h3 {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 600;
  }

  .empty-state p {
    margin: 0;
    color: var(--muted);
    max-width: 32rem;
  }

  .view-toggle {
    display: flex;
    gap: 2px;
    background: var(--panel-2);
    border-radius: 6px;
    padding: 2px;
    width: fit-content;
    margin-bottom: 1.5rem;
  }

  .toggle-btn {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.75rem;
    border: none;
    border-radius: 4px;
    background: transparent;
    color: var(--muted);
    font-size: 0.8125rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.15s;
  }

  .toggle-btn:hover {
    color: var(--ink);
  }

  .toggle-btn.active {
    background: var(--panel);
    color: var(--ink);
    box-shadow: 0 1px 2px rgba(0,0,0,0.06);
  }

  .search-nudge { margin: 0 0 16px; padding: 12px 14px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--panel); font-size: 14px; }
  .search-nudge p { margin: 0 0 10px; }
  .search-nudge p:last-child { margin-bottom: 0; }
  .describe-status { color: var(--muted); font-size: 13px; }
  .search-dot { width: 8px; height: 8px; border-radius: 50%; background: #16a34a; }
  .search-dot.unsearchable { background: #d97706; }
</style>
