---
import AssetRow from "@/components/AssetRow.astro";
import AppLayout from "@/layouts/AppLayout.astro";
import { fetchApi, getAuthToken } from "@/lib/api/client";
import { listCollections } from "@/lib/api/collections";
import { getAssets } from "@/lib/api/platform";
import { listTags } from "@/lib/api/tags";
import { listTrashedAssets } from "@/lib/api/trash";
import { FULL_CONTENT_ACCESS, getContentAccess } from "@/lib/api/workspaces";
import { getMimeCategory } from "@/lib/assetCategory";
import { DECISIONS, isFiltered, isUnsearchableImage, listParams, ORIGINS, readLibraryView, SORTS, TYPES, viewHref } from "@/lib/assetLibraryView";
import { decisionOf } from "@/lib/assetLineage";
import { createSdkClient } from "@/lib/sdk";

const authToken = getAuthToken(Astro.cookies);
// Everyone reads; uploading is AUTHOR+, editing and deleting assets EDITOR+.
const access = authToken ? await getContentAccess(authToken) : FULL_CONTENT_ACCESS;
// The filters live in the URL (lib/assetLibraryView.ts): the API returns exactly the matching assets, with versions
// folded under their original unless shown.
const view = readLibraryView(Astro.url.searchParams);

let assets: any[] = [];
let trashedAssets: any[] = [];
let tags: any[] = [];
let collections: any[] = [];
let sourceAsset: any = null;
let error: string | null = null;

// Ask files (chat attachments) live apart from the library: a link to them, with their count.
let askFiles = 0;
try {
  const [library, asks, trashed, tagList, collectionList] = await Promise.all([
    view.status === "trashed" ? Promise.resolve([]) : getAssets(authToken, listParams(view)),
    fetchApi<unknown[]>("/api/platform/assets?scope=ask", {}, authToken).catch(() => []),
    listTrashedAssets(authToken).catch(() => []),
    listTags(authToken).catch(() => []),
    listCollections(authToken).catch(() => []),
  ]);
  assets = library;
  askFiles = asks.length;
  trashedAssets = trashed;
  tags = tagList;
  collections = collectionList.filter((c: any) => (c.targetType ?? "entry") === "asset");
  if (view.source) sourceAsset = await createSdkClient(authToken).assets.get(view.source).catch(() => null);
} catch (e) {
  error = e instanceof Error ? e.message : String(e);
  console.error("[Assets] Failed to load:", error);
}
const listed = view.status === "trashed" ? trashedAssets : assets;
// "Not searchable yet": pictures search and the assistants can't find, having no alt text or description.
const rows = view.searchable === "no" ? listed.filter(isUnsearchableImage) : listed;
const unsearchable = view.status === "trashed" ? [] : assets.filter(isUnsearchableImage);

// Group assets by MIME category
const categoryLabels: Record<string, string> = {
  image: "Images",
  video: "Videos",
  audio: "Audio",
  document: "Documents",
  other: "Other",
};
const categoryGroups = new Map<string, { label: string; assets: any[] }>();
for (const asset of rows) {
  const cat = getMimeCategory(asset.mimeType);
  if (!categoryGroups.has(cat)) {
    categoryGroups.set(cat, { label: categoryLabels[cat] || cat, assets: [] });
  }
  categoryGroups.get(cat)!.assets.push(asset);
}
const categoryOrder = ["image", "video", "audio", "document", "other"];
const sortedCategoryGroups = categoryOrder
  .filter((cat) => categoryGroups.has(cat))
  .map((cat) => ({ key: cat, ...categoryGroups.get(cat)! }));
const opt = (value: string, label: string, current: string) => ({ value, label, selected: value === current });
---

<AppLayout title="Assets">
  {error ? (
    <div class="error-banner">
      <p><strong>Error loading assets:</strong> {error}</p>
      <button onclick="location.reload()" class="button secondary">Retry</button>
    </div>
  ) : (
    <>
      <div class="toolbar">
        <div>
          <h2 style="margin:0;font-size:20px;">{view.source ? `Versions of ${sourceAsset?.name ?? "an asset"}` : view.status === "trashed" ? "Assets in the Trash" : "Media library"}</h2>
          <p style="margin:4px 0 0;color:var(--muted);">
            {view.source ? (
              <>Made from it by workflows and the media pipeline · <a href={viewHref(view, { source: "" })}>Back to the library</a></>
            ) : (
              <>{rows.length} {rows.length === 1 ? "asset" : "assets"}{!view.versions && view.status !== "trashed" ? " (versions folded under their original)" : ""}.</>
            )}
          </p>
        </div>
        <div style="display:flex;gap:0.75rem;">
          <a class="button secondary" href="/workspace/assets/ask-files" title="Files attached to chat questions, kept out of the library">Ask files{askFiles ? ` (${askFiles})` : ""}</a>
          {access.canAuthor && <a class="button" href="/workspace/assets/new">Upload Asset</a>}
        </div>
      </div>

      <form method="get" class="asset-filters" id="asset-filters">
        <input type="search" name="q" class="filter-search" placeholder="Search name or filename…" value={view.q} />
        <select name="type" class="filter-select" aria-label="Type">
          <option value="">All types</option>
          {Object.entries(TYPES).map(([v, l]) => <option value={v} selected={view.type === v}>{l}</option>)}
        </select>
        <select name="origin" class="filter-select" aria-label="Where it came from">
          <option value="">Any origin</option>
          {Object.entries(ORIGINS).map(([v, l]) => <option value={v} selected={view.origin === v}>{l}</option>)}
        </select>
        <select name="decision" class="filter-select" aria-label="What an approval said about it">
          <option value="">Any decision</option>
          {Object.entries(DECISIONS).map(([v, l]) => <option value={v} selected={view.decision === v}>{l}</option>)}
        </select>
        {tags.length > 0 && (
          <select name="tag" class="filter-select" aria-label="Tag">
            <option value="">Any tag</option>
            {tags.map((t: any) => <option value={t.slug} selected={view.tag === t.slug}>{t.name}</option>)}
          </select>
        )}
        {collections.length > 0 && (
          <select name="collection" class="filter-select" aria-label="Collection">
            <option value="">Any collection</option>
            {collections.map((c: any) => <option value={c.slug} selected={view.collection === c.slug}>{c.name}</option>)}
          </select>
        )}
        <select name="attached" class="filter-select" aria-label="Used on an entry">
          {[opt("", "On entries or not", view.attached), opt("yes", "Used on an entry", view.attached), opt("no", "Not on any entry", view.attached)].map((o) => (
            <option value={o.value} selected={o.selected}>{o.label}</option>
          ))}
        </select>
        <select name="searchable" class="filter-select" aria-label="Searchable">
          {[opt("", "Searchable or not", view.searchable), opt("no", "Not searchable yet", view.searchable)].map((o) => (
            <option value={o.value} selected={o.selected}>{o.label}</option>
          ))}
        </select>
        <select name="sort" class="filter-select" aria-label="Sort">
          {Object.entries(SORTS).map(([v, l]) => <option value={v} selected={view.sort === v}>{l}</option>)}
        </select>
        <label class="filter-check"><input type="checkbox" name="versions" value="show" checked={view.versions} /> Show versions</label>
        {trashedAssets.length > 0 && (
          <label class="filter-check"><input type="checkbox" name="status" value="trashed" checked={view.status === "trashed"} /> The Trash ({trashedAssets.length})</label>
        )}
        {view.source && <input type="hidden" name="source" value={view.source} />}
        {(isFiltered(view) || view.versions || view.status || view.sort !== "name") && <a class="filter-reset" href="/workspace/assets">Clear</a>}
      </form>

      {rows.length === 0 && (isFiltered(view) || view.status) ? (
        <div class="empty-state">
          <h3>Nothing matches</h3>
          <p><a href="/workspace/assets">Clear the filters</a></p>
        </div>
      ) : assets.length === 0 && trashedAssets.length === 0 ? (
        <div class="empty-state">
          <div class="empty-icon">🖼️</div>
          <h3>No assets yet</h3>
          <p>Assets are images, videos, documents, and files that you can reference in your entries.</p>
          {access.canAuthor && <a href="/workspace/assets/new" class="button">Upload Your First Asset</a>}
        </div>
      ) : (
        <>
          {unsearchable.length > 0 && view.searchable !== "no" && (
            <p class="search-nudge">
              {unsearchable.length === 1 ? "1 picture has" : `${unsearchable.length} pictures have`} no alt text or description, so search and
              the assistants can't find {unsearchable.length === 1 ? "it" : "them"}. <a href={viewHref(view, { searchable: "no" })}>Show {unsearchable.length === 1 ? "it" : "them"}</a>
            </p>
          )}
          {view.searchable === "no" && rows.length > 0 && access.canEdit && (
            <div class="search-nudge">
              <p>
                Give each a description so it can be found: open one and type it, or let AI look at {rows.length === 1 ? "it" : "them"} and
                write one ({rows.length === 1 ? "one AI call" : `one AI call each, ${rows.length} in all`}). The text is saved straight away; edit it any time.
              </p>
              <button type="button" class="button" id="describe-all" data-ids={rows.map((a: any) => a.id).join(",")}>
                ✨ Describe and save {rows.length === 1 ? "it" : `these ${rows.length}`} with AI
              </button>
              <p id="describe-status" class="describe-status" aria-live="polite"></p>
            </div>
          )}
          <div class="view-toggle">
            <button class="toggle-btn active" id="view-table" title="All assets">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><rect x="1" y="1" width="6" height="6" rx="1"/><rect x="9" y="1" width="6" height="6" rx="1"/><rect x="1" y="9" width="6" height="6" rx="1"/><rect x="9" y="9" width="6" height="6" rx="1"/></svg>
              All
            </button>
            <button class="toggle-btn" id="view-grid" title="Thumbnails">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><rect x="1" y="1" width="4" height="4" rx="1"/><rect x="6" y="1" width="4" height="4" rx="1"/><rect x="11" y="1" width="4" height="4" rx="1"/><rect x="1" y="6" width="4" height="4" rx="1"/><rect x="6" y="6" width="4" height="4" rx="1"/><rect x="11" y="6" width="4" height="4" rx="1"/><rect x="1" y="11" width="4" height="4" rx="1"/><rect x="6" y="11" width="4" height="4" rx="1"/><rect x="11" y="11" width="4" height="4" rx="1"/></svg>
              Grid
            </button>
            <button class="toggle-btn" id="view-grouped" title="Group by type">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><rect x="1" y="1" width="14" height="3" rx="1"/><rect x="3" y="5.5" width="12" height="2" rx="0.5" opacity="0.6"/><rect x="3" y="8.5" width="12" height="2" rx="0.5" opacity="0.6"/><rect x="1" y="12" width="14" height="3" rx="1"/></svg>
              Types
            </button>
          </div>

          <div id="table-view" class="view-section">
            <table class="table stacks">
              <thead>
                <tr>
                  <th>Preview</th>
                  <th>Name</th>
                  <th>Type</th>
                  <th>Dimensions</th>
                  <th>Size</th>
                  <th>Alt Text</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                {rows.map((asset: any) => (
                  <AssetRow asset={asset} canEdit={access.canEdit} inTrash={view.status === "trashed"} versionsHref={viewHref(view, { source: asset.id, versions: false })} />
                ))}
              </tbody>
            </table>
          </div>

          <div id="grid-view" class="view-section" style="display:none;">
            <ul class="asset-grid">
              {rows.map((asset: any) => (
                <li class="asset-card" data-href={view.status === "trashed" ? `/workspace/assets/${asset.id}` : `/workspace/assets/${asset.id}/view`} data-in-trash={view.status === "trashed" ? "" : undefined}>
                  <a class="thumb" href={view.status === "trashed" ? `/workspace/assets/${asset.id}` : `/workspace/assets/${asset.id}/view`} title={asset.name}>
                    {asset.publicUrl && getMimeCategory(asset.mimeType) === "image" ? (
                      <img src={asset.publicUrl} alt={asset.altText ?? asset.name} loading="lazy" style={`object-position: ${asset.focalPoint ?? "50% 50%"}`} />
                    ) : (
                      <span class="file-icon">📎</span>
                    )}
                  </a>
                  <a class="card-name" href={view.status === "trashed" ? `/workspace/assets/${asset.id}` : `/workspace/assets/${asset.id}/view`} title={asset.name}>{asset.name}</a>
                  <div class="card-meta">
                    {asset.width && asset.height ? `${asset.width}×${asset.height}` : asset.mimeType}
                    {asset.origin === "derived" && <span class="card-badge">Version</span>}
                    {asset.origin === "generated" && <span class="card-badge">Generated</span>}
                    {isUnsearchableImage(asset) && <span class="card-badge unsearchable" title="No alt text or description: search can't find it">Not searchable</span>}
                    {decisionOf(asset.metadataJson) && <span class={`card-badge decision-${decisionOf(asset.metadataJson)!.decision}`}>{decisionOf(asset.metadataJson)!.label}</span>}
                    {asset.versionsCount > 0 && (
                      <a class="card-badge versions" href={viewHref(view, { source: asset.id, versions: false })}>{asset.versionsCount} {asset.versionsCount === 1 ? "version" : "versions"}</a>
                    )}
                  </div>
                </li>
              ))}
            </ul>
          </div>

          <div id="grouped-view" class="view-section" style="display:none;">
            {sortedCategoryGroups.map(({ key, label, assets: groupAssets }) => (
              <details class="collection-group" data-group-type={key}>
                <summary class="collection-header">
                  <h3 class="collection-title">
                    <span class="collapse-chevron"></span>
                    {label}
                    <span class="collection-count">{groupAssets.length}</span>
                  </h3>
                </summary>
                <table class="table stacks">
                  <thead>
                    <tr>
                      <th>Preview</th>
                      <th>Name</th>
                      <th>Type</th>
                      <th>Dimensions</th>
                      <th>Size</th>
                      <th>Alt Text</th>
                      <th>Actions</th>
                    </tr>
                  </thead>
                  <tbody>
                    {groupAssets.map((asset: any) => (
                      <AssetRow asset={asset} canEdit={access.canEdit} inTrash={view.status === "trashed"} versionsHref={viewHref(view, { source: asset.id, versions: false })} />
                    ))}
                  </tbody>
                </table>
              </details>
            ))}
          </div>
        </>
      )}
    </>
  )}
</AppLayout>

<script>
  import { createSdkClient } from '@/lib/sdk';

  // "Describe and save these with AI": one generate-alt-text call per picture, one after another, each saved as it
  // comes back (the person clicked, so this is their save), then the list reloads without the described ones.
  const describeAll = document.getElementById('describe-all') as HTMLButtonElement | null;
  const describeStatus = document.getElementById('describe-status');
  describeAll?.addEventListener('click', async () => {
    const ids = (describeAll.dataset.ids ?? '').split(',').filter(Boolean);
    const sdk = createSdkClient();
    describeAll.disabled = true;
    let done = 0;
    const failed: string[] = [];
    for (const id of ids) {
      if (describeStatus) describeStatus.textContent = `Describing ${done + failed.length + 1} of ${ids.length}…`;
      try {
        const exec: any = await sdk.ai.operations.execute('generate-alt-text', { entityType: 'asset', entityId: id });
        const out = exec?.outputJson ?? exec?.output_json ?? {};
        const altText = out.alt_text ?? out.altText;
        if (!altText) throw new Error('no description came back');
        await sdk.assets.update(id, { altText, description: out.description ?? null } as any);
        done += 1;
      } catch (e: any) {
        failed.push(e?.message || e?.detail || 'failed');
      }
    }
    if (describeStatus) {
      describeStatus.textContent = failed.length
        ? `Described ${done} of ${ids.length}. ${failed.length} failed: ${failed[0]}`
        : `Described all ${done}. Reloading…`;
    }
    if (!failed.length) setTimeout(() => window.location.reload(), 800);
    else describeAll.disabled = false;
  });

  const tableView = document.getElementById('table-view');
  const groupedView = document.getElementById('grouped-view');
  const gridView = document.getElementById('grid-view');
  const viewGridBtn = document.getElementById('view-grid');
  const viewTableBtn = document.getElementById('view-table');
  const viewGroupedBtn = document.getElementById('view-grouped');

  type View = 'table' | 'grid' | 'grouped';
  function setView(view: View) {
    if (!tableView || !groupedView || !gridView) return;
    tableView.style.display = view === 'table' ? '' : 'none';
    gridView.style.display = view === 'grid' ? '' : 'none';
    groupedView.style.display = view === 'grouped' ? '' : 'none';
    viewTableBtn?.classList.toggle('active', view === 'table');
    viewGridBtn?.classList.toggle('active', view === 'grid');
    viewGroupedBtn?.classList.toggle('active', view === 'grouped');
    try { localStorage.setItem('assets-view', view); } catch { /* a private window: the choice just isn't kept */ }
  }

  viewTableBtn?.addEventListener('click', () => setView('table'));
  viewGroupedBtn?.addEventListener('click', () => setView('grouped'));
  viewGridBtn?.addEventListener('click', () => setView('grid'));

  let savedView: string | null = null;
  try { savedView = localStorage.getItem('assets-view'); } catch { /* as above */ }
  if (savedView === 'table' || savedView === 'grid' || savedView === 'grouped') setView(savedView);

  // A row or a card opens its asset wherever it's tapped — on a phone the table's Actions column (View / Edit) sits
  // off-screen to the right, so the row itself is the way in, as it is for entries. Links, buttons and form controls
  // inside keep their own meaning.
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target.closest('a, button, form, input, select, label, summary')) return;
    const holder = target.closest<HTMLElement>('.asset-row[data-href], .asset-card[data-href]');
    if (holder?.dataset.href) window.location.href = holder.dataset.href;
  });

  // The filters are a GET form: a choice reloads the list from the server (search on Enter).
  const filters = document.getElementById('asset-filters') as HTMLFormElement | null;
  filters?.querySelectorAll('select, input[type="checkbox"]').forEach((el) => el.addEventListener('change', () => filters.requestSubmit()));
</script>

<style>
  .asset-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .asset-card[data-href] { cursor: pointer; }
  .asset-card {
    min-width: 0;
  }
  .asset-card .thumb {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 8px;
    border: 1px solid var(--line);
    background: var(--panel, var(--bg));
  }
  .asset-card[data-in-trash] .thumb {
    opacity: 0.5;
  }
  .asset-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .asset-card .file-icon {
    font-size: 2rem;
  }
  .card-name {
    margin-top: 0.35rem;
    font-size: 0.875rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    display: block;
    color: inherit;
    text-decoration: none;
  }
  .card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    align-items: center;
    color: var(--muted);
    font-size: 0.75rem;
  }
  .card-badge {
    padding: 0 0.35rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    text-decoration: none;
  }
  .card-badge.versions {
    color: var(--accent, inherit);
  }
  .card-badge.decision-denied {
    color: var(--color-error);
    border-color: var(--color-error);
  }
  .card-badge.decision-approved {
    color: var(--color-success, var(--accent));
  }

  .asset-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    align-items: center;
    margin: 0 0 1rem;
  }
  .filter-search {
    min-width: 220px;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--bg);
    color: var(--text);
  }
  .filter-select {
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--bg);
    color: var(--text);
  }
  .filter-check {
    display: inline-flex;
    gap: 0.35rem;
    align-items: center;
    color: var(--muted);
    font-size: 0.875rem;
  }
  .filter-reset {
    font-size: 0.875rem;
  }

  .error-banner {
    padding: 1.5rem;
    background: var(--color-error-bg);
    border: 1px solid var(--color-error);
    border-radius: var(--radius);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .error-banner p {
    margin: 0;
    color: var(--color-error);
  }

  .empty-state {
    display: grid;
    place-items: center;
    gap: 1rem;
    padding: 4rem 2rem;
    text-align: center;
  }

  .empty-icon {
    font-size: 4rem;
    margin-bottom: 1rem;
    opacity: 0.5;
  }

  .empty-state h3 {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 600;
  }

  .empty-state p {
    margin: 0;
    color: var(--muted);
    max-width: 32rem;
  }

  .view-toggle {
    display: flex;
    gap: 2px;
    background: var(--panel-2);
    border-radius: 6px;
    padding: 2px;
    width: fit-content;
    margin-bottom: 1.5rem;
  }

  .toggle-btn {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.75rem;
    border: none;
    border-radius: 4px;
    background: transparent;
    color: var(--muted);
    font-size: 0.8125rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.15s;
  }

  .toggle-btn:hover {
    color: var(--ink);
  }

  .toggle-btn.active {
    background: var(--panel);
    color: var(--ink);
    box-shadow: 0 1px 2px rgba(0,0,0,0.06);
  }

  .collection-group {
    margin-bottom: 1.5rem;
  }

  .collection-group > .table {
    margin-top: 1rem;
  }

  .collection-header {
    padding: 0.625rem 0.75rem;
    border-bottom: 1px solid var(--line);
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .collection-header::-webkit-details-marker {
    display: none;
  }

  .collection-header:hover {
    background: var(--panel-2);
    border-radius: 6px;
  }

  .collection-title {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .collapse-chevron {
    display: inline-block;
    width: 16px;
    height: 16px;
    transition: transform 0.15s;
  }

  .collapse-chevron::before {
    content: '';
    display: block;
    width: 6px;
    height: 6px;
    border-right: 2px solid var(--muted);
    border-bottom: 2px solid var(--muted);
    transform: rotate(-45deg) translate(1px, -1px);
    margin: 4px auto;
  }

  details[open] > .collection-header .collapse-chevron {
    transform: rotate(90deg);
  }

  .collection-count {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--muted);
