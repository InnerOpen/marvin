---
// Social inbox: the comments, replies and mentions the Social engagement task kept (30 days) across every connected network,
// what was replied (rehearsal or sent), and what to do with each: reply (private by default), like, hide, delete, message the
// author, make an auto-reply rule from it, open it on its network. Editors read, like and hide; admins reply, delete and message
// (the API's `can` says which). A row is compact on every screen; tapping it opens the item with its actions.
// Backend: routes/groups/social_inbox_controller.py. Pure logic: lib/socialInbox.ts (socialInbox.test.mjs).
import AppLayout from "@/layouts/AppLayout.astro";
import { getAuthToken } from "@/lib/api/client";
import { getSummary, type InboxList, listItems } from "@/lib/api/socialInbox";
import { emptyNotice, engineNote, hasFilters, type InboxSummary, integrationOptions, KINDS, parseFilters, STATUSES } from "@/lib/socialInbox";
import { isForbidden } from "@/lib/workspaceRole";

const authToken = getAuthToken(Astro.cookies);
const filters = parseFilters(Astro.url.searchParams);
let summary: InboxSummary | null = null;
let list: InboxList | null = null;
let error: string | null = null;
let restricted = false;
try {
  [summary, list] = await Promise.all([getSummary(authToken), listItems(filters, 0, authToken)]);
} catch (e) {
  if (isForbidden(e)) restricted = true;
  else error = e instanceof Error ? e.message : String(e);
}
const options = summary ? integrationOptions(summary.integrations) : [];
const note = engineNote(summary?.engine);
const empty = emptyNotice(summary, hasFilters(filters));
const data = JSON.stringify({ summary, list, filters }).replace(/</g, "\\u003c");
---

<AppLayout crumb="workspace.social" restrictedNote={restricted ? "The Social inbox is for editors and above." : null}>
  <div class="social-page">
    <script type="application/json" id="si-data" is:inline set:html={data}></script>
    <div class="toolbar">
      <div>
        <h2>Social inbox</h2>
        <p class="si-lede">
          Recent comments, replies and mentions from your connected networks, and what was answered. It fills from the
          {" "}<a href="/workspace/settings/integrations#social-engagement">Social engagement</a> task, which checks every 5 minutes and keeps 30 days.
        </p>
      </div>
      <button type="button" class="button secondary" id="si-mark-all" hidden>Mark all seen</button>
    </div>

    {error && <div class="si-alert">Could not load the inbox: {error}</div>}

    {note && (
      <div class="si-notice" id="si-note">
        <strong>{note.title}.</strong> {note.body}
        {note.link && <> <a href={note.link.href}>{note.link.label}</a></>}
      </div>
    )}

    {!error && (
      <form class="si-filters" id="si-filters" method="get" action="/workspace/social" role="search">
        <label>Network
          <select class="input" name="integration">
            <option value="">All networks</option>
            {options.map((o) => <option value={o.value} selected={o.value === filters.integration}>{o.label}</option>)}
          </select>
        </label>
        <label>Kind
          <select class="input" name="kind">
            <option value="">All kinds</option>
            {KINDS.map((k) => <option value={k.value} selected={k.value === filters.kind}>{k.label}</option>)}
          </select>
        </label>
        <label>Status
          <select class="input" name="status">
            <option value="">Any status</option>
            {STATUSES.map((s) => <option value={s.value} selected={s.value === filters.status}>{s.label}</option>)}
          </select>
        </label>
        <label class="grow">Search
          <input class="input" type="search" name="q" value={filters.q} placeholder="Text, @handle or name" maxlength="200" />
        </label>
        <button class="button secondary" type="submit">Search</button>
      </form>
    )}

    <ul class="si-list" id="si-list" aria-label="Social inbox"></ul>
    <p class="si-muted si-count" id="si-count" hidden></p>
    <button type="button" class="button secondary si-more" id="si-more" hidden>Show more</button>

    <div class="si-empty" id="si-empty" hidden>
      <h3 id="si-empty-title">{empty.title}</h3>
      <p id="si-empty-body">{empty.body}</p>
      <p id="si-empty-link">{empty.link && <a class="button secondary" href={empty.link.href}>{empty.link.label}</a>}</p>
    </div>
  </div>

  <dialog id="si-dialog" class="si-dialog" aria-labelledby="si-d-title">
    <div class="si-d-head">
      <h3 id="si-d-title">Item</h3>
      <button type="button" class="si-d-close" data-close aria-label="Close">×</button>
    </div>
    <div class="si-d-body" id="si-d-body"></div>
  </dialog>
</AppLayout>

<script>
  import * as api from "@/lib/api/socialInbox";
  import { installLogoFallback, markHtml } from "@/lib/integrationLogo";
  import {
    type ActionButton,
    actionButtons,
    authorLabel,
    type Can,
    confirmText,
    emptyNotice,
    excerpt,
    type Filters,
    filtersToQuery,
    hasFilters,
    type InboxItem,
    type InboxSummary,
    kindLabel,
    openHref,
    replyAgainText,
    replyBadge,
    replyForm,
    replyText,
    SOCIAL_INBOX_PATH,
    statusBadge,
    timeAgo,
    errorMessage,
  } from "@/lib/socialInbox";

  const $ = (id: string): any => document.getElementById(id);
  const esc = (s: unknown) =>
    String(s ?? "").replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c] as string);

  const init = JSON.parse($("si-data").textContent || "{}");
  const summary: InboxSummary | null = init.summary ?? null;
  const filters: Filters = init.filters;
  const can: Can = summary?.can ?? {};
  let items: InboxItem[] = init.list?.items ?? [];
  let total: number = init.list?.total ?? 0;
  let newCount: number = init.list?.new ?? summary?.new ?? 0;
  let openId: string | null = null;

  const badge = (b: { label: string; tone: string; title?: string }) =>
    `<span class="si-badge ${esc(b.tone)}"${b.title ? ` title="${esc(b.title)}"` : ""}>${esc(b.label)}</span>`;

  const mark = (network: string) => markHtml({ slug: network, icon: "💬", hasLogo: true });

  function badgesHtml(item: InboxItem): string {
    const replied = replyBadge(item.reply);
    const repliedHtml = replied
      ? replied.href
        ? `<a class="si-badge-link" href="${esc(replied.href)}" title="Open the reply log entry">${badge(replied)}</a>`
        : badge(replied)
      : "";
    const status = item.status === "replied" && replied ? "" : badge(statusBadge(item.status));
    return `${status}${repliedHtml}`;
  }

  function rowHtml(item: InboxItem): string {
    const unread = item.status === "new";
    return `<li><button type="button" class="si-row${unread ? " unread" : ""}" data-id="${esc(item.id)}" aria-haspopup="dialog">
      <span class="si-mark">${mark(item.network)}</span>
      <span class="si-main">
        <span class="si-line"><strong class="si-author">${esc(authorLabel(item.author))}</strong><span class="si-kind">${esc(kindLabel(item.kind))}</span></span>
        <span class="si-text">${esc(excerpt(item.text))}</span>
      </span>
      <span class="si-meta"><time datetime="${esc(item.createdAt)}" title="${esc(new Date(item.createdAt).toLocaleString())}">${esc(timeAgo(item.createdAt))}</time><span class="si-badges">${badgesHtml(item)}</span></span>
    </button></li>`;
  }

  function render() {
    const filtered = hasFilters(filters);
    $("si-list").innerHTML = items.map(rowHtml).join("");
    $("si-empty").hidden = items.length > 0;
    if (items.length === 0) {
      const notice = emptyNotice(summary, filtered);
      $("si-empty-title").textContent = notice.title;
      $("si-empty-body").textContent = notice.body;
      $("si-empty-link").innerHTML = notice.link ? `<a class="button secondary" href="${esc(notice.link.href)}">${esc(notice.link.label)}</a>` : "";
    }
    $("si-count").hidden = items.length === 0;
    $("si-count").textContent = `${items.length} of ${total}${newCount ? ` · ${newCount} new in the workspace` : ""}`;
    $("si-more").hidden = items.length >= total;
    $("si-mark-all").hidden = !(can.seen && newCount > 0);
    installLogoFallback();
  }

  // ── filters: a change goes to the URL, so a view can be bookmarked ───────────────────────────────────────────────
  const form = $("si-filters") as HTMLFormElement | null;
  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    const f = Object.fromEntries(new FormData(form).entries()) as Record<string, string>;
    location.href = `${SOCIAL_INBOX_PATH}${filtersToQuery({ integration: f.integration ?? "", kind: f.kind ?? "", status: f.status ?? "", q: f.q ?? "" })}`;
  });
  form?.querySelectorAll("select").forEach((select) => select.addEventListener("change", () => form.requestSubmit()));

  $("si-more").addEventListener("click", async () => {
    const button = $("si-more") as HTMLButtonElement;
    button.disabled = true;
    try {
      const more = await api.listItems(filters, items.length);
      items = [...items, ...more.items.filter((m) => !items.some((i) => i.id === m.id))];
      total = more.total;
      newCount = more.new;
      render();
    } catch (e) {
      $("si-count").textContent = errorMessage(e);
    } finally {
      button.disabled = false;
    }
  });

  $("si-mark-all").addEventListener("click", async () => {
    const button = $("si-mark-all") as HTMLButtonElement;
    button.disabled = true;
    try {
      await api.markSeen({ all: true, ...(filters.integration ? { integration: filters.integration } : {}) });
      location.reload();
    } catch (e) {
      button.disabled = false;
      $("si-count").hidden = false;
      $("si-count").textContent = errorMessage(e);
    }
  });

  // ── the item ─────────────────────────────────────────────────────────────────────────────────────────────────────
  const dialog = $("si-dialog") as HTMLDialogElement;
  const body = $("si-d-body") as HTMLElement;
  const current = () => items.find((i) => i.id === openId) ?? null;

  function buttonHtml(b: ActionButton): string {
    const tone = b.destructive ? " si-danger" : " secondary";
    return `<button type="button" class="button${tone} si-btn-sm" data-act="${b.key}">${esc(b.label)}</button>`;
  }

  function dialogHtml(item: InboxItem): string {
    const open = openHref(item);
    const replied = replyBadge(item.reply);
    const buttons = actionButtons(item, can);
    const reply = buttons.some((b) => b.key === "reply") ? replyForm(item.replyModes) : null;
    const canMessage = buttons.some((b) => b.key === "message");
    return `
      <div class="si-d-who">${mark(item.network)}<div><strong>${esc(authorLabel(item.author))}</strong>${item.author.name && item.author.handle ? ` <span class="si-muted">${esc(item.author.name)}</span>` : ""}
        <div class="si-muted si-small">${esc(kindLabel(item.kind))} on ${esc(item.network)}${item.integration && item.integration !== item.network ? ` (${esc(item.integration)})` : ""} · <time title="${esc(new Date(item.createdAt).toLocaleString())}">${esc(timeAgo(item.createdAt))}</time></div></div>
        <span class="si-badges">${badgesHtml(item)}</span></div>
      <p class="si-full">${esc(item.text)}</p>
      <p class="si-muted si-small si-links">${item.postUrl ? `<a href="${esc(item.postUrl)}" target="_blank" rel="noopener noreferrer">The post</a>` : ""}${open ? `${item.postUrl ? " · " : ""}<a href="${esc(open)}" target="_blank" rel="noopener noreferrer">Open on ${esc(item.network)}</a>` : ""}${replied?.href ? ` · <a href="${esc(replied.href)}">Reply log entry</a>` : ""}</p>
      <div class="si-actions">${buttons.map(buttonHtml).join("")}</div>
      ${
        reply
          ? `<form class="si-form" data-form="reply" hidden>
              <label for="si-reply-text">Reply</label>
              <textarea id="si-reply-text" class="input" rows="3" maxlength="10000" required></textarea>
              ${
                reply.showToggle
                  ? `<fieldset class="si-modes"><legend class="si-sr">Reply as</legend>
                      ${reply.modes.map((m) => `<label><input type="radio" name="si-mode" value="${m}"${m === reply.mode ? " checked" : ""} /> ${m === "private" ? "Private (only them)" : "Public (in the thread)"}</label>`).join("")}</fieldset>`
                  : `<p class="si-muted si-small">${reply.mode === "private" ? "Sent privately to them." : "Sent publicly in the thread."}</p>`
              }
              <div class="si-form-actions"><button class="button si-btn-sm" type="submit">Send reply</button><button class="button secondary si-btn-sm" type="button" data-cancel>Cancel</button></div>
              <p class="si-muted si-small">Your pressing Send is the approval: it is sent as you and logged in the reply log, so no rule answers it again.</p>
            </form>`
          : ""
      }
      ${
        canMessage
          ? `<form class="si-form" data-form="message" hidden>
              <label for="si-msg-text">Message ${esc(authorLabel(item.author))}</label>
              <textarea id="si-msg-text" class="input" rows="3" maxlength="10000" required></textarea>
              <div class="si-form-actions"><button class="button si-btn-sm" type="submit">Send message</button><button class="button secondary si-btn-sm" type="button" data-cancel>Cancel</button></div>
              <p class="si-muted si-small">A direct message, not a reply to this comment.</p>
            </form>`
          : ""
      }
      <p class="si-result" id="si-result" role="status" hidden></p>`;
  }

  function showItem(item: InboxItem) {
    openId = item.id;
    $("si-d-title").textContent = `${authorLabel(item.author)} · ${kindLabel(item.kind)}`;
    body.innerHTML = dialogHtml(item);
    installLogoFallback();
  }

  function say(text: string, ok = true) {
    const out = $("si-result");
    out.hidden = false;
    out.className = `si-result ${ok ? "ok" : "bad"}`;
    out.innerHTML = text;
  }

  /** The item came back changed: keep it in the list, redraw its row and the open dialog. */
  function update(next: InboxItem) {
    items = items.map((i) => (i.id === next.id ? next : i));
    showItem(next);
    const row = document.querySelector(`.si-row[data-id="${CSS.escape(next.id)}"]`);
    if (row) row.closest("li")!.outerHTML = rowHtml(next);
  }

  function busy(on: boolean) {
    body.querySelectorAll("button, textarea, input").forEach((el: HTMLButtonElement) => (el.disabled = on));
  }

  async function run(work: () => Promise<void>) {
    busy(true);
    try {
      await work();
    } catch (e) {
      say(esc(errorMessage(e)), false);
    } finally {
      busy(false);
    }
  }

  $("si-list").addEventListener("click", async (event: Event) => {
    const row = (event.target as HTMLElement).closest<HTMLElement>(".si-row");
    const item = row ? items.find((i) => i.id === row.dataset.id) : null;
    if (!item) return;
    showItem(item);
    dialog.showModal();
    if (item.status === "new" && can.seen) {
      try {
        await api.markSeen({ ids: [item.id] });
        newCount = Math.max(0, newCount - 1);
        update({ ...item, status: "seen" });
        render();
      } catch {
        /* the item stays new; opening it is not worth an error */
      }
    }
  });

  dialog.addEventListener("click", (event) => {
    if (event.target === dialog || (event.target as HTMLElement).closest("[data-close]")) dialog.close();
  });
  dialog.addEventListener("close", () => {
    openId = null;
  });

  body.addEventListener("click", async (event: Event) => {
    const target = event.target as HTMLElement;
    const item = current();
    if (!item) return;
    if (target.closest("[data-cancel]")) {
      target.closest<HTMLElement>(".si-form")!.hidden = true;
      return;
    }
    const act = target.closest<HTMLElement>("[data-act]")?.dataset.act;
    if (!act) return;
    if (act === "reply" || act === "message") {
      body.querySelectorAll<HTMLElement>(".si-form").forEach((f) => (f.hidden = f.dataset.form !== act));
      const text = body.querySelector<HTMLTextAreaElement>(`[data-form="${act}"] textarea`);
      text?.focus();
      const again = act === "reply" ? replyAgainText(item) : null;
      if (again) say(esc(again), true);
      return;
    }
    if (act === "delete" && !confirm(confirmText("delete", item))) return;
    await run(async () => {
      if (act === "like") {
        update((await api.like(item.id)).item!);
        say("Liked.");
      } else if (act === "hide") {
        const hidden = item.status !== "hidden";
        update((await api.hide(item.id, hidden)).item!);
        say(hidden ? "Hidden on the network." : "Unhidden.");
      } else if (act === "delete") {
        await api.remove(item.id);
        items = items.filter((i) => i.id !== item.id);
        total = Math.max(0, total - 1);
        dialog.close();
        render();
      } else if (act === "rule") {
        const typed = body.querySelector<HTMLTextAreaElement>('[data-form="reply"] textarea')?.value ?? "";
        const rule = await api.makeRule(item.id, replyText(typed) ?? "");
        say(
          `A draft rule was made (keywords: ${esc(rule.keywords.join(", ") || "none suggested")}). It does nothing until you publish it: <a href="${esc(rule.path)}">open it to adjust and publish</a>.`,
        );
      }
    });
  });

  body.addEventListener("submit", async (event: Event) => {
    event.preventDefault();
    const formEl = event.target as HTMLFormElement;
    const item = current();
    const text = replyText(formEl.querySelector("textarea")!.value);
    if (!item || !text) return;
    await run(async () => {
      if (formEl.dataset.form === "reply") {
        const mode = (formEl.querySelector<HTMLInputElement>('input[name="si-mode"]:checked')?.value ?? replyForm(item.replyModes).mode) as string;
        const out = await api.reply(item.id, text, mode === "private");
        update(out.item);
        say(`${out.private ? "Private" : "Public"} reply sent${out.logged ? " and logged" : " (the reply log isn't set up, so it wasn't logged)"}.`);
      } else {
        const out = await api.message(item.id, text);
        update(out.item!);
        say("Message sent.");
      }
    });
  });

  render();
</script>

<style is:global>
  .social-page [hidden], .si-dialog [hidden] { display: none !important; }
  .social-page { display: grid; gap: 14px; max-width: 960px; }
  .si-lede { margin: 4px 0 0; color: var(--muted); max-width: 70ch; }
  .si-lede a, .si-notice a { color: var(--accent); }
  .si-notice { padding: 10px 14px; border: 1px solid var(--line); border-left: 3px solid var(--gold); border-radius: var(--radius); background: var(--panel); font-size: 14px; }
  .si-alert { padding: 10px 14px; border-radius: var(--radius); color: var(--color-error); background: var(--color-error-bg); }

  .si-filters { display: flex; flex-wrap: wrap; gap: 10px; align-items: flex-end; }
  .si-filters label { display: grid; gap: 4px; font-size: 12.5px; color: var(--muted); min-width: 130px; }
  .si-filters label.grow { flex: 1 1 200px; }

  .si-list { list-style: none; margin: 0; padding: 0; border: 1px solid var(--line); border-radius: var(--radius); background: var(--panel); overflow: hidden; }
  .si-list:empty { display: none; }
  .si-list li + li { border-top: 1px solid var(--line); }
  .si-row {
    display: grid; grid-template-columns: 36px minmax(0, 1fr) auto; gap: 10px; align-items: center; width: 100%;
    padding: 10px 12px; border: 0; background: none; color: inherit; font: inherit; text-align: left; cursor: pointer;
  }
  .si-row:hover { background: var(--panel-2); }
  .si-row:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
  .si-mark { display: grid; place-items: center; }
  .si-main { display: grid; gap: 2px; min-width: 0; }
  .si-line { display: flex; gap: 8px; align-items: baseline; min-width: 0; }
  .si-author { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 500; }
  .unread .si-author { font-weight: 800; }
  .unread .si-author::before { content: ""; display: inline-block; width: 8px; height: 8px; margin-right: 6px; border-radius: 50%; background: var(--accent); }
  .si-kind { font-size: 12px; color: var(--muted); white-space: nowrap; }
  .si-text { color: var(--muted); font-size: 14px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .unread .si-text { color: var(--ink); }
  .si-meta { display: grid; gap: 4px; justify-items: end; font-size: 12px; color: var(--muted); white-space: nowrap; }
  .si-badges { display: inline-flex; gap: 4px; flex-wrap: wrap; justify-content: flex-end; }

  .si-badge { display: inline-block; padding: 1px 8px; border-radius: 999px; border: 1px solid var(--line); font-size: 11.5px; line-height: 1.6; color: var(--muted); background: var(--panel); }
  .si-badge.new { color: white; background: var(--accent); border-color: var(--accent); }
  .si-badge.good { color: var(--good); border-color: color-mix(in srgb, var(--good) 45%, var(--line)); }
  .si-badge.warn { color: var(--warn); border-color: color-mix(in srgb, var(--warn) 45%, var(--line)); }
  .si-badge-link { text-decoration: none; }
  .si-count { margin: 0; font-size: 13px; }
  .si-more { justify-self: start; }
  .si-empty { padding: 24px; border: 1px dashed var(--line); border-radius: var(--radius); text-align: center; }
  .si-empty h3 { margin: 0 0 6px; }
  .si-empty p { margin: 6px auto; max-width: 60ch; color: var(--muted); }

  .si-dialog { width: min(640px, calc(100vw - 32px)); max-height: calc(100dvh - 48px); padding: 0; border: 1px solid var(--line); border-radius: var(--radius); background: var(--panel); color: var(--ink); box-shadow: 0 8px 32px rgb(0 0 0 / 0.18); }
  .si-dialog[open] { display: flex; flex-direction: column; }
  .si-dialog::backdrop { background: rgb(0 0 0 / 0.5); }
  .si-d-head { display: flex; align-items: center; gap: 12px; padding: 12px 16px; border-bottom: 1px solid var(--line); }
  .si-d-head h3 { margin: 0; flex: 1; font-size: 16px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .si-d-close { background: none; border: 0; font-size: 24px; line-height: 1; color: var(--muted); cursor: pointer; padding: 2px 8px; }
  .si-d-body { overflow-y: auto; padding: 14px 16px 18px; display: grid; gap: 12px; }
  .si-d-who { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: 10px; align-items: center; }
  .si-full { margin: 0; white-space: pre-wrap; overflow-wrap: anywhere; font-size: 15px; line-height: 1.5; }
  .si-links { margin: 0; }
  .si-links a { color: var(--accent); }
  .si-actions { display: flex; flex-wrap: wrap; gap: 8px; }
  .button.si-btn-sm { min-height: 34px; padding: 6px 10px; font-size: 13px; }
  .button.si-danger { background: var(--panel); color: var(--color-error); border-color: color-mix(in srgb, var(--color-error) 50%, var(--line)); }
  .si-form { display: grid; gap: 8px; padding: 12px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--panel-2); }
  .si-form[hidden] { display: none; }
  .si-form label { font-size: 13px; font-weight: 600; }
  .si-form textarea { resize: vertical; }
  .si-modes { display: flex; flex-wrap: wrap; gap: 14px; border: 0; margin: 0; padding: 0; }
  .si-modes label { font-weight: 400; display: inline-flex; gap: 6px; align-items: center; }
  .si-form-actions { display: flex; gap: 8px; }
  .si-form p { margin: 0; }
