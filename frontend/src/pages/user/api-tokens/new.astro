---
import ApiTokenRevealModal from "@/components/ApiTokenRevealModal.astro";
import AppLayout from "@/layouts/AppLayout.astro";
import type { WorkspaceWithMembership } from "@inneropen/marvin-sdk/platform";
import { listWorkspaces } from "@/lib/api/workspaces";
import { getAuthToken } from "@/lib/api/client";

// The workspaces this person belongs to, for pinning a token. Empty on failure: the token is then simply global.
const workspaces = await listWorkspaces(getAuthToken(Astro.cookies)).catch(() => [] as WorkspaceWithMembership[]);
---

<AppLayout title="New API Token" eyebrow="User Settings">
  <div class="page-header">
    <div>
      <h2>Create API Token</h2>
      <p>Generate a new personal access token</p>
    </div>
  </div>

  <div class="form-container">
    <form id="create-token-form" class="form">
      <div class="form-section">
        <h3>Token Details</h3>

        <label class="form-field">
          <span class="label">Name *</span>
          <input
            type="text"
            name="name"
            required
            placeholder="Production API Access"
            class="input"
          />
          <small class="hint">A descriptive name to identify this token</small>
        </label>

        <label class="form-field">
          <span class="label">Description</span>
          <textarea
            name="description"
            rows="3"
            placeholder="Used for production deployment scripts"
            class="input"
          ></textarea>
          <small class="hint">Optional notes about this token's purpose</small>
        </label>

        <label class="form-field">
          <span class="label">Workspace</span>
          <select name="groupId" class="input" data-testid="token-workspace">
            <option value="">All workspaces (global)</option>
            {workspaces.map((w) => <option value={w.workspace.id}>{w.workspace.name}</option>)}
          </select>
          <small class="hint">
            Global follows the workspace you have active, as every token did before. Pinned works in that one workspace
            only, whatever you have active, and can't manage tokens or your account. Fixed once created.
          </small>
        </label>

        <div class="info-box">
          <strong>⚠️ Important</strong>
          <p>Your token will be shown only once after creation. Copy it immediately and store it securely.</p>
        </div>
      </div>

      <div class="form-actions">
        <button type="submit" class="button">Create Token</button>
        <a href="/user/api-tokens" class="button secondary">Cancel</a>
      </div>
    </form>
  </div>

  <ApiTokenRevealModal title="Personal API Token" doneHref="/user/api-tokens" />
</AppLayout>

<script>
  import { revealTokenOnce } from '@/lib/tokenReveal';
  import { createSdkClient } from '@/lib/sdk';

  // HttpOnly cookie is automatically sent with credentials: 'include'
  const form = document.getElementById('create-token-form');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(e.target as HTMLFormElement);

    const payload = {
      name: formData.get('name') as string,
      description: (formData.get('description') as string) || undefined,
      // Empty means global. The installed SDK's create type predates groupId (the API takes it); drop the cast once it is bumped.
      groupId: (formData.get('groupId') as string) || undefined,
    } as Parameters<ReturnType<typeof createSdkClient>['user']['createApiToken']>[0] & { groupId?: string };

    try {
      const sdk = createSdkClient();

      const data = await sdk.user.createApiToken(payload);

      // Shown once from the response; dismissing the dialog moves on to the tokens list.
      const dialog = document.getElementById('api-token-modal') as HTMLDialogElement | null;
      if (!dialog || !revealTokenOnce(dialog, data.token)) {
        alert('Warning: Token created but no token was returned. Please rotate it to get a new one.');
        window.location.href = '/user/api-tokens';
      }
    } catch (error) {
      alert('Failed to create token. Please try again.');
      console.error('Error creating token:', error);
    }
  });
</script>

<style>
  .page-header {
    margin-bottom: 32px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--line);
  }



  .form-container {
    max-width: 700px;
  }

  .form {
    display: grid;
    gap: 24px;
  }

  .form-section {
    display: grid;
    gap: 16px;
    padding: 24px;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .form-section h3 {
    margin: 0 0 8px;
    font-size: 16px;
    font-weight: 600;
  }

  .form-field {
    display: grid;
    gap: 6px;
  }

  .label {
    font-size: 14px;
    font-weight: 500;
  }

  .input {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    font-size: 14px;
  }

  textarea.input {
    resize: vertical;
    font-family: inherit;
  }

  .hint {
    font-size: 12px;
    color: var(--muted);
  }

  .info-box {
    padding: 16px;
    background: rgba(255, 193, 7, 0.1);
    border: 1px solid rgba(255, 193, 7, 0.3);
    border-radius: var(--radius);
  }

  .info-box strong {
    display: block;
    margin-bottom: 6px;
    font-size: 14px;
  }

  .info-box p {
    margin: 0;
    font-size: 13px;
    color: var(--muted);
  }

  .form-actions {
    display: flex;
    gap: 12px;
  }
</style>
