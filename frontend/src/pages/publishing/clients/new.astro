---
import ApiClientPermissionFields from "@/components/ApiClientPermissionFields.astro";
import ApiTokenRevealModal from "@/components/ApiTokenRevealModal.astro";
import AppLayout from "@/layouts/AppLayout.astro";
import { getAuthToken } from "@/lib/api/client";
import { canManageCurrentWorkspace } from "@/lib/api/workspaces";
import { API_CLIENTS_ADMIN_ONLY } from "@/lib/workspaceRole";

// If the role lookup fails, show the form anyway: the API still refuses non-admins.
let canManage = true;
try {
  canManage = await canManageCurrentWorkspace(getAuthToken(Astro.cookies));
} catch (e) {
  console.error("[clients/new] Error checking role:", e);
}
---

<AppLayout crumb="publishing.clients.new">
  <div class="toolbar">
    <div>
      <h2>Create API Client</h2>
      <p>Generate a token for external sites to access published content</p>
    </div>
  </div>

  {!canManage ? (
    <div class="alert alert-info" role="status">{API_CLIENTS_ADMIN_ONLY}</div>
  ) : (
    <form method="POST" action="/api/api-clients" class="create-form" id="create-client-form">
      <section class="form-section">
        <h3>Client Details</h3>
        <div class="form-grid">
          <label class="span-2">
            <span>Name <span class="required">*</span></span>
            <input
              type="text"
              name="name"
              required
              placeholder="e.g., Production Site, Staging, Mobile App"
              autofocus
            />
            <small>Slug will be auto-generated from the name</small>
          </label>

          <label class="span-2">
            <span>Description</span>
            <textarea
              name="description"
              rows="3"
              placeholder="Optional: where this client is used, what it's for"
            ></textarea>
          </label>
        </div>
      </section>

      <ApiClientPermissionFields />

      <div class="form-actions">
        <button type="submit" class="button">Create Client</button>
        <a href="/publishing/clients" class="button secondary">Cancel</a>
      </div>

      <div class="info-box">
        <strong>⚠️ Important:</strong> The API token will only be shown once after creation.
        Copy it immediately and store it securely.
      </div>
    </form>
  )}

  <ApiTokenRevealModal doneHref="/publishing/clients" />
</AppLayout>

<script>
  import { permissionsFromChecked } from '@/lib/apiClientPermissions';
  import { revealTokenOnce } from '@/lib/tokenReveal';

  interface APIClientCreatePayload {
    name: string;
    description?: string | null;
    permissions?: Record<string, boolean> | null;
  }

  // HttpOnly cookie is automatically sent with credentials: 'include'
  const form = document.getElementById('create-client-form') as HTMLFormElement | null;
  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const formData = new FormData(form);
      const nameValue = formData.get('name');
      const descriptionValue = formData.get('description');

      if (typeof nameValue !== 'string' || !nameValue) {
        alert('Name is required');
        return;
      }

      const permissions = permissionsFromChecked(formData.getAll('permission').map(String));

      const data: APIClientCreatePayload = {
        name: nameValue,
        description: descriptionValue && typeof descriptionValue === 'string' ? descriptionValue : null,
        permissions: Object.keys(permissions).length > 0 ? permissions : null,
      };

      try {
        const { createSdkClient } = await import('@/lib/sdk');

        // SDK uses cookie-based auth automatically via credentials: 'include'
        const sdk = createSdkClient();
        const result = await sdk.apiClients.create(data);

        // Shown once from the response; dismissing the dialog moves on to the clients list.
        const dialog = document.getElementById('api-token-modal') as HTMLDialogElement | null;
        if (!dialog || !revealTokenOnce(dialog, result.token)) {
          alert('Warning: Client created but no token was returned. Please rotate the token to get a new one.');
          window.location.href = '/publishing/clients';
        }
      } catch (err) {
        alert('Error: ' + (err instanceof Error ? err.message : 'Failed to create client'));
      }
    });
  }
</script>

<style>
  .toolbar {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 32px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--line);
  }

  .toolbar h2 {
    margin: 0;
    font-size: 24px;
    font-weight: 600;
  }

  .toolbar p {
    margin: 8px 0 0;
    color: var(--muted);
    font-size: 14px;
  }

  .alert {
    max-width: 700px;
    padding: 16px;
    border-radius: var(--radius);
    font-size: 14px;
  }

  .alert-info {
    background: rgb(47 111 115 / 0.1);
    color: var(--accent-2);
    border: 1px solid var(--accent-2);
  }

  .create-form {
    max-width: 700px;
    display: grid;
    gap: 24px;
  }

  .form-section {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 24px;
  }

  .form-section h3 {
    margin: 0 0 4px;
    font-size: 18px;
    font-weight: 600;
  }

  .section-description {
    margin: 0 0 20px;
    color: var(--muted);
    font-size: 14px;
  }

  .form-grid {
    display: grid;
    gap: 16px;
  }

  .form-grid label {
    display: grid;
    gap: 6px;
  }

  .form-grid label.span-2 {
    grid-column: 1 / -1;
  }

  .form-grid label > span {
    font-size: 14px;
    font-weight: 500;
    color: var(--ink);
  }

  .required {
    color: var(--warn);
  }

  .form-grid input,
  .form-grid textarea {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--panel);
    font-size: 14px;
    color: var(--ink);
  }

  .form-grid input:focus,
  .form-grid textarea:focus {
    outline: none;
    border-color: var(--accent);
  }

  .form-grid textarea {
    resize: vertical;
  }

  .form-grid small {
    font-size: 12px;
    color: var(--muted);
  }

  .form-actions {
    display: flex;
    gap: 12px;
  }

  .info-box {
    padding: 16px;
    background: rgb(169 99 47 / 0.1);
    border-left: 3px solid var(--warn);
    border-radius: var(--radius);
    font-size: 14px;
    color: var(--ink);
  }

  .info-box strong {
    color: var(--warn);
  }
</style>
