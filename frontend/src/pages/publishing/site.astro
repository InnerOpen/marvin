---
import type { Workspace } from "@inneropen/marvin-sdk/platform";
import AppLayout from "@/layouts/AppLayout.astro";
import { getAuthToken } from "@/lib/api/client";
import { getEmbedProviders } from "@/lib/api/mediaEmbeds";
import { getSiteLinks, type SiteLinksStatus } from "@/lib/api/siteLinks";
import type { GroupPreferencesRead } from "@/lib/api/types";
import { DEFAULT_CONSENT_TEXT } from "@/lib/mediaEmbeds";
import { createSdkClient } from "@/lib/sdk";

const authToken = getAuthToken(Astro.cookies);
const sdk = createSdkClient(authToken);

let workspace: Workspace | null = null;
let preferences: GroupPreferencesRead | null = null;
let siteLinks: SiteLinksStatus | null = null;
let error: string | null = null;
let success: boolean = false;

// Check for success/error query params
const urlParams = Astro.url.searchParams;
if (urlParams.get("success")) {
  success = true;
}
if (urlParams.get("error")) {
  error = "Failed to save site configuration. Please try again.";
}

try {
  workspace = await sdk.workspaces.getCurrent();

  if (workspace?.id) {
    // Get preferences for this workspace
    preferences = (await sdk.workspaces.getPreferences(workspace.id)) as GroupPreferencesRead;
    siteLinks = await getSiteLinks(workspace.id, authToken).catch(() => null); // a nicety: the page works without it
  } else {
    error = "No active workspace found. Please activate a workspace first.";
  }
} catch (e) {
  console.error("[site] Error loading:", e);
  error = e instanceof Error ? e.message : String(e);
}

// SEO lives under site_metadata_json.seo — surface it as a structured section (not raw JSON).
const siteMeta = (preferences?.siteMetadataJson || {}) as Record<string, any>;
const seo = (siteMeta.seo || {}) as Record<string, any>;
const seoKeywords = Array.isArray(seo.keywords) ? seo.keywords.join(", ") : (seo.keywords ?? "");

// Privacy & cookies live under site_metadata_json.privacy (disclosure only). The repeatable rows are drawn by the
// inline script from these JSON blobs, so the row markup exists once (in the <template>s below).
const privacy = (siteMeta.privacy || {}) as Record<string, any>;
const privacyController = (privacy.controller || {}) as Record<string, any>;
const privacyConsent = (privacy.consent || {}) as Record<string, any>;
const privacyProcessors = Array.isArray(privacy.processors) ? privacy.processors : [];
const privacyCookies = Array.isArray(privacy.cookies) ? privacy.cookies : [];
const COOKIE_CATEGORIES = ["necessary", "preferences", "analytics", "marketing"];
// Derived, never stored: any non-"necessary" cookie needs prior consent (same rule as the API's bannerRequired).
const bannerRequired = privacyCookies.some((c: Record<string, any>) => c?.category && c.category !== "necessary");

// Media embeds live under site_metadata_json.embeds = {mode, consentText}; click-to-load is the default.
const embeds = (siteMeta.embeds || {}) as Record<string, any>;
const embedsMode = embeds.mode === "direct" ? "direct" : "click_to_load";
let embedProviderNames: string[] = [];
try {
  embedProviderNames = (await getEmbedProviders(authToken)).providers.map((p) => p.name);
} catch (e) {
  console.warn("[site] Could not load media embed providers:", e);
}

// The raw metadata editor owns everything EXCEPT seo, privacy and embeds (structured above) — compute its display value
// here in the frontmatter, since TS generics/casts can't live inside Astro template expressions.
const metaWithoutSeo: Record<string, any> = { ...siteMeta };
delete metaWithoutSeo.seo;
delete metaWithoutSeo.privacy;
delete metaWithoutSeo.embeds;
const siteSocial = (preferences?.siteSocialJson || null) as Record<string, any> | null;
const metaForDisplay: Record<string, any> =
  siteSocial && Object.keys(siteSocial).length > 0 ? { ...metaWithoutSeo, social: siteSocial } : metaWithoutSeo;
const metadataEditorValue = Object.keys(metaForDisplay).length > 0 ? JSON.stringify(metaForDisplay, null, 2) : "";
// The many "X has no page URL pattern" problems fold into one callout with a chip per type (named from the message).
const NO_PATTERN_SUFFIX = " has no page URL pattern";
const noPattern = (siteLinks?.problems ?? [])
  .filter((p) => p.kind === "no_page_pattern")
  .map((p) => ({ ...p, name: p.message.includes(NO_PATTERN_SUFFIX) ? p.message.split(NO_PATTERN_SUFFIX)[0] : (p.entryType ?? p.fix.label) }));
---

<AppLayout crumb="publishing.site">
  <div class="toolbar">
    <div>
      <h2>Site Configuration</h2>
      <p>Configure your workspace's public identity and publishing settings</p>
    </div>
    <a class="button secondary" href="/publishing/clients">Manage Clients</a>
  </div>

  {success && (
    <div class="alert alert-success">
      <strong>Saved!</strong> Site configuration updated successfully.
    </div>
  )}

  {error && (
    <div class="alert alert-error">
      <strong>Error:</strong> {error}
    </div>
  )}

  {workspace?.id && preferences ? (
    <form method="POST" data-workspace-id={workspace.id} class="site-form" id="site-form">
      <section class="form-section">
        <h3>Identity</h3>
        <p class="section-description">How your site identifies itself to the world</p>
        <div class="form-grid">
          <label class="span-2">
            <span>Site Title</span>
            <input
              type="text"
              name="siteTitle"
              value={preferences.siteTitle || ""}
              placeholder={workspace.name}
            />
            <small>Defaults to workspace name if not set</small>
          </label>
          <label class="span-2">
            <span>Tagline</span>
            <input
              type="text"
              name="siteTagline"
              value={preferences.siteTagline || ""}
              placeholder="A short slogan or motto"
            />
          </label>
          <label class="span-2">
            <span>Description</span>
            <textarea
              name="siteDescription"
              rows="3"
              placeholder="Describe what this site is about"
            >{preferences.siteDescription || ""}</textarea>
          </label>
          <label class="span-2" id="site-canonical-url">
            <span>Canonical URL</span>
            <input
              type="url"
              name="siteCanonicalUrl"
              value={preferences.siteCanonicalUrl || ""}
              placeholder="https://example.com"
            />
            <small>Where this site is published. Also the base for entry links when an entry type has a Page URL pattern.</small>
          </label>
        </div>
      </section>

      {siteLinks && (
        <section class="form-section" id="site-links" data-workspace-id={workspace.id}>
          <h3>Site links</h3>
          <p class="section-description">
            An entry's link is the Canonical URL above plus its entry type's Page URL pattern. Without both, links come back
            empty in AI answers, workflows (<code>{"${entry.url}"}</code>) and "View on site".
          </p>
          <p id="site-links-ok" class="status-success" hidden={!siteLinks.ok}>Every publishable entry type has a page address.</p>
          {siteLinks.problems.filter((p) => p.kind !== "no_page_pattern").map((p) => (
            <div class="sl-callout">
              <span>{p.message}</span>
              <a class="sl-fix" href={p.fix.path}>{p.fix.label} →</a>
            </div>
          ))}
          {noPattern.length > 0 && (
            <div class="sl-callout" data-testid="site-links-no-pattern">
              <span>
                {noPattern.length === 1 ? "1 entry type has" : `${noPattern.length} entry types have`} no page URL pattern, so
                {noPattern.length === 1 ? " its" : " their"} entries have no link. Pick one to set it; a type that is only part of a page (a hero, a band) can stay without.
              </span>
              <div class="sl-chips">
                {noPattern.map((p) => <a class="sl-chip" href={p.fix.path} title={p.fix.label}>{p.name}</a>)}
              </div>
            </div>
          )}
          <div class="sl-probe">
              <button type="button" id="site-links-probe-btn" class="button secondary">Check the live links</button>
              <small id="site-links-probe-note">Fetches one published entry per type from your site; takes a few seconds.</small>
          </div>
          <ul id="site-links-probe-results" class="sl-results"></ul>
        </section>
      )}

      <section class="form-section">
        <h3>Branding</h3>
        <p class="section-description">Visual identity assets</p>
        <div class="form-grid">
          <label>
            <span>Logo URL</span>
            <input
              type="url"
              name="siteLogo"
              value={preferences.siteLogo || ""}
              placeholder="https://example.com/logo.png"
            />
          </label>
          <label>
            <span>Favicon URL</span>
            <input
              type="url"
              name="siteFavicon"
              value={preferences.siteFavicon || ""}
              placeholder="https://example.com/favicon.ico"
            />
          </label>
        </div>
      </section>

      <section class="form-section">
        <h3>Localization</h3>
        <p class="section-description">Language and timezone settings</p>
        <div class="form-grid">
          <label>
            <span>Locale</span>
            <input
              type="text"
              name="siteLocale"
              value={preferences.siteLocale || "en-US"}
              placeholder="en-US"
            />
            <small>e.g., en-US, en-GB, fr-FR</small>
          </label>
          <label>
            <span>Timezone</span>
            <input
              type="text"
              name="siteTimezone"
              value={preferences.siteTimezone || "America/New_York"}
              placeholder="America/New_York"
              list="tz-list"
            />
            <datalist id="tz-list"></datalist>
            <small>Your site's time zone: workflow waits ("at 09:00", "next Monday") and scheduled times are read in it. Pick from the list — an unknown name falls back to the default.</small>
          </label>
        </div>
      </section>

      <section class="form-section">
        <h3>Contact</h3>
        <p class="section-description">How people can reach you</p>
        <div class="form-grid">
          <label class="span-2">
            <span>Contact Email</span>
            <input
              type="email"
              name="siteContactEmail"
              value={preferences.siteContactEmail || ""}
              placeholder="hello@example.com"
            />
          </label>
        </div>
      </section>

      <section class="form-section" id="seo">
        <h3>SEO &amp; Social Sharing</h3>
        <p class="section-description">How search engines and social platforms present your site. Leave a field blank to fall back to the identity settings above.</p>
        <div class="subgroups">
          <details class="subgroup" open>
            <summary class="subgroup-label">Search</summary>
            <div class="form-grid">
          <label class="span-2">
            <span>Meta Title</span>
            <input
              type="text"
              name="seoTitle"
              value={seo.title || ""}
              maxlength="60"
              placeholder={preferences.siteTitle || workspace.name}
            />
            <small>Shown in browser tabs and search results. Aim for ≤ 60 characters.</small>
          </label>
          <label class="span-2">
            <span>Title Template</span>
            <input
              type="text"
              name="seoTitleTemplate"
              value={seo.titleTemplate || ""}
              placeholder="%s | My Site"
            />
            <small>Pattern for per-page titles. <code>%s</code> is replaced by the page title.</small>
          </label>
          <label class="span-2">
            <span>Meta Description</span>
            <textarea
              name="seoDescription"
              rows="3"
              maxlength="160"
              placeholder={preferences.siteDescription || "A concise summary of this site for search results"}
            >{seo.description || ""}</textarea>
            <small>The snippet under your title in search results. Aim for ≤ 160 characters.</small>
          </label>
          <label class="span-2">
            <span>Keywords</span>
            <input
              type="text"
              name="seoKeywords"
              value={seoKeywords}
              placeholder="content, publishing, headless cms"
            />
            <small>Comma-separated. Low ranking value today, but some frameworks still emit them.</small>
          </label>
          <label>
            <span>Search Engine Indexing</span>
            <select name="seoRobots">
              <option value="index,follow" selected={(seo.robots || "index,follow") === "index,follow"}>Index &amp; follow (public)</option>
              <option value="noindex,nofollow" selected={seo.robots === "noindex,nofollow"}>No index (hidden from search)</option>
            </select>
            <small>Controls the robots meta tag.</small>
          </label>

          </div>
          </details>
          <details class="subgroup" open>
            <summary class="subgroup-label">Social sharing</summary>
            <div class="form-grid">
          <label class="span-2">
            <span>Default Share Image URL</span>
            <input
              type="url"
              name="seoImage"
              value={seo.image || ""}
              placeholder="https://example.com/og-image.png"
            />
            <small>Used for Open Graph and Twitter cards. Recommended 1200×630.</small>
          </label>
          <label class="span-2">
            <span>Share Image Alt Text</span>
            <input
              type="text"
              name="seoImageAlt"
              value={seo.imageAlt || ""}
              placeholder="Describe the share image"
            />
            <small>Accessible description of the share image (og:image:alt).</small>
          </label>
          <label>
            <span>Open Graph Type</span>
            <select name="seoOgType">
              {["website", "article", "profile", "book"].map((t) => (
                <option value={t} selected={(seo.ogType || "website") === t}>{t}</option>
              ))}
            </select>
            <small>How platforms categorize the page.</small>
          </label>
          <label>
            <span>Site Name</span>
            <input
              type="text"
              name="seoSiteName"
              value={seo.siteName || ""}
              placeholder={preferences.siteTitle || workspace.name}
            />
            <small>og:site_name — the brand name, distinct from the page title.</small>
          </label>
          <label>
            <span>Twitter Card</span>
            <select name="seoTwitterCard">
              {["summary_large_image", "summary"].map((t) => (
                <option value={t} selected={(seo.twitterCard || "summary_large_image") === t}>{t}</option>
              ))}
            </select>
            <small>Large image or compact preview.</small>
          </label>
          <label>
            <span>Twitter Site Handle</span>
            <input
              type="text"
              name="seoTwitterHandle"
              value={seo.twitterHandle || ""}
              placeholder="@yourhandle"
            />
            <small>twitter:site — the site's handle.</small>
          </label>
          <label>
            <span>Twitter Creator Handle</span>
            <input
              type="text"
              name="seoTwitterCreator"
              value={seo.twitterCreator || ""}
              placeholder="@author"
            />
            <small>twitter:creator — the content author.</small>
          </label>
          <label>
            <span>Facebook App ID</span>
            <input
              type="text"
              name="seoFbAppId"
              value={seo.fbAppId || ""}
              placeholder="1234567890"
            />
            <small>fb:app_id — for Facebook domain insights.</small>
          </label>

          </div>
          </details>
          <details class="subgroup" open>
            <summary class="subgroup-label">Branding &amp; structured data</summary>
            <div class="form-grid">
          <label>
            <span>Theme Color</span>
            <input
              type="text"
              name="seoThemeColor"
              value={seo.themeColor || ""}
              placeholder="#4f9c84"
            />
            <small>Browser chrome / PWA color (theme-color meta).</small>
          </label>
          <label>
            <span>Publisher</span>
            <input
              type="text"
              name="seoPublisher"
              value={seo.publisher || ""}
              placeholder={preferences.siteTitle || workspace.name}
            />
            <small>Organization name for structured data (JSON-LD).</small>
          </label>

          </div>
          </details>
          <details class="subgroup" open>
            <summary class="subgroup-label">Search engine verification</summary>
            <div class="form-grid">
          <label>
            <span>Google</span>
            <input
              type="text"
              name="seoVerGoogle"
              value={seo.verification?.google || ""}
              placeholder="google-site-verification token"
            />
            <small>Google Search Console.</small>
          </label>
          <label>
            <span>Bing</span>
            <input
              type="text"
              name="seoVerBing"
              value={seo.verification?.bing || ""}
              placeholder="msvalidate.01 token"
            />
            <small>Bing Webmaster Tools.</small>
          </label>
          <label>
            <span>Pinterest</span>
            <input
              type="text"
              name="seoVerPinterest"
              value={seo.verification?.pinterest || ""}
              placeholder="p:domain_verify token"
            />
            <small>Pinterest domain verification.</small>
          </label>
          <label>
            <span>Yandex</span>
            <input
              type="text"
              name="seoVerYandex"
              value={seo.verification?.yandex || ""}
              placeholder="yandex-verification token"
            />
            <small>Yandex Webmaster.</small>
          </label>
          </div>
          </details>
        </div>
      </section>

      <section class="form-section" id="privacy">
        <h3>Privacy &amp; Cookies</h3>
        <p class="section-description">The facts your site's privacy and cookie policy pages need, served to your site as <code>site.privacy</code>. Disclosure only: Marvin does not show a consent banner. Leave this section empty to publish nothing.</p>
        <div class="subgroups">
          <details class="subgroup" open>
            <summary class="subgroup-label">Controller</summary>
            <div class="form-grid">
          <label>
            <span>Legal name</span>
            <input type="text" data-p="controller.legalName" value={privacyController.legalName || ""} />
          </label>
          <label>
            <span>Contact email</span>
            <input type="email" data-p="controller.contactEmail" value={privacyController.contactEmail || ""} placeholder="privacy@example.com" />
          </label>
          <label class="span-2">
            <span>Address</span>
            <input type="text" data-p="controller.address" value={privacyController.address || ""} />
          </label>
          <label>
            <span>EU representative</span>
            <input type="text" data-p="controller.euRepresentative" value={privacyController.euRepresentative || ""} />
            <small>Only if you are outside the EU but serve EU visitors.</small>
          </label>
          <label>
            <span>Data protection officer email</span>
            <input type="email" data-p="controller.dpoEmail" value={privacyController.dpoEmail || ""} />
          </label>

          </div>
          </details>
          <details class="subgroup" open>
            <summary class="subgroup-label">Processors</summary>
            <div class="form-grid">
          <div class="span-2 repeat-list" id="privacy-processors" data-initial={JSON.stringify(privacyProcessors)}></div>
          <div class="span-2"><button type="button" class="button secondary" data-add="processors">Add processor</button></div>

          </div>
          </details>
          <details class="subgroup" open>
            <summary class="subgroup-label">Cookies</summary>
            <div class="form-grid">
          <div class="span-2 repeat-list" id="privacy-cookies" data-initial={JSON.stringify(privacyCookies)}></div>
          <div class="span-2"><button type="button" class="button secondary" data-add="cookies">Add cookie</button></div>
          <p class="span-2 banner-required">
            <span>Consent banner required:</span> <strong id="privacy-banner-required">{bannerRequired ? "yes" : "no"}</strong>
            <small>Derived from the cookies above: yes when any cookie is not "necessary".</small>
          </p>

          </div>
          </details>
          <details class="subgroup" open>
            <summary class="subgroup-label">Policy pages</summary>
            <div class="form-grid">
          <label>
            <span>Privacy policy entry slug</span>
            <input type="text" data-p="consent.policyEntrySlug" value={privacyConsent.policyEntrySlug || ""} />
          </label>
          <label>
            <span>Cookie policy entry slug</span>
            <input type="text" data-p="consent.cookiePolicyEntrySlug" value={privacyConsent.cookiePolicyEntrySlug || ""} />
          </label>
          <label>
            <span>Last reviewed</span>
            <input type="date" data-p="consent.lastReviewed" value={privacyConsent.lastReviewed || ""} />
          </label>
          </div>
          </details>
        </div>

        <template id="tpl-processors">
          <div class="repeat-row" data-row>
            <label><span>Name</span><input type="text" data-f="name" /></label>
            <label><span>Purpose</span><input type="text" data-f="purpose" /></label>
            <label class="span-2"><span>Data categories</span><input type="text" data-f="dataCategories" placeholder="email, IP address" /><small>Comma-separated.</small></label>
            <label><span>Region</span><input type="text" data-f="region" placeholder="EU, Germany, US" /></label>
            <label>
              <span>Transfer basis</span>
              <input type="text" data-f="transferBasis" placeholder="SCCs, adequacy decision" />
              <small>Required when the region is outside the EU/EEA.</small>
            </label>
            <label><span>DPA URL</span><input type="url" data-f="dpaUrl" /></label>
            <label><span>Privacy policy URL</span><input type="url" data-f="privacyUrl" /></label>
            <div class="span-2"><button type="button" class="button secondary" data-remove>Remove processor</button></div>
          </div>
        </template>

        <template id="tpl-cookies">
          <div class="repeat-row" data-row>
            <label><span>Name</span><input type="text" data-f="name" /></label>
            <label><span>Provider</span><input type="text" data-f="provider" /></label>
            <label class="span-2"><span>Purpose</span><input type="text" data-f="purpose" /></label>
            <label><span>Duration</span><input type="text" data-f="duration" placeholder="session, 1 year" /></label>
            <label>
              <span>Category</span>
              <select data-f="category">
                {COOKIE_CATEGORIES.map((c) => <option value={c}>{c}</option>)}
              </select>
            </label>
            <div class="span-2"><button type="button" class="button secondary" data-remove>Remove cookie</button></div>
          </div>
        </template>
      </section>

      <section class="form-section" id="embeds">
        <h3>Embeds &amp; Privacy</h3>
        <p class="section-description">How your site shows media players for video, music and podcast links in your content.</p>
        <div class="form-grid">
          <label class="span-2">
            <span>Loading players</span>
            <select name="embedsMode">
              <option value="click_to_load" selected={embedsMode === "click_to_load"}>Click to load — recommended</option>
              <option value="direct" selected={embedsMode === "direct"}>Load players directly</option>
            </select>
            <small>
              <strong>Click to load</strong> shows a placeholder with a play button; nothing is fetched from the provider (and no
              third-party cookies are set) until the visitor clicks. <strong>Load players directly</strong> embeds the player
              straight away — convenient, but the provider sees every page view.
            </small>
          </label>
          <label class="span-2">
            <span>Consent text</span>
            <textarea
              name="embedsConsentText"
              rows="2"
              placeholder={DEFAULT_CONSENT_TEXT}
            >{embeds.consentText || ""}</textarea>
            <small>Shown on click-to-load placeholders. <code>{"{provider}"}</code> is replaced with the provider's name. Leave blank for the default.</small>
          </label>
          {embedProviderNames.length > 0 && (
            <p class="span-2 embed-providers">
              <span>Supported providers:</span> {embedProviderNames.join(", ")}
            </p>
          )}
        </div>
      </section>

      <section class="form-section">
        <h3>Advanced Metadata</h3>
        <p class="section-description">Custom metadata for framework-specific settings, social links, analytics, etc. SEO, privacy &amp; cookies and embeds are managed in the sections above.</p>
        <div class="form-grid">
          <label class="span-2">
            <span>Custom Metadata (JSON)</span>
            <textarea
              id="metadata-editor"
              name="siteMetadataJson"
              rows="10"
              placeholder='{"social": {"instagram": "...", "twitter": "..."}, "seo": {"image": "..."}, "analytics": {"id": "..."}}'
              class="metadata-editor"
            >{metadataEditorValue}</textarea>
            <small>Additional metadata for your publishing framework. Include social links under "social" key.</small>

            {(() => {
              if (Object.keys(metaForDisplay).length > 0) {
                return (
                  <div class="metadata-preview">
                    <p class="metadata-preview-title">Current Metadata:</p>
                    <dl class="metadata-preview-list">
                      {Object.entries(metaForDisplay).map(([key, value]) => (
                        <div class="metadata-preview-item">
                          <dt>{key}</dt>
                          <dd>{typeof value === 'object' ? JSON.stringify(value, null, 2) : String(value)}</dd>
                        </div>
                      ))}
                    </dl>
                  </div>
                );
              }
              return null;
            })()}
          </label>
        </div>
      </section>

      <div class="form-actions">
        <button type="submit" class="button">Save Site Configuration</button>
        <a href="/publishing/clients" class="button secondary">Manage Clients</a>
      </div>
    </form>
  ) : !error && (
    <div class="empty-state">
      <p>Loading site configuration...</p>
    </div>
  )}
</AppLayout>

<script>
  import { bindMetadataPreview } from '@/lib/metadataPreview';
  import { probeSiteLinks } from '@/lib/api/siteLinks';

  // The zones this browser knows, as suggestions for the free-text Timezone field: a mistyped zone falls back to the
  // default in workflow waits without a word, so pick from the list.
  const tzList = document.getElementById('tz-list');
  const intlTz = Intl as any;
  if (tzList && typeof intlTz.supportedValuesOf === 'function') {
    for (const zone of intlTz.supportedValuesOf('timeZone') as string[]) {
      const opt = document.createElement('option');
      opt.value = zone;
      tzList.appendChild(opt);
    }
  }

  // Site links: the live check fetches one published entry per type, so it runs on a click (never on load).
  const probeBtn = document.getElementById('site-links-probe-btn') as HTMLButtonElement | null;
  if (probeBtn) {
    probeBtn.addEventListener('click', async () => {
      const workspaceId = document.getElementById('site-links')?.dataset.workspaceId;
      const note = document.getElementById('site-links-probe-note');
      const results = document.getElementById('site-links-probe-results');
      if (!workspaceId || !note || !results) return;
      probeBtn.disabled = true;
      note.textContent = 'Checking…';
      results.replaceChildren();
      try {
        const { problems } = await probeSiteLinks(workspaceId);
        note.textContent = problems.length ? 'These links did not answer 200:' : 'Every link answered 200.';
        for (const p of problems) {
          const li = document.createElement('li');
          const text = document.createElement('span');
          text.textContent = p.message;
          const link = document.createElement('a');
          link.className = 'sl-fix';
          link.href = p.fix.path;
          link.textContent = `${p.fix.label} →`;
          li.append(text, link);
          results.appendChild(li);
        }
      } catch (err) {
        note.textContent = 'Error: ' + (err instanceof Error ? err.message : 'The check failed');
      }
      probeBtn.disabled = false;
    });
  }


  // HttpOnly cookie is automatically sent with credentials: 'include'
  const form = document.getElementById('site-form') as HTMLFormElement;
  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const workspaceId = form.dataset.workspaceId;
      if (!workspaceId) {
        alert('Workspace ID not found');
        return;
      }

      const formData = new FormData(form);
      const data: Record<string, any> = {};

      // Gather the structured SEO fields into a single seo object (stored under metadata.seo).
      const seoFieldMap: Record<string, string> = {
        seoTitle: 'title',
        seoTitleTemplate: 'titleTemplate',
        seoDescription: 'description',
        seoRobots: 'robots',
        seoImage: 'image',
        seoImageAlt: 'imageAlt',
        seoOgType: 'ogType',
        seoSiteName: 'siteName',
        seoTwitterCard: 'twitterCard',
        seoTwitterHandle: 'twitterHandle',
        seoTwitterCreator: 'twitterCreator',
        seoFbAppId: 'fbAppId',
        seoThemeColor: 'themeColor',
        seoPublisher: 'publisher',
      };
      const seo: Record<string, any> = {};
      for (const [field, key] of Object.entries(seoFieldMap)) {
        const v = (formData.get(field) as string | null)?.trim();
        if (v) seo[key] = v;
      }
      const keywordsRaw = (formData.get('seoKeywords') as string | null)?.trim();
      if (keywordsRaw) {
        const kw = keywordsRaw.split(',').map((k) => k.trim()).filter(Boolean);
        if (kw.length) seo.keywords = kw;
      }
      // Search-engine verification tokens nest under seo.verification.
      const verFieldMap: Record<string, string> = {
        seoVerGoogle: 'google',
        seoVerBing: 'bing',
        seoVerPinterest: 'pinterest',
        seoVerYandex: 'yandex',
      };
      const verification: Record<string, any> = {};
      for (const [field, key] of Object.entries(verFieldMap)) {
        const v = (formData.get(field) as string | null)?.trim();
        if (v) verification[key] = v;
      }
      if (Object.keys(verification).length > 0) seo.verification = verification;

      const seoKeys = new Set([
        ...Object.keys(seoFieldMap),
        ...Object.keys(verFieldMap),
        'seoKeywords',
        'embedsMode',
        'embedsConsentText',
      ]);

      // Embeds & privacy (stored under metadata.embeds); the mode always has a value.
      const embeds = {
        mode: formData.get('embedsMode') === 'direct' ? 'direct' : 'click_to_load',
        consentText: (formData.get('embedsConsentText') as string | null)?.trim() || null,
      };

      // Privacy & cookies (stored under metadata.privacy); dropped entirely when nothing is filled in.
      const privacy = collectPrivacy(form);
      if (privacy && (!privacy.controller.legalName || !privacy.controller.contactEmail)) {
        alert('Privacy & cookies: a legal name and contact email are required for the controller.');
        return;
      }

      // Parse the raw metadata editor (everything except seo, privacy and embeds, which the sections above own).
      let metadataObj: Record<string, any> = {};
      const rawMeta = formData.get('siteMetadataJson') as string | null;
      if (rawMeta) {
        try {
          metadataObj = JSON.parse(rawMeta) || {};
        } catch {
          metadataObj = {};
        }
      }

      // social is persisted separately for backward compatibility.
      if (metadataObj.social) {
        data['siteSocialJson'] = metadataObj.social;
        delete metadataObj.social;
      } else {
        data['siteSocialJson'] = null;
      }

      // Fold structured SEO back into metadata (drop it entirely when empty).
      if (Object.keys(seo).length > 0) {
        metadataObj.seo = seo;
      } else {
        delete metadataObj.seo;
      }
      if (privacy) {
        metadataObj.privacy = privacy;
      } else {
        delete metadataObj.privacy;
      }
      metadataObj.embeds = embeds;
      data['siteMetadataJson'] = Object.keys(metadataObj).length > 0 ? metadataObj : null;

      // Remaining simple string fields.
      formData.forEach((value, key) => {
        if (key === 'siteMetadataJson' || seoKeys.has(key)) return;
        data[key] = value || null;
      });

      try {
        const { createSdkClient } = await import('@/lib/sdk');
        const sdk = createSdkClient();

        await sdk.workspaces.updatePreferences(workspaceId, data);

        window.location.href = '/publishing/site?success=1';
      } catch (err) {
        const errorMessage = err instanceof Error ? err.message : 'Failed to save';
        window.location.href = '/publishing/site?error=' + encodeURIComponent(errorMessage);
      }
    });
  }

  // ---- Privacy & cookies: repeatable rows (plain DOM; the row markup lives in the <template>s) ----
  type Row = Record<string, any>;

  function rowFields(row: Element): (HTMLInputElement | HTMLSelectElement)[] {
    return Array.from(row.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[data-f]'));
  }

  function addRow(kind: string, values: Row = {}) {
    const tpl = document.getElementById('tpl-' + kind) as HTMLTemplateElement | null;
    const list = document.getElementById('privacy-' + kind);
    if (!tpl || !list) return;
    const row = (tpl.content.firstElementChild as HTMLElement).cloneNode(true) as HTMLElement;
    for (const el of rowFields(row)) {
      const v = values[el.dataset.f as string];
      if (v !== undefined && v !== null) el.value = Array.isArray(v) ? v.join(', ') : String(v);
    }
    list.appendChild(row);
  }

  // A row counts only when a text box has something in it (a fresh cookie row already has a category).
  function readRows(kind: string): Row[] {
    const rows: Row[] = [];
    document.querySelectorAll('#privacy-' + kind + ' [data-row]').forEach((row) => {
      const out: Row = {};
      let filled = false;
      for (const el of rowFields(row)) {
        const key = el.dataset.f as string;
        const v = el.value.trim();
        if (el instanceof HTMLInputElement && v) filled = true;
        if (!v) continue;
        out[key] = key === 'dataCategories' ? v.split(',').map((c) => c.trim()).filter(Boolean) : v;
      }
      if (filled) rows.push(out);
    });
    return rows;
  }

  // Same rule as the API's derived bannerRequired: any cookie that is not "necessary".
  function refreshBanner() {
    const out = document.getElementById('privacy-banner-required');
    if (out) out.textContent = readRows('cookies').some((c) => c.category !== 'necessary') ? 'yes' : 'no';
  }

  function collectPrivacy(scope: HTMLFormElement) {
    const groups: Record<string, Row> = { controller: {}, consent: {} };
    scope.querySelectorAll<HTMLInputElement>('[data-p]').forEach((el) => {
      const [group, key] = (el.dataset.p as string).split('.');
      const v = el.value.trim();
      if (v) groups[group][key] = v;
    });
    const processors = readRows('processors');
    const cookies = readRows('cookies');
    const empty =
      Object.keys(groups.controller).length === 0 &&
      Object.keys(groups.consent).length === 0 &&
      processors.length === 0 &&
      cookies.length === 0;
    return empty ? null : { controller: groups.controller, processors, cookies, consent: groups.consent };
  }

  for (const kind of ['processors', 'cookies']) {
    const list = document.getElementById('privacy-' + kind);
    if (!list) continue;
    try {
      for (const values of JSON.parse(list.dataset.initial || '[]')) addRow(kind, values);
    } catch {
      /* a malformed stored block just starts with no rows */
    }
    list.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('[data-remove]');
      if (btn) {
        btn.closest('[data-row]')?.remove();
        refreshBanner();
      }
    });
    list.addEventListener('input', refreshBanner);
  }
  document.querySelectorAll<HTMLElement>('[data-add]').forEach((btn) =>
    btn.addEventListener('click', () => {
      addRow(btn.dataset.add as string);
      refreshBanner();
    })
  );
  refreshBanner();

  // Metadata preview update
  const metadataEditor = document.getElementById('metadata-editor') as HTMLTextAreaElement | null;
  if (metadataEditor) {
    bindMetadataPreview(metadataEditor, '.form-grid', () => metadataEditor.closest('label')?.querySelector('small'));
  }
</script>

<style>
  /* A jump to a section or field (#seo, #privacy, #embeds, #site-links, #site-canonical-url) clears the sticky header. */
  .form-section[id], #site-canonical-url { scroll-margin-top: 80px; }
  .status-success { margin: 8px 0; color: var(--good, #16a34a); font-size: 14px; }
  /* Site links: problems as callouts (the many "no page URL pattern" ones folded into one, with a chip per type) */
  .sl-callout { display: grid; gap: 10px; margin: 10px 0; padding: 12px 14px; border: 1px solid var(--line); border-left: 3px solid var(--warn, #d97706); border-radius: var(--radius); background: var(--panel-2); font-size: 14px; color: var(--muted); }
  .sl-callout > span { color: var(--ink); }
  .sl-fix { color: var(--accent); font-size: 13px; text-decoration: none; justify-self: start; }
  .sl-chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .sl-chip { padding: 3px 10px; border: 1px solid var(--line); border-radius: 999px; background: var(--panel); color: var(--ink); font-size: 13px; text-decoration: none; }
  .sl-chip:hover { border-color: var(--accent); color: var(--accent); }
  .sl-probe { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; margin-top: 14px; }
  .sl-probe small { color: var(--muted); font-size: 13px; }
  .sl-results { list-style: none; margin: 8px 0 0; padding: 0; }
  .sl-results:empty { display: none; }
  .sl-results :global(li) { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 12px; padding: 8px 12px; border-left: 3px solid var(--color-error); background: var(--panel-2); border-radius: var(--radius); margin-top: 6px; font-size: 14px; overflow-wrap: anywhere; }
  .sl-results :global(.sl-fix) { color: var(--accent); font-size: 13px; text-decoration: none; }
  .toolbar {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 32px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--line);
  }



  .alert {
    padding: 16px;
    margin-bottom: 24px;
    border-radius: var(--radius);
    font-size: 14px;
  }

  .alert-success {
    background: rgb(53 122 85 / 0.1);
    color: var(--good);
    border: 1px solid var(--good);
  }

  .alert-error {
    background: var(--color-error-bg);
    color: var(--color-error);
    border: 1px solid var(--color-error);
  }

  .site-form {
    display: grid;
    gap: 32px;
  }

  .form-section {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 24px;
  }

  .form-section h3 {
    margin: 0 0 4px;
    font-size: 18px;
    font-weight: 600;
  }

  .section-description {
    margin: 0 0 20px;
    color: var(--muted);
    font-size: 14px;
  }

  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .form-grid label {
    display: grid;
    gap: 6px;
  }

  .form-grid label.span-2 {
    grid-column: 1 / -1;
  }

  /* A section's sub-groups (SEO: Search, Social sharing…; Privacy: Controller, Cookies…) are darker cards inside its
     grey card, the way the Agents page nests agents in its panels. */
  .subgroups { display: grid; gap: 12px; }
  .subgroups > .subgroup + .subgroup { margin-top: 0; } /* the grid's gap spaces them */


  .form-grid small code {
    font-size: 12px;
    padding: 1px 4px;
    background: var(--panel-2);
    border-radius: 3px;
  }

  .form-grid label > span {
    font-size: 14px;
    font-weight: 500;
    color: var(--ink);
  }

  .form-grid input,
  .form-grid textarea,
  .form-grid select {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--panel);
    font-size: 14px;
    color: var(--ink);
  }

  .form-grid input:focus,
  .form-grid textarea:focus,
  .form-grid select:focus {
    outline: none;
    border-color: var(--accent);
  }

  .form-grid textarea {
    resize: vertical;
    font-family: ui-monospace, monospace;
    font-size: 13px;
  }

  .form-grid small {
    font-size: 12px;
    color: var(--muted);
  }

  .repeat-list {
    display: grid;
    gap: 12px;
  }

  .repeat-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    padding: 12px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--panel); /* a row inside a darker sub-group: the levels alternate */
  }

  .repeat-row .span-2 {
    grid-column: 1 / -1;
  }

  .banner-required {
    margin: 0;
    font-size: 14px;
  }

  .banner-required small {
    display: block;
  }

  .embed-providers {
    grid-column: 1 / -1;
    margin: 0;
    font-size: 13px;
    color: var(--muted);
  }

  .embed-providers span {
    font-weight: 500;
    color: var(--ink);
  }

  .form-actions {
    display: flex;
    gap: 12px;
    padding-top: 8px;
  }


  .metadata-preview {
    margin-top: 1rem;
    padding: 1rem;
    background: var(--panel-2);
    border-radius: 6px;
  }

  .metadata-preview-title {
    margin: 0 0 0.75rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .metadata-preview-list {
    display: grid;
    gap: 0.75rem;
    margin: 0;
  }

  .metadata-preview-item {
    padding: 0.5rem;
    background: var(--bg);
    border-radius: 4px;
  }

  .metadata-preview-item dt {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 0.25rem;
  }

  .metadata-preview-item dd {
    margin: 0;
    font-size: 0.875rem;
    word-break: break-word;
    white-space: pre-wrap;
    font-family: monospace;
  }
</style>
