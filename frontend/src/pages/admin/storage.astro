---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { getStorageSettings, type StorageSettings } from "@/lib/api/admin/storage";
import { getAuthToken } from "@/lib/api/client";
import { requireAdmin } from "@/lib/auth";

await requireAdmin(Astro.cookies, Astro.redirect, Astro.url.pathname);
const authToken = getAuthToken(Astro.cookies);

let storage: StorageSettings | null = null;
let error: string | null = null;
try {
  storage = await getStorageSettings(authToken);
} catch (e) {
  console.error("[admin/storage] Failed to load:", e);
  error = e instanceof Error ? e.message : String(e);
}

const SOURCES: Record<string, string> = { builtin: "Built in", core: "Core (until the plugin)" };
const sourceLabel = (s: string) => SOURCES[s] ?? (s ? `Plugin: ${s}` : "Not installed");
const size = (n: number) =>
  n >= 1024 ** 3
    ? `${(n / 1024 ** 3).toFixed(2)} GB`
    : n >= 1024 ** 2
      ? `${(n / 1024 ** 2).toFixed(1)} MB`
      : `${(n / 1024).toFixed(1)} KB`;
const selected = storage ? (storage.uploadProvider ?? "") : "";
const nameOf = (slug: string) => storage?.providers.find((p) => p.slug === slug)?.name ?? slug;
---

<AdminLayout crumb="admin.storage">
  <div class="toolbar">
    <div>
      <h2>Asset Storage</h2>
      <p>Where new uploads are stored, and how many files live on each provider.</p>
    </div>
  </div>

  {error && <div class="alert error">Could not load storage settings: {error}</div>}

  {storage && (
    <div class="page-container">
      {storage.warning && (
        <div class="alert error" role="alert" data-testid="storage-warning"><strong>Uploads are falling back.</strong> {storage.warning}</div>
      )}

      <form id="storage-form" class="settings-section">
        <h3>New uploads go to</h3>
        <p>
          Switching only decides where <strong>new</strong> uploads are stored, and you can switch back at any time.
          Existing files keep serving from the provider they were stored on; moving them is
          <code>python -m marvin.scripts.storage_migrate --to &lt;provider&gt; --rekey</code> (see the "Assets on R2" runbook).
        </p>
        <fieldset class="choices">
          <label class="choice">
            <input type="radio" name="uploadProvider" value="" checked={selected === ""} />
            <span>
              <strong>Default</strong> — follow <code>STORAGE_PROVIDER</code> (<code>{storage.envDefault}</code>)
            </span>
          </label>
          {storage.providers.filter((p) => p.source).map((p) => (
            <label class:list={["choice", { disabled: !p.available }]}>
              <input type="radio" name="uploadProvider" value={p.slug} checked={selected === p.slug} disabled={!p.available && selected !== p.slug} />
              <span>
                <strong>{p.name}</strong> <code>{p.slug}</code>
                {!p.available && <span class="muted"> — unavailable: {p.error}</span>}
              </span>
            </label>
          ))}
        </fieldset>
        <p class="now">
          Now: new uploads go to <strong>{nameOf(storage.effectiveProvider)}</strong> (<code>{storage.effectiveProvider}</code>)
          {storage.warning
            ? ` — STORAGE_PROVIDER, because ${storage.uploadProvider} is unavailable.`
            : storage.uploadProvider
              ? " — chosen here."
              : " — STORAGE_PROVIDER."}
        </p>
        <div class="form-actions">
          <button type="submit" id="storage-save" class="button">Save</button>
          <span id="storage-status" class="status-text" role="status"></span>
        </div>
      </form>

      <section class="settings-section">
        <h3>Files per provider</h3>
        <table class="table">
          <thead>
            <tr><th>Provider</th><th>Source</th><th class="num">Assets</th><th class="num">Size</th><th class="num">Library files</th></tr>
          </thead>
          <tbody>
            {storage.providers.map((p) => (
              <tr>
                <td><strong>{p.name}</strong> <code>{p.slug}</code></td>
                <td>{sourceLabel(p.source)}</td>
                <td class="num">{p.assets}</td>
                <td class="num">{size(p.bytes)}</td>
                <td class="num">{p.libraryFiles}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>

      <section class="settings-section" data-testid="provider-settings">
        <h3>Provider settings</h3>
        <p>
          What each provider is using, as this backend reads it from its environment (the chart): read-only here.
          Secrets read <code>****</code>; key ids show their last four characters, to tell which key is in use.{" "}
          <strong>Test connection</strong> lists, writes, reads back and deletes a tiny object under
          <code>_marvin-healthcheck/</code>, and says which step failed and why.
        </p>
        {storage.providers.filter((p) => p.source).map((p) => (
          <div class="provider-card" data-provider={p.slug}>
            <div class="provider-head">
              <strong>{p.name}</strong> <code>{p.slug}</code>
              {!p.available && <span class="muted"> — unavailable: {p.error}</span>}
              <button type="button" class="button secondary test-btn" data-slug={p.slug}>Test connection</button>
            </div>
            {p.settings.length > 0 ? (
              <dl class="settings-list">
                {p.settings.map((s) => (
                  <>
                    <dt title={s.help || undefined}>{s.label} <code class="env">{s.env}</code></dt>
                    <dd>
                      {s.value === null ? <span class="muted">not set</span> : <code class:list={[{ secret: s.secret }]}>{s.value}</code>}
                      {s.value !== null && !s.isSet && <span class="muted"> (default)</span>}
                    </dd>
                  </>
                ))}
              </dl>
            ) : (
              <p class="muted">No settings.</p>
            )}
            <div class="test-result" role="status" aria-live="polite" hidden></div>
          </div>
        ))}
      </section>

      <section class="settings-section" data-testid="backup-targets">
        <h3>Backup targets</h3>
        <p>
          The backup CronJobs (<code>backup.targets[]</code>) have their own environment, which this backend doesn't
          see: what's below is what each target's latest run reported (no keys). Their health, schedule and recent
          runs are on <a href="/admin/backup-health">Backup health</a>. To test a target's key, run
          <code>python -m marvin.scripts.backup test</code> as a Job (the "Off-site backup" runbook).
        </p>
        {storage.backupTargets.length === 0 ? (
          <p class="muted">No backup run has reported yet.</p>
        ) : (
          <div class="table-scroll">
            <table class="table">
              <thead>
                <tr><th>Target</th><th>Writes to</th><th>Settings</th><th>State</th></tr>
              </thead>
              <tbody>
                {storage.backupTargets.map((t) => (
                  <tr>
                    <td><strong>{t.name}</strong> <code>{t.type}</code></td>
                    <td><code>{t.location ?? "—"}</code></td>
                    <td>
                      {t.settings.length === 0 ? "—" : (
                        <ul class="plain">
                          {t.settings.map((s) => <li><code class="env">{s.env}</code> <code>{s.value ?? "—"}</code></li>)}
                        </ul>
                      )}
                    </td>
                    <td><a href={`/admin/backup-health?target=${encodeURIComponent(t.name)}`} class:list={["state", t.state]}>{t.state}</a></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </section>

      <section class="settings-section" data-testid="workspace-domains">
        <h3>Workspace keys and public domains</h3>
        <p>
          New files are stored as <code>&lt;prefix&gt;/&lt;yyyy&gt;/&lt;mm&gt;/&lt;uuid&gt;.&lt;ext&gt;</code>: the prefix is a fixed,
          random code per workspace, so URLs show neither the workspace nor the file's name. A workspace can serve
          its files on a remote provider from its own domain, which must serve the same bucket (an R2 custom domain
          or a Cloudflare for SaaS hostname; see the "Assets on R2" runbook). Empty uses the platform default
          {storage.remotePublicBaseUrl ? <code>{storage.remotePublicBaseUrl}</code> : <span>(<code>STORAGE_REMOTE_PUBLIC_URL</code>, not set)</span>}.
          Files on local disk always use the API host.
        </p>
        <div class="table-scroll">
        <table class="table">
          <thead>
            <tr><th>Workspace</th><th>Key prefix</th><th>Public asset domain</th><th></th></tr>
          </thead>
          <tbody>
            {storage.workspaceSettings.map((w) => (
              <tr data-workspace-id={w.workspaceId}>
                <td><a href={`/admin/groups/${w.workspaceId}`}>{w.workspace}</a></td>
                <td><code>{w.storageCode ?? "—"}</code></td>
                <td>
                  <input
                    class="domain-input"
                    type="url"
                    inputmode="url"
                    placeholder={storage.remotePublicBaseUrl ?? "https://assets.example.com"}
                    value={w.assetPublicBaseUrl ?? ""}
                    aria-label={`Public asset domain for ${w.workspace}`}
                  />
                  <span class="status-text domain-status" role="status"></span>
                </td>
                <td class="row-actions">
                  <button type="button" class="button domain-save">Save</button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
        </div>
      </section>

      <section class="settings-section">
        <h3>By workspace</h3>
        {storage.workspaces.length === 0 ? (
          <p>No assets yet.</p>
        ) : (
          <table class="table">
            <thead>
              <tr><th>Workspace</th><th>Provider</th><th class="num">Assets</th><th class="num">Size</th></tr>
            </thead>
            <tbody>
              {storage.workspaces.map((w) => (
                <tr>
                  <td><a href={`/admin/groups/${w.workspaceId}`}>{w.workspace}</a></td>
                  <td><code>{w.provider}</code></td>
                  <td class="num">{w.assets}</td>
                  <td class="num">{size(w.bytes)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        )}
      </section>
    </div>
  )}
</AdminLayout>

<script>
  import { testStorageProvider, updateStorageSettings, updateWorkspaceStorage } from "@/lib/api/admin/storage";

  // Test connection: one line per step (list, put, get, delete), built with textContent only.
  for (const button of document.querySelectorAll<HTMLButtonElement>(".test-btn")) {
    const card = button.closest<HTMLElement>(".provider-card");
    const out = card?.querySelector<HTMLElement>(".test-result");
    const slug = button.dataset.slug;
    if (!out || !slug) continue;
    button.addEventListener("click", async () => {
      button.disabled = true;
      out.hidden = false;
      out.className = "test-result";
      out.textContent = "Testing…";
      try {
        const result = await testStorageProvider(slug);
        out.textContent = "";
        out.classList.add(result.ok ? "ok" : "fail");
        const head = document.createElement("strong");
        head.textContent = result.ok ? "Connection OK" : "Connection failed";
        out.append(head);
        if (result.location) out.append(` — ${result.location}`);
        const list = document.createElement("ul");
        for (const step of result.steps) {
          const li = document.createElement("li");
          li.className = step.ok ? "ok" : "fail";
          li.textContent = `${step.ok ? "✓" : "✗"} ${step.name} — ${step.ok ? "ok" : (step.error ?? "failed")}${step.code ? ` (${step.code})` : ""} · ${step.ms < 1 ? "<1" : Math.round(step.ms)} ms`;
          list.append(li);
        }
        out.append(list);
      } catch (err) {
        out.classList.add("fail");
        out.textContent = `Error: ${err instanceof Error ? err.message : "test failed"}`;
      } finally {
        button.disabled = false;
      }
    });
  }

  for (const row of document.querySelectorAll<HTMLTableRowElement>("tr[data-workspace-id]")) {
    const input = row.querySelector<HTMLInputElement>(".domain-input");
    const button = row.querySelector<HTMLButtonElement>(".domain-save");
    const status = row.querySelector<HTMLElement>(".domain-status");
    const id = row.dataset.workspaceId;
    if (!input || !button || !id) continue;
    button.addEventListener("click", async () => {
      button.disabled = true;
      if (status) status.textContent = "Saving…";
      try {
        const saved = await updateWorkspaceStorage(id, input.value.trim() || null);
        const mine = saved.workspaceSettings.find((w) => w.workspaceId === id);
        input.value = mine?.assetPublicBaseUrl ?? "";
        if (status) status.textContent = "Saved";
      } catch (err) {
        if (status) status.textContent = "Error: " + (err instanceof Error ? err.message : "save failed");
      } finally {
        button.disabled = false;
      }
    });
  }

  const form = document.getElementById("storage-form") as HTMLFormElement | null;
  const saveBtn = document.getElementById("storage-save") as HTMLButtonElement | null;
  const statusEl = document.getElementById("storage-status");

  if (form && saveBtn) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const value = (new FormData(form).get("uploadProvider") as string | null) || null;
      saveBtn.disabled = true;
      if (statusEl) statusEl.textContent = "Saving…";
      try {
        await updateStorageSettings(value);
        window.location.reload();
      } catch (err) {
        if (statusEl) statusEl.textContent = "Error: " + (err instanceof Error ? err.message : "save failed");
        saveBtn.disabled = false;
      }
    });
  }
</script>

<style>
  .page-container {
    max-width: 900px;
  }
  .settings-section {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 24px;
    margin-bottom: 24px;
  }
  .settings-section h3 {
    margin: 0 0 8px;
    font-size: 18px;
    font-weight: 600;
  }
  .settings-section > p {
    margin: 0 0 16px;
    color: var(--muted);
    font-size: 14px;
  }
  .choices {
    border: 0;
    padding: 0;
    margin: 0 0 12px;
    display: grid;
    gap: 10px;
  }
  .choice {
    display: flex;
    gap: 10px;
    align-items: baseline;
    cursor: pointer;
  }
  .choice.disabled {
    cursor: not-allowed;
    opacity: 0.7;
  }
  .muted {
    color: var(--muted);
    font-size: 13px;
  }
  .now {
    font-size: 14px;
  }
  .form-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }
  .status-text {
    font-size: 13px;
    color: var(--muted);
  }
  .table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }
  .table th,
  .table td {
    text-align: left;
    padding: 8px 6px;
    border-bottom: 1px solid var(--line);
  }
  .table .num {
    text-align: right;
  }
  .table-scroll {
    overflow-x: auto;
  }
  .domain-status {
    display: block;
    margin-top: 4px;
  }
  .domain-status:empty {
    display: none;
  }
  .domain-input {
    width: 100%;
    min-width: 180px;
    padding: 6px 8px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--panel);
    color: inherit;
    font: inherit;
  }
  .row-actions {
    white-space: nowrap;
  }
  .provider-card {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 14px 16px;
    margin-bottom: 12px;
  }
  .provider-head {
    display: flex;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 10px;
  }
  .provider-head .test-btn {
    margin-left: auto;
  }
  .settings-list {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 6px 16px;
    margin: 0;
    font-size: 13px;
  }
  .settings-list dt {
    color: var(--muted);
  }
  .settings-list dd {
    margin: 0;
    min-width: 0;
    overflow-wrap: anywhere;
  }
  code.env {
    font-size: 11px;
    color: var(--muted);
  }
  code.secret {
    letter-spacing: 0.05em;
  }
  .test-result {
    margin-top: 12px;
    padding: 10px 12px;
    border-radius: var(--radius);
    background: var(--panel-2);
    font-size: 13px;
  }
  .test-result.ok {
    border-left: 3px solid var(--good);
  }
  .test-result.fail {
    border-left: 3px solid var(--color-error);
  }
  /* Built by the script, so without this component's scope attribute. */
  .test-result :global(ul) {
    margin: 6px 0 0;
    padding-left: 0;
    list-style: none;
  }
  .test-result :global(li.fail) {
    color: var(--color-error);
  }
  ul.plain {
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 12px;
  }
  .state.ok {
    color: var(--good);
  }
  .state.failed,
  .state.overdue {
    color: var(--color-error);
    font-weight: 600;
  }
  .state.partial {
    color: var(--warn);
  }
  .alert.error {
    padding: 12px 16px;
    border: 1px solid #c33;
    border-radius: var(--radius);
    color: #c33;
    margin-bottom: 16px;
  }
</style>
