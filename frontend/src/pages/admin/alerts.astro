---
// Admin → Alerts: which platform events (backups, storage, security) reach people outside Marvin, and how.
// Email to super admins and push are built in; "Platform channels" are the platform's own connections (Apprise
// first, belonging to no workspace) and any message-capable action on one can be added as a route. Server strings
// render through Astro's escaping ({...}); the script builds channel and route rows with textContent only.
import AdminLayout from "@/layouts/AdminLayout.astro";
import "@/styles/alert-settings.css";
import { deliveryBadge } from "@/lib/admin/platformAlerts";
import { getPlatformAlerts, type PlatformAlerts } from "@/lib/api/admin/platformAlerts";
import { getAuthToken } from "@/lib/api/client";
import { requireAdmin } from "@/lib/auth";

await requireAdmin(Astro.cookies, Astro.redirect, Astro.url.pathname);
const authToken = getAuthToken(Astro.cookies);

let data: PlatformAlerts | null = null;
let error: string | null = null;
try {
  data = await getPlatformAlerts(authToken);
} catch (e) {
  console.error("[admin/alerts] Failed to load:", e);
  error = e instanceof Error ? e.message : String(e);
}

const email = data?.email;
const emailBadge = deliveryBadge(email?.lastDelivery);
const push = data?.push?.configured ? data.push : null;
const pushBadge = deliveryBadge(push?.lastDelivery);
---

<AdminLayout crumb="admin.alerts">
  <div class="toolbar">
    <div>
      <h2>Platform Alerts</h2>
      <p>
        Platform events always show in a super admin's bell and on <a href="/admin/events">Events</a>. Choose which of them
        also go out by email, push or through a platform channel such as Apprise, so a failed backup reaches someone who isn't looking at Marvin.
        See <a href="/admin/backup-health">Backup health</a> for what the backup alerts mean.
      </p>
    </div>
  </div>

  {error && <div class="alert-settings-error" role="alert">Could not load platform alerts: {error}</div>}

  {data && email && (
    <form id="pa-form" class="alert-settings" novalidate>
      <section class="card">
        <h3>Which events alert</h3>
        <p class="lead">Each one is sent once, when it happens — a failing backup alerts once per incident, not on every retry.</p>
        <div class="kinds">
          {data.types.map((k) => (
            <label class="kind">
              <input type="checkbox" name="kind" value={k.key} checked={k.enabled} data-testid={`kind-${k.key}`} />
              <span>
                <strong>{k.label}</strong> <code class="small muted">{k.eventType}</code>
                <span class="muted small block">{k.description}</span>
              </span>
            </label>
          ))}
        </div>
      </section>

      <section class="card" data-testid="email-channel">
        <div class="channel-head">
          <h3>Email</h3>
          <label class="switch"><input type="checkbox" id="pa-email-enabled" checked={email.enabled} /> On</label>
        </div>
        {email.smtpReady ? (
          <p class="lead">
            Built in. Sent through the platform SMTP server (<a href="/admin/email-settings">Email settings</a>): the
            environment's settings, with anything an admin set there on top.
          </p>
        ) : (
          <p class="notice warn" role="status" data-testid="smtp-missing">
            <strong>Email isn't set up,</strong> so email alerts are recorded as not sent. Set the platform SMTP server
            on <a href="/admin/email-settings">Email settings</a> to start sending them.
          </p>
        )}
        <fieldset class="recipients">
          <legend>Send to</legend>
          <label class="radio">
            <input type="radio" name="pa-recipients" value="all" checked={email.recipients === null} />
            Every super admin{" "}
            <span class="muted small">
              ({email.superAdminEmails.length ? email.superAdminEmails.join(", ") : "none has an email address"})
            </span>
          </label>
          <label class="radio">
            <input type="radio" name="pa-recipients" value="list" checked={email.recipients !== null} />
            These addresses
          </label>
          <textarea id="pa-recipients-text" rows="3" placeholder="ops@example.com, one per line or comma-separated" aria-label="Email addresses">{(email.recipients ?? []).join("\n")}</textarea>
        </fieldset>
        <div class="channel-foot">
          <span class:list={["pill", emailBadge.tone]} id="pa-email-status">{emailBadge.label}</span>
          <span class="muted small" id="pa-email-detail">{emailBadge.detail}</span>
          <button type="button" class="button secondary small-btn" data-test-channel="email">Send test</button>
        </div>
      </section>

      {push && (
        <section class="card" data-testid="push-channel">
          <div class="channel-head">
            <h3>Push</h3>
            <label class="switch"><input type="checkbox" id="pa-push-enabled" checked={push.enabled} /> On</label>
          </div>
          <p class="lead">
            Built in. To the phones and browsers of super admins who turned notifications on with “Platform alerts” in
            their <a href="/user/profile#notifications">Profile</a>.{" "}
            <span class="muted small" data-testid="push-people">
              {push.people.length ? `Reaches: ${push.people.join(", ")}.` : "Nobody has turned it on yet."}
            </span>
          </p>
          <div class="channel-foot">
            <span class:list={["pill", pushBadge.tone]} id="pa-push-status">{pushBadge.label}</span>
            <span class="muted small" id="pa-push-detail">{pushBadge.detail}</span>
            <button type="button" class="button secondary small-btn" data-test-channel="push">Send test</button>
          </div>
        </section>
      )}

      <section class="card" data-testid="platform-channels">
        <h3>Platform channels</h3>
        {!data.integrationsAvailable ? (
          <p class="lead">The integrations framework isn't installed on this server, so only email and push can carry platform alerts.</p>
        ) : data.providers.length === 0 ? (
          <p class="notice warn" role="status" data-testid="no-providers">
            No installed plugin can send messages. Install the Apprise integration plugin to add channels; email and push still work.
          </p>
        ) : (
          <>
            <p class="lead">
              Where alerts go besides email and push. Add Apprise notification URLs — Slack, Discord, Telegram, ntfy and 100+ more — then
              choose the channel in a route below. Channels belong to the platform, not to any workspace.
            </p>
            <ul id="pa-channels" class="routes" aria-label="Platform channels"></ul>
            <div class="route channel-add" id="pa-channel-add" role="group" aria-label="Add a channel">
              <strong>Add a channel</strong>
              <label class="field" id="pa-ch-provider-wrap">
                <span class="small">Type</span>
                <select id="pa-ch-provider">
                  {data.providers.map((p) => <option value={p.slug}>{p.name}</option>)}
                </select>
              </label>
              <label class="field">
                <span class="small">Name</span>
                <input type="text" id="pa-ch-name" maxlength="100" placeholder="e.g. Phone pushes" autocomplete="off" />
              </label>
              <div id="pa-ch-config" class="config-fields"></div>
              <label class="field" id="pa-ch-cred-wrap">
                <span class="small" id="pa-ch-cred-label">Apprise URL(s)</span>
                <textarea id="pa-ch-cred" rows="3" autocomplete="off" spellcheck="false" placeholder="slack://…  one per line"></textarea>
                <span class="muted small" id="pa-ch-cred-help"></span>
              </label>
              <div class="channel-foot">
                <button type="button" class="button" id="pa-ch-add">Add channel</button>
                <span class="muted small" id="pa-ch-status" role="status"></span>
              </div>
            </div>
          </>
        )}
      </section>

      <section class="card" data-testid="integration-routes">
        <h3>Routes</h3>
        <p class="lead">
          A route sends each alert through one platform channel — Apprise's <em>Send notification</em>, Slack's <em>Send message</em>, or
          another plugin's message action. Adding a channel above adds its route here; save to start sending.
        </p>
        <ul id="pa-routes" class="routes" aria-label="Integration routes"></ul>
        <div class="add-route" id="pa-add-wrap" hidden>
          <label for="pa-add-target" class="small muted">Add a route</label>
          <select id="pa-add-target"></select>
          <button type="button" class="button secondary" id="pa-add">Add</button>
        </div>
      </section>

      <div class="form-actions">
        <button type="submit" class="button" id="pa-save">Save</button>
        <span id="pa-status" class="muted small" role="status"></span>
      </div>
    </form>
  )}

  <script is:inline type="application/json" id="pa-data" set:html={JSON.stringify(data ?? null).replace(/</g, "\\u003c")} />
</AdminLayout>

<script>
  import {
    buildUpdate,
    connectionPill,
    countUrls,
    deliveryBadge,
    draftFrom,
    dropRoutesOf,
    missingInputs,
    type RouteDraft,
    targetKey,
  } from "@/lib/admin/platformAlerts";
  import {
    createPlatformConnection,
    deletePlatformConnection,
    type PlatformAlertDelivery,
    type PlatformAlerts,
    type PlatformAlertTarget,
    type PlatformConnection,
    testPlatformAlert,
    testPlatformConnection,
    updatePlatformAlerts,
    updatePlatformConnection,
  } from "@/lib/api/admin/platformAlerts";

  const raw = document.getElementById("pa-data")?.textContent;
  let state: PlatformAlerts | null = raw ? JSON.parse(raw) : null;
  const form = document.getElementById("pa-form") as HTMLFormElement | null;
  const list = document.getElementById("pa-routes") as HTMLUListElement | null;
  const statusEl = document.getElementById("pa-status");

  if (state && form && list) {
    let routes: RouteDraft[] = state.routes.map(draftFrom);
    const targets = () => new Map<string, PlatformAlertTarget>((state?.targets ?? []).map((t) => [targetKey(t), t]));

    const el = <K extends keyof HTMLElementTagNameMap>(tag: K, cls?: string, text?: string) => {
      const node = document.createElement(tag);
      if (cls) node.className = cls;
      if (text !== undefined) node.textContent = text;
      return node;
    };

    const setStatus = (pill: HTMLElement, detail: HTMLElement, d: PlatformAlertDelivery | null | undefined) => {
      const b = deliveryBadge(d);
      pill.className = `pill ${b.tone}`;
      pill.textContent = b.label;
      detail.textContent = b.detail;
    };

    function render() {
      if (!list || !state) return;
      list.replaceChildren();
      const byKey = targets();
      routes.forEach((route, index) => {
        const saved = route.id ? state?.routes.find((r) => r.id === route.id) : undefined;
        const target = byKey.get(targetKey(route));
        const li = el("li", "route");
        li.dataset.testid = "route";

        const head = el("div", "route-head");
        const title = el("strong", "", saved?.label ?? (target ? `${target.integrationName} → ${target.actionLabel}` : route.action));
        const toggle = el("label", "switch");
        const box = el("input");
        box.type = "checkbox";
        box.checked = route.enabled;
        box.addEventListener("change", () => (route.enabled = box.checked));
        toggle.append(box, " On");
        const remove = el("button", "button secondary small-btn", "Remove");
        remove.type = "button";
        remove.addEventListener("click", () => {
          routes.splice(index, 1);
          render();
        });
        head.append(title, toggle, remove);
        li.append(head);

        if (saved?.problem) li.append(el("p", "notice warn small", saved.problem));

        for (const input of target?.inputs ?? []) {
          const field = el("label", "field");
          field.append(el("span", "small", input.label + (input.required ? " (required)" : "")));
          const box = el("input");
          box.type = "text";
          box.value = String(route.args[input.key] ?? "");
          box.required = input.required;
          box.placeholder = input.description || "";
          box.addEventListener("input", () => (route.args[input.key] = box.value));
          field.append(box);
          li.append(field);
        }
        if (target && target.inputs.length === 0) {
          li.append(el("p", "muted small", "No settings: the channel decides where its messages go."));
        }

        const foot = el("div", "channel-foot");
        const pill = el("span", "pill");
        const detail = el("span", "muted small");
        setStatus(pill, detail, saved?.lastDelivery);
        const test = el("button", "button secondary small-btn", "Send test");
        test.type = "button";
        if (route.id) test.dataset.testChannel = route.id;
        else {
          test.disabled = true;
          test.title = "Save first";
        }
        foot.append(pill, detail, test);
        li.append(foot);
        list.append(li);
      });
      if (routes.length === 0) list.append(el("li", "muted small", "No routes: alerts go out by email and push only."));
    }

    // ── the add-a-route picker follows the platform channels ──────────────────────
    const addWrap = document.getElementById("pa-add-wrap") as HTMLElement | null;
    const addSelect = document.getElementById("pa-add-target") as HTMLSelectElement | null;
    function renderTargetPicker() {
      if (!addSelect || !addWrap || !state) return;
      addSelect.replaceChildren(
        ...state.targets.map((t) => {
          const option = el("option", "", `${t.integrationName} → ${t.actionLabel} (${t.providerName})${t.connectionEnabled ? "" : " — channel off"}`);
          option.value = targetKey(t);
          return option;
        }),
      );
      addWrap.hidden = state.targets.length === 0;
    }

    // ── platform channels ───────────────────────────────────────────────────────────
    const channelList = document.getElementById("pa-channels") as HTMLUListElement | null;
    const chStatus = document.getElementById("pa-ch-status");

    /** A new state from a channel change: routes the server removed go from the drafts too. */
    function applyState(next: PlatformAlerts) {
      state = next;
      const savedIds = new Set(next.routes.map((r) => r.id));
      routes = dropRoutesOf(routes, next.connections).filter((r) => !r.id || savedIds.has(r.id));
      renderChannels();
      renderTargetPicker();
      render();
    }

    function channelRow(c: PlatformConnection): HTMLLIElement {
      const li = el("li", "route");
      li.dataset.testid = "channel";
      const head = el("div", "route-head");
      const pillInfo = connectionPill(c);
      const pill = el("span", `pill ${pillInfo.tone}`, pillInfo.label);
      head.append(el("strong", "", c.name), pill);
      li.append(head);
      const bits = [c.providerName, c.hasCredential ? "credential saved" : "no credential", `used by ${c.routes} route${c.routes === 1 ? "" : "s"}`];
      li.append(el("p", "muted small", bits.join(" · ")));

      const result = el("div", "channel-foot");
      const resultPill = el("span", "pill");
      resultPill.hidden = true;
      const resultText = el("span", "muted small");
      const note = (text: string, tone = "") => {
        resultPill.hidden = true;
        resultText.textContent = text;
        resultText.className = `muted small ${tone}`;
      };

      const actions = el("div", "channel-foot");
      const test = el("button", "button secondary small-btn", "Send test");
      test.type = "button";
      if (!c.available) {
        test.disabled = true;
        test.title = "Its plugin isn't installed";
      } else if (c.needsRouteInputs) {
        test.disabled = true;
        test.title = "It needs more than the message (a channel name): add a route, save, and test the route";
      }
      test.addEventListener("click", async () => {
        test.disabled = true;
        note("Sending…");
        try {
          const res = await testPlatformConnection(c.id);
          const b = deliveryBadge(res.delivery);
          resultPill.hidden = false;
          resultPill.className = `pill ${b.tone}`;
          resultPill.textContent = b.label;
          resultText.textContent = b.detail;
        } catch (err) {
          note(`Test failed: ${err instanceof Error ? err.message : String(err)}`, "err");
        } finally {
          test.disabled = !c.available || c.needsRouteInputs;
        }
      });
      const toggle = el("button", "button secondary small-btn", c.enabled ? "Turn off" : "Turn on");
      toggle.type = "button";
      toggle.addEventListener("click", async () => {
        toggle.disabled = true;
        try {
          applyState(await updatePlatformConnection(c.id, { enabled: !c.enabled }));
        } catch (err) {
          note(`Not changed: ${err instanceof Error ? err.message : String(err)}`, "err");
          toggle.disabled = false;
        }
      });
      const rotate = el("button", "button secondary small-btn", c.hasCredential ? "Replace URLs" : "Add URLs");
      rotate.type = "button";
      const remove = el("button", "button secondary small-btn", "Remove");
      remove.type = "button";
      remove.addEventListener("click", async () => {
        const used = c.routes ? ` Its ${c.routes} route${c.routes === 1 ? "" : "s"} will be removed too.` : "";
        if (!window.confirm(`Remove “${c.name}” and its saved credential?${used}`)) return;
        remove.disabled = true;
        try {
          applyState(await deletePlatformConnection(c.id));
          if (statusEl) statusEl.textContent = `Removed ${c.name}.`;
        } catch (err) {
          note(`Not removed: ${err instanceof Error ? err.message : String(err)}`, "err");
          remove.disabled = false;
        }
      });
      actions.append(test, toggle, rotate, remove);
      li.append(actions);

      const editor = el("div", "field");
      editor.hidden = true;
      const area = el("textarea");
      area.rows = 3;
      area.autocomplete = "off";
      area.spellcheck = false;
      area.placeholder = "New URLs, one per line — the saved ones are never shown";
      area.setAttribute("aria-label", `New credential for ${c.name}`);
      const saveRotate = el("button", "button small-btn", "Save");
      saveRotate.type = "button";
      saveRotate.addEventListener("click", async () => {
        if (!area.value.trim()) return;
        saveRotate.disabled = true;
        try {
          applyState(await updatePlatformConnection(c.id, { credential: area.value }));
          if (statusEl) statusEl.textContent = `Saved the new URLs for ${c.name}.`;
        } catch (err) {
          note(`Not saved: ${err instanceof Error ? err.message : String(err)}`, "err");
          saveRotate.disabled = false;
        }
      });
      editor.append(area, saveRotate);
      rotate.addEventListener("click", () => {
        editor.hidden = !editor.hidden;
        if (!editor.hidden) area.focus();
      });
      li.append(editor);
      result.append(resultPill, resultText);
      li.append(result);
      return li;
    }

    function renderChannels() {
      if (!channelList || !state) return;
      channelList.replaceChildren(...state.connections.map(channelRow));
      if (state.connections.length === 0) channelList.append(el("li", "muted small", "No channels yet."));
    }

    // The add-a-channel form: the provider decides the credential's label and any other settings.
    const provider = document.getElementById("pa-ch-provider") as HTMLSelectElement | null;
    const chName = document.getElementById("pa-ch-name") as HTMLInputElement | null;
    const chCred = document.getElementById("pa-ch-cred") as HTMLTextAreaElement | null;
    const chConfig = document.getElementById("pa-ch-config") as HTMLElement | null;

    function renderProviderFields() {
      const p = state?.providers.find((x) => x.slug === provider?.value);
      const credWrap = document.getElementById("pa-ch-cred-wrap");
      if (!p || !chConfig || !credWrap) return;
      credWrap.hidden = !p.credentialLabel;
      const label = document.getElementById("pa-ch-cred-label");
      if (label) label.textContent = (p.credentialLabel ?? "") + (p.credentialRequired ? "" : " (optional)");
      const help = document.getElementById("pa-ch-cred-help");
      if (help) help.textContent = p.credentialHelp;
      chConfig.replaceChildren(
        ...p.configFields.map((f) => {
          const field = el("label", "field");
          field.append(el("span", "small", f.label + (f.required ? " (required)" : "")));
          const input = el("input");
          input.type = "text";
          input.name = f.key;
          input.required = f.required;
          input.placeholder = f.description || "";
          field.append(input);
          return field;
        }),
      );
    }
    provider?.addEventListener("change", renderProviderFields);

    // Enter in the name box adds the channel; it must not submit the alert settings behind it.
    chName?.addEventListener("keydown", (e) => {
      if (e.key === "Enter") {
        e.preventDefault();
        document.getElementById("pa-ch-add")?.click();
      }
    });
    chCred?.addEventListener("input", () => {
      if (chStatus && provider?.value === "apprise") chStatus.textContent = chCred.value.trim() ? `${countUrls(chCred.value)} URL(s)` : "";
    });

    document.getElementById("pa-ch-add")?.addEventListener("click", async () => {
      if (!state || !provider || !chName || !chStatus) return;
      const button = document.getElementById("pa-ch-add") as HTMLButtonElement;
      const config: Record<string, string> = {};
      chConfig?.querySelectorAll<HTMLInputElement>("input").forEach((i) => {
        if (i.value.trim()) config[i.name] = i.value.trim();
      });
      const had = new Set(state.connections.map((c) => c.id));
      button.disabled = true;
      chStatus.textContent = "Adding…";
      try {
        const next = await createPlatformConnection({
          provider: provider.value,
          name: chName.value,
          config,
          credential: chCred?.value.trim() ? chCred.value : undefined,
        });
        const added = next.connections.find((c) => !had.has(c.id));
        applyState(next);
        // Its route is ready to save when the action needs nothing but the message.
        const target = added ? next.targets.find((t) => t.integrationId === added.id) : undefined;
        if (added && target && target.inputs.every((i) => !i.required)) {
          routes.push({ integrationId: target.integrationId, action: target.action, args: {}, enabled: true });
          render();
          chStatus.textContent = `Added ${added.name}. Its route is ready below: save to start sending alerts through it.`;
        } else {
          chStatus.textContent = added ? `Added ${added.name}. Add a route for it below.` : "Added.";
        }
        chName.value = "";
        if (chCred) chCred.value = "";
        chConfig?.querySelectorAll("input").forEach((i) => (i.value = ""));
      } catch (err) {
        chStatus.textContent = `Not added: ${err instanceof Error ? err.message : String(err)}`;
      } finally {
        button.disabled = false;
      }
    });

    renderChannels();
    renderProviderFields();
    renderTargetPicker();
    render();

    document.getElementById("pa-add")?.addEventListener("click", () => {
      const target = addSelect ? targets().get(addSelect.value) : undefined;
      if (!target) return;
      routes.push({ integrationId: target.integrationId, action: target.action, args: {}, enabled: true });
      render();
    });

    form.addEventListener("click", async (e) => {
      const button = (e.target as HTMLElement).closest<HTMLButtonElement>("button[data-test-channel]");
      if (!button) return;
      const channel = button.dataset.testChannel!;
      button.disabled = true;
      try {
        const res = await testPlatformAlert(channel);
        const holder = button.parentElement; // the channel's footer: its status pill and detail
        const pill = holder?.querySelector<HTMLElement>(".pill");
        const detail = holder?.querySelector<HTMLElement>(".muted.small");
        if (pill && detail) setStatus(pill, detail, res.delivery);
        if (state) {
          if (channel === "email") state.email.lastDelivery = res.delivery;
          else if (channel === "push") state.push.lastDelivery = res.delivery;
          else {
            const r = state.routes.find((x) => x.id === channel);
            if (r) r.lastDelivery = res.delivery;
          }
        }
      } catch (err) {
        if (statusEl) statusEl.textContent = `Test failed: ${err instanceof Error ? err.message : String(err)}`;
      } finally {
        button.disabled = false;
      }
    });

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!state || !statusEl) return;
      const byKey = targets();
      const missing = routes.flatMap((r) => missingInputs(byKey.get(targetKey(r)), r.args).map((m) => `${byKey.get(targetKey(r))?.integrationName}: ${m}`));
      if (missing.length) {
        statusEl.textContent = `Fill in: ${missing.join(", ")}`;
        return;
      }
      const types = Object.fromEntries(
        [...form.querySelectorAll<HTMLInputElement>('input[name="kind"]')].map((box) => [box.value, box.checked]),
      );
      const update = buildUpdate({
        types,
        emailEnabled: (document.getElementById("pa-email-enabled") as HTMLInputElement).checked,
        everySuperAdmin: (form.querySelector<HTMLInputElement>('input[name="pa-recipients"]:checked')?.value ?? "all") === "all",
        recipientsText: (document.getElementById("pa-recipients-text") as HTMLTextAreaElement).value,
        pushEnabled: (document.getElementById("pa-push-enabled") as HTMLInputElement | null)?.checked ?? null,
        routes,
      });
      const save = document.getElementById("pa-save") as HTMLButtonElement;
      save.disabled = true;
      statusEl.textContent = "Saving…";
      try {
        state = await updatePlatformAlerts(update);
        routes = state.routes.map(draftFrom);
        render();
        statusEl.textContent = "Saved.";
      } catch (err) {
        statusEl.textContent = `Not saved: ${err instanceof Error ? err.message : String(err)}`;
      } finally {
        save.disabled = false;
      }
    });
  }
</script>
