---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { getAuthToken } from "@/lib/api/client";
import { requireAdmin } from "@/lib/auth";
import { createSdkClient } from "@/lib/sdk";

// Require admin authentication
const user = await requireAdmin(Astro.cookies, Astro.redirect, Astro.url.pathname);
const authToken = getAuthToken(Astro.cookies);
const sdk = createSdkClient(authToken);

let stats: any = null;
try {
  stats = await sdk.adminMaintenance.getStats();
} catch (e) {
  console.error("[admin/maintenance] Failed to fetch stats:", e);
}
---

<AdminLayout crumb="admin.maintenance">
  <div class="toolbar">
    <div>
      <h2>Maintenance</h2>
      <p>Storage use, and where cleanup happens</p>
    </div>
  </div>

  <div class="page-container">
    <div class="maintenance-grid">
      <!-- Cleanup runs as scheduled tasks: one place with config, history and Run Now. -->
      <section class="card">
        <h3>Cleanup</h3>
        <p class="card-description">
          Temporary files, revoked tokens, old events and execution logs are cleaned up on a schedule.
          See what ran, change a schedule, or run one now (Optimize Database is there too, run-on-demand) in
          <a href="/admin/scheduled-tasks">Scheduled Tasks</a>.
        </p>
      </section>

      <!-- Storage Information -->
      <section class="card">
        <h3>Storage Overview</h3>
        <p class="card-description">Data size across all storage</p>
        <div class="storage-list">
          <div class="storage-item">
            <div class="storage-info">
              <span class="storage-label">Database Size</span>
              <span class="storage-path">{stats?.database_path || '/var/lib/marvin/marvin.db'}</span>
            </div>
            <span class="storage-size">{stats?.database_size || 'Unknown'}</span>
          </div>
          <div class="storage-item">
            <div class="storage-info">
              <span class="storage-label">Assets Storage</span>
              <span class="storage-path">{stats?.assets_path || '/var/lib/marvin/assets/'}</span>
            </div>
            <span class="storage-size">{stats?.assets_size || 'Unknown'}</span>
          </div>
          <div class="storage-item">
            <div class="storage-info">
              <span class="storage-label">Backup Storage</span>
              <span class="storage-path">{stats?.backups_path || '/var/lib/marvin/backups/'}</span>
            </div>
            <span class="storage-size">{stats?.backups_size || 'Unknown'}</span>
          </div>
          <div class="storage-item">
            <div class="storage-info">
              <span class="storage-label">Total Storage Used</span>
              <span class="storage-path">{stats?.data_dir_path || 'All data combined'}</span>
            </div>
            <span class="storage-size total">{stats?.total_size || 'Unknown'}</span>
          </div>
        </div>
      </section>
    </div>
  </div>
</AdminLayout>

<style>
  .toolbar {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 32px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--line);
  }

  .toolbar h2 {
    margin: 0;
    font-size: 24px;
    font-weight: 600;
  }

  .toolbar p {
    margin: 8px 0 0;
    color: var(--muted);
    font-size: 14px;
  }

  .page-container {
    max-width: 1200px;
  }

  .maintenance-grid {
    display: grid;
    gap: 24px;
  }

  .card {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 24px;
  }

  .card h3 {
    margin: 0 0 4px;
    font-size: 18px;
    font-weight: 600;
  }

  .card-description {
    margin: 0 0 20px;
    line-height: 1.5;
    font-size: 14px;
    color: var(--muted);
  }

  .storage-list {
    display: grid;
    gap: 12px;
  }

  .storage-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 16px;
    background: var(--panel-2);
    border-radius: var(--radius);
  }

  .storage-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .storage-label {
    font-size: 14px;
    font-weight: 500;
  }

  .storage-path {
    font-size: 12px;
    font-family: ui-monospace, monospace;
    color: var(--muted);
  }

  .storage-size {
    font-size: 15px;
    font-weight: 600;
    color: var(--accent);
  }

  .storage-size.total {
    font-size: 18px;
  }
</style>
