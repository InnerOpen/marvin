---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { fetchApi, getAuthToken } from "@/lib/api/client";
import { getPlatformTrashSettings } from "@/lib/api/trash";
import { requireAdmin } from "@/lib/auth";
import { createSdkClient } from "@/lib/sdk";
import { AUTO_EMPTY_CHOICES, autoEmptyLabel } from "@/lib/trash";

const currentUser = await requireAdmin(Astro.cookies, Astro.redirect, Astro.url.pathname);

const authToken = getAuthToken(Astro.cookies);
const sdk = createSdkClient(authToken);
let settings: any = null;

try {
  settings = await sdk.adminSystem.getStartupInfo();
} catch (e) {
  console.error("Could not fetch settings:", e);
}
// The platform default for how long the Trash keeps deleted entries; workspaces inherit it unless they override.
const trashDefault = await getPlatformTrashSettings(authToken).catch(() => null);
// The security policy an admin can set here; each value overrides its environment variable (services/platform_policy.py).
type SecurityRow = { key: string; label: string; help: string; unit: string; min: number; max: number; default: number; value: number; overridden: boolean };
const securityRows: SecurityRow[] = await fetchApi<SecurityRow[]>("/api/admin/platform-policy/security", {}, authToken).catch(() => []);
// The remote MCP server (OAuth sign-in for claude.ai, ChatGPT, Claude Code): off unless switched on here or by
// MCP_REMOTE_ENABLED. Its token lifetimes and extra redirect URIs follow the security fields' pattern.
type RemoteMcp = {
  enabled: boolean; enabledDefault: boolean; unavailableReason: string | null; issuer: string | null; resource: string | null;
  fields: SecurityRow[]; extraRedirectUris: string[]; allowDynamicRegistration: boolean;
};
const remoteMcp = await fetchApi<RemoteMcp>("/api/admin/platform-policy/remote-mcp", {}, authToken).catch(() => null);

// The UI address emailed links point at (BASE_URL / FRONTEND_URL, the chart's config.publicUiUrl). Left at the
// laptop defaults, every password-reset and invitation email links to localhost — say so at the top of the page.
const isLocal = (url: unknown) => typeof url === "string" && /\/\/(localhost|127\.0\.0\.1)(:|\/|$)/.test(url);
const uiAddressUnset = Boolean(settings) && (isLocal(settings.baseUrl) || isLocal(settings.frontendUrl));

// A word on values that read wrong out of context.
const SETTING_NOTES: Record<string, string> = {
  frontendPort: "The frontend pod's port. In a split deploy the API pod shows a derived value it never listens on.",
  baseUrl: "Where emailed links (password reset, invitations) point: the address people open the editor at.",
  frontendUrl: "Where push notifications and agent answers link to: the editor's public address.",
  corsOrigins: "Browser origins allowed to call the API from another host (the editor's public addresses).",
};

// Group settings by prefix
const settingsGroups: Record<string, any> = {};
const featureSettings: any[] = [];

if (settings) {
  Object.entries(settings).forEach(([key, value]) => {
    // Extract features (enabled/feature pairs)
    if (key.endsWith("Enabled") || key.endsWith("Ready")) {
      const baseName = key.replace(/Enabled$|Ready$/, "");
      const featureKey = `${baseName}Feature`;
      featureSettings.push({
        name: baseName,
        enabled: value,
        feature: settings[featureKey],
      });
      return;
    }
    if (key.endsWith("Feature")) {
      return; // Skip, handled above
    }

    // Group by prefix (first word before capital letter)
    const match = key.match(/^([a-z]+)/);
    const prefix = match ? match[1] : "general";

    if (!settingsGroups[prefix]) {
      settingsGroups[prefix] = [];
    }
    settingsGroups[prefix].push({ key, value });
  });
}

// Convert camelCase to Title Case
function toTitleCase(str: string) {
  return str
    .replace(/([A-Z])/g, " $1")
    .replace(/^./, (s) => s.toUpperCase())
    .trim();
}
---

<AdminLayout crumb="admin.site-settings">
  <div class="toolbar">
    <div>
      <h2>Site Settings</h2>
      <p>Configure platform-wide settings</p>
    </div>
  </div>

  <div class="page-container">
    {uiAddressUnset && (
      <div class="ui-warning" role="alert">
        <strong>The editor's public address isn't set.</strong>
        Base URL is <code>{settings.baseUrl}</code>, so password-reset and invitation emails link to localhost and
        can't be opened. Set <code>config.publicUiUrl</code> in the deploy values (it sets BASE_URL and FRONTEND_URL) to
        the address people use, e.g. <code>https://admin.example.com</code>.
      </div>
    )}
    <div class="settings-grid">
      {trashDefault && (
        <section class="card" id="trash">
          <h3>Trash</h3>
          <p class="card-description">
            How long a deleted entry stays in a workspace's Trash before it is deleted forever. Workspaces use this
            unless they choose their own (Settings → General → Trash).
          </p>
          <form id="trash-default-form" class="trash-default">
            <select name="auto_empty_days" class="input">
              {AUTO_EMPTY_CHOICES.map((days) => (
                <option value={String(days)} selected={trashDefault.auto_empty_days === days}>
                  {days ? `After ${autoEmptyLabel(days)}` : "Never"}
                </option>
              ))}
            </select>
            <button type="submit" class="button">Save</button>
          </form>
        </section>
      )}

      {securityRows.length > 0 && (
        <section class="card" id="security">
          <h3>Security</h3>
          <p class="card-description">
            Sign-in throttling, password rules and session length. A value set here replaces the environment's
            (shown under each); clear a box to go back to it.
          </p>
          <form id="security-form" class="security-form">
            {securityRows.map((r) => (
              <label class="security-field">
                <span class="security-label">{r.label}</span>
                <span class="security-input">
                  <input type="number" class="input" name={r.key} min={r.min} max={r.max}
                    value={r.overridden ? String(r.value) : ""} placeholder={String(r.default)} />
                  <span class="security-unit">{r.unit}</span>
                </span>
                <span class="security-help">{r.help} Environment: {r.default}.</span>
              </label>
            ))}
            <div class="security-actions">
              <button type="submit" class="button">Save security</button>
              <span class="security-status" role="status"></span>
            </div>
          </form>
        </section>
      )}

      {remoteMcp && (
        <section class="card" id="remote-mcp">
          <h3>Remote MCP</h3>
          <p class="card-description">
            Lets AI assistants (claude.ai, ChatGPT, Claude Code) connect to Marvin by signing in, with no token to
            store. Each connection is for one workspace, and that workspace's "External MCP hosts" AI source must be on.
            Switched off, its addresses answer 404 and existing connections stop working until it is back on.
          </p>
          <form id="remote-mcp-form" class="security-form">
            <label class="security-field remote-mcp-switch">
              <span class="security-label">
                <input type="checkbox" name="enabled" checked={remoteMcp.enabled} disabled={Boolean(remoteMcp.unavailableReason) && !remoteMcp.enabled} />
                Remote MCP server on
              </span>
              <span class="security-help">
                {remoteMcp.unavailableReason
                  ? remoteMcp.unavailableReason
                  : remoteMcp.resource
                    ? <>Clients connect to <code>{remoteMcp.resource}</code>.</>
                    : <>PUBLIC_API_URL isn't set, so clients connect to <code>/mcp</code> at whatever address they reach the API by (development only).</>}
                {" "}Environment: {remoteMcp.enabledDefault ? "on" : "off"}.
              </span>
            </label>
            {remoteMcp.fields.map((r: SecurityRow) => (
              <label class="security-field">
                <span class="security-label">{r.label}</span>
                <span class="security-input">
                  <input type="number" class="input" name={r.key} min={r.min} max={r.max}
                    value={r.overridden ? String(r.value) : ""} placeholder={String(r.default)} />
                  <span class="security-unit">{r.unit}</span>
                </span>
                <span class="security-help">{r.help} Environment: {r.default}.</span>
              </label>
            ))}
            <label class="security-field remote-mcp-wide">
              <span class="security-label">Extra redirect URIs</span>
              <textarea class="input" name="extraRedirectUris" rows="3"
                placeholder="https://example.com/oauth/callback">{remoteMcp.extraRedirectUris.join("\n")}</textarea>
              <span class="security-help">
                One per line, https only; end one with * to allow every address that starts with it. claude.ai, ChatGPT
                and local clients (Claude Code) are always allowed.
              </span>
            </label>
            <label class="security-field remote-mcp-wide">
              <span class="security-label">
                <input type="checkbox" name="allowDynamicRegistration" checked={remoteMcp.allowDynamicRegistration} />
                Clients may register themselves
              </span>
              <span class="security-help">Off, only clients already registered can connect.</span>
            </label>
            <div class="security-actions">
              <button type="submit" class="button">Save remote MCP</button>
              <span class="security-status" role="status"></span>
            </div>
          </form>
        </section>
      )}

      <!-- Feature Status -->
      {featureSettings.length > 0 && (
        <section class="card">
          <h3>Features Status</h3>
          <p class="card-description">Enabled integrations and features</p>
          <div class="features-list">
            {featureSettings.map(({name, enabled, feature}) => (
              <div class="feature-item">
                <div class="feature-info">
                  <span class="feature-name">{toTitleCase(name)}</span>
                  {!enabled && feature?.description && (
                    <span class="feature-note">{feature.description}</span>
                  )}
                </div>
                <span class={`feature-badge ${enabled ? 'enabled' : 'disabled'}`}>
                  {enabled ? '● Enabled' : '○ Disabled'}
                </span>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Dynamic Settings Groups -->
      {Object.entries(settingsGroups).map(([prefix, items]) => (
        <section class="card">
          <h3>{toTitleCase(prefix)} Settings</h3>
          <p class="card-description">Configuration for {prefix}</p>
          <div class="settings-display">
            {items.map(({key, value}) => {
              const isObject = typeof value === 'object' && value !== null;
              return (
                <div class={`setting-item ${isObject ? 'is-block' : ''}`}>
                  <span class="setting-label">
                    {toTitleCase(key)}
                    {SETTING_NOTES[key] && <span class="setting-note">{SETTING_NOTES[key]}</span>}
                  </span>
                  {isObject ? (
                    <pre class="setting-value setting-json">{JSON.stringify(value, null, 2)}</pre>
                  ) : (
                    <span class="setting-value">
                      {typeof value === 'boolean' ? (value ? 'Yes' : 'No') :
                       value?.toString() || '(not set)'}
                    </span>
                  )}
                </div>
              );
            })}
          </div>
        </section>
      ))}
    </div>
  </div>
</AdminLayout>

<script>
  import { fetchApi } from '@/lib/api/client';
  import { updatePlatformTrashSettings } from '@/lib/api/trash';

  const trashForm = document.getElementById('trash-default-form') as HTMLFormElement | null;
  trashForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const button = trashForm.querySelector('button') as HTMLButtonElement;
    button.disabled = true;
    try {
      await updatePlatformTrashSettings(Number(new FormData(trashForm).get('auto_empty_days')));
      button.textContent = 'Saved';
    } catch (err) {
      alert('Error: ' + (err instanceof Error ? err.message : 'Failed to save the Trash default'));
    } finally {
      button.disabled = false;
    }
  });

  // Security: blank = back to the environment's value (sent as null).
  const securityForm = document.getElementById('security-form') as HTMLFormElement | null;
  securityForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const status = securityForm.querySelector('.security-status') as HTMLElement;
    const values: Record<string, number | null> = {};
    securityForm.querySelectorAll<HTMLInputElement>('input[type="number"]').forEach((el) => {
      values[el.name] = el.value.trim() === '' ? null : Number(el.value);
    });
    status.textContent = 'Saving…';
    status.classList.remove('error');
    try {
      await fetchApi('/api/admin/platform-policy/security', { method: 'PUT', body: JSON.stringify({ values }) });
      status.textContent = 'Saved.';
    } catch (err) {
      status.textContent = err instanceof Error ? err.message : String(err);
      status.classList.add('error');
    }
  });

  // Remote MCP: the switch, the lifetimes (blank = the environment's), the extra redirect URIs and self-registration.
  const remoteMcpForm = document.getElementById('remote-mcp-form') as HTMLFormElement | null;
  remoteMcpForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const status = remoteMcpForm.querySelector('.security-status') as HTMLElement;
    const values: Record<string, number | null> = {};
    remoteMcpForm.querySelectorAll<HTMLInputElement>('input[type="number"]').forEach((el) => {
      values[el.name] = el.value.trim() === '' ? null : Number(el.value);
    });
    const checked = (name: string) => (remoteMcpForm.elements.namedItem(name) as HTMLInputElement).checked;
    const uris = (remoteMcpForm.elements.namedItem('extraRedirectUris') as HTMLTextAreaElement).value
      .split('\n').map((u) => u.trim()).filter(Boolean);
    status.textContent = 'Saving…';
    status.classList.remove('error');
    try {
      await fetchApi('/api/admin/platform-policy/remote-mcp', {
        method: 'PUT',
        body: JSON.stringify({ enabled: checked('enabled'), values, extraRedirectUris: uris, allowDynamicRegistration: checked('allowDynamicRegistration') }),
      });
      status.textContent = 'Saved.';
    } catch (err) {
      status.textContent = err instanceof Error ? err.message : String(err);
      status.classList.add('error');
    }
  });
</script>

<style>
  .remote-mcp-switch, .remote-mcp-wide { grid-column: 1 / -1; }
  .remote-mcp-wide textarea { max-width: 640px; font-family: var(--font-mono, monospace); font-size: 13px; }
  .security-form { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 14px 20px; }
  .security-field { display: grid; gap: 4px; }
  .security-label { font-size: 13px; font-weight: 600; }
  .security-input { display: flex; align-items: center; gap: 8px; }
  .security-input .input { max-width: 120px; }
  .security-unit, .security-help { font-size: 12px; color: var(--muted); }
  .security-actions { grid-column: 1 / -1; display: flex; align-items: center; gap: 12px; }
  .security-status { font-size: 13px; color: var(--muted); }
  .security-status.error { color: var(--color-error); }

  .trash-default {
    display: flex;
    gap: 0.6rem;
    align-items: center;
  }

  .toolbar {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 32px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--line);
  }

  .toolbar h2 {
    margin: 0;
    font-size: 24px;
    font-weight: 600;
  }

  .toolbar p {
    margin: 8px 0 0;
    color: var(--muted);
    font-size: 14px;
  }

  .page-container {
    max-width: 1200px;
  }

  .settings-grid {
    display: grid;
    gap: 24px;
  }

  .ui-warning {
    margin-bottom: 20px;
    padding: 14px 18px;
    border: 1px solid var(--color-error);
    background: var(--color-error-bg);
    border-radius: var(--radius);
    font-size: 14px;
    line-height: 1.5;
  }
  .ui-warning strong { display: block; color: var(--color-error); margin-bottom: 4px; }
  .setting-note { display: block; font-size: 12px; font-weight: 400; color: var(--muted); margin-top: 2px; }

  .card {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 24px;
  }

  .card h3 {
    margin: 0 0 4px;
    font-size: 18px;
    font-weight: 600;
  }

  .card-description {
    margin: 0 0 20px;
    font-size: 14px;
    color: var(--muted);
  }

  .settings-display {
    display: grid;
    gap: 12px;
  }

  .setting-item {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding: 10px 14px;
    background: var(--panel-2);
    border-radius: var(--radius);
  }

  .setting-label {
    font-size: 13px;
    font-weight: 500;
    color: var(--muted);
  }

  .setting-value {
    font-size: 14px;
    font-family: ui-monospace, monospace;
    color: var(--text);
    min-width: 0;
    text-align: right;
    word-break: break-word;
  }

  /* Object values render as a wrapping JSON block; stack label above so nothing overflows the card. */
  .setting-item.is-block {
    flex-direction: column;
    align-items: stretch;
  }

  .setting-json {
    margin: 0;
    text-align: left;
    white-space: pre-wrap;
    word-break: break-word;
    max-height: 320px;
    overflow: auto;
    padding: 10px 12px;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    font-size: 13px;
    line-height: 1.5;
  }

  .features-list {
    display: grid;
    gap: 12px;
  }

  .feature-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 16px;
    background: var(--panel-2);
    border-radius: var(--radius);
  }

  .feature-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex: 1;
  }

  .feature-name {
    font-size: 14px;
    font-weight: 500;
  }

  .feature-note {
    font-size: 12px;
    color: var(--muted);
    font-style: italic;
  }

  .feature-badge {
    padding: 6px 12px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 500;
    white-space: nowrap;
  }

  .feature-badge.enabled {
    background: rgba(79, 156, 132, 0.1);
    color: var(--accent);
    border: 1px solid var(--accent);
  }

  .feature-badge.disabled {
    background: var(--panel);
    color: var(--muted);
    border: 1px solid var(--line);
  }
</style>
