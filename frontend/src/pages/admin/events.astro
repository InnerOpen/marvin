---
import AdminLayout from "@/layouts/AdminLayout.astro";
import {
  type AdminEventPage,
  apiQuery,
  formatUtc,
  groupTypesByCategory,
  hasFilters,
  type PlatformEventType,
  pageHref,
  parseFilters,
  rangeLabel,
} from "@/lib/admin/events";
import { listAdminEvents, listPlatformEventTypes } from "@/lib/api/admin/events";
import { fetchApi, getAuthToken } from "@/lib/api/client";
import { requireAdmin } from "@/lib/auth";

await requireAdmin(Astro.cookies, Astro.redirect, Astro.url.pathname);
const authToken = getAuthToken(Astro.cookies);

const filters = parseFilters(Astro.url.searchParams);

interface WorkspaceOption {
  id: string;
  name: string;
}

let page: AdminEventPage | null = null;
let error: string | null = null;
let types: PlatformEventType[] = [];
let workspaces: WorkspaceOption[] = [];

const [eventsResult, typesResult, workspacesResult] = await Promise.allSettled([
  listAdminEvents(apiQuery(filters), authToken),
  listPlatformEventTypes(authToken),
  fetchApi<{ items: WorkspaceOption[] }>("/api/admin/groups?perPage=-1", {}, authToken),
]);

if (eventsResult.status === "fulfilled") {
  page = eventsResult.value;
} else {
  error = eventsResult.reason instanceof Error ? eventsResult.reason.message : String(eventsResult.reason);
  console.error("[admin/events] Failed to load:", error);
}
// The filters degrade on their own: without the lists the selects keep only the current choice.
if (typesResult.status === "fulfilled") types = typesResult.value;
else console.error("[admin/events] Failed to load event types:", typesResult.reason);
if (workspacesResult.status === "fulfilled") {
  workspaces = (workspacesResult.value.items ?? []).slice().sort((a, b) => a.name.localeCompare(b.name));
} else {
  console.error("[admin/events] Failed to load workspaces:", workspacesResult.reason);
}

const typeGroups = groupTypesByCategory(types);
const typeKnown = !filters.eventType || types.some((t) => t.eventType === filters.eventType);
const workspaceKnown = !filters.workspaceId || workspaces.some((w) => w.id === filters.workspaceId);
const events = page?.items ?? [];
const filtered = hasFilters(filters);
---

<AdminLayout title="Events">
  <div class="toolbar">
    <div>
      <h2>Events</h2>
      <p>
        Platform events across every workspace: sign-ups and account changes, workspaces created, changed, deleted
        and switched to, personal API tokens, and the platform's security and backup events. Each row names the
        workspace it was recorded with. Everything else happens inside a workspace and stays in that workspace's
        Event Log.
      </p>
    </div>
  </div>

  <div class="page-container">
    <form class="filters" method="get" action="/admin/events">
      <label class="field">
        <span>Event</span>
        <select name="type">
          <option value="">All platform events</option>
          {!typeKnown && <option value={filters.eventType} selected>{filters.eventType}</option>}
          {typeGroups.map((group) => (
            <optgroup label={group.category}>
              {group.types.map((t) => (
                <option value={t.eventType} selected={t.eventType === filters.eventType}>{t.name}</option>
              ))}
            </optgroup>
          ))}
        </select>
      </label>
      <label class="field">
        <span>Workspace</span>
        <select name="workspace">
          <option value="">All workspaces</option>
          {!workspaceKnown && <option value={filters.workspaceId} selected>{filters.workspaceId}</option>}
          {workspaces.map((w) => (
            <option value={w.id} selected={w.id === filters.workspaceId}>{w.name}</option>
          ))}
        </select>
      </label>
      <label class="field field-date">
        <span>From (UTC)</span>
        <input type="date" name="from" value={filters.from} />
      </label>
      <label class="field field-date">
        <span>To (UTC)</span>
        <input type="date" name="to" value={filters.to} />
      </label>
      <div class="filter-actions">
        <button type="submit" class="button">Apply</button>
        {filtered && <a class="button secondary" href="/admin/events">Clear</a>}
      </div>
    </form>

    {error ? (
      <div class="alert alert-error"><strong>Error:</strong> {error}</div>
    ) : events.length === 0 ? (
      <div class="empty-state">
        <p class="empty-title">{filtered ? "No events match these filters" : "No platform events yet"}</p>
        <p class="empty-desc">
          {filtered ? "Try a wider date range or another event type." : "Sign-ups, new workspaces and the other platform events appear here as they happen."}
        </p>
      </div>
    ) : (
      <>
        <div class="table-wrap">
          <table class="log-table">
            <thead>
              <tr>
                <th><span class="visually-hidden">Payload</span></th>
                <th>When</th>
                <th>Event</th>
                <th>Workspace</th>
                <th>User</th>
                <th>Details</th>
              </tr>
            </thead>
            <tbody>
              {events.map((ev, i) => (
                <>
                  <tr class="log-row">
                    <td class="expand-cell">
                      <button
                        type="button"
                        class="expand-btn"
                        data-target={`detail-${i}`}
                        data-event-id={ev.eventId}
                        aria-expanded="false"
                        aria-controls={`detail-${i}`}
                        aria-label={`Show the payload of ${ev.eventName}`}
                      >▶</button>
                    </td>
                    <td class="nowrap muted" data-label="When"><time datetime={ev.occurredAt}>{formatUtc(ev.occurredAt)}</time></td>
                    <td data-label="Event">
                      <span class="event-cell">
                        <span class="event-title">{ev.eventName}</span>
                        <code class="ev-badge">{ev.eventType}</code>
                      </span>
                    </td>
                    <td data-label="Workspace">
                      {ev.workspaceId ? (
                        ev.workspaceName ? (
                          <a class="entity-link" href={`/admin/groups/${ev.workspaceId}`}>{ev.workspaceName}</a>
                        ) : (
                          <span class="muted" title={ev.workspaceId}>Deleted workspace</span>
                        )
                      ) : (
                        <span class="muted">—</span>
                      )}
                    </td>
                    <td data-label="User">
                      {ev.userName || ev.userEmail ? (
                        <span class="user-cell">
                          {ev.userId && ev.userName ? (
                            <a class="entity-link" href={`/admin/users/${ev.userId}`}>{ev.userName}</a>
                          ) : (
                            ev.userName && <span>{ev.userName}</span>
                          )}
                          {ev.userEmail && <span class="user-email">{ev.userEmail}</span>}
                        </span>
                      ) : (
                        <span class="muted">—</span>
                      )}
                    </td>
                    <td class="detail-col" data-label="Details">{ev.messageBody || ev.messageTitle}</td>
                  </tr>
                  <tr class="detail-row" id={`detail-${i}`} hidden>
                    <td colspan="6">
                      <div class="detail-body">
                        <div class="detail-label">Payload</div>
                        <pre class="payload-json" data-payload-for={ev.eventId}>Loading…</pre>
                      </div>
                    </td>
                  </tr>
                </>
              ))}
            </tbody>
          </table>
        </div>
        {page && (
          <nav class="pager" aria-label="Pages">
            <span class="count-note">{rangeLabel(page)}</span>
            <span class="pager-links">
              {filters.page > 1 && <a class="button secondary" href={pageHref(filters, filters.page - 1)}>Newer</a>}
              {filters.page < page.total_pages && <a class="button secondary" href={pageHref(filters, filters.page + 1)}>Older</a>}
            </span>
          </nav>
        )}
      </>
    )}
  </div>
</AdminLayout>

<script>
  import { getAdminEvent } from "@/lib/api/admin/events";

  const loaded = new Set<string>();

  // Expand / collapse + lazy-load the payload. It's shown as text, never as HTML.
  for (const btn of Array.from(document.querySelectorAll<HTMLButtonElement>(".expand-btn"))) {
    btn.addEventListener("click", async () => {
      const row = document.getElementById(btn.dataset.target ?? "");
      if (!row) return;
      const open = !row.hidden;
      row.hidden = open;
      btn.textContent = open ? "▶" : "▼";
      btn.setAttribute("aria-expanded", String(!open));

      const eventId = btn.dataset.eventId ?? "";
      if (open || loaded.has(eventId)) return;
      loaded.add(eventId);
      const pre = row.querySelector<HTMLElement>("[data-payload-for]");
      if (!pre) return;
      try {
        const full = await getAdminEvent(eventId);
        pre.textContent = JSON.stringify(full.eventData, null, 2);
      } catch (e) {
        loaded.delete(eventId);
        pre.textContent = `Failed to load the payload: ${e instanceof Error ? e.message : String(e)}`;
      }
    });
  }
</script>

<style>
  .toolbar {
    margin-bottom: 24px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--line);
  }
  .toolbar h2 { margin: 0; font-size: 24px; font-weight: 600; }
  .toolbar p { margin: 8px 0 0; color: var(--muted); font-size: 14px; max-width: 760px; }

  .page-container { max-width: 1200px; min-width: 0; }

  .filters {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 12px;
    margin-bottom: 20px;
  }
  .field { display: flex; flex-direction: column; gap: 4px; flex: 1 1 200px; min-width: 0; }
  .field-date { flex: 0 1 170px; }
  .field span { font-size: 12px; font-weight: 600; color: var(--muted); }
  .field select,
  .field input {
    width: 100%;
    min-width: 0;
    padding: 8px 10px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg);
    color: var(--ink);
    font-size: 14px;
  }
  .field select:focus,
  .field input:focus { border-color: var(--accent); outline: none; }
  .filter-actions { display: flex; gap: 8px; }

  .alert {
    padding: 16px;
    margin-bottom: 24px;
    border-radius: var(--radius);
    background: var(--color-error-bg);
    color: var(--color-error);
    border: 1px solid var(--color-error);
  }

  .empty-state { padding: 64px 24px; text-align: center; }
  .empty-title { margin: 0 0 8px; font-size: 18px; font-weight: 600; }
  .empty-desc { margin: 0; color: var(--muted); font-size: 14px; }

  /* The log table: the workspace Event Log's look. */
  .table-wrap { overflow-x: auto; }
  .log-table { width: 100%; border-collapse: collapse; font-size: 14px; }
  .log-table th {
    text-align: left;
    padding: 10px 12px;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--muted);
    border-bottom: 2px solid var(--line);
    white-space: nowrap;
  }
  .log-table td { padding: 10px 12px; border-bottom: 1px solid var(--line); vertical-align: middle; }
  .log-row:hover td { background: var(--panel); }
  .expand-cell { width: 32px; padding: 10px 6px 10px 12px; }
  .expand-btn {
    background: none;
    border: none;
    cursor: pointer;
    color: var(--muted);
    font-size: 11px;
    padding: 2px 4px;
    border-radius: 3px;
  }
  .expand-btn:hover { background: var(--line); color: var(--ink); }
  .detail-row td { padding: 0; border-bottom: 1px solid var(--line); }
  .detail-row[hidden] { display: none; }
  .detail-body { padding: 16px 16px 16px 52px; background: var(--panel); display: flex; flex-direction: column; gap: 4px; }
  .detail-label { font-size: 11px; font-weight: 600; text-transform: uppercase; color: var(--muted); }
  .payload-json {
    font-size: 12px;
    font-family: ui-monospace, monospace;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 12px;
    margin: 0;
    overflow: auto;
    max-height: 400px;
    white-space: pre;
    color: var(--ink);
  }
  .nowrap { white-space: nowrap; }
  .muted { color: var(--muted); }
  .event-cell { display: flex; flex-direction: column; gap: 3px; align-items: flex-start; }
  .event-title { font-size: 14px; color: var(--ink); font-weight: 500; }
  .ev-badge {
    font-size: 12px;
    font-family: ui-monospace, monospace;
    background: var(--panel);
    border: 1px solid var(--line);
    padding: 2px 8px;
    border-radius: 4px;
    color: var(--ink);
    overflow-wrap: anywhere;
  }
  .entity-link { color: var(--accent); text-decoration: none; }
  .entity-link:hover { text-decoration: underline; }
  .user-cell { display: flex; flex-direction: column; gap: 1px; }
  .user-email { font-size: 12px; color: var(--muted); overflow-wrap: anywhere; }
  .detail-col { color: var(--muted); font-size: 13px; max-width: 420px; }

  .pager { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-top: 14px; }
  .pager-links { display: flex; gap: 8px; }
  .count-note { font-size: 12px; color: var(--muted); }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* A phone: each event is a card, its cells labelled, so nothing scrolls sideways. */
  @media (max-width: 640px) {
    .field,
    .field-date { flex: 1 1 100%; }
    .table-wrap { overflow-x: visible; }
    .log-table thead { display: none; }
    .log-table,
    .log-table tbody,
    .log-table tr,
    .log-table td { display: block; width: 100%; box-sizing: border-box; }
    .log-row {
      position: relative;
      padding: 10px 0 10px 36px;
      border-bottom: 1px solid var(--line);
    }
    .log-table .log-row td { border-bottom: 0; padding: 3px 0; max-width: none; white-space: normal; }
    .log-table .log-row td.expand-cell { position: absolute; left: 4px; top: 10px; width: auto; padding: 0; }
    .log-table .log-row td[data-label]::before {
      content: attr(data-label);
      display: block;
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: var(--muted);
    }
    .log-row:hover td { background: none; }
    .detail-body { padding: 12px; }
  }
</style>
