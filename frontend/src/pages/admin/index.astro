---
import LocalTime from "@/components/LocalTime.astro";
import AdminLayout from "@/layouts/AdminLayout.astro";
import { BACKUP_STALE_DAYS, formatAge, summarizeBackups, summarizeTasks } from "@/lib/admin/overview";
import { listAdminEvents } from "@/lib/api/admin/events";
import { listPlugins } from "@/lib/api/admin/plugins";
import { listAllTasks } from "@/lib/api/admin/scheduledTasks";
import { getBackupHealth } from "@/lib/api/admin/backupHealth";
import { fetchApi, getAuthToken } from "@/lib/api/client";
import { getApiUrl } from "@/lib/api/config";
import type { EmbeddingsInfo } from "@/lib/api/admin/about";
import { requireAdmin } from "@/lib/auth";

await requireAdmin(Astro.cookies, Astro.redirect, Astro.url.pathname);
const authToken = getAuthToken(Astro.cookies);

const READINESS_TIMEOUT_MS = 3000;
const MAX_FAILING_TASKS_SHOWN = 3;
const NO_DATA = "—";

interface AboutInfo {
  version: string;
  versionLatest: string;
  dbType: string;
  embeddings?: EmbeddingsInfo | null;
}
interface Statistics {
  totalUsers: number;
  totalGroups: number;
  totalEntries: number;
  totalCollections: number;
  totalEntryTypes: number;
  totalAssets: number;
  totalResources: number;
  totalApiTokens: number;
  totalApiClients: number;
  totalWebhooks: number;
  totalAiOperations: number;
  totalAiTokens: number;
  totalAiCostUsd: number;
  totalWorkflows?: number;
  enabledWorkflows?: number;
  pendingApprovals?: number;
  totalAgents?: number;
  totalPlaybooks?: number;
  totalIntegrations?: number;
  totalScheduledTasks?: number;
  totalIncomingWebhooks?: number;
  totalFormSubmissions?: number;
  connectedApps?: number;
}
interface Backup {
  created_at: string;
}

// Each card is best-effort: one endpoint failing blanks its card, never the page.
async function attempt<T>(label: string, load: () => Promise<T>): Promise<T | null> {
  try {
    return await load();
  } catch (e) {
    console.error(`[admin/overview] Failed to load ${label}:`, e);
    return null;
  }
}

// Probed directly rather than via fetchApi, which retries 5xx — a not-ready 503 is the answer here.
async function checkReadiness(): Promise<boolean | null> {
  try {
    const response = await fetch(getApiUrl("/readyz"), { signal: AbortSignal.timeout(READINESS_TIMEOUT_MS) });
    return response.ok;
  } catch {
    return null;
  }
}

const EVENTS_WINDOW_DAYS = 7;
const eventsSince = new Date(Date.now() - EVENTS_WINDOW_DAYS * 86_400_000).toISOString();

type HealthDot = { key: string; label: string; tone: "ok" | "warn" | "bad" | "off"; href: string };
type WorkspaceRow = {
  id: string; name: string; slug: string; entries: number; members: number;
  aiSpendMonth: number; aiLimitMonth: number | null; openAlerts: number; lastActivity: string | null;
};
type SpendDay = { day: string; cost: number; runs: number; promptTokens: number; cachedTokens: number };
type SignIn = { userId: string; name: string; username: string; at: string };
type PluginUpdate = { package: string; installed: string; latest: string; repo: string };
type Overview = {
  health: HealthDot[]; workspaces: WorkspaceRow[]; spend: SpendDay[]; signIns: SignIn[]; pluginUpdates: PluginUpdate[];
};

const [about, ready, stats, backups, tasks, plugins, recentEvents, backupHealth, overview] = await Promise.all([
  attempt("about", () => fetchApi<AboutInfo>("/api/admin/about", {}, authToken)),
  checkReadiness(),
  attempt("statistics", () => fetchApi<Statistics>("/api/admin/about/statistics", {}, authToken)),
  attempt("backups", () => fetchApi<Backup[]>("/api/admin/backups", {}, authToken)),
  attempt("scheduled tasks", () => listAllTasks(authToken)),
  attempt("plugins", () => listPlugins(authToken)),
  attempt("events", () =>
    listAdminEvents(new URLSearchParams({ per_page: "1", start_date: eventsSince }).toString(), authToken),
  ),
  attempt("backup health", () => getBackupHealth({ limit: 1 }, authToken)),
  attempt("overview", () => fetchApi<Overview>("/api/admin/overview", {}, authToken)),
]);

// AI spend, last 30 days: one bar a day, the cached share of its prompt shaded (services/admin_overview.py).
// Platform totals (what the separate Platform System page used to show), grouped; a count the backend doesn't send yet is left out.
const n = (v: number | undefined | null) => (v == null ? null : v.toLocaleString());
const totals: { title: string; rows: [string, string | null][] }[] = stats
  ? [
      { title: "People", rows: [["Users", n(stats.totalUsers)], ["Workspaces", n(stats.totalGroups)]] },
      { title: "Content", rows: [["Entries", n(stats.totalEntries)], ["Collections", n(stats.totalCollections)], ["Entry types", n(stats.totalEntryTypes)], ["Assets", n(stats.totalAssets)], ["Resources", n(stats.totalResources)], ["Form submissions", n(stats.totalFormSubmissions)]] },
      { title: "Automation", rows: [["Workflows", stats.totalWorkflows == null ? null : `${n(stats.enabledWorkflows ?? 0)} on of ${n(stats.totalWorkflows)}`], ["Approvals waiting", n(stats.pendingApprovals)], ["Scheduled tasks", n(stats.totalScheduledTasks)], ["Incoming webhooks", n(stats.totalIncomingWebhooks)], ["Outgoing webhooks", n(stats.totalWebhooks)]] },
      { title: "AI", rows: [["Agents", n(stats.totalAgents)], ["Playbooks", n(stats.totalPlaybooks)], ["AI runs", n(stats.totalAiOperations)], ["AI tokens", n(stats.totalAiTokens)], ["AI cost", stats.totalAiCostUsd == null ? null : `$${Number(stats.totalAiCostUsd).toFixed(2)}`]] },
      { title: "Connections", rows: [["Integrations", n(stats.totalIntegrations)], ["Connected MCP apps", n(stats.connectedApps)], ["API tokens", n(stats.totalApiTokens)], ["API clients", n(stats.totalApiClients)]] },
    ].map((g) => ({ ...g, rows: g.rows.filter(([, v]) => v != null) as [string, string | null][] }))
  : [];
const embeddings = about?.embeddings ?? null;
const staleModels = embeddings?.indexedModels.filter((m) => m.modelId !== embeddings?.model) ?? [];

const spend = overview?.spend ?? [];
const spendTotal = spend.reduce((n, d) => n + d.cost, 0);
const spendRuns = spend.reduce((n, d) => n + d.runs, 0);
const promptTotal = spend.reduce((n, d) => n + d.promptTokens, 0);
const cachedTotal = spend.reduce((n, d) => n + d.cachedTokens, 0);
const cachedShare = promptTotal ? Math.round((cachedTotal / promptTotal) * 100) : 0;
const SPEND_BAR = 10, SPEND_GAP = 3, SPEND_H = 60;
const spendPeak = Math.max(0.0001, ...spend.map((d) => d.cost));
const spendWidth = Math.max(1, spend.length * (SPEND_BAR + SPEND_GAP) - SPEND_GAP);
const spendBars = spend.map((d, i) => {
  const h = d.cost ? Math.max(2, Math.round((d.cost / spendPeak) * SPEND_H)) : 1;
  const share = d.promptTokens ? d.cachedTokens / d.promptTokens : 0;
  return { x: i * (SPEND_BAR + SPEND_GAP), y: SPEND_H - h, h, hc: Math.round(h * share), label: `${d.day}: $${d.cost.toFixed(4)} · ${d.runs} runs · ${Math.round(share * 100)}% of prompt cached` };
});
const usd = (n: number) => (n >= 1 ? `$${n.toFixed(2)}` : n > 0 ? `$${n.toFixed(4)}` : "$0");
const relDay = (iso: string | null) => {
  if (!iso) return "never";
  const days = Math.floor((Date.now() - new Date(iso.endsWith("Z") || iso.includes("+") ? iso : `${iso}Z`).getTime()) / 86_400_000);
  return days <= 0 ? "today" : days === 1 ? "yesterday" : `${days} days ago`;
};
const backupTargets = backupHealth?.targets ?? [];
const backupProblems = backupTargets.filter((t) => t.state !== "ok" && t.state !== "unknown");
const latestEvent = recentEvents?.items[0] ?? null;

// The release check reports failures as text ("error fetching version"), so only a version-looking
// tag counts as a newer release.
const VERSION_TAG = /^v?\d/;
const stripV = (v: string) => v.replace(/^v/, "");
const updateAvailable =
  about !== null && VERSION_TAG.test(about.versionLatest) && stripV(about.versionLatest) !== stripV(about.version);

const backupSummary = backups ? summarizeBackups(backups) : null;
const taskSummary = tasks ? summarizeTasks(tasks) : null;
const failedPlugins = plugins ? plugins.filter((p) => !p.ok).length : 0;
const providerCount = plugins ? plugins.reduce((sum, p) => sum + p.providers.length, 0) : 0;

const readinessLabel = ready === null ? NO_DATA : ready ? "Ready" : "Unavailable";
const plural = (n: number, word: string) => `${n} ${word}${n === 1 ? "" : "s"}`;
---

<AdminLayout width="full" crumb="admin">
  <div class="page-container">
    {overview && overview.health.length > 0 && (
      <ul class="health-strip" aria-label="Platform health">
        {overview.health.map((d) => (
          <li><a href={d.href} class={`health-dot tone-${d.tone}`}><span class="dot" aria-hidden="true"></span>{d.label}</a></li>
        ))}
      </ul>
    )}
    <div class="status-grid">
      <a href="#system" class:list={["status-card", { warn: updateAvailable || ready === false }]}>
        <h3>Version &amp; health</h3>
        <div class="status-value">{about?.version ?? NO_DATA}</div>
        <ul class="status-details">
          {about && <li>{updateAvailable ? `Update available: ${about.versionLatest}` : "Up to date"}</li>}
          <li>Database{about ? ` (${about.dbType})` : ""}: {readinessLabel}</li>
        </ul>
      </a>

      <a href="/admin/users" class="status-card">
        <h3>People</h3>
        <div class="status-value">{stats ? plural(stats.totalUsers, "user") : NO_DATA}</div>
        <ul class="status-details">
          <li>{stats ? plural(stats.totalGroups, "workspace") : NO_DATA}</li>
        </ul>
      </a>

      <a href="/admin/plugins" class:list={["status-card", { warn: failedPlugins > 0 }]}>
        <h3>Plugins</h3>
        <div class="status-value">{plugins ? `${plugins.length} installed` : NO_DATA}</div>
        <ul class="status-details">
          {plugins && <li>{plural(providerCount, "provider")}</li>}
          {failedPlugins > 0 && <li>{failedPlugins} failed to load</li>}
        </ul>
      </a>

      <a href="/admin/backups" class:list={["status-card", { warn: backupSummary !== null && backupSummary.state !== "fresh" }]}>
        <h3>Last backup</h3>
        <div class="status-value">
          {backupSummary === null ? NO_DATA : backupSummary.latestAt ? formatAge(backupSummary.latestAt) : "None yet"}
        </div>
        <ul class="status-details">
          {backupSummary?.latestAt && <li><LocalTime iso={backupSummary.latestAt} /></li>}
          {backupSummary && backupSummary.state !== "fresh" && (
            <li>{backupSummary.state === "none" ? "No backup has been taken" : `Older than ${BACKUP_STALE_DAYS} days`}</li>
          )}
          {backups && <li>{plural(backups.length, "backup")} on disk</li>}
        </ul>
      </a>

      <a href="/admin/backup-health" class:list={["status-card", { warn: backupProblems.length > 0 }]} data-testid="backup-health-card">
        <h3>Installation backups</h3>
        <div class="status-value">
          {backupHealth === null ? NO_DATA : backupTargets.length === 0 ? "No runs yet" : backupProblems.length ? `${backupProblems.length} need attention` : "All OK"}
        </div>
        <ul class="status-details">
          {backupTargets.map((t) => (
            <li class:list={[{ failing: t.state !== "ok" && t.state !== "unknown" }]}>
              {t.name}: {t.state}{t.lastRun ? `, ${formatAge(t.lastRun.startedAt)}` : ""}
            </li>
          ))}
        </ul>
      </a>

      <a href="/admin/events" class="status-card">
        <h3>Platform events</h3>
        <div class="status-value">{recentEvents ? `${recentEvents.total} in ${EVENTS_WINDOW_DAYS} days` : NO_DATA}</div>
        <ul class="status-details">
          {latestEvent && <li>Latest: {latestEvent.eventName}, {formatAge(latestEvent.occurredAt)}</li>}
          {recentEvents && !latestEvent && <li>None in the last {EVENTS_WINDOW_DAYS} days</li>}
        </ul>
      </a>
      <a href="/admin/scheduled-tasks" class:list={["status-card", { warn: (taskSummary?.failing.length ?? 0) > 0 }]}>
        <h3>Scheduled tasks</h3>
        <div class="status-value">{taskSummary ? `${taskSummary.failing.length} failing` : NO_DATA}</div>
        <ul class="status-details">
          {taskSummary?.failing.slice(0, MAX_FAILING_TASKS_SHOWN).map((t) => <li class="failing">{t.name}</li>)}
          {taskSummary && taskSummary.failing.length > MAX_FAILING_TASKS_SHOWN && (
            <li>and {taskSummary.failing.length - MAX_FAILING_TASKS_SHOWN} more</li>
          )}
          {taskSummary && <li>{taskSummary.enabled} of {taskSummary.total} enabled</li>}
          {taskSummary?.lastRunAt && <li>Last run {formatAge(taskSummary.lastRunAt)}</li>}
        </ul>
      </a>
    </div>

    {overview && (
      <div class="overview-panels">
        <section class="panel">
          <div class="panel-head">
            <h3>Workspaces</h3>
            <a href="/admin/workspaces" class="panel-link">Manage →</a>
          </div>
          <div class="table-scroll">
            <table class="ws-table">
              <thead><tr><th>Workspace</th><th class="num">Entries</th><th class="num">Members</th><th class="num">AI this month</th><th class="num">Alerts</th><th>Last activity</th></tr></thead>
              <tbody>
                {overview.workspaces.map((w) => (
                  <tr>
                    <td><a href={`/admin/groups/${w.id}`}>{w.name}</a></td>
                    <td class="num">{w.entries.toLocaleString()}</td>
                    <td class="num">{w.members}</td>
                    <td class="num">
                      {usd(w.aiSpendMonth)}{w.aiLimitMonth ? <span class="muted"> of {usd(w.aiLimitMonth)}</span> : null}
                      {w.aiLimitMonth ? (
                        <span class="meter" title={`${Math.round((w.aiSpendMonth / w.aiLimitMonth) * 100)}% of the monthly limit`}>
                          <span class:list={["meter-fill", { over: w.aiSpendMonth >= w.aiLimitMonth }]} style={`width:${Math.min(100, (w.aiSpendMonth / w.aiLimitMonth) * 100)}%`}></span>
                        </span>
                      ) : null}
                    </td>
                    <td class:list={["num", { warn: w.openAlerts > 0 }]}>{w.openAlerts || "·"}</td>
                    <td class="muted">{relDay(w.lastActivity)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        <section class="panel">
          <div class="panel-head">
            <h3>AI spend</h3>
            <span class="panel-sub">last 30 days, all workspaces</span>
          </div>
          {spendRuns === 0 ? (
            <p class="muted">No AI runs in the last 30 days.</p>
          ) : (
            <>
              <p class="spend-summary"><strong>{usd(spendTotal)}</strong> over {spendRuns.toLocaleString()} runs · {cachedShare}% of prompt tokens served from cache</p>
              <svg class="spend-chart" viewBox={`0 0 ${spendWidth} ${SPEND_H}`} preserveAspectRatio="none" role="img" aria-label={`AI spend per day, last 30 days: ${usd(spendTotal)}`}>
                {spendBars.map((b) => (
                  <g>
                    <title>{b.label}</title>
                    <rect class="bar-cost" x={b.x} y={b.y} width={SPEND_BAR} height={b.h} rx="1" />
                    {b.hc > 0 && <rect class="bar-cached" x={b.x} y={b.y + b.h - b.hc} width={SPEND_BAR} height={b.hc} rx="1" />}
                  </g>
                ))}
              </svg>
              <div class="spend-axis"><span>{spend[0]?.day}</span><span>today</span></div>
              <ul class="spend-legend">
                <li><span class="swatch cost"></span>Cost per day</li>
                <li><span class="swatch cached"></span>Share of the prompt served from cache</li>
              </ul>
            </>
          )}
        </section>

        <section class="panel">
          <div class="panel-head">
            <h3>Recent sign-ins</h3>
            <a href="/admin/users" class="panel-link">Users →</a>
          </div>
          {overview.signIns.length === 0 ? (
            <p class="muted">No sign-ins recorded yet.</p>
          ) : (
            <ul class="plain-list">
              {overview.signIns.map((s) => (
                <li>
                  <a href={`/admin/users/${s.userId}`}>{s.name}</a>
                  {s.username && s.username !== s.name && <span class="muted"> @{s.username}</span>}
                  <span class="muted list-when"><LocalTime iso={s.at} /></span>
                </li>
              ))}
            </ul>
          )}
        </section>

        <section class="panel">
          <div class="panel-head">
            <h3>Plugin updates</h3>
            <a href="/admin/plugins" class="panel-link">Plugins →</a>
          </div>
          {overview.pluginUpdates.length === 0 ? (
            <p class="muted">Every plugin installed from GitHub is on its newest release.</p>
          ) : (
            <>
              <ul class="plain-list">
                {overview.pluginUpdates.map((u) => (
                  <li>
                    <a href={`https://github.com/${u.repo}/releases`} target="_blank" rel="noopener">{u.package}</a>
                    <span class="muted list-when">{u.installed} → <strong>{u.latest}</strong></span>
                  </li>
                ))}
              </ul>
              <p class="muted">Updating is a Marvin release: bump the pin in the <code>plugins</code> group.</p>
            </>
          )}
        </section>
      </div>
    )}

    <!-- What the Platform System page used to be: platform-wide totals and the embedding engine. -->
    <div class="overview-panels" id="system">
      {totals.length > 0 && (
        <section class="panel">
          <div class="panel-head">
            <h3>Platform totals</h3>
            <span class="panel-sub">every workspace</span>
          </div>
          <div class="totals">
            {totals.map((g) => (
              <dl class="totals-group">
                <h4>{g.title}</h4>
                {g.rows.map(([label, value]) => (
                  <div class="total"><dt>{label}</dt><dd>{value}</dd></div>
                ))}
              </dl>
            ))}
          </div>
        </section>
      )}
      {embeddings && (
        <section class="panel">
          <div class="panel-head">
            <h3>Embeddings</h3>
            <span class="panel-sub">semantic search</span>
          </div>
          <dl class="totals-group">
            <div class="total"><dt>Built-in model</dt><dd>{embeddings.builtinAvailable ? "On" : embeddings.builtinEnabled ? "Off: fastembed is not installed" : "Off: workspaces use their AI provider's model"}</dd></div>
            {embeddings.model && <div class="total"><dt>Model</dt><dd><code>{embeddings.model}</code></dd></div>}
            {embeddings.dimensions != null && <div class="total"><dt>Dimensions</dt><dd>{embeddings.dimensions}</dd></div>}
            <div class="total"><dt>Engine</dt><dd>{embeddings.engine}{embeddings.engineVersion ? ` ${embeddings.engineVersion}` : " (not installed)"}</dd></div>
            <div class="total"><dt>ONNX Runtime</dt><dd>{embeddings.onnxruntimeVersion ?? "not installed"}</dd></div>
          </dl>
          <h4 class="emb-sub">Indexed with</h4>
          {embeddings.indexedModels.length === 0 ? (
            <p class="muted">Nothing is indexed yet.</p>
          ) : (
            <ul class="plain-list">
              {embeddings.indexedModels.map((m) => (
                <li class:list={{ stale: m.modelId !== embeddings.model }}>
                  <code>{m.modelId}</code>
                  <span class="muted list-when">{m.chunks.toLocaleString()} {m.chunks === 1 ? "chunk" : "chunks"}</span>
                </li>
              ))}
            </ul>
          )}
          {staleModels.length > 0 && embeddings.model && (
            <p class="muted">Chunks from a model other than <code>{embeddings.model}</code> are not searched. Reindex the workspace (Settings → AI) to rebuild them.</p>
          )}
        </section>
      )}
    </div>
  </div>
</AdminLayout>

<style>
  .health-strip { list-style: none; margin: 0 0 20px; padding: 0; display: flex; flex-wrap: wrap; gap: 8px 18px; }
  .health-dot { display: inline-flex; align-items: center; gap: 7px; font-size: 13px; color: var(--muted); text-decoration: none; }
  a.health-dot:hover { color: var(--ink); }
  .health-dot .dot { width: 9px; height: 9px; border-radius: 50%; background: var(--line); flex: none; }
  .tone-ok .dot { background: #16a34a; }
  .tone-warn .dot { background: #d97706; }
  .tone-bad .dot { background: var(--color-error, #dc2626); }
  .tone-bad, .tone-warn { color: var(--ink); }
  .tone-off { opacity: 0.7; }
  .overview-panels { display: grid; grid-template-columns: 1.4fr 1fr; gap: 20px; margin-top: 24px; align-items: start; }
  @media (max-width: 1000px) { .overview-panels { grid-template-columns: 1fr; } }
  .panel { background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); padding: 20px 24px; min-width: 0; }
  .panel-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin-bottom: 14px; }
  .panel-head h3 { margin: 0; font-size: 16px; }
  .panel-link { font-size: 13px; color: var(--accent); text-decoration: none; }
  .panel-sub, .muted { color: var(--muted); font-size: 12px; }
  .ws-table { width: 100%; border-collapse: collapse; font-size: 14px; }
  .ws-table th { text-align: left; font-size: 12px; text-transform: uppercase; color: var(--muted); padding: 6px 8px; border-bottom: 1px solid var(--line); }
  .ws-table td { padding: 8px; border-bottom: 1px solid var(--line); vertical-align: top; }
  .ws-table tr:last-child td { border-bottom: 0; }
  .ws-table a { color: var(--ink); }
  .ws-table .num { text-align: right; white-space: nowrap; }
  .ws-table .warn { color: #d97706; font-weight: 600; }
  .plain-list { list-style: none; margin: 0; padding: 0; font-size: 14px; }
  .plain-list li { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px; padding: 7px 0; border-bottom: 1px solid var(--line); }
  .plain-list li:last-child { border-bottom: 0; }
  .plain-list a { color: var(--ink); }
  .list-when { margin-left: auto; }
  .totals { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 8px 28px; }
  .totals-group { margin: 0; }
  .totals-group h4, .emb-sub { margin: 0 0 6px; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; color: var(--muted); }
  .emb-sub { margin-top: 16px; }
  .total { display: flex; justify-content: space-between; gap: 12px; padding: 6px 0; border-bottom: 1px solid var(--line); font-size: 14px; }
  .total:last-child { border-bottom: 0; }
  .total dt { color: var(--muted); }
  .total dd { margin: 0; text-align: right; font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
  .plain-list li.stale .list-when { color: var(--color-error); }
  #system { scroll-margin-top: 80px; }
  .meter { display: block; height: 4px; margin-top: 4px; background: var(--line); border-radius: 2px; overflow: hidden; }
  .meter-fill { display: block; height: 100%; background: #16a34a; }
  .meter-fill.over { background: var(--color-error, #dc2626); }
  .spend-summary { margin: 0 0 10px; font-size: 14px; }
  .spend-chart { display: block; width: 100%; height: 90px; }
  .bar-cost { fill: var(--accent); opacity: 0.85; }
  .bar-cached { fill: #16a34a; opacity: 0.6; }
  .spend-axis { display: flex; justify-content: space-between; font-size: 11px; color: var(--muted); margin-top: 4px; }
  .spend-legend { list-style: none; margin: 10px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px 14px; font-size: 12px; color: var(--muted); }
  .spend-legend li { display: inline-flex; align-items: center; gap: 6px; }
  .swatch { width: 10px; height: 10px; border-radius: 2px; display: inline-block; }
  .swatch.cost { background: var(--accent); }
  .swatch.cached { background: #16a34a; opacity: 0.6; }




  .status-grid {
