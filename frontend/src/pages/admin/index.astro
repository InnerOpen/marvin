---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { BACKUP_STALE_DAYS, formatAge, summarizeBackups, summarizeTasks } from "@/lib/admin/overview";
import { listAdminEvents } from "@/lib/api/admin/events";
import { listPlugins } from "@/lib/api/admin/plugins";
import { listAllTasks } from "@/lib/api/admin/scheduledTasks";
import { fetchApi, getAuthToken } from "@/lib/api/client";
import { getApiUrl } from "@/lib/api/config";
import { requireAdmin } from "@/lib/auth";

await requireAdmin(Astro.cookies, Astro.redirect, Astro.url.pathname);
const authToken = getAuthToken(Astro.cookies);

const READINESS_TIMEOUT_MS = 3000;
const MAX_FAILING_TASKS_SHOWN = 3;
const NO_DATA = "—";

interface AboutInfo {
  version: string;
  versionLatest: string;
  dbType: string;
}
interface Statistics {
  totalUsers: number;
  totalGroups: number;
}
interface Backup {
  created_at: string;
}

// Each card is best-effort: one endpoint failing blanks its card, never the page.
async function attempt<T>(label: string, load: () => Promise<T>): Promise<T | null> {
  try {
    return await load();
  } catch (e) {
    console.error(`[admin/overview] Failed to load ${label}:`, e);
    return null;
  }
}

// Probed directly rather than via fetchApi, which retries 5xx — a not-ready 503 is the answer here.
async function checkReadiness(): Promise<boolean | null> {
  try {
    const response = await fetch(getApiUrl("/readyz"), { signal: AbortSignal.timeout(READINESS_TIMEOUT_MS) });
    return response.ok;
  } catch {
    return null;
  }
}

const EVENTS_WINDOW_DAYS = 7;
const eventsSince = new Date(Date.now() - EVENTS_WINDOW_DAYS * 86_400_000).toISOString();

const [about, ready, stats, backups, tasks, plugins, recentEvents] = await Promise.all([
  attempt("about", () => fetchApi<AboutInfo>("/api/admin/about", {}, authToken)),
  checkReadiness(),
  attempt("statistics", () => fetchApi<Statistics>("/api/admin/about/statistics", {}, authToken)),
  attempt("backups", () => fetchApi<Backup[]>("/api/admin/backups", {}, authToken)),
  attempt("scheduled tasks", () => listAllTasks(authToken)),
  attempt("plugins", () => listPlugins(authToken)),
  attempt("events", () =>
    listAdminEvents(new URLSearchParams({ per_page: "1", start_date: eventsSince }).toString(), authToken),
  ),
]);
const latestEvent = recentEvents?.items[0] ?? null;

// The release check reports failures as text ("error fetching version"), so only a version-looking
// tag counts as a newer release.
const VERSION_TAG = /^v?\d/;
const stripV = (v: string) => v.replace(/^v/, "");
const updateAvailable =
  about !== null && VERSION_TAG.test(about.versionLatest) && stripV(about.versionLatest) !== stripV(about.version);

const backupSummary = backups ? summarizeBackups(backups) : null;
const taskSummary = tasks ? summarizeTasks(tasks) : null;
const failedPlugins = plugins ? plugins.filter((p) => !p.ok).length : 0;
const providerCount = plugins ? plugins.reduce((sum, p) => sum + p.providers.length, 0) : 0;

const readinessLabel = ready === null ? NO_DATA : ready ? "Ready" : "Unavailable";
const fmtDate = (iso: string) => new Date(iso).toLocaleString(undefined, { dateStyle: "medium", timeStyle: "short" });
const plural = (n: number, word: string) => `${n} ${word}${n === 1 ? "" : "s"}`;
---

<AdminLayout title="Overview">
  <div class="toolbar">
    <div>
      <h2>Platform overview</h2>
      <p>What needs attention across the platform. Each card opens its page.</p>
    </div>
  </div>

  <div class="page-container">
    <div class="status-grid">
      <a href="/admin/system" class:list={["status-card", { warn: updateAvailable || ready === false }]}>
        <h3>Version &amp; health</h3>
        <div class="status-value">{about?.version ?? NO_DATA}</div>
        <ul class="status-details">
          {about && <li>{updateAvailable ? `Update available: ${about.versionLatest}` : "Up to date"}</li>}
          <li>Database{about ? ` (${about.dbType})` : ""}: {readinessLabel}</li>
        </ul>
      </a>

      <a href="/admin/users" class="status-card">
        <h3>People</h3>
        <div class="status-value">{stats ? plural(stats.totalUsers, "user") : NO_DATA}</div>
        <ul class="status-details">
          <li>{stats ? plural(stats.totalGroups, "workspace") : NO_DATA}</li>
        </ul>
      </a>

      <a href="/admin/plugins" class:list={["status-card", { warn: failedPlugins > 0 }]}>
        <h3>Plugins</h3>
        <div class="status-value">{plugins ? `${plugins.length} installed` : NO_DATA}</div>
        <ul class="status-details">
          {plugins && <li>{plural(providerCount, "provider")}</li>}
          {failedPlugins > 0 && <li>{failedPlugins} failed to load</li>}
        </ul>
      </a>

      <a href="/admin/backups" class:list={["status-card", { warn: backupSummary !== null && backupSummary.state !== "fresh" }]}>
        <h3>Last backup</h3>
        <div class="status-value">
          {backupSummary === null ? NO_DATA : backupSummary.latestAt ? formatAge(backupSummary.latestAt) : "None yet"}
        </div>
        <ul class="status-details">
          {backupSummary?.latestAt && <li>{fmtDate(backupSummary.latestAt)}</li>}
          {backupSummary && backupSummary.state !== "fresh" && (
            <li>{backupSummary.state === "none" ? "No backup has been taken" : `Older than ${BACKUP_STALE_DAYS} days`}</li>
          )}
          {backups && <li>{plural(backups.length, "backup")} on disk</li>}
        </ul>
      </a>

      <a href="/admin/events" class="status-card">
        <h3>Platform events</h3>
        <div class="status-value">{recentEvents ? `${recentEvents.total} in ${EVENTS_WINDOW_DAYS} days` : NO_DATA}</div>
        <ul class="status-details">
          {latestEvent && <li>Latest: {latestEvent.eventName}, {formatAge(latestEvent.occurredAt)}</li>}
          {recentEvents && !latestEvent && <li>None in the last {EVENTS_WINDOW_DAYS} days</li>}
        </ul>
      </a>
      <a href="/admin/scheduled-tasks" class:list={["status-card", { warn: (taskSummary?.failing.length ?? 0) > 0 }]}>
        <h3>Scheduled tasks</h3>
        <div class="status-value">{taskSummary ? `${taskSummary.failing.length} failing` : NO_DATA}</div>
        <ul class="status-details">
          {taskSummary?.failing.slice(0, MAX_FAILING_TASKS_SHOWN).map((t) => <li class="failing">{t.name}</li>)}
          {taskSummary && taskSummary.failing.length > MAX_FAILING_TASKS_SHOWN && (
            <li>and {taskSummary.failing.length - MAX_FAILING_TASKS_SHOWN} more</li>
          )}
          {taskSummary && <li>{taskSummary.enabled} of {taskSummary.total} enabled</li>}
          {taskSummary?.lastRunAt && <li>Last run {formatAge(taskSummary.lastRunAt)}</li>}
        </ul>
      </a>
    </div>
  </div>
</AdminLayout>

<style>
  .toolbar {
    margin-bottom: 32px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--line);
  }

  .toolbar h2 {
    margin: 0;
    font-size: 24px;
    font-weight: 600;
  }

  .toolbar p {
    margin: 8px 0 0;
    color: var(--muted);
    font-size: 14px;
  }

  .page-container {
    max-width: 1200px;
  }

  .status-grid {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  }

  .status-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 20px;
    background: var(--panel);
    border: 1px solid var(--line);
    border-left: 4px solid var(--line);
    border-radius: var(--radius);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.2s;
  }

  .status-card:hover {
    border-color: var(--accent);
  }

  /* A warning keeps its colour on hover so it doesn't read as resolved. */
  .status-card.warn,
  .status-card.warn:hover {
    border-left-color: var(--warn);
  }

  .status-card h3 {
    margin: 0;
    font-size: 14px;
    font-weight: 600;
    color: var(--muted);
  }

  .status-value {
    font-size: 24px;
    font-weight: 600;
    color: var(--accent);
  }

  .status-card.warn .status-value {
    color: var(--warn);
  }

  .status-details {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 13px;
    color: var(--muted);
  }

  .status-details .failing {
    color: var(--warn);
  }
</style>
