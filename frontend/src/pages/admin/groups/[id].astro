---
import type { PlatformWorkspaceMember, Workspace } from "@inneropen/marvin-sdk/platform";
import PlatformBadge from "@/components/PlatformBadge.astro";
import AdminLayout from "@/layouts/AdminLayout.astro";
import { getAuthToken } from "@/lib/api/client";
import { createSdkClient } from "@/lib/sdk";

const authToken = getAuthToken(Astro.cookies);
const { id } = Astro.params;

let group: Workspace | null = null;
let members: PlatformWorkspaceMember[] = [];
let error: string | null = null;

if (!id) {
  error = "Group ID is required";
} else if (!authToken) {
  error = "Authentication required";
} else {
  try {
    const sdk = createSdkClient(authToken);

    // Get workspace details
    group = await sdk.workspaces.get(id);

    // Get workspace members
    members = await sdk.workspaceMembers.list(id);
  } catch (e) {
    error = e instanceof Error ? e.message : String(e);
    console.error("[admin/groups] Failed to load:", error);
  }
}
// The platform (admin's) workspace: platform alerts and shared services run from it. It can be renamed
// (name and slug) but never deleted. (`isPlatform` is newer than the SDK's Workspace type.)
const isPlatform = Boolean((group as (Workspace & { isPlatform?: boolean }) | null)?.isPlatform);
---

<AdminLayout crumb="admin.workspaces.workspace" title={group ? `Manage ${group.name}` : "Manage Workspace"}>
  {error ? (
    <div class="error-banner">
      <p><strong>Error loading workspace:</strong> {error}</p>
    </div>
  ) : group ? (
    <>
      <div class="toolbar">
        <div>
          <div class="title-row">
            <h2>{group.name}</h2>
            {isPlatform && <PlatformBadge size="md" />}
          </div>
          <p>
            {isPlatform
              ? "The admin's workspace: platform alerts and shared services run from here."
              : "Manage workspace settings and members"}
          </p>
        </div>
      </div>

      <div class="layout-grid">
        <section class="main-section">
          <div class="panel">
            <h3>{isPlatform ? "Rename the platform workspace" : "Workspace Details"}</h3>
            <form id="workspace-rename-form" class="form" data-workspace-id={group.id}>
              <div class="form-group">
                <label for="name">Name *</label>
                <input type="text" id="name" name="name" required value={group.name} />
              </div>

              <div class="form-group">
                <label for="slug">Slug</label>
                <input type="text" id="slug" name="slug" value={group.slug || ""} pattern="[A-Za-z0-9 _-]*" />
                <p class="form-help">
                  Used in Publishing API URLs (<code>/api/publish/&lt;slug&gt;/…</code>) and backup names. Leave
                  blank to derive it from the name. The old slug keeps working after a change, so sites, CLI
                  arguments and backups that use it still reach this workspace.
                </p>
              </div>

              <div class="form-actions">
                <button type="submit" class="button">Save Changes</button>
                <span id="rename-status" class="status-text" role="status" aria-live="polite"></span>
              </div>
            </form>
          </div>

          <div class="panel">
            <h3>Members ({members.length})</h3>
            {members.length === 0 ? (
              <p class="empty-message">No members in this workspace.</p>
            ) : (
              <table class="table">
                <thead>
                  <tr>
                    <th>User</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  {members.map((member) => (
                    <tr>
                      <td>
                        <strong>{member.user?.fullName || member.user?.username || 'Unknown'}</strong>
                      </td>
                      <td>{member.user?.email || '—'}</td>
                      <td><span class="role-badge">{member.workspaceRole}</span></td>
                      <td>
                        <button
                          type="button"
                          class="button secondary small danger js-remove-member"
                          data-workspace-id={id}
                          data-user-id={member.userId}
                        >
                          Remove
                        </button>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            )}
          </div>
        </section>

        <aside class="sidebar">
          <div class="panel">
            <h3>Info</h3>
            <dl class="info-list">
              <dt>Workspace ID</dt>
              <dd><code>{group.id}</code></dd>

              {group.slug && (
                <>
                  <dt>Slug</dt>
                  <dd><code>{group.slug}</code></dd>
                </>
              )}

              <dt>Total Members</dt>
              <dd>{members.length}</dd>
            </dl>
          </div>

          <div class="panel">
            <h3>Quick Actions</h3>
            <a href={`/workspace/members`} class="button secondary" style="width:100%;margin-bottom:0.5rem;">
              View Members Page
            </a>
            <a href={`/workspace/invites`} class="button secondary" style="width:100%;">
              Manage Invites
            </a>
          </div>
        </aside>
      </div>
    </>
  ) : null}
</AdminLayout>

<script>
  import { adminErrorMessage, removeWorkspaceMember, renameWorkspace } from "@/lib/api/admin/workspaces";

  const form = document.getElementById("workspace-rename-form") as HTMLFormElement | null;
  const status = document.getElementById("rename-status");
  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const id = form.dataset.workspaceId;
    if (!id) return;
    const data = new FormData(form);
    const button = form.querySelector<HTMLButtonElement>("button[type=submit]");
    if (button) button.disabled = true;
    if (status) status.textContent = "Saving…";
    try {
      const saved = await renameWorkspace(id, String(data.get("name") ?? ""), String(data.get("slug") ?? ""));
      if (status) status.textContent = `Saved — slug is now “${saved.slug}”.`;
      window.location.reload();
    } catch (err) {
      if (status) status.textContent = `Error: ${adminErrorMessage(err)}`;
      if (button) button.disabled = false;
    }
  });

  // Remove a member through the admin API. (A form here used to post to a route that never existed,
  // so Remove opened a raw "Not Found" page and the member stayed.)
  document.querySelectorAll<HTMLButtonElement>(".js-remove-member").forEach((button) => {
    button.addEventListener("click", async () => {
      if (!confirm("Remove this user from the workspace?")) return;
      button.disabled = true;
      try {
        await removeWorkspaceMember(button.dataset.workspaceId!, button.dataset.userId!);
        window.location.reload();
      } catch (err) {
        alert(`Couldn't remove them: ${adminErrorMessage(err)}`);
        button.disabled = false;
      }
    });
  });
</script>

<style>
  .title-row {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .status-text {
    margin-left: 12px;
    font-size: 13px;
    color: var(--muted);
  }

  .error-banner {
    padding: 1.5rem;
    background: var(--color-error-bg);
    border: 1px solid var(--color-error);
    border-radius: var(--radius);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .error-banner p {
    margin: 0;
    color: var(--color-error);
  }

  .toolbar {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--line);
  }

  .toolbar h2 {
    margin: 0;
    font-size: 24px;
    font-weight: 600;
  }

  .toolbar p {
    margin: 8px 0 0;
    color: var(--muted);
    font-size: 14px;
  }

  .toolbar-actions {
    display: flex;
    gap: 0.75rem;
  }

  .layout-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: 2rem;
  }

  .main-section {
    display: grid;
    gap: 2rem;
  }

  .panel {
    padding: 2rem;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .panel h3 {
    margin: 0 0 1.5rem;
    font-size: 18px;
    font-weight: 600;
  }

  .form {
    display: grid;
    gap: 1.5rem;
  }

  .form-group {
    display: grid;
    gap: 0.5rem;
  }

  label {
    font-weight: 600;
    font-size: 14px;
    color: var(--ink);
  }

  input[type="text"] {
    padding: 10px 12px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg);
    color: var(--ink);
    font-size: 14px;
  }

  input[type="text"]:focus {
    outline: none;
    border-color: var(--accent);
  }

  .form-help {
    margin: 0;
    font-size: 12px;
    color: var(--muted);
  }

  .form-actions {
    display: flex;
    gap: 12px;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .empty-message {
    padding: 3rem 2rem;
    text-align: center;
    color: var(--muted);
    background: var(--panel-2);
    border-radius: var(--radius);
  }

  .role-badge {
    display: inline-block;
    padding: 4px 10px;
    background: var(--panel-2);
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    color: var(--muted);
  }

  .button.small {
    min-height: 32px;
    padding: 6px 12px;
    font-size: 13px;
  }

  .button.danger {
    color: var(--color-error);
    border-color: var(--color-error);
  }

  .button.danger:hover {
    background: var(--color-error-bg);
  }

  .sidebar {
    display: grid;
    gap: 1.5rem;
    align-content: start;
  }

  .info-list {
    display: grid;
    gap: 1rem;
    margin: 0;
  }

  .info-list dt {
    font-size: 11px;
    font-weight: 600;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .info-list dd {
    margin: 0;
    font-size: 14px;
    color: var(--ink);
  }

  @media (max-width: 1024px) {
    .layout-grid {
      grid-template-columns: 1fr;
    }

    .sidebar {
      order: -1;
    }
  }
</style>
