---
import type { PlatformWorkspaceMember, Workspace } from "@inneropen/marvin-sdk/platform";
import LocalTime from "@/components/LocalTime.astro";
import AdminLayout from "@/layouts/AdminLayout.astro";
import { getWorkspaceDeletePreview, type WorkspaceDeletePreview } from "@/lib/api/admin/workspaces";
import { fetchApi, getAuthToken } from "@/lib/api/client";

const authToken = getAuthToken(Astro.cookies);
const { id } = Astro.params;

let group: Workspace | null = null;
let members: PlatformWorkspaceMember[] = [];
let preview: WorkspaceDeletePreview | null = null;
let error: string | null = null;

if (!id) {
  error = "Group ID is required";
} else if (!authToken) {
  error = "Authentication required";
} else {
  try {
    // The admin endpoints: they work for a super admin who is in no workspace themselves.
    [group, members, preview] = await Promise.all([
      fetchApi<Workspace>(`/api/admin/groups/${encodeURIComponent(id)}`, {}, authToken),
      fetchApi<PlatformWorkspaceMember[]>(`/api/admin/workspaces/${encodeURIComponent(id)}/members`, {}, authToken),
      getWorkspaceDeletePreview(id, authToken),
    ]);
  } catch (e) {
    error = e instanceof Error ? e.message : String(e);
    console.error("[admin/groups] Failed to load:", error);
  }
}
const bytes = (n: number) =>
  n >= 1024 ** 3 ? `${(n / 1024 ** 3).toFixed(2)} GB` : n >= 1024 ** 2 ? `${(n / 1024 ** 2).toFixed(1)} MB` : `${Math.max(1, Math.round(n / 1024))} KB`;
const plural = (n: number, one: string, many = `${one}s`) => `${n.toLocaleString()} ${n === 1 ? one : many}`;
---

<AdminLayout width="wide" crumb="admin.workspaces.workspace" title={group ? `Manage ${group.name}` : "Manage Workspace"}>
  {error ? (
    <div class="error-banner">
      <p><strong>Error loading workspace:</strong> {error}</p>
    </div>
  ) : group ? (
    <>
      <div class="toolbar">
        <div>
          <div class="title-row">
            <h2>{group.name}</h2>
          </div>
          <p>Manage workspace settings and members</p>
        </div>
      </div>

      <div class="layout-grid">
        <section class="main-section">
          <div class="panel">
            <h3>Workspace Details</h3>
            <form id="workspace-rename-form" class="form" data-workspace-id={group.id}>
              <div class="form-group">
                <label for="name">Name *</label>
                <input type="text" id="name" name="name" required value={group.name} />
              </div>

              <div class="form-group">
                <label for="slug">Slug</label>
                <input type="text" id="slug" name="slug" value={group.slug || ""} pattern="[A-Za-z0-9 _-]*" />
                <p class="form-help">
                  Used in Publishing API URLs (<code>/api/publish/&lt;slug&gt;/…</code>) and backup names. Leave
                  blank to derive it from the name. The old slug keeps working after a change, so sites, CLI
                  arguments and backups that use it still reach this workspace.
                </p>
              </div>

              <div class="form-actions">
                <button type="submit" class="button">Save Changes</button>
                <span id="rename-status" class="status-text" role="status" aria-live="polite"></span>
              </div>
            </form>
          </div>

          <div class="panel">
            <h3>Members ({members.length})</h3>
            {members.length === 0 ? (
              <p class="empty-message">No members in this workspace.</p>
            ) : (
              <div class="table-scroll">
              <table class="table">
                <thead>
                  <tr>
                    <th>User</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  {members.map((member) => (
                    <tr>
                      <td>
                        <strong>{member.user?.fullName || member.user?.username || 'Unknown'}</strong>
                      </td>
                      <td>{member.user?.email || '—'}</td>
                      <td><span class="role-badge">{member.workspaceRole}</span></td>
                      <td>
                        <button
                          type="button"
                          class="button secondary small danger js-remove-member"
                          data-workspace-id={id}
                          data-user-id={member.userId}
                        >
                          Remove
                        </button>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
              </div>
            )}
          </div>

          {preview && (
            <div class="panel danger-panel" id="delete" data-testid="delete-panel">
              <h3>Delete workspace</h3>
              <p class="form-help">
                Deleting a workspace is permanent. This is what goes with <strong>{group.name}</strong>:
              </p>
              <ul class="stakes" data-testid="delete-preview">
                <li>{plural(preview.members, "member")}</li>
                <li>{plural(preview.entries, "entry", "entries")}</li>
                <li>{plural(preview.assets, "file")} ({bytes(preview.assetBytes)})</li>
                <li>{plural(preview.integrations, "integration")}</li>
                <li>{plural(preview.scheduledTasks, "scheduled task")}</li>
                <li>{plural(preview.smtpProfiles, "SMTP profile")}</li>
                <li>{plural(preview.homeUsers, "user")} lose{preview.homeUsers === 1 ? "s" : ""} this as their home workspace (they stay, in no workspace)</li>
              </ul>
              <p class="form-help">
                Its stored files are kept for {preview.storageGraceDays} days and then purged
                (<a href="/admin/storage#deleted-workspaces">Admin → Storage</a> lists them: purge now, or keep).
                Platform events about it stay in the Event Log.
              </p>

              <div
                class="backup-state"
                id="backup-state"
                data-recent={String(preview.backupIsRecent)}
                data-hours={preview.backupMaxAgeHours}
              >
                <p id="backup-line" role="status">
                  {preview.backupIsRecent ? (
                    <>Last backup: <LocalTime iso={preview.lastBackupAt} />. That is recent enough.</>
                  ) : preview.lastBackupAt ? (
                    <>Last backup: <LocalTime iso={preview.lastBackupAt} /> — older than {preview.backupMaxAgeHours} hours.</>
                  ) : (
                    <>No backup of this workspace yet.</>
                  )}
                </p>
                <button type="button" id="backup-now" class="button secondary small" data-workspace-id={group.id}>Back up now</button>
              </div>

              <label class="checkbox-row" id="skip-backup-row" hidden={preview.backupIsRecent}>
                <input type="checkbox" id="skip-backup" />
                <span>Delete without a backup (a bundle from the last {preview.backupMaxAgeHours} hours is required otherwise)</span>
              </label>

              <div class="form-group">
                <label for="confirm-name">Type the workspace name to confirm: <code>{group.name}</code></label>
                <input
                  type="text"
                  id="confirm-name"
                  autocomplete="off"
                  autocapitalize="off"
                  spellcheck="false"
                  data-name={group.name}
                  data-workspace-id={group.id}
                />
              </div>
              <div class="form-actions">
                <button type="button" id="delete-workspace" class="button secondary danger" disabled>Delete workspace</button>
                <span id="delete-status" class="status-text" role="status" aria-live="polite"></span>
              </div>
            </div>
          )}
        </section>

        <aside class="sidebar">
          <div class="panel">
            <h3>Info</h3>
            <dl class="info-list">
              <dt>Workspace ID</dt>
              <dd><code>{group.id}</code></dd>

              {group.slug && (
                <>
                  <dt>Slug</dt>
                  <dd><code>{group.slug}</code></dd>
                </>
              )}

              <dt>Total Members</dt>
              <dd>{members.length}</dd>
            </dl>
          </div>

          <div class="panel">
            <h3>Quick Actions</h3>
            <a href={`/workspace/members`} class="button secondary" style="width:100%;margin-bottom:0.5rem;">
              View Members Page
            </a>
            <a href={`/workspace/invites`} class="button secondary" style="width:100%;">
              Manage Invites
            </a>
          </div>
        </aside>
      </div>
    </>
  ) : null}
</AdminLayout>

<script>
  import {
    adminErrorMessage,
    backUpWorkspace,
    deleteWorkspace,
    removeWorkspaceMember,
    renameWorkspace,
  } from "@/lib/api/admin/workspaces";

  const form = document.getElementById("workspace-rename-form") as HTMLFormElement | null;
  const status = document.getElementById("rename-status");
  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const id = form.dataset.workspaceId;
    if (!id) return;
    const data = new FormData(form);
    const button = form.querySelector<HTMLButtonElement>("button[type=submit]");
    if (button) button.disabled = true;
    if (status) status.textContent = "Saving…";
    try {
      const saved = await renameWorkspace(id, String(data.get("name") ?? ""), String(data.get("slug") ?? ""));
      if (status) status.textContent = `Saved — slug is now “${saved.slug}”.`;
      window.location.reload();
    } catch (err) {
      if (status) status.textContent = `Error: ${adminErrorMessage(err)}`;
      if (button) button.disabled = false;
    }
  });

  // Remove a member through the admin API. (A form here used to post to a route that never existed,
  // so Remove opened a raw "Not Found" page and the member stayed.)
  document.querySelectorAll<HTMLButtonElement>(".js-remove-member").forEach((button) => {
    button.addEventListener("click", async () => {
      if (!confirm("Remove this user from the workspace?")) return;
      button.disabled = true;
      try {
        await removeWorkspaceMember(button.dataset.workspaceId!, button.dataset.userId!);
        window.location.reload();
      } catch (err) {
        alert(`Couldn't remove them: ${adminErrorMessage(err)}`);
        button.disabled = false;
      }
    });
  });

  // Delete: the typed name, plus a bundle from the last day ("Back up now") or an explicit skip.
  const nameInput = document.getElementById("confirm-name") as HTMLInputElement | null;
  const deleteButton = document.getElementById("delete-workspace") as HTMLButtonElement | null;
  const deleteStatus = document.getElementById("delete-status");
  const backupState = document.getElementById("backup-state");
  const skipBox = document.getElementById("skip-backup") as HTMLInputElement | null;
  const skipRow = document.getElementById("skip-backup-row");
  const backupLine = document.getElementById("backup-line");
  const backupButton = document.getElementById("backup-now") as HTMLButtonElement | null;

  const recent = () => backupState?.dataset.recent === "true";
  const refreshDelete = () => {
    if (!nameInput || !deleteButton) return;
    deleteButton.disabled = !(nameInput.value === nameInput.dataset.name && (recent() || skipBox?.checked));
  };
  nameInput?.addEventListener("input", refreshDelete);
  skipBox?.addEventListener("change", refreshDelete);

  backupButton?.addEventListener("click", async () => {
    const id = backupButton.dataset.workspaceId;
    if (!id) return;
    backupButton.disabled = true;
    if (backupLine) backupLine.textContent = "Backing up…";
    try {
      const made = await backUpWorkspace(id);
      if (backupState) backupState.dataset.recent = "true";
      if (backupLine) {
        backupLine.textContent = `Backed up just now (${made.filename}). `;
        const link = document.createElement("a");
        link.href = made.download_url;
        link.textContent = "Download it";
        backupLine.append(link, ".");
      }
      if (skipRow) skipRow.hidden = true;
      if (skipBox) skipBox.checked = false;
      refreshDelete();
    } catch (err) {
      if (backupLine) backupLine.textContent = `The backup failed: ${adminErrorMessage(err)}`;
    } finally {
      backupButton.disabled = false;
    }
  });

  deleteButton?.addEventListener("click", async () => {
    const id = nameInput?.dataset.workspaceId;
    if (!id || !nameInput) return;
    deleteButton.disabled = true;
    if (deleteStatus) deleteStatus.textContent = "Deleting…";
    try {
      const result = await deleteWorkspace(id, { confirmName: nameInput.value, skipBackup: !recent() && Boolean(skipBox?.checked) });
      const next = new URLSearchParams({ deleted: nameInput.dataset.name ?? "" });
      if (result.storageLocations > 0) next.set("kept", "30");
      window.location.href = `/admin/workspaces?${next}`;
    } catch (err) {
      if (deleteStatus) deleteStatus.textContent = `Couldn't delete it: ${adminErrorMessage(err)}`;
      refreshDelete();
    }
  });
</script>

<style>
  .danger-panel {
    border-color: var(--color-error);
  }

  .stakes {
    margin: 0 0 1rem;
    padding-left: 1.25rem;
    display: grid;
    gap: 4px;
    font-size: 14px;
  }

  .backup-state {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    margin: 1rem 0;
    font-size: 14px;
  }

  .backup-state p {
    margin: 0;
  }

  .checkbox-row {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    margin-bottom: 1rem;
    font-weight: 400;
    font-size: 14px;
  }

  .checkbox-row[hidden] {
    display: none;
  }

  .checkbox-row input {
    margin-top: 3px;
  }

  .button.danger:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .title-row {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .status-text {
    margin-left: 12px;
    font-size: 13px;
    color: var(--muted);
  }

  .error-banner {
    padding: 1.5rem;
    background: var(--color-error-bg);
    border: 1px solid var(--color-error);
    border-radius: var(--radius);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .error-banner p {
    margin: 0;
    color: var(--color-error);
  }

  .toolbar {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--line);
  }

  .toolbar h2 {
    margin: 0;
    font-size: 24px;
    font-weight: 600;
  }

  .toolbar p {
    margin: 8px 0 0;
    color: var(--muted);
    font-size: 14px;
  }

  .toolbar-actions {
    display: flex;
    gap: 0.75rem;
  }

  .table-scroll {
    overflow-x: auto;
  }

  .layout-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: 2rem;
  }

  .main-section {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
  }

  .panel {
    padding: 2rem;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .panel h3 {
    margin: 0 0 1.5rem;
    font-size: 18px;
    font-weight: 600;
  }

  .form {
    display: grid;
    gap: 1.5rem;
  }

  .form-group {
    display: grid;
    gap: 0.5rem;
  }

  label {
    font-weight: 600;
    font-size: 14px;
    color: var(--ink);
  }

  input[type="text"] {
    padding: 10px 12px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg);
    color: var(--ink);
    font-size: 14px;
  }

  input[type="text"]:focus {
    outline: none;
    border-color: var(--accent);
  }

  .form-help {
    margin: 0;
    font-size: 12px;
    color: var(--muted);
  }

  .form-actions {
    display: flex;
    gap: 12px;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .empty-message {
    padding: 3rem 2rem;
    text-align: center;
    color: var(--muted);
    background: var(--panel-2);
    border-radius: var(--radius);
  }

  .role-badge {
    display: inline-block;
    padding: 4px 10px;
    background: var(--panel-2);
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    color: var(--muted);
  }

  .button.small {
    min-height: 32px;
    padding: 6px 12px;
    font-size: 13px;
  }

  .button.danger {
    color: var(--color-error);
    border-color: var(--color-error);
  }

  .button.danger:hover {
    background: var(--color-error-bg);
  }

  .sidebar {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    align-content: start;
  }

  .info-list {
    display: grid;
    gap: 1rem;
    margin: 0;
  }

  .info-list dt {
    font-size: 11px;
    font-weight: 600;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .info-list dd {
    margin: 0;
    overflow-wrap: anywhere;
    font-size: 14px;
    color: var(--ink);
  }

  @media (max-width: 1024px) {
    .layout-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .sidebar {
      order: -1;
    }
  }

  @media (max-width: 640px) {
    .panel {
      padding: 1.25rem;
    }

    .toolbar {
      flex-direction: column;
      gap: 0.75rem;
    }

    .form-actions {
      flex-wrap: wrap;
    }

    .form-actions .button,
    .backup-state .button {
      min-height: 40px;
    }

    .form-actions .button {
      flex: 1 1 100%;
    }
  }
</style>
