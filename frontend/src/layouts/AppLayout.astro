---
import ThemeInit from "@/components/ThemeInit.astro";
import "../styles/global.css";
import ActivityToaster from "@/components/ActivityToaster.astro";
import EnvironmentBadge from "@/components/EnvironmentBadge.astro";
import Marvin from "@/components/Marvin.astro";
import UploadQueue from "@/components/UploadQueue.astro";
import NavDrawerToggle from "@/components/NavDrawerToggle.astro";
import RuntimeConfig from "@/components/RuntimeConfig.astro";
import UpdateBanner from "@/components/UpdateBanner.astro";
import LocalTimeScript from "@/components/LocalTimeScript.astro";
import ThemeSwitcher from "@/components/ThemeSwitcher.astro";
import WorkspaceSwitcher from "@/components/WorkspaceSwitcher.astro";
import NavTrail from "@/components/NavTrail.astro";
import Pwa from "@/components/Pwa.astro";
import { fetchApi, getAuthToken } from "@/lib/api/client";
import { getEnvironmentLabel, withEnvironmentPrefix } from "@/lib/environmentLabel";
import { sourceAllowed } from "@/lib/marvin/gate";
import { navTitle, navTrail } from "@/lib/navTree";
import { createSdkClient } from "@/lib/sdk";
import { listAssetTypes } from "@/lib/api/assets";
import { listCollections } from "@/lib/api/collections";
import { listResourceTypes } from "@/lib/api/resources";
import { listEntryTypes } from "@/lib/api/entryTypes";
import { getContentAccess } from "@/lib/api/workspaces";
import { ADMINS_ONLY } from "@/lib/workspaceRole";

interface Props {
  /**
   * This page's node in lib/navTree.ts (settings, automation and publishing pages). The layout shows its ancestors as
   * the breadcrumb trail above the H1, in place of the eyebrow, and its title as the H1 unless `title` is passed.
   */
  crumb?: string;
  /** Route params for a dynamic ancestor's link, e.g. { type } on the event type → webhook page. */
  crumbParams?: Record<string, string>;
  /** Labels for dynamic ancestors by node id, e.g. { "automation.events.type": "Entry published" }. */
  crumbLabels?: Record<string, string>;
  /** The H1. Optional with `crumb` (defaults to the node's title); detail pages pass their own. */
  title?: string;
  /** The line above the H1 on pages that have no `crumb` (content pages). */
  eyebrow?: string;
  /**
   * Optional page grounding for the Marvin bubble — what entity this page is rendering.
   * Detail pages declare it; it's stamped onto <body> as data-entity-* and read back by
   * @/lib/marvin/context. Grounding only: it does not widen permissions.
   */
  /**
   * Only declare a type the agent can actually resolve with a tool (get_entry, get_asset,
   * get_resource, get_collection, get_entry_type). Grounding a page whose entity the agent
   * cannot fetch invites hallucination rather than preventing it.
   */
  entityType?: "entry" | "asset" | "resource" | "collection" | "entry_type";
  entityId?: string;
  entityLabel?: string;
  /**
   * The page is workspace-admin only and the caller isn't one (the API answered 403): show the
   * admins-only note in place of the page body, so a member never sees controls the API refuses.
   */
  adminOnly?: boolean;
  /**
   * The caller's role can't use this page (e.g. EDITORS_ONLY or AUTHORS_ONLY from lib/workspaceRole):
   * show this note in place of the page body. `adminOnly` is the same with ADMINS_ONLY.
   */
  restrictedNote?: string | null;
}

const { crumb, crumbParams, crumbLabels, eyebrow = "Marvin Platform", entityType, entityId, entityLabel, adminOnly = false, restrictedNote = null } = Astro.props;
const title = Astro.props.title ?? (crumb ? navTitle(crumb) : "");
const trail = crumb ? navTrail(crumb, { params: crumbParams, labels: crumbLabels }) : null;
const blockedNote = adminOnly ? ADMINS_ONLY : restrictedNote;
const path = Astro.url.pathname;
// Non-production instances (backend ENVIRONMENT_LABEL) badge the header and prefix the tab title.
const environmentLabel = await getEnvironmentLabel();

// Check if user is admin and get platform role
const authToken = getAuthToken(Astro.cookies);
const sdk = createSdkClient(authToken);
let isAdmin = false;
let isSuperAdmin = false;
let currentUserId: string | null = null;
try {
  const currentUser = (await sdk.user.getProfile()) as any;
  currentUserId = currentUser?.id ?? null;
  isAdmin = currentUser?.admin === true;
  isSuperAdmin = currentUser?.platformRole === "SUPER_ADMIN";

  if (import.meta.env.DEV) {
    console.debug("[AppLayout] User role check:", {
      admin: isAdmin,
      superAdmin: isSuperAdmin,
      platformRole: currentUser?.platformRole,
      workspaceMemberships: currentUser?.workspaceMemberships,
    });
    console.debug("[AppLayout] Full user object:", currentUser);
  }
} catch (e) {
  // Not logged in or error
}

// Entries badge: how many entries wait in `inbox` (agents and forms drop drafts there). Best-effort —
// a failed count just hides the badge.
// The installed app's icon adds the approvals waiting for you in any workspace (GET /api/self/push/badge).
let inboxCount = 0;
let appBadge = 0;
if (authToken) {
  try {
    const badge = await fetchApi<{ inbox: number; count: number }>("/api/self/push/badge", {}, authToken);
    inboxCount = Number(badge.inbox ?? 0);
    appBadge = Number(badge.count ?? inboxCount);
  } catch {
    inboxCount = appBadge = 0;
  }
}

// Ask link: hidden while the workspace has the Ask page invocation source switched off. Best-effort — a
// failed read keeps the link (the page explains itself).
let askLinkShown = true;
if (authToken) {
  try {
    askLinkShown = sourceAllowed(((await sdk.ai.settings.get()) as any)?.invocationSources, "ask_page");
  } catch {
    askLinkShown = true;
  }
}

// The New menu: this workspace's entry types (the dashboard's Quick Create, in reach from every page). Best-effort.
let newTypes: { id: string; name: string; icon?: string | null }[] = [];
let canAuthor = false;
// The system collections (Inbox, Drafts, Needs Review, Approved — every workspace has them) are Gmail's folders, with
// Published and Trash after them; a person's own collections fold under Content, like labels.
let folders: { id: string; name: string; slug: string; icon: string | null; count: number }[] = [];
let collections: { id: string; name: string; icon: string | null }[] = [];
// Assets and Resources fold open to their types in use, each with a count.
let assetTypes: { type: string; count: number }[] = [];
let resourceTypes: { type: string; count: number }[] = [];
if (authToken) {
  try {
    const [types, access, colls, aTypes, rTypes] = await Promise.all([
      listEntryTypes(authToken),
      getContentAccess(authToken),
      listCollections(authToken),
      listAssetTypes(authToken).catch(() => []),
      listResourceTypes(authToken).catch(() => []),
    ]);
    assetTypes = aTypes;
    resourceTypes = rTypes;
    canAuthor = access.canAuthor;
    newTypes = (types ?? []).slice(0, 8).map((t: any) => ({ id: t.id, name: t.name, icon: t.icon ?? null }));
    const all = (colls ?? []).map((c: any) => ({ id: c.id, name: c.name, slug: c.slug, icon: c.icon ?? null, system: Boolean(c.isSystem), count: Number(c.entryCount ?? 0) }));
    folders = all.filter((c) => c.system);
    collections = all.filter((c) => !c.system).slice(0, 10);
  } catch {
    newTypes = [];
  }
}
const hasFolder = (slug: string) => folders.some((c) => c.slug === slug);
// Each folder with the icon and count the Collections page gives it; Inbox and Needs Review are things to do, so
// their counts stand out (Gmail's unread), the rest read as plain totals.
const ATTENTION = new Set(["inbox", "needs-review"]);
// In the publish lifecycle's order — Published sits after Approved — then anything else a workspace has (Archive, Trash).
const LIFECYCLE = ["inbox", "drafts", "needs-review", "approved", "published", "archive", "trash"];
const rank = (slug: string) => (LIFECYCLE.includes(slug) ? LIFECYCLE.indexOf(slug) : LIFECYCLE.length);
const folderRows = folders.map((c) => ({ slug: c.slug, href: `/workspace/collections/${c.id}`, label: c.name, icon: c.icon || "📁", count: c.count, attention: ATTENTION.has(c.slug) }));
if (!hasFolder("published")) folderRows.push({ slug: "published", href: "/workspace/entries?status=published", label: "Published", icon: "✅", count: 0, attention: false });
if (!hasFolder("trash") && !hasFolder("trashed")) folderRows.push({ slug: "trash", href: "/workspace/entries?status=trashed", label: "Trash", icon: "🗑", count: 0, attention: false });
const ENTRY_FOLDERS = folderRows.sort((a, b) => rank(a.slug) - rank(b.slug));
const here = Astro.url.pathname + Astro.url.search;
const onEntries = Astro.url.pathname === "/workspace/entries" && !Astro.url.searchParams.get("status");
const onCollections = Astro.url.pathname.startsWith("/workspace/collections") && !folders.some((c) => Astro.url.pathname === `/workspace/collections/${c.id}`);
const ASSET_TYPE_LABELS: Record<string, string> = { image: "Images", svg: "SVGs", document: "Documents", video: "Videos", audio: "Audio", archive: "Archives", other: "Other" };
const ASSET_TYPE_ICONS: Record<string, string> = { image: "🖼", svg: "✒️", document: "📄", video: "🎬", audio: "🎵", archive: "🗜", other: "📦" };
const typeLabel = (t: string) => t.charAt(0).toUpperCase() + t.slice(1).replace(/[-_]/g, " ");
const onAssets = Astro.url.pathname.startsWith("/workspace/assets");
const onResources = Astro.url.pathname.startsWith("/workspace/resources");
const typeHere = Astro.url.searchParams.get("type");
// Settings as a group of the hub's tabs, not one opaque link: the page's tab is marked, and the group stays open on
// any settings page (elsewhere, a person's last choice — remembered on the device).
const SETTINGS_TABS: { tab: string; label: string; icon: string; paths: string[]; badge?: number }[] = [
  { tab: "general", label: "General", icon: "⚙", paths: ["/workspace/settings/general", "/workspace/settings/environment", "/workspace/settings/secrets", "/workspace/settings/backups"] },
  { tab: "members", label: "Members", icon: "👥", paths: ["/workspace/members", "/workspace/invites"] },
  { tab: "entry-types", label: "Content model", icon: "🧩", paths: ["/workspace/entry-types", "/workspace/tags"] },
  { tab: "email", label: "Email", icon: "✉", paths: ["/workspace/settings/email"] },
  { tab: "publishing", label: "Publishing", icon: "🚀", paths: ["/publishing", "/workspace/settings/submission-protection"] },
  { tab: "automation", label: "Automation", icon: "⚡", paths: ["/automation", "/workspace/events", "/workspace/scheduled-tasks"], badge: Math.max(0, appBadge - inboxCount) },
  { tab: "ai", label: "AI", icon: "✨", paths: ["/workspace/settings/ai-"] },
  { tab: "integrations", label: "Integrations", icon: "🔌", paths: ["/workspace/settings/integrations"] },
];
const ASK_PATH = "/workspace/settings/ai-ask";
const activeTab = SETTINGS_TABS.find((t) => t.paths.some((p) => Astro.url.pathname.startsWith(p)) && Astro.url.pathname !== ASK_PATH)?.tab
  ?? (Astro.url.pathname === "/workspace/settings" ? Astro.url.searchParams.get("tab") || "general" : null);
const onSettings = activeTab !== null;
// Simplified navigation following 80% rule

// Primary sidebar contains only daily-use features
const navGroups = [
  {
    label: null,
    items: [
      { href: "/", label: "Dashboard", icon: "⌂" },
      // Quick link to the agent chat; the page itself gates on AI being enabled.
      ...(askLinkShown ? [{ href: ASK_PATH, label: "Ask", icon: "💬" }] : []),
    ],
  },
];

const finalNavGroups = [...navGroups];


// Helper to check if path is active (exact or starts with for nested routes)
function isActive(itemPath: string, currentPath: string): boolean {
  if (itemPath === "/") {
    return currentPath === "/";
  }
  // The Workspace "Settings" item lands on /workspace (dashboard) and owns the settings
  // sections, but NOT sibling content routes like /workspace/entries or /workspace/assets.
  if (itemPath === "/workspace") {
    return currentPath === "/workspace" || (currentPath.startsWith("/workspace/settings") && currentPath !== ASK_PATH);
  }
  return currentPath === itemPath || currentPath.startsWith(`${itemPath}/`);
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <ThemeInit />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Marvin platform admin frontend" />
    <title>{withEnvironmentPrefix(`${title} | Marvin`, environmentLabel)}</title>
    <RuntimeConfig />
    <Pwa environmentLabel={environmentLabel} badgeCount={authToken ? appBadge : null} />
  </head>
  <body
    data-entity-type={entityType}
    data-entity-id={entityId}
    data-entity-label={entityLabel}
  >
    <div class="app-shell">
      <aside class="sidebar" id="app-sidebar" aria-label="Navigation">
        <div class="sidebar-header">
          <WorkspaceSwitcher showPlatformBadge={isSuperAdmin} />
        </div>
        {canAuthor && (
          <details class="nav-new">
            <summary class="button nav-new-button">＋ New</summary>
            <nav class="nav nav-new-menu" aria-label="New">
              {newTypes.map((t) => (
                <a href={`/workspace/entries/new?type=${t.id}`}><span aria-hidden="true">{t.icon || "📝"}</span><span>{t.name}</span></a>
              ))}
              <a href="/workspace/assets/new"><span aria-hidden="true">🖼</span><span>Upload files</span></a>
              <a href="/workspace/collections/new"><span aria-hidden="true">📚</span><span>Collection</span></a>
            </nav>
          </details>
        )}
        {finalNavGroups.slice(0, 1).map((group) => (
          <div class="nav-group">
            <nav class="nav" aria-label="Primary">
              {group.items.map((item) => (
                <a href={item.href} aria-current={isActive(item.href, path) ? "page" : undefined}>
                  <span aria-hidden="true">{item.icon}</span><span>{item.label}</span>
                </a>
              ))}
            </nav>
          </div>
        ))}
        <div class="nav-group">
          <a class="nav-group-label nav-group-link" href="/workspace/entries" aria-current={onEntries ? "page" : undefined}>Entries</a>
          <nav class="nav" aria-label="Entries">
            {ENTRY_FOLDERS.map((f) => (
              <a href={f.href} aria-current={here === f.href || path === f.href ? "page" : undefined}>
                <span aria-hidden="true">{f.icon}</span>
                <span>{f.label}</span>
                {(f.count ?? 0) > 0 && <span class:list={["nav-count", { attention: f.attention }]} aria-label={`${f.count} entries`}>{(f.count ?? 0) > 999 ? "999+" : f.count}</span>}
              </a>
            ))}
          </nav>
        </div>
        <div class="nav-group">
          <div class="nav-group-label">Content</div>
          <nav class="nav" aria-label="Content">
            <details class="nav-fold" open={onCollections}>
              <summary class="nav-fold-row" aria-current={onCollections ? "page" : undefined}>
                <span aria-hidden="true">📚</span><span>Collections</span><span class="nav-chevron" aria-hidden="true">›</span>
              </summary>
              <div class="nav nav-fold-items">
                {collections.map((c) => (
                  <a href={`/workspace/collections/${c.id}`} aria-current={path === `/workspace/collections/${c.id}` ? "page" : undefined}><span aria-hidden="true">{c.icon || "📁"}</span><span>{c.name}</span></a>
                ))}
                <a href="/workspace/collections" class="nav-fold-all"><span aria-hidden="true">📚</span><span>All collections</span></a>
              </div>
            </details>
            <details class="nav-fold" open={onAssets}>
              <summary class="nav-fold-row" aria-current={onAssets && !typeHere ? "page" : undefined}>
                <span aria-hidden="true">🖼</span><span>Assets</span><span class="nav-chevron" aria-hidden="true">›</span>
              </summary>
              <div class="nav nav-fold-items">
                {assetTypes.map((t) => (
                  <a href={`/workspace/assets?type=${encodeURIComponent(t.type)}`} aria-current={onAssets && typeHere === t.type ? "page" : undefined}>
                    <span aria-hidden="true">{ASSET_TYPE_ICONS[t.type] ?? "📦"}</span><span>{ASSET_TYPE_LABELS[t.type] ?? typeLabel(t.type)}</span>
                    <span class="nav-count">{t.count > 999 ? "999+" : t.count}</span>
                  </a>
                ))}
                <a href="/workspace/assets" class="nav-fold-all"><span aria-hidden="true">🖼</span><span>All assets</span></a>
              </div>
            </details>
            <details class="nav-fold" open={onResources}>
              <summary class="nav-fold-row" aria-current={onResources && !typeHere ? "page" : undefined}>
                <span aria-hidden="true">🔗</span><span>Resources</span><span class="nav-chevron" aria-hidden="true">›</span>
              </summary>
              <div class="nav nav-fold-items">
                {resourceTypes.map((t) => (
                  <a href={`/workspace/resources?type=${encodeURIComponent(t.type)}`} aria-current={onResources && typeHere === t.type ? "page" : undefined}>
                    <span aria-hidden="true">🔗</span><span>{typeLabel(t.type)}</span>
                    <span class="nav-count">{t.count > 999 ? "999+" : t.count}</span>
                  </a>
                ))}
                <a href="/workspace/resources" class="nav-fold-all"><span aria-hidden="true">🔗</span><span>All resources</span></a>
              </div>
            </details>
          </nav>
        </div>
        {finalNavGroups.slice(1).map((group) => (
          <div class="nav-group">
            {group.label && (
              <div class="nav-group-label">{group.label}</div>
            )}
            <nav class="nav" aria-label={group.label || "Primary"}>
              {group.items.map((item) => (
                <a href={item.href} aria-current={isActive(item.href, path) ? "page" : undefined}>
                  <span aria-hidden="true">{item.icon}</span>
                  <span>{item.label}</span>
                </a>
              ))}
            </nav>
          </div>
        ))}
        <details class="nav-group nav-settings" id="nav-settings" open={onSettings} data-forced={onSettings ? "1" : undefined}>
          <summary class="nav-settings-row">
            <span aria-hidden="true">⚙</span><span>Settings</span><span class="nav-chevron" aria-hidden="true">›</span>
          </summary>
          <nav class="nav" aria-label="Settings">
            {SETTINGS_TABS.map((t) => (
              <a href={`/workspace/settings?tab=${t.tab}`} aria-current={activeTab === t.tab ? "page" : undefined}>
                <span aria-hidden="true">{t.icon}</span>
                <span>{t.label}</span>
                {(t.badge ?? 0) > 0 && <span class="nav-badge" aria-label={`${t.badge} waiting for you`}>{(t.badge ?? 0) > 99 ? "99+" : t.badge}</span>}
              </a>
            ))}
          </nav>
        </details>
        {isSuperAdmin && (
          <div class="nav-group nav-group-admin">
            <div class="nav-group-label">Administration</div>
            <nav class="nav" aria-label="Administration"><a href="/admin" aria-current={path.startsWith("/admin") ? "page" : undefined}><span aria-hidden="true">🛠</span><span>Admin Settings</span></a></nav>
          </div>
        )}
        <script>
          // The Settings group remembers whether it was open, per device — unless the page is one of its own.
          const group = document.getElementById("nav-settings") as HTMLDetailsElement | null;
          if (group && !group.dataset.forced) {
            try { group.open = localStorage.getItem("nav.settings.open") === "1"; } catch { /* storage off */ }
          }
          group?.addEventListener("toggle", () => { try { localStorage.setItem("nav.settings.open", group.open ? "1" : "0"); } catch { /* storage off */ } });
        </script>
      </aside>
      <main class="main">
        <header class="topbar">
          <div class="topbar-left">
            <NavDrawerToggle controls="app-sidebar" />
            <EnvironmentBadge label={environmentLabel} />
            <div class="topbar-title">
              {trail ? <NavTrail trail={trail} /> : <p>{eyebrow}</p>}
              <h1>{title}</h1>
            </div>
          </div>
          <div class="topbar-actions">
            {authToken && <ActivityToaster userId={currentUserId} askPage={askLinkShown} platformFeed={isSuperAdmin} />}
            <a class="button secondary topbar-profile" href="/user/profile" aria-current={path.startsWith("/user/") ? "page" : undefined} title="Profile"><span aria-hidden="true">👤</span><span class="topbar-profile-label">Profile</span></a>
            <form method="POST" action="/api/auth/logout" style="display:inline;">
              <button type="submit" class="button secondary">Logout</button>
            </form>
          </div>
        </header>
        <section class="content">
          {blockedNote ? (
            <div class="alert alert-info" role="status">{blockedNote}</div>
          ) : (
            <slot />
          )}
        </section>
      </main>
      <ThemeSwitcher />
      <Marvin />
      <UploadQueue />
    </div>

    <UpdateBanner />
    <LocalTimeScript />
  </body>
</html>
