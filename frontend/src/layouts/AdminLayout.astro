---
import ThemeInit from "@/components/ThemeInit.astro";
import "../styles/global.css";
import EnvironmentBadge from "@/components/EnvironmentBadge.astro";
import NavDrawerToggle from "@/components/NavDrawerToggle.astro";
import RuntimeConfig from "@/components/RuntimeConfig.astro";
import UpdateBanner from "@/components/UpdateBanner.astro";
import ThemeSwitcher from "@/components/ThemeSwitcher.astro";
import NavTrail from "@/components/NavTrail.astro";
import { getEnvironmentLabel, withEnvironmentPrefix } from "@/lib/environmentLabel";
import { navHref, navNode, navTitle, navTrail } from "@/lib/navTree";

interface Props {
  /** This page's node in lib/navTree.ts; the layout builds the breadcrumb trail from it. */
  crumb: string;
  /** The H1 when it isn't the node's title (detail pages: the user's name, the task's name). */
  title?: string;
}

const { crumb, title = navTitle(crumb) } = Astro.props;
const trail = navTrail(crumb);
const path = Astro.url.pathname;
// Non-production instances (backend ENVIRONMENT_LABEL) badge the header and prefix the tab title.
const environmentLabel = await getEnvironmentLabel();

interface AdminNavItem {
  href: string;
  label: string;
  icon: string;
  /** Other path prefixes that belong to this item, so its sub-pages keep it highlighted. */
  alsoMatches?: string[];
}

interface AdminNavGroup {
  label: string | null;
  /** Names an unlabelled group's <nav> for screen readers. */
  ariaLabel?: string;
  items: AdminNavItem[];
}

const OVERVIEW_PATH = navHref("admin");

/** A sidebar row for a node in lib/navTree.ts: its link and label come from the map. */
function item(id: string, icon: string, extra: Partial<AdminNavItem> = {}): AdminNavItem {
  const node = navNode(id);
  return { href: node.href, label: node.label, icon, ...extra };
}

// Grouped by what an operator is doing, so new areas (more plugin kinds) have an obvious home.
const adminNavGroups: AdminNavGroup[] = [
  {
    label: null,
    items: [item("admin", "⌂", { label: navTitle("admin") })],
  },
  {
    label: "People & access",
    items: [
      item("admin.users", "👥"),
      // A workspace's detail page still lives under its legacy /admin/groups/{id} path.
      item("admin.workspaces", "◫", { alsoMatches: ["/admin/groups"] }),
      item("admin.roles", "🔑"),
    ],
  },
  {
    label: "Settings",
    items: [item("admin.site-settings", "⚙"), item("admin.email", "📧"), item("admin.submission-protection", "🛡")],
  },
  {
    label: "Extensions",
    items: [item("admin.plugins", "🧩"), item("admin.character-library", "🎭")],
  },
  {
    label: "Operations",
    items: [
      item("admin.system", "📊"),
      item("admin.events", "🗂"),
      item("admin.scheduled-tasks", "⏱"),
      item("admin.backups", "💾"),
      item("admin.maintenance", "🔧"),
    ],
  },
  {
    label: null,
    ariaLabel: "Leave admin",
    items: [{ href: "/", label: "Back to workspace", icon: "◄" }],
  },
];

function isUnder(prefix: string, currentPath: string): boolean {
  return currentPath === prefix || currentPath.startsWith(`${prefix}/`);
}

// The overview only matches itself; every other item also owns its sub-pages (/admin/users/123).
function isActive(item: AdminNavItem, currentPath: string): boolean {
  if (item.href === OVERVIEW_PATH) {
    return currentPath === OVERVIEW_PATH || currentPath === `${OVERVIEW_PATH}/`;
  }
  return [item.href, ...(item.alsoMatches ?? [])].some((prefix) => isUnder(prefix, currentPath));
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <ThemeInit />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Marvin platform admin" />
    <title>{withEnvironmentPrefix(`${title} | Marvin Admin`, environmentLabel)}</title>
    <RuntimeConfig />
  </head>
  <body>
    <div class="app-shell">
      <aside class="sidebar admin-sidebar" id="app-sidebar" aria-label="Navigation">
        <a class="brand" href="/admin">
          <strong>Marvin Admin</strong>
          <span>Platform administration</span>
        </a>
        {adminNavGroups.map((group) => (
          <div class="nav-group">
            {group.label && (
              <div class="nav-group-label">{group.label}</div>
            )}
            <nav class="nav" aria-label={group.label ?? group.ariaLabel ?? "Primary"}>
              {group.items.map((item) => (
                <a href={item.href} aria-current={isActive(item, path) ? "page" : undefined}>
                  <span aria-hidden="true">{item.icon}</span>
                  <span>{item.label}</span>
                </a>
              ))}
            </nav>
          </div>
        ))}
      </aside>
      <main class="main">
        <header class="topbar">
          <div class="topbar-left">
            <NavDrawerToggle controls="app-sidebar" />
            <EnvironmentBadge label={environmentLabel} />
            <div class="topbar-title">
              <NavTrail trail={trail} />
              <h1>{title}</h1>
            </div>
          </div>
          <div class="topbar-actions">
            <a class="button secondary" href="/">Back to workspace</a>
            <form method="POST" action="/api/auth/logout" style="display:inline;">
              <button type="submit" class="button secondary">Logout</button>
            </form>
          </div>
        </header>
        <section class="content">
          <slot />
        </section>
      </main>
      <ThemeSwitcher />
    </div>
    <UpdateBanner />
  </body>
</html>

<style>
  /* Admin sidebar has different styling to distinguish it from user sidebar */
  .admin-sidebar {
    background: var(--panel);
    border-right: 2px solid var(--accent);
  }

  .admin-sidebar .brand {
    border-bottom-color: var(--line);
  }

  .admin-sidebar .nav-group-label {
    color: var(--muted);
    font-weight: 600;
  }

  .admin-sidebar .nav a {
    color: var(--ink);
    opacity: 0.8;
  }

  .admin-sidebar .nav a:hover {
    background: var(--panel-2);
    color: var(--ink);
    opacity: 1;
  }

  .admin-sidebar .nav a[aria-current="page"] {
    background: var(--color-primary-bg);
    color: var(--accent);
    opacity: 1;
    font-weight: 600;
  }
</style>
