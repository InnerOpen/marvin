---
import "../styles/global.css";
import RuntimeConfig from "@/components/RuntimeConfig.astro";
import ThemeSwitcher from "@/components/ThemeSwitcher.astro";

interface Props {
  title: string;
  eyebrow?: string;
}

const { title, eyebrow = "Admin" } = Astro.props;
const path = Astro.url.pathname;

interface AdminNavItem {
  href: string;
  label: string;
  icon: string;
  /** Other path prefixes that belong to this item, so its sub-pages keep it highlighted. */
  alsoMatches?: string[];
}

interface AdminNavGroup {
  label: string | null;
  /** Names an unlabelled group's <nav> for screen readers. */
  ariaLabel?: string;
  items: AdminNavItem[];
}

const OVERVIEW_PATH = "/admin";

// Grouped by what an operator is doing, so new areas (more plugin kinds) have an obvious home.
const adminNavGroups: AdminNavGroup[] = [
  {
    label: null,
    items: [{ href: OVERVIEW_PATH, label: "Overview", icon: "⌂" }],
  },
  {
    label: "People & access",
    items: [
      { href: "/admin/users", label: "Users", icon: "👥" },
      // A workspace's detail page still lives under its legacy /admin/groups/{id} path.
      { href: "/admin/workspaces", label: "Workspaces", icon: "◫", alsoMatches: ["/admin/groups"] },
      { href: "/admin/roles", label: "Roles", icon: "🔑" },
    ],
  },
  {
    label: "Settings",
    items: [
      { href: "/admin/site-settings", label: "Site Settings", icon: "⚙" },
      { href: "/admin/email-settings", label: "Email", icon: "📧" },
      { href: "/admin/submission-protection", label: "Submission Protection", icon: "🛡" },
    ],
  },
  {
    label: "Extensions",
    items: [
      { href: "/admin/plugins", label: "Plugins", icon: "🧩" },
      { href: "/admin/character-library", label: "Character Library", icon: "🎭" },
    ],
  },
  {
    label: "Operations",
    items: [
      { href: "/admin/system", label: "System", icon: "📊" },
      { href: "/admin/scheduled-tasks", label: "Scheduled Tasks", icon: "⏱" },
      { href: "/admin/backups", label: "Backups", icon: "💾" },
      { href: "/admin/maintenance", label: "Maintenance", icon: "🔧" },
    ],
  },
  {
    label: null,
    ariaLabel: "Leave admin",
    items: [{ href: "/", label: "Back to workspace", icon: "◄" }],
  },
];

function isUnder(prefix: string, currentPath: string): boolean {
  return currentPath === prefix || currentPath.startsWith(`${prefix}/`);
}

// The overview only matches itself; every other item also owns its sub-pages (/admin/users/123).
function isActive(item: AdminNavItem, currentPath: string): boolean {
  if (item.href === OVERVIEW_PATH) {
    return currentPath === OVERVIEW_PATH || currentPath === `${OVERVIEW_PATH}/`;
  }
  return [item.href, ...(item.alsoMatches ?? [])].some((prefix) => isUnder(prefix, currentPath));
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Marvin platform admin" />
    <title>{title} | Marvin Admin</title>
    <RuntimeConfig />
  </head>
  <body>
    <div class="app-shell">
      <aside class="sidebar admin-sidebar">
        <a class="brand" href="/admin">
          <strong>Marvin Admin</strong>
          <span>Platform administration</span>
        </a>
        {adminNavGroups.map((group) => (
          <div class="nav-group">
            {group.label && (
              <div class="nav-group-label">{group.label}</div>
            )}
            <nav class="nav" aria-label={group.label ?? group.ariaLabel ?? "Primary"}>
              {group.items.map((item) => (
                <a href={item.href} aria-current={isActive(item, path) ? "page" : undefined}>
                  <span aria-hidden="true">{item.icon}</span>
                  <span>{item.label}</span>
                </a>
              ))}
            </nav>
          </div>
        ))}
      </aside>
      <main class="main">
        <header class="topbar">
          <div class="topbar-left">
            <div class="topbar-title">
              <p>{eyebrow}</p>
              <h1>{title}</h1>
            </div>
          </div>
          <div class="topbar-actions">
            <a class="button secondary" href="/">Back to workspace</a>
            <form method="POST" action="/api/auth/logout" style="display:inline;">
              <button type="submit" class="button secondary">Logout</button>
            </form>
          </div>
        </header>
        <section class="content">
          <slot />
        </section>
      </main>
      <ThemeSwitcher />
    </div>
  </body>
</html>

<style>
  /* Admin sidebar has different styling to distinguish it from user sidebar */
  .admin-sidebar {
    background: var(--panel);
    border-right: 2px solid var(--accent);
  }

  .admin-sidebar .brand {
    border-bottom-color: var(--line);
  }

  .admin-sidebar .nav-group-label {
    color: var(--muted);
    font-weight: 600;
  }

  .admin-sidebar .nav a {
    color: var(--ink);
    opacity: 0.8;
  }

  .admin-sidebar .nav a:hover {
    background: var(--panel-2);
    color: var(--ink);
    opacity: 1;
  }

  .admin-sidebar .nav a[aria-current="page"] {
    background: var(--color-primary-bg);
    color: var(--accent);
    opacity: 1;
    font-weight: 600;
  }
</style>
