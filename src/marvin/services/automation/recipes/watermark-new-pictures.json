{
  "name": "Watermark new pictures",
  "definition": {
    "trigger": {
      "type": "event",
      "event": "asset_attached_to_entry"
    },
    "conditions": [
      {
        "field": "event.role",
        "op": "eq",
        "value": "{{image_role}}"
      },
      {
        "field": "asset.mime_type",
        "op": "in",
        "value": "image/jpeg,image/png,image/webp"
      },
      {
        "field": "asset.derived_from",
        "op": "exists",
        "value": false
      }
    ],
    "actions": [
      {
        "kind": "media",
        "id": "marked",
        "op": "watermark",
        "text": "{{watermark_text}}",
        "position": "{{position}}",
        "attach_as": "{{image_role}}-watermarked",
        "tags": [
          "watermarked"
        ]
      }
    ]
  }
}
