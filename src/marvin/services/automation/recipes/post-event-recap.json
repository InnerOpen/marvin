{
  "name": "Post-event recap",
  "definition": {
    "trigger": {
      "type": "event",
      "event": "entry_published"
    },
    "conditions": [
      {
        "field": "entry.entry_type",
        "op": "eq",
        "value": "{{event_entry_type}}"
      }
    ],
    "actions": [
      {
        "kind": "wait",
        "id": "after",
        "until": "${entry.{{event_date}}}",
        "offset": "+1d",
        "at": "{{send_at}}"
      },
      {
        "kind": "collect",
        "id": "guests",
        "entity": "entry",
        "query": {
          "entry_type": "{{rsvp_type}}",
          "status": "published",
          "where": [
            {
              "field": "{{rsvp_event_field}}",
              "op": "eq",
              "value": "${entry.slug}"
            }
          ]
        },
        "limit": 25
      },
      {
        "kind": "operation",
        "id": "recap",
        "op": "custom",
        "see": [
          "item"
        ],
        "prompt": "“${entry.title}” was yesterday, with ${steps.guests.output.total} guests who'd RSVP'd. Write a short recap post in {{voice}} from what the entry says (what it was, where, why it mattered) — thank people as a group, name no one — and ask them to share their photos. Invent nothing.",
        "output_schema": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "maxLength": 120
            },
            "body": {
              "type": "string",
              "minLength": 40
            }
          },
          "required": [
            "title",
            "body"
          ]
        },
        "when": {
          "field": "steps.guests.output.count",
          "op": "gt",
          "value": 0
        }
      },
      {
        "kind": "entry",
        "op": "create",
        "entry_type": "{{draft_entry_type}}",
        "title": "${steps.recap.output.title}",
        "data": {
          "{{draft_body_field}}": "${steps.recap.output.body}"
        },
        "metadata": {
          "recap_of": "${entry.slug}"
        },
        "status": "draft",
        "when": {
          "field": "steps.guests.output.count",
          "op": "gt",
          "value": 0
        }
      },
      {
        "kind": "repeat",
        "id": "thanks",
        "for_each": "${steps.guests.output.rows}",
        "as": "guest",
        "on_item_error": "continue",
        "steps": [
          {
            "kind": "operation",
            "id": "message",
            "op": "custom",
            "see": [
              "item"
            ],
            "prompt": "${guest.title} came to “${entry.title}” yesterday. Write a short, personal thank-you message to them in {{voice}}: thanks for coming, one line about the event from what the entry says, and an invitation to share any photos. Address them by first name; invent nothing about them.",
            "output_schema": {
              "type": "object",
              "properties": {
                "body": {
                  "type": "string",
                  "minLength": 30,
                  "maxLength": 600
                }
              },
              "required": [
                "body"
              ]
            }
          },
          {
            "kind": "entry",
            "op": "set_metadata",
            "entity_id": "${guest.id}",
            "metadata": {
              "thank_you": {
                "for": "${entry.slug}",
                "message": "${steps.message.output.body}"
              }
            }
          }
        ],
        "when": {
          "field": "steps.guests.output.count",
          "op": "gt",
          "value": 0
        }
      }
    ]
  }
}
