{
  "name": "File format converter",
  "definition": {
    "trigger": {
      "type": "event",
      "event": "asset_uploaded"
    },
    "conditions": [
      {
        "field": "asset.mime_type",
        "op": "in",
        "value": "image/jpeg,image/png"
      },
      {
        "field": "asset.derived_from",
        "op": "exists",
        "value": false
      }
    ],
    "actions": [
      {
        "kind": "media",
        "id": "webp",
        "op": "convert",
        "format": "webp",
        "quality": "{{quality}}"
      }
    ]
  }
}
