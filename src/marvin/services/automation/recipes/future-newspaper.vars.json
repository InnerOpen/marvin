{
  "recipe": "future-newspaper",
  "variables": {
    "project_type": {
      "type": "entry_type_slug",
      "description": "The entry type to imagine front pages for.",
      "example": "project"
    },
    "newspaper_name": {
      "type": "text",
      "description": "The made-up newspaper's name.",
      "example": "The Raleigh Ledger"
    },
    "image_role": {
      "type": "text",
      "description": "The role an entry's main picture is attached in.",
      "example": "hero"
    }
  }
}
