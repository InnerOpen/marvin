{
  "recipe": "comic-strip-edition",
  "variables": {
    "entry_type": {
      "type": "entry_type_slug",
      "description": "The entry type to turn into comics.",
      "example": "article"
    },
    "footer": {
      "type": "text",
      "description": "A line under the strip.",
      "example": "A Mash & Burn tale"
    },
    "image_role": {
      "type": "text",
      "description": "The role an entry's main picture is attached in.",
      "example": "hero"
    }
  }
}
