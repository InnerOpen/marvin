{
  "name": "Teaser ladder",
  "definition": {
    "trigger": {
      "type": "event",
      "event": "entry_published"
    },
    "conditions": [
      {
        "field": "entry.entry_type",
        "op": "eq",
        "value": "{{launch_entry_type}}"
      }
    ],
    "actions": [
      {
        "kind": "wait",
        "id": "before",
        "until": "${entry.{{launch_date}}}",
        "at": "{{post_at}}",
        "offset": "-3d"
      },
      {
        "kind": "operation",
        "id": "teaser",
        "op": "custom",
        "see": [
          "item"
        ],
        "prompt": "“${entry.title}” launches in three days (${entry.{{launch_date}}}). Write a short teaser post in {{voice}} that builds anticipation from what the entry says, without giving it all away. Invent nothing.",
        "output_schema": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "maxLength": 120
            },
            "body": {
              "type": "string",
              "minLength": 20
            }
          },
          "required": [
            "title",
            "body"
          ]
        },
        "when": {
          "field": "steps.before.output.late",
          "op": "neq",
          "value": true
        }
      },
      {
        "kind": "entry",
        "op": "create",
        "entry_type": "{{draft_entry_type}}",
        "title": "${steps.teaser.output.title}",
        "data": {
          "{{draft_body_field}}": "${steps.teaser.output.body}"
        },
        "metadata": {
          "launch_of": "${entry.slug}",
          "launch_post": "teaser"
        },
        "status": "draft",
        "when": {
          "field": "steps.before.output.late",
          "op": "neq",
          "value": true
        }
      },
      {
        "kind": "wait",
        "id": "day",
        "until": "${entry.{{launch_date}}}",
        "at": "{{post_at}}"
      },
      {
        "kind": "operation",
        "id": "launch",
        "op": "custom",
        "see": [
          "item"
        ],
        "prompt": "“${entry.title}” launches today. Write the launch post in {{voice}}: what it is and why it matters, from what the entry says, ending with where to find it (${entry.url}). Invent nothing.",
        "output_schema": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "maxLength": 120
            },
            "body": {
              "type": "string",
              "minLength": 20
            }
          },
          "required": [
            "title",
            "body"
          ]
        },
        "when": {
          "field": "steps.day.output.late",
          "op": "neq",
          "value": true
        }
      },
      {
        "kind": "entry",
        "op": "create",
        "entry_type": "{{draft_entry_type}}",
        "title": "${steps.launch.output.title}",
        "data": {
          "{{draft_body_field}}": "${steps.launch.output.body}"
        },
        "metadata": {
          "launch_of": "${entry.slug}",
          "launch_post": "launch"
        },
        "status": "draft",
        "when": {
          "field": "steps.day.output.late",
          "op": "neq",
          "value": true
        }
      },
      {
        "kind": "wait",
        "id": "after",
        "until": "${entry.{{launch_date}}}",
        "at": "{{post_at}}",
        "offset": "+7d"
      },
      {
        "kind": "operation",
        "id": "follow_up",
        "op": "custom",
        "see": [
          "item"
        ],
        "prompt": "“${entry.title}” launched a week ago. Write a short follow-up post in {{voice}} that reminds people it's out and gives one fresh angle from the entry. Invent nothing.",
        "output_schema": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "maxLength": 120
            },
            "body": {
              "type": "string",
              "minLength": 20
            }
          },
          "required": [
            "title",
            "body"
          ]
        },
        "when": {
          "field": "steps.after.output.late",
          "op": "neq",
          "value": true
        }
      },
      {
        "kind": "entry",
        "op": "create",
        "entry_type": "{{draft_entry_type}}",
        "title": "${steps.follow_up.output.title}",
        "data": {
          "{{draft_body_field}}": "${steps.follow_up.output.body}"
        },
        "metadata": {
          "launch_of": "${entry.slug}",
          "launch_post": "follow-up"
        },
        "status": "draft",
        "when": {
          "field": "steps.after.output.late",
          "op": "neq",
          "value": true
        }
      }
    ]
  }
}
