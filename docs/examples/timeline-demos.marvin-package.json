      "category": "General",
      "source": "core",
      "requires": [
        "entry_type:demo-plan",
        "entry_type:demo-day",
        "entry_type:demo-post"
      ],
      "parameters": [],
      "payload": {
        "description": "Content plans, their days and their posts.",
        "icon": "📅",
        "color": "#16A34A",
        "is_smart": true,
        "is_public": false,
        "in_sidebar": true,
        "sort_order": 2,
        "smart_rules": {
          "entry_types": [
            "demo-plan",
            "demo-day",
            "demo-post"
          ],
          "match": "all"
        }
      }
    },
    {
      "kind": "view",
      "slug": "event-agenda",
      "name": "Event agenda",
      "description": "An event's day as time, in minutes: its sessions in order, grouped by the part of the day, with who is on stage and the room cues under them.",
      "payload": {
        "kind": "timeline",
        "title": "Event agenda",
        "unit": "minutes",
        "entry_type": "demo-event",
        "sidebar": {
          "label": "Event agenda",
          "icon": "🎤"
        },
        "spine": {
          "entry_type": "demo-session",
          "of": "event",
          "order": "order",
          "group": {
            "entry_type": "demo-block",
            "field": "block",
            "order": "order"
          },
          "picture": "picture",
          "status": "status",
          "seconds": {
            "hold": "minutes",
            "defaults": {
              "hold": 30
            }
          }
        },
        "lanes": [
          {
            "id": "people",
            "title": "People",
            "entry_type": "demo-speaker",
            "of": "event",
            "in": "session",
            "order": "order",
            "who": "role",
            "seconds": "minutes"
          },
          {
            "id": "cues",
            "title": "Room and AV cues",
            "entry_type": "demo-cue",
            "placed": {
              "field": "cues",
              "ref": "cue",
              "at": "at"
            },
            "seconds": "minutes"
          }
        ],
        "picker": {
          "picture": "cover",
          "subtitle": [
            "venue",
            "date"
          ],
          "badges": [
            "status"
          ],
          "strip": {
            "limit": 12
          }
        }
      }
    },
    {
      "kind": "view",
      "slug": "content-plan",
      "name": "Content plan",
      "description": "A content plan as time, in days: one card per day, with the posts that go out that day and their channel under it.",
      "payload": {
        "kind": "timeline",
        "title": "Content plan",
        "unit": "days",
        "entry_type": "demo-plan",
        "sidebar": {
          "label": "Content plan",
          "icon": "📅"
        },
        "spine": {
          "entry_type": "demo-day",
          "of": "plan",
          "order": "number",
          "status": "status",
          "seconds": {
            "hold": "days",
            "defaults": {
              "hold": 1
            }
          }
        },
        "lanes": [
          {
            "id": "posts",
            "title": "Posts",
            "entry_type": "demo-post",
            "of": "plan",
            "in": "day",
            "order": "order",
            "who": "channel",
            "status": "status"
          }
        ],
        "picker": {
          "picture": "cover",
          "subtitle": [
            "starts"
          ],
          "badges": [
            "status"
          ]
        }
      }
    }
  ]
}
